{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": false,
    "noCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", ".astro/types.d.ts", "astro.config.*"],
  "exclude": ["dist", "node_modules", "reports", "scripts", "xu-ly-van-phong-v2.0"]
}
