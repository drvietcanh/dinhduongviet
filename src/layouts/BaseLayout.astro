---
// BaseLayout.astro — Layout chính cho toàn bộ trang Dinh Dưỡng Việt
// Có dark mode, responsive, SEO meta tags, self-hosted fonts, print/PDF style
import Fonts from "../components/Fonts.astro";
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}
const { title, description, image, canonical } = Astro.props;
const defaultImage = "https://dinh-duong-viet.pages.dev/og-default.png";
const imageUrl = image || defaultImage;
const canonicalUrl = canonical ? `https://dinh-duong-viet.pages.dev${canonical}` : null;

const pathname = Astro.url.pathname;
const pathParts = pathname.split("/").filter(Boolean);
const isArticle = pathname.startsWith("/kien-thuc-dinh-duong/") && pathParts.length >= 2;
var breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://dinh-duong-viet.pages.dev/" }
];
var breadcrumbNames = {
  "thuc-pham": "Thực phẩm",
  "mon-an": "Món ăn",
  "kien-thuc-dinh-duong": "Kiến thức dinh dưỡng",
  "cong-cu": "Công cụ",
  "tim-kiem": "Tìm kiếm",
  "bmi": "BMI & Vòng eo",
  "muc-tieu-can-nang": "Mục tiêu cân nặng",
  "bang-xep-hang": "Bảng xếp hạng thực phẩm",
  "so-sanh": "So sánh dinh dưỡng",
  "so-sanh-thuc-pham": "So sánh thực phẩm",
  "ke-hoach-bua-an": "Kế hoạch bữa ăn",
  "loc-thuc-pham": "Lọc thực phẩm",
  "nuoc-uong": "Nước uống",
  "doi-don-vi": "Đổi đơn vị",
  "danh-gia-bua-an": "Đánh giá bữa ăn",
  "thong-ke": "Thống kê"
};
var accumulated = "";
for (var i = 0; i < pathParts.length; i++) {
  accumulated += "/" + pathParts[i];
  var name = breadcrumbNames[pathParts[i]];
  if (!name) {
    name = pathParts[i].replace(/-/g, " ").replace(/\b[a-z]/g, function(c) { return c.toUpperCase(); });
  }
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": i + 2,
    "name": name,
    "item": "https://dinh-duong-viet.pages.dev" + accumulated
  });
}
if (breadcrumbItems.length > 1 && pathParts.length > 0) {
  breadcrumbItems[breadcrumbItems.length - 1].name = title;
}
var breadcrumbSchema = null;
if (breadcrumbItems.length > 1) {
  breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems
  };
}

// Organization + WebSite JSON-LD (chạy 1 lần)
var orgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://dinh-duong-viet.pages.dev/#organization",
      "name": "Dinh Dưỡng Việt",
      "url": "https://dinh-duong-viet.pages.dev",
      "sameAs": [ "https://www.facebook.com/dinhduongviet", "https://www.youtube.com/@dinhduongviet" ],
      "description": "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam.",
      "founder": { "@type": "Person", "name": "Dr. Viet Canh" }
    },
    {
      "@type": "WebSite",
      "@id": "https://dinh-duong-viet.pages.dev/#website",
      "url": "https://dinh-duong-viet.pages.dev",
      "name": "Dinh Dưỡng Việt",
      "description": "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam.",
      "publisher": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
      "inLanguage": "vi-VN",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://dinh-duong-viet.pages.dev/tim-kiem?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
};

// Article JSON-LD for pages /kien-thuc-dinh-duong/*
var articleSchema = null;
if (isArticle) {
  const articleTitle = title.replace(" - Dinh Dưỡng Việt", "");
  articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "description": "Bài viết kiến thức dinh dưỡng: " + articleTitle,
    "author": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
    "publisher": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
    "datePublished": "2026-06-01",
    "dateModified": "2026-06-02",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://dinh-duong-viet.pages.dev" + pathname
    }
  };
}
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam. Dữ liệu từ Bảng thành phần thực phẩm Việt Nam 2007 và USDA."} />
    <meta name="theme-color" content="#1b5e20" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="default" />
      <meta name="apple-mobile-web-app-title" content="DD Việt" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- OG / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam. Dữ liệu từ Bảng thành phần thực phẩm Việt Nam 2007 và USDA."} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Dinh Dưỡng Việt" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl ? canonicalUrl : "https://dinh-duong-viet.pages.dev"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam."} />
    <meta name="twitter:image" content={imageUrl} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Breadcrumb JSON-LD -->
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    <!-- Organization + WebSite JSON-LD (once per page) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {articleSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}

    <!-- Self-hosted fonts (replaces Google Fonts CDN) -->
    <Fonts />

    <title>{title}</title>

    <style is:global>
      /* ===================== RESET & BASE ===================== */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', 'Noto Sans', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
        min-height: 100vh;
      }
      a { color: var(--brand); text-decoration: none; }
      a:hover { text-decoration: underline; }
      img { max-width: 100%; height: auto; display: block; }
      ul { list-style: none; }
      table { border-collapse: collapse; width: 100%; }

      /* ===================== CSS CUSTOM PROPERTIES ===================== */
      :root {
        --brand: #059669;
        --brand-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --brand-dark: #047857;
        --brand-light: #ecfdf5;
        --brand-light2: #d1fae5;
        --brand-subtle: #f0fdf4;
        --ink: #1e293b;
        --ink-secondary: #475569;
        --ink-tertiary: #94a3b8;
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --bg-elevated: #f1f5f9;
        --card: #ffffff;
        --card-hover: #f8fafc;
        --card-border: #e2e8f0;
        --line: #e2e8f0;
        --line-light: #f1f5f9;
        --radius: 12px;
        --radius-lg: 20px;
        --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
        --shadow: 0 8px 16px -4px rgba(0,0,0,0.04), 0 4px 8px -2px rgba(0,0,0,0.02);
        --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04);
        --accent: #0ea5e9;
        --accent-light: #e0f2fe;
        --bg-success: #f0fdf4;
        --bg-info: #e0f2fe;
        --bg-warning: #fef2f2;
        --bg-highlight: #f0fdf4;
        --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      [data-theme="dark"] {
        --brand: #34d399;
        --brand-gradient: linear-gradient(135deg, #34d399 0%, #059669 100%);
        --brand-dark: #10b981;
        --brand-light: #064e3b;
        --brand-light2: #065f46;
        --brand-subtle: #022c22;
        --ink: #f8fafc;
        --ink-secondary: #94a3b8;
        --ink-tertiary: #64748b;
        --bg: #0f172a;
        --bg-soft: #1e293b;
        --bg-elevated: #1e293b;
        --card: #1e293b;
        --card-hover: #334155;
        --card-border: #334155;
        --line: #334155;
        --line-light: #1e293b;
        --shadow-sm: 0 2px 4px rgba(0,0,0,0.2);
        --shadow: 0 8px 16px -4px rgba(0,0,0,0.3), 0 4px 8px -2px rgba(0,0,0,0.2);
        --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.4), 0 8px 10px -6px rgba(0,0,0,0.3);
        --accent: #38bdf8;
        --accent-light: #0c4a6e;
        --bg-success: #022c22;
        --bg-info: #0c4a6e;
        --bg-warning: #450a0a;
        --bg-highlight: #022c22;
        --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* ===================== UI OVERHAUL (GLASSMORPHISM) ===================== */
      .card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: var(--radius-lg);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.05);
        padding: 24px;
        margin-bottom: 24px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      [data-theme="dark"] .card {
        background: rgba(30, 41, 59, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.1);
      }
      .cc-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.5);
        color: var(--ink);
        font-family: inherit;
        font-size: 1rem;
        transition: all var(--transition);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
      }
      [data-theme="dark"] .cc-input {
        background: rgba(15, 23, 42, 0.5);
      }
      .cc-input:focus {
        outline: none;
        border-color: var(--brand);
        background: var(--bg);
        box-shadow: 0 0 0 4px var(--brand-light2);
      }
      .cc-btn {
        padding: 14px 28px;
        background: var(--brand-gradient);
        color: white;
        border: none;
        border-radius: var(--radius);
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px 0 rgba(5, 150, 105, 0.39);
      }
      .cc-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.23);
      }
      .cc-btn:active {
        transform: translateY(1px);
      }

      @keyframes slideUpFade {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-result {
        animation: slideUpFade 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* ===================== COMMON STYLES ===================== */
       /* ===================== NAV ===================== */
      .top-bar {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: var(--ink);
        padding: 10px 24px;
        position: sticky;
        top: 16px;
        z-index: 100;
        max-width: 1100px;
        margin: 0 auto 32px;
        border-radius: 50px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
        transition: background 0.3s, border-color 0.3s;
      }
      [data-theme="dark"] .top-bar {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
      }
      .top-bar .wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .top-bar .logo {
        font-weight: 800;
        font-size: 1.35rem;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        flex-shrink: 0;
      }
      .top-bar .logo img.logo-svg { width: 28px; height: 28px; display: block; }
      .top-bar .logo:hover { text-decoration: none; opacity: 0.9; }

      .nav-links {
        display: flex;
        gap: 18px;
        align-items: center;
      }
      .nav-links a {
        color: var(--ink-secondary);
        font-size: 0.9rem;
        font-weight: 500;
        padding: 6px 0;
        position: relative;
        transition: color 0.2s;
        white-space: nowrap;
      }
      .nav-links a::after {
        background-color: var(--brand);
        transform-origin: bottom right;
        transition: transform 0.25s ease-out;
      }
      .nav-links a:hover {
        color: var(--brand);
        text-decoration: none;
      }
      .nav-links a:hover::after {
        transform: scaleX(1);
        transform-origin: bottom left;
      }

      .nav-search {
        background: var(--bg-soft);
        border-radius: 20px;
        padding: 0 14px;
        gap: 8px;
        min-height: 38px;
        flex-grow: 1;
        max-width: 240px;
        transition: background 0.3s, max-width 0.3s, box-shadow 0.3s;
        border: 1px solid var(--line);
      }
      .nav-search:focus-within {
        background: var(--bg);
        max-width: 300px;
        box-shadow: 0 0 0 3px var(--brand-light2);
      }
      .nav-search input {
        color: var(--ink);
        font-size: 0.85rem;
        padding: 6px 0;
        width: 100%;
        outline: none;
        font-family: inherit;
      }
      .nav-search input::placeholder { color: rgba(255, 255, 255, 0.6); }
      .nav-search .search-icon { font-size: 0.85rem; opacity: 0.7; flex-shrink: 0; }

      .hamburger {
        color: var(--ink);
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
      }
      .theme-toggle {
        background: var(--bg-soft);
        border: 1px solid var(--line);
        color: var(--ink);
        min-width: 38px;
        min-height: 38px;
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 50%;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.2s;
        flex-shrink: 0;
      }
      .theme-toggle:hover {
        background: var(--line-light);
        transform: scale(1.05);
      }
      .theme-toggle:active {
        transform: scale(0.95);
      }

      /* Mobile styles override */
      @media (max-width: 768px) {
        .top-bar .wrapper {
          display: grid;
          grid-template-columns: 1fr auto auto;
          align-items: center;
          gap: 12px 10px;
        }
        .top-bar .logo {
          grid-column: 1;
          grid-row: 1;
          min-width: 0;
          font-size: 1.05rem;
        }
        .theme-toggle {
          grid-column: 2;
          grid-row: 1;
        }
        .top-bar .logo span {
          min-width: 0;
        }
        .nav-search {
          grid-column: 1 / -1;
          grid-row: 2;
          width: 100%;
          max-width: none;
          min-width: 0;
        }
        .nav-search:focus-within {
          max-width: none;
        }
        .nav-links {
          grid-column: 1 / -1;
          grid-row: 3;
          display: none;
          flex-direction: column;
          align-items: stretch;
          gap: 8px;
          padding-top: 8px;
        }
        .wrapper.nav-open .nav-links {
          display: flex;
        }
        .nav-links a {
          display: block;
          padding: 10px 0;
          white-space: normal;
        }
        .hamburger {
          grid-column: 3;
          grid-row: 1;
          background: var(--bg-soft);
          border: 1px solid var(--line);
          color: var(--ink);
          width: 38px;
          height: 38px;
          border-radius: 50%;
          font-size: 1.1rem;
          cursor: pointer;
          box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
          z-index: 999;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: opacity 0.3s, background 0.2s, transform 0.2s;
          line-height: 1;
          text-align: center;
        }
      }

      /* ===================== SKELETON ===================== */
      .skeleton { background: var(--line-light); border-radius: var(--radius); animation: pulse 1.5s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <nav class="top-bar">
      <div class="wrapper">
        <a href="/" class="logo">
        <img src="/logo.svg" alt="Dinh Dưỡng Việt" class="logo-svg" width="26" height="26" />
        <span>Dinh Dưỡng Việt</span>
      </a>
      <button class="hamburger" id="hamburger-btn" aria-label="Menu">☰</button>
      <div class="nav-search">
        <span class="search-icon">🔍</span>
        <input type="search" id="nav-search-input" placeholder="Tìm..." autocomplete="off" />
      </div>
        <div class="nav-links">
          <a href="/nhat-ky" style="color: #fde047; font-weight: 700;">📓 Nhật ký</a>
          <a href="/thong-ke" style="color: #38bdf8; font-weight: 700;">📈 Thống kê</a>
          <a href="/kien-thuc-dinh-duong">Kiến thức</a>
          <a href="/ban-do-benh">Bệnh lý</a>
          <a href="/dung-tin-ngay">🔍 Đừng Tin Ngay</a>
          <a href="/thuc-pham">Thực phẩm</a>
          <a href="/mon-an">Món ăn</a>
          <a href="/cong-cu">Công cụ</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" title="Chuyển giao diện sáng/tối">🌓</button>
      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main>
      <div class="content-wrapper">
        <slot />
      </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="wrapper">
        <div class="footer-col">
          <h4>Dinh Dưỡng Việt</h4>
          <p style="font-size:0.85rem;">Dữ liệu tham khảo từ Bảng thành phần thực phẩm Việt Nam 2007 và các nguồn quốc tế.</p>
        </div>
        <div class="footer-col">
          <h4>Tra cứu</h4>
          <a href="/kien-thuc-dinh-duong">📚 Kiến thức dinh dưỡng</a>
          <a href="/dung-tin-ngay">🔍 Đừng Tin Ngay!</a>
          <a href="/ban-do-benh">🗺️ Bản đồ bệnh mạn tính</a>
          <a href="/thuc-pham">🥬 Thực phẩm</a>
          <a href="/mon-an">🍜 Món ăn Việt</a>
        </div>
        <div class="footer-col">
          <h4>Công cụ</h4>
          <a href="/cong-cu/bmi">⚖️ BMI & Vòng eo</a>
          <a href="/cong-cu/muc-tieu-can-nang">🎯 Mục tiêu cân nặng</a>
          <a href="/cong-cu/bang-xep-hang">🏆 Bảng xếp hạng</a>
          <a href="/cong-cu/theo-doi-suc-khoe">📊 Theo dõi sức khỏe</a>
          <a href="/cong-cu/khau-phan-viet-clinical">🔬 Khẩu phần Clinical</a>
        </div>
        <div class="footer-col">
          <h4>Hỗ trợ</h4>
          <a href="/hoi-dap">❓ Hỏi nhanh – đáp gọn</a>
          <a href="/tim-kiem">🔍 Tìm kiếm</a>
          <a href="/phuong-phap">📖 Phương pháp & Dữ liệu</a>
          <a href="/kien-thuc-dinh-duong">📋 Danh sách bài viết</a>
          <a href="/ban-do-benh">🗺️ Bản đồ bệnh mạn tính</a>
        </div>
      </div>
      <div style="max-width: 900px; margin: 30px auto 0; text-align: center; padding: 16px; background: var(--bg-warning); border: 1px solid var(--card-border); border-radius: var(--radius-lg); font-size: 0.85rem; color: var(--ink-secondary);">
        <strong style="color: #c53030;">Tuyên bố Miễn trừ Trách nhiệm Y khoa:</strong> Các thông tin và bài viết trên website <em>Dinh Dưỡng Việt</em> chỉ mang tính chất tham khảo, không nhằm mục đích thay thế cho chẩn đoán, điều trị hay lời khuyên từ bác sĩ. Bạn cần luôn tham vấn ý kiến bác sĩ chuyên khoa hoặc chuyên gia dinh dưỡng trước khi áp dụng bất kỳ chế độ ăn kiêng nào, đặc biệt khi đang điều trị bệnh lý nền.
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Dinh Dưỡng Việt — Dữ liệu chỉ mang tính tham khảo, không thay thế tư vấn y tế.</p>
      </div>
    </footer>

    <!-- Scroll to Top Button -->
    <button id="scroll-top-btn" title="Lên đầu trang" aria-label="Lên đầu trang">&#8593;</button>

    <script is:inline>
      (function() {
        var btn = document.getElementById('scroll-top-btn');
        if (btn) {
          window.addEventListener('scroll', function() {
            btn.style.display = window.scrollY > 300 ? 'block' : 'none';
          });
          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      })();
    </script>

    <!-- Nav: Hamburger + Search -->
    <script is:inline>
      (function() {
        var ham = document.getElementById('hamburger-btn');
        var wrapper = ham && ham.closest('.wrapper');
        if (ham && wrapper) {
          ham.addEventListener('click', function() {
            wrapper.classList.toggle('nav-open');
          });
        }
        var searchInput = document.getElementById('nav-search-input');
        if (searchInput) {
          searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              var q = this.value.trim();
              if (q) {
                window.location.href = '/tim-kiem?q=' + encodeURIComponent(q);
              }
            }
          });
        }
      })();
    </script>

    <!-- Dark Mode Script -->
    <script is:inline>
      (function() {
        var key = 'ddv-theme';
        var stored = localStorage.getItem(key);

        function apply(theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }

        if (stored) {
          apply(stored);
        } else {
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          apply(prefersDark ? 'dark' : 'light');
        }

        document.getElementById('theme-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-theme');
          var next = current === 'dark' ? 'light' : 'dark';
          apply(next);
          try { localStorage.setItem(key, next); } catch(e) {}
        });
      })();
    </script>

    <!-- Service Worker Registration (PWA) -->
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      }
    </script>
  </body>
