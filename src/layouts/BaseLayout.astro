---
import Fonts from "../components/Fonts.astro";
import ToolMethodologyCard from "../components/ToolMethodologyCard.astro";
import { getToolMethodology } from "../data/tool-methodology";
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string;
}
const { title, description, image, canonical, robots } = Astro.props;
const defaultImage = "https://dinh-duong-viet.pages.dev/og-default.png";
const imageUrl = image || defaultImage;
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = canonicalPath
  ? (canonicalPath.startsWith("http")
    ? canonicalPath
    : `https://dinh-duong-viet.pages.dev${canonicalPath}`)
  : null;

const pathname = Astro.url.pathname;
const toolMethodology = getToolMethodology(pathname);
const pathParts = pathname.split("/").filter(Boolean);
const isArticle = pathname.startsWith("/kien-thuc-dinh-duong/") && pathParts.length >= 2;
var breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://dinh-duong-viet.pages.dev/" }
];
var breadcrumbNames = {
  "thuc-pham": "Thực phẩm",
  "mon-an": "Món ăn",
  "kien-thuc-dinh-duong": "Kiến thức dinh dưỡng",
  "theo-benh": "Theo bệnh",
  "ban-do-benh": "Bản đồ bệnh đầy đủ",
  "cong-cu": "Công cụ",
  "tac-gia": "Tác giả",
  "tim-kiem": "Tìm kiếm",
  "phuong-phap": "Phương pháp và dữ liệu",
  "hoi-dap": "Hỏi đáp",
  "bmi": "BMI",
  "muc-tieu-can-nang": "Mục tiêu cân nặng",
  "bang-xep-hang": "Bảng xếp hạng thực phẩm",
  "so-sanh": "So sánh dinh dưỡng",
  "so-sanh-thuc-pham": "So sánh thực phẩm",
  "ke-hoach-bua-an": "Kế hoạch bữa ăn",
  "loc-thuc-pham": "Lọc thực phẩm",
  "nuoc-uong": "Nước uống",
  "doi-don-vi": "Đổi đơn vị",
  "danh-gia-bua-an": "Đánh giá bữa ăn",
  "tra-cuu-nhu-cau-dinh-duong": "Tra cứu nhu cầu dinh dưỡng",
  "thong-ke": "Thống kê"
};
var accumulated = "";
for (var i = 0; i < pathParts.length; i++) {
  accumulated += "/" + pathParts[i];
  var name = breadcrumbNames[pathParts[i]];
  if (!name) {
    name = pathParts[i].replace(/-/g, " ").replace(/\b[a-z]/g, function(c) { return c.toUpperCase(); });
  }
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": i + 2,
    "name": name,
    "item": "https://dinh-duong-viet.pages.dev" + accumulated
  });
}
if (breadcrumbItems.length > 1 && pathParts.length > 0) {
  breadcrumbItems[breadcrumbItems.length - 1].name = title;
}
var breadcrumbSchema = null;
if (breadcrumbItems.length > 1) {
  breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems
  };
}

// Organization + WebSite JSON-LD (chạy 1 lần)
var orgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://dinh-duong-viet.pages.dev/#organization",
      "name": "Dinh dưỡng Việt",
      "url": "https://dinh-duong-viet.pages.dev",
      "sameAs": [ "https://www.facebook.com/dinhduongviet", "https://www.youtube.com/@dinhduongviet" ],
      "description": "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam.",
      "founder": { "@type": "Person", "name": "Dr. Viet Canh" }
    },
    {
      "@type": "WebSite",
      "@id": "https://dinh-duong-viet.pages.dev/#website",
      "url": "https://dinh-duong-viet.pages.dev",
      "name": "Dinh dưỡng Việt",
      "description": "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam.",
      "publisher": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
      "inLanguage": "vi-VN",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://dinh-duong-viet.pages.dev/tim-kiem?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
};

// Article JSON-LD for pages /kien-thuc-dinh-duong/*
var articleSchema = null;
if (isArticle) {
  const articleTitle = title.replace(" - Dinh dưỡng Việt", "");
  articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "description": "Bài viết kiến thức dinh dưỡng: " + articleTitle,
    "author": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
    "publisher": { "@id": "https://dinh-duong-viet.pages.dev/#organization" },
    "datePublished": "2026-06-01",
    "dateModified": "2026-06-02",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://dinh-duong-viet.pages.dev" + pathname
    }
  };
}
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam. Dữ liệu từ Bảng thành phần thực phẩm Việt Nam 2007 và USDA."} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#1b5e20" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="default" />
      <meta name="apple-mobile-web-app-title" content="DD Việt" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- OG / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam. Dữ liệu từ Bảng thành phần thực phẩm Việt Nam 2007 và USDA."} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Dinh dưỡng Việt" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl ? canonicalUrl : "https://dinh-duong-viet.pages.dev"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam."} />
    <meta name="twitter:image" content={imageUrl} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Breadcrumb JSON-LD -->
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    <!-- Organization + WebSite JSON-LD (once per page) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {articleSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}

    <!-- Self-hosted fonts (replaces Google Fonts CDN) -->
    <Fonts />

    <title>{title}</title>

    <style is:global>
      /* ===================== RESET & BASE ===================== */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', 'Noto Sans', system-ui, -apple-system, sans-serif;
        background:
          radial-gradient(circle at 10% -4%, rgba(16, 185, 129, 0.12), transparent 30rem),
          radial-gradient(circle at 92% 4%, rgba(14, 165, 233, 0.10), transparent 26rem),
          radial-gradient(circle at 54% 38rem, rgba(245, 158, 11, 0.05), transparent 22rem),
          linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 34rem);
        color: var(--ink);
        line-height: 1.6;
        min-height: 100vh;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--brand); text-decoration: none; }
      a:hover { text-decoration: underline; }
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      summary:focus-visible {
        outline: 3px solid rgba(5, 150, 105, 0.32);
        outline-offset: 3px;
        border-radius: 8px;
      }
      img { max-width: 100%; height: auto; display: block; }
      ul { list-style: none; }
      table { border-collapse: collapse; width: 100%; }

      /* ===================== CSS CUSTOM PROPERTIES ===================== */
      :root {
        --brand: #059669;
        --brand-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --brand-dark: #047857;
        --brand-light: #ecfdf5;
        --brand-light2: #d1fae5;
        --brand-subtle: #f0fdf4;
        --ink: #1e293b;
        --ink-secondary: #475569;
        --ink-tertiary: #94a3b8;
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --bg-elevated: #f1f5f9;
        --card: #ffffff;
        --card-hover: #f8fafc;
        --card-border: #e2e8f0;
        --line: #e2e8f0;
        --line-light: #f1f5f9;
        --radius: 12px;
        --radius-lg: 20px;
        --shadow-sm: 0 2px 4px rgba(0,0,0,0.02);
        --shadow: 0 8px 16px -4px rgba(0,0,0,0.04), 0 4px 8px -2px rgba(0,0,0,0.02);
        --shadow-md: 0 12px 20px -8px rgba(15,23,42,0.16), 0 4px 8px -4px rgba(15,23,42,0.10);
        --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04);
        --accent: #0ea5e9;
        --accent-light: #e0f2fe;
        --bg-success: #f0fdf4;
        --bg-info: #e0f2fe;
        --bg-warning: #fef2f2;
        --bg-highlight: #f0fdf4;
        --surface-info: #eafaf1;
        --surface-info-strong: #d5f5e3;
        --border-info: #86cfa5;
        --text-info: #123f2a;
        --surface-danger: #fdedec;
        --surface-danger-strong: #fadbd8;
        --border-danger: #e98b82;
        --text-danger: #5c1d18;
        --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --primary: var(--brand);
        --primary-bg: var(--brand-light);
        --text-color: var(--ink);
        --border: var(--line);
        --border-color: var(--line);
        --bg-card: var(--card);
        --bg-card-alt: var(--bg-soft);
        --fg: var(--ink);
        --ink-primary: var(--ink);
        --dtn-badge-bg: rgba(255, 183, 77, 0.15);
        --dtn-badge-fg: #b45309;
        --dtn-badge-bg2: linear-gradient(135deg, #fff3e0, #ffe0b2);
        --dtn-badge-fg2: #e65100;
        --dtn-hero-bg1: #1a1a2e;
        --dtn-hero-bg2: #16213e;
        --dtn-hero-bg3: #0f3460;
        --dtn-hero-glow: rgba(255, 183, 77, 0.08);
        --dtn-hero-text: #ffffff;
        --dtn-hero-desc: rgba(255, 255, 255, 0.78);
        --dtn-stats: rgba(255, 255, 255, 0.62);
        --dtn-stat-em: #ffb74d;
        --myth-border: #fecaca;
        --myth-text: #991b1b;
        --truth-border: #bbf7d0;
        --truth-text: #166534;
      }

      [data-theme="dark"] {
        --brand: #34d399;
        --brand-gradient: linear-gradient(135deg, #34d399 0%, #059669 100%);
        --brand-dark: #10b981;
        --brand-light: #064e3b;
        --brand-light2: #065f46;
        --brand-subtle: #022c22;
        --ink: #f8fafc;
        --ink-secondary: #94a3b8;
        --ink-tertiary: #64748b;
        --bg: #0f172a;
        --bg-soft: #1e293b;
        --bg-elevated: #1e293b;
        --card: #1e293b;
        --card-hover: #334155;
        --card-border: #334155;
        --line: #334155;
        --line-light: #1e293b;
        --shadow-sm: 0 2px 4px rgba(0,0,0,0.2);
        --shadow: 0 8px 16px -4px rgba(0,0,0,0.3), 0 4px 8px -2px rgba(0,0,0,0.2);
        --shadow-md: 0 12px 20px -8px rgba(0,0,0,0.45), 0 4px 8px -4px rgba(0,0,0,0.35);
        --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.4), 0 8px 10px -6px rgba(0,0,0,0.3);
        --accent: #38bdf8;
        --accent-light: #0c4a6e;
        --bg-success: #022c22;
        --bg-info: #0c4a6e;
        --bg-warning: #450a0a;
        --bg-highlight: #022c22;
        --surface-info: #123b2c;
        --surface-info-strong: #0f2f25;
        --border-info: #2f7a59;
        --text-info: #dcfce7;
        --surface-danger: #451a1a;
        --surface-danger-strong: #321515;
        --border-danger: #8f3f3f;
        --text-danger: #fee2e2;
        --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --primary: var(--brand);
        --primary-bg: var(--brand-light);
        --text-color: var(--ink);
        --border: var(--line);
        --border-color: var(--line);
        --bg-card: var(--card);
        --bg-card-alt: var(--bg-elevated);
        --fg: var(--ink);
        --ink-primary: var(--ink);
        --dtn-badge-bg: rgba(255, 183, 77, 0.14);
        --dtn-badge-fg: #ffb74d;
        --dtn-badge-bg2: linear-gradient(135deg, #3a2a10, #4a2a00);
        --dtn-badge-fg2: #ffb74d;
        --dtn-hero-bg1: #1a1a2e;
        --dtn-hero-bg2: #16213e;
        --dtn-hero-bg3: #0f3460;
        --dtn-hero-glow: rgba(255, 183, 77, 0.05);
        --dtn-hero-text: #e0e0e0;
        --dtn-hero-desc: rgba(226, 232, 240, 0.78);
        --dtn-stats: rgba(226, 232, 240, 0.56);
        --dtn-stat-em: #ffcc80;
        --myth-border: #5a2020;
        --myth-text: #e8a0a0;
        --truth-border: #1a4a1a;
        --truth-text: #81c784;
      }

      /* ===================== UI OVERHAUL (GLASSMORPHISM) ===================== */
      .card {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.62)),
          var(--card);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(148, 163, 184, 0.20);
        border-radius: var(--radius-lg);
        box-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.055);
        padding: 24px;
        margin-bottom: 24px;
        transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease, background 0.24s ease;
      }
      [data-theme="dark"] .card {
        background:
          linear-gradient(180deg, rgba(30, 41, 59, 0.74), rgba(15, 23, 42, 0.58)),
          var(--card);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .card:hover {
        transform: translateY(-2px);
        border-color: rgba(16, 185, 129, 0.34);
        box-shadow: 0 16px 42px -18px rgba(15, 23, 42, 0.22);
      }
      .cc-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.5);
        color: var(--ink);
        font-family: inherit;
        font-size: 1rem;
        transition: all var(--transition);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
      }
      [data-theme="dark"] .cc-input {
        background: rgba(15, 23, 42, 0.5);
      }
      .cc-input:focus {
        outline: none;
        border-color: var(--brand);
        background: var(--bg);
        box-shadow: 0 0 0 4px var(--brand-light2);
      }
      .cc-btn {
        padding: 14px 28px;
        background: var(--brand-gradient);
        color: white;
        border: none;
        border-radius: var(--radius);
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px 0 rgba(5, 150, 105, 0.39);
      }
      .cc-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.23);
      }
      .cc-btn:active {
        transform: translateY(1px);
      }

      @keyframes slideUpFade {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-result {
        animation: slideUpFade 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* ===================== COMMON STYLES ===================== */
      .content-wrapper {
        width: min(100% - 32px, 1180px);
        margin: 0 auto;
      }
      main {
        min-height: 58vh;
      }
      .list-hero,
      .ki-hero,
      .hero-copy,
      .hero-panel {
        position: relative;
      }
      .list-hero::before,
      .ki-hero::before {
        content: "";
        display: block;
        width: 72px;
        height: 5px;
        border-radius: 999px;
        margin: 0 0 14px;
        background: linear-gradient(90deg, var(--brand), var(--accent), #f59e0b);
        opacity: 0.86;
      }
      .list-hero h1,
      .ki-hero h1 {
        letter-spacing: -0.035em;
      }
      .lead,
      .ki-desc {
        text-wrap: pretty;
      }
      .badge,
      .mini-tag,
      .sp-tab,
      .aud-btn,
      .quick-start-links a,
      .cross-cta-strip a {
        letter-spacing: -0.005em;
      }
      .mini-tag,
      .badge {
        border: 1px solid rgba(5, 150, 105, 0.12);
      }
      .filter-panel,
      .tag-filter-panel,
      .quick-start-panel,
      .usage-step,
      .ki-start-card,
      .ki-section-title {
        box-shadow: 0 10px 30px -22px rgba(15, 23, 42, 0.28);
      }
      .filter-panel,
      .quick-start-panel,
      .ki-start-card {
        background:
          linear-gradient(135deg, rgba(236, 253, 245, 0.62), rgba(255, 255, 255, 0.72) 42%, rgba(224, 242, 254, 0.36)),
          var(--card);
      }
      [data-theme="dark"] .filter-panel,
      [data-theme="dark"] .quick-start-panel,
      [data-theme="dark"] .ki-start-card {
        background:
          linear-gradient(135deg, rgba(6, 78, 59, 0.34), rgba(15, 23, 42, 0.70) 46%, rgba(12, 74, 110, 0.24)),
          var(--card);
      }
      .filter-row label span {
        color: var(--ink-secondary);
        font-weight: 750;
      }
      .filter-row select,
      .filter-row input,
      .nav-search {
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 8px 20px -18px rgba(15, 23, 42, 0.30);
      }
      .empty-state {
        border: 1px dashed var(--brand-light2);
        border-radius: var(--radius-lg);
        background: var(--brand-subtle);
      }
       /* ===================== NAV ===================== */
      .top-bar {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: var(--ink);
        padding: 10px 24px;
        position: sticky;
        top: 16px;
        z-index: 100;
        max-width: 1160px;
        margin: 0 auto 32px;
        border-radius: 50px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 16px 42px -22px rgba(15, 23, 42, 0.28);
        transition: background 0.3s, border-color 0.3s;
      }
      [data-theme="dark"] .top-bar {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
      }
      .top-bar .wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .top-bar .logo {
        font-weight: 800;
        font-size: 1.35rem;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        flex-shrink: 0;
      }
      .top-bar .logo img.logo-svg { width: 28px; height: 28px; display: block; }
      .top-bar .logo:hover { text-decoration: none; opacity: 0.9; }

      .nav-links {
        display: flex;
        gap: 16px;
        align-items: center;
      }
      .nav-group { position: relative; }
      .nav-group summary {
        color: var(--ink-secondary);
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        list-style: none;
        padding: 8px 0;
        white-space: nowrap;
      }
      .nav-group summary::-webkit-details-marker { display: none; }
      .nav-group summary::after { content: " ▾"; font-size: 0.75em; opacity: 0.7; }
      .nav-group[open] summary, .nav-group summary:hover, .nav-group summary[aria-current="location"] { color: var(--brand); }
      .nav-group-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: -12px;
        z-index: 10;
        display: grid;
        min-width: 230px;
        padding: 10px;
        gap: 4px;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: 0 18px 42px -18px rgba(15, 23, 42, 0.34);
      }
      .nav-group-menu a {
        padding: 10px 11px;
        border-radius: 10px;
        line-height: 1.35;
        color: var(--ink-secondary);
        font-weight: 650;
      }
      .nav-group-menu a:hover {
        background: var(--brand-light);
        color: var(--brand-dark);
        text-decoration: none;
      }
      .nav-links a {
        color: var(--ink-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        padding: 8px 0;
        position: relative;
        transition: color 0.2s;
        white-space: nowrap;
      }
      .nav-links .nav-primary {
        color: var(--ink);
      }
      .nav-links a::after {
        background-color: var(--brand);
        transform-origin: bottom right;
        transition: transform 0.25s ease-out;
      }
      .nav-links a:hover {
        color: var(--brand);
        text-decoration: none;
      }
      .nav-links a:hover::after {
        transform: scaleX(1);
        transform-origin: bottom left;
      }
      .nav-links a[aria-current="page"] {
        color: var(--brand);
        font-weight: 700;
      }

      .nav-search {
        display: flex;
        align-items: center;
        background: var(--bg-soft);
        border-radius: 20px;
        padding: 0 14px;
        gap: 8px;
        min-height: 38px;
        flex-grow: 1;
        min-width: 0;
        max-width: 260px;
        overflow: hidden;
        transition: background 0.3s, max-width 0.3s, box-shadow 0.3s;
        border: 1px solid var(--line);
      }
      .nav-search:focus-within {
        background: var(--bg);
        max-width: 340px;
        box-shadow: 0 0 0 3px var(--brand-light2);
      }
      .nav-search input {
        min-width: 0;
        border: 0;
        background: transparent;
        color: var(--ink);
        font-size: 0.85rem;
        padding: 6px 0;
        width: 100%;
        outline: none;
        font-family: inherit;
      }
      .nav-search input::placeholder { color: var(--ink-tertiary); }
      .nav-search .search-icon { font-size: 0.85rem; opacity: 0.7; flex-shrink: 0; }

      .hamburger {
        color: var(--ink);
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
      }
      .theme-toggle {
        background: var(--bg-soft);
        border: 1px solid var(--line);
        color: var(--ink);
        min-width: 38px;
        min-height: 38px;
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 50%;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.2s;
        flex-shrink: 0;
      }
      .theme-toggle:hover {
        background: var(--line-light);
        transform: scale(1.05);
      }
      .theme-toggle:active {
        transform: scale(0.95);
      }
      .footer-col a {
        display: flex;
        align-items: center;
        min-height: 44px;
        color: var(--ink-secondary);
      }
      .footer-mobile {
        display: none;
      }

      /* Mobile styles override */
      @media (max-width: 1024px) {
        .content-wrapper {
          width: min(100% - 20px, 1180px);
        }
        .top-bar {
          top: 8px;
          margin: 0 8px 14px;
          padding: 8px 12px;
          border-radius: 18px;
          max-width: none;
        }
        .top-bar .wrapper {
          display: grid;
          grid-template-columns: 1fr auto auto;
          align-items: center;
          gap: 8px 8px;
        }
        .top-bar .logo {
          grid-column: 1;
          grid-row: 1;
          min-width: 0;
          font-size: 0.98rem;
          min-height: 36px;
          gap: 7px;
        }
        .theme-toggle {
          grid-column: 2;
          grid-row: 1;
          min-width: 34px;
          min-height: 34px;
          width: 34px;
          height: 34px;
          font-size: 0.82rem;
        }
        .top-bar .logo span {
          min-width: 0;
        }
        .top-bar .logo img.logo-svg {
          width: 24px;
          height: 24px;
        }
        .nav-search {
          grid-column: 1 / -1;
          grid-row: 2;
          width: 100%;
          max-width: none;
          min-width: 0;
          min-height: 36px;
          padding: 0 11px;
          gap: 6px;
          border-radius: 16px;
        }
        .nav-search:focus-within {
          max-width: none;
        }
        .nav-search input {
          font-size: 0.84rem;
          padding: 5px 0;
        }
        .nav-search .search-icon {
          font-size: 0.8rem;
        }
        .nav-links {
          grid-column: 1 / -1;
          grid-row: 3;
          display: none;
          flex-direction: column;
          align-items: stretch;
          gap: 6px;
          padding-top: 8px;
        }
        .nav-group {
          border-top: 1px solid var(--line-light);
          padding-top: 2px;
        }
        .nav-group summary {
          padding: 10px 0;
          font-size: 0.92rem;
        }
        .nav-group-menu {
          position: static;
          min-width: 0;
          margin: 0 0 4px 8px;
          box-shadow: none;
          background: transparent;
          border: 0;
          border-left: 2px solid var(--line);
          border-radius: 0;
          padding: 0 0 0 8px;
          gap: 2px;
        }
        .nav-group-menu a {
          padding: 8px 0;
          font-size: 0.88rem;
        }
        .wrapper.nav-open .nav-links {
          display: flex;
        }
        .nav-links a {
          display: block;
          padding: 8px 0;
          font-size: 0.9rem;
          white-space: normal;
        }
        .hamburger {
          grid-column: 3;
          grid-row: 1;
          background: var(--bg-soft);
          border: 1px solid var(--line);
          color: var(--ink);
          width: 34px;
          height: 34px;
          border-radius: 50%;
          font-size: 1rem;
          cursor: pointer;
          box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
          z-index: 999;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: opacity 0.3s, background 0.2s, transform 0.2s;
          line-height: 1;
          text-align: center;
        }
        .footer .wrapper {
          display: grid;
          grid-template-columns: 1fr;
          gap: 14px;
        }
        .footer-desktop {
          display: none;
        }
        .footer-mobile {
          display: grid;
          gap: 10px;
        }
        .footer-col {
          padding-bottom: 6px;
          border-bottom: 1px solid var(--line-light);
        }
        .footer-col:last-child {
          border-bottom: 0;
        }
        .footer-accordion {
          border: 1px solid var(--line-light);
          border-radius: 12px;
          background: var(--card);
          padding: 0 12px;
        }
        .footer-accordion summary {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          min-height: 44px;
          cursor: pointer;
          list-style: none;
          font-size: 0.95rem;
          font-weight: 700;
          color: var(--ink);
        }
        .footer-accordion summary::-webkit-details-marker {
          display: none;
        }
        .footer-accordion summary::after {
          content: "+";
          font-size: 1rem;
          color: var(--ink-secondary);
        }
        .footer-accordion[open] summary::after {
          content: "−";
        }
        .footer-accordion-links {
          display: grid;
          gap: 2px;
          padding: 0 0 10px;
        }
        .footer-accordion-links a {
          display: flex;
          align-items: center;
          min-height: 38px;
          color: var(--ink-secondary);
          font-size: 0.9rem;
        }
        .footer-site-disclaimer,
        .footer-data-badge {
          max-width: 900px;
          margin-inline: auto;
        }
        .footer-compact-note,
        .footer-compact-author {
          padding: 12px 14px;
          border: 1px solid var(--line-light);
          border-radius: 12px;
          background: var(--card);
        }
        .footer-compact-note p,
        .footer-compact-author p {
          margin: 0;
          font-size: 0.84rem;
          line-height: 1.55;
          color: var(--ink-secondary);
        }
        .footer-compact-author {
          display: grid;
          gap: 6px;
        }
        .footer-compact-author strong {
          color: var(--ink);
          font-size: 0.92rem;
        }
        .footer-site-disclaimer {
          margin-top: 22px;
          text-align: center;
          padding: 14px;
          background: var(--bg-warning);
          border: 1px solid var(--card-border);
          border-radius: var(--radius-lg);
          font-size: 0.82rem;
          line-height: 1.55;
          color: var(--ink-secondary);
        }
        .footer-data-badge {
          margin-top: 12px;
          display: flex;
          justify-content: center;
        }
        .footer-data-badge-inner {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 9px 12px;
          border: 1px solid var(--card-border);
          border-radius: var(--radius-lg);
          background: var(--card);
          font-size: 0.82rem;
          color: var(--ink-secondary);
        }
        .footer-data-badge-inner span {
          font-weight: 600;
          color: var(--ink);
        }
      }
      @media (max-width: 480px) {
        .top-bar {
          margin-inline: 6px;
          padding: 8px 10px;
          border-radius: 16px;
        }
        .top-bar .logo {
          font-size: 0.92rem;
          gap: 6px;
