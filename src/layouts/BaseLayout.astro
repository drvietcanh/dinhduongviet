          padding: 8px 11px;
        }
      }

      /* ===================== SKELETON ===================== */
      .skeleton { background: var(--line-light); border-radius: var(--radius); animation: pulse 1.5s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    </style>
