---
import { marked } from 'marked';
import BaseLayout from "./BaseLayout.astro";
import SocialShare from "../components/SocialShare.astro";
import type { ArticleMeta } from "../data/articles";
import { getRelatedArticles, articleBySlug, SERIES, SOURCE_ORG, SPECIALTIES } from "../data/articles";
import practicalQA from "../data/practical-qa";

export interface Props {
  article: ArticleMeta;
  lead?: string;
  children?: any;
}

const { article: articleInput, lead } = Astro.props;
// Merge with registry data to get complete info (tags, etc.)
const fullData = articleBySlug[articleInput.slug];
const article = { ...articleInput, ...fullData };
const qa = practicalQA[article.slug] || null;
const related = getRelatedArticles(article.slug, 4);
const dateStr = new Date(article.date).toLocaleDateString("vi-VN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const seriesInfo = article.series ? SERIES[article.series] : null;
const backLink = seriesInfo ? "/" + article.series : "/kien-thuc-dinh-duong";
const backLabel = seriesInfo ? "← Quay lại " + seriesInfo.name : "← Quay lại Kiến thức";
const showSafety = article.category === "disease" || article.category === "special" || (article.tags && article.tags.includes("ask-doctor"));

// Tool links per specialty
const toolMap = {
  'noi-tiet': [{ h: '/cong-cu/chi-so-gi', l: 'Tra chỉ số GI' }, { h: '/cong-cu/tinh-gl-bua-an', l: 'Tính GL bữa ăn' }, { h: '/cong-cu/tinh-carb', l: 'Tính carb' }],
  'tim-mach': [{ h: '/cong-cu/chi-so-gi', l: 'Tra chỉ số GI' }, { h: '/cong-cu/tinh-calo-tieu-thu', l: 'Tính calo' }, { h: '/cong-cu/tinh-carb', l: 'Tính carb' }],
  'tieu-hoa': [{ h: '/cong-cu/tinh-carb', l: 'Tính carb' }, { h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }, { h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }],
  'than-tiet-nieu': [{ h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }, { h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }],
  'co-xuong-khop': [{ h: '/cong-cu/tinh-calo-tieu-thu', l: 'Calo tiêu thụ' }, { h: '/cong-cu/ti-le-mo-co-the', l: 'Tỷ lệ mỡ cơ thể' }],
  'ho-hap': [{ h: '/cong-cu/theo-doi-duong-huyet', l: 'Theo dõi đường huyết' }, { h: '/cong-cu/tinh-calo-tieu-thu', l: 'Calo tiêu thụ' }],
  'than-kinh': [{ h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }, { h: '/cong-cu/tinh-calo-tieu-thu', l: 'Calo tiêu thụ' }],
  'da-lieu': [{ h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }],
  'phu-nu-nhi': [{ h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }, { h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }],
  'huyet-hoc': [{ h: '/cong-cu/theo-doi-duong-huyet', l: 'Theo dõi đường huyết' }, { h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }],
  'ung-thu': [{ h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }, { h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }],
  'nhi-khoa': [{ h: '/cong-cu/nhu-cau-dinh-duong-tre-em', l: 'Nhu cầu trẻ em' }, { h: '/cong-cu/khau-phan-don-gian', l: 'Khẩu phần tham khảo' }],
  'lao-khoa': [{ h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }, { h: '/cong-cu/khau-phan-don-gian', l: 'Khẩu phần tham khảo' }],
  'san-khoa': [{ h: '/cong-cu/dinh-duong-thai-ky', l: 'Dinh dưỡng thai kỳ' }, { h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }],
  'di-ung': [{ h: '/cong-cu/checklist-an-uong', l: 'Checklist ăn uống' }, { h: '/cong-cu/tuong-tac-thuoc-thuc-pham', l: 'Thuốc - thực phẩm' }],
  'tai-mui-hong': [{ h: '/cong-cu/nuoc-uong', l: 'Tính nhu cầu nước' }, { h: '/cong-cu/checklist-an-uong', l: 'Checklist ăn uống' }],
  'phau-thuat': [{ h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }, { h: '/cong-cu/khau-phan-viet-clinical', l: 'Khẩu phần Việt Clinical' }],
  'ngoai-khoa': [{ h: '/cong-cu/tinh-nhu-cau-dam', l: 'Nhu cầu đạm' }, { h: '/cong-cu/khau-phan-viet-clinical', l: 'Khẩu phần Việt Clinical' }],
  'truyen-nhiem': [{ h: '/cong-cu/nuoc-uong', l: 'Tính nhu cầu nước' }, { h: '/cong-cu/khau-phan-don-gian', l: 'Khẩu phần tham khảo' }],
  'dinh-duong-the-thao': [{ h: '/cong-cu/tinh-calo-tieu-thu', l: 'Calo tiêu thụ' }, { h: '/cong-cu/tinh-nang-luong', l: 'Tính BMR & TDEE' }],
};

// CTA per specialty — shown after article body, before Q&A
const specialtyCTA = {
  'noi-tiet': '📊 Muốn biết chỉ số đường huyết của bữa ăn bạn? Dùng ngay <a href="/cong-cu/tinh-gl-bua-an">công cụ tính GL bữa ăn</a> hoặc <a href="/cong-cu/chi-so-gi">tra chỉ số GI thực phẩm</a>.',
  'tim-mach': '❤️ Kiểm tra sức khỏe tim mạch của bạn với <a href="/cong-cu/bmi">máy tính BMI & vòng eo</a> hoặc tính <a href="/cong-cu/tinh-calo-tieu-thu">calo tiêu thụ khi tập</a>.',
  'tieu-hoa': '🥗 Theo dõi chế độ ăn cho hệ tiêu hoá — tính <a href="/cong-cu/tinh-carb">lượng carb</a> hoặc <a href="/cong-cu/tinh-nhu-cau-dam">nhu cầu đạm</a> của bạn.',
  'than-tiet-nieu': '🫘 Bệnh thận cần kiểm soát đạm chặt chẽ. Dùng <a href="/cong-cu/tinh-nhu-cau-dam">công cụ tính nhu cầu đạm</a> và <a href="/cong-cu/bmi">BMI</a>.',
  'co-xuong-khop': '🦴 Duy trì cân nặng hợp lý giảm áp lực lên khớp. Tính thử <a href="/cong-cu/bmi">BMI</a> hoặc <a href="/cong-cu/tinh-calo-tieu-thu">calo tiêu thụ</a> khi vận động.',
  'ho-hap': '🫁 Theo dõi đường huyết và dinh dưỡng với <a href="/cong-cu/theo-doi-duong-huyet">công cụ theo dõi</a> hoặc tính <a href="/cong-cu/tinh-calo-tieu-thu">calo tiêu thụ</a>.',
  'than-kinh': '🧠 Dinh dưỡng tốt cho thần kinh. Dùng <a href="/cong-cu/bmi">BMI & vòng eo</a> để kiểm tra cân nặng hoặc <a href="/cong-cu/tinh-calo-tieu-thu">tính calo</a> vận động.',
  'da-lieu': '🌟 Chăm sóc da từ bên trong. Kiểm tra <a href="/cong-cu/bmi">BMI</a> và cân nặng hợp lý.',
  'phu-nu-nhi': '👶 Mẹ và bé khoẻ mạnh. Tính thử <a href="/cong-cu/bmi">BMI</a> hoặc <a href="/cong-cu/tinh-nhu-cau-dam">nhu cầu đạm</a> cho cả gia đình.',
  'huyet-hoc': '🩸 Duy trì dinh dưỡng tốt với <a href="/cong-cu/bmi">BMI</a> và <a href="/cong-cu/theo-doi-duong-huyet">theo dõi đường huyết</a>.',
  'ung-thu': '🎗️ Dinh dưỡng hỗ trợ điều trị ung thư. Tính <a href="/cong-cu/tinh-nhu-cau-dam">nhu cầu đạm</a> và <a href="/cong-cu/bmi">BMI</a>.',
  'nhi-khoa': '👶 Với trẻ em, nhu cầu dinh dưỡng thay đổi theo tuổi và tình trạng ăn uống. Bạn có thể xem <a href="/cong-cu/nhu-cau-dinh-duong-tre-em">công cụ nhu cầu trẻ em</a> hoặc <a href="/cong-cu/khau-phan-don-gian">khẩu phần tham khảo</a>.',
  'lao-khoa': '👴 Người cao tuổi dễ thiếu đạm và mất cơ. Dùng <a href="/cong-cu/tinh-nhu-cau-dam">công cụ tính nhu cầu đạm</a> hoặc xem <a href="/cong-cu/khau-phan-don-gian">khẩu phần tham khảo</a> để ước lượng bữa ăn hằng ngày.',
  'san-khoa': '🤰 Trong thai kỳ và sau sinh, dinh dưỡng cần cá thể hóa theo tuần thai và triệu chứng. Bạn có thể xem <a href="/cong-cu/dinh-duong-thai-ky">công cụ dinh dưỡng thai kỳ</a> để định hướng ban đầu.',
  'di-ung': '🌿 Với dị ứng thực phẩm, điều quan trọng là nhận diện tình huống nguy cơ và tránh lây nhiễm chéo. Bạn có thể dùng <a href="/cong-cu/checklist-an-uong">checklist ăn uống</a> để tự rà nhanh trong ngày.',
  'tai-mui-hong': '👂 Khi khó chịu vùng tai mũi họng, ưu tiên đủ nước và bữa ăn dễ nuốt. Bạn có thể xem <a href="/cong-cu/nuoc-uong">công cụ nhu cầu nước</a> để ước lượng lượng uống hằng ngày.',
  'phau-thuat': '🏥 Sau phẫu thuật, ưu tiên đủ năng lượng và đủ đạm để hồi phục. Dùng <a href="/cong-cu/tinh-nhu-cau-dam">công cụ nhu cầu đạm</a> để ước lượng ban đầu.',
  'ngoai-khoa': '🩹 Trong giai đoạn hồi phục ngoại khoa, đạm và khẩu phần đầy đủ giúp bảo tồn khối cơ tốt hơn. Bạn có thể xem <a href="/cong-cu/khau-phan-viet-clinical">khẩu phần Việt Clinical</a>.',
  'truyen-nhiem': '🦠 Khi đang hồi phục sau sốt hoặc nhiễm trùng, ưu tiên đủ nước và bữa ăn dễ dung nạp. Có thể xem <a href="/cong-cu/nuoc-uong">công cụ nhu cầu nước</a> để định hướng nhanh.',
  'dinh-duong-the-thao': '🏃 Với vận động và sức bền, tổng năng lượng và thời điểm nạp carb quan trọng hơn việc kiêng khem cực đoan. Xem <a href="/cong-cu/tinh-calo-tieu-thu">công cụ calo tiêu thụ</a> hoặc <a href="/cong-cu/tinh-nang-luong">ước tính BMR & TDEE</a>.',
};
const cta = article.specialty && article.specialty in specialtyCTA
  ? specialtyCTA[article.specialty as keyof typeof specialtyCTA]
  : null;

const toolLinks = article.specialty && article.specialty in toolMap
  ? toolMap[article.specialty as keyof typeof toolMap]
  : [{ h: '/cong-cu/bmi', l: 'BMI & Vòng eo' }, { h: '/cong-cu/muc-tieu-can-nang', l: 'Mục tiêu cân nặng' }];

const audienceLabelMap: Record<string, string> = {
  diabetes: "Tiểu đường",
  hypertension: "Cao huyết áp",
  gout: "Gout",
  kidney: "Bệnh thận",
  "fatty-liver": "Gan nhiễm mỡ",
  stomach: "Dạ dày - trào ngược",
  elderly: "Người cao tuổi",
  pregnancy: "Mang thai",
  children: "Trẻ em",
  "weight-loss": "Giảm cân",
  vegan: "Ăn chay",
  caregiver: "Người chăm sóc",
};

const pathwayMap: Record<string, { label: string; href: string }> = {
  diabetes: { label: "Lộ trình tiểu đường", href: "/ban-do-benh#tieu-duong" },
  hypertension: { label: "Lộ trình cao huyết áp", href: "/ban-do-benh#huyet-ap" },
  gout: { label: "Lộ trình gout", href: "/ban-do-benh#gout" },
  kidney: { label: "Lộ trình bệnh thận", href: "/ban-do-benh#suy-than" },
  "fatty-liver": { label: "Lộ trình gan nhiễm mỡ", href: "/ban-do-benh#gan" },
  stomach: { label: "Lộ trình dạ dày - trào ngược", href: "/ban-do-benh#da-day" },
  elderly: { label: "Lộ trình người cao tuổi", href: "/ban-do-benh#nguoi-gia" },
  pregnancy: { label: "Lộ trình mang thai", href: "/ban-do-benh#ba-bau" },
};

const decisionMap: Record<string, { good: string[]; limit: string[]; when: string }> = {
  diabetes: {
    good: ["chia tinh bột đều giữa các bữa", "ưu tiên rau, đạm nạc, đậu", "dùng công cụ tính carb hoặc GL trước khi đổi thực đơn"],
    limit: ["nước ngọt, trà sữa, bánh kẹo", "ăn dồn nhiều cơm/bún/phở trong một bữa", "tin mẹo chữa khỏi bằng thực phẩm đơn lẻ"],
    when: "đường huyết tăng kéo dài, sụt cân, khát nhiều, tiểu nhiều, hoặc có thuốc đang dùng cần chỉnh bữa ăn",
  },
  hypertension: {
    good: ["giảm món nhiều nước chấm và thực phẩm chế biến sẵn", "tăng rau, đậu, trái cây phù hợp", "ưu tiên cách nấu hấp, luộc, áp chảo nhạt"],
    limit: ["mì gói, xúc xích, chả, đồ muối chua mặn", "chan nhiều nước mắm, bột nêm, tương ớt", "tự bỏ muối hoàn toàn nếu đang có chỉ định đặc biệt khác"],
    when: "huyết áp vẫn cao dù đã ăn nhạt, có phù, khó thở, đau đầu nhiều, hoặc đang kèm suy tim/suy thận",
  },
  gout: {
    good: ["uống đủ nước", "ưu tiên sữa ít béo, đậu hũ, trứng, rau", "giảm rượu bia và kiểm soát cân nặng"],
    limit: ["nhậu dồn dập, bia rượu", "nội tạng, nước dùng cô đặc, hải sản số lượng lớn trong cơn đau", "kiêng sạch mọi loại đạm quá mức"],
    when: "đau khớp cấp, acid uric tăng kéo dài, đang có sỏi thận, hoặc dùng thuốc hạ acid uric",
  },
  kidney: {
    good: ["cá thể hóa lượng đạm theo giai đoạn bệnh", "đọc kỹ kali, natri trong thực phẩm đóng gói", "theo dõi phù, cân nặng, huyết áp"],
    limit: ["tự kiêng đạm cực đoan", "uống thực phẩm bổ sung không rõ thành phần", "áp dụng thực đơn của người khác máy móc"],
    when: "creatinin tăng nhanh, phù, tiểu ít, kali cao, hoặc đang lọc máu/chạy thận",
  },
  "fatty-liver": {
    good: ["giảm nước ngọt và đồ uống nhiều đường", "ăn đủ đạm, rau, tinh bột vừa phải", "duy trì giảm cân chậm và bền"],
    limit: ["nhịn ăn rồi ăn bù", "tin rằng chỉ cần bỏ mỡ là đủ", "rượu bia và đồ ngọt thường xuyên"],
    when: "men gan cao kéo dài, đau tức hạ sườn phải, sụt cân không rõ nguyên nhân, hoặc có đái tháo đường kèm theo",
  },
  stomach: {
    good: ["bữa nhỏ, mềm, dễ tiêu", "ăn chậm và tránh nằm ngay sau ăn", "ghi lại món làm mình khó chịu để loại trừ có chọn lọc"],
    limit: ["cà phê, rượu, đồ cay chua nếu làm nặng triệu chứng", "ăn quá no về đêm", "kiêng quá nhiều nhóm thực phẩm kéo dài"],
    when: "đau tăng, nôn, đi ngoài phân đen, sụt cân, nghẹn nuốt, hoặc triệu chứng kéo dài nhiều tuần",
  },
};

const normalizedAudiences = Array.isArray(article.audience) ? article.audience.filter((item) => item in audienceLabelMap) : [];
const focusAudience = normalizedAudiences[0] || null;
const focusPathway = focusAudience ? pathwayMap[focusAudience] : null;
const quickDecision = focusAudience ? decisionMap[focusAudience] : null;

// Render markdown inside slot content
const rawSlot = await Astro.slots.render("default");
// Normalize: add blank lines after HTML blocks so marked can parse following markdown
const normalized = rawSlot
  // Add blank line after HTML blocks before markdown: headings, blockquotes, bullet lists
  .replace(/<\/(table|div|section|ul|ol|blockquote)>\n(?!\n)([#>\-\*])/g, '</$1>\n\n$2');
const renderedContent = marked.parse(normalized, { async: false })
  // Fix remaining **bold** inside HTML blocks (section, table, div, li...)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  // Fix remaining *italic*
  .replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, '<em>$1</em>');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  author: {
    "@type": "Person",
    name: "BSCKII Đỗ Việt Cảnh",
    email: "drvietcanh@gmail.com",
  },
};
---

<BaseLayout title={`${article.title} | Dinh Dưỡng Việt`} description={article.description} image={`/og/${article.slug}.svg`}>
  <div style="max-width: 760px; margin: 0 auto; padding: 24px 0;">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">🏠 Trang chủ</a>
      <span class="bc-sep">/</span>
      {seriesInfo ? (
        <a href={"/" + article.series}>{seriesInfo.emoji} {seriesInfo.name}</a>
      ) : (
        <a href="/kien-thuc-dinh-duong">📚 Kiến thức</a>
      )}
      {article.specialty && SPECIALTIES[article.specialty] && (
        <div style="display:inline">
          <span class="bc-sep">/</span>
          <a href="/kien-thuc-dinh-duong">
            {SPECIALTIES[article.specialty].emoji} {SPECIALTIES[article.specialty].name}
          </a>
        </div>
      )}
      <span class="bc-sep">/</span>
      <span class="bc-current">{article.title}</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 24px;">
      <a href={backLink} class="back-link">{backLabel}</a>
      <div style="font-size: 0.85rem; color: var(--ink-tertiary); margin: 8px 0;">
        <span class="badge" style="margin-right: 8px;">{article.emoji} {article.categoryName}</span>
        <span>{dateStr}</span>
        <span style="margin: 0 6px">·</span>
        <span>{article.readTime} phút đọc</span>
      </div>
      <h1 style="margin: 12px 0 8px; font-size: 1.75rem; line-height: 1.3;">{article.emoji} {article.title}</h1>
      {lead && <p style="color: var(--ink-secondary); font-size: 1.05rem; line-height: 1.6; margin-bottom: 6px;">{lead}</p>}
      <!-- Priority tags -->
      {article.tags && article.tags.length > 0 && (
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;">
          {article.tags.map(t => {
            const info = {
              'new-diagnosis': { label: '🆕 Mới chẩn đoán — nên đọc', color: '#2e86de', bg: '#ebf5ff' },
              'before-shopping': { label: '🛒 Đọc trước khi đi chợ', color: '#27ae60', bg: '#eafaf1' },
              'before-supplement': { label: '🏷️ Đọc trước khi mua', color: '#e67e22', bg: '#fef5e7' },
              'caregiver': { label: '👨‍👩‍👧‍👦 Dành cho người nhà chăm sóc', color: '#8e44ad', bg: '#f4ecf7' },
              'ask-doctor': { label: '⚕️ Cần hỏi bác sĩ trước khi áp dụng', color: '#e74c3c', bg: '#fdedec' },
            }[t] || { label: t, color: '#718093', bg: '#f1f2f6' };
            return <span style={`display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;background:${info.bg};color:${info.color};font-size:0.8rem;font-weight:500;line-height:1.3;`}>{info.label}</span>;
          })}
        </div>
      )}
      <!-- Series badge -->
      {seriesInfo && (
        <a href={"/" + article.series} style="display:inline-flex;align-items:center;gap:6px;margin-top:10px;padding:6px 12px;background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:8px;text-decoration:none;color:#ffb74d;font-size:0.85rem;font-weight:600;">
          <span>{seriesInfo.emoji}</span>
          <span>Series: {seriesInfo.name}</span>
          <span style="font-size:0.75rem;opacity:0.7;">→</span>
        </a>
      )}
    </div>

    <!-- Tóm tắt nhanh -->
    <div style="margin-bottom: 24px; background: linear-gradient(135deg, #eafaf1 0%, #d5f5e3 100%); border: 1px solid #a9dfbf; border-radius: 12px; padding: 1rem 1.2rem;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
        <span style="font-size: 1.3rem;">📌</span>
        <strong style="font-size: 1rem;">Tóm tắt nhanh</strong>
      </div>
      <ul style="margin: 0; padding-left: 1.4rem; font-size: 0.88rem; line-height: 1.7;">
        <li>{qa?.summary || 'Không cần kiêng tuyệt đối — điều chỉnh là chính.'}</li>
        <li>Quan trọng là <strong>lượng ăn</strong> và <strong>cách phối hợp</strong> thực phẩm.</li>
        <li>Ưu tiên thực phẩm tươi, <strong>ít đường</strong>, <strong>ít muối</strong>, <strong>ít chế biến sẵn</strong>.</li>
        <li>Có bệnh thận/tim/đái tháo đường cần <strong>cá thể hóa</strong> — không áp dụng máy móc.</li>
        <li>Có triệu chứng bất thường: sụt cân, mệt nhiều, đau — <strong>nên đi khám</strong> ngay.</li>
      </ul>
    </div>

    {(focusAudience || quickDecision) && (
      <section class="decision-box">
        <div class="decision-head">
          <div>
            <div class="decision-kicker">Đọc nhanh trước khi áp dụng</div>
            <h2>{focusAudience ? `Nếu bạn đang quan tâm đến ${audienceLabelMap[focusAudience]}` : "Gợi ý áp dụng an toàn"}</h2>
          </div>
          {focusPathway && <a href={focusPathway.href} class="decision-link">{focusPathway.label} →</a>}
        </div>
        <div class="decision-grid">
          <div class="decision-panel ok">
            <div class="decision-title">Nên ưu tiên</div>
            <ul>
              {(quickDecision?.good || ["đọc theo từng bước, không đổi thực đơn quá đột ngột", "giữ bữa ăn đều và ưu tiên thực phẩm ít chế biến"]).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="decision-panel limit">
            <div class="decision-title">Nên hạn chế</div>
            <ul>
              {(quickDecision?.limit || ["kiêng khem cực đoan", "tin vào mẹo truyền miệng thay cho theo dõi thực tế"]).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="decision-panel alert">
            <div class="decision-title">Khi nào nên hỏi bác sĩ</div>
            <p>{quickDecision?.when || qa?.whenDoctor || "Khi có bệnh nền, đang dùng thuốc, có xét nghiệm bất thường, hoặc triệu chứng kéo dài."}</p>
          </div>
        </div>
        <div class="decision-footer">
          {toolLinks.slice(0, 3).map((t) => (
            <a href={t.h} class="decision-chip">🔧 {t.l}</a>
          ))}
        </div>
      </section>
    )}

    <!-- Article body -->
      <div class="article-body" set:html={renderedContent} />

    <!-- Practical Q&A box -->
    
    <!-- Specialty CTA -->
    {cta && (
      <div style="margin-top: 32px; padding: 16px 20px; background: var(--brand-light); border: 1px solid var(--brand-light2); border-radius: 12px; font-size: 0.92rem; line-height: 1.6; display: flex; align-items: flex-start; gap: 10px;">
        <span style="font-size: 1.1rem; flex-shrink: 0;">💡</span>
        <span set:html={cta}></span>
      </div>
    )}

{qa && (
      <div style="margin-top: 36px; background: linear-gradient(135deg, var(--primary-bg) 0%, var(--card) 100%); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem;">
        <h3 style="margin: 0 0 16px; font-size: 1.1rem;">📋 Câu trả lời nhanh</h3>
