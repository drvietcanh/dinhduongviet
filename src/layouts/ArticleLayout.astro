const quickDecision = focusAudience ? decisionMap[focusAudience] : null;
const nextStepMap: Record<string, { href: string; label: string }[]> = {
  diabetes: [
    { href: "/cong-cu/tinh-carb", label: "Tính carb" },
    { href: "/cong-cu/tinh-gl-bua-an", label: "Tính GL bữa ăn" },
    { href: "/theo-benh/tieu-duong", label: "Xem lộ trình theo bệnh" },
  ],
  hypertension: [
    { href: "/cong-cu/nuoc-muoi-mon-an", label: "Muối trong món ăn" },
    { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn" },
    { href: "/theo-benh/cao-huyet-ap", label: "Xem lộ trình theo bệnh" },
  ],
  gout: [
    { href: "/cong-cu/so-sanh-thuc-pham", label: "So sánh thực phẩm" },
