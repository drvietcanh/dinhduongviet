            {article.sources.map(s => (
              <li><a href={s.url} target="_blank" rel="noopener" style="color: var(--brand); text-decoration: none;">{s.name}</a></li>
            ))}
          </ol>
        </details>
      </div>
    )}

    <!-- Related articles -->
    {related.length > 0 && (
      <div style="margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line);">
        <h3 style="font-size: 1.1rem; margin-bottom: 16px;">📖 Bài viết liên quan</h3>
        <div class="related-grid">
          {related.map((r) => (
            <a href={`/kien-thuc-dinh-duong/${r.slug}`} class="related-card">
