    { href: "/theo-benh/gout-axit-uric", label: "Xem lộ trình theo bệnh" },
  ],
  kidney: [
    { href: "/cong-cu/so-sanh-thuc-pham", label: "So sánh thực phẩm" },
    { href: "/cong-cu/tinh-nhu-cau-dam", label: "Tính nhu cầu đạm" },
    { href: "/theo-benh/benh-than", label: "Xem lộ trình theo bệnh" },
  ],
  "fatty-liver": [
    { href: "/cong-cu/muc-tieu-can-nang", label: "Mục tiêu cân nặng" },
    { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn" },
    { href: "/theo-benh/gan-nhiem-mo", label: "Xem lộ trình theo bệnh" },
  ],
  stomach: [
    { href: "/cong-cu/checklist-an-uong", label: "Checklist ăn uống" },
    { href: "/cong-cu/tim-mon-tu-nguyen-lieu", label: "Tìm món từ nguyên liệu" },
    { href: "/theo-benh/da-day-trao-nguoc", label: "Xem lộ trình theo bệnh" },
  ],
};
const nextSteps = focusAudience ? nextStepMap[focusAudience] : null;

// Render markdown inside slot content
const rawSlot = await Astro.slots.render("default");
// Normalize: add blank lines after HTML blocks so marked can parse following markdown
const normalized = rawSlot
  // Add blank line after HTML blocks before markdown: headings, blockquotes, bullet lists
  .replace(/<\/(table|div|section|ul|ol|blockquote)>\n(?!\n)([#>\-\*])/g, '</$1>\n\n$2');
const rawRenderedContent = marked.parse(normalized, { async: false })
  // Fix remaining **bold** inside HTML blocks (section, table, div, li...)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  // Fix remaining *italic*
  .replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, '<em>$1</em>');

const articleToc: { id: string; text: string }[] = [];
const slugifyHeading = (text: string) =>
  text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-")
    .slice(0, 72);
const renderedContent = rawRenderedContent.replace(/<h2>(.*?)<\/h2>/g, (_match, inner) => {
  const text = String(inner).replace(/<[^>]+>/g, "").trim();
  const baseId = slugifyHeading(text) || `muc-${articleToc.length + 1}`;
  const duplicateCount = articleToc.filter((item) => item.id === baseId || item.id.startsWith(`${baseId}-`)).length;
  const id = duplicateCount ? `${baseId}-${duplicateCount + 1}` : baseId;
  articleToc.push({ id, text });
  return `<h2 id="${id}">${inner}<a class="heading-anchor" href="#${id}" aria-label="Liên kết đến mục ${text}">#</a></h2>`;
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: article.reviewedAt || article.date,
  author: {
    "@type": "Person",
    name: "BSCKII Đỗ Việt Cảnh",
    email: "drvietcanh@gmail.com",
  },
  reviewedBy: article.reviewedAt ? {
    "@type": "Person",
    name: reviewer,
  } : undefined,
};
---

<BaseLayout title={`${article.title} | Dinh Dưỡng Việt`} description={article.description} image={`/og/${article.slug}.svg`}>
  <div class="article-shell">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">🏠 Trang chủ</a>
      <span class="bc-sep">/</span>
      {seriesInfo ? (
        <a href={"/" + article.series}>{seriesInfo.emoji} {seriesInfo.name}</a>
      ) : (
        <a href="/kien-thuc-dinh-duong">📚 Kiến thức</a>
      )}
      {article.specialty && SPECIALTIES[article.specialty] && (
        <div style="display:inline">
          <span class="bc-sep">/</span>
          <a href="/kien-thuc-dinh-duong">
            {SPECIALTIES[article.specialty].emoji} {SPECIALTIES[article.specialty].name}
          </a>
        </div>
      )}
      <span class="bc-sep">/</span>
      <span class="bc-current">{article.title}</span>
    </nav>

    <!-- Header -->
    <div class="article-header">
      <a href={backLink} class="back-link">{backLabel}</a>
      <div class="article-header-meta">
        <span class="badge article-kind-badge">{article.emoji} {article.categoryName}</span>
        <span>{dateStr}</span>
        <span class="article-meta-sep">·</span>
        <span>{article.readTime} phút đọc</span>
      </div>
      <h1 class="article-title">{article.emoji} {article.title}</h1>
      {lead && <p class="article-lead">{lead}</p>}
      <div class="editorial-meta" aria-label="Thông tin biên tập">
        <span>Phụ trách nội dung: <a href="/tac-gia">{reviewer}</a></span>
        <span>Cập nhật: {dateStr}</span>
        {reviewedDateStr && <span>Rà soát chuyên môn: {reviewedDateStr}</span>}
        {evidenceLabel && <span>Mức nguồn: {evidenceLabel}</span>}
        <a href="/chinh-sach-bien-tap">Chính sách biên tập</a>
      </div>
      <div class="trust-strip" aria-label="Thông tin độ tin cậy của bài viết">
        <span>🩺 Nội dung tham khảo, không thay thế khám bệnh</span>
        {effectiveSources.length > 0 && <span>📚 {effectiveSources.length} nguồn tham khảo</span>}
        {evidenceLabel && <span>🔎 {evidenceLabel}</span>}
        <a href="/phuong-phap">Phương pháp dữ liệu →</a>
      </div>
      <!-- Priority tags -->
      {article.tags && article.tags.length > 0 && (
        <div class="article-priority-tags">
          {article.tags.map(t => {
            const info = {
              'new-diagnosis': { label: '🆕 Mới chẩn đoán — nên đọc', color: '#2e86de', bg: '#ebf5ff' },
              'before-shopping': { label: '🛒 Đọc trước khi đi chợ', color: '#27ae60', bg: '#eafaf1' },
              'before-supplement': { label: '🏷️ Đọc trước khi mua', color: '#e67e22', bg: '#fef5e7' },
              'caregiver': { label: '👨‍👩‍👧‍👦 Dành cho người nhà chăm sóc', color: '#8e44ad', bg: '#f4ecf7' },
              'ask-doctor': { label: '⚕️ Cần hỏi bác sĩ trước khi áp dụng', color: '#e74c3c', bg: '#fdedec' },
            }[t] || { label: t, color: '#718093', bg: '#f1f2f6' };
            return <span class="article-priority-tag" style={`background:${info.bg};color:${info.color};`}>{info.label}</span>;
          })}
        </div>
      )}
      <!-- Series badge -->
      {seriesInfo && (
        <a href={"/" + article.series} class="series-badge">
          <span>{seriesInfo.emoji}</span>
          <span>Series: {seriesInfo.name}</span>
          <span class="series-badge-arrow">→</span>
        </a>
      )}
    </div>

    {articleToc.length >= 3 && (
      <nav class="article-toc" aria-label="Mục lục bài viết">
        <div class="article-toc-title">Đọc nhanh theo mục</div>
        <div class="article-toc-links">
          {articleToc.slice(0, 8).map((item) => (
            <a href={`#${item.id}`}>{item.text}</a>
          ))}
        </div>
      </nav>
    )}

    <!-- Tóm tắt nhanh -->
    <div class="article-summary-box">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
        <span style="font-size: 1.3rem;">📌</span>
        <strong style="font-size: 1rem;">Tóm tắt nhanh</strong>
      </div>
      <ul style="margin: 0; padding-left: 1.4rem; font-size: 0.88rem; line-height: 1.7;">
        <li>{qa?.summary || 'Không cần kiêng tuyệt đối — điều chỉnh là chính.'}</li>
        <li>Quan trọng là <strong>lượng ăn</strong> và <strong>cách phối hợp</strong> thực phẩm.</li>
        <li>Ưu tiên thực phẩm tươi, <strong>ít đường</strong>, <strong>ít muối</strong>, <strong>ít chế biến sẵn</strong>.</li>
        <li>Có bệnh thận/tim/đái tháo đường cần <strong>cá thể hóa</strong> — không áp dụng máy móc.</li>
        <li>Có triệu chứng bất thường: sụt cân, mệt nhiều, đau — <strong>nên đi khám</strong> ngay.</li>
      </ul>
    </div>

    {(focusAudience || quickDecision) && (
      <section class="decision-box">
        <div class="decision-head">
          <div>
            <div class="decision-kicker">Đọc nhanh trước khi áp dụng</div>
            <h2>{focusAudience ? `Nếu bạn đang quan tâm đến ${audienceLabelMap[focusAudience]}` : "Gợi ý áp dụng an toàn"}</h2>
          </div>
          {focusPathway && <a href={focusPathway.href} class="decision-link">{focusPathway.label} →</a>}
        </div>
        <div class="decision-grid">
          <div class="decision-panel ok">
            <div class="decision-title">Nên ưu tiên</div>
            <ul>
              {(quickDecision?.good || ["đọc theo từng bước, không đổi thực đơn quá đột ngột", "giữ bữa ăn đều và ưu tiên thực phẩm ít chế biến"]).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="decision-panel limit">
            <div class="decision-title">Nên hạn chế</div>
            <ul>
              {(quickDecision?.limit || ["kiêng khem cực đoan", "tin vào mẹo truyền miệng thay cho theo dõi thực tế"]).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="decision-panel alert">
            <div class="decision-title">Khi nào nên hỏi bác sĩ</div>
            <p>{quickDecision?.when || qa?.whenDoctor || "Khi có bệnh nền, đang dùng thuốc, có xét nghiệm bất thường, hoặc triệu chứng kéo dài."}</p>
          </div>
        </div>
        <div class="decision-footer">
          {toolLinks.slice(0, 3).map((t) => (
            <a href={t.h} class="decision-chip">🔧 {t.l}</a>
          ))}
        </div>
      </section>
    )}

    <!-- Article body -->
      <div class="article-body" set:html={renderedContent} />

    <!-- Practical Q&A box -->
    
    <!-- Specialty CTA -->
    {cta && (
      <div style="margin-top: 32px; padding: 16px 20px; background: var(--brand-light); border: 1px solid var(--brand-light2); border-radius: 12px; font-size: 0.92rem; line-height: 1.6; display: flex; align-items: flex-start; gap: 10px;">
        <span style="font-size: 1.1rem; flex-shrink: 0;">💡</span>
        <span set:html={cta}></span>
      </div>
    )}

{qa && (
      <div style="margin-top: 36px; background: linear-gradient(135deg, var(--primary-bg) 0%, var(--card) 100%); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem;">
        <h3 style="margin: 0 0 16px; font-size: 1.1rem;">📋 Câu trả lời nhanh</h3>
        {qa.summary && (
          <div style="background: var(--brand); color: white; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 0.95rem; font-weight: 500;">
            {qa.summary}
          </div>
        )}
        <div style="display: grid; gap: 12px;">
          {qa.canEat && (
            <div style="background: var(--card); border-left: 4px solid #27ae60; padding: 12px 14px; border-radius: 8px;">
              <div style="font-weight: 600; font-size: 0.9rem; color: #27ae60; margin-bottom: 4px;">✅ Ăn được không?</div>
              <div style="font-size: 0.92rem; line-height: 1.6;">{qa.canEat}</div>
            </div>
          )}
          {qa.howMuch && (
            <div style="background: var(--card); border-left: 4px solid #f39c12; padding: 12px 14px; border-radius: 8px;">
              <div style="font-weight: 600; font-size: 0.9rem; color: #f39c12; margin-bottom: 4px;">📏 Ăn bao nhiêu là vừa?</div>
              <div style="font-size: 0.92rem; line-height: 1.6;">{qa.howMuch}</div>
            </div>
          )}
          {qa.swapWith && (
            <div style="background: var(--card); border-left: 4px solid #3498db; padding: 12px 14px; border-radius: 8px;">
              <div style="font-weight: 600; font-size: 0.9rem; color: #3498db; margin-bottom: 4px;">🔄 Nên thay bằng gì?</div>
              <div style="font-size: 0.92rem; line-height: 1.6;">{qa.swapWith}</div>
            </div>
          )}
          {qa.whenDoctor && (
            <div style="background: var(--card); border-left: 4px solid #e74c3c; padding: 12px 14px; border-radius: 8px;">
              <div style="font-weight: 600; font-size: 0.9rem; color: #e74c3c; margin-bottom: 4px;">⚕️ Khi nào cần hỏi bác sĩ?</div>
              <div style="font-size: 0.92rem; line-height: 1.6;">{qa.whenDoctor}</div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Cảnh báo an toàn (chỉ hiện với bài bệnh/đối tượng đặc biệt) -->
    {showSafety && (
    <div class="article-safety-box">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
        <span style="font-size: 1.3rem;">🛑</span>
        <strong style="font-size: 1rem;">Lưu ý an toàn</strong>
      </div>
      <ul style="margin: 0; padding-left: 1.4rem; font-size: 0.88rem; line-height: 1.8;">
        <li><strong>Không tự kiêng</strong> đạm, kali, phốt pho quá mức nếu chưa có chỉ định — có thể gây suy dinh dưỡng nguy hiểm.</li>
        <li><strong>Không tự uống thực phẩm chức năng</strong> thay thuốc điều trị — thực phẩm chức năng là bổ sung, không phải thuốc.</li>
        <li>Người có bệnh <strong>thận, suy tim, xơ gan, ung thư</strong>, phụ nữ mang thai, trẻ nhỏ hoặc đang dùng thuốc đặc biệt — <strong>hỏi bác sĩ</strong> trước khi tự kiêng khem hoặc dùng thực phẩm bổ sung.</li>
        <li><strong>Giảm cân quá nhanh</strong> (>1.5kg/tuần) có thể gây mất cơ, mệt mỏi, rối loạn chuyển hóa.</li>
        <li>Đây là thông tin dinh dưỡng cộng đồng — <strong>không thay thế</strong> tư vấn y tế cá nhân.</li>
      </ul>
    </div>
    )}

    <div class="tool-links-section">
      <h3 class="tool-links-title">🛠️ Bước tiếp theo</h3>
      {(nextSteps ?? toolLinks.map((t) => ({ href: t.h, label: t.l })).slice(0, 3)).map((t) => (
        <a href={t.href} class="art-btn art-btn-secondary" style="font-size: 0.85rem; margin: 4px;">🔧 {t.label}</a>
      ))}
    </div>

    <!-- Social Share Component -->
    <SocialShare title={article.title} url={"https://dinh-duong-viet.pages.dev" + getArticlePath(article)} />

    <!-- Nguồn tham khảo -->
    {effectiveSources.length > 0 && (
      <div style="margin-top: 28px; padding: 16px 0; border-top: 1px solid var(--line);">
        <details style="font-size: 0.82rem; color: var(--ink-tertiary);">
          <summary style="cursor: pointer; font-weight: 600; color: var(--ink-secondary);">📚 Nguồn tham khảo ({effectiveSources.length})</summary>
          <ol style="margin: 10px 0 0; padding-left: 1.2rem; line-height: 1.8;">
            {effectiveSources.map(s => (
              <li><a href={s.url} target="_blank" rel="noopener" style="color: var(--brand); text-decoration: none;">{s.title ? `${s.name} — ${s.title}` : s.name}</a></li>
            ))}
          </ol>
        </details>
      </div>
    )}

    <!-- Related articles -->
    {related.length > 0 && (
      <div style="margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line);">
        <h3 style="font-size: 1.1rem; margin-bottom: 16px;">📖 Bài viết liên quan</h3>
        <div class="related-grid">
          {related.map((r) => (
            <a href={getArticlePath(r)} class="related-card" data-specialty={r.specialty || "general"}>
              <span style="font-size: 1.6rem; display: block; margin-bottom: 6px;">{r.emoji}</span>
              <strong style="font-size: 0.9rem;">{r.title}</strong>
              <span style="font-size: 0.8rem; color: var(--ink-tertiary); margin-top: 4px;">{r.readTime} phút đọc</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Article actions -->
    <div style="margin-top: 32px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">
      <a href="/tim-kiem" class="art-btn art-btn-secondary">🔍 Tìm trên site</a>
      <button class="art-btn art-btn-primary" id="art-share" onclick="navigator.share?navigator.share({title:document.title,url:location.href}):(navigator.clipboard.writeText(location.href),alert('Đã copy link'))">📤 Chia sẻ</button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .article-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 24px 0;
  }
  .article-summary-box,
  .article-safety-box {
    border-radius: 14px;
    padding: 1.2rem 1.5rem;
  }
  .article-summary-box {
    margin-bottom: 24px;
    color: var(--text-info);
    background: linear-gradient(135deg, var(--surface-info), var(--surface-info-strong));
    border: 1px solid var(--border-info);
  }
  .article-safety-box {
    margin-top: 32px;
    color: var(--text-danger);
    background: linear-gradient(135deg, var(--surface-danger), var(--surface-danger-strong));
    border: 1px solid var(--border-danger);
  }
  .back-link {
    color: var(--brand);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .back-link:hover { text-decoration: underline; }
  .badge {
    display: inline-block;
    background: var(--brand-light);
    color: var(--brand);
    font-size: 0.78rem;
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 500;
  }
  .article-body h2 {
    scroll-margin-top: 120px;
    position: relative;
    margin-top: 36px;
    margin-bottom: 12px;
    font-size: 1.3rem;
    padding: 0 0 8px 14px;
    border-bottom: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    letter-spacing: -0.01em;
  }
  .heading-anchor {
    opacity: 0;
    margin-left: 8px;
    color: var(--ink-tertiary);
    font-size: 0.82em;
    text-decoration: none;
    transition: opacity 0.18s ease, color 0.18s ease;
  }
  .article-body h2:hover .heading-anchor,
  .heading-anchor:focus {
    opacity: 1;
  }
  .heading-anchor:hover {
    color: var(--brand);
    text-decoration: none;
  }
  .article-body h3 {
    margin-top: 24px;
    margin-bottom: 8px;
    font-size: 1.1rem;
  }
  .article-body p {
    margin-bottom: 16px;
    line-height: 1.8;
    color: var(--ink);
  }
  .article-body ul, .article-body ol {
    margin-bottom: 18px;
    padding-left: 26px;
  }
  .article-body li {
    margin-bottom: 8px;
    line-height: 1.7;
    padding-left: 2px;
  }
  .article-body li strong {
    color: var(--brand);
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 0.92rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .article-body th, .article-body td {
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-align: left;
  }
  .article-body th {
    background: var(--brand-light);
    font-weight: 700;
    color: var(--brand);
  }
  .article-body tr:nth-child(even) {
    background: var(--bg-soft);
  }
  .article-body blockquote {
    border-left: 4px solid var(--brand);
    margin: 20px 0;
    padding: 12px 18px;
    background: linear-gradient(135deg, var(--brand-light), var(--bg-soft));
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--ink-secondary);
    font-style: italic;
  }
  .article-body img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: 20px 0;
    box-shadow: var(--shadow);
  }
  .highlight-box {
    background: var(--brand-light);
    border: 1px solid var(--brand-light);
    border-radius: var(--radius);
    padding: 14px 18px;
    margin: 16px 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .highlight-box strong { color: var(--brand); }
  .warn-box {
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: var(--radius);
    padding: 14px 18px;
    margin: 16px 0;
    font-size: 0.92rem;
    color: #856404;
  }
  .tip-box {
    background: #d4edda;
    border: 1px solid #28a745;
    border-radius: var(--radius);
    padding: 14px 18px;
    margin: 16px 0;
    font-size: 0.92rem;
    color: #155724;
  }
  .article-header {
    margin-bottom: 20px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background:
      radial-gradient(circle at top left, rgba(16, 185, 129, 0.16), transparent 34%),
      linear-gradient(180deg, var(--card), var(--bg-soft));
    box-shadow: var(--shadow-sm);
  }
  .article-header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.85rem;
    color: var(--ink-tertiary);
    margin: 8px 0 0;
  }
  .article-kind-badge {
    margin-right: 2px;
  }
  .article-meta-sep {
    opacity: 0.45;
  }
  .article-title {
    margin: 12px 0 8px;
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }
  .article-lead {
    color: var(--ink-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 6px;
  }
  .editorial-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 12px;
    padding: 10px 12px;
    border-left: 3px solid var(--brand);
    background: var(--bg-soft);
    color: var(--ink-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
    border-radius: 10px;
  }
  .editorial-meta span,
  .editorial-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
  }
  .article-priority-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .article-priority-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding: 6px 12px;
    background: linear-gradient(135deg,#1a1a2e,#16213e);
    border-radius: 999px;
    text-decoration: none;
    color: #ffb74d;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .series-badge-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .trust-strip span,
  .trust-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--ink-secondary);
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
  }
  [data-theme="dark"] .trust-strip span,
  [data-theme="dark"] .trust-strip a {
    background: rgba(15, 23, 42, 0.42);
  }
  .trust-strip a {
    color: var(--brand-dark);
  }
  .trust-strip a:hover {
    border-color: var(--brand-light2);
    background: var(--brand-light);
    text-decoration: none;
  }
  .article-toc {
    margin: 0 0 24px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .article-toc-title {
