---
// VNHealthScore.astro — Điểm tóm tắt tham khảo, không phải thang điểm lâm sàng.

interface Props {
  nutrients: {
    energyKcal?: number;
    proteinG?: number;
    carbG?: number;
    fatG?: number;
    fiberG?: number;
    sugarG?: number;
    sodiumMg?: number;
    saturatedFatG?: number;
    calciumMg?: number;
    ironMg?: number;
    vitaminCMg?: number;
    vitaminAUg?: number;
    [key: string]: any;
  };
  name: string;
  isRecipe?: boolean;
  servingKcal?: number;
}

const { nutrients, name, isRecipe, servingKcal } = Astro.props;

// --- NHÓM ĐIỂM ---
// Dựa trên khuyến nghị Bộ Y Tế VN (BMR 2000kcal, RDI tham khảo)
let score = 0;
const maxScore = 10;
const details: { label: string; points: number; max: number; reason: string }[] = [];

// 1. Chất xơ (+2 tối đa)
let fiberPoints = 0;
const fiber = nutrients.fiberG;
if (fiber != null && fiber >= 6) { fiberPoints = 2; }
else if (fiber != null && fiber >= 4) { fiberPoints = 1.5; }
else if (fiber != null && fiber >= 2) { fiberPoints = 1; }
else if (fiber != null && fiber > 0) { fiberPoints = 0.5; }
score += fiberPoints;
details.push({ label: "Chất xơ", points: fiberPoints, max: 2, reason: fiber == null
  ? `⚪ Chưa có dữ liệu — không được xem là 0g`
  : fiber >= 2 ? `✅ ${fiber.toFixed(1)}g — có thể đóng góp chất xơ cho khẩu phần`
  : fiber > 0 ? `🟡 Chỉ ${fiber.toFixed(1)}g — cân nhắc thêm nguồn chất xơ khác`
  : `Không ghi nhận chất xơ trong dữ liệu nguồn` });

// 2. Đạm vừa phải (+1.5)
let proteinPoints = 0;
const protein = nutrients.proteinG;
if (isRecipe) {
  const kcal = servingKcal || nutrients.energyKcal;
  if (protein != null && kcal != null && kcal > 0) {
    const pct = (protein * 4 / kcal) * 100;
    if (pct >= 15 && pct <= 30) proteinPoints = 1.5;
    else if (pct >= 10 && pct <= 35) proteinPoints = 1;
    else if (pct > 0) proteinPoints = 0.5;
  }
} else if (protein != null) {
  if (protein >= 10 && protein <= 25) proteinPoints = 1.5;
  else if (protein >= 5 && protein <= 30) proteinPoints = 1;
  else if (protein > 0) proteinPoints = 0.5;
}
score += proteinPoints;
details.push({ label: "Đạm", points: proteinPoints, max: 1.5, reason: protein == null
  ? `⚪ Chưa có dữ liệu — không được xem là 0g`
  : proteinPoints >= 1.5
  ? `✅ ${protein.toFixed(1)}g — tỷ lệ hợp lý`
  : proteinPoints >= 1 ? `🟡 ${protein.toFixed(1)}g — tạm ổn`
  : protein > 0 ? `🟡 ${protein.toFixed(1)}g — thấp, thiếu đạm`
  : `❌ Không có đạm` });

// 3. Ít đường (+1.5)
let sugarPoints = 0;
const sugar = nutrients.sugarG;
if (sugar != null && sugar <= 2) sugarPoints = 1.5;
else if (sugar != null && sugar <= 5) sugarPoints = 1;
else if (sugar != null && sugar <= 10) sugarPoints = 0.5;
score += sugarPoints;
details.push({ label: "Đường", points: sugarPoints, max: 1.5, reason: sugarPoints >= 1
  ? `✅ ${sugar.toFixed(1)}g — thấp theo ngưỡng tham khảo, không đồng nghĩa an toàn cho mọi người`
  : sugarPoints > 0 ? `🟡 ${sugar.toFixed(1)}g — hơi nhiều đường`
  : sugar == null ? `⚪ Chưa có dữ liệu — không được xem là 0g`
  : sugar > 10 ? `🔴 ${sugar.toFixed(1)}g — lượng đường cao trong dữ liệu tham khảo`
  : `Không ghi nhận đường trong dữ liệu nguồn` });

// 4. Ít natri (+1.5)
let sodiumPoints = 0;
const sodium = nutrients.sodiumMg;
if (sodium != null && sodium <= 120) sodiumPoints = 1.5;
else if (sodium != null && sodium <= 300) sodiumPoints = 1;
else if (sodium != null && sodium <= 600) sodiumPoints = 0.5;
score += sodiumPoints;
details.push({ label: "Muối (Natri)", points: sodiumPoints, max: 1.5, reason: sodiumPoints >= 1
  ? `✅ ${sodium?.toFixed(0)}mg — lượng muối thấp`
  : sodiumPoints > 0 ? `🟡 ${sodium?.toFixed(0)}mg — muối trung bình`
  : sodium == null ? `⚪ Chưa có dữ liệu natri — chưa thể chấm tiêu chí này`
  : `🔴 ${sodium.toFixed(0)}mg — nhiều muối (nguy cơ THA)` });

// 5. Ít chất béo bão hòa (+1)
let satPoints = 0;
const satFat = nutrients.saturatedFatG;
if (satFat != null && satFat <= 1.5) satPoints = 1;
else if (satFat != null && satFat <= 3) satPoints = 0.5;
score += satPoints;
details.push({ label: "Chất béo bão hòa", points: satPoints, max: 1, reason: satPoints >= 1
  ? `✅ ${satFat.toFixed(1)}g — rất ít`
  : satPoints > 0 ? `🟡 ${satFat.toFixed(1)}g — mức vừa`
  : satFat == null ? `⚪ Chưa có dữ liệu — không được xem là 0g`
  : `🔴 ${satFat.toFixed(1)}g — lượng cao theo ngưỡng tham khảo` });

// 6. Giàu vi chất (canxi + sắt + vitamin C + A) (+1.5)
let microPoints = 0;
const calcium = nutrients.calciumMg;
const iron = nutrients.ironMg;
const vitC = nutrients.vitaminCMg;
const vitA = nutrients.vitaminAUg;
const micros = [
  { val: calcium, threshold: 100, label: "Canxi" },
  { val: iron, threshold: 1.5, label: "Sắt" },
  { val: vitC, threshold: 10, label: "Vit C" },
  { val: vitA, threshold: 100, label: "Vit A" },
];
const richMicros = micros.filter(m => m.val != null && m.val >= m.threshold);
const knownMicros = micros.filter(m => m.val != null);
const missingMicros = micros.filter(m => m.val == null);
microPoints = Math.min(richMicros.length * 0.375, 1.5);
score += microPoints;
details.push({ label: "Vi chất", points: microPoints, max: 1.5, reason: microPoints >= 1
  ? `✅ Giàu ${richMicros.map(m => m.label).join(", ")}`
  : microPoints > 0
  ? `🟡 Có ${richMicros.map(m => m.label).join(", ")}${missingMicros.length ? `; chưa có số liệu ${missingMicros.map(m => m.label).join(", ")}` : ""}`
  : knownMicros.length === 0 ? `⚪ Chưa có dữ liệu vi chất — không được xem là bằng 0`
  : `Chưa ghi nhận mức giàu theo ngưỡng tham khảo${missingMicros.length ? `; chưa có số liệu ${missingMicros.map(m => m.label).join(", ")}` : ""}` });

// 7. Tỷ lệ calo từ chất béo hợp lý (+1)
let fatPctPoints = 0;
const fat = nutrients.fatG;
const kcal = nutrients.energyKcal;
if (fat != null && kcal != null && kcal > 0) {
  const fatPct = (fat * 9 / kcal) * 100;
  if (fatPct >= 15 && fatPct <= 30) fatPctPoints = 1;
  else if (fatPct >= 10 && fatPct <= 35) fatPctPoints = 0.5;
  if (fatPct < 5 && fatPctPoints > 0) fatPctPoints = 0.3; // quá ít béo cũng không tốt
}
score += fatPctPoints;
details.push({ label: "% calo từ béo", points: fatPctPoints, max: 1, reason: fat == null || kcal == null || kcal <= 0
  ? `⚪ Chưa đủ dữ liệu chất béo/năng lượng để tính`
  : fatPctPoints >= 0.5
  ? `✅ Tỷ lệ hợp lý`
  : `🟡 Chưa cân đối` });

// Làm tròn
score = Math.round(score * 10) / 10;

// Phân loại
let grade = "", gradeColor = "", gradeIcon = "";
const scoreInputsComplete = [fiber, protein, sugar, sodium, satFat, calcium, iron, vitC, vitA, fat, kcal].every((value) => value != null);
const scoreMissingLabels = [
  [fiber, "chất xơ"], [sugar, "đường"], [sodium, "natri"], [satFat, "béo bão hòa"],
  [protein, "đạm"], [fat, "chất béo"], [kcal, "năng lượng"], [calcium, "canxi"], [iron, "sắt"], [vitC, "vitamin C"], [vitA, "vitamin A"],
].filter(([value]) => value == null).map(([, label]) => label);
if (!scoreInputsComplete) { grade = "Chưa đủ dữ liệu"; gradeColor = "#64748b"; gradeIcon = "⚪"; }
else if (score >= 9) { grade = "Xuất sắc"; gradeColor = "#16a34a"; gradeIcon = "🏆"; }
else if (score >= 8) { grade = "Rất tốt"; gradeColor = "#22c55e"; gradeIcon = "🌟"; }
else if (score >= 6.5) { grade = "Tốt"; gradeColor = "#65a30d"; gradeIcon = "👍"; }
else if (score >= 5) { grade = "Trung bình"; gradeColor = "#d97706"; gradeIcon = "🫤"; }
else if (score >= 3.5) { grade = "Kém"; gradeColor = "#ea580c"; gradeIcon = "⚠️"; }
else { grade = "Cần cân nhắc"; gradeColor = "#dc2626"; gradeIcon = "🔴"; }

const starCount = Math.round(score / 2);
const stars = "★".repeat(starCount) + "☆".repeat(5 - starCount);
---

<div class="vn-score-widget">
  <div class="vn-score-header">
    <span class="vn-score-icon">🇻🇳</span>
    <span class="vn-score-title">Điểm dinh dưỡng tham khảo</span>
    <span class="vn-score-badge">{gradeIcon} {grade}</span>
  </div>
  
  <div class="vn-score-body">
    <div class="vn-score-main">
      <div class="vn-score-circle" style={`--score-pct: ${(score / maxScore * 100).toFixed(0)}%; --score-color: ${gradeColor};`}>
        <span class="vn-score-value">{score.toFixed(1)}</span>
        <span class="vn-score-max">/{maxScore}</span>
      </div>
      <div class="vn-score-text">
        <div class="vn-score-stars">{stars}</div>
        <div class="vn-score-label">{name}</div>
      </div>
    </div>

    <div class="vn-score-details">
      {details.map(d => (
        <div class="vn-score-row">
          <div class="vn-score-row-label">{d.label}</div>
          <div class="vn-score-bar-wrapper">
            <div class="vn-score-bar-bg">
              <div class="vn-score-bar-fill" style={`width: ${(d.points / d.max * 100).toFixed(0)}%;`}></div>
            </div>
          </div>
          <div class="vn-score-row-pts">{d.points}/{d.max}</div>
          <div class="vn-score-row-reason">{d.reason}</div>
        </div>
      ))}
    </div>

    {!scoreInputsComplete && (
      <div class="vn-score-warning">
        Chưa thể xếp hạng đầy đủ vì thiếu: {scoreMissingLabels.join(", ")}. Những trường này không được xem là 0; điểm tạm tính không dùng để kết luận thực phẩm tốt/xấu hay phù hợp với bệnh lý.
      </div>
    )}
    {scoreInputsComplete && score < 5 && (
      <div class="vn-score-warning">
        ⚠️ Điểm tổng hợp đang thấp. Hãy đọc kỹ lại phần chất xơ, đường, natri,
        chất béo bão hòa và cân nhắc phối hợp món hoặc khẩu phần cho cân bằng
        hơn.
      </div>
    )}
    {scoreInputsComplete && score >= 8 && (
      <div class="vn-score-tip">
        💪 Điểm tổng hợp đang tốt. Dùng khối này như ảnh chụp nhanh về chất
        lượng dinh dưỡng tổng thể, rồi đối chiếu thêm cảnh báo bệnh lý nếu bạn
        cần cá thể hóa.
      </div>
    )}
    <p class="muted" style="margin: 10px 0 0; font-size: 0.78rem; line-height: 1.5;">
      Đây là thang điểm tham khảo nội bộ, không phải thang điểm chính thức của Bộ Y tế, công cụ sàng lọc hay khuyến nghị điều trị. Thực phẩm tính theo 100 g; món ăn tính theo khẩu phần.
    </p>
  </div>
</div>

<style>
  .vn-score-widget {
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .vn-score-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: #f0fdf4;
    border-bottom: 1px solid #dcfce7;
    font-weight: 600;
    font-size: 0.95em;
  }
  .vn-score-icon { font-size: 1.2em; }
  .vn-score-badge {
    margin-left: auto;
    font-size: 0.8em;
    padding: 2px 10px;
    border-radius: 10px;
    font-weight: 600;
    background: #e5e7eb;
  }
  .vn-score-body { padding: 14px; }
  .vn-score-main {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .vn-score-circle {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: conic-gradient(var(--score-color) 0% var(--score-pct), #e5e7eb var(--score-pct) 100%);
    position: relative;
  }
  .vn-score-circle::before {
    content: '';
    position: absolute;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #fff;
  }
  .vn-score-value {
    font-weight: 700;
    font-size: 1.1em;
    z-index: 1;
    line-height: 1;
  }
  .vn-score-max {
    font-size: 0.7em;
    color: #9ca3af;
    z-index: 1;
  }
  .vn-score-text { flex: 1; }
  .vn-score-stars {
    font-size: 1.1em;
    letter-spacing: 2px;
    color: #f59e0b;
  }
  .vn-score-label {
    font-size: 0.85em;
    color: #6b7280;
    margin-top: 2px;
  }
  .vn-score-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vn-score-row {
    display: grid;
    grid-template-columns: 90px 1fr 50px;
    gap: 6px;
    align-items: center;
    font-size: 0.83em;
  }
  .vn-score-row-label { color: #374151; font-weight: 500; }
  .vn-score-bar-wrapper { min-width: 0; }
  .vn-score-bar-bg {
    height: 6px;
    background: #e5e7eb;
    border-radius: 3px;
    overflow: hidden;
  }
  .vn-score-bar-fill {
    height: 100%;
    background: #22c55e;
    border-radius: 3px;
    transition: width 0.3s;
  }
  .vn-score-row-pts {
    text-align: right;
    color: #374151;
    font-weight: 500;
  }
  .vn-score-row-reason {
    grid-column: 1 / -1;
    font-size: 0.8em;
    color: #6b7280;
    margin-top: -4px;
  }
  .vn-score-warning {
    margin-top: 12px;
    padding: 8px 10px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-size: 0.85em;
    color: #991b1b;
  }
  .vn-score-tip {
    margin-top: 12px;
    padding: 8px 10px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    font-size: 0.85em;
    color: #166534;
  }
</style>
