---
import { foods, recipes } from "../data/nutrition";
import { calculateRecipe } from "../lib/nutrition";
import { articles } from "../data/articles";

const articleItems = articles
  .filter(a => a && a.slug && a.title)
  .map(a => ({
    n: a.title,
    s: a.slug,
    a: (a.keywords || []).concat([a.categoryName || ""]),
    t: "bài viết",
    u: `/kien-thuc-dinh-duong/${a.slug}`,
    k: 0,
    e: a.emoji || "📄"
  }));

const toolItems = [
  { n: "BMI & Vòng eo", s: "bmi", a: ["cân nặng", "béo phì", "mỡ"], t: "công cụ", u: "/cong-cu/bmi", k: 0, e: "⚖️" },
  { n: "Chỉ số đường huyết (GI)", s: "chi-so-gi", a: ["glucose", "đái tháo đường", "tiểu đường", "carb"], t: "công cụ", u: "/cong-cu/chi-so-gi", k: 0, e: "📊" },
  { n: "Tính GL bữa ăn", s: "tinh-gl-bua-an", a: ["đường huyết", "tải lượng", "đái tháo đường", "tiểu đường"], t: "công cụ", u: "/cong-cu/tinh-gl-bua-an", k: 0, e: "🥘" },
  { n: "Tính nhu cầu đạm", s: "tinh-nhu-cau-dam", a: ["protein", "thận", "cơ"], t: "công cụ", u: "/cong-cu/tinh-nhu-cau-dam", k: 0, e: "🥩" },
  { n: "Tính carb trong bữa ăn", s: "tinh-carb", a: ["tinh bột", "đường", "đái tháo đường", "tiểu đường"], t: "công cụ", u: "/cong-cu/tinh-carb", k: 0, e: "🔢" },
  { n: "Theo dõi đường huyết", s: "theo-doi-duong-huyet", a: ["glucose", "HbA1c"], t: "công cụ", u: "/cong-cu/theo-doi-duong-huyet", k: 0, e: "🩸" },
  { n: "Tính calo tiêu thụ", s: "tinh-calo-tieu-thu", a: ["vận động", "tập", "MET"], t: "công cụ", u: "/cong-cu/tinh-calo-tieu-thu", k: 0, e: "🔥" },
  { n: "Tỷ lệ mỡ cơ thể", s: "ti-le-mo-co-the", a: ["body fat", "WHR", "vòng eo"], t: "công cụ", u: "/cong-cu/ti-le-mo-co-the", k: 0, e: "📏" },
  { n: "Dinh dưỡng thai kỳ", s: "dinh-duong-thai-ky", a: ["mang thai", "bầu", "thai nhi"], t: "công cụ", u: "/cong-cu/dinh-duong-thai-ky", k: 0, e: "🤰" },
  { n: "Nhu cầu dinh dưỡng trẻ em", s: "nhu-cau-dinh-duong-tre-em", a: ["trẻ", "thiếu nhi", "tăng trưởng"], t: "công cụ", u: "/cong-cu/nhu-cau-dinh-duong-tre-em", k: 0, e: "👶" },
  { n: "Tương tác thuốc-thực phẩm", s: "tuong-tac-thuoc-thuc-pham", a: ["thuốc", "kháng sinh", "tương kỵ"], t: "công cụ", u: "/cong-cu/tuong-tac-thuoc-thuc-pham", k: 0, e: "💊" },
  { n: "Đường trong đồ uống", s: "duong-do-uong", a: ["nước ngọt", "đường", "calo lỏng"], t: "công cụ", u: "/cong-cu/duong-do-uong", k: 0, e: "🥤" },
  { n: "Lập thực đơn tuần", s: "lap-thuc-don-tuan", a: ["kế hoạch", "bữa ăn", "meal prep"], t: "công cụ", u: "/cong-cu/lap-thuc-don-tuan", k: 0, e: "📋" },
];

const allItems = [
  ...foods.map(f => ({ n: f.name, s: f.slug, a: f.aliases ?? [], t: "thực phẩm", u: `/thuc-pham/${f.slug}`, k: Math.round(f.nutrients?.energyKcal ?? 0), e: "" })),
  ...recipes.map(r => {
    const n = calculateRecipe(r);
    return { n: r.name, s: r.slug, a: r.aliases ?? [], t: "món ăn", u: `/mon-an/${r.slug}`, k: Math.round(n?.energyKcal ?? 0), e: "" };
  }),
  ...articleItems,
  ...toolItems,
];
const dataPayload = allItems;
const jsonPayload = JSON.stringify(dataPayload);
---

<autocomplete-search>
  <div class="ac-backdrop" style="display: none;"></div>
  <div class="ac-search-wrapper">
    <div class="ac-search-row">
      <span class="ac-search-icon">🔍</span>
      <input type="text" class="ac-input" placeholder="Tìm thực phẩm, món ăn, bài viết, công cụ..." aria-label="Tìm kiếm" autocomplete="off" />
      <div class="ac-actions">
        <button class="ac-clear" style="display: none;" aria-label="Xóa">✕</button>
        <div class="ac-hotkey">Ctrl K</div>
        <button class="ac-submit" style="display: none;">🔍</button>
      </div>
    </div>
    <div class="ac-dropdown" style="display: none;"></div>
  </div>
  <div class="ac-suggestions">
    <span class="ac-suggestion-label">Gợi ý nhanh:</span>
    <button class="ac-chip" data-q="bmi">⚖️ BMI</button>
    <button class="ac-chip" data-q="đái tháo đường">🩸 đái tháo đường</button>
    <button class="ac-chip" data-q="đạm">🥩 nhu cầu đạm</button>
    <button class="ac-chip" data-q="phở bò">🍜 phở bò</button>
    <button class="ac-chip" data-q="trứng">🥚 trứng</button>
    <button class="ac-chip" data-q="bún">🍜 bún</button>
  </div>
  <!-- Hidden container with search data - Astro evaluates {expression} in text content -->
  <div id="search-payload" style="display:none">{jsonPayload}</div>
</autocomplete-search>

<script is:inline>
(function() {
  var payloadEl = document.getElementById('search-payload');
  if (!payloadEl) return;
  var raw = payloadEl.textContent;
  if (!raw) return;
  var PAYLOAD = JSON.parse(raw);
  var el = document.querySelector('autocomplete-search');
  if (!el) return;
  var input = el.querySelector('.ac-input');
  var dropdown = el.querySelector('.ac-dropdown');
  var backdrop = el.querySelector('.ac-backdrop');
  var clearBtn = el.querySelector('.ac-clear');

  // Hotkey Ctrl+K
  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      input.focus();
    }
  });

  // Clear button logic
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      input.value = '';
      dropdown.style.display = 'none';
      backdrop.style.display = 'none';
      clearBtn.style.display = 'none';
      input.focus();
    });
  }

  function escapeHtml(text) {
    return String(text || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function highlightHtml(text, q) {
    var safeText = escapeHtml(text);
    if (!q) return safeText;
    try {
      var safeQ = escapeHtml(q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var regex = new RegExp('(' + safeQ + ')', 'gi');
      return safeText.replace(regex, '<mark>$1</mark>');
    } catch (e) {
      return safeText;
    }
  }

  function normalize(str) {
    return str.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  function matchesSearchText(text, q) {
    if (!q) return true;
    if (q.length <= 3 || q.indexOf(' ') !== -1) {
      return (' ' + text + ' ').indexOf(' ' + q + ' ') !== -1;
    }
    return text.indexOf(q) !== -1;
  }

  function fieldScore(value, q, rawQ) {
    var raw = String(value || '').toLowerCase();
    var text = normalize(raw);
    if (!text || !q) return 0;
    if (text === q || raw === rawQ) return 120;
    if (text.indexOf(q + ' ') === 0 || raw.indexOf(rawQ) === 0) return 90;
    if ((' ' + text + ' ').indexOf(' ' + q + ' ') !== -1) return 70;
    if (text.indexOf(q) !== -1) return 35;
    return 0;
  }

  function aliasIntentBonus(rawText, q, rawQ) {
    var raw = String(rawText || '').toLowerCase();
    if (q === 'ngo' && rawQ.indexOf('ngò') !== -1) return raw.indexOf('ngò') !== -1 ? 32 : (raw.indexOf('ngô') !== -1 ? -35 : 0);
    if (q === 'ngo') return raw.indexOf('ngô') !== -1 ? 32 : (raw.indexOf('ngò') !== -1 ? -35 : 0);
    if (q === 'bap') return raw.indexOf('bắp cải') !== -1 || raw.indexOf('đậu bắp') !== -1 ? -20 : (raw.indexOf('bắp') !== -1 || raw.indexOf('ngô') !== -1 ? 24 : 0);
    if (q === 'lon') return raw.indexOf('lợn') !== -1 ? 36 : (raw.indexOf('lòng') !== -1 || raw.indexOf('lộn') !== -1 ? -45 : 0);
    if (q === 'lac') return raw.indexOf('lạc') !== -1 || raw.indexOf('đậu phộng') !== -1 ? 32 : (raw.indexOf('lắc') !== -1 ? -35 : 0);
    if (q === 'ca phe') return raw.indexOf('cà phê') !== -1 || raw.indexOf('cafe') !== -1 ? 32 : 0;
    if (q === 'tom su') return raw.indexOf('tôm sú') !== -1 ? 32 : 0;
    if (q === 'gao lat' || q === 'gao lut' || q === 'com gao lut') return raw.indexOf('gạo lứt') !== -1 || raw.indexOf('gạo lật') !== -1 ? 24 : 0;
    return 0;
  }

  function searchScore(item, q, rawQ) {
    if (!q) return 1;
    var fields = [item.n, item.s].concat(item.a || []);
    var best = 0;
    for (var i = 0; i < fields.length; i++) {
      best = Math.max(best, fieldScore(fields[i], q, rawQ));
    }
    var rawText = fields.join(' ');
    best += aliasIntentBonus(rawText, q, rawQ);
    if (item.t === 'thực phẩm') best += 3;
    return best;
  }

  function filterItems(q) {
    var lower = normalize(q);
    var rawQ = String(q || '').toLowerCase().trim();
    var results = [];
    for (var i = 0; i < PAYLOAD.length; i++) {
      var item = PAYLOAD[i];
      var haystack = normalize([item.n, item.s].concat(item.a || []).join(' '));
      var score = searchScore(item, lower, rawQ);
      if (score > 0 && (matchesSearchText(haystack, lower) || score >= 70)) {
        results.push({ item: item, score: score });
      }
    }
    results.sort(function(a, b) {
      if (b.score !== a.score) return b.score - a.score;
      return a.item.n.localeCompare(b.item.n, 'vi');
    });
    return results.slice(0, 8).map(function(row) { return row.item; });
  }

  function showDropdown(results) {
    if (results.length === 0) {
      dropdown.style.display = 'none';
      return;
    }
    var html = '';
    for (var i = 0; i < results.length; i++) {
      var r = results[i];
      var kcalHtml = r.k > 0 ? '<span class="ac-item-kcal">' + r.k + ' kcal</span>' : '';
      var emojiHtml = r.e ? '<span class="ac-item-emoji">' + r.e + '</span>' : '';
      html += '<a class="ac-item" href="' + r.u + '">' +
        '<span class="ac-item-name">' + emojiHtml + highlightHtml(r.n, input.value.trim()) + '</span>' +
        '<span class="ac-item-meta">' +
          '<span class="ac-item-type ' + (r.t === 'bài viết' ? 'bai-viet' : r.t === 'công cụ' ? 'cong-cu' : '') + '">' + escapeHtml(r.t) + '</span>' +
          kcalHtml +
        '</span>' +
      '</a>';
    }
    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
    if (backdrop) backdrop.style.display = 'block';
  }

  input.addEventListener('input', function() {
    var q = this.value.trim();
    if (clearBtn) clearBtn.style.display = q.length > 0 ? 'block' : 'none';
    if (q.length < 1) {
      dropdown.style.display = 'none';
      if (backdrop) backdrop.style.display = 'none';
      return;
    }
    var results = filterItems(q);
    showDropdown(results);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      dropdown.style.display = 'none';
      this.blur();
    }
    if (e.key === 'Enter') {
      dropdown.style.display = 'none';
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.value);
    }
  });

  document.addEventListener('click', function(e) {
    if (!el.contains(e.target)) {
      dropdown.style.display = 'none';
      if (backdrop) backdrop.style.display = 'none';
    }
  });

  el.querySelectorAll('.ac-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.dataset.q);
    });
  });

  el.querySelector('.ac-submit').addEventListener('click', function() {
    window.location.href = '/tim-kiem?q=' + encodeURIComponent(input.value);
  });
})();
</script>

<style>
  autocomplete-search { display: block; }
  .ac-search-wrapper { position: relative; }
  .ac-backdrop {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
    z-index: 40;
  }
  .ac-search-wrapper { position: relative; z-index: 50; }
  .ac-search-row {
    display: flex; align-items: center;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 4px 8px;
  }
  .ac-search-row:focus-within {
    background: #ffffff;
    box-shadow: 0 12px 48px rgba(0,0,0,0.15), 0 0 0 3px rgba(59,130,246,0.3);
    transform: translateY(-2px);
  }
  .ac-search-icon { padding: 0 12px; font-size: 1.2rem; color: #666; }
  .ac-actions { display: flex; align-items: center; gap: 8px; padding-right: 8px; }
  .ac-hotkey {
    background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px;
    padding: 4px 8px; font-size: 0.75rem; font-weight: 600; color: #64748b;
    pointer-events: none;
  }
  .ac-clear {
    background: #f1f5f9; border: none; border-radius: 50%;
    width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; color: #64748b; cursor: pointer; transition: background 0.2s;
  }
  .ac-clear:hover { background: #e2e8f0; color: #333; }
  mark { background: rgba(59,130,246,0.2); color: #1d4ed8; border-radius: 3px; padding: 0 2px; font-weight: 700; }
  .ac-dropdown {
    border: none;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    margin-top: 12px;
  }
  .ac-input { padding: 0; min-height: 48px; }
  .ac-search-row:focus-within {
    box-shadow: 0 0 0 4px var(--brand-light);
  }
  .ac-input {
    flex: 1;
    border: none;
    min-height: 52px;
    padding: 0 16px;
    font-size: 1rem;
    background: transparent;
    color: var(--ink);
  }
  .ac-input:focus { outline: none; box-shadow: none; }
  .ac-submit {
    background: var(--brand);
    color: white;
    border: none;
    padding: 0 20px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .ac-submit:hover { background: var(--brand-dark); }
  .ac-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    z-index: 50;
    overflow: hidden;
  }
  .ac-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    transition: background 0.15s;
    border-bottom: 1px solid var(--line-light);
  }
  .ac-item:last-child { border-bottom: none; }
  .ac-item:hover { background: var(--line-light); }
  .ac-item-name { font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 6px; }
  .ac-item-emoji { font-size: 1rem; flex-shrink: 0; }
  .ac-item-meta { display: flex; gap: 8px; align-items: center; }
  .ac-item-type {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    font-weight: 500;
  }
  .ac-item-kcal {
    font-size: 0.8rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-item-type.bai-viet { background: #e3f2fd; color: #1565c0; }
  .ac-item-type.cong-cu { background: #fce4ec; color: #c62828; }
  .ac-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    align-items: center;
  }
  .ac-suggestion-label {
    font-size: 0.82rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-chip {
    padding: 8px 14px;
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s;
    font-weight: 500;
  }
  .ac-chip:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
  }
</style>
