---
import { foods, recipes } from "../data/nutrition";
import { calculateRecipe } from "../lib/nutrition";
import { articles } from "../data/articles";

const articleItems = articles
  .filter(a => a && a.slug && a.title)
  .map(a => ({
    n: a.title,
    s: a.slug,
    a: (a.keywords || []).concat([a.categoryName || ""]),
    t: "bài viết",
    u: `/kien-thuc-dinh-duong/${a.slug}`,
    k: 0,
    e: a.emoji || "📄"
  }));

const toolItems = [
  { n: "BMI & Vòng eo", s: "bmi", a: ["cân nặng", "béo phì", "mỡ"], t: "công cụ", u: "/cong-cu/bmi", k: 0, e: "⚖️" },
  { n: "Chỉ số đường huyết (GI)", s: "chi-so-gi", a: ["glucose", "tiểu đường", "carb"], t: "công cụ", u: "/cong-cu/chi-so-gi", k: 0, e: "📊" },
  { n: "Tính GL bữa ăn", s: "tinh-gl-bua-an", a: ["đường huyết", "tải lượng", "tiểu đường"], t: "công cụ", u: "/cong-cu/tinh-gl-bua-an", k: 0, e: "🥘" },
  { n: "Tính nhu cầu đạm", s: "tinh-nhu-cau-dam", a: ["protein", "thận", "cơ"], t: "công cụ", u: "/cong-cu/tinh-nhu-cau-dam", k: 0, e: "🥩" },
  { n: "Tính carb trong bữa ăn", s: "tinh-carb", a: ["tinh bột", "đường", "tiểu đường"], t: "công cụ", u: "/cong-cu/tinh-carb", k: 0, e: "🔢" },
  { n: "Theo dõi đường huyết", s: "theo-doi-duong-huyet", a: ["glucose", "HbA1c"], t: "công cụ", u: "/cong-cu/theo-doi-duong-huyet", k: 0, e: "🩸" },
  { n: "Tính calo tiêu thụ", s: "tinh-calo-tieu-thu", a: ["vận động", "tập", "MET"], t: "công cụ", u: "/cong-cu/tinh-calo-tieu-thu", k: 0, e: "🔥" },
  { n: "Tỷ lệ mỡ cơ thể", s: "ti-le-mo-co-the", a: ["body fat", "WHR", "vòng eo"], t: "công cụ", u: "/cong-cu/ti-le-mo-co-the", k: 0, e: "📏" },
  { n: "Dinh dưỡng thai kỳ", s: "dinh-duong-thai-ky", a: ["mang thai", "bầu", "thai nhi"], t: "công cụ", u: "/cong-cu/dinh-duong-thai-ky", k: 0, e: "🤰" },
  { n: "Nhu cầu dinh dưỡng trẻ em", s: "nhu-cau-dinh-duong-tre-em", a: ["trẻ", "thiếu nhi", "tăng trưởng"], t: "công cụ", u: "/cong-cu/nhu-cau-dinh-duong-tre-em", k: 0, e: "👶" },
  { n: "Tương tác thuốc-thực phẩm", s: "tuong-tac-thuoc-thuc-pham", a: ["thuốc", "kháng sinh", "tương kỵ"], t: "công cụ", u: "/cong-cu/tuong-tac-thuoc-thuc-pham", k: 0, e: "💊" },
  { n: "Đường trong đồ uống", s: "duong-do-uong", a: ["nước ngọt", "đường", "calo lỏng"], t: "công cụ", u: "/cong-cu/duong-do-uong", k: 0, e: "🥤" },
  { n: "Lập thực đơn tuần", s: "lap-thuc-don-tuan", a: ["kế hoạch", "bữa ăn", "meal prep"], t: "công cụ", u: "/cong-cu/lap-thuc-don-tuan", k: 0, e: "📋" },
];

const allItems = [
  ...foods.map(f => ({ slug: f.slug, name: f.name, aliases: f.aliases, type: "thực phẩm", url: `/thuc-pham/${f.slug}`, nutrients: f.nutrients, emoji: "" })),
  ...recipes.map(r => {
    const n = calculateRecipe(r);
    return { slug: r.slug, name: r.name, aliases: r.aliases, type: "món ăn", url: `/mon-an/${r.slug}`, nutrients: n, emoji: "" };
  }),
  ...articleItems,
  ...toolItems,
];
const dataPayload = allItems.map(({ name, slug, aliases, type, url, nutrients, emoji }) => ({
  n: name, s: slug, a: aliases ?? [], t: type, u: url, k: Math.round(nutrients && nutrients.energyKcal ? nutrients.energyKcal : 0), e: emoji || ""
}));
const jsonPayload = JSON.stringify(dataPayload);
---

<autocomplete-search>
  <div class="ac-search-wrapper">
    <div class="ac-search-row">
      <input type="text" class="ac-input" placeholder="Tìm thực phẩm, món ăn, bài viết, công cụ..." aria-label="Tìm kiếm" autocomplete="off" />
      <button class="ac-submit">🔍</button>
    </div>
    <div class="ac-dropdown" style="display: none;"></div>
  </div>
  <div class="ac-suggestions">
    <span class="ac-suggestion-label">Gợi ý nhanh:</span>
    <button class="ac-chip" data-q="bmi">⚖️ BMI</button>
    <button class="ac-chip" data-q="tiểu đường">🩸 tiểu đường</button>
    <button class="ac-chip" data-q="đạm">🥩 nhu cầu đạm</button>
    <button class="ac-chip" data-q="phở bò">🍜 phở bò</button>
    <button class="ac-chip" data-q="trứng">🥚 trứng</button>
    <button class="ac-chip" data-q="bún">🍜 bún</button>
  </div>
  <!-- Hidden container with search data - Astro evaluates {expression} in text content -->
  <div id="search-payload" style="display:none">{jsonPayload}</div>
</autocomplete-search>

<script is:inline>
(function() {
  var payloadEl = document.getElementById('search-payload');
  if (!payloadEl) return;
  var raw = payloadEl.textContent;
  if (!raw) return;
  var PAYLOAD = JSON.parse(raw);
  var el = document.querySelector('autocomplete-search');
  if (!el) return;
  var input = el.querySelector('.ac-input');
  var dropdown = el.querySelector('.ac-dropdown');

  function normalize(str) {
    return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
  }

  function filterItems(q) {
    var lower = normalize(q);
    var results = [];
    for (var i = 0; i < PAYLOAD.length; i++) {
      var item = PAYLOAD[i];
      var haystack = normalize([item.n, item.s].concat(item.a || []).join(' '));
      if (haystack.indexOf(lower) !== -1) {
        results.push(item);
        if (results.length >= 8) break;
      }
    }
    return results;
  }

  function showDropdown(results) {
    if (results.length === 0) {
      dropdown.style.display = 'none';
      return;
    }
    var html = '';
    for (var i = 0; i < results.length; i++) {
      var r = results[i];
      var kcalHtml = r.k > 0 ? '<span class="ac-item-kcal">' + r.k + ' kcal</span>' : '';
      var emojiHtml = r.e ? '<span class="ac-item-emoji">' + r.e + '</span>' : '';
      html += '<a class="ac-item" href="' + r.u + '">' +
        '<span class="ac-item-name">' + emojiHtml + r.n + '</span>' +
        '<span class="ac-item-meta">' +
          '<span class="ac-item-type ' + (r.t === 'bài viết' ? 'bai-viet' : r.t === 'công cụ' ? 'cong-cu' : '') + '">' + r.t + '</span>' +
          kcalHtml +
        '</span>' +
      '</a>';
    }
    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
  }

  input.addEventListener('input', function() {
    var q = this.value.trim();
    if (q.length < 1) {
      dropdown.style.display = 'none';
      return;
    }
    var results = filterItems(q);
    showDropdown(results);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      dropdown.style.display = 'none';
      this.blur();
    }
    if (e.key === 'Enter') {
      dropdown.style.display = 'none';
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.value);
    }
  });

  document.addEventListener('click', function(e) {
    if (!el.contains(e.target)) dropdown.style.display = 'none';
  });

  el.querySelectorAll('.ac-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.dataset.q);
    });
  });

  el.querySelector('.ac-submit').addEventListener('click', function() {
    window.location.href = '/tim-kiem?q=' + encodeURIComponent(input.value);
  });
})();
</script>

<style>
  autocomplete-search { display: block; }
  .ac-search-wrapper { position: relative; }
  .ac-search-row {
    display: flex;
    gap: 0;
    border: 2px solid var(--brand);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elevated);
    transition: box-shadow 0.2s;
  }
  .ac-search-row:focus-within {
    box-shadow: 0 0 0 4px var(--brand-light);
  }
  .ac-input {
    flex: 1;
    border: none;
    min-height: 52px;
    padding: 0 16px;
    font-size: 1rem;
    background: transparent;
    color: var(--ink);
  }
  .ac-input:focus { outline: none; box-shadow: none; }
  .ac-submit {
    background: var(--brand);
    color: white;
    border: none;
    padding: 0 20px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .ac-submit:hover { background: var(--brand-dark); }
  .ac-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    z-index: 50;
    overflow: hidden;
  }
  .ac-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    transition: background 0.15s;
    border-bottom: 1px solid var(--line-light);
  }
  .ac-item:last-child { border-bottom: none; }
  .ac-item:hover { background: var(--line-light); }
  .ac-item-name { font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 6px; }
  .ac-item-emoji { font-size: 1rem; flex-shrink: 0; }
  .ac-item-meta { display: flex; gap: 8px; align-items: center; }
  .ac-item-type {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    font-weight: 500;
  }
  .ac-item-kcal {
    font-size: 0.8rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-item-type.bai-viet { background: #e3f2fd; color: #1565c0; }
  .ac-item-type.cong-cu { background: #fce4ec; color: #c62828; }
  .ac-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    align-items: center;
  }
  .ac-suggestion-label {
    font-size: 0.82rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-chip {
    padding: 8px 14px;
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s;
    font-weight: 500;
  }
  .ac-chip:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
  }
</style>
