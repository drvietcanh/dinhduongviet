<autocomplete-search>
  <div class="ac-backdrop" style="display: none;"></div>
  <div class="ac-search-wrapper">
    <div class="ac-search-row">
      <span class="ac-search-icon">🔍</span>
      <input type="text" class="ac-input" placeholder="Tìm thực phẩm, món ăn, bệnh, công cụ..." aria-label="Tìm kiếm" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="home-search-suggestions" aria-expanded="false" />
      <div class="ac-actions">
        <button class="ac-clear" style="display: none;" aria-label="Xóa">✕</button>
        <div class="ac-hotkey">Ctrl K</div>
        <button class="ac-submit" style="display: none;">🔍</button>
      </div>
    </div>
    <div class="ac-dropdown" id="home-search-suggestions" role="listbox" aria-label="Gợi ý tìm kiếm" style="display: none;"></div>
  </div>
  <div class="ac-suggestions">
    <span class="ac-suggestion-label">Gợi ý nhanh:</span>
    <button class="ac-chip" data-q="bmi">⚖️ BMI</button>
    <button class="ac-chip" data-q="đái tháo đường">🩸 đái tháo đường</button>
    <button class="ac-chip" data-q="đạm">🥩 nhu cầu đạm</button>
    <button class="ac-chip" data-q="phở bò">🍜 phở bò</button>
    <button class="ac-chip" data-q="trứng">🥚 trứng</button>
    <button class="ac-chip" data-q="bún">🍜 bún</button>
  </div>
</autocomplete-search>

<script is:inline>
(function() {
  var PAYLOAD = [];
  var payloadPromise = null;
  var el = document.querySelector('autocomplete-search');
  if (!el) return;
  var input = el.querySelector('.ac-input');
  var dropdown = el.querySelector('.ac-dropdown');
  var backdrop = el.querySelector('.ac-backdrop');
  var clearBtn = el.querySelector('.ac-clear');

  function itemUrl(item) {
    if (item.type === 'food') return '/thuc-pham/' + item.slug;
    if (item.type === 'recipe') return '/mon-an/' + item.slug;
    if (item.type === 'tool') return '/cong-cu/' + item.slug;
    if (item.type === 'hub') return '/theo-benh/' + item.slug;
    if (item.slug.indexOf('dung-tin-ngay-') === 0) return '/dung-tin-ngay/' + item.slug;
    return '/kien-thuc-dinh-duong/' + item.slug;
  }

  function loadPayload() {
    if (payloadPromise) return payloadPromise;
    payloadPromise = fetch('/api/search-index.json')
      .then(function(res) { if (!res.ok) throw new Error('search-index'); return res.json(); })
      .then(function(items) {
        PAYLOAD = items.map(function(item) {
          return {
            n: item.name,
            s: item.slug,
            a: item.aliases || [],
            t: item.type === 'food' ? 'thực phẩm' : item.type === 'recipe' ? 'món ăn' : item.type === 'tool' ? 'công cụ' : item.type === 'hub' ? 'theo bệnh' : 'bài viết',
            u: itemUrl(item),
            k: Math.round(item.kcal || 0),
            e: item.type === 'article' ? '📄' : item.type === 'hub' ? (item.emoji || '🩺') : ''
          };
        });
      })
      .catch(function() { PAYLOAD = []; });
    return payloadPromise;
  }

  // Hotkey Ctrl+K
  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      input.focus();
    }
  });

  // Clear button logic
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      input.value = '';
      dropdown.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      backdrop.style.display = 'none';
      clearBtn.style.display = 'none';
      input.focus();
    });
  }

  function escapeHtml(text) {
    return String(text || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function highlightHtml(text, q) {
    var safeText = escapeHtml(text);
    if (!q) return safeText;
    try {
      var safeQ = escapeHtml(q).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var regex = new RegExp('(' + safeQ + ')', 'gi');
      return safeText.replace(regex, '<mark>$1</mark>');
    } catch (e) {
      return safeText;
    }
  }

  function normalize(str) {
    return str.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  function matchesSearchText(text, q) {
    if (!q) return true;
    if (q.length <= 3 || q.indexOf(' ') !== -1) {
      return (' ' + text + ' ').indexOf(' ' + q + ' ') !== -1;
    }
    return text.indexOf(q) !== -1;
  }

  function fieldScore(value, q, rawQ) {
    var raw = String(value || '').toLowerCase();
    var text = normalize(raw);
    if (!text || !q) return 0;
    if (text === q || raw === rawQ) return 120;
    if (text.indexOf(q + ' ') === 0 || raw.indexOf(rawQ) === 0) return 90;
    if ((' ' + text + ' ').indexOf(' ' + q + ' ') !== -1) return 70;
    if (text.indexOf(q) !== -1) return 35;
    return 0;
  }

  function aliasIntentBonus(rawText, q, rawQ) {
    var raw = String(rawText || '').toLowerCase();
    if (q === 'ngo' && rawQ.indexOf('ngò') !== -1) return raw.indexOf('ngò') !== -1 ? 32 : (raw.indexOf('ngô') !== -1 ? -35 : 0);
    if (q === 'ngo') return raw.indexOf('ngô') !== -1 ? 32 : (raw.indexOf('ngò') !== -1 ? -35 : 0);
    if (q === 'bap') return raw.indexOf('bắp cải') !== -1 || raw.indexOf('đậu bắp') !== -1 ? -20 : (raw.indexOf('bắp') !== -1 || raw.indexOf('ngô') !== -1 ? 24 : 0);
    if (q === 'lon') return raw.indexOf('lợn') !== -1 ? 36 : (raw.indexOf('lòng') !== -1 || raw.indexOf('lộn') !== -1 ? -45 : 0);
    if (q === 'lac') return raw.indexOf('lạc') !== -1 || raw.indexOf('đậu phộng') !== -1 ? 32 : (raw.indexOf('lắc') !== -1 ? -35 : 0);
    if (q === 'ca phe') return raw.indexOf('cà phê') !== -1 || raw.indexOf('cafe') !== -1 ? 32 : 0;
    if (q === 'tom su') return raw.indexOf('tôm sú') !== -1 ? 32 : 0;
    if (q === 'gao lat' || q === 'gao lut' || q === 'com gao lut') return raw.indexOf('gạo lứt') !== -1 || raw.indexOf('gạo lật') !== -1 ? 24 : 0;
    return 0;
  }

  function searchScore(item, q, rawQ) {
    if (!q) return 1;
    var fields = [item.n, item.s].concat(item.a || []);
    var best = 0;
    for (var i = 0; i < fields.length; i++) {
      best = Math.max(best, fieldScore(fields[i], q, rawQ));
    }
    var rawText = fields.join(' ');
    best += aliasIntentBonus(rawText, q, rawQ);
    if (item.t === 'thực phẩm') best += 3;
    return best;
  }

  function filterItems(q) {
    var lower = normalize(q);
    var rawQ = String(q || '').toLowerCase().trim();
    var results = [];
    for (var i = 0; i < PAYLOAD.length; i++) {
      var item = PAYLOAD[i];
      var haystack = normalize([item.n, item.s].concat(item.a || []).join(' '));
      var score = searchScore(item, lower, rawQ);
      if (score > 0 && (matchesSearchText(haystack, lower) || score >= 70)) {
        results.push({ item: item, score: score });
      }
    }
    results.sort(function(a, b) {
      if (b.score !== a.score) return b.score - a.score;
      return a.item.n.localeCompare(b.item.n, 'vi');
    });
    return results.slice(0, 8).map(function(row) { return row.item; });
  }

  function showDropdown(results) {
    if (results.length === 0) {
      dropdown.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      return;
    }
    var html = '';
    for (var i = 0; i < results.length; i++) {
      var r = results[i];
      var kcalHtml = r.k > 0 ? '<span class="ac-item-kcal">' + r.k + ' kcal</span>' : '';
      var emojiHtml = r.e ? '<span class="ac-item-emoji">' + r.e + '</span>' : '';
      html += '<a class="ac-item" role="option" href="' + escapeHtml(r.u) + '">' +
        '<span class="ac-item-name">' + emojiHtml + highlightHtml(r.n, input.value.trim()) + '</span>' +
        '<span class="ac-item-meta">' +
          '<span class="ac-item-type ' + (r.t === 'bài viết' ? 'bai-viet' : r.t === 'công cụ' ? 'cong-cu' : '') + '">' + escapeHtml(r.t) + '</span>' +
          kcalHtml +
        '</span>' +
      '</a>';
    }
    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
    input.setAttribute('aria-expanded', 'true');
    if (backdrop) backdrop.style.display = 'block';
  }

  input.addEventListener('focus', loadPayload, { once: true });
  input.addEventListener('input', function() {
    var q = this.value.trim();
    if (clearBtn) clearBtn.style.display = q.length > 0 ? 'block' : 'none';
    if (q.length < 1) {
      dropdown.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.style.display = 'none';
      return;
    }
    loadPayload().then(function() { showDropdown(filterItems(q)); });
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      dropdown.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      this.blur();
    }
    if (e.key === 'Enter') {
      dropdown.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.value);
    }
  });

  document.addEventListener('click', function(e) {
    if (!el.contains(e.target)) {
      dropdown.style.display = 'none';
      if (backdrop) backdrop.style.display = 'none';
    }
  });

  el.querySelectorAll('.ac-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      window.location.href = '/tim-kiem?q=' + encodeURIComponent(this.dataset.q);
    });
  });

  el.querySelector('.ac-submit').addEventListener('click', function() {
    window.location.href = '/tim-kiem?q=' + encodeURIComponent(input.value);
  });
})();
</script>

<style>
  autocomplete-search { display: block; }
  .ac-search-wrapper { position: relative; }
  .ac-backdrop {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
    z-index: 40;
  }
  .ac-search-wrapper { position: relative; z-index: 50; }
  .ac-search-row {
    display: flex; align-items: center;
    border: 1px solid color-mix(in srgb, var(--card-border) 70%, transparent);
    border-radius: 24px;
    background: color-mix(in srgb, var(--card) 88%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 4px 8px;
  }
  .ac-search-row:focus-within {
    background: var(--card);
    box-shadow: var(--shadow), 0 0 0 3px var(--brand-light2);
    transform: translateY(-2px);
  }
  .ac-search-icon { padding: 0 12px; font-size: 1.2rem; color: var(--ink-tertiary); }
  .ac-actions { display: flex; align-items: center; gap: 8px; padding-right: 8px; }
  .ac-hotkey {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 6px;
    padding: 4px 8px; font-size: 0.75rem; font-weight: 700; color: var(--ink-secondary);
    pointer-events: none;
  }
  .ac-clear {
    background: var(--bg-soft); border: none; border-radius: 50%;
    width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; color: var(--ink-tertiary); cursor: pointer; transition: background 0.2s;
  }
  .ac-clear:hover { background: var(--line-light); color: var(--ink); }
  mark { background: var(--brand-light); color: var(--brand-dark); border-radius: 3px; padding: 0 2px; font-weight: 700; }
  .ac-dropdown {
    border: none;
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    margin-top: 12px;
  }
  .ac-input { padding: 0; min-height: 48px; }
  .ac-search-row:focus-within {
    box-shadow: 0 0 0 4px var(--brand-light);
  }
  .ac-input {
    flex: 1;
    border: none;
    min-height: 52px;
    padding: 0 16px;
    font-size: 1rem;
    background: transparent;
    color: var(--ink);
  }
  .ac-input:focus { outline: none; box-shadow: none; }
  .ac-submit {
    background: var(--brand);
    color: white;
    border: none;
    padding: 0 20px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .ac-submit:hover { background: var(--brand-dark); }
  .ac-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    z-index: 50;
    overflow: hidden;
  }
  .ac-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    transition: background 0.15s;
    border-bottom: 1px solid var(--line-light);
  }
  .ac-item:last-child { border-bottom: none; }
  .ac-item:hover { background: var(--line-light); }
  .ac-item-name { font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 6px; }
  .ac-item-emoji { font-size: 1rem; flex-shrink: 0; }
  .ac-item-meta { display: flex; gap: 8px; align-items: center; }
  .ac-item-type {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    font-weight: 500;
  }
  .ac-item-kcal {
    font-size: 0.8rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-item-type.bai-viet {
    background: color-mix(in srgb, #3b82f6 14%, var(--card));
    color: color-mix(in srgb, #1d4ed8 80%, var(--ink));
  }
  .ac-item-type.cong-cu {
    background: color-mix(in srgb, #ec4899 13%, var(--card));
    color: color-mix(in srgb, #be185d 78%, var(--ink));
  }
  .ac-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    align-items: center;
  }
  .ac-suggestion-label {
    font-size: 0.82rem;
    color: var(--ink-tertiary);
    font-weight: 500;
  }
  .ac-chip {
    padding: 8px 14px;
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s;
    font-weight: 500;
  }
  .ac-chip:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
  }
</style>
