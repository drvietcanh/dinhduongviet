---
import { nutrientLabels, type NutrientValues } from "../data/nutrition";
import { formatValue, primaryNutrients } from "../lib/nutrition";

const { nutrients } = Astro.props as { nutrients: NutrientValues };
---

<div class="grid three">
  {primaryNutrients.map((key) => {
    const meta = nutrientLabels[key];
    return (
      <div class="nutrient-stat">
        <span class="nutrient-label">{meta.label}</span>
        <strong class="nutrient-value">{formatValue(nutrients[key])}</strong>
        <span class="nutrient-unit">{nutrients[key] === undefined ? "chưa có dữ liệu" : meta.unit}</span>
      </div>
    );
  })}
</div>

<style>
  .nutrient-stat {
    display: flex;
    min-height: 102px;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px 15px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--card) 92%, var(--bg-soft));
  }

  .nutrient-label {
    color: var(--ink-secondary);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .nutrient-value {
    margin-top: 10px;
    font-size: 1.08rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .nutrient-unit {
    margin-top: 6px;
    color: var(--ink-tertiary);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .nutrient-stat {
      min-height: 92px;
      padding: 12px 13px;
    }

    .nutrient-value {
      font-size: 1rem;
    }
  }
</style>
