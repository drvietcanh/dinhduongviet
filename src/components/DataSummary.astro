---
import { dataSummary } from "../lib/nutrition";

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const summary = dataSummary();
const topCategories = summary.categories.slice(0, 6);
const maxCategoryCount = topCategories.length > 0 ? Math.max(...topCategories.map((item) => item.count)) : 0;
---

<section class:list={["section", compact && "summary-compact-section"]}>
  <div class:list={["grid", "three", compact && "summary-compact-grid"]}>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Thực phẩm</span>
      <strong>{summary.totalFoods}</strong>
      <p class="muted">mục theo 100g phần ăn được</p>
    </div>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Món ăn</span>
      <strong>{summary.totalRecipes}</strong>
      <p class="muted">món tính từ công thức định lượng</p>
    </div>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Nhóm thực phẩm</span>
      <strong>{summary.totalCategories}</strong>
      <p class="muted">nhóm đang có trong dữ liệu</p>
    </div>
  </div>

  {!compact && (
    <div class="card" style="margin-top: 16px;">
      <div class="summary-head">
        <div>
          <h2>Thống kê theo nhóm</h2>
          <p class="muted">Các nhóm nhiều dữ liệu nhất hiện tại.</p>
        </div>
        <a class="button secondary" href="/thong-ke">Xem đầy đủ</a>
      </div>
      <div class="category-bars">
        {topCategories.map((item) => {
          const pct = summary.totalFoods > 0 ? Math.round((item.count / summary.totalFoods) * 100) : 0;
          const width = maxCategoryCount > 0 ? Math.max(12, Math.round((item.count / maxCategoryCount) * 100)) : 0;
          return (
            <a class="category-row" href={`/thuc-pham?category=${encodeURIComponent(item.category)}#food-results`}>
              <span class="category-name">{item.category}</span>
              <div class="bar" aria-hidden="true"><span style={`width: ${width}%`}></span></div>
              <strong>{item.count}<small>{pct}% dữ liệu</small></strong>
            </a>
          );
        })}
      </div>
    </div>
  )}
</section>

<style>
  .summary-compact-section {
    margin-top: 10px;
  }
  .summary-compact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .summary-compact-stat {
    padding: 14px 16px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    background: var(--card);
  }
  .summary-compact-stat .muted {
    font-size: 0.76rem;
  }
  .summary-compact-stat strong {
    display: block;
    margin-top: 4px;
    font-size: 1.8rem;
    line-height: 1;
  }
  .summary-compact-stat p.muted {
    margin-top: 6px;
    line-height: 1.45;
  }
  .summary-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .summary-head .button.secondary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
  }
  .category-bars {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .category-row {
    display: grid;
    grid-template-columns: minmax(110px, 160px) minmax(0, 1fr) 44px;
    gap: 12px;
    align-items: center;
    color: var(--ink);
  }
  .category-name {
    font-weight: 600;
  }
  .category-row strong {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
    gap: 4px;
  }
  .category-row strong small {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-tertiary);
  }
  .category-row:hover span:first-child {
    color: var(--brand);
  }
  .bar {
    height: 12px;
    border-radius: 999px;
    background: #edf1e9;
    overflow: hidden;
    position: relative;
  }
  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand) 0%, #34d399 100%);
    transition: width var(--transition);
    box-shadow: 0 0 0 1px rgba(5, 150, 105, 0.08) inset;
  }
  @media (max-width: 760px) {
    .summary-compact-section {
      margin-top: 6px;
    }
    .summary-compact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .summary-compact-stat {
      padding: 12px 10px;
    }
    .summary-compact-stat .muted {
      font-size: 0.72rem;
    }
    .summary-compact-stat strong {
      font-size: 1.28rem;
    }
    .summary-compact-stat p.muted {
      font-size: 0.72rem;
      margin-top: 4px;
      line-height: 1.35;
    }
    .summary-head {
      align-items: flex-start;
      gap: 10px;
    }
    .summary-head h2 {
      font-size: 1.22rem;
      line-height: 1.2;
    }
    .summary-head .muted {
      font-size: 0.82rem;
      line-height: 1.45;
    }
    .summary-head .button.secondary {
      min-height: 38px;
      font-size: 0.82rem;
      padding: 0 12px;
    }
    .category-row {
      grid-template-columns: minmax(88px, 108px) minmax(0, 1fr) 52px;
      gap: 8px;
      align-items: center;
    }
    .category-row span:first-child {
      font-size: 0.82rem;
      line-height: 1.35;
    }
    .category-row strong {
      font-size: 0.94rem;
    }
    .category-row strong small {
      font-size: 0.64rem;
    }
    .bar {
      height: 10px;
    }
  }
</style>
