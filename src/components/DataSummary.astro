---
import { dataSummary } from "../lib/nutrition";

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const summary = dataSummary();
const topCategories = summary.categories.slice(0, 6);
---

<section class:list={["section", compact && "summary-compact-section"]}>
  <div class:list={["grid", "three", compact && "summary-compact-grid"]}>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Thực phẩm</span>
      <strong>{summary.totalFoods}</strong>
      <p class="muted">mục theo 100g phần ăn được</p>
    </div>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Món ăn</span>
      <strong>{summary.totalRecipes}</strong>
      <p class="muted">món tính từ công thức định lượng</p>
    </div>
    <div class:list={["stat", compact && "summary-compact-stat"]}>
      <span class="muted">Nhóm thực phẩm</span>
      <strong>{summary.totalCategories}</strong>
      <p class="muted">nhóm đang có trong dữ liệu</p>
    </div>
  </div>

  {!compact && (
    <div class="card" style="margin-top: 16px;">
      <div class="summary-head">
        <div>
          <h2>Thống kê theo nhóm</h2>
          <p class="muted">Các nhóm nhiều dữ liệu nhất hiện tại.</p>
        </div>
        <a class="button secondary" href="/thong-ke">Xem đầy đủ</a>
      </div>
      <div class="category-bars">
        {topCategories.map((item) => {
          const width = Math.max(12, Math.round((item.count / summary.totalFoods) * 100));
          return (
            <a class="category-row" href={`/thuc-pham#${encodeURIComponent(item.category)}`}>
              <span>{item.category}</span>
              <div class="bar"><span style={`width: ${width}%`}></span></div>
              <strong>{item.count}</strong>
            </a>
          );
        })}
      </div>
    </div>
  )}
</section>

<style>
  .summary-compact-section {
    margin-top: 10px;
  }
  .summary-compact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .summary-compact-stat {
    padding: 14px 16px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    background: var(--card);
  }
  .summary-compact-stat .muted {
    font-size: 0.76rem;
  }
  .summary-compact-stat strong {
    display: block;
    margin-top: 4px;
    font-size: 1.8rem;
    line-height: 1;
  }
  .summary-compact-stat p.muted {
    margin-top: 6px;
    line-height: 1.45;
  }
  .summary-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .summary-head .button.secondary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
  }
  .category-bars {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .category-row {
    display: grid;
    grid-template-columns: minmax(110px, 160px) minmax(0, 1fr) 44px;
    gap: 12px;
    align-items: center;
    color: var(--ink);
  }
  .category-row:hover span:first-child {
    color: var(--brand);
  }
  .bar {
    height: 10px;
    border-radius: 999px;
    background: #edf1e9;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
  }
  @media (max-width: 760px) {
    .summary-compact-section {
      margin-top: 6px;
    }
    .summary-compact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .summary-compact-stat {
      padding: 12px 10px;
    }
    .summary-compact-stat .muted {
      font-size: 0.72rem;
    }
    .summary-compact-stat strong {
      font-size: 1.28rem;
    }
    .summary-compact-stat p.muted {
      font-size: 0.72rem;
      margin-top: 4px;
      line-height: 1.35;
    }
    .summary-head,
    .category-row {
      grid-template-columns: 1fr;
    }
    .summary-head {
      align-items: flex-start;
    }
    .category-row {
      gap: 6px;
    }
  }
</style>
