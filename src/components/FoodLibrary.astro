      var url = window.location.pathname + (next.toString() ? '?' + next.toString() : '') + (window.location.hash === '#food-results' ? '#food-results' : '');
      window.history.replaceState({}, '', url);
    }
    function refresh(resetLimit, shouldSyncUrl) { if (resetLimit) visibleLimit = BATCH_SIZE; render(); if (shouldSyncUrl) updateUrl(); }
    function applyUrlState() {
      if (foodSearch && params.get('q')) foodSearch.value = params.get('q');
      if (categoryFilter && params.get('category') && categoryFilter.querySelector('option[value="' + CSS.escape(params.get('category')) + '"]')) categoryFilter.value = params.get('category');
      if (profileFilter && params.get('profile')) profileFilter.value = params.get('profile');
      if (sortSelect && params.get('sort') && sortSelect.querySelector('option[value="' + CSS.escape(params.get('sort')) + '"]')) sortSelect.value = params.get('sort');
      if (params.get('tag') && document.querySelector('.tag-filter[data-filter="' + CSS.escape(params.get('tag')) + '"]')) activeTag = params.get('tag');
      [['maxKcal', maxKcal], ['minProtein', minProtein], ['maxCarb', maxCarb], ['maxSodium', maxSodium]].forEach(function(pair) { if (pair[1] && params.get(pair[0])) pair[1].value = params.get(pair[0]); });
    }
    function focusResults() { document.getElementById('food-results').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    function resetAll() {
      if (foodSearch) foodSearch.value = '';
      if (categoryFilter) categoryFilter.value = 'all';
      if (profileFilter) profileFilter.value = 'all';
      [maxKcal, minProtein, maxCarb, maxSodium].forEach(function(input) { if (input) input.value = ''; });
      activeTag = 'all'; hideSuggestions(); refresh(true, true);
    }
    function start(data) {
      foods = (Array.isArray(data) ? data : []).filter(function(item) {
        var status = item[16] || '';
        return status !== 'candidate_pending_dietitian_review' && status !== 'recipe_estimate_only';
      });
      applyUrlState();
      render();
      if (grid) grid.setAttribute('aria-busy', 'false');
    }

    foodSearch && foodSearch.addEventListener('input', function() { renderSuggestions(); refresh(true, true); });
    clearSearch && clearSearch.addEventListener('click', function() { if (foodSearch) { foodSearch.value = ''; foodSearch.focus(); } hideSuggestions(); refresh(true, true); });
    [categoryFilter, sortSelect, profileFilter, maxKcal, minProtein, maxCarb, maxSodium].forEach(function(input) { input && input.addEventListener('input', function() { refresh(true, true); }); input && input.addEventListener('change', function() { refresh(true, true); }); });
    document.addEventListener('click', function(event) {
      var suggestion = event.target.closest('[data-suggestion-slug]');
      if (suggestion) { selectSuggestion(suggestion); return; }
      var clearFilter = event.target.closest('[data-clear-filter]');
      if (clearFilter) {
        var clearKey = clearFilter.getAttribute('data-clear-filter');
        if (clearKey === 'query' && foodSearch) foodSearch.value = '';
        if (clearKey === 'category' && categoryFilter) categoryFilter.value = 'all';
        if (clearKey === 'profile' && profileFilter) profileFilter.value = 'all';
        if (clearKey === 'tag') activeTag = 'all';
        if (clearKey === 'max-kcal' && maxKcal) maxKcal.value = '';
        if (clearKey === 'min-protein' && minProtein) minProtein.value = '';
        if (clearKey === 'max-carb' && maxCarb) maxCarb.value = '';
        if (clearKey === 'max-sodium' && maxSodium) maxSodium.value = '';
        hideSuggestions(); refresh(true, true); return;
      }
      var category = event.target.closest('[data-category-choice]');
      if (category) { if (categoryFilter) categoryFilter.value = category.getAttribute('data-category-choice'); hideSuggestions(); refresh(true, true); focusResults(); return; }
      var tag = event.target.closest('.tag-filter');
      if (tag) { activeTag = tag.getAttribute('data-filter') || 'all'; refresh(true, true); return; }
      var preset = event.target.closest('[data-search-preset]');
      if (preset) { if (foodSearch) { foodSearch.value = preset.getAttribute('data-search-preset') || ''; foodSearch.focus(); } hideSuggestions(); refresh(true, true); focusResults(); return; }
      var presetTag = event.target.closest('[data-search-tag]');
      if (presetTag) { activeTag = presetTag.getAttribute('data-search-tag') || 'all'; hideSuggestions(); refresh(true, true); focusResults(); return; }
      if (suggestionBox && !event.target.closest('.library-search-panel')) hideSuggestions();
    });
    reset && reset.addEventListener('click', resetAll);
    loadMore && loadMore.addEventListener('click', function() { visibleLimit += BATCH_SIZE; render(); });
    showAll && showAll.addEventListener('click', function() { visibleLimit = foods.length; render(); });
    foodSearch && foodSearch.addEventListener('keydown', function(event) {
      if (event.key === 'ArrowDown' && suggestionBox && !suggestionBox.hidden) { event.preventDefault(); setSuggestionActive(suggestionIndex + 1); }
      if (event.key === 'ArrowUp' && suggestionBox && !suggestionBox.hidden) { event.preventDefault(); setSuggestionActive(suggestionIndex - 1); }
      if (event.key === 'Enter' && suggestionBox && !suggestionBox.hidden) { var active = suggestionBox.querySelector('.food-search-suggestion[aria-selected="true"]') || suggestionBox.querySelector('.food-search-suggestion'); if (active) { event.preventDefault(); selectSuggestion(active); } }
      if (event.key === 'Escape') { hideSuggestions(); }
    });
    document.addEventListener('keydown', function(event) { if (event.key === '/' && document.activeElement !== foodSearch && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement && document.activeElement.tagName)) { event.preventDefault(); foodSearch && foodSearch.focus(); } });
    function loadFoodLibrary() {
      if (errorState) errorState.hidden = true;
      if (grid) { grid.hidden = false; grid.setAttribute('aria-busy', 'true'); }
      fetch('/api/foods-full.json').then(function(response) { if (!response.ok) throw new Error('Không tải được dữ liệu thực phẩm'); return response.json(); }).then(start).catch(function() { if (summary) summary.textContent = 'Không tải được thư viện thực phẩm.'; if (grid) { grid.innerHTML = ''; grid.hidden = true; grid.setAttribute('aria-busy', 'false'); } if (errorState) errorState.hidden = false; });
    }
    retryButton && retryButton.addEventListener('click', loadFoodLibrary);
    loadFoodLibrary();
  })();
</script>
