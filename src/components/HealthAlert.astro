---
// HealthAlert.astro — Cảnh báo dinh dưỡng thông minh theo bệnh lý
// Đưa vào trang thực phẩm và món ăn

export interface Props {
  nutrients: Record<string, number | null | undefined>;
  name: string;
  category?: string;
}

const { nutrients, name, category } = Astro.props;
const energy = nutrients.energyKcal;
const protein = nutrients.proteinG;
const fat = nutrients.fatG;
const carb = nutrients.carbG;
const sugar = nutrients.sugarG;
const fiber = nutrients.fiberG;
const sodium = nutrients.sodiumMg;
const potassium = nutrients.potassiumMg;
const calcium = nutrients.calciumMg;
const iron = nutrients.ironMg;
const saturatedFat = nutrients.saturatedFatG;
const gi = nutrients.glycemicIndex;

// Định nghĩa các ngưỡng cảnh báo
const warnings: { icon: string; title: string; advice: string; severity: "high" | "medium" | "info" }[] = [];

// Purine content is not available in the current food data; protein alone
// cannot determine whether a food is high or low in purines.

// 1. Đái tháo đường — GI, GL, carb, sugar
if (gi != null) {
  if (gi > 70) {
    warnings.push({
      icon: "🩸",
      title: "Cảnh báo Đái tháo đường",
      advice: `GI=${gi} thuộc nhóm cao theo thang phân loại. GI không dự đoán chính xác đường huyết cá nhân; khẩu phần, cách chế biến và món ăn kèm cũng ảnh hưởng kết quả.`,
      severity: "high",
    });
  } else if (gi >= 56) {
    warnings.push({
      icon: "🩸",
      title: "Lưu ý Đái tháo đường",
      advice: `GI=${gi} thuộc nhóm trung bình theo thang phân loại. Cần xét khẩu phần và đáp ứng cá nhân; con số này không thay thế theo dõi đường huyết.`,
      severity: "medium",
    });
  }
} else if (carb != null && sugar != null && carb > 40 && sugar > 10) {
  warnings.push({
    icon: "🩸",
    title: "Cảnh báo Đái tháo đường",
    advice: `Nhiều carb (${carb.toFixed(0)}g) và đường (${sugar.toFixed(1)}g)/100g. Người đái tháo đường nên hạn chế.`,
    severity: "high",
  });
} else if ((carb != null && carb > 30) || (sugar != null && sugar > 15)) {
  warnings.push({
    icon: "🩸",
    title: "Lưu ý Đái tháo đường",
    advice: `${carb != null ? `Lượng carb (${carb.toFixed(0)}g/100g)` : `Lượng đường (${sugar!.toFixed(1)}g/100g)`} ở mức cần kiểm soát khẩu phần nếu bạn bị đái tháo đường.`,
    severity: "medium",
  });
} else if (carb != null && fiber != null && carb <= 10 && sugar != null && sugar <= 3 && fiber >= 2) {
  warnings.push({
    icon: "🩸",
    title: "Carb và đường thấp theo dữ liệu",
    advice: `Mục này có carb ${carb.toFixed(0)}g, đường ${sugar.toFixed(1)}g và xơ ${fiber.toFixed(1)}g/100g. Đây không phải kết luận phù hợp cho từng người; vẫn cần tính khẩu phần và kế hoạch điều trị.`,
    severity: "info",
  });
}

// 3. Tăng huyết áp — natri cao
if (sodium != null && sodium > 600) {
  warnings.push({
    icon: "🫀",
    title: "Cảnh báo Tăng huyết áp",
    advice: `Rất nhiều natri (${sodium.toFixed(0)}mg). Người tăng huyết áp nên tránh hoặc ăn rất hạn chế.`,
    severity: "high",
  });
} else if (sodium != null && sodium > 200) {
  warnings.push({
    icon: "🫀",
    title: "Lưu ý Tăng huyết áp",
    advice: `Natri ở mức ${sodium.toFixed(0)}mg. Nếu ăn nhiều khẩu phần có thể vượt ngưỡng 2000mg/ngày.`,
    severity: "medium",
  });
} else if (sodium != null && potassium != null && sodium <= 50 && potassium >= 200) {
  warnings.push({
    icon: "🫀",
    title: "Natri thấp, kali tương đối cao",
    advice: `Theo dữ liệu trên 100g, natri thấp và kali tương đối cao. Không thể kết luận phù hợp chế độ DASH hoặc bệnh thận chỉ từ hai chỉ số này; người cần hạn chế kali nên hỏi chuyên gia.`,
    severity: "info",
  });
}

// 4. Bệnh thận mạn — ưu tiên cảnh báo gộp khi vừa kali cao vừa đạm cao
if (potassium != null && protein != null && protein >= 20 && potassium > 300) {
  warnings.push({
    icon: "🫘",
    title: "Cảnh báo Bệnh thận mạn",
    advice: `Vừa đạm cao (${protein.toFixed(0)}g) vừa kali cao (${potassium.toFixed(0)}mg/100g). Người bệnh thận mạn cần hạn chế hoặc tránh tùy giai đoạn.`,
    severity: "high",
  });
} else if (potassium != null && potassium > 400) {
  warnings.push({
    icon: "🫘",
    title: "Cảnh báo Bệnh thận mạn",
    advice: `Kali cao (${potassium.toFixed(0)}mg/100g). Người bệnh thận mạn giai đoạn 3-5 thường cần hạn chế.`,
    severity: "high",
  });
} else if (potassium != null && potassium > 250) {
  warnings.push({
    icon: "🫘",
    title: "Lưu ý Bệnh thận mạn",
    advice: `Kali ở mức trung bình-cao (${potassium.toFixed(0)}mg/100g). Nếu bạn bị bệnh thận mạn, nên cân đối khẩu phần theo tư vấn chuyên môn.`,
    severity: "medium",
  });
}

// 5. Gan nhiễm mỡ — chất béo + đường
if (fat != null && sugar != null && fat > 20 && sugar > 5) {
  warnings.push({
    icon: "🫁",
    title: "Cảnh báo Gan nhiễm mỡ",
    advice: `Nhiều chất béo (${fat.toFixed(0)}g) và đường (${sugar.toFixed(1)}g). Cả hai đều là yếu tố nguy cơ cho gan nhiễm mỡ.`,
    severity: "high",
  });
} else if ((fat != null && fat > 15) || (saturatedFat != null && saturatedFat > 5)) {
  warnings.push({
    icon: "🫁",
    title: "Lưu ý Gan nhiễm mỡ",
    advice: `Chất béo ở mức cần chú ý (${fat.toFixed(0)}g/100g). Người gan nhiễm mỡ nên hạn chế.`,
    severity: "medium",
  });
}

// 6. Loãng xương — canxi thấp + kết nối
if (calcium != null) {
  if (calcium >= 200) {
    warnings.push({
      icon: "🦴",
      title: "Tốt cho xương",
      advice: `Giàu canxi (${calcium.toFixed(0)}mg/100g). Hỗ trợ phòng ngừa loãng xương.`,
      severity: "info",
    });
  } else if (calcium < 20) {
    warnings.push({
      icon: "🦴",
      title: "Lưu ý Loãng xương",
      advice: `Lượng canxi ghi nhận thấp (${calcium.toFixed(0)}mg/100g), nên thực phẩm này đóng góp ít canxi ở khẩu phần tương đương. Không dùng chỉ số này để chẩn đoán thiếu canxi.`,
      severity: "medium",
    });
  }
}

// 7. Thiếu máu — sắt
if (iron != null) {
  if (iron >= 3) {
    warnings.push({
      icon: "🩸",
      title: "Giàu sắt",
      advice: `Lượng sắt ghi nhận tương đối cao (${iron.toFixed(1)}mg/100g). Hấp thu thực tế còn tùy dạng sắt và bữa ăn; thực phẩm này không thay thế chẩn đoán hay điều trị thiếu máu.`,
      severity: "info",
    });
  }
}

// 8. Béo phì — năng lượng cao
if (energy != null && energy > 300) {
  warnings.push({
    icon: "⚖️",
    title: "Cảnh báo Năng lượng cao",
    advice: `Năng lượng cao (${energy.toFixed(0)} kcal/100g). Cần kiểm soát khẩu phần nếu đang giảm cân.`,
    severity: "high",
  });
} else if (energy != null && energy > 200) {
  warnings.push({
    icon: "⚖️",
    title: "Lưu ý Năng lượng",
    advice: `Năng lượng ở mức trung bình-cao (${energy.toFixed(0)} kcal/100g). Nên ăn lượng vừa phải.`,
    severity: "medium",
  });
} else if (energy != null && fiber != null && energy <= 40 && fiber >= 2) {
  warnings.push({
    icon: "⚖️",
    title: "Thân thiện giảm cân",
    advice: `Ít calo (${energy.toFixed(0)} kcal), giàu xơ — phù hợp cho chế độ giảm cân.`,
    severity: "info",
  });
}

// Bỏ qua nếu không có warnings đáng kể
const significantWarnings = warnings.filter(w => w.severity !== "info");
if (significantWarnings.length === 0 && warnings.length <= 1) return;
---

{warnings.length > 0 && (
  <section class="section">
    <h2 style="margin-bottom: 12px;">⚠️ Cảnh báo dinh dưỡng</h2>
    <p class="muted" style="margin-bottom: 12px;">
      Đối chiếu tự động với một số bệnh cảnh thường gặp để nhắc điểm cần thận
      trọng khi đọc số liệu. Đây là lớp cảnh báo theo bệnh lý, không phải kết
      luận chẩn đoán hay chỉ định điều trị. Thư viện chưa có số liệu purin đo
      trực tiếp; không suy ra purin từ lượng đạm.
    </p>
    <div class="health-alerts">
      {warnings.map(w => (
        <div class={`alert alert-${w.severity}`}>
          <div class="alert-header">
            <span class="alert-icon">{w.icon}</span>
            <strong>{w.title}</strong>
          </div>
          <p class="alert-advice">{w.advice}</p>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .health-alerts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .alert {
    padding: 12px 16px;
    border-radius: 10px;
    border-left: 4px solid;
    background: var(--bg-card, var(--card));
  }
  .alert-high {
    border-left-color: #ef4444;
    background: color-mix(in srgb, #ef4444 10%, var(--card));
  }
  .alert-medium {
    border-left-color: #f59e0b;
    background: color-mix(in srgb, #f59e0b 11%, var(--card));
  }
  .alert-info {
    border-left-color: #22c55e;
    background: color-mix(in srgb, #22c55e 10%, var(--card));
  }
  .alert-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .alert-icon {
    font-size: 1.2em;
  }
  .alert-advice {
    margin: 0;
    font-size: 0.9em;
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  section.section h2 { font-size: 1.25rem; }
  @media (max-width: 640px) {
    .health-alerts {
      gap: 7px;
    }
    .alert {
      padding: 11px 13px;
      border-radius: 9px;
    }
    .alert-header {
      gap: 7px;
      margin-bottom: 3px;
    }
    .alert-icon {
      font-size: 1.08em;
    }
    .alert-advice {
      font-size: 0.84rem;
      line-height: 1.45;
    }
    section.section h2 {
      font-size: 1.14rem;
      margin-bottom: 10px !important;
    }
  }
  @media (max-width: 480px) {
    .alert {
      padding: 10px 12px;
    }
    .alert-header strong {
      font-size: 0.92rem;
      line-height: 1.3;
    }
    .alert-advice {
      font-size: 0.8rem;
      line-height: 1.4;
    }
  }
</style>
