---
import { canonicalAudienceList } from "../utils/audience";

export interface Props {
  title: string;
  slug: string;
  emoji: string;
  description: string;
  readTime: number;
  date: string;
  audience?: string[];
  tags?: string[];
  series?: string;
  prefix?: string; // URL prefix, default "/kien-thuc-dinh-duong"
}

const { title, slug, emoji, description, readTime, date, audience, tags, series, prefix = "/kien-thuc-dinh-duong" } = Astro.props;
const articlePrefix = series === "dung-tin-ngay" && slug.startsWith("canh-bao-hieu-lam-")
  ? "/kien-thuc-dinh-duong"
  : series
    ? `/${series}`
    : prefix;
const href = `${articlePrefix}/${slug}`;
const normalizedAudience = canonicalAudienceList(audience);

const audLabels: Record<string, { emoji: string; label: string }> = {
  diabetes: { emoji: "🩸", label: "Đái tháo đường" },
  hypertension: { emoji: "🫗", label: "Tăng huyết áp" },
  gout: { emoji: "🦶", label: "Gout" },
  kidney: { emoji: "🫘", label: "Thận" },
  "fatty-liver": { emoji: "🫁", label: "Gan nhiễm mỡ" },
  stomach: { emoji: "😣", label: "Dạ dày, tá tràng" },
  cardio: { emoji: "❤️", label: "Tim mạch" },
  respiratory: { emoji: "🫁", label: "Hô hấp" },
  elderly: { emoji: "👴", label: "Người cao tuổi" },
  pregnancy: { emoji: "🤰", label: "Thai kỳ" },
  children: { emoji: "🧒", label: "Trẻ em" },
  "weight-loss": { emoji: "⚖️", label: "Giảm cân" },
  vegan: { emoji: "🥬", label: "Ăn chay" },
  caregiver: { emoji: "👨‍👩‍👧‍👦", label: "Chăm sóc" },
};

const tagLabels: Record<string, { emoji: string; label: string }> = {
  "new-diagnosis": { emoji: "🆕", label: "Mới chẩn đoán" },
  "before-shopping": { emoji: "🛒", label: "Đi chợ" },
  "before-supplement": { emoji: "🏷️", label: "Mua sắm" },
  caregiver: { emoji: "👨‍👩‍👧‍👦", label: "Người chăm" },
  "ask-doctor": { emoji: "⚕️", label: "Hỏi bác sĩ" },
};
const primaryTag = tags?.map((t) => tagLabels[t]).find(Boolean) ?? null;
const primaryAudience = normalizedAudience.map((a) => audLabels[a]).find(Boolean) ?? null;
---

<a href={href} class="ac-card">
  <div class="ac-top">
    <span class="ac-emoji" aria-hidden="true">{emoji}</span>
    <div class="ac-info">
      <h3 class="ac-title">{title}</h3>
      <p class="ac-desc">{description}</p>
    </div>
  </div>
  <div class="ac-bottom">
    {(primaryTag || primaryAudience) && (
      <div class="ac-tags">
        {primaryTag && <span class="ac-prio-tag">{primaryTag.emoji} {primaryTag.label}</span>}
        {primaryAudience && <span class="ac-aud-tag" title={primaryAudience.label}>{primaryAudience.emoji} {primaryAudience.label}</span>}
      </div>
    )}
    <div class="ac-meta">
      <span>{readTime} phút</span>
      <span class="ac-dot">·</span>
      <span>{new Date(date).toLocaleDateString("vi-VN", { year: "numeric", month: "2-digit", day: "2-digit" })}</span>
    </div>
    <div class="ac-cta">
      <span>Đọc bài</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  .ac-card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition);
    box-shadow: var(--shadow-sm);
    min-height: 100%;
    position: relative;
    overflow: hidden;
  }
  .ac-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--brand), var(--accent));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ac-card:hover {
    border-color: var(--brand-light2);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .ac-card:hover::before {
    opacity: 1;
  }
  .ac-top {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  .ac-emoji {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--brand-light);
    font-size: 1.35rem;
    flex-shrink: 0;
    margin-top: 0;
  }
  .ac-info {
    flex: 1;
    min-width: 0;
  }
  .ac-title {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ac-desc {
    margin: 3px 0 0;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ac-bottom {
    margin-top: auto;
  }
  .ac-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 7px;
  }
  .ac-prio-tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--brand-light);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand);
    white-space: nowrap;
  }
  .ac-aud-tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--bg-elevated);
    font-size: 0.7rem;
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  .ac-meta {
    font-size: 0.72rem;
    color: var(--ink-tertiary);
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }
  .ac-meta span:last-child {
    white-space: nowrap;
  }
  .ac-cta {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
    align-items: center;
    gap: 5px;
  }
  .ac-cta span {
    color: var(--brand-dark);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .ac-dot { opacity: 0.4; }
  @media (max-width: 640px) {
    .ac-card {
      padding: 12px 13px;
    }
    .ac-title {
      font-size: 0.88rem;
    }
    .ac-desc {
      font-size: 0.77rem;
      -webkit-line-clamp: 2;
    }
    .ac-tags {
      margin-bottom: 7px;
    }
    .ac-prio-tag,
    .ac-aud-tag {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
