---
export interface Props {
  title: string;
  slug: string;
  emoji: string;
  description: string;
  readTime: number;
  date: string;
  audience?: string[];
  tags?: string[];
  series?: string;
  prefix?: string; // URL prefix, default "/kien-thuc-dinh-duong"
}

const { title, slug, emoji, description, readTime, date, audience, tags, series, prefix = "/kien-thuc-dinh-duong" } = Astro.props;
const articlePrefix = series === "dung-tin-ngay" && slug.startsWith("canh-bao-hieu-lam-")
  ? "/kien-thuc-dinh-duong"
  : series
    ? `/${series}`
    : prefix;
const href = `${articlePrefix}/${slug}`;

const audLabels: Record<string, { emoji: string; label: string }> = {
  diabetes: { emoji: "🩸", label: "Tiểu đường" },
  hypertension: { emoji: "🫗", label: "Cao huyết áp" },
  gout: { emoji: "🦶", label: "Gout" },
  kidney: { emoji: "🫘", label: "Thận" },
  "fatty-liver": { emoji: "🫁", label: "Gan nhiễm mỡ" },
  stomach: { emoji: "😣", label: "Dạ dày" },
  elderly: { emoji: "👴", label: "Người cao tuổi" },
  pregnancy: { emoji: "🤰", label: "Thai kỳ" },
  children: { emoji: "🧒", label: "Trẻ em" },
  "weight-loss": { emoji: "⚖️", label: "Giảm cân" },
  vegan: { emoji: "🥬", label: "Ăn chay" },
  caregiver: { emoji: "👨‍👩‍👧‍👦", label: "Chăm sóc" },
};

const tagLabels: Record<string, { emoji: string; label: string }> = {
  "new-diagnosis": { emoji: "🆕", label: "Mới chẩn đoán" },
  "before-shopping": { emoji: "🛒", label: "Đi chợ" },
  "before-supplement": { emoji: "🏷️", label: "Mua sắm" },
  caregiver: { emoji: "👨‍👩‍👧‍👦", label: "Người chăm" },
  "ask-doctor": { emoji: "⚕️", label: "Hỏi bác sĩ" },
};
---

<a href={href} class="ac-card">
  <div class="ac-top">
    <span class="ac-emoji">{emoji}</span>
    <div class="ac-info">
      <h3 class="ac-title">{title}</h3>
      <p class="ac-desc">{description}</p>
    </div>
  </div>
  <div class="ac-bottom">
    <div class="ac-tags">
      {tags && tags.length > 0 && tags.map(t => {
        const info = tagLabels[t];
        return info
          ? <span class="ac-prio-tag">{info.emoji} {info.label}</span>
          : null;
      })}
    </div>
    {audience && audience.length > 0 && (
      <div class="ac-audience">
        {audience.map(a => {
          const info = audLabels[a];
          return info
            ? <span class="ac-aud-tag" title={info.label}>{info.emoji} {info.label}</span>
            : null;
        })}
      </div>
    )}
    <div class="ac-meta">
      <span>{readTime} phút</span>
      <span class="ac-dot">·</span>
      <span>{new Date(date).toLocaleDateString("vi-VN", { year: "numeric", month: "2-digit", day: "2-digit" })}</span>
    </div>
  </div>
</a>

<style>
  .ac-card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 14px 16px;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition);
    box-shadow: var(--shadow-sm);
  }
  .ac-card:hover {
    border-color: var(--brand-light2);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .ac-top {
    display: flex;
    gap: 10px;
    margin-bottom: 8px;
  }
  .ac-emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .ac-info {
    flex: 1;
    min-width: 0;
  }
  .ac-title {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    font-weight: 700;
  }
  .ac-desc {
    margin: 3px 0 0;
    font-size: 0.78rem;
    color: var(--ink-secondary);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ac-bottom {
    margin-top: auto;
  }
  .ac-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 4px;
  }
  .ac-prio-tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--brand-light);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand);
    white-space: nowrap;
  }
  .ac-audience {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-bottom: 4px;
  }
  .ac-aud-tag {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--bg-elevated);
    font-size: 0.7rem;
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  .ac-meta {
    font-size: 0.72rem;
    color: var(--ink-tertiary);
    display: flex;
    gap: 4px;
  }
  .ac-dot { opacity: 0.4; }
</style>
