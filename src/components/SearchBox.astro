---
const { value = "", mobilePlaceholder = "Tìm món ăn, thực phẩm..." } = Astro.props;
---

<form class="card" action="/tim-kiem" method="get">
  <div class="search-kicker">Tìm nhanh trong thư viện</div>
  <div class="search-row">
    <input name="q" value={value} placeholder="Tìm thực phẩm hoặc món ăn: phở bò, thịt bò, trứng gà..." data-mobile-placeholder={mobilePlaceholder} aria-label="Từ khóa tìm kiếm" />
    <button class="button" type="submit">Tìm kiếm</button>
  </div>
  <div class="search-suggestions" aria-label="Gợi ý tìm kiếm">
    <span>Gợi ý:</span>
    <a href="/tim-kiem?q=đái tháo đường">đái tháo đường</a>
    <a href="/tim-kiem?q=tăng huyết áp">tăng huyết áp</a>
    <a href="/tim-kiem?q=phở bò">phở bò</a>
    <a href="/tim-kiem?q=triglyceride">triglyceride</a>
  </div>
</form>

<style>
  .search-kicker {
    margin-bottom: 8px;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .search-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .search-row input {
    flex: 1 1 240px;
    min-width: 0;
    min-height: 44px;
    padding: 12px 14px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    background: var(--card);
    color: var(--ink);
    font: inherit;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.72);
  }

  .search-row input:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
  }

  .search-row .button {
    flex: 0 0 auto;
    min-height: 44px;
    border-radius: 999px;
    font-weight: 800;
  }
  .search-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    color: var(--ink-tertiary);
    font-size: 0.82rem;
    align-items: center;
  }
  .search-suggestions a {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-secondary);
    font-weight: 650;
    text-decoration: none;
  }
  .search-suggestions a:hover {
    background: var(--brand-light);
    border-color: var(--brand-light2);
    color: var(--brand-dark);
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .search-row {
      gap: 8px;
    }
    .search-row input {
      min-height: 42px;
      padding: 9px 12px;
      font-size: 0.95rem;
      border-radius: 9px;
    }
    .search-row input::placeholder {
      font-size: 0.9rem;
    }
    .search-row .button {
      width: 100%;
      min-height: 42px;
      font-size: 0.92rem;
      padding: 9px 12px;
    }
    .search-suggestions {
      gap: 6px;
    }
  }
</style>

<script is:inline>
  (function() {
    var input = document.querySelector('.search-row input[data-mobile-placeholder]');
    if (!input) return;
    var desktopPlaceholder = input.getAttribute('placeholder') || '';
    var mobileValue = input.getAttribute('data-mobile-placeholder') || desktopPlaceholder;

    function syncPlaceholder() {
      input.setAttribute('placeholder', window.innerWidth <= 560 ? mobileValue : desktopPlaceholder);
    }

    syncPlaceholder();
    window.addEventListener('resize', syncPlaceholder);
  })();
</script>
