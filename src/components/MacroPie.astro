---
interface Props {
  proteinG: number;
  fatG: number;
  carbG: number;
  size?: number;
}
const { proteinG, fatG, carbG, size = 140 } = Astro.props;
const totalKcal = proteinG * 4 + fatG * 9 + carbG * 4;
const proteinKcal = proteinG * 4;
const fatKcal = fatG * 9;
const carbKcal = carbG * 4;
const proteinPct = totalKcal > 0 ? (proteinKcal / totalKcal) * 100 : 0;
const fatPct = totalKcal > 0 ? (fatKcal / totalKcal) * 100 : 0;
const carbPct = totalKcal > 0 ? (carbKcal / totalKcal) * 100 : 0;

// SVG arc helper
function describeArc(cx: number, cy: number, r: number, startAngle: number, endAngle: number): string {
  const startRad = ((startAngle - 90) * Math.PI) / 180;
  const endRad = ((endAngle - 90) * Math.PI) / 180;
  const x1 = cx + r * Math.cos(startRad);
  const y1 = cy + r * Math.sin(startRad);
  const x2 = cx + r * Math.cos(endRad);
  const y2 = cy + r * Math.sin(endRad);
  const largeArc = endAngle - startAngle > 180 ? 1 : 0;
  return `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} Z`;
}
const r = size / 2 - 4;
const cx = size / 2;
const cy = size / 2;
const slices: { pct: number; color: string; label: string; value: string }[] = [];
if (proteinPct > 0) slices.push({ pct: proteinPct, color: '#e0875a', label: 'Protein', value: `${Math.round(proteinG)}g` });
if (fatPct > 0) slices.push({ pct: fatPct, color: '#f0c050', label: 'Fat', value: `${Math.round(fatG)}g` });
if (carbPct > 0) slices.push({ pct: carbPct, color: '#41b87a', label: 'Carbs', value: `${Math.round(carbG)}g` });
let accum = 0;
const arcs = slices.map((s) => {
  const start = accum;
  const end = accum + s.pct;
  accum = end;
  return { ...s, d: describeArc(cx, cy, r, start, end) };
});
---

<div class="macro-pie" style={`width: ${size}px; height: ${size}px;`}>
  <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
    {arcs.map((arc) => (
      <path d={arc.d} fill={arc.color} />
    ))}
    <circle cx={cx} cy={cy} r={r * 0.45} fill="var(--card)" />
  </svg>
  <div class="pie-center">
    <strong>{Math.round(totalKcal)}</strong>
    <span class="muted">kcal</span>
  </div>
</div>
<div class="pie-legend">
  {slices.map((s, i) => (
    <div class="legend-item">
      <span class="dot" style={`background: ${s.color};`}></span>
      <span>{s.label} <span class="muted">{s.value}</span></span>
    </div>
  ))}
</div>

<style>
  .macro-pie {
    position: relative;
    display: inline-block;
  }
  .pie-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    line-height: 1.2;
  }
  .pie-center strong {
    display: block;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .pie-center .muted {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pie-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-top: 12px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .legend-item .muted {
    font-weight: 400;
  }
</style>
