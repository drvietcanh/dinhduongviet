---
import type { Food } from "../data/nutrition";
import { allTags, tagLabel, confidenceLabel, formatValue } from "../lib/nutrition";
import FoodIcon from "./FoodIcon.astro";

const { food, compact = false } = Astro.props as { food: Food; compact?: boolean };
const tags = allTags(food);
const kcal = food.nutrients.energyKcal;
const carb = food.nutrients.carbG ?? 0;
const protein = food.nutrients.proteinG ?? 0;
const fat = food.nutrients.fatG ?? 0;
const fiber = food.nutrients.fiberG ?? 0;
const sodium = food.nutrients.sodiumMg ?? "";
const potassium = food.nutrients.potassiumMg ?? "";
const gi = food.nutrients.glycemicIndex ?? "";
---

<a class="food-card card" href={`/thuc-pham/${food.slug}`}
  data-tags={tags.join(' ')}
  data-category={food.category}
  data-kcal={kcal}
  data-protein={protein}
  data-carb={carb}
  data-fat={fat}
  data-fiber={fiber}
  data-sodium={sodium}
  data-potassium={potassium}
  data-gi={gi}>
  <div class="food-icon-area" aria-hidden="true">
    <FoodIcon category={food.category} />
  </div>
  <div class="food-card-body">
    <span class="badge">{confidenceLabel(food.confidence)}</span>
    <h3>{food.name}</h3>
    <div class="food-macro">
      <span class="macro-kcal">{kcal} kcal</span>
      <span class="macro-sep">·</span>
      <span>Carb {formatValue(carb)}g</span>
      <span class="macro-sep">·</span>
      <span>Đạm {formatValue(protein)}g</span>
    </div>
    {!compact && <div class="food-tags">
      {tags.slice(0, 3).map(t => <span class="mini-tag">{tagLabel(t)}</span>)}
    </div>}
  </div>
</a>

<style>
  .food-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition: box-shadow 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .food-card::after {
    content: "";
    position: absolute;
    inset: 12px auto 12px 0;
    width: 4px;
    border-radius: 999px;
    background: var(--brand);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .food-card:hover {
    border-color: var(--brand-light2);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .food-card:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--brand) 45%, transparent);
    outline-offset: 3px;
  }
  .food-card:hover::after {
    opacity: 0.9;
  }
  .food-icon-area {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--bg-elevated);
    border: 1px solid rgba(148, 163, 184, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }
  .food-card-body { flex: 1; min-width: 0; }
  .food-card-body h3 {
    margin: 4px 0 4px;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .badge { font-size: 0.7rem; }
  .food-macro {
    font-size: 0.82rem;
    color: var(--ink-secondary);
    display: flex;
    gap: 4px;
    align-items: center;
    flex-wrap: wrap;
  }
  .macro-kcal {
    color: var(--ink);
    font-weight: 800;
  }
  .macro-sep { color: var(--card-border); }
  .food-tags { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
  .mini-tag {
    font-size: 0.68rem; padding: 1px 8px;
    border-radius: 999px; background: var(--brand-light);
    color: var(--brand); font-weight: 500;
  }
  [data-theme="dark"] .mini-tag {
    background: var(--brand-light2);
    color: #a7f3d0;
  }
  @media (max-width: 520px) {
    .food-card {
      align-items: flex-start;
      padding: 13px 14px;
      border-radius: 16px;
    }
    .food-icon-area {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      font-size: 1.55rem;
    }
    .food-macro {
      gap: 5px;
    }
  }
</style>
