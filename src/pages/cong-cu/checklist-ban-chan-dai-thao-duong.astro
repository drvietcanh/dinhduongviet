---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist chăm sóc bàn chân đái tháo đường";
const desc = "Bảng kiểm dinh dưỡng–tự chăm sóc giúp giảm nguy cơ loét bàn chân ở người đái tháo đường.";
const items = [
  "Tôi kiểm tra lòng/bàn chân và kẽ ngón mỗi ngày, dùng gương hoặc nhờ người hỗ trợ",
  "Tôi rửa chân bằng nước ấm vừa, lau khô kỹ và dưỡng ẩm tránh kẽ ngón",
  "Tôi mang giày vừa chân, tất sạch; không đi chân trần hoặc thử nước bằng chân",
  "Tôi không tự cắt chai/mắt cá, chọc phồng rộp hoặc bôi thuốc không rõ nguồn",
  "Tôi kiểm soát đường huyết, bỏ thuốc lá và tái khám chân theo lịch",
  "Tôi biết nơi liên hệ khi có vết xước, phồng rộp, đỏ/nóng, mủ hoặc đổi màu",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ban-chan-dai-thao-duong">
  <main class="foot-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm đái tháo đường</p>
      <h1>🦶 Checklist chăm sóc bàn chân</h1>
      <p>{desc} Đây là bảng nhắc việc, không thay thế khám bàn chân và đánh giá mạch máu/thần kinh.</p>
    </header>
    <form id="foot-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-foot /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm</h2>
      <p>Vết thương không lành, đỏ/nóng/sưng, mủ, mùi hôi, sốt, đau tăng, tê mất cảm giác hoặc ngón chân đổi màu.</p>
      <p class="warning">Không trì hoãn vì vết thương nhỏ và không tự dùng kháng sinh/thuốc bôi.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("foot-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-foot]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục kiểm tra chân hằng ngày và mang ghi chép khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ đái tháo đường hoặc điều dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .foot-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .foot-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
