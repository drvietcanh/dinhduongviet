---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist kiểu ăn DASH";
const desc = "Tự kiểm tra nhanh các thói quen chính của kiểu ăn DASH hỗ trợ tim mạch và huyết áp.";
const items = [
  ["vegetables", "Có rau không tinh bột trong ít nhất 2 bữa hôm nay"],
  ["fruit", "Có trái cây nguyên quả thay vì nước ép hoặc đồ ngọt"],
  ["wholegrain", "Có ngũ cốc nguyên hạt hoặc nguồn tinh bột giàu chất xơ"],
  ["legumes", "Có đậu, cá, trứng hoặc thịt nạc làm nguồn đạm"],
  ["dairy", "Nếu dùng sữa, ưu tiên loại ít béo và không thêm đường"],
  ["salt", "Nếm trước khi thêm muối/nước mắm; hạn chế món chế biến sẵn"],
  ["fat", "Ưu tiên dầu thực vật; hạn chế mỡ, da, thịt chế biến"],
  ["sugary", "Không dùng hoặc giảm rõ đồ uống có đường và bánh kẹo"],
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-dash">
  <main class="dash-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm hành vi</p>
      <h1>❤️ Checklist kiểu ăn DASH</h1>
      <p>{desc} Đây là công cụ giáo dục, không phải thang điểm chẩn đoán hay đơn thuốc.</p>
    </header>
    <form id="dash-form" class="card">
      <p class="hint">Đánh dấu những việc bạn đã làm hôm nay:</p>
      {items.map(([id, label]) => <label class="check"><input type="checkbox" data-dash={id} /> <span>{label}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card info">
      <h2>Lưu ý khi áp dụng</h2>
      <p>Người bệnh suy tim, bệnh thận, xơ gan, rối loạn điện giải, thai kỳ hoặc đang dùng thuốc cần hỏi bác sĩ/chuyên gia dinh dưỡng trước khi thay đổi mạnh lượng muối, nước, kali hay đạm.</p>
      <p class="warning">Không tự ngừng thuốc huyết áp và không dùng checklist này để thay thế đo huyết áp hoặc kế hoạch điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("dash-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-dash]:checked").length;
      const pct = Math.round((done / total) * 100);
      const message = done >= 6 ? "Nhiều thói quen DASH đã hiện diện." : done >= 3 ? "Bạn đã có một số nền tảng; hãy chọn thêm một thay đổi nhỏ." : "Hãy bắt đầu từ một thay đổi dễ làm như thêm rau và giảm đồ uống có đường.";
      result.hidden = false;
      result.innerHTML = `<h2>${done}/${total} mục (${pct}%)</h2><p>${message}</p><small>Đây là tổng hợp nhắc việc, không phải điểm sức khỏe hay dự báo huyết áp.</small>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .dash-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result { margin-top: 16px; } .result h2 { color: var(--brand); }
    .info { margin-top: 16px; } .warning { color: #a3432d; font-weight: 700; } small { color: var(--ink-tertiary); }
    @media (max-width: 650px) { .dash-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
