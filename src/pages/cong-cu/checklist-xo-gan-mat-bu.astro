---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist xơ gan mất bù";
const desc = "Bảng kiểm dinh dưỡng và theo dõi cổ trướng, bệnh não gan khi xơ gan mất bù.";
const items = [
  "Tôi theo dõi vòng bụng, cân nặng, phù chân và lượng nước tiểu theo hướng dẫn",
  "Tôi giảm muối theo kế hoạch, đọc nhãn thực phẩm và tránh đồ muối/đóng hộp",
  "Tôi vẫn chia đủ bữa và đủ đạm theo bác sĩ, không tự kiêng đạm hoặc nhịn ăn",
  "Tôi dùng lợi tiểu, lactulose hoặc thuốc khác đúng đơn và báo khi tiêu chảy nhiều",
  "Tôi tránh hoàn toàn rượu bia và báo bác sĩ mọi thuốc không kê đơn, thảo dược, thực phẩm bổ sung",
  "Tôi biết dấu hiệu xuất huyết tiêu hóa, lú lẫn, sốt, đau bụng hoặc vàng da tăng để đi khám ngay",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-xo-gan-mat-bu">
  <main class="liver-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm gan mật</p>
      <h1>🫀 Checklist xơ gan mất bù</h1>
      <p>{desc} Đây là bảng nhắc việc, không thay thế theo dõi của bác sĩ gan mật.</p>
    </header>
    <form id="liver-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-liver /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần đi khám/cấp cứu khi</h2>
      <p>Nôn máu hoặc đi ngoài phân đen, lơ mơ/lú lẫn mới xuất hiện, sốt và đau bụng, khó thở do cổ trướng, vàng da tăng nhanh hoặc tiểu rất ít.</p>
      <p class="warning">Không tự chọc tháo dịch, tự tăng lợi tiểu, dùng thuốc ngủ/thuốc giảm đau hay thảo dược “bổ gan”.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("liver-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-liver]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký cân nặng, vòng bụng, phân và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ gan mật hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .liver-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .liver-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
