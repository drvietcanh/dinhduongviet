---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist tiêu chảy do kháng sinh";
const desc = "Bảng kiểm bù dịch, vệ sinh và theo dõi tiêu chảy sau dùng kháng sinh.";
const items = [
  "Tôi ghi thời điểm bắt đầu, số lần đi ngoài, máu/nhầy, sốt, đau bụng và kháng sinh đã dùng",
  "Tôi bù nước–điện giải từng ngụm, ăn nhẹ phù hợp và theo dõi lượng nước tiểu",
  "Tôi dùng thuốc điều trị theo đơn, không tự dùng loperamide khi sốt hoặc có máu trong phân",
  "Tôi rửa tay bằng xà phòng, vệ sinh nhà vệ sinh và không dùng chung khăn/đồ cá nhân",
  "Tôi báo bác sĩ các thuốc ức chế miễn dịch, bệnh ruột, bệnh thận hoặc tuổi cao",
  "Tôi biết dấu hiệu nặng: đau/chướng bụng, sốt, phân máu, choáng, tiểu ít hoặc tiêu chảy kéo dài",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-tieu-chay-khang-sinh">
  <main class="abx-diarrhea-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa–truyền nhiễm</p>
      <h1>🦠 Checklist tiêu chảy do kháng sinh</h1>
      <p>{desc} Một số trường hợp cần xét nghiệm phân và điều trị đặc hiệu, không tự cầm tiêu chảy.</p>
    </header>
    <form id="abx-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-abx /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám ngay khi</h2>
      <p>Đau/chướng bụng tăng, sốt cao, phân máu, nôn, choáng, tiểu ít hoặc tiêu chảy nhiều lần không giảm.</p>
      <p class="warning">Không tự dùng kháng sinh khác, thuốc cầm tiêu chảy hoặc men vi sinh thay cho đánh giá y tế.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("abx-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-abx]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang danh sách kháng sinh, nhật ký phân, sốt và lượng dịch khi đi khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa/truyền nhiễm về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .abx-diarrhea-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .abx-diarrhea-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
