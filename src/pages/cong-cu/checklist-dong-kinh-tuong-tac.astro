---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist động kinh và tương tác thuốc–thực phẩm";
const desc = "Bảng kiểm dùng thuốc, ăn uống và an toàn cho người bệnh động kinh.";
const items = [
  "Tôi uống thuốc chống động kinh đúng giờ, không tự ngừng dù đã lâu không lên cơn",
  "Tôi hỏi bác sĩ/dược sĩ trước khi dùng thuốc mới, vitamin, thảo dược hoặc thực phẩm bổ sung",
  "Tôi báo danh sách bưởi, rượu bia, chế độ keto hoặc thực phẩm đặc biệt đang dùng để kiểm tra tương tác",
  "Tôi ăn uống đều, ngủ đủ và tránh bỏ bữa, mất nước hoặc rượu bia là yếu tố kích hoạt cơn",
  "Tôi có kế hoạch xử trí cơn, người thân biết cách bảo vệ an toàn và không nhét vật vào miệng",
  "Tôi ghi nhật ký cơn, tác dụng phụ, cân nặng và báo khi nôn nhiều hoặc không giữ được thuốc",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-dong-kinh-tuong-tac">
  <main class="epilepsy-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thần kinh</p>
      <h1>⚡ Checklist động kinh và tương tác thuốc</h1>
      <p>{desc} Bảng kiểm hỗ trợ trao đổi với bác sĩ thần kinh, không thay thế điều trị.</p>
    </header>
    <form id="epilepsy-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-epilepsy /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu khi</h2>
      <p>Cơn kéo dài trên 5 phút, cơn lặp lại không tỉnh, chấn thương nặng, khó thở hoặc không hồi phục ý thức.</p>
      <p class="warning">Không tự tăng liều, đổi thuốc, dùng CBD/thảo dược hoặc áp dụng chế độ keto điều trị nếu chưa có đội chuyên môn theo dõi.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("epilepsy-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-epilepsy]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký cơn, thuốc, thực phẩm bổ sung và câu hỏi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ thần kinh hoặc dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .epilepsy-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .epilepsy-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
