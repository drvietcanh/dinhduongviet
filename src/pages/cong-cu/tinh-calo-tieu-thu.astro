---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "🧮 Ước tính năng lượng tiêu hao khi vận động";
const desc = "Ước tính kcal tiêu hao từ cân nặng, thời gian và hoạt động ở mức tham khảo, không dùng để đặt mục tiêu giảm cân, ăn bù hoặc điều trị.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/tinh-calo-tieu-thu">
  <main class="content-page">
    <div class="page-header">
      <h1><span class="h-icon">🧮</span><span class="h-text">Ước tính năng lượng tiêu hao khi vận động</span></h1>
      <p class="page-desc">{desc}</p>
    </div>

    <div class="section-label"><span class="sl-num">1</span> Thông tin tập luyện</div>
    <div class="form-card">
      <p class="form-note">Công cụ này chỉ cho ra <strong>ước tính tham khảo</strong>. Kết quả phụ thuộc cường độ thực tế, kỹ thuật vận động, thể trạng và sai số của công thức.</p>
      <div class="form-grid">
        <div class="form-row">
          <label for="weight">⚖️ Cân nặng</label>
          <div class="input-wrap"><input type="text" inputmode="decimal" id="weight" placeholder="Ví dụ: 70 hoặc 70,5" aria-describedby="weight-help"><span class="input-suffix">kg</span></div>
        </div>
        <div class="form-row">
          <label for="duration">⏱️ Thời gian</label>
          <div class="input-wrap"><input type="text" inputmode="decimal" id="duration" placeholder="Ví dụ: 30" aria-describedby="duration-help"><span class="input-suffix">phút</span></div>
        </div>
        <div class="form-row" style="grid-column:1/-1;">
          <label for="activity">🏃 Bài tập</label>
          <div class="input-wrap stage-wrap">
            <select id="activity">
              <option value="walk-slow">🚶 Đi bộ chậm (3 km/h)</option>
              <option value="walk-moderate">🚶 Đi bộ nhanh (5 km/h)</option>
              <option value="walk-fast">🏃 Đi bộ nhanh (6.5 km/h)</option>
              <option value="jog">🏃 Chạy bộ (8 km/h)</option>
              <option value="run">🏃‍♂️ Chạy (10 km/h)</option>
              <option value="sprint">💨 Chạy nhanh (12 km/h)</option>
              <option value="cycle-leisure">🚲 Đạp xe dạo (16 km/h)</option>
              <option value="cycle-moderate">🚲 Đạp xe vừa (20 km/h)</option>
              <option value="cycle-fast">🚴 Đạp xe nhanh (27 km/h)</option>
              <option value="swim-leisure">🏊 Bơi dạo</option>
              <option value="swim-moderate">🏊 Bơi vừa (nước rút)</option>
              <option value="swim-fast">🏊 Bơi nhanh (bướm)</option>
              <option value="yoga">🧘 Yoga nhẹ</option>
              <option value="pilates">🤸 Pilates</option>
              <option value="gym-light">🏋️ Tập tạ nhẹ (nghỉ lâu)</option>
              <option value="gym-moderate">🏋️ Tập tạ vừa (nghỉ 60s)</option>
              <option value="gym-heavy">🏋️ Tập tạ nặng (HIIT, Crossfit)</option>
              <option value="badminton">🏸 Cầu lông giao lưu</option>
              <option value="badminton-comp">🏸 Cầu lông thi đấu</option>
              <option value="football">⚽ Đá bóng giao lưu</option>
              <option value="football-comp">⚽ Đá bóng thi đấu</option>
              <option value="basketball">🏀 Bóng rổ</option>
              <option value="table-tennis">🏓 Bóng bàn</option>
              <option value="dance">💃 Nhảy (zumba, aerobic)</option>
              <option value="stairs">🪜 Leo cầu thang</option>
              <option value="housework">🧹 Làm việc nhà</option>
            </select>
            <span class="stage-arrow">▼</span>
          </div>
        </div>
      </div>
      <div id="form-feedback" class="form-feedback" hidden></div>
      <button class="btn-calc" onclick="calculate()">🔥 Tính kcal ước tính</button>
    </div>

    <div id="result" style="display:none;">
      <div class="section-label"><span class="sl-num">2</span> Kết quả</div>
      <div class="card-plain" style="text-align:center;padding:28px;">
        <div style="font-size:3rem;font-weight:800;color:var(--brand);" id="cal-burned">0</div>
        <div style="font-size:1rem;margin-bottom:6px;">kcal ước tính</div>
        <div id="cal-detail" class="cal-detail"></div>
        <div class="cal-bar-track" style="margin:14px auto 0;max-width:400px;height:18px;background:var(--line);border-radius:10px;overflow:hidden;">
          <div id="cal-fill" class="cal-bar-fill" style="width:0%;height:100%;background:var(--brand);border-radius:10px;transition:width 0.5s;"></div>
        </div>
        <p class="result-note">Không dùng kết quả này để tự đặt mục tiêu giảm cân, ăn bù sau vận động hoặc tự điều chỉnh chế độ điều trị.</p>
      </div>
    </div>

    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        Công cụ chỉ cung cấp ước tính năng lượng tiêu hao khi vận động ở mức tham khảo. Không dùng để tự xây dựng chế độ giảm cân, tăng cân, ăn bù hoặc tự điều chỉnh thuốc. Người có bệnh tim mạch, tăng huyết áp, tiểu đường, bệnh thận, bệnh hô hấp, bệnh cơ xương khớp, thai kỳ, trẻ em, người cao tuổi, hoặc có đau ngực, khó thở, chóng mặt khi vận động nên hỏi bác sĩ hoặc chuyên gia trước khi thay đổi mức vận động.
      </div>
    </div>
  </main>

  <style>
    .content-page { max-width: 800px; margin:0 auto; padding: 32px 20px; }
    .page-header { text-align:center; margin-bottom:28px; }
    .page-header h1 { display:flex; align-items:center; justify-content:center; gap:12px; margin:0 0 10px; }
    .h-icon { font-size:1.8rem; line-height:1; }
    .h-text { font-size:1.65rem; font-weight:800; letter-spacing:-0.02em; line-height:1.2; }
    .page-desc { max-width:560px; margin:0 auto; color:var(--ink-secondary); font-size:0.92rem; line-height:1.6; }

    .section-label { display:flex; align-items:center; gap:10px; font-weight:700; font-size:0.9rem; margin:24px 0 12px; color:var(--ink); }
    .section-label:first-of-type { margin-top:0; }
    .sl-num { width:28px; height:28px; border-radius:50%; background:var(--brand-light); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.78rem; font-weight:800; flex-shrink:0; }

    .form-card { background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius-lg); padding:24px; margin-bottom:8px; box-shadow:var(--shadow-sm); }
    .form-note { margin: 0 0 16px; font-size: 0.84rem; line-height: 1.6; color: var(--ink-secondary); }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; margin-bottom:18px; }
    .form-row label { display:block; font-size:0.82rem; font-weight:600; margin-bottom:5px; color:var(--ink-secondary); }
    .input-wrap { display:flex; align-items:center; background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius); transition: border-color var(--transition), box-shadow var(--transition); }
    .input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 3px rgba(5, 150, 105, 0.15); }
    .input-wrap input, .input-wrap select { flex:1; border:none; background:transparent; padding:11px 12px; font-size:0.92rem; color:var(--ink); outline:none; width:100%; }
    .input-wrap select { appearance:none; -webkit-appearance:none; cursor:pointer; font-weight:500; }
    .input-suffix { padding-right:12px; font-size:0.78rem; color:var(--ink-tertiary); font-weight:500; }
    .stage-wrap { position:relative; }
    .stage-arrow { position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:0.65rem; color:var(--ink-tertiary); pointer-events:none; }
    .form-feedback { margin: 0 0 14px; padding: 10px 12px; border-radius: var(--radius); background: var(--bg-soft); color: var(--ink-secondary); font-size: 0.82rem; line-height: 1.5; text-align: left; }

    .btn-calc { width:100%; padding:14px; border:none; border-radius:var(--radius); background:var(--brand); color:white; font-size:1rem; font-weight:700; cursor:pointer; font-family:inherit; transition:all var(--transition); }
    .btn-calc:hover { background:var(--brand-dark); transform:translateY(-1px); box-shadow:var(--shadow-sm); }

    .card-plain { background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius-lg); padding:20px; margin-bottom:8px; box-shadow:var(--shadow-sm); }

    .safety-note { display:flex; align-items:flex-start; gap:12px; margin-top:20px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:var(--radius); font-size:0.82rem; line-height:1.6; }
    .safety-icon-col { flex-shrink:0; font-size:1.1rem; }
    .safety-text-col { flex:1; color:var(--ink-secondary); }

    /* Page-specific styles */
    .cal-detail { font-size:0.82rem; color:var(--ink-secondary); margin-bottom:6px; }
    .result-note { margin: 14px auto 0; max-width: 500px; font-size: 0.84rem; line-height: 1.6; color: var(--ink-secondary); }

    @media (max-width:600px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.25rem; }
      .form-grid { grid-template-columns:1fr; gap:12px; }
    }
  </style>

  <script is:inline>
  (function() {
    var METS = {
      'walk-slow': 2.8, 'walk-moderate': 3.8, 'walk-fast': 5.0,
      'jog': 7.0, 'run': 9.8, 'sprint': 11.5,
      'cycle-leisure': 5.5, 'cycle-moderate': 7.5, 'cycle-fast': 10.5,
      'swim-leisure': 5.0, 'swim-moderate': 7.5, 'swim-fast': 10.0,
      'yoga': 2.5, 'pilates': 3.5,
      'gym-light': 3.5, 'gym-moderate': 5.5, 'gym-heavy': 8.5,
      'badminton': 4.5, 'badminton-comp': 7.0,
      'football': 6.0, 'football-comp': 9.0,
      'basketball': 6.5, 'table-tennis': 3.5,
      'dance': 5.5, 'stairs': 7.5, 'housework': 3.0
    };

    function parseLocaleNumber(value) {
      if (typeof value !== 'string') {
        return Number(value);
      }

      var normalized = value.trim().replace(',', '.');
      if (!normalized) {
        return NaN;
      }

      return Number(normalized);
    }

    function showFeedback(message) {
      var feedback = document.getElementById('form-feedback');
      feedback.textContent = message;
      feedback.hidden = false;
    }

    function clearFeedback() {
      var feedback = document.getElementById('form-feedback');
      feedback.textContent = '';
      feedback.hidden = true;
    }

    function calculate() {
      var w = parseLocaleNumber(document.getElementById('weight').value);
      var dur = parseLocaleNumber(document.getElementById('duration').value);
      var act = document.getElementById('activity').value;
      var met = METS[act] || 3.0;
      var result = document.getElementById('result');

      if (!Number.isFinite(w) || !Number.isFinite(dur) || w <= 0 || dur <= 0) {
        result.style.display = 'none';
        showFeedback('Vui lòng nhập cân nặng và thời gian hợp lệ để xem ước tính tham khảo.');
        return;
      }

      if (w > 500 || dur > 1440) {
        result.style.display = 'none';
        showFeedback('Giá trị đang vượt ngoài phạm vi kiểm tra nhanh của công cụ. Hãy kiểm tra lại đơn vị và số đã nhập.');
        return;
      }

      clearFeedback();

      var cal = Math.round((met * 3.5 * w / 200 * dur) * 10) / 10;
      var calH = Math.round((met * 3.5 * w / 200 * 60) * 10) / 10;

      document.getElementById('cal-burned').textContent = cal.toLocaleString();

      var labels = {
        'walk-slow': 'Đi bộ chậm', 'walk-moderate': 'Đi bộ nhanh', 'walk-fast': 'Đi bộ nhanh',
        'jog': 'Chạy bộ', 'run': 'Chạy', 'sprint': 'Chạy nhanh',
        'cycle-leisure': 'Đạp xe dạo', 'cycle-moderate': 'Đạp xe vừa', 'cycle-fast': 'Đạp xe nhanh',
        'swim-leisure': 'Bơi dạo', 'swim-moderate': 'Bơi vừa', 'swim-fast': 'Bơi nhanh',
        'yoga': 'Yoga', 'pilates': 'Pilates',
        'gym-light': 'Tập tạ nhẹ', 'gym-moderate': 'Tập tạ vừa', 'gym-heavy': 'Tập tạ nặng',
        'badminton': 'Cầu lông', 'badminton-comp': 'Cầu lông thi đấu',
        'football': 'Đá bóng', 'football-comp': 'Đá bóng thi đấu',
        'basketball': 'Bóng rổ', 'table-tennis': 'Bóng bàn',
        'dance': 'Nhảy', 'stairs': 'Leo cầu thang', 'housework': 'Việc nhà'
      };

      document.getElementById('cal-detail').textContent = labels[act] + ' — ' + dur + ' phút — MET tham khảo ' + met.toFixed(1) + ' — khoảng ' + calH + ' kcal/giờ';

      var fill = Math.min(cal/800*100, 100);
      document.getElementById('cal-fill').style.width = fill + '%';

      result.style.display = 'block';
    }

    window.calculate = calculate;
  })();
  </script>
</BaseLayout>
