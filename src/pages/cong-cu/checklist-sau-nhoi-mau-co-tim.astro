---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau nhồi máu cơ tim";
const desc = "Bảng kiểm ăn uống, thuốc và phục hồi sau nhồi máu cơ tim.";
const items = [
  "Tôi dùng thuốc chống kết tập tiểu cầu/statin và thuốc khác đúng hướng dẫn",
  "Tôi đọc nhãn natri, giảm món chế biến sẵn, đồ chiên và chất béo bão hòa",
  "Bữa ăn có rau, đậu, ngũ cốc nguyên hạt, cá và đạm phù hợp",
  "Tôi tham gia phục hồi tim hoặc vận động theo mức bác sĩ cho phép",
  "Tôi theo dõi huyết áp, cân nặng, đường huyết và triệu chứng mới",
  "Tôi biết dấu hiệu tái thiếu máu cơ tim và số điện thoại gọi cấp cứu",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-sau-nhoi-mau-co-tim">
  <main class="mi-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tim mạch</p>
      <h1>❤️ Checklist sau nhồi máu cơ tim</h1>
      <p>{desc} Ăn uống là một phần của phục hồi tim, không thay thế thuốc và can thiệp chuyên môn.</p>
    </header>
    <form id="mi-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-mi /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cấp cứu ngay khi</h2>
      <p>Đau/đè nặng ngực kéo dài, khó thở, vã mồ hôi lạnh, ngất, đau lan tay/hàm hoặc hồi hộp kèm choáng.</p>
      <p class="warning">Không tự lái xe, không tự ngừng thuốc và không chờ triệu chứng tự hết.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("mi-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-mi]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi huyết áp, triệu chứng và thuốc để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ tim mạch hoặc chuyên gia phục hồi tim về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .mi-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .mi-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
