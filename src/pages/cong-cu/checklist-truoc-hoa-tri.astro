---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng trước hóa trị";
const desc = "Bảng kiểm chuẩn bị dinh dưỡng và an toàn thực phẩm trước đợt hóa trị.";
const items = [
  "Tôi đã được đánh giá cân nặng, sụt cân, lượng ăn và khối cơ trước khi bắt đầu điều trị",
  "Tôi có kế hoạch bữa nhỏ giàu năng lượng và đạm phù hợp bệnh, thuốc và khả năng ăn",
  "Tôi chuẩn bị thức ăn dễ ăn khi buồn nôn, thay đổi vị giác, loét miệng hoặc mệt",
  "Tôi biết nguyên tắc rửa tay, bảo quản, nấu chín và tránh thực phẩm sống/nguy cơ nhiễm khuẩn",
  "Tôi báo đội ung thư mọi thuốc, vitamin, thảo dược và không tự dùng liều cao để “tăng đề kháng”",
  "Tôi biết cách liên hệ khi nôn nhiều, tiêu chảy, sốt, không uống được hoặc sụt cân tiếp tục",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-truoc-hoa-tri">
  <main class="chemo-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung thư</p>
      <h1>🧬 Checklist dinh dưỡng trước hóa trị</h1>
      <p>{desc} Chuẩn bị sớm giúp giảm gián đoạn điều trị, nhưng không thay thế phác đồ của bác sĩ ung bướu.</p>
    </header>
    <form id="chemo-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-chemo /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội điều trị ngay khi</h2>
      <p>Sốt theo ngưỡng đội ung thư đã dặn, rét run, khó thở, nôn/tiêu chảy không kiểm soát, đau dữ dội hoặc không uống được thuốc.</p>
      <p class="warning">Không tự trì hoãn hóa trị, tự dùng kháng sinh, thuốc chống nôn hoặc thực phẩm bổ sung liều cao.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("chemo-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-chemo]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký ăn uống, triệu chứng, thuốc và câu hỏi khi đến buổi điều trị.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với đội ung thư hoặc chuyên gia dinh dưỡng trước đợt hóa trị.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .chemo-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .chemo-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
