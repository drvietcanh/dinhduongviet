---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng gout";
const desc = "Bảng kiểm thói quen hỗ trợ kiểm soát cơn gout và acid uric.";
const items = [
  "Tôi biết acid uric và chức năng thận gần nhất, cùng mục tiêu bác sĩ đặt ra",
  "Tôi uống nước theo hướng dẫn, không cố uống quá mức khi có suy tim/thận",
  "Tôi hạn chế rượu bia, nước ngọt có đường và các bữa ăn quá lớn",
  "Tôi ăn đạm vừa đủ, đa dạng cá/thịt/trứng/đậu theo tư vấn thay vì kiêng tuyệt đối",
  "Tôi duy trì cân nặng và vận động phù hợp, tránh giảm cân cấp tốc",
  "Tôi dùng thuốc hạ uric/thuốc cơn gout đúng kê đơn và báo thuốc bổ sung đang dùng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-gout">
  <main class="gout-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chuyển hóa</p>
      <h1>🦶 Checklist dinh dưỡng gout</h1>
      <p>{desc} Không tự ngừng thuốc hoặc loại bỏ hoàn toàn mọi nguồn đạm.</p>
    </header>
    <form id="gout-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-gout /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám khi</h2>
      <p>Sưng đỏ đau dữ dội kèm sốt, đau hông lưng, tiểu ít, nôn nhiều hoặc cơn đau không đáp ứng kế hoạch đã được kê.</p>
      <p class="warning">Không tự dùng aspirin liều thấp, thuốc nam, thuốc lợi tiểu hoặc thực phẩm bổ sung để xử trí cơn gout.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("gout-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-gout]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cơn đau, thuốc và thực phẩm nghi ngờ để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ và hỏi bác sĩ/dinh dưỡng viên về mục còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .gout-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .gout-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
