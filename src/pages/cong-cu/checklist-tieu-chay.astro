---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi tiêu chảy";
const desc = "Bảng kiểm bù nước, ăn uống và an toàn thực phẩm khi tiêu chảy cấp hoặc kéo dài.";
const items = [
  "Tôi có dung dịch oresol đúng hướng dẫn và uống từng ngụm nhỏ",
  "Tôi theo dõi số lần đi ngoài, nôn, lượng tiểu và dấu mất nước",
  "Tôi ăn lại sớm với món mềm, dễ tiêu, không nhịn đói kéo dài",
  "Tôi tránh rượu bia, đồ uống quá ngọt và thực phẩm sống/nghi nhiễm",
  "Tôi rửa tay, dùng nước sạch và tách dụng cụ thực phẩm sống/chín",
  "Tôi biết dấu hiệu cần khám và không tự dùng kháng sinh/thuốc cầm tiêu chảy",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-tieu-chay">
  <main class="diarrhea-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>💧 Checklist dinh dưỡng khi tiêu chảy</h1>
      <p>{desc} Trẻ nhỏ, người cao tuổi, thai phụ và người bệnh mạn mất nước nhanh hơn.</p>
    </header>
    <form id="diarrhea-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-diarrhea /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Lừ đừ, khát nhiều, mắt trũng, tiểu ít, nôn không uống được, máu trong phân, sốt cao, đau bụng tăng hoặc tiêu chảy kéo dài.</p>
      <p class="warning">Không tự pha oresol “đậm/loãng theo cảm tính”, không nhịn ăn và không dùng thuốc cầm tiêu chảy khi có máu/sốt.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("diarrhea-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-diarrhea]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi số lần đi ngoài, lượng uống và lượng tiểu để theo dõi.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ/dược sĩ về phần còn thiếu, đặc biệt nếu có bệnh nền hoặc trẻ nhỏ.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .diarrhea-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .diarrhea-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
