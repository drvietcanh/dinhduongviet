---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist gout và acid uric";
const desc = "Bảng kiểm ăn uống, thuốc và theo dõi acid uric ở người bệnh gout.";
const items = [
  "Tôi dùng thuốc hạ acid uric đúng đơn, không tự ngừng khi hết đau và biết thuốc dự phòng cơn",
  "Tôi uống nước phù hợp bệnh thận/suy tim và theo dõi nước tiểu, cân nặng",
  "Tôi hạn chế rượu bia, nước ngọt có đường, nội tạng và khẩu phần thịt/hải sản quá lớn",
  "Tôi tránh nhịn đói hoặc giảm cân quá nhanh; duy trì cân nặng và vận động từ từ",
  "Tôi báo bác sĩ mọi thuốc lợi tiểu, aspirin liều thấp, vitamin, thảo dược và thực phẩm bổ sung",
  "Tôi biết dấu hiệu cần khám: sốt, khớp sưng nóng nhiều, đau không giảm, đau hông lưng hoặc tiểu ít",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-gout-acid-uric">
  <main class="gout-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chuyển hóa</p>
      <h1>🦶 Checklist gout và acid uric</h1>
      <p>{desc} Chế độ ăn hỗ trợ nhưng thường không thay thế thuốc hạ acid uric khi đã có gout.</p>
    </header>
    <form id="gout-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-gout /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Sốt kèm khớp sưng nóng, đau dữ dội khác thường, phát ban sau thuốc, đau hông lưng hoặc tiểu rất ít.</p>
      <p class="warning">Không tự tăng colchicine, dùng corticoid hoặc ngừng allopurinol/febuxostat khi chưa hỏi bác sĩ.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("gout-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-gout]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang kết quả acid uric, chức năng thận và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ cơ xương khớp/thận hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .gout-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .gout-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
