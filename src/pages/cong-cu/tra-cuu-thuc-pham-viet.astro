---
// tra-cuu-thuc-pham-viet.astro — Bảng TP thực phẩm Việt Nam 2007
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Bảng TP thực phẩm Việt Nam 2007 - Dinh Dưỡng Việt"
  description="Xem nhanh thành phần dinh dưỡng thực phẩm Việt theo dữ liệu Bảng thành phần thực phẩm Việt Nam 2007 ở mức tham khảo."
  canonical="/cong-cu/tra-cuu-thuc-pham-viet"
>
  <style>
    .app-container { max-width: 1100px; margin: 0 auto; padding: 0; }
    .badge { display: inline-block; background: var(--brand-light); color: var(--brand); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; }
    h1 { font-size: 1.8rem; margin: 0 0 4px; }
    .subtitle { color: var(--ink-secondary); margin-bottom: 20px; font-size: 0.95rem; }

    .search-row { display: flex; gap: 8px; margin-bottom: 20px; }
    .search-row input {
      flex: 1; padding: 11px 16px; border: 1px solid var(--card-border); border-radius: var(--radius);
      font-size: 1rem; box-sizing: border-box; transition: border-color var(--transition), box-shadow var(--transition);
      background: var(--bg); color: var(--ink);
    }
    .search-row input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }
    .search-row .info-count {
      white-space: nowrap; display: flex; align-items: center;
      padding: 0 12px; color: var(--ink-tertiary); font-size: 0.85rem;
    }

    /* ── Results list ── */
    .results { max-height: 420px; overflow-y: auto; border: 1px solid var(--card-border); border-radius: var(--radius-lg); margin-bottom: 20px; box-shadow: var(--shadow-sm); }
    .result-item {
      display: flex; align-items: center; gap: 12px; padding: 10px 14px;
      border-bottom: 1px solid var(--line-light); cursor: pointer; transition: background var(--transition);
    }
    .result-item:last-child { border-bottom: none; }
    .result-item:hover { background: var(--bg-soft); }
    .result-item.active { background: var(--brand-light2); color: var(--brand-dark); }
    .ri-code { color: #888; font-size: 0.8rem; width: 48px; flex-shrink: 0; font-family: monospace; }
    .ri-name { flex: 1; font-weight: 600; }
    .ri-name-en { font-size: 0.8rem; color: var(--ink-tertiary); }
    .ri-kcal { color: #666; font-size: 0.85rem; white-space: nowrap; font-weight: 500; }

    .empty-state { text-align: center; padding: 40px; color: #999; }

    /* ── Detail panel ── */
    .detail-panel { background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; box-shadow: var(--shadow-sm); }
    .detail-panel h2 { margin: 0 0 4px; font-size: 1.3rem; color: var(--brand-dark); }
    .detail-panel .en-name { color: #888; font-size: 0.9rem; margin-bottom: 8px; }
    .detail-panel .waste { font-size: 0.85rem; color: #888; }

    .calc-row { display: flex; align-items: center; gap: 12px; margin: 16px 0; }
    .calc-row label { font-weight: 600; color: var(--ink-secondary); }
    .calc-row input[type="number"] {
      width: 100px; padding: 8px 12px; border: 1px solid var(--card-border); border-radius: var(--radius);
      font-size: 1rem; text-align: center; background: var(--card); color: var(--ink); transition: border-color var(--transition);
    }
    .calc-row input:focus { border-color: var(--brand); outline: none; }

    /* Core table */
    .core-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 8px; margin-bottom: 16px;
    }
    .core-item {
      background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius);
      padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;
    }
    .ci-label { font-size: 0.85rem; color: var(--ink-secondary); }
    .ci-value { font-weight: 800; font-size: 1.05rem; color: var(--brand); }
    .ci-unit { font-size: 0.75rem; color: #999; font-weight: 400; }
    .ci-null { font-weight: 400; color: #bbb; }

    /* Tabs */
    .tabs { display: flex; gap: 0; margin-bottom: 0; border-bottom: 2px solid var(--card-border); }
    .tab {
      padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 0.9rem;
      color: var(--ink-tertiary); border-bottom: 2px solid transparent; margin-bottom: -2px;
      transition: all var(--transition);
    }
    .tab:hover { color: var(--brand); }
    .tab.active { color: var(--brand); border-bottom-color: var(--brand); }

    .tab-content { display: none; padding: 16px 0; }
    .tab-content.active { display: block; }

    /* Detail nutrients table */
    .detail-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .detail-table th { text-align: left; padding: 8px 10px; background: var(--bg-soft); font-weight: 600; }
    .detail-table td { padding: 8px 10px; border-bottom: 1px solid var(--line-light); }
    .detail-table tr:hover td { background: var(--bg-soft); }
    .dt-null { color: #ccc; }

    .detail-scroll { max-height: 500px; overflow: auto; border: 1px solid var(--card-border); border-radius: var(--radius); }

    .no-selection { text-align: center; padding: 40px; color: #999; }

    .safety-note {
      margin: 0 0 16px;
      padding: 14px 16px;
      background: var(--bg-soft);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      font-size: 0.88rem;
      color: var(--ink-secondary);
      line-height: 1.55;
    }
    .safety-note strong { color: var(--ink); }

    .source-note { margin-top: 24px; padding: 14px; background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: var(--radius-lg); font-size: 0.85rem; color: #666; }

    @media (max-width: 600px) {
      .core-grid { grid-template-columns: repeat(2, 1fr); }
      .search-row { flex-wrap: wrap; }
      .detail-panel { padding: 16px; }
      .calc-row { flex-wrap: wrap; }
    }
  </style>

  <section>
    <span class="badge">📖 Dữ liệu chính thức</span>
    <h1>Bảng TP thực phẩm Việt</h1>
    <p class="subtitle">
      Nguồn dữ liệu Việt từ <strong>Bảng thành phần thực phẩm Việt Nam 2007</strong> với 526 thực phẩm và hơn 45.000 chỉ số.
    </p>
    <div class="safety-note">
      <strong>Phạm vi v1:</strong> Chỉ dùng để xem dữ liệu nguồn ở mức tham khảo. Không thay thế tư vấn bệnh lý hay quyết định điều trị cá thể hóa.
    </div>
  </section>

  <div class="app-container" id="vietnam-app">
    <!-- Search -->
    <div class="search-row">
      <input type="text" id="search-input" placeholder="🔍 Tìm thực phẩm (gõ tên tiếng Việt, mã số...)" autocomplete="off">
      <span class="info-count" id="result-count"></span>
    </div>

    <!-- Results list -->
    <div id="results" class="results"></div>

    <!-- Detail panel -->
    <div id="detail-panel" class="detail-panel">
      <div class="no-selection" id="no-selection">
        <div style="font-size: 2.5rem;margin-bottom:8px;">🥬</div>
        <p>Chọn một thực phẩm từ danh sách bên trên</p>
        <p style="font-size:0.85rem;">hoặc gõ tên thực phẩm vào ô tìm kiếm</p>
      </div>

      <div id="detail-area" style="display:none">
        <!-- Food header -->
        <h2 id="food-name"></h2>
        <div class="en-name" id="food-en-name"></div>
        <div class="waste" id="food-waste"></div>

        <!-- Gram calculator -->
        <div class="calc-row">
          <label>Khẩu phần:</label>
          <input type="number" id="gram-input" value="100" min="1" max="5000" step="1">
          <span>gram</span>
          <span style="color:#888;font-size:0.85rem;">
            ≈ <span id="calc-kcal"></span> kcal
          </span>
        </div>

        <!-- Tabs -->
        <div class="tabs">
          <div class="tab active" data-tab="core">Chỉ số chính</div>
          <div class="tab" data-tab="full">Thành phần đầy đủ</div>
        </div>

        <!-- Core tab -->
        <div class="tab-content active" id="tab-core">
          <div class="core-grid" id="core-grid"></div>
        </div>

        <!-- Full detail tab -->
        <div class="tab-content" id="tab-full">
          <div class="detail-scroll">
            <table class="detail-table">
              <thead><tr><th>Chất dinh dưỡng</th><th>Hàm lượng</th><th>Đơn vị</th><th>Nguồn</th></tr></thead>
              <tbody id="detail-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="source-note">
      <strong>Nguồn dữ liệu:</strong> Bảng thành phần thực phẩm Việt Nam 2007 — Viện Dinh Dưỡng Quốc Gia (NIN), tính theo <strong>100g phần ăn được</strong>.
    </div>
  </div>

  <script is:inline type="module">
    // ── Load data ──
    let foods = [];
    let nutrientsMap = {};

    let loading = false;
    let loadPromise = null;

    async function load() {
      if (loadPromise) return loadPromise;
      loading = true;
      loadPromise = new Promise(async (resolve) => {
        const [f, n] = await Promise.all([
          fetch("/api/vietnam-foods.json").then(r => r.json()),
          fetch("/api/vietnam-nutrients.json").then(r => r.json()),
        ]);
        foods = f;
        for (const rec of n) {
          if (!nutrientsMap[rec.code]) nutrientsMap[rec.code] = [];
          nutrientsMap[rec.code].push(rec);
        }
        loading = false;
        resolve();
      });
      return loadPromise;
    }

    // Lazy load: trigger on first interaction
    function triggerLoad() {
      load();
      document.getElementById("search-input").removeEventListener("focus", triggerLoad);
      document.getElementById("search-input").removeEventListener("input", triggerLoad);
    }
    document.getElementById("search-input").addEventListener("focus", triggerLoad);
    document.getElementById("search-input").addEventListener("input", triggerLoad);

    // Also preload on idle/after page load
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => load());
    } else {
      setTimeout(() => load(), 2000);
    }

    // ── Search ──
    const searchInput = document.getElementById("search-input");
    const resultsDiv = document.getElementById("results");
    const countSpan = document.getElementById("result-count");

    let selectedCode = null;

    function searchFoods(keyword) {
      const q = keyword.toLowerCase().trim();
      if (!q) return foods.slice(0, 50);

      return foods.filter(f => {
        // Search by code prefix
        if (f.code.startsWith(q)) return true;
        // Search by Vietnamese name
        if (removeAccents(f.name_vi).includes(removeAccents(q))) return true;
        if (f.name_vi.toLowerCase().includes(q)) return true;
        // Search by English name
        if (f.name_en && f.name_en.toLowerCase().includes(q)) return true;
        return false;
      }).slice(0, 50);
    }

    function removeAccents(str) {
      return str
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d")
        .replace(/Đ/g, "D")
        .toLowerCase();
    }

    function clearNode(node) {
      node.replaceChildren();
    }

    function createEmptyState(message) {
      const wrap = document.createElement("div");
      wrap.className = "empty-state";
      wrap.textContent = message;
      return wrap;
    }

    function renderResults(keyword) {
      const matches = searchFoods(keyword);
      countSpan.textContent = `${matches.length} kết quả`;
      clearNode(resultsDiv);

      if (!matches.length) {
        resultsDiv.appendChild(createEmptyState(`Không tìm thấy thực phẩm "${keyword}"`));
        return;
      }

      for (const f of matches) {
        const item = document.createElement("div");
        item.className = `result-item${selectedCode === f.code ? " active" : ""}`;
        item.dataset.code = f.code;

        const code = document.createElement("span");
        code.className = "ri-code";
        code.textContent = f.code;

        const nameWrap = document.createElement("div");
        nameWrap.className = "ri-name";
        nameWrap.textContent = f.name_vi;
        if (f.name_en) {
          const nameEn = document.createElement("div");
          nameEn.className = "ri-name-en";
          nameEn.textContent = f.name_en;
          nameWrap.appendChild(nameEn);
        }

        const kcal = document.createElement("span");
        kcal.className = "ri-kcal";
        kcal.textContent = f.energy_kcal != null ? `${f.energy_kcal} kcal` : "";

        item.append(code, nameWrap, kcal);
        item.addEventListener("click", () => selectFood(f.code));
        resultsDiv.appendChild(item);
      }
    }

    searchInput.addEventListener("input", function() {
      renderResults(this.value);
    });

    // ── Select food ──
    function selectFood(code) {
      selectedCode = code;
      const food = foods.find(f => f.code === code);
      if (!food) return;

      // Update results active state
      document.querySelectorAll(".result-item").forEach(el => {
        el.classList.toggle("active", el.dataset.code === code);
      });

      // Show detail
      document.getElementById("no-selection").style.display = "none";
      document.getElementById("detail-area").style.display = "";
      const foodName = document.getElementById("food-name");
      foodName.textContent = food.name_vi;
      document.getElementById("food-en-name").textContent = food.name_en || "";
      document.getElementById("food-waste").textContent = food.waste_percent != null && food.waste_percent > 0
        ? `Tỉ lệ thải bỏ: ${food.waste_percent}%`
        : "";

      const codeBadge = document.createElement("span");
      codeBadge.style.fontSize = "0.85rem";
      codeBadge.style.color = "#999";
      codeBadge.style.fontWeight = "400";
      codeBadge.textContent = ` (#${food.code})`;
      foodName.appendChild(codeBadge);

      // Reset gram to 100
      document.getElementById("gram-input").value = 100;

      // Render core nutrients
      renderCore(food, 100);
      document.getElementById("calc-kcal").textContent = food.energy_kcal != null ? String(food.energy_kcal) : "—";
      renderFullNutrients(code);
    }

    // ── Core nutrients ──
    const CORE_KEYS = [
      { key: "energy_kcal", label: "Năng lượng", unit: "kcal" },
      { key: "protein_g", label: "Protein", unit: "g" },
      { key: "lipid_g", label: "Lipid (béo)", unit: "g" },
      { key: "glucid_g", label: "Glucid (bột đường)", unit: "g" },
      { key: "fiber_g", label: "Chất xơ", unit: "g" },
      { key: "calcium_mg", label: "Canxi", unit: "mg" },
      { key: "iron_mg", label: "Sắt", unit: "mg" },
      { key: "sodium_mg", label: "Natri", unit: "mg" },
      { key: "potassium_mg", label: "Kali", unit: "mg" },
      { key: "cholesterol_mg", label: "Cholesterol", unit: "mg" },
      { key: "purin_mg", label: "Purin", unit: "mg" },
    ];

    function renderCore(food, grams) {
      const factor = grams / 100;
      const grid = document.getElementById("core-grid");
      clearNode(grid);
      for (const { key, label, unit } of CORE_KEYS) {
        const item = document.createElement("div");
        item.className = "core-item";

        const labelEl = document.createElement("span");
        labelEl.className = "ci-label";
        labelEl.textContent = label;

        if (food[key] === null || food[key] === undefined) {
          const nullEl = document.createElement("span");
          nullEl.className = "ci-null";
          nullEl.textContent = "—";
          item.append(labelEl, nullEl);
          grid.appendChild(item);
          continue;
        }

        const scaled = food[key] * factor;
        const display = Number.isInteger(scaled) ? String(scaled) : scaled.toFixed(1);
        const valueEl = document.createElement("span");
        valueEl.className = "ci-value";
        valueEl.textContent = `${display} `;
        const unitEl = document.createElement("span");
        unitEl.className = "ci-unit";
        unitEl.textContent = unit;
        valueEl.appendChild(unitEl);
        item.append(labelEl, valueEl);
        grid.appendChild(item);
      }
    }

    // Gram input handler
    document.getElementById("gram-input").addEventListener("input", function() {
      const grams = parseFloat(this.value) || 0;
      if (!selectedCode) return;
      const food = foods.find(f => f.code === selectedCode);
      if (!food || grams <= 0) return;
      renderCore(food, grams);

      // Update kcal preview
      if (food.energy_kcal != null) {
        document.getElementById("calc-kcal").textContent = (food.energy_kcal * grams / 100).toFixed(0);
      }
    });

    // ── Full nutrients ──
    function renderFullNutrients(code) {
      const tbody = document.getElementById("detail-tbody");
      const nuts = nutrientsMap[code] || [];
      clearNode(tbody);

      if (!nuts.length) {
        const row = document.createElement("tr");
        const cell = document.createElement("td");
        cell.colSpan = 4;
        cell.style.textAlign = "center";
        cell.style.color = "#999";
        cell.textContent = "Chưa có số liệu chi tiết";
        row.appendChild(cell);
        tbody.appendChild(row);
        return;
      }

      for (const n of nuts) {
        const row = document.createElement("tr");

        const nameCell = document.createElement("td");
        const nameStrong = document.createElement("strong");
        nameStrong.textContent = n.nutrient_name;
        nameCell.appendChild(nameStrong);

        const valueCell = document.createElement("td");
        if (n.value_num != null) {
          valueCell.textContent = String(n.value_num);
        } else if (n.value_text && n.value_text !== "-") {
          valueCell.textContent = n.value_text;
        } else {
          const nullEl = document.createElement("span");
          nullEl.className = "dt-null";
          nullEl.textContent = "—";
          valueCell.appendChild(nullEl);
        }

        const unitCell = document.createElement("td");
        unitCell.textContent = n.unit || "";

        const sourceCell = document.createElement("td");
        sourceCell.style.fontSize = "0.8rem";
        sourceCell.style.color = "#999";
        sourceCell.textContent = n.source_ref || "";

        row.append(nameCell, valueCell, unitCell, sourceCell);
        tbody.appendChild(row);
      }
    }

    // ── Tab switching ──
    document.querySelector(".tabs").addEventListener("click", function(e) {
      const tab = e.target.closest(".tab");
      if (!tab) return;
      const tabId = tab.dataset.tab;
      document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
      document.querySelectorAll(".tab-content").forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
      document.getElementById("tab-" + tabId).classList.add("active");
    });
  </script>
</BaseLayout>
