---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Theo dõi đường huyết | Dinh Dưỡng Việt";
const desc =
  "Ghi lại chỉ số đường huyết để chuẩn bị thông tin khi trao đổi với bác sĩ hoặc chuyên gia đang theo dõi.";

const safetySituations = [
  "Đang dùng insulin, sulfonylurea hoặc thuốc hạ đường huyết khác",
  "Có triệu chứng bất thường như run tay, vã mồ hôi, lơ mơ, khát nhiều, tiểu nhiều hoặc mệt lả",
  "Đang mang thai, nghi đái tháo đường thai kỳ hoặc đang chuẩn bị mang thai",
  "Có bệnh thận, bệnh tim mạch, bệnh gan, nhiễm trùng cấp hoặc đang nằm viện",
  "Có thay đổi thuốc, ăn uống thất thường, uống rượu hoặc vận động khác thường",
  "Muốn cá thể hóa chỉ số theo dõi, HbA1c hoặc kế hoạch dùng thuốc",
];

const prepItems = [
  "Thời điểm đo: đói, trước ăn, sau ăn, trước ngủ hoặc khi có triệu chứng",
  "Giá trị đo và đơn vị trên máy đo",
  "Bữa ăn, vận động, giấc ngủ, stress hoặc triệu chứng đi kèm",
  "Danh sách thuốc đang dùng, liều đã được kê và thời điểm uống/tiêm",
  "Kết quả xét nghiệm gần đây nếu có, đặc biệt HbA1c hoặc hồ sơ theo dõi bệnh nền",
];

const timeOptions = [
  ["fasting", "Đói / sáng sớm"],
  ["before-meal", "Trước ăn"],
  ["after-meal", "Sau ăn"],
  ["bedtime", "Trước ngủ"],
  ["symptom", "Khi có triệu chứng"],
  ["other", "Thời điểm khác"],
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/theo-doi-duong-huyet">
  <main class="glucose-log-shell" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Nhật ký an toàn v1</p>
      <h1 id="page-title">Theo dõi đường huyết</h1>
      <p>
        Trang này chỉ giúp ghi lại chỉ số để bạn mang theo khi trao đổi với bác sĩ
        hoặc chuyên gia đang theo dõi. V1 không đặt ngưỡng cá nhân, không phân
        loại kết quả và không hướng dẫn thay đổi thuốc.
      </p>
    </section>

    <section class="notice-panel" aria-labelledby="scope-title">
      <h2 id="scope-title">Phạm vi hiện tại</h2>
      <p>
        Đường huyết và HbA1c cần được cá thể hóa theo chẩn đoán, thuốc, thai kỳ,
        bệnh nền, triệu chứng và kế hoạch theo dõi. Vì chưa có source-lock và
        quy trình duyệt lâm sàng riêng, công cụ này không đưa ngưỡng cá nhân,
        không diễn giải chỉ số và không thay thế tư vấn chuyên môn.
      </p>
    </section>

    <section class="log-panel" aria-labelledby="log-title">
      <div class="section-head">
        <p class="eyebrow">Ghi lại để trao đổi</p>
        <h2 id="log-title">Nhật ký đường huyết</h2>
        <p>
          Dữ liệu chỉ lưu trong trình duyệt của bạn. Hãy kiểm tra lại với máy đo,
          sổ khám hoặc ứng dụng chính thức nếu cần dùng trong buổi khám.
        </p>
      </div>

      <div class="form-card" aria-label="Ghi nhật ký đường huyết">
        <label>
          Thời điểm đo
          <select id="entry-time">
            {timeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>

        <label>
          Chỉ số trên máy đo
          <input id="entry-value" type="number" inputmode="decimal" min="0" step="0.1" placeholder="Nhập số đo" />
        </label>

        <label>
          Ghi chú bữa ăn, thuốc, triệu chứng
          <textarea id="entry-note" rows="3" placeholder="Ví dụ: sau bữa tối, có đi bộ, đang dùng thuốc theo toa"></textarea>
        </label>

        <div class="button-row">
          <button type="button" class="primary-button" id="add-entry">Thêm vào nhật ký</button>
          <button type="button" class="secondary-button" id="clear-log">Xóa nhật ký</button>
        </div>
      </div>

      <div class="summary-strip" id="summary-strip" aria-live="polite"></div>

      <div class="chart-card">
        <canvas id="glucose-chart" width="720" height="260" aria-label="Biểu đồ nhật ký đường huyết"></canvas>
      </div>

      <div class="table-card" id="log-table" aria-live="polite"></div>
    </section>

    <section class="situation-panel" aria-labelledby="situation-title">
      <p class="eyebrow">Khi nào cần hỏi chuyên môn?</p>
      <h2 id="situation-title">Các tình huống cần cá thể hóa</h2>
      <div class="situation-grid">
        {safetySituations.map((item) => (
          <article class="situation-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="result-panel" aria-labelledby="result-title">
      <p class="result-label">Định hướng</p>
      <h2 id="result-title">Không đủ điều kiện đưa khuyến nghị cá nhân ở v1</h2>
      <p>
        Nếu có triệu chứng bất thường, kết quả lặp lại khác thường, đang dùng thuốc
        hạ đường huyết, đang mang thai hoặc có bệnh nền phức tạp, hãy liên hệ bác sĩ
        hoặc cơ sở y tế đang theo dõi. Không dùng trang này để thay đổi thuốc,
        lịch dùng thuốc hoặc kế hoạch chăm sóc nếu chưa trao đổi với bác sĩ.
      </p>
    </section>

    <section class="prep-panel" aria-labelledby="prep-title">
      <p class="eyebrow">Chuẩn bị thông tin</p>
      <h2 id="prep-title">Nên mang theo khi đi hỏi</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>

  <style is:global>
    .glucose-log-shell {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 0 44px;
    }

    .glucose-log-shell section {
      margin-bottom: 18px;
    }

    .hero-panel,
    .notice-panel,
    .log-panel,
    .situation-panel,
    .result-panel,
    .prep-panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 20px;
    }

    .hero-panel {
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.08), rgba(34, 197, 94, 0.08));
    }

    .eyebrow,
    .result-label {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .glucose-log-shell h1,
    .glucose-log-shell h2 {
      margin: 0 0 10px;
      line-height: 1.25;
    }

    .glucose-log-shell h1 {
      font-size: 1.75rem;
    }

    .glucose-log-shell h2 {
      font-size: 1.16rem;
    }

    .glucose-log-shell p,
    .glucose-log-shell li,
    .glucose-log-shell label {
      color: var(--ink-secondary);
      line-height: 1.65;
    }

    .glucose-log-shell p {
      margin: 0;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .form-card {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--bg);
    }

    .form-card label {
      display: grid;
      gap: 6px;
      font-weight: 700;
      font-size: 0.88rem;
    }

    .form-card label:nth-child(3) {
      grid-column: 1 / -1;
    }

    .form-card input,
    .form-card select,
    .form-card textarea {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card);
      color: var(--ink);
      font: inherit;
      padding: 10px 12px;
    }

    .form-card textarea {
      resize: vertical;
    }

    .button-row {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .primary-button,
    .secondary-button {
      min-height: 42px;
      border-radius: 8px;
      border: 1px solid var(--line);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      padding: 10px 14px;
    }

    .primary-button {
      background: var(--brand);
      border-color: var(--brand);
      color: #fff;
    }

    .secondary-button {
      background: transparent;
      color: var(--ink-secondary);
    }

    .summary-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }

    .summary-item {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card);
      padding: 10px 12px;
      color: var(--ink-secondary);
      font-size: 0.86rem;
    }

    .summary-item strong {
      color: var(--ink);
    }

    .chart-card,
    .table-card {
      margin-top: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card);
      padding: 14px;
      overflow-x: auto;
    }

    #glucose-chart {
      display: block;
      width: 100%;
      height: auto;
      min-height: 180px;
    }

    .log-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
      min-width: 560px;
    }

    .log-table th,
    .log-table td {
      border-bottom: 1px solid var(--line);
      padding: 10px;
      text-align: left;
      vertical-align: top;
    }

    .log-table th {
      color: var(--ink);
      background: var(--bg-soft);
    }

    .empty-state {
      text-align: center;
      color: var(--ink-tertiary);
      padding: 20px 8px;
    }

    .situation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .situation-card {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 12px;
      background: var(--bg);
    }

    .situation-card span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: #fff3cd;
      color: #7a4b00;
      font-weight: 900;
    }

    .result-panel {
      border-color: rgba(14, 165, 233, 0.24);
      background: rgba(14, 165, 233, 0.07);
    }

    .prep-panel ul {
      margin: 10px 0 0;
      padding-left: 20px;
    }

    @media (max-width: 640px) {
      .glucose-log-shell {
        padding: 12px 0 34px;
      }

      .hero-panel,
      .notice-panel,
      .log-panel,
      .situation-panel,
      .result-panel,
      .prep-panel {
        padding: 16px;
        border-radius: 8px;
      }

      .glucose-log-shell h1 {
        font-size: 1.45rem;
      }

      .form-card,
      .situation-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const storageKey = "ddv_glucose_log_v1";
      const timeLabels = {
        fasting: "Đói / sáng sớm",
        "before-meal": "Trước ăn",
        "after-meal": "Sau ăn",
        bedtime: "Trước ngủ",
        symptom: "Khi có triệu chứng",
        other: "Thời điểm khác",
      };

      const getEntries = () => {
        try {
          const value = JSON.parse(localStorage.getItem(storageKey) || "[]");
          return Array.isArray(value) ? value : [];
        } catch {
          return [];
        }
      };

      const saveEntries = (entries) => {
        localStorage.setItem(storageKey, JSON.stringify(entries));
      };

      const formatDate = (iso) => {
        const date = new Date(iso);
        return date.toLocaleString("vi-VN", {
          day: "2-digit",
          month: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
        });
      };

      const escapeHtml = (text) =>
        String(text)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const renderSummary = (entries) => {
        const summary = document.getElementById("summary-strip");
        const latest = entries.at(-1);
        summary.innerHTML = [
          `<div class="summary-item"><strong>${entries.length}</strong> lần ghi</div>`,
          `<div class="summary-item"><strong>${latest ? formatDate(latest.date) : "--"}</strong> lần gần nhất</div>`,
          `<div class="summary-item">Trang chỉ ghi nhật ký và không diễn giải chỉ số.</div>`,
        ].join("");
      };

      const renderTable = (entries) => {
        const target = document.getElementById("log-table");
        const recent = entries.slice(-60).reverse();
        if (!recent.length) {
          target.innerHTML = '<div class="empty-state">Chưa có dữ liệu. Hãy thêm chỉ số đầu tiên nếu bạn muốn dùng trang này như nhật ký cá nhân.</div>';
          return;
        }

        const rows = recent
          .map(
            (entry) => `
              <tr>
                <td>${formatDate(entry.date)}</td>
                <td>${escapeHtml(timeLabels[entry.time] || "Thời điểm khác")}</td>
                <td>${Number(entry.value).toFixed(1)}</td>
                <td>${escapeHtml(entry.note || "")}</td>
              </tr>
            `
          )
          .join("");

        target.innerHTML = `
          <table class="log-table">
            <thead>
              <tr>
                <th>Thời gian</th>
                <th>Thời điểm</th>
                <th>Chỉ số đã ghi</th>
                <th>Ghi chú</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        `;
      };

      const renderChart = (entries) => {
        const canvas = document.getElementById("glucose-chart");
        const ctx = canvas.getContext("2d");
        const width = canvas.width;
        const height = canvas.height;
        ctx.clearRect(0, 0, width, height);

        ctx.fillStyle = "#8a8f98";
        ctx.font = "14px sans-serif";
        ctx.textAlign = "center";

        if (entries.length < 2) {
          ctx.fillText("Ghi ít nhất 2 lần để xem đường nối xu hướng cá nhân.", width / 2, height / 2);
          return;
        }

        const recent = entries.slice(-30);
        const values = recent.map((entry) => Number(entry.value));
        const min = Math.min(...values);
        const max = Math.max(...values);
        const range = Math.max(max - min, 1);
        const pad = { top: 28, right: 22, bottom: 34, left: 44 };
        const chartWidth = width - pad.left - pad.right;
        const chartHeight = height - pad.top - pad.bottom;

        ctx.strokeStyle = "#e5e7eb";
        ctx.lineWidth = 1;
        for (let i = 0; i <= 3; i += 1) {
          const y = pad.top + (chartHeight / 3) * i;
          ctx.beginPath();
          ctx.moveTo(pad.left, y);
          ctx.lineTo(width - pad.right, y);
          ctx.stroke();
        }

        const points = recent.map((entry, index) => {
          const x = pad.left + (index / Math.max(recent.length - 1, 1)) * chartWidth;
          const y = pad.top + chartHeight - ((Number(entry.value) - min) / range) * chartHeight;
          return { x, y };
        });

        ctx.strokeStyle = "#0ea5e9";
        ctx.lineWidth = 2;
        ctx.beginPath();
        points.forEach((point, index) => {
          if (index === 0) ctx.moveTo(point.x, point.y);
          else ctx.lineTo(point.x, point.y);
        });
        ctx.stroke();

        ctx.fillStyle = "#0284c7";
        points.forEach((point) => {
          ctx.beginPath();
          ctx.arc(point.x, point.y, 4, 0, Math.PI * 2);
          ctx.fill();
        });

        ctx.fillStyle = "#8a8f98";
        ctx.font = "12px sans-serif";
        ctx.textAlign = "left";
        ctx.fillText(`Giá trị nhỏ nhất đã ghi: ${min.toFixed(1)}`, pad.left, height - 10);
        ctx.textAlign = "right";
        ctx.fillText(`Giá trị lớn nhất đã ghi: ${max.toFixed(1)}`, width - pad.right, height - 10);
      };

      const renderAll = () => {
        const entries = getEntries();
        renderSummary(entries);
        renderTable(entries);
        renderChart(entries);
      };

      const addEntry = () => {
        const time = document.getElementById("entry-time").value;
        const value = Number.parseFloat(document.getElementById("entry-value").value);
        const note = document.getElementById("entry-note").value.trim();

        if (!Number.isFinite(value) || value <= 0) {
          alert("Vui lòng nhập số đo hợp lệ từ máy đo.");
          return;
        }

        const entries = getEntries();
        entries.push({
          time,
          value,
          note,
          date: new Date().toISOString(),
        });
        saveEntries(entries);

        document.getElementById("entry-value").value = "";
        document.getElementById("entry-note").value = "";
        renderAll();
      };

      const clearLog = () => {
        if (!confirm("Xóa nhật ký đã lưu trong trình duyệt này?")) return;
        saveEntries([]);
        renderAll();
      };

      document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("add-entry").addEventListener("click", addEntry);
        document.getElementById("clear-log").addEventListener("click", clearLog);
        renderAll();
      });
    })();
  </script>
</BaseLayout>
