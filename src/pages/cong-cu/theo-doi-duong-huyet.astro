---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "🩸 Theo dõi đường huyết — nhật ký & biểu đồ";
const desc = "Ghi lại đường huyết sáng sớm, sau ăn, tối. Xem biểu đồ xu hướng 7 ngày. Đánh giá mức kiểm soát tiểu đường.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/theo-doi-duong-huyet">
  <main class="content-page">
    <div class="page-header">
      <h1><span class="h-icon">🩸</span><span class="h-text">Theo dõi đường huyết</span></h1>
      <p class="page-desc">{desc}</p>
    </div>

    <!-- Targets -->
    <div class="targets">
      <div class="target-card good"><strong>Đói:</strong> 4.0–5.6 mmol/L</div>
      <div class="target-card good"><strong>Sau ăn 2h:</strong> &lt; 7.8 mmol/L</div>
      <div class="target-card mid"><strong>Tối & trước ngủ:</strong> 5.5–7.8 mmol/L</div>
      <div class="target-card warn"><strong>HbA1c mục tiêu:</strong> &lt; 7%</div>
    </div>

    <div class="section-label"><span class="sl-num">1</span> Ghi chỉ số</div>
    <div class="form-card">
      <div class="entry-row">
        <div class="input-wrap stage-wrap" style="flex:1;min-width:140px;">
          <select id="entry-time">
            <option value="fasting">🌅 Đói (sáng sớm)</option>
            <option value="after-breakfast">🌞 Sau ăn sáng 2h</option>
            <option value="before-lunch">🍽️ Trước ăn trưa</option>
            <option value="after-lunch">🌞 Sau ăn trưa 2h</option>
            <option value="before-dinner">🍽️ Trước ăn tối</option>
            <option value="after-dinner">🌙 Sau ăn tối 2h</option>
            <option value="bedtime">🌜 Trước ngủ</option>
          </select>
          <span class="stage-arrow">▼</span>
        </div>
        <div class="input-wrap" style="flex:0.6;min-width:100px;">
          <input type="number" id="entry-value" placeholder="mmol/L" step="0.1" min="1" max="30">
          <span class="input-suffix">mmol/L</span>
        </div>
        <button class="btn-sm" onclick="addEntry()">+ Thêm</button>
      </div>
      <div class="entry-extra">
        <label class="entry-check-label"><input type="checkbox" id="is-after-meal"> Đã ăn? Ghi kèm món:</label>
        <input type="text" id="entry-note" placeholder="VD: cơm 1 bát + cá kho" class="entry-note-input">
        <button class="btn-del" onclick="clearData()">🗑️ Xoá hết</button>
      </div>
    </div>

    <div class="section-label"><span class="sl-num">2</span> Biểu đồ 7 ngày gần nhất</div>
    <div class="card-plain">
      <div id="chart" class="chart-container">
        <canvas id="bg-chart" width="700" height="300"></canvas>
      </div>
      <div class="chart-legend" id="chart-legend"></div>
    </div>

    <div class="section-label"><span class="sl-num">3</span> Nhật ký đường huyết</div>
    <div class="card-plain">
      <div id="stats-bar" class="stats-bar"></div>
      <div id="log-table" class="log-table-wrap"></div>
    </div>

    <!-- Safety -->
    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        Dữ liệu được lưu trong trình duyệt (localStorage). Không đồng bộ với bác sĩ. Đường huyết mục tiêu có thể khác nhau tùy người — hãy hỏi bác sĩ về mục tiêu cá nhân của bạn. Nếu đường huyết &lt; 3.9 hoặc &gt; 16.7, cần cấp cứu ngay.
      </div>
    </div>
  </main>

  <style>
    .content-page { max-width: 800px; margin:0 auto; padding: 32px 20px; }
    .page-header { text-align:center; margin-bottom:28px; }
    .page-header h1 { display:flex; align-items:center; justify-content:center; gap:12px; margin:0 0 10px; }
    .h-icon { font-size:1.8rem; line-height:1; }
    .h-text { font-size:1.65rem; font-weight:800; letter-spacing:-0.02em; line-height:1.2; }
    .page-desc { max-width:560px; margin:0 auto; color:var(--ink-secondary); font-size:0.92rem; line-height:1.6; }

    .section-label { display:flex; align-items:center; gap:10px; font-weight:700; font-size:0.9rem; margin:24px 0 12px; color:var(--ink); }
    .section-label:first-of-type { margin-top:0; }
    .sl-num { width:28px; height:28px; border-radius:50%; background:var(--brand-light); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.78rem; font-weight:800; flex-shrink:0; }

    .form-card { background:var(--card); border:2px solid var(--line); border-radius:16px; padding:24px; margin-bottom:8px; }
    .form-card:focus-within { border-color:var(--brand); }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; margin-bottom:18px; }
    .form-row label { display:block; font-size:0.82rem; font-weight:600; margin-bottom:5px; color:var(--ink-secondary); }
    .input-wrap { display:flex; align-items:center; background:var(--bg); border:1px solid var(--line); border-radius:10px; }
    .input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 2px rgba(46,125,50,0.1); }
    .input-wrap input, .input-wrap select { flex:1; border:none; background:transparent; padding:11px 12px; font-size:0.92rem; color:var(--ink); outline:none; width:100%; }
    .input-wrap select { appearance:none; -webkit-appearance:none; cursor:pointer; font-weight:500; }
    .input-suffix { padding-right:12px; font-size:0.78rem; color:var(--ink-tertiary); font-weight:500; }
    .stage-wrap { position:relative; }
    .stage-arrow { position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:0.65rem; color:var(--ink-tertiary); pointer-events:none; }

    .btn-calc { width:100%; padding:14px; border:none; border-radius:12px; background:linear-gradient(135deg,#2e7d32,#388e3c); color:white; font-size:1rem; font-weight:700; cursor:pointer; font-family:inherit; box-shadow:0 2px 8px rgba(46,125,50,0.2); }
    .btn-calc:hover { opacity:0.9; transform:translateY(-1px); }

    .card-plain { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:20px; margin-bottom:8px; }

    .safety-note { display:flex; align-items:flex-start; gap:12px; margin-top:20px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--line-light); border-radius:12px; font-size:0.82rem; line-height:1.6; }
    .safety-icon-col { flex-shrink:0; font-size:1.1rem; }
    .safety-text-col { flex:1; color:var(--ink-secondary); }

    /* Page-specific styles */
    .targets { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:28px; }
    .target-card { padding:8px 16px; border-radius:10px; font-size:0.85rem; }
    .target-card.good { background:#e8f5e9; color:#2e7d32; border:1px solid #a5d6a7; }
    .target-card.mid { background:#fff8e1; color:#e65100; border:1px solid #ffcc80; }
    .target-card.warn { background:#ffebee; color:#c62828; border:1px solid #ef9a9a; }

    .entry-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
    .btn-sm { padding:10px 20px; background:var(--brand); color:white; border:none; border-radius:10px; font-weight:600; cursor:pointer; font-family:inherit; white-space:nowrap; }
    .btn-sm:hover { opacity:0.85; }

    .entry-extra { display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:0.85rem; }
    .entry-check-label { display:flex; align-items:center; gap:4px; font-size:0.82rem; color:var(--ink-secondary); cursor:pointer; }
    .entry-check-label input { margin:0; }
    .entry-note-input { flex:1; padding:9px 12px; border:1px solid var(--line); border-radius:10px; background:var(--bg); color:var(--ink); font-size:0.85rem; font-family:inherit; outline:none; min-width:120px; box-sizing:border-box; }
    .entry-note-input:focus { border-color:var(--brand); }
    .btn-del { padding:8px 14px; border:1px solid var(--line); border-radius:10px; background:transparent; color:var(--ink-secondary); cursor:pointer; font-size:0.82rem; font-family:inherit; white-space:nowrap; }
    .btn-del:hover { border-color:#ef4444; color:#ef4444; }

    .chart-container { width:100%; max-width:700px; margin:0 auto; }
    #bg-chart { width:100%; height:auto; background:var(--bg-soft); border-radius:12px; }

    .stats-bar { display:flex; gap:16px; flex-wrap:wrap; margin-bottom:14px; padding:12px; background:var(--bg-soft); border-radius:10px; font-size:0.85rem; }
    .stat-item { }
    .stat-item .stat-label { color:var(--ink-secondary); }
    .stat-item .stat-value { font-weight:700; }
    .stat-item .stat-good { color:#2e7d32; }
    .stat-item .stat-warn { color:#e65100; }
    .stat-item .stat-bad { color:#c62828; }

    .log-table-wrap { max-height:400px; overflow-y:auto; }
    .log-table { width:100%; border-collapse:collapse; font-size:0.82rem; }
    .log-table th { position:sticky; top:0; background:var(--brand-light); color:var(--brand); font-weight:700; padding:8px 10px; text-align:left; border-bottom:2px solid var(--brand-light2); }
    .log-table td { padding:8px 10px; border-bottom:1px solid var(--line-light); }
    .log-table .bg-good { color:#2e7d32; font-weight:600; }
    .log-table .bg-mid { color:#e65100; font-weight:600; }
    .log-table .bg-high { color:#c62828; font-weight:600; }
    .log-table .bg-low { color:#9c27b0; font-weight:700; }

    @media (max-width:600px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.25rem; }
      .form-grid { grid-template-columns:1fr; gap:12px; }
    }
  </style>

  <script is:inline>
  (function() {
    var STORAGE_KEY = 'ddv_blood_glucose';
    var COLORS = {
      fasting: '#2196f3', 'after-breakfast': '#ff9800', 'before-lunch': '#4caf50',
      'after-lunch': '#f44336', 'before-dinner': '#9c27b0', 'after-dinner': '#e91e63',
      bedtime: '#607d8b'
    };
    var TIME_LABELS = {
      fasting: '🌅 Đói', 'after-breakfast': '🌞 S.ăn sáng', 'before-lunch': '🍽️ Tr.ăn trưa',
      'after-lunch': '🌞 S.ăn trưa', 'before-dinner': '🍽️ Tr.ăn tối',
      'after-dinner': '🌙 S.ăn tối', bedtime: '🌜 Tối'
    };

    function loadData() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch(e) { return []; }
    }
    function saveData(data) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    function getReadableTime(iso) {
      var d = new Date(iso);
      var dd = d.getDate().toString().padStart(2,'0');
      var mm = (d.getMonth()+1).toString().padStart(2,'0');
      var hh = d.getHours().toString().padStart(2,'0');
      var mi = d.getMinutes().toString().padStart(2,'0');
      return dd+'/'+mm+' '+hh+':'+mi;
    }

    function addEntry() {
      var time = document.getElementById('entry-time').value;
      var val = parseFloat(document.getElementById('entry-value').value);
      var note = document.getElementById('entry-note').value.trim();
      if (!val || val < 1 || val > 30) { alert('Nhập chỉ số đường huyết (1–30 mmol/L)'); return; }
      var data = loadData();
      data.push({
        time: time,
        value: val,
        note: note || '',
        date: new Date().toISOString()
      });
      saveData(data);
      document.getElementById('entry-value').value = '';
      document.getElementById('entry-note').value = '';
      renderTable();
      renderChart();
    }

    function clearData() {
      if (!confirm('Xoá tất cả dữ liệu đường huyết đã ghi?')) return;
      saveData([]);
      renderTable();
      renderChart();
    }

    function renderTable() {
      var data = loadData();
      var recent = data.slice(-50).reverse();

      // Stats
      var fasting = data.filter(function(d) { return d.time === 'fasting'; });
      var vals = data.map(function(d) { return d.value; });
      var avg = vals.length ? (vals.reduce(function(a,b){return a+b;},0)/vals.length).toFixed(1) : '--';
      var avgFasting = '--';
      if (fasting.length) {
        var sumF = 0;
        for (var i=0;i<fasting.length;i++) sumF += fasting[i].value;
        avgFasting = (sumF/fasting.length).toFixed(1);
      }

      var max = vals.length ? Math.max.apply(null, vals).toFixed(1) : '--';
      var hypo = vals.filter(function(v){return v<3.9;}).length;
      var hyper = vals.filter(function(v){return v>13.9;}).length;

      var avgClass = avg !== '--' ? (parseFloat(avg) < 8 ? 'stat-good' : 'stat-warn') : '';
      var fClass = avgFasting !== '--' ? (parseFloat(avgFasting) < 6.5 ? 'stat-good' : 'stat-warn') : '';

      document.getElementById('stats-bar').innerHTML = [
        '<div class="stat-item">📊 <span class="stat-label">TB tất cả:</span> <span class="stat-value '+avgClass+'">'+avg+' mmol/L</span></div>',
        '<div class="stat-item">🌅 <span class="stat-label">TB đói:</span> <span class="stat-value '+fClass+'">'+avgFasting+' mmol/L</span></div>',
        '<div class="stat-item">⬆️ <span class="stat-label">Cao nhất:</span> <span class="stat-value stat-warn">'+max+' mmol/L</span></div>',
        '<div class="stat-item">⬇️ <span class="stat-label">Hạ đg huyết:</span> <span class="stat-value '+ (hypo>0?'stat-bad':'stat-good')+'">'+hypo+' lần</span></div>',
        '<div class="stat-item">⚠️ <span class="stat-label">Tăng cao:</span> <span class="stat-value '+(hyper>0?'stat-warn':'stat-good')+'">'+hyper+' lần</span></div>',
      ].join('');

      // Table
      if (!recent.length) {
        document.getElementById('log-table').innerHTML = '<p style="text-align:center;color:var(--ink-tertiary);padding:20px;">📝 Chưa có dữ liệu — thêm chỉ số đầu tiên</p>';
        return;
      }
      var html = '<table class="log-table"><thead><tr><th>Thời gian</th><th>Lúc</th><th>Chỉ số</th><th>Đánh giá</th><th>Ghi chú</th></tr></thead><tbody>';
      for (var i=0;i<recent.length;i++) {
        var d = recent[i];
        var cls = d.value < 3.9 ? 'bg-low' : d.value <= 7.8 ? 'bg-good' : d.value <= 13.9 ? 'bg-mid' : 'bg-high';
        var lbl = d.value < 3.9 ? '⬇️ Hạ' : d.value <= 7.8 ? '✅ Tốt' : d.value <= 10 ? '🟡 Hơi cao' : d.value <= 13.9 ? '🔴 Cao' : '🚨 Rất cao';
        html += '<tr><td>'+getReadableTime(d.date)+'</td><td>'+TIME_LABELS[d.time]+'</td><td class="'+cls+'">'+d.value.toFixed(1)+'</td><td>'+lbl+'</td><td>'+(d.note || '')+'</td></tr>';
      }
      html += '</tbody></table>';
      document.getElementById('log-table').innerHTML = html;
    }

    function renderChart() {
      var data = loadData();
      var canvas = document.getElementById('bg-chart');
      var ctx = canvas.getContext('2d');
      var W = canvas.width = Math.min(700, window.innerWidth - 60);
      var H = canvas.height = 300;

      ctx.clearRect(0,0,W,H);
      if (data.length < 2) {
        ctx.fillStyle = '#aaa';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('📊 Ghi ít nhất 2 chỉ số để xem biểu đồ', W/2, H/2);
        return;
      }

      // Take last 50 entries
      var recent = data.slice(-50);
      var min = Math.floor(Math.min.apply(null, recent.map(function(d){return d.value;})) * 0.8);
      var max = Math.ceil(Math.max.apply(null, recent.map(function(d){return d.value;})) * 1.2);
      if (min < 1) min = 1;
      if (max < 10) max = 10;

      var pad = {t:20, b:30, l:40, r:20};
      var chartW = W - pad.l - pad.r;
      var chartH = H - pad.t - pad.b;

      // Background lines
      ctx.strokeStyle = '#e0e0e0';
      ctx.lineWidth = 0.5;
      var lines = 4;
      for (var i=0;i<=lines;i++) {
        var y = pad.t + (chartH/lines)*i;
        ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();
        var val = max - ((max-min)/lines)*i;
        ctx.fillStyle = '#888';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText(val.toFixed(1)+' ', pad.l-4, y+4);
      }

      // Reference lines
      ctx.strokeStyle = '#4caf50';
      ctx.lineWidth = 1;
      ctx.setLineDash([4,4]);
      var refY = pad.t + chartH - ((7.8-min)/(max-min))*chartH;
      if (refY > pad.t && refY < pad.t+chartH) {
        ctx.beginPath(); ctx.moveTo(pad.l, refY); ctx.lineTo(W-pad.r, refY); ctx.stroke();
        ctx.fillStyle = '#4caf50'; ctx.font = '9px sans-serif'; ctx.textAlign = 'left';
        ctx.fillText('⬆️ Sau ăn lý tưởng 7.8', W-pad.r-150, refY-4);
      }
      ctx.setLineDash([]);

      // Plot points
      var points = recent.map(function(d,i) {
        var x = pad.l + (i / Math.max(recent.length-1,1)) * chartW;
        var y = pad.t + chartH - ((d.value-min)/(max-min))*chartH;
        return {x:x, y:y, val:d.value, time:d.time, idx:i};
      });

      // Lines connecting
      ctx.strokeStyle = '#2196f3';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(points[0].x, points[0].y);
      for (var i=1;i<points.length;i++) ctx.lineTo(points[i].x, points[i].y);
      ctx.stroke();

      // Points
      for (var i=0;i<points.length;i++) {
        var p = points[i];
        var color = p.val < 3.9 ? '#9c27b0' : p.val <= 7.8 ? '#4caf50' : p.val <= 13.9 ? '#ff9800' : '#f44336';
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4, 0, Math.PI*2);
        ctx.fill();
      }

      // X axis labels (show date of first, middle, last)
      ctx.fillStyle = '#888';
      ctx.font = '9px sans-serif';
      ctx.textAlign = 'center';
      var firstDate = getReadableTime(recent[0].date).split(' ')[0];
      var midDate = recent.length > 2 ? getReadableTime(recent[Math.floor(recent.length/2)].date).split(' ')[0] : '';
      var lastDate = getReadableTime(recent[recent.length-1].date).split(' ')[0];
      ctx.fillText(firstDate, points[0].x, H-8);
      if (midDate) ctx.fillText(midDate, points[Math.floor(points.length/2)].x, H-8);
      ctx.fillText(lastDate, points[points.length-1].x, H-8);
    }

    // Init
    document.addEventListener('DOMContentLoaded', function() {
      renderTable();
      renderChart();
    });

    window.addEventListener('resize', function() {
      renderChart();
    });

    // Expose for onclick
    window.addEntry = addEntry;
    window.clearData = clearData;
  })();
  </script>
</BaseLayout>
