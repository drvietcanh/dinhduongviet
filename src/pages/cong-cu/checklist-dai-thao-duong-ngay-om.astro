---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist đái tháo đường ngày ốm";
const desc = "Bảng kiểm chuẩn bị theo dõi đường huyết, ăn uống, nước và thuốc khi người bệnh đái tháo đường bị ốm.";
const items = [
  "Tôi có kế hoạch ngày ốm do bác sĩ/điều dưỡng hướng dẫn và biết khi nào cần gọi",
  "Tôi có máy đo đường huyết, que thử còn hạn và ghi lại các kết quả bất thường",
  "Tôi chuẩn bị nước/oresol theo hướng dẫn và theo dõi nôn, tiêu chảy, lượng tiểu",
  "Tôi có nguồn carbohydrate tác dụng nhanh để xử trí hạ đường huyết theo kế hoạch",
  "Tôi biết không tự ý tăng, giảm hoặc ngừng thuốc; đã hỏi rõ thuốc nào cần xử trí khi không ăn được",
  "Tôi kiểm tra bàn chân, vết thương và dấu nhiễm trùng khi sức khỏe xấu đi",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-dai-thao-duong-ngay-om">
  <main class="diabetes-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm đái tháo đường</p>
      <h1>🩸 Checklist ngày ốm</h1>
      <p>{desc} Mỗi người có kế hoạch thuốc và ngưỡng liên hệ khác nhau; ưu tiên hướng dẫn của ê-kíp điều trị.</p>
    </header>
    <form id="diabetes-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-diabetes /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần liên hệ ngay</h2>
      <p>Lơ mơ/ngất, khó thở, nôn không giữ được nước, đau bụng, mất nước, đường huyết rất thấp hoặc cao kéo dài theo ngưỡng đã được dặn, hoặc nghi nhiễm toan ceton.</p>
      <p class="warning">Không cố ăn/uống khi đang rối loạn ý thức và không tự điều chỉnh insulin/thuốc theo checklist này.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("diabetes-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-diabetes]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi đường huyết, triệu chứng và mang theo danh sách thuốc khi liên hệ ê-kíp.</p>`
        : `<h2>Còn ${missing} mục nên chuẩn bị</h2><p>Hãy hỏi bác sĩ/điều dưỡng về phần còn thiếu trước khi có đợt ốm tiếp theo.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .diabetes-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .diabetes-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
