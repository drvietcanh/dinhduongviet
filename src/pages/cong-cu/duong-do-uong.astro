---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Đường trong đồ uống tham khảo";
const desc =
  "Tra cứu lượng đường tham khảo trong một số đồ uống phổ biến, dựa trên dữ liệu nội bộ và khẩu phần hiển thị.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/duong-do-uong">
  <main class="content-page sugar-page">
    <header class="page-header">
      <h1>🧋 Đường trong đồ uống</h1>
      <p class="page-desc">{desc}</p>
    </header>

    <section class="safety-shell" aria-label="Luu y tham khao">
      <p>
        Công cụ này chỉ hỗ trợ đọc nhãn hoặc tra cứu lượng đường tham khảo trong đồ uống phổ biến.
        Kết quả không kết luận đồ uống tốt hay xấu và không thay thế tư vấn của bác sĩ hoặc chuyên gia dinh dưỡng.
      </p>
      <p>
        Hãy kiểm tra lại khẩu phần, dung tích thực uống và nhãn sản phẩm. Người có bệnh nền, đang dùng thuốc,
        thai kỳ, trẻ em hoặc cần chế độ ăn điều trị nên hỏi nhân viên y tế nếu cần hướng dẫn cá nhân.
      </p>
      <p>
        Mốc đọc nhanh ở v1: WHO khuyến nghị hạn chế đường tự do dưới 10% tổng năng lượng mỗi ngày; giảm xuống dưới khoảng 25 g/ngày có thể có thêm lợi ích.
      </p>
    </section>

    <section class="lookup-panel" aria-labelledby="sugar-lookup-title">
      <div class="panel-head">
        <h2 id="sugar-lookup-title">Tra cứu theo tên đồ uống</h2>
        <p>
          Danh sách dưới đây hiển thị số gram đường theo khẩu phần ghi kèm. Đây là dữ liệu tham khảo để đọc nhãn
          và so sánh khẩu phần, không phải khuyến nghị điều trị hay mục tiêu cá nhân.
        </p>
      </div>

      <label class="search-label" for="sugar-search">Tên đồ uống</label>
      <input
        id="sugar-search"
        type="text"
        inputmode="search"
        autocomplete="off"
        placeholder="Ví dụ: tra sua, coca, ca phe sua"
      />

      <p class="lookup-note">
        Số liệu hiển thị theo khẩu phần mô tả trong từng dòng. Dữ liệu có thể thay đổi theo nhãn hàng,
        công thức pha, đá, topping hoặc kích cỡ thực tế.
      </p>

      <div id="drink-results" class="drink-results" aria-live="polite"></div>
    </section>
  </main>

  <style>
    .sugar-page {
      max-width: 860px;
      margin: 0 auto;
    }
    .page-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .page-desc {
      max-width: 620px;
      margin: 10px auto 0;
      color: var(--ink-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .safety-shell,
    .lookup-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 18px;
      margin-bottom: 18px;
      box-shadow: var(--shadow-sm);
    }
    .safety-shell {
      background: var(--brand-light);
    }
    .safety-shell p,
    .panel-head p,
    .lookup-note,
    .empty-state,
    .drink-meta {
      margin: 0;
      color: var(--ink-secondary);
      line-height: 1.6;
      font-size: 0.92rem;
    }
    .safety-shell p + p,
    .panel-head p + p {
      margin-top: 10px;
    }
    .panel-head {
      margin-bottom: 14px;
    }
    .panel-head h2 {
      margin: 0 0 6px;
      font-size: 1.05rem;
    }
    .search-label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    #sugar-search {
      width: 100%;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 12px 14px;
      background: var(--card);
      color: inherit;
      font: inherit;
      box-sizing: border-box;
      transition: border-color var(--transition), box-shadow var(--transition);
    }
    #sugar-search:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }
    .lookup-note {
      margin-top: 10px;
      font-size: 0.85rem;
    }
    .drink-results {
      display: grid;
      gap: 10px;
      margin-top: 16px;
    }
    .drink-card,
    .empty-state {
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 14px;
      background: var(--bg-soft);
      transition: all var(--transition);
    }
    .drink-card:hover {
      border-color: var(--brand);
      background: var(--card);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }
    .drink-top {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .drink-icon {
      font-size: 1.35rem;
      line-height: 1;
      margin-top: 2px;
    }
    .drink-main {
      flex: 1;
      min-width: 0;
    }
    .drink-name {
      margin: 0;
      font-size: 0.98rem;
    }
    .drink-meta {
      margin-top: 4px;
    }
    .drink-value {
      font-weight: 700;
      white-space: nowrap;
      font-size: 0.98rem;
      margin-left: 10px;
      color: var(--brand);
    }
    .empty-state strong {
      display: block;
      margin-bottom: 6px;
      color: var(--ink);
    }
    @media (max-width: 640px) {
      .safety-shell,
      .lookup-panel {
        padding: 16px;
      }
      .drink-top {
        flex-wrap: wrap;
      }
      .drink-value {
        margin-left: 0;
      }
    }
  </style>

  <script>
    (function () {
      var drinks = [
        { icon: "🧋", name: "Trà sữa trân châu size M", portion: "500 ml", sugar: 48 },
        { icon: "🧋", name: "Trà sữa trân châu size L", portion: "700 ml", sugar: 65 },
        { icon: "🥤", name: "Coca-Cola", portion: "1 lon 330 ml", sugar: 39 },
        { icon: "🥤", name: "Pepsi", portion: "1 lon 330 ml", sugar: 41 },
        { icon: "🥤", name: "Sprite", portion: "1 lon 330 ml", sugar: 38 },
        { icon: "🥤", name: "7Up", portion: "1 lon 330 ml", sugar: 38 },
        { icon: "🧃", name: "Nước cam ép đóng hộp", portion: "330 ml", sugar: 27 },
        { icon: "🧃", name: "Nước ép táo đóng hộp", portion: "330 ml", sugar: 30 },
        { icon: "🧃", name: "Nước ép xoài đóng hộp", portion: "330 ml", sugar: 32 },
        { icon: "🧋", name: "Trà đào", portion: "500 ml", sugar: 46 },
        { icon: "🧋", name: "Trà chanh có đường", portion: "500 ml", sugar: 35 },
        { icon: "☕", name: "Cà phê sữa đá", portion: "300 ml", sugar: 28 },
        { icon: "☕", name: "Cà phê đen có đường", portion: "1 tách", sugar: 8 },
        { icon: "☕", name: "Caramel Frappuccino cỡ grande", portion: "473 ml", sugar: 54 },
        { icon: "🥤", name: "Nước tăng lực Red Bull", portion: "1 lon 250 ml", sugar: 27 },
        { icon: "🥤", name: "Nước tăng lực Monster", portion: "1 lon 473 ml", sugar: 54 },
        { icon: "🥛", name: "Sữa đặc pha", portion: "200 ml", sugar: 24 },
        { icon: "🥛", name: "Sữa Milo", portion: "1 hộp 200 ml", sugar: 22 },
        { icon: "🥛", name: "Sữa chua uống Yakult", portion: "1 chai 100 ml", sugar: 13 },
        { icon: "🧃", name: "Nước dừa tươi", portion: "1 trái khoảng 300 ml", sugar: 15 },
        { icon: "🧃", name: "Nước mía", portion: "1 ly 250 ml", sugar: 30 },
        { icon: "🧃", name: "Sinh tố bơ có đường hoặc sữa đặc", portion: "300 ml", sugar: 28 },
        { icon: "🧃", name: "Sinh tố xoài có đường", portion: "300 ml", sugar: 32 },
        { icon: "🍺", name: "Bia tùy loại", portion: "1 lon 330 ml", sugar: 0 },
        { icon: "🍷", name: "Rượu vang đỏ", portion: "1 ly 150 ml", sugar: 1 },
        { icon: "🍸", name: "Cocktail Mojito", portion: "1 ly 300 ml", sugar: 20 }
      ];

      function normalizeText(value) {
        return String(value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();
      }

      function createDrinkCard(drink) {
        var card = document.createElement("article");
        card.className = "drink-card";

        var top = document.createElement("div");
        top.className = "drink-top";

        var icon = document.createElement("div");
        icon.className = "drink-icon";
        icon.textContent = drink.icon;

        var main = document.createElement("div");
        main.className = "drink-main";

        var name = document.createElement("h3");
        name.className = "drink-name";
        name.textContent = drink.name;

        var meta = document.createElement("p");
        meta.className = "drink-meta";
        meta.textContent = "Khẩu phần tham khảo: " + drink.portion;

        var value = document.createElement("div");
        value.className = "drink-value";
        value.textContent = drink.sugar + " g đường";

        main.appendChild(name);
        main.appendChild(meta);
        top.appendChild(icon);
        top.appendChild(main);
        top.appendChild(value);
        card.appendChild(top);

        return card;
      }

      function createState(titleText, bodyText) {
        var empty = document.createElement("div");
        empty.className = "empty-state";

        var title = document.createElement("strong");
        title.textContent = titleText;

        var body = document.createElement("p");
        body.textContent = bodyText;

        empty.appendChild(title);
        empty.appendChild(body);
        return empty;
      }

      function renderResults(list) {
        var container = document.getElementById("drink-results");
        if (!container) return;

        if (!list.length) {
          container.replaceChildren(
            createState(
              "Chưa có kết quả phù hợp",
              "Hãy thử tên đồ uống khác hoặc kiểm tra lại cách viết. Kết quả chỉ mang tính tham khảo theo dữ liệu hiện có."
            )
          );
          return;
        }

        var nodes = list.map(createDrinkCard);
        container.replaceChildren.apply(container, nodes);
      }

      var input = document.getElementById("sugar-search");
      var container = document.getElementById("drink-results");

      if (container) {
        container.replaceChildren(
          createState(
            "Nhập tên đồ uống để tra cứu",
            "Bạn có thể thử các từ khóa như tra, trà, sua, sữa, nuoc, nước hoặc coca. Kết quả hiển thị theo dữ liệu tham khảo hiện có."
          )
        );
      }

      if (!input) return;

      input.addEventListener("input", function () {
        var query = normalizeText(input.value);
        if (!query) {
          if (container) {
            container.replaceChildren(
              createState(
                "Nhập tên đồ uống để tra cứu",
                "Bạn có thể thử các từ khóa như tra, trà, sua, sữa, nuoc, nước hoặc coca. Kết quả hiển thị theo dữ liệu tham khảo hiện có."
              )
            );
          }
          return;
        }

        var filtered = drinks.filter(function (drink) {
          return normalizeText(drink.name).indexOf(query) !== -1;
        });

        renderResults(filtered);
      });
    })();
  </script>
</BaseLayout>
