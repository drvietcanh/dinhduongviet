---
// tim-mon-tu-nguyen-lieu.astro — Gợi ý món ăn từ nguyên liệu có sẵn
import BaseLayout from "../../layouts/BaseLayout.astro";

// Categories are hardcoded for the static checklist UI
// Ingredient data loaded client-side from /ingredient-map.json
const catData = [
  "Rau xanh", "Củ quả", "Thịt", "Cá", "Hải sản", "Tinh bột", "Trái cây",
  "Đậu", "Nấm", "Trứng sữa", "Gia vị", "Dầu mỡ", "Rau gia vị", "Bánh kẹo", "Thịt chế biến", "Đồ uống", "Nước dùng", "Hạt"
];
---

<BaseLayout title="Tìm món từ nguyên liệu có sẵn - Dinh Dưỡng Việt">
  <section>
    <span class="badge">🔍 Công cụ</span>
    <h1>Tìm món từ nguyên liệu có sẵn</h1>
    <p class="lead">
      Nhập các nguyên liệu bạn đang có để xem gợi ý ý tưởng món ăn ở mức tham khảo, dựa trên độ khớp nguyên liệu.
    </p>
  </section>

  <div class="safety-shell">
    <p><strong>Lưu ý:</strong> Công cụ này chỉ gợi ý ý tưởng món ăn từ nguyên liệu bạn nhập, không dùng để kết luận theo bệnh nền hoặc tư vấn điều trị.</p>
    <p>Hãy kiểm tra lại dị ứng, hạn dùng, vệ sinh thực phẩm và chế biến chín trước khi dùng. Người có bệnh nền, đang dùng thuốc, thai kỳ, trẻ em hoặc cần chế độ ăn điều trị nên hỏi bác sĩ hoặc chuyên gia dinh dưỡng.</p>
  </div>

  <div class="app-container" id="recipe-finder-app">
    <!-- Category filter tabs -->
    <div class="cat-tabs" id="cat-tabs">
      <button class="cat-tab active" data-cat="all">Tất cả</button>
      {catData.map(cat => (
        <button class="cat-tab" data-cat={cat}>{cat}</button>
      ))}
    </div>

    <!-- Ingredient checkboxes -->
    <div class="ing-grid" id="ing-grid">
      <div class="empty-state"><p>Đang tải nguyên liệu...</p></div>
    </div>

    <!-- Results -->
    <div class="results-panel">
      <div class="results-header">
        <h2>Món gợi ý</h2>
        <span class="results-count" id="results-count">Chọn nguyên liệu để bắt đầu</span>
      </div>
      <div class="recipe-results" id="recipe-results">
        <div class="empty-state">
          <p>☝️ Chọn ít nhất 1 nguyên liệu để xem gợi ý ý tưởng món ăn.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  fetch('/ingredient-map.json')
    .then(r => r.json())
    .then(data => {
      window.recipeData = data;
      initApp();
    })
    .catch(() => {
      const grid = document.getElementById('ing-grid');
      const results = document.getElementById('recipe-results');
      const count = document.getElementById('results-count');
      const message = 'Chưa tải được dữ liệu nguyên liệu. Hãy thử tải lại trang sau ít phút.';
      if (grid) {
        const box = document.createElement('div');
        box.className = 'empty-state';
        const p = document.createElement('p');
        p.textContent = message;
        box.appendChild(p);
        grid.replaceChildren(box);
      }
      if (results) {
        const box = document.createElement('div');
        box.className = 'empty-state';
        const p = document.createElement('p');
        p.textContent = message;
        box.appendChild(p);
        results.replaceChildren(box);
      }
      if (count) count.textContent = 'Chưa tải được dữ liệu';
    });

  function initApp() {
    const data = window.recipeData;
    const grid = document.getElementById('ing-grid');
    const results = document.getElementById('recipe-results');
    const count = document.getElementById('results-count');
    const tabs = document.querySelectorAll('.cat-tab');
    const allRecipes = Object.keys(data.recipeToIngs || {});

    renderIngredientGroups(data.categories || []);

    const checkboxes = document.querySelectorAll('.ing-chip input[type="checkbox"]');

    // Category filter
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const cat = tab.dataset.cat;
        document.querySelectorAll('.cat-group').forEach(g => {
          g.style.display = (cat === 'all' || g.dataset.cat === cat) ? '' : 'none';
        });
      });
    });

    // Search when ingredients change
    checkboxes.forEach(cb => {
      cb.addEventListener('change', searchRecipes);
    });

    function searchRecipes() {
      const selected = [...checkboxes].filter(cb => cb.checked).map(cb => cb.value);
      
      if (selected.length === 0) {
        renderEmptyState('☝️ Chọn ít nhất 1 nguyên liệu để xem gợi ý ý tưởng món ăn.');
        count.textContent = 'Chọn nguyên liệu để bắt đầu';
        return;
      }

      // Score each recipe
      const scored = allRecipes.map(slug => {
        const ings = data.recipeToIngs[slug] || [];
        const matched = ings.filter(id => selected.includes(id));
        const score = matched.length;
        const matchRatio = ings.length > 0 ? (matched.length / ings.length) : 0;
        return { slug, score, matchRatio, totalIngs: ings.length, matched };
      });

      // Sort: by matched count desc, then match ratio asc (prioritizes recipes that use selected ings)
      scored.sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        if (a.matchRatio !== b.matchRatio) return a.matchRatio - b.matchRatio;
        return (data.recipeNames[a.slug] || a.slug).localeCompare(data.recipeNames[b.slug] || b.slug, 'vi');
      });

      const top = scored.filter(r => r.score > 0).slice(0, 20);
      
      count.textContent = `Tìm thấy ${top.length} gợi ý món`;
      
      if (top.length === 0) {
        renderEmptyState('Không tìm thấy gợi ý món nào với nguyên liệu đã chọn. Thử thêm nguyên liệu khác để tham khảo thêm.');
        return;
      }

      renderResults(top);
    }

    function renderIngredientGroups(categories) {
      const fragment = document.createDocumentFragment();

      categories.forEach(cat => {
        const section = document.createElement('section');
        section.className = 'cat-group';
        section.dataset.cat = cat.name;

        const label = document.createElement('div');
        label.className = 'cat-label';
        label.textContent = cat.name;

        const itemsWrap = document.createElement('div');
        itemsWrap.className = 'ing-items';

        (cat.items || []).forEach(item => {
          const chip = document.createElement('label');
          chip.className = 'ing-chip';
          chip.dataset.id = item.id;

          const input = document.createElement('input');
          input.type = 'checkbox';
          input.value = item.id;

          const name = document.createElement('span');
          name.className = 'chip-name';
          name.textContent = item.name;

          const chipCount = document.createElement('span');
          chipCount.className = 'chip-count';
          chipCount.textContent = String(item.recipeCount || 0);

          chip.appendChild(input);
          chip.appendChild(name);
          chip.appendChild(chipCount);
          itemsWrap.appendChild(chip);
        });

        section.appendChild(label);
        section.appendChild(itemsWrap);
        fragment.appendChild(section);
      });

      grid.replaceChildren(fragment);
    }

    function renderResults(items) {
      const fragment = document.createDocumentFragment();

      items.forEach(r => {
        const matchedNames = r.matched.map(id => {
          const f = document.querySelector(`.ing-chip[data-id="${id}"] .chip-name`);
          return f ? f.textContent : id;
        }).join(', ');

        const link = document.createElement('a');
        link.href = `/mon-an/${r.slug}`;
        link.className = 'recipe-result-item';

        const header = document.createElement('div');
        header.className = 'rr-header';

        const strong = document.createElement('strong');
        strong.textContent = data.recipeNames[r.slug] || r.slug;

        const badge = document.createElement('span');
        badge.className = 'rr-badge';
        badge.textContent = `${r.score}/${r.totalIngs} nguyên liệu khớp`;

        header.appendChild(strong);
        header.appendChild(badge);

        const matched = document.createElement('div');
        matched.className = 'rr-matched';
        matched.textContent = `Khớp với nguyên liệu đã chọn: ${matchedNames}`;

        link.appendChild(header);
        link.appendChild(matched);

        if (r.matchRatio >= 0.5) {
          const tip = document.createElement('div');
          tip.className = 'rr-tip';
          tip.textContent = 'Mức khớp nguyên liệu cao trong tập nguyên liệu của món này.';
          link.appendChild(tip);
        }

        fragment.appendChild(link);
      });

      results.replaceChildren(fragment);
    }

    function renderEmptyState(message) {
      const box = document.createElement('div');
      box.className = 'empty-state';
      const p = document.createElement('p');
      p.textContent = message;
      box.appendChild(p);
      results.replaceChildren(box);
    }
  }
</script>

<style>
  .safety-shell {
    margin: 18px 0 20px;
    padding: 14px 16px;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    background: #eff6ff;
    color: #1f2937;
  }
  .safety-shell p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .safety-shell p + p {
    margin-top: 8px;
  }
  .app-container {
    margin-top: 20px;
  }
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .cat-tab {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    cursor: pointer;
    font-size: 0.85em;
    transition: all 0.15s;
  }
  .cat-tab:hover { background: var(--line-light); }
  .cat-tab.active {
    background: #1d4ed8;
    color: #fff;
    border-color: #1d4ed8;
  }
  .cat-group {
    display: none;
    margin-bottom: 16px;
  }
  .cat-group[data-cat] { display: none; }
  .cat-group:first-of-type { display: block; }
  .cat-tab[data-cat="all"].active ~ #ing-grid .cat-group { display: block; }
  /* Simple approach: show all groups by default, JS toggles */
  .cat-group { display: block; }
  
  .cat-label {
    font-size: 0.9em;
    color: #6b7280;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid #e5e7eb;
  }
  .ing-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .ing-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid #d1d5db;
    border-radius: 16px;
    font-size: 0.85em;
    cursor: pointer;
    transition: all 0.15s;
    user-select: none;
  }
  .ing-chip:hover { border-color: #60a5fa; background: var(--bg-info); }
  .ing-chip input { display: none; }
  .ing-chip:has(input:checked) {
    border-color: #2563eb;
    background: #dbeafe;
    box-shadow: 0 0 0 1px #2563eb;
  }
  .chip-name { flex: 1; }
  .chip-count {
    font-size: 0.75em;
    color: #9ca3af;
    background: #f3f4f6;
    padding: 0 5px;
    border-radius: 8px;
  }
  
  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-top: 20px;
    border-top: 2px solid #e5e7eb;
  }
  .results-count { font-size: 0.9em; color: #6b7280; }
  
  .recipe-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .recipe-result-item {
    display: block;
    padding: 12px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s;
  }
  .recipe-result-item:hover { border-color: #93c5fd; background: var(--card-hover); }
  .rr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .rr-badge {
    font-size: 0.75em;
    padding: 2px 8px;
    border-radius: 10px;
    background: #e5e7eb;
    color: #374151;
  }
  .rr-matched {
    font-size: 0.85em;
    color: #6b7280;
  }
  .rr-tip {
    font-size: 0.8em;
    color: #2563eb;
    margin-top: 4px;
  }
  .empty-state {
    text-align: center;
    padding: 40px;
    color: #9ca3af;
  }
</style>
