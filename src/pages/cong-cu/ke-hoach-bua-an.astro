        { name: "Cơm gạo lứt + Ức gà xào nấm", slug: "com-gao-lut-nam", cal: 380, pro: 28, fat: 8, carb: 48, tags: ["healthy"] },
        { name: "Cơm trắng + Canh chua cá", slug: "canh-chua-ca", cal: 440, pro: 24, fat: 10, carb: 60, tags: ["vietnamese","soup"] },
