        { name: "Cơm trắng + Canh rau ngót", slug: "canh-rau-ngot-thit-bam", cal: 400, pro: 20, fat: 10, carb: 58, tags: ["vietnamese","soup"] },
        { name: "Cơm trắng + Canh bí đỏ thịt băm", slug: "canh-bi-do-thit-bam", cal: 420, pro: 20, fat: 12, carb: 56, tags: ["vietnamese","soup"] },
        { name: "Cơm trắng + Nem rán", slug: "nem-ran", cal: 500, pro: 22, fat: 20, carb: 58, tags: ["vietnamese"] },
      ],
      soup: [
        { name: "Canh rau ngót thịt băm", slug: "canh-rau-ngot-thit-bam", cal: 80, pro: 6, fat: 3, carb: 8, tags: ["soup"] },
        { name: "Canh bí đỏ thịt băm", slug: "canh-bi-do-thit-bam", cal: 90, pro: 5, fat: 3, carb: 12, tags: ["soup"] },
        { name: "Canh chua cá", slug: "canh-chua-ca", cal: 120, pro: 10, fat: 4, carb: 12, tags: ["soup"] },
        { name: "Canh rau đền thịt băm", slug: "canh-rau-den-thit-bam", cal: 70, pro: 5, fat: 2, carb: 8, tags: ["soup"] },
        { name: "Canh mồng tơi cua", slug: "canh-mong-toi-cua", cal: 80, pro: 6, fat: 2, carb: 10, tags: ["soup"] },
        { name: "Canh mướp tôm", slug: "canh-muop-huong-tom", cal: 60, pro: 4, fat: 1, carb: 8, tags: ["soup"] },
        { name: "Canh bí xanh tôm khô", slug: "canh-bi-xanh-tom-kho", cal: 65, pro: 5, fat: 1, carb: 9, tags: ["soup"] },
        { name: "Canh tôm rong biển", slug: "canh-tom-rong-bien", cal: 70, pro: 6, fat: 1, carb: 8, tags: ["soup"] },
        { name: "Canh chay rau củ", slug: "canh-chay-rau-cu", cal: 50, pro: 2, fat: 1, carb: 9, tags: ["soup","vegetarian"] },
      ],
      dessert: [
        { name: "Chè đậu xanh", slug: "che-dau-xanh", cal: 180, pro: 4, fat: 2, carb: 38, tags: ["dessert"] },
        { name: "Chè ba ba", slug: "che-ba-ba-moi", cal: 220, pro: 3, fat: 6, carb: 40, tags: ["dessert"] },
        { name: "Chè đậu đen", slug: "che-dau-den-moi", cal: 200, pro: 5, fat: 3, carb: 38, tags: ["dessert"] },
        { name: "Sinh tố bơ", slug: "sinh-to-bo-v2", cal: 200, pro: 3, fat: 12, carb: 22, tags: ["drink"] },
        { name: "Sinh tố dưa hấu", slug: "sinh-to-dua", cal: 120, pro: 1, fat: 0, carb: 28, tags: ["drink"] },
        { name: "Trái cây tươi", slug: "trai-cay-tuoi", cal: 80, pro: 1, fat: 0, carb: 20, tags: ["fruit"] },
      ]
    };

    // Condition-based food restrictions
    const CONDITION_RULES = {
      diabetes: { maxSugarMeals: false, preferLowGI: true, desc: "Phù hợp cho người đái tháo đường", advice: "⚠️ Ưu tiên món ít đường, nhiều xơ" },
      hypertension: { maxSodium: true, preferLowSalt: true, desc: "Phù hợp cho người tăng huyết áp", advice: "⚠️ Ưu tiên món ít muối, nhiều rau" },
      dyslipidemia: { maxFat: true, preferLowFat: true, desc: "Phù hợp cho người rối loạn mỡ máu", advice: "⚠️ Hạn chế mỡ động vật, tăng chất xơ" },
      gout: { maxPurine: true, preferLowPurine: true, desc: "Phù hợp cho người gout", advice: "⚠️ Hạn chế thịt đỏ, nội tạng; tăng rau" },
      ckd: { maxProtein: true, preferLowProtein: true, desc: "Phù hợp cho người bệnh thận", advice: "⚠️ Giảm đạm, hạn chế muối" },
      vegetarian: { noMeat: true, desc: "Không thịt cá", advice: "🌱 Chay: ưu tiên đậu phụ và rau củ" },
    };

    // Filter pool based on condition
    function filterMeal(pool, condition) {
      if (!condition || condition === "") return pool;
      const rules = CONDITION_RULES[condition];
      if (!rules) return pool;
      if (rules.noMeat) {
        return pool.filter(m => !["pho-bo","banh-mi-thit","bun-cha","thit-kho-trung","ca-kho-to",
          "thit-bo-xao-can","suon-kho","ca-chep-kho-tuong","thit-bo-nuong-la-lot",
          "ga-nuong-mat-ong","thit-heo-luoc","com-rau-muong-dau-huy","com-gao-lut-luoc",
          "canh-rau-ngot-thit-bam","canh-bi-do-thit-bam","bun-rieu-cua","com-hen",
          "chao-long","canh-chua-ca","tom-hap-sa","ca-loc-hap","muc-xao",
          "canh-rau-den-thit-bam","canh-mong-toi-cua","canh-muop-huong-tom",
          "canh-bi-xanh-tom-kho","canh-tom-rong-bien","bun-bo-hue","pho-ga","bun-moc","banh-da-cua",
          "com-tam-suon","banh-trang-tron","bun-rieu-cua","banh-cuon"].includes(m.slug));
      }
      return pool;
    }

    function pickRandom(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    // Generate meal plan
    function generatePlan(data) {
      const { age, sex, weight, height, activity, goal, condition } = data;
      const actVal = parseFloat(activity);

      // BMR (Mifflin-St Jeor)
      let bmr;
      if (sex === "male") {
        bmr = 10 * weight + 6.25 * height - 5 * age + 5;
      } else {
        bmr = 10 * weight + 6.25 * height - 5 * age - 161;
      }
      let tdee = Math.round(bmr * actVal);

      // Calorie target based on goal
      let calTarget;
      if (goal === "lose") calTarget = Math.round(tdee * 0.8);
      else if (goal === "gain") calTarget = Math.round(tdee * 1.15);
      else calTarget = tdee;

      // Macro split
      let proteinPct = 0.25, fatPct = 0.25, carbPct = 0.50;
      if (goal === "gain") { proteinPct = 0.30; fatPct = 0.25; carbPct = 0.45; }
      else if (goal === "lose") { proteinPct = 0.30; fatPct = 0.25; carbPct = 0.45; }
      // Adjust for condition
      if (condition === "ckd") { proteinPct = 0.12; carbPct = 0.58; fatPct = 0.30; }

      const proteinG = Math.round((calTarget * proteinPct) / 4);
      const fatG = Math.round((calTarget * fatPct) / 9);
      const carbG = Math.round((calTarget * carbPct) / 4);

      // Distribute calories across meals
      const mealRatio = { breakfast: 0.25, lunch: 0.35, dinner: 0.30, snack: 0.10 };
      const target = (meal, calTarget) => Math.round(calTarget * mealRatio[meal]);

      // Pick meals
      const breakfastPool = filterMeal(MEAL_POOL.breakfast, condition);
      const lunchPool = filterMeal(MEAL_POOL.lunch, condition);
      const dinnerPool = filterMeal(MEAL_POOL.dinner, condition);
      const soupPool = filterMeal(MEAL_POOL.soup, condition);
      const dessertPool = filterMeal(MEAL_POOL.dessert, condition);

      const bTarget = target("breakfast", calTarget);
      const lTarget = target("lunch", calTarget);
      const dTarget = target("dinner", calTarget);

      // Pick closest match for calories
      function pickClosest(pool, targetCal, excludeSlug) {
        if (pool.length === 0) return null;
        let sorted = [...pool].sort((a, b) => Math.abs(a.cal - targetCal) - Math.abs(b.cal - targetCal));
        if (excludeSlug) sorted = sorted.filter(m => m.slug !== excludeSlug);
        return sorted[0] || sorted.length > 0 ? sorted[0] : null;
      }

      const breakfast = pickClosest(breakfastPool, bTarget);
      const lunch = pickClosest(lunchPool, lTarget);
      // For dinner, if condition, recommend a soup too
      let dinner = pickClosest(dinnerPool, dTarget);
      const soup = condition && condition !== "" && soupPool.length > 0 ? pickClosest(soupPool, 80) : null;
      const dessert = goal === "maintain" ? pickClosest(dessertPool, 150) : null;

      // Recalculate actual totals
      let actualCal = 0, actualPro = 0, actualFat = 0, actualCarb = 0;
      const meals = [];
      if (breakfast) { meals.push({ type: "breakfast", label: "🍳 Bữa sáng", meal: breakfast }); actualCal += breakfast.cal; actualPro += breakfast.pro; actualFat += breakfast.fat; actualCarb += breakfast.carb; }
      if (lunch) { meals.push({ type: "lunch", label: "🍚 Bữa trưa", meal: lunch }); actualCal += lunch.cal; actualPro += lunch.pro; actualFat += lunch.fat; actualCarb += lunch.carb; }
      if (dinner) { meals.push({ type: "dinner", label: "🍜 Bữa tối", meal: dinner }); actualCal += dinner.cal; actualPro += dinner.pro; actualFat += dinner.fat; actualCarb += dinner.carb; }
      if (soup) { meals.push({ type: "soup", label: "🥣 Canh kèm", meal: soup }); actualCal += soup.cal; actualPro += soup.pro; actualFat += soup.fat; actualCarb += soup.carb; }
      if (dessert) { meals.push({ type: "dessert", label: "🍨 Tráng miệng", meal: dessert }); actualCal += dessert.cal; actualPro += dessert.pro; actualFat += dessert.fat; actualCarb += dessert.carb; }

      return {
        meta: { calTarget, tdee, bmr, proteinG, fatG, carbG, condition },
        meals,
        actualCal, actualPro, actualFat, actualCarb,
        conditionInfo: condition && condition !== "" ? CONDITION_RULES[condition] : null
      };
    }

    // Render
    function renderPlan(plan) {
      const area = document.getElementById("result-area");
      if (!plan) return;

      const conditionBadge = plan.conditionInfo ? `<div style="margin-bottom:10px;"><span class="condition-badge">${plan.conditionInfo.advice}</span></div>` : "";

      let mealsHtml = plan.meals.map(m => {
        const tagClass = `tag-${m.type === "soup" ? "dinner" : m.type === "dessert" ? "snack" : m.type}`;
        const tagLabel = {breakfast:"Sáng", lunch:"Trưa", dinner:"Tối", soup:"Canh", dessert:"Tráng miệng"}[m.type] || m.type;
        return `<div class="meal-plan-card">
          <div class="meal-plan-header">
            <div>
              <span class="meal-type-tag ${tagClass}">${tagLabel}</span>
              <h3><a href="/mon-an/${m.meal.slug}">${m.meal.name}</a></h3>
            </div>
            <div class="cal-summary">~${m.meal.cal} kcal</div>
          </div>
          <ul class="meal-items">
            <li><span>Protein</span><span class="cal">${m.meal.pro}g</span></li>
            <li><span>Chất béo</span><span class="cal">${m.meal.fat}g</span></li>
            <li><span>Carb</span><span class="cal">${m.meal.carb}g</span></li>
          </ul>
        </div>`;
      }).join("");

      const condNote = plan.conditionInfo ? `<p style="font-size:0.85rem;color:var(--ink-secondary);margin-top:8px;"><em>${plan.conditionInfo.desc}</em></p>` : "";

      const proteinPct = plan.actualCal > 0 ? Math.round((plan.actualPro * 4 / plan.actualCal) * 100) : 0;
      const fatPct = plan.actualCal > 0 ? Math.round((plan.actualFat * 9 / plan.actualCal) * 100) : 0;
      const carbPct = plan.actualCal > 0 ? Math.round((plan.actualCarb * 4 / plan.actualCal) * 100) : 0;

      const html = `
        ${conditionBadge}
        ${mealsHtml}
        <div class="meal-plan-card">
          <h3>📊 Tổng kết dinh dưỡng</h3>
          <div class="summary-row">
            <div class="summary-item"><div class="value">${plan.actualCal}</div><div class="label">kcal</div></div>
            <div class="summary-item"><div class="value">${plan.actualPro}g</div><div class="label">Đạm</div></div>
            <div class="summary-item"><div class="value">${plan.actualFat}g</div><div class="label">Béo</div></div>
            <div class="summary-item"><div class="value">${plan.actualCarb}g</div><div class="label">Carb</div></div>
          </div>
          <div class="macro-bar-cont">
            <div class="macro-bar-protein" style="width:${proteinPct}%"></div>
            <div class="macro-bar-fat" style="width:${fatPct}%"></div>
            <div class="macro-bar-carb" style="width:${carbPct}%"></div>
          </div>
          <div class="macro-labels">
            <span><span class="dot dot-red"></span> Đạm ${proteinPct}%</span>
            <span><span class="dot dot-orange"></span> Béo ${fatPct}%</span>
            <span><span class="dot dot-blue"></span> Carb ${carbPct}%</span>
          </div>
          <div style="margin-top:10px;font-size:0.82rem;color:var(--ink-secondary);">
            BMR: ${plan.meta.bmr} kcal | TDEE: ${plan.meta.tdee} kcal | Mục tiêu: ${plan.meta.calTarget} kcal/ngày
          </div>
          ${condNote}
          <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
            <a href="/cong-cu/muc-tieu-dinh-duong" class="button secondary compact">🎯 Mục tiêu</a>
            <a href="/cong-cu/nhat-ky" class="button secondary compact">📓 Nhật ký</a>
            <button onclick="location.reload()" class="button secondary compact">🔄 Tạo lại</button>
          </div>
        </div>
      `;

      area.innerHTML = html;
    }

    // Main handler
    document.getElementById("profile-form").addEventListener("submit", function(e) {
      e.preventDefault();
      const data = {
        age: parseInt(document.getElementById("age").value),
        sex: document.getElementById("sex").value,
        weight: parseFloat(document.getElementById("weight").value),
        height: parseFloat(document.getElementById("height").value),
        activity: document.getElementById("activity").value,
        goal: document.getElementById("goal").value,
        condition: document.getElementById("condition").value,
      };
      const plan = generatePlan(data);
      renderPlan(plan);
    });

    // Auto-generate on load with default values
    window.addEventListener("DOMContentLoaded", function() {
      // Parse URL params (from Khẩu Phần Việt Clinical link)
      var p = new URLSearchParams(window.location.search);
      var initData = {
        age: parseInt(document.getElementById("age").value),
        sex: document.getElementById("sex").value,
        weight: parseFloat(document.getElementById("weight").value),
        height: parseFloat(document.getElementById("height").value),
        activity: document.getElementById("activity").value,
        goal: document.getElementById("goal").value,
        condition: document.getElementById("condition").value,
      };
      if (p.get('w')) { initData.weight = parseFloat(p.get('w')); document.getElementById('weight').value = initData.weight; }
      if (p.get('age')) { initData.age = parseInt(p.get('age')); document.getElementById('age').value = initData.age; }
      if (p.get('sex')) { initData.sex = p.get('sex'); document.getElementById('sex').value = initData.sex; }
      if (p.get('act')) { initData.activity = p.get('act'); document.getElementById('activity').value = initData.activity; }
      if (p.get('dis')) {
        var disMap = { tieuDuong:'diabetes', tangHuyetAp:'hypertension', gout:'gout', thanMan:'ckd', ganNhiemMo:'dyslipidemia' };
        var dis = p.get('dis').split(',')[0];
        var mapped = disMap[dis];
        if (mapped) { initData.condition = mapped; document.getElementById('condition').value = mapped; }
      }
      const plan = generatePlan(initData);
      renderPlan(plan);
    });
  </script>
</BaseLayout>
