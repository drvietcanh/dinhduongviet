---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";
const siteTitle = "Kế hoạch bữa ăn tham khảo | Dinh dưỡng Việt";
const siteDesc = "Gợi ý bữa ăn Việt từ thư viện món ăn và thành phần dinh dưỡng tham khảo; không đặt mục tiêu điều trị cá nhân.";
const domain = "dinhduongviet.vn";
const mealPlanRecipes = recipes.map((recipe) => {
  const nutrients = calculateRecipe(recipe);
  return {
    slug: recipe.slug,
    name: recipe.name,
    tags: recipe.tags ?? [],
    mealContexts: recipe.mealContexts ?? [],
    servingName: recipe.servingName,
    confidence: recipe.confidence,
    kcal: Math.round(nutrients.energyKcal),
    protein: Math.round(nutrients.proteinG * 10) / 10,
    fat: Math.round(nutrients.fatG * 10) / 10,
    carb: Math.round(nutrients.carbG * 10) / 10,
  };
});
---
<BaseLayout title={siteTitle} description={siteDesc} canonical={"https://" + domain + "/cong-cu/ke-hoach-bua-an"}>
  <style is:global>
    .hero { text-align: center; margin-bottom: 20px; }
    .hero h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .hero .sub { color: var(--ink-secondary); font-size: 0.95rem; }
    .mealplanner-layout { display: grid; grid-template-columns: 340px 1fr; gap: 20px; }
    @media (max-width: 768px) { .mealplanner-layout { grid-template-columns: 1fr; } }
    .sidebar-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 18px; box-shadow: var(--shadow-sm); }
    .sidebar-card h2 { font-size: 1rem; margin-bottom: 12px; }
    .form-group { margin-bottom: 10px; }
    .form-group label { display: block; font-size: 0.82rem; font-weight: 600; color: var(--ink-secondary); margin-bottom: 3px; }
    .form-help { display: block; margin-top: 5px; color: var(--ink-secondary); font-size: 0.78rem; line-height: 1.5; }
    .form-group select, .form-group input { width: 100%; min-height: 40px; border: 1px solid var(--card-border); border-radius: var(--radius); padding: 0 10px; font-size: 0.88rem; background: var(--bg-elevated); color: var(--ink); transition: border-color var(--transition), box-shadow var(--transition); }
    .form-group select:focus, .form-group input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .gen-btn { display: block; width: 100%; padding: 11px; font-size: 1rem; font-weight: 600; background: var(--brand); color: white; border: none; border-radius: var(--radius); cursor: pointer; margin-top: 12px; transition: background var(--transition), transform var(--transition); }
    .gen-btn:hover { background: var(--brand-dark); transform: translateY(-1px); }
    .gen-btn:active { transform: translateY(0); }
    .result-area { min-height: 300px; }
    .meal-plan-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 18px; margin-bottom: 14px; box-shadow: var(--shadow-sm); }
    .meal-plan-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px; }
    .meal-plan-header h3 { margin: 0; font-size: 1.05rem; }
    .meal-plan-header .cal-summary { font-size: 0.85rem; color: var(--ink-secondary); }
    .meal-type-tag { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
    .tag-breakfast { background: #fff3e0; color: #e65100; }
    .tag-lunch { background: #e8f5e9; color: #2e7d32; }
    .tag-dinner { background: #e3f2fd; color: #1565c0; }
    .tag-snack { background: #f3e5f5; color: #7b1fa2; }
    [data-theme="dark"] .tag-breakfast { background: #3e2a1a; color: #ffb74d; }
    [data-theme="dark"] .tag-lunch { background: #1b3a1b; color: #81c784; }
    [data-theme="dark"] .tag-dinner { background: #1a2a3e; color: #64b5f6; }
    [data-theme="dark"] .tag-snack { background: #2a1a3e; color: #ce93d8; }
    .meal-items { list-style: none; padding: 0; margin: 0; }
    .meal-items li { padding: 6px 0; border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; }
    .meal-items li:last-child { border-bottom: none; }
    .meal-items li a { color: var(--brand); text-decoration: none; flex: 1; transition: color var(--transition); }
    .meal-items li a:hover { text-decoration: underline; color: var(--brand-dark); }
    .meal-items li .amount { color: var(--ink-secondary); font-size: 0.82rem; margin-left: 8px; white-space: nowrap; }
    .meal-items li .cal { font-weight: 600; font-size: 0.85rem; white-space: nowrap; min-width: 50px; text-align: right; }
    .summary-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 8px; margin-top: 14px; }
    .summary-item { text-align: center; padding: 10px; background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: var(--radius); }
    .summary-item .value { font-size: 1.2rem; font-weight: 700; color: var(--brand); }
    .summary-item .label { font-size: 0.75rem; color: var(--ink-secondary); }
    .macro-bar-cont { height: 8px; background: var(--line); border-radius: 4px; margin: 12px 0; overflow: hidden; display: flex; }
    .macro-bar-cont div { height: 100%; }
    .macro-bar-protein { background: #e53935; }
    .macro-bar-fat { background: #ff9800; }
    .macro-bar-carb { background: #2196f3; }
    .macro-labels { display: flex; justify-content: space-around; font-size: 0.78rem; }
    .macro-labels span { display: flex; align-items: center; gap: 4px; }
    .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
    .dot-red { background: #e53935; }
    .dot-orange { background: #ff9800; }
    .dot-blue { background: #2196f3; }
    .placeholder-text { text-align: center; padding: 60px 20px; color: var(--ink-secondary); }
    .placeholder-text .big-icon { font-size: 3rem; margin-bottom: 10px; }
    .meal-customize { margin-top: 10px; }
    .meal-customize select { width: auto; min-height: 32px; font-size: 0.82rem; padding: 0 8px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--bg-elevated); color: var(--ink); transition: border-color var(--transition); }
    .meal-customize select:focus { outline: none; border-color: var(--brand); }
    .meal-customize button { padding: 4px 10px; font-size: 0.82rem; border: 1px solid var(--brand); color: var(--brand); background: transparent; border-radius: var(--radius); cursor: pointer; transition: all var(--transition); }
    .meal-customize button:hover { background: var(--brand); color: white; }
    .condition-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; background: #fff3cd; color: #856404; margin-right: 4px; }
    [data-theme="dark"] .condition-badge { background: #3a3200; color: #ffd54f; }
  </style>

  <div class="hero">
    <h1>🥗 Kế hoạch bữa ăn tham khảo</h1>
    <p class="sub">Trang này chỉ gợi ý khung bữa ăn ở mức tham khảo. Không dùng để tự kết luận thực đơn riêng cho bệnh nền hoặc tự thay đổi điều trị.</p>
  </div>

  <div class="mealplanner-layout">
    <!-- Sidebar: Profile Form -->
    <aside class="sidebar-card">
      <h2>📋 Tùy chọn gợi ý</h2>
      <form id="profile-form">
        <div class="form-group">
          <label>Ưu tiên món ăn</label>
          <select id="preference">
            <option value="varied" selected>Đa dạng món Việt</option>
            <option value="vegetarian">Ưu tiên món chay</option>
          </select>
        </div>
        <div class="form-group">
          <label>Bối cảnh sức khỏe cần lưu ý</label>
          <select id="condition">
            <option value="">Không có / chưa rõ</option>
            <option value="diabetes">Đái tháo đường</option>
            <option value="hypertension">Tăng huyết áp</option>
            <option value="dyslipidemia">Rối loạn mỡ máu</option>
            <option value="gout">Gout</option>
            <option value="ckd">Bệnh thận mạn</option>
          </select>
          <small class="form-help">Lựa chọn này chỉ hiện lời nhắc an toàn, không cá thể hóa món ăn theo bệnh.</small>
        </div>
        <button class="gen-btn" type="submit">🎲 Gợi ý bữa ăn</button>
      </form>
    </aside>

    <!-- Main: Meal Plan -->
    <div class="result-area" id="result-area">
      <div class="placeholder-text" id="placeholder">
        <div class="big-icon">🍳</div>
        <p>Chọn ưu tiên món ăn bên cạnh để xem gợi ý cho ba bữa chính.</p>
        <p style="font-size:0.85rem;">Nếu có bệnh nền, đang dùng thuốc, đang mang thai, là trẻ em hoặc người cao tuổi, hãy xem kết quả như thông tin tham khảo và hỏi bác sĩ hoặc chuyên gia trước khi đổi chế độ ăn.</p>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ mealPlanRecipes }}>
    const CONDITION_NOTES = {
      diabetes: {
        title: "Có đái tháo đường hoặc rối loạn đường huyết",
        advice: "Hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi đổi khẩu phần, lượng carb, giờ ăn hoặc thuốc."
      },
      hypertension: {
        title: "Có tăng huyết áp",
        advice: "Cần hỏi bác sĩ hoặc chuyên gia nếu bạn đang theo dõi muối, cân nặng, huyết áp hoặc thuốc liên quan."
      },
      dyslipidemia: {
        title: "Có rối loạn mỡ máu",
        advice: "Không nên xem trang này như kế hoạch điều trị cá nhân; hãy hỏi chuyên gia nếu cần điều chỉnh khẩu phần lâu dài."
      },
      gout: {
        title: "Có gout hoặc tăng acid uric",
        advice: "Cần hỏi chuyên gia trước khi thay đổi chế độ ăn, lượng đạm hoặc rượu bia khi đang theo dõi gout."
      },
      ckd: {
        title: "Có bệnh thận mạn",
        advice: "Không dùng kết quả này để tự đặt mục tiêu đạm, natri, kali, phospho hoặc nước; hãy hỏi bác sĩ hoặc chuyên gia."
      },
      vegetarian: {
        title: "Ăn chay hoặc hạn chế thịt cá",
        advice: "Danh sách ưu tiên các món được gắn nhãn chay trong thư viện; hãy kiểm tra nguyên liệu, nước dùng và gia vị thực tế."
      }
    };

    function classifyMeal(recipe) {
      const name = `${recipe.name} ${(recipe.tags || []).join(" ")}`.toLocaleLowerCase("vi");
      if (["chè", "sinh tố", "tráng miệng", "trái cây", "sữa chua", "yaourt"].some((term) => name.includes(term))) return "snack";
      if (["phở", "bún", "cháo", "bánh mì", "xôi", "bánh cuốn", "bánh ướt", "bánh bao", "hủ tiếu"].some((term) => name.includes(term))) return "breakfast";
      if ((recipe.mealContexts || []).includes("dinner-heavy") || (recipe.mealContexts || []).includes("communal")) return "lunch";
      if ((recipe.mealContexts || []).includes("dinner-light") || ["canh", "súp", "lẩu"].some((term) => name.includes(term))) return "dinner";
      return "lunch";
    }

    function filterMeal(pool, preference) {
      if (preference !== "vegetarian") return pool;
      return pool.filter((recipe) => (recipe.tags || []).some((tag) => tag === "vegan" || tag === "vegetarian"));
    }

    const mealTypes = [
      { type: "breakfast", label: "🍳 Bữa sáng" },
      { type: "lunch", label: "🍚 Bữa trưa" },
      { type: "dinner", label: "🍜 Bữa tối" },
    ];

    function pickMeal(pool, usedSlugs) {
      const available = pool.filter((recipe) => !usedSlugs.has(recipe.slug));
      if (!available.length) return null;
      return available[Math.floor(Math.random() * available.length)];
    }

    function generatePlan(data) {
      const { preference, condition } = data;
      const usedSlugs = new Set();
      const vegetarianPool = mealPlanRecipes.filter((recipe) =>
        (recipe.tags || []).some((tag) => tag === "vegan" || tag === "vegetarian"),
      );
      const meals = mealTypes.flatMap(({ type, label }) => {
        let pool = filterMeal(mealPlanRecipes.filter((recipe) => classifyMeal(recipe) === type), preference);
        if (preference === "vegetarian" && pool.length === 0) pool = vegetarianPool;
        const meal = pickMeal(pool, usedSlugs);
        if (!meal) return [];
        usedSlugs.add(meal.slug);
        return [{ type, label, meal }];
      });

      return {
        meals,
        actualCal: meals.reduce((sum, item) => sum + item.meal.kcal, 0),
        actualPro: Math.round(meals.reduce((sum, item) => sum + item.meal.protein, 0) * 10) / 10,
        actualFat: Math.round(meals.reduce((sum, item) => sum + item.meal.fat, 0) * 10) / 10,
        actualCarb: Math.round(meals.reduce((sum, item) => sum + item.meal.carb, 0) * 10) / 10,
        conditionInfo: condition
          ? CONDITION_NOTES[condition] || null
          : preference === "vegetarian" ? CONDITION_NOTES.vegetarian : null,
      };
    }

    function renderPlan(plan) {
      const area = document.getElementById("result-area");
      if (!plan || !area) return;
      const proteinPct = plan.actualCal > 0 ? Math.round((plan.actualPro * 4 / plan.actualCal) * 100) : 0;
      const fatPct = plan.actualCal > 0 ? Math.round((plan.actualFat * 9 / plan.actualCal) * 100) : 0;
      const carbPct = plan.actualCal > 0 ? Math.round((plan.actualCarb * 4 / plan.actualCal) * 100) : 0;
      const mealTagLabels = { breakfast: "Sáng", lunch: "Trưa", dinner: "Tối" };
      const frag = document.createDocumentFragment();

      function make(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
      }

      if (!plan.meals.length) {
        const empty = make("div", "meal-plan-card", "Chưa có đủ món trong thư viện phù hợp với lựa chọn này. Hãy thử chế độ món đa dạng.");
        empty.setAttribute("role", "status");
        area.replaceChildren(empty);
        return;
      }

      if (plan.conditionInfo) {
        const noteCard = make("div", "meal-plan-card");
        const noteTitle = make("h3", "", "Khi nào cần hỏi chuyên môn?");
        const noteBadgeWrap = make("div", "");
        noteBadgeWrap.style.marginBottom = "10px";
        const noteBadge = make("span", "condition-badge", plan.conditionInfo.title);
        noteBadgeWrap.appendChild(noteBadge);
        const noteText = make("p", "");
        noteText.style.fontSize = "0.85rem";
        noteText.style.color = "var(--ink-secondary)";
        noteText.style.margin = "0";
        noteText.textContent = plan.conditionInfo.advice;
        noteCard.appendChild(noteTitle);
        noteCard.appendChild(noteBadgeWrap);
        noteCard.appendChild(noteText);
        frag.appendChild(noteCard);
      }

      plan.meals.forEach((m) => {
        const card = make("div", "meal-plan-card");
        const header = make("div", "meal-plan-header");
        const left = make("div", "");
        const tagClass = `tag-${m.type === "soup" ? "dinner" : m.type === "dessert" ? "snack" : m.type}`;
        const badge = make("span", `meal-type-tag ${tagClass}`, mealTagLabels[m.type] || m.type);
        const title = make("h3", "");
        const link = make("a", "", m.meal.name);
        link.href = `/mon-an/${m.meal.slug}`;
        title.appendChild(link);
        left.appendChild(badge);
        left.appendChild(title);
        const sourceQuality = m.meal.confidence === "high" ? "giá trị tham khảo" : "công thức ước tính";
        const cal = make("div", "cal-summary", `~${m.meal.kcal} kcal · ${sourceQuality}`);
        header.appendChild(left);
        header.appendChild(cal);
        card.appendChild(header);

        const list = make("ul", "meal-items");
        [
          ["Đạm", `${m.meal.protein} g`],
          ["Chất béo", `${m.meal.fat} g`],
          ["Carbohydrate", `${m.meal.carb} g`],
        ].forEach(([label, value]) => {
          const li = make("li", "");
          li.appendChild(make("span", "", label));
          li.appendChild(make("span", "cal", value));
          list.appendChild(li);
        });
        card.appendChild(list);
        frag.appendChild(card);
      });

      const summaryCard = make("div", "meal-plan-card");
      summaryCard.appendChild(make("h3", "", "📊 Tổng kết tham khảo"));
      summaryCard.appendChild(make("p", "", "Tỷ lệ năng lượng ước tính từ các món được gợi ý (không phải mục tiêu cá nhân):"));
      const disclaimer = make("p", "");
      disclaimer.style.fontSize = "0.85rem";
      disclaimer.style.color = "var(--ink-secondary)";
      disclaimer.style.marginTop = "0";
      disclaimer.textContent = "Đây là tổng giá trị của các khẩu phần mẫu được chọn từ thư viện món ăn; lượng ăn, nguyên liệu và cách nấu thực tế có thể khác. Không phải mục tiêu kcal hoặc macro cá nhân.";
      summaryCard.appendChild(disclaimer);

      const summaryRow = make("div", "summary-row");
      [
        [String(plan.actualCal), "kcal tham khảo"],
        [`${plan.actualPro}g`, "Đạm"],
        [`${plan.actualFat}g`, "Béo"],
        [`${plan.actualCarb}g`, "Carb"],
      ].forEach(([value, label]) => {
        const item = make("div", "summary-item");
        item.appendChild(make("div", "value", value));
        item.appendChild(make("div", "label", label));
        summaryRow.appendChild(item);
      });
      summaryCard.appendChild(summaryRow);

      const bar = make("div", "macro-bar-cont");
      const barProtein = make("div", "macro-bar-protein");
      barProtein.style.width = `${proteinPct}%`;
      const barFat = make("div", "macro-bar-fat");
      barFat.style.width = `${fatPct}%`;
      const barCarb = make("div", "macro-bar-carb");
      barCarb.style.width = `${carbPct}%`;
      bar.appendChild(barProtein);
      bar.appendChild(barFat);
      bar.appendChild(barCarb);
      summaryCard.appendChild(bar);

      const labels = make("div", "macro-labels");
      [
        ["dot-red", `Đạm ${proteinPct}%`],
        ["dot-orange", `Béo ${fatPct}%`],
        ["dot-blue", `Carb ${carbPct}%`],
      ].forEach(([dotClass, text]) => {
        const span = make("span", "");
        span.appendChild(make("span", `dot ${dotClass}`));
        span.appendChild(document.createTextNode(` ${text}`));
        labels.appendChild(span);
      });
      summaryCard.appendChild(labels);

      const est = make("div", "");
      est.style.marginTop = "10px";
      est.style.fontSize = "0.82rem";
      est.style.color = "var(--ink-secondary)";
      est.textContent = "Bạn có thể tạo lại để xem các gợi ý món khác; hãy kiểm tra dị ứng, khẩu phần và cách chế biến trước khi áp dụng.";
      summaryCard.appendChild(est);

      const safetyTitle = make("h3", "");
      safetyTitle.style.marginTop = "14px";
      safetyTitle.textContent = "Khi nào cần hỏi chuyên môn?";
      summaryCard.appendChild(safetyTitle);

      const safety = make("div", "");
      safety.style.marginTop = "6px";
      safety.style.fontSize = "0.82rem";
      safety.style.color = "var(--ink-secondary)";
      safety.textContent = "Nếu bạn có bệnh nền, đang dùng insulin, thuốc hạ đường huyết, thuốc huyết áp, lợi tiểu hoặc thuốc khác, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi đổi bữa ăn, khẩu phần hoặc giờ ăn.";
      summaryCard.appendChild(safety);

      const actions = make("div", "");
      actions.style.marginTop = "12px";
      actions.style.display = "flex";
      actions.style.gap = "8px";
      actions.style.flexWrap = "wrap";
      const goalLink = make("a", "button secondary compact", "🎯 Mục tiêu dinh dưỡng");
      goalLink.href = "/cong-cu/muc-tieu-dinh-duong";
      const diaryLink = make("a", "button secondary compact", "📊 Theo dõi sức khỏe");
      diaryLink.href = "/cong-cu/theo-doi-suc-khoe";
      const reloadBtn = make("button", "button secondary compact", "🔄 Tạo lại");
      reloadBtn.type = "button";
      reloadBtn.addEventListener("click", () => location.reload());
      actions.appendChild(goalLink);
      actions.appendChild(diaryLink);
      actions.appendChild(reloadBtn);
      summaryCard.appendChild(actions);
      frag.appendChild(summaryCard);

      area.replaceChildren(frag);
    }

    // Main handler
    document.getElementById("profile-form").addEventListener("submit", function(e) {
      e.preventDefault();
      const data = {
        preference: document.getElementById("preference").value,
        condition: document.getElementById("condition").value,
      };
      const plan = generatePlan(data);
      renderPlan(plan);
    });

    // Auto-generate on load with default values
    window.addEventListener("DOMContentLoaded", function() {
      // Parse URL params (from Khẩu Phần Việt Clinical link)
      var p = new URLSearchParams(window.location.search);
      var initData = {
        preference: document.getElementById("preference").value,
        condition: document.getElementById("condition").value,
      };
      if (p.get('dis')) {
        var disMap = { tieuDuong:'diabetes', tangHuyetAp:'hypertension', gout:'gout', thanMan:'ckd', ganNhiemMo:'dyslipidemia' };
        var dis = p.get('dis').split(',')[0];
        var mapped = disMap[dis];
        if (mapped) { initData.condition = mapped; document.getElementById('condition').value = mapped; }
      }
      const plan = generatePlan(initData);
      renderPlan(plan);
    });
  </script>
</BaseLayout>
