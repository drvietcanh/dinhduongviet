        { name: "Mì gõ trứng", slug: "mi-goi-trung", cal: 380, pro: 14, fat: 16, carb: 48, tags: ["vietnamese"] },
        { name: "Cơm tấm sườn", slug: "com-tam-suon", cal: 520, pro: 24, fat: 16, carb: 68, tags: ["vietnamese"] },
        { name: "Miến lòng", slug: "mien-lon", cal: 340, pro: 16, fat: 10, carb: 48, tags: ["vietnamese"] },
      ],
      lunch: [
        { name: "Cơm gà", slug: "com-ga-uc-ga", cal: 500, pro: 28, fat: 14, carb: 64, tags: ["vietnamese"] },
        { name: "Cơm sườn", slug: "com-tam-suon", cal: 520, pro: 24, fat: 16, carb: 68, tags: ["vietnamese"] },
        { name: "Phở bò", slug: "pho-bo", cal: 450, pro: 22, fat: 12, carb: 62, tags: ["vietnamese"] },
        { name: "Bún chả", slug: "bun-cha", cal: 480, pro: 20, fat: 14, carb: 64, tags: ["vietnamese"] },
        { name: "Bún thịt nướng", slug: "bun-thit-nuong", cal: 480, pro: 18, fat: 14, carb: 68, tags: ["vietnamese"] },
        { name: "Bánh tráng trộn", slug: "banh-trang-tron", cal: 320, pro: 8, fat: 14, carb: 42, tags: ["vietnamese"] },
        { name: "Cơm rang dưa bò", slug: "com-rang-bo", cal: 460, pro: 20, fat: 16, carb: 58, tags: ["vietnamese"] },
        { name: "Bún bò Huế", slug: "bun-bo-hue", cal: 460, pro: 22, fat: 12, carb: 64, tags: ["vietnamese"] },
        { name: "Mì Quảng", slug: "mi-quang", cal: 440, pro: 18, fat: 14, carb: 58, tags: ["vietnamese"] },
        { name: "Cơm gạo lứt thịt luộc", slug: "com-gao-lut-luoc", cal: 400, pro: 22, fat: 10, carb: 56, tags: ["healthy"] },
        { name: "Bún mọc", slug: "bun-moc", cal: 360, pro: 16, fat: 8, carb: 56, tags: ["vietnamese"] },
        { name: "Bánh đa cua", slug: "banh-da-cua", cal: 420, pro: 20, fat: 12, carb: 56, tags: ["vietnamese"] },
        { name: "Cơm cà ri gà", slug: "com-ca-ri-ga", cal: 540, pro: 26, fat: 18, carb: 64, tags: ["vietnamese"] },
        { name: "Bánh mì thịt", slug: "banh-mi-thit", cal: 350, pro: 16, fat: 12, carb: 46, tags: ["vietnamese"] },
        { name: "Cơm mực xào", slug: "muc-xao", cal: 420, pro: 24, fat: 14, carb: 48, tags: ["seafood"] },
      ],
      dinner: [
        { name: "Cơm trắng + Thịt kho trứng", slug: "thit-kho-trung", cal: 550, pro: 26, fat: 18, carb: 66, tags: ["vietnamese"] },
        { name: "Cơm trắng + Cá kho tộ", slug: "ca-kho-to", cal: 480, pro: 28, fat: 14, carb: 58, tags: ["vietnamese"] },
        { name: "Cơm trắng + Bò xào cần", slug: "thit-bo-xao-can", cal: 460, pro: 26, fat: 14, carb: 54, tags: ["vietnamese"] },
        { name: "Cơm trắng + Sườn kho", slug: "suon-kho", cal: 520, pro: 24, fat: 18, carb: 60, tags: ["vietnamese"] },
        { name: "Cơm trắng + Cá chép kho tương", slug: "ca-chep-kho-tuong", cal: 460, pro: 26, fat: 12, carb: 58, tags: ["vietnamese"] },
        { name: "Cơm trắng + Bò nướng lá lốt", slug: "thit-bo-nuong-la-lot", cal: 480, pro: 28, fat: 16, carb: 52, tags: ["vietnamese"] },
        { name: "Cơm trắng + Gà nướng mật ong", slug: "ga-nuong-mat-ong", cal: 520, pro: 30, fat: 16, carb: 56, tags: ["vietnamese"] },
        { name: "Cơm trắng + Tôm hấp sả", slug: "tom-hap-sa", cal: 400, pro: 26, fat: 8, carb: 54, tags: ["seafood"] },
