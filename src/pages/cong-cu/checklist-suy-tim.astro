---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng suy tim";
const desc = "Bảng kiểm chuẩn bị và theo dõi ăn uống cho người suy tim hoặc sau nhồi máu cơ tim.";
const items = [
  "Tôi biết rõ bác sĩ dặn giới hạn muối và lượng nước mỗi ngày (nếu có)",
  "Tôi đọc nhãn natri và hạn chế thực phẩm chế biến sẵn, đồ muối/cà muối",
  "Tôi có cân và ghi cân nặng vào cùng một thời điểm mỗi ngày",
  "Tôi dùng thuốc đúng giờ và không tự dùng muối thay thế hoặc thuốc bổ sung",
  "Bữa ăn có rau, đạm phù hợp và chất béo lành mạnh theo khả năng dung nạp",
  "Tôi biết nơi liên hệ khi khó thở tăng, phù, đau ngực hoặc tăng cân nhanh",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-suy-tim">
  <main class="heart-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tim mạch</p>
      <h1>❤️ Checklist dinh dưỡng suy tim</h1>
      <p>{desc} Mục tiêu muối, nước và kali phải theo bệnh cảnh, thuốc và chỉ định riêng.</p>
    </header>
    <form id="heart-form" class="card">
      <p class="hint">Đánh dấu những điều đã được chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-heart /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần liên hệ khẩn cấp</h2>
      <p>Đau ngực mới hoặc tăng, khó thở khi nghỉ, ngất, tím tái, lú lẫn hoặc phù tăng nhanh. Không chờ checklist hoàn tất trong tình huống cấp cứu.</p>
      <p class="warning">Không tự ngừng lợi tiểu, thuốc huyết áp, statin hoặc thuốc chống đông; không tự uống thêm nước để “bù”.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("heart-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-heart]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, triệu chứng và mang theo danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục nên làm rõ</h2><p>Hãy hỏi bác sĩ tim mạch hoặc chuyên gia dinh dưỡng; không tự suy ra mức muối/nước từ checklist.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .heart-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .heart-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
