---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng táo bón";
const desc = "Bảng kiểm thói quen ăn uống và sinh hoạt hỗ trợ cải thiện táo bón.";
const items = [
  "Tôi tăng chất xơ từ từ qua rau, quả, đậu và ngũ cốc nguyên hạt",
  "Tôi uống đủ theo nhu cầu và bệnh nền, không cố uống nhiều khi bị hạn chế nước",
  "Tôi vận động và đi lại phù hợp mỗi ngày",
  "Tôi dành thời gian đi tiêu sau bữa, không nhịn và không rặn kéo dài",
  "Tôi rà soát thuốc gây táo bón (sắt, opioid, một số thuốc khác) với bác sĩ/dược sĩ",
  "Tôi theo dõi đau bụng, nôn, chướng bụng, máu trong phân và thay đổi đột ngột",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-tao-bon">
  <main class="constipation-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🚽 Checklist táo bón</h1>
      <p>{desc} Mức chất xơ và nước cần điều chỉnh nếu có bệnh thận, suy tim, hẹp ruột hoặc đợt viêm ruột.</p>
    </header>
    <form id="constipation-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-constipation /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Đau bụng tăng, nôn, bụng chướng, không trung tiện, máu trong phân, sụt cân hoặc táo bón mới xuất hiện kéo dài.</p>
      <p class="warning">Không tự dùng thuốc xổ kích thích kéo dài, thụt tháo hoặc tăng chất xơ khi nghi tắc ruột.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("constipation-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-constipation]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi số lần đi tiêu, dạng phân và thuốc đang dùng để trao đổi khi cần.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ và hỏi bác sĩ/dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .constipation-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .constipation-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
