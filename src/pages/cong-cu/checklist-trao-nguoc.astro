---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng trào ngược dạ dày";
const desc = "Bảng kiểm thói quen ăn uống và sinh hoạt giúp nhận diện yếu tố làm nặng trào ngược.";
const items = [
  "Tôi ăn khẩu phần vừa phải và tránh nằm ngay sau bữa",
  "Tôi ghi lại món/đồ uống làm tăng ợ nóng thay vì kiêng mọi thực phẩm",
  "Tôi hạn chế bữa rất nhiều mỡ, rượu bia và đồ uống có gas nếu chúng gây triệu chứng",
  "Tôi tránh ăn quá sát giờ ngủ và đã hỏi về kê cao đầu giường khi cần",
  "Tôi duy trì cân nặng phù hợp và tránh hút thuốc",
  "Tôi dùng thuốc đúng hướng dẫn và biết dấu hiệu báo động cần nội soi/khám",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-trao-nguoc">
  <main class="gerd-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🔥 Checklist trào ngược dạ dày</h1>
      <p>{desc} Tác nhân khác nhau giữa từng người; bảng kiểm không thay thế chẩn đoán GERD.</p>
    </header>
    <form id="gerd-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-gerd /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần khám sớm</h2>
      <p>Nuốt nghẹn/nuốt đau, sụt cân không chủ ý, nôn dai dẳng, nôn máu, phân đen, thiếu máu hoặc đau ngực chưa rõ nguyên nhân.</p>
      <p class="warning">Không tự tăng thuốc giảm acid kéo dài hoặc dùng mẹo dân gian thay cho khám khi có dấu hiệu báo động.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("gerd-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-gerd]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi nhật ký triệu chứng và thuốc để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ và hỏi bác sĩ tiêu hóa về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .gerd-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .gerd-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
