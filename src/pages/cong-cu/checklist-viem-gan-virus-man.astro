---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist viêm gan virus mạn";
const desc = "Bảng kiểm dinh dưỡng, thuốc và theo dõi an toàn ở người bệnh viêm gan B/C mạn.";
const items = [
  "Tôi biết lịch xét nghiệm tải lượng virus, men gan, siêu âm và khám chuyên khoa của mình",
  "Tôi dùng thuốc kháng virus đúng đơn, không tự ngừng hoặc dùng thuốc/thảo dược không rõ nguồn",
  "Tôi tránh hoàn toàn rượu bia và báo bác sĩ mọi thuốc giảm đau, thực phẩm bổ sung đang dùng",
  "Tôi ăn đủ năng lượng–đạm, rau quả an toàn và duy trì cân nặng phù hợp, không nhịn ăn giải độc",
  "Tôi kiểm tra viêm gan A, tiêm phòng phù hợp và không dùng chung kim tiêm/đồ cá nhân dính máu",
  "Tôi biết dấu hiệu vàng da tăng, bụng to, phù, nôn máu, phân đen, lú lẫn hoặc đau bụng cần khám ngay",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-viem-gan-virus-man">
  <main class="viral-hepatitis-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm gan mật</p>
      <h1>🧫 Checklist viêm gan virus mạn</h1>
      <p>{desc} Dinh dưỡng hỗ trợ sức khỏe chung, không thay thế thuốc kháng virus và theo dõi chuyên khoa.</p>
    </header>
    <form id="viral-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-viral /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám ngay khi</h2>
      <p>Vàng da tăng nhanh, bụng to/phù mới xuất hiện, nôn máu, phân đen, lú lẫn, sốt hoặc đau bụng dữ dội.</p>
      <p class="warning">Không tự ngừng thuốc kháng virus, tự dùng “thuốc bổ gan” hoặc trì hoãn siêu âm/xét nghiệm theo lịch.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("viral-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-viral]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang kết quả xét nghiệm, danh sách thuốc và câu hỏi khi tái khám gan mật.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ gan mật hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .viral-hepatitis-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .viral-hepatitis-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
