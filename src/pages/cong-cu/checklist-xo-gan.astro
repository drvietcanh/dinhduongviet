---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng xơ gan và cổ trướng";
const desc = "Bảng kiểm ăn uống và theo dõi an toàn cho người xơ gan, cổ trướng hoặc bệnh gan tiến triển.";
const items = [
  "Tôi đã hỏi rõ mức muối và lượng nước phù hợp với cổ trướng, phù và xét nghiệm",
  "Tôi tránh hoàn toàn rượu bia và hỏi trước khi dùng thuốc/thực phẩm bổ sung",
  "Tôi chia nhỏ bữa, có bữa phụ phù hợp và không nhịn đói kéo dài",
  "Tôi có nguồn đạm an toàn theo hướng dẫn, không tự kiêng đạm khi chưa được dặn",
  "Tôi tránh thực phẩm sống/tái và biết cách bảo quản thực phẩm an toàn",
  "Tôi theo dõi vòng bụng, cân nặng, phù, vàng da và thay đổi ý thức",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-xo-gan">
  <main class="liver-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm gan mật</p>
      <h1>🧬 Checklist xơ gan và cổ trướng</h1>
      <p>{desc} Mục tiêu đạm, muối, nước và năng lượng phải cá thể hóa theo giai đoạn bệnh.</p>
    </header>
    <form id="liver-form" class="card">
      <p class="hint">Đánh dấu những điều đã được chuẩn bị hoặc theo dõi:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-liver /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần liên hệ ngay</h2>
      <p>Lú lẫn hoặc buồn ngủ bất thường, nôn ra máu, đi ngoài phân đen, sốt, đau bụng, bụng to nhanh, khó thở, vàng da tăng hoặc tiểu rất ít.</p>
      <p class="warning">Không tự dùng thuốc lợi tiểu, thuốc an thần, thuốc giảm đau, chất bổ gan hoặc tự giảm đạm/nước.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("liver-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-liver]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, vòng bụng, lượng ăn và triệu chứng để mang khi tái khám.</p>`
        : `<h2>Còn ${missing} mục nên làm rõ</h2><p>Hãy hỏi bác sĩ gan mật hoặc chuyên gia dinh dưỡng; không tự suy ra chế độ ăn từ checklist.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .liver-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .liver-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
