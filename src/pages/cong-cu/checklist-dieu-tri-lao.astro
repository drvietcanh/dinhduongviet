---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi điều trị lao";
const desc = "Bảng kiểm ăn uống, thuốc và theo dõi an toàn trong điều trị bệnh lao.";
const items = [
  "Tôi dùng thuốc lao đúng giờ, đúng liều và biết thuốc nào cần uống lúc đói theo hướng dẫn",
  "Tôi báo bác sĩ mọi thuốc khác, thuốc tránh thai, thảo dược, vitamin và thực phẩm bổ sung",
  "Tôi ăn đủ năng lượng–đạm, chia bữa khi chán ăn và theo dõi cân nặng mỗi tuần",
  "Tôi tránh rượu bia, không tự dùng paracetamol liều cao và hỏi về vitamin B6 khi được chỉ định",
  "Tôi giữ vệ sinh, thông khí, đeo khẩu trang theo hướng dẫn và không tự ngừng thuốc khi thấy đỡ",
  "Tôi biết dấu hiệu độc tính: vàng da, nôn nhiều, nhìn mờ, tê bì, phát ban nặng hoặc khó thở",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-dieu-tri-lao">
  <main class="tb-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm truyền nhiễm</p>
      <h1>🫁 Checklist dinh dưỡng khi điều trị lao</h1>
      <p>{desc} Dinh dưỡng hỗ trợ phục hồi, không thay thế phác đồ thuốc và theo dõi lao.</p>
    </header>
    <form id="tb-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-tb /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế ngay khi</h2>
      <p>Vàng da, nước tiểu sẫm, nôn không giữ được thuốc, nhìn mờ, khó thở, phát ban phồng rộp hoặc lú lẫn.</p>
      <p class="warning">Không tự ngừng thuốc lao, tự đổi lịch uống hoặc uống rượu bia trong thời gian điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("tb-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-tb]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang lịch uống thuốc, cân nặng, triệu chứng và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ lao hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .tb-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .tb-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
