---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";
const recipeData = recipes.map(r => ({
  slug: r.slug,
  name: r.name,
  servingName: r.servingName || "1 suất",
  nutrients: calculateRecipe(r)
}));
---

<BaseLayout title="So sánh bữa ăn - Dinh Dưỡng Việt" canonical="/cong-cu/so-sanh-bua-an">
  <span class="badge">⭐ Công cụ</span>
  <h1>🍽️ So sánh bữa ăn</h1>
  <p class="lead">Chọn 2-4 món ăn để so sánh dinh dưỡng cạnh nhau. Xem bên nào nhiều đạm hơn, ít carb hơn, phù hợp với mục tiêu của bạn.</p>

  <div class="disclaimer">Dữ liệu ước tính dựa trên công thức trung bình. Kết quả có thể sai lệch ±15% theo cách chế biến thực tế.</div>

  <section class="tool-section card">
    <div class="picker-grid">
      <div class="picker-col">
        <label>Món 1 <span class="required">*</span></label>
        <select id="meal1" class="meal-select" onchange="compare()">
          <option value="">-- Chọn món --</option>
          {recipeData.map(r => <option value={r.slug}>{r.name}</option>)}
        </select>
      </div>
      <div class="picker-col">
        <label>Món 2 <span class="required">*</span></label>
        <select id="meal2" class="meal-select" onchange="compare()">
          <option value="">-- Chọn món --</option>
          {recipeData.map(r => <option value={r.slug}>{r.name}</option>)}
        </select>
      </div>
      <div class="picker-col">
        <label>Món 3</label>
        <select id="meal3" class="meal-select" onchange="compare()">
          <option value="">-- Không chọn --</option>
          {recipeData.map(r => <option value={r.slug}>{r.name}</option>)}
        </select>
      </div>
      <div class="picker-col">
        <label>Món 4</label>
        <select id="meal4" class="meal-select" onchange="compare()">
          <option value="">-- Không chọn --</option>
          {recipeData.map(r => <option value={r.slug}>{r.name}</option>)}
        </select>
      </div>
    </div>

    <div id="results">
      <div class="empty-state">
        <div class="empty-icon">🍽️</div>
        <h3>Chọn ít nhất 2 món để so sánh</h3>
        <p class="muted">Chọn từ 2-4 món ăn ở trên, bảng so sánh sẽ hiện ra tự động.</p>
      </div>
    </div>
  </section>

  <script id="recipe-data" type="application/json">{JSON.stringify(recipeData)}</script>
</BaseLayout>

<script>
const RECIPES = JSON.parse(document.getElementById('recipe-data').textContent);

function getRecipe(slug) { return RECIPES.find(r => r.slug === slug); }

function n(v) { return v && typeof v === 'number' ? v : 0; }

function fmt(v) {
  if (v === 0 || v == null) return "—";
  return v < 10 ? v.toFixed(1) : Math.round(v).toString();
}

const NUTRIENTS = [
  {key:"energyKcal",lbl:"🔥 Năng lượng",unit:"kcal"},
  {key:"proteinG",lbl:"🥩 Đạm",unit:"g"},
  {key:"fatG",lbl:"🧈 Béo",unit:"g"},
  {key:"carbG",lbl:"🍚 Carb",unit:"g"},
  {key:"fiberG",lbl:"🌾 Chất xơ",unit:"g"},
  {key:"sugarG",lbl:"🍬 Đường",unit:"g"},
  {key:"satFatG",lbl:"🥓 Béo bão hòa",unit:"g"},
  {key:"sodiumMg",lbl:"🧂 Natri",unit:"mg"},
  {key:"potassiumMg",lbl:"🍌 Kali",unit:"mg"},
  {key:"ironMg",lbl:"🩸 Sắt",unit:"mg"},
  {key:"calciumMg",lbl:"🦴 Canxi",unit:"mg"},
  {key:"vitCIUMg",lbl:"🍊 Vitamin C",unit:"mg"},
];

function compare() {
  var slugs = ["meal1","meal2","meal3","meal4"]
    .map(function(id){return document.getElementById(id).value})
    .filter(Boolean);
  var $r = document.getElementById("results");
  if (slugs.length < 2) {
    $r.innerHTML = '<div class="empty-state"><div class="empty-icon">🍽️</div><h3>Chọn ít nhất 2 món để so sánh</h3><p class="muted">Chọn từ 2-4 món ăn ở trên, bảng so sánh sẽ hiện ra tự động.</p></div>';
    return;
  }
  var meals = slugs.map(function(slug){return {slug:slug,...getRecipe(slug)};});
  if (meals.some(function(m){return !m;})) return;

  var html = '<div class="compare-table-wrapper"><table class="compare-table"><thead><tr><th>Chỉ số</th>';
  meals.forEach(function(m){html += '<th><a href="/mon-an/'+m.slug+'">'+m.name+'</a><br><small>'+m.servingName+'</small></th>';});
  html += '</tr></thead><tbody>';

  NUTRIENTS.forEach(function(nk){
    var vals = meals.map(function(m){return n(m.nutrients[nk.key]);});
    var max = Math.max.apply(null, vals);
    var min = Math.min.apply(null, vals.filter(function(v){return v>0;}));
    if (!vals.some(function(v){return v>0;})) return;

    html += '<tr><td class="key-cell">'+nk.lbl+'</td>';
    vals.forEach(function(v){
      var cls = "";
      if (v === max && v > 0) cls = " highlight-max";
      else if (v === min && v > 0) cls = " highlight-min";
      html += '<td class="val-cell'+cls+'"><span class="val-num">'+fmt(v)+'</span> <span class="val-unit">'+nk.unit+'</span></td>';
    });
    html += '</tr>';
  });
  html += '</tbody></table></div>';

  // Summary
  html += '<div class="summary-bar"><h3>📊 Tóm tắt nhanh</h3><div class="summary-grid">';
  NUTRIENTS.slice(0,6).forEach(function(nk){
    var vals = meals.map(function(m){return n(m.nutrients[nk.key]);});
    var max = Math.max.apply(null, vals);
    var min = Math.min.apply(null, vals.filter(function(v){return v>0;}));
    if (!vals.some(function(v){return v>0;})) return;
    var maxMeal = meals[vals.indexOf(max)].name;
    var minMeal = meals[vals.indexOf(min)].name;
    html += '<div class="summary-card"><div class="summary-label">'+nk.lbl+'</div><div class="summary-max">⬆️ '+maxMeal+': '+fmt(max)+'</div><div class="summary-min">⬇️ '+minMeal+': '+fmt(min)+'</div></div>';
  });
  html += '</div></div>';
  html += '<div class="meal-links">';
  meals.forEach(function(m){html += '<a class="meal-link" href="/mon-an/'+m.slug+'">🔗 Chi tiết: '+m.name+' →</a>';});
  html += '</div>';

  $r.innerHTML = html;
}
</script>

<style>
.tool-section { padding: 20px; }
.picker-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:24px; }
.picker-col label { display:block; font-weight:600; font-size:0.88rem; margin-bottom:6px; }
.required { color:#d32f2f; }
.meal-select { width:100%; padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:var(--bg-card); font-size:0.9rem; color:var(--ink); }
.meal-select:focus { border-color:var(--brand); box-shadow:0 0 0 3px var(--brand-light); outline:none; }
.empty-state { text-align:center; padding:48px 20px; }
.empty-icon { font-size:3rem; margin-bottom:8px; }
.compare-table-wrapper { overflow-x:auto; margin-bottom:20px; }
.compare-table { width:100%; border-collapse:collapse; font-size:0.9rem; }
.compare-table th, .compare-table td { padding:10px 14px; border-bottom:1px solid var(--border); text-align:center; }
.compare-table th { background:var(--bg-elevated); font-weight:600; position:sticky; top:0; }
.compare-table th a { color:var(--ink); text-decoration:none; }
.compare-table th a:hover { color:var(--brand); }
.compare-table th small { font-weight:400; font-size:0.78rem; color:var(--ink-tertiary); }
.key-cell { text-align:left !important; font-weight:500; white-space:nowrap; }
.val-num { font-weight:700; font-size:1.05rem; }
.val-unit { font-size:0.78rem; color:var(--ink-tertiary); }
.highlight-max { background:rgba(76,175,80,0.08); }
.highlight-max .val-num { color:#2e7d32; }
.highlight-min { background:rgba(255,152,0,0.08); }
.highlight-min .val-num { color:#e65100; }
.summary-bar { background:var(--bg-elevated); border-radius:12px; padding:20px; margin-bottom:16px; }
.summary-bar h3 { margin:0 0 12px; font-size:1rem; }
.summary-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; }
.summary-card { padding:10px 14px; background:var(--bg-card); border-radius:8px; }
.summary-label { font-weight:600; font-size:0.85rem; margin-bottom:6px; }
.summary-max { font-size:0.82rem; color:#2e7d32; }
.summary-min { font-size:0.82rem; color:#e65100; }
.meal-links { display:flex; gap:12px; flex-wrap:wrap; }
.meal-link { display:inline-block; padding:8px 16px; background:var(--brand-light); border-radius:8px; color:var(--brand); font-weight:600; font-size:0.9rem; }
@media (max-width:700px) { .picker-grid { grid-template-columns:1fr 1fr; } .compare-table { font-size:0.82rem; } .compare-table th, .compare-table td { padding:8px 10px; } }
@media (max-width:500px) { .picker-grid { grid-template-columns:1fr; } }
</style>
