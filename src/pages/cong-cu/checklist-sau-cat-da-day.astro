---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau cắt dạ dày";
const desc = "Bảng kiểm ăn uống, dumping và vi chất sau phẫu thuật cắt một phần hoặc toàn bộ dạ dày.";
const items = [
  "Tôi chia thành nhiều bữa nhỏ, ăn chậm, nhai kỹ và ngồi thẳng khi ăn",
  "Tôi tách lượng nước khỏi bữa ăn theo hướng dẫn để giảm đầy bụng và dumping",
  "Tôi nhận biết vã mồ hôi, run, hồi hộp, đau quặn hoặc tiêu chảy sau ăn để báo đội điều trị",
  "Tôi ăn đủ năng lượng–đạm và dùng vitamin B12, sắt, canxi/vitamin D theo xét nghiệm và đơn",
  "Tôi theo dõi cân nặng, số lần đi ngoài, lượng uống và khả năng dung nạp từng món",
  "Tôi báo sớm khi nôn kéo dài, nuốt nghẹn, tiểu ít, chóng mặt hoặc sụt cân tiếp tục",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-sau-cat-da-day">
  <main class="gastrectomy-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm hậu phẫu tiêu hóa</p>
      <h1>🍽️ Checklist sau cắt dạ dày</h1>
      <p>{desc} Kế hoạch cần cá thể hóa theo phần dạ dày còn lại và bệnh nền.</p>
    </header>
    <form id="gastrectomy-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-gastrectomy /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội điều trị khi</h2>
      <p>Nôn không giữ được nước/thuốc, đau bụng tăng, sốt, nuốt nghẹn, tiêu chảy nhiều, choáng hoặc tiểu ít.</p>
      <p class="warning">Không tự dùng men tiêu hóa, thuốc cầm tiêu chảy hoặc bỏ thuốc bổ sung đã được kê.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("gastrectomy-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-gastrectomy]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký ăn uống, triệu chứng dumping, cân nặng và thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ phẫu thuật hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .gastrectomy-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .gastrectomy-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
