---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng bệnh thận mạn chưa lọc máu";
const desc = "Bảng kiểm chuẩn bị xét nghiệm và câu hỏi dinh dưỡng theo giai đoạn bệnh thận mạn.";
const items = [
  "Tôi biết eGFR/giai đoạn bệnh thận và xu hướng creatinine gần đây",
  "Tôi có kết quả kali, phốt pho, bicarbonate và albumin nếu bác sĩ đã chỉ định",
  "Tôi biết mức đạm, muối, nước, kali và phốt pho cần cá thể hóa",
  "Tôi đọc nhãn natri/phosphate và không tự dùng muối thay thế",
  "Tôi rà soát thuốc giảm đau, thuốc bổ, thảo dược và thực phẩm bổ sung",
  "Tôi theo dõi phù, huyết áp, cân nặng, lượng tiểu và dấu hiệu mất nước",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ckd-chua-loc-mau">
  <main class="ckd-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thận</p>
      <h1>🫘 Checklist CKD chưa lọc máu</h1>
      <p>{desc} Không có một thực đơn CKD chung; mục tiêu thay đổi theo eGFR, xét nghiệm và bệnh kèm.</p>
    </header>
    <form id="ckd-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-ckd /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ bác sĩ khi</h2>
      <p>Phù tăng nhanh, khó thở, đau ngực, yếu cơ/hồi hộp, nôn nhiều, tiểu ít hoặc lú lẫn.</p>
      <p class="warning">Không tự giảm đạm, kali, phốt pho hoặc nước chỉ dựa trên tên “suy thận”.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("ckd-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-ckd]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, huyết áp, lượng tiểu và xét nghiệm để tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ thận hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .ckd-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .ckd-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
