---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Tra nhanh lượng muối trong món ăn Việt";
const desc =
  "Xem ước tính muối trong một số món Việt thường gặp và nhắc các tình huống cần hỏi bác sĩ hoặc chuyên gia.";

const foods = [
  { name: "Phở bò (1 tô)", salt: "3.5-4.5g", note: "Nước dùng + nước mắm chấm" },
  { name: "Bún bò Huế (1 tô)", salt: "4-5g", note: "Mắm ruốc + nước dùng đậm" },
  { name: "Bún riêu (1 tô)", salt: "3.5-4g", note: "Mắm tôm + nước dùng" },
  { name: "Bánh mì thịt (1 ổ)", salt: "2-3g", note: "Ruốc, pate, xúc xích, nước sốt" },
  { name: "Cơm tấm sườn bì (1 đĩa)", salt: "3-4g", note: "Sườn ướp + nước mắm + đồ chua" },
  { name: "Cơm trắng + cá kho (1 suất)", salt: "2.5-3.5g", note: "Cá kho mặn + nước mắm" },
  { name: "Cơm trắng + thịt kho (1 suất)", salt: "2.5-3.5g", note: "Nước kho mặn" },
  { name: "Canh chua (1 bát)", salt: "1.5-2g", note: "Nêm mắm + muối" },
  { name: "Canh rau (1 bát)", salt: "1-1.5g", note: "Tùy độ mặn khi nêm" },
  { name: "Rau luộc (1 đĩa)", salt: "0-0.5g", note: "Không muối khi luộc" },
  { name: "Rau xào (1 đĩa)", salt: "1-1.5g", note: "Nêm nước mắm khi xào" },
  { name: "Gỏi cuốn (2 cuốn)", salt: "0.8-1.2g", note: "Nước chấm là chính" },
  { name: "Bánh cuốn (1 đĩa)", salt: "2-3g", note: "Nước mắm + chả/sườn" },
  { name: "Bún chả (1 suất)", salt: "3-4g", note: "Nước mắm chấm + chả" },
  { name: "Bánh xèo (2 cái)", salt: "2-3g", note: "Bột + nước mắm chấm" },
  { name: "Bún mắm (1 tô)", salt: "4-6g", note: "Mắm cá đậm vị" },
  { name: "Lẩu (1 bát nước lẩu)", salt: "1.5-2.5g", note: "Nước lẩu thường mặn" },
  { name: "Bún thịt nướng (1 suất)", salt: "2.5-3.5g", note: "Thịt ướp + nước mắm" },
  { name: "Miến gà (1 tô)", salt: "2-3g", note: "Nước dùng + nước mắm" },
  { name: "Cháo thịt băm (1 tô)", salt: "1-1.5g", note: "Tùy nêm" },
  { name: "Cá hấp (1 suất)", salt: "1-1.5g", note: "Nước mắm chấm riêng" },
  { name: "Thịt luộc (1 suất)", salt: "0.5-1g", note: "Nước mắm chấm riêng" },
  { name: "Salad trộn (1 đĩa)", salt: "0.5-1g", note: "Tùy sốt" },
  { name: "Mì gói (1 gói)", salt: "3-4g", note: "Gói gia vị + gói dầu" },
  { name: "Xúc xích (1 cây)", salt: "1-1.5g", note: "Thực phẩm chế biến sẵn" },
  { name: "Giò lụa (100g)", salt: "2-3g", note: "Muối trong chế biến" },
  { name: "Lạp xưởng (1 cây)", salt: "2-3g", note: "Thực phẩm chế biến sẵn" },
  { name: "Dưa muối, cà muối (100g)", salt: "3-5g", note: "Món muối chua mặn" },
];

const safetySituations = [
  "Tăng huyết áp, suy tim, phù hoặc đang được dặn hạn chế muối/dịch",
  "Bệnh thận mạn, lọc máu, xơ gan/cổ trướng hoặc hạ natri máu",
  "Đái tháo đường, bệnh tim mạch, người cao tuổi yếu hoặc đang sụt cân",
  "Đang dùng thuốc lợi tiểu, thuốc huyết áp, thuốc thận hoặc nhiều thuốc cùng lúc",
  "Đang mang thai, cho con bú, hoặc có triệu chứng bất thường như phù nhanh, khó thở, chóng mặt",
];

const prepareItems = [
  "Tên món, khẩu phần và số lần ăn trong tuần",
  "Loại nước chấm, nước dùng, đồ muối chua hoặc thực phẩm chế biến sẵn hay dùng",
  "Chẩn đoán, thuốc đang dùng và xét nghiệm gần đây nếu có",
  "Lời dặn hiện tại của bác sĩ hoặc chuyên gia về muối, nước, cân nặng và huyết áp",
];
---

<BaseLayout title={title} description={desc} image="/logo.svg">
  <main class="salt-tool" data-foods={JSON.stringify(foods)}>
    <section class="hero">
      <p class="eyebrow">Trang tham khảo</p>
      <h1>🧂 Tra nhanh lượng muối trong món ăn</h1>
      <p class="lead">
        Trang này chỉ giúp xem ước tính muối trong một số món Việt thường gặp.
        Kết quả không đặt mức ăn riêng cho bệnh nền và không thay thế tư vấn của bác sĩ
        hoặc chuyên gia dinh dưỡng.
      </p>
    </section>

    <section class="safety-card" aria-labelledby="safety-title">
      <h2 id="safety-title">Khi nào cần hỏi chuyên môn?</h2>
      <p>
        Nếu bạn có bệnh nền, đang dùng thuốc hoặc từng được dặn ăn nhạt, hãy dùng nhật ký món ăn
        như thông tin chuẩn bị khi trao đổi với bác sĩ hoặc chuyên gia.
      </p>
      <p>
        Mốc đọc nhanh ở v1: WHO khuyến nghị người lớn giới hạn dưới 5 g muối/ngày, tương đương khoảng 2000 mg natri.
      </p>
      <ul>
        {safetySituations.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="lookup-card" aria-labelledby="lookup-title">
      <div class="section-head">
        <div>
          <h2 id="lookup-title">Tra món thường gặp</h2>
          <p>Khoảng muối dưới đây là ước tính tham khảo; cách nêm, nước chấm và khẩu phần có thể làm thay đổi nhiều.</p>
        </div>
        <span class="badge">Ước tính món ăn</span>
      </div>

      <label class="search-label" for="search-input">Tìm món ăn</label>
      <input id="search-input" type="search" placeholder="Ví dụ: phở, bún, mì gói..." autocomplete="off" />

      <div id="results" class="results" aria-live="polite"></div>
    </section>

    <section class="info-grid" aria-label="Thông tin chuẩn bị">
      <div class="info-panel">
        <h2>Trang này không làm gì?</h2>
        <ul>
          <li>Không đặt mức muối, natri, nước hoặc kali/phospho riêng cho bạn.</li>
          <li>Không phân loại món ăn là phù hợp hay không phù hợp cho một bệnh nền.</li>
          <li>Không hướng dẫn tự đổi thuốc, thuốc lợi tiểu, nước uống hoặc chế độ đang theo dõi.</li>
        </ul>
      </div>
      <div class="info-panel">
        <h2>Nên mang theo khi đi khám</h2>
        <ul>
          {prepareItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const root = document.querySelector(".salt-tool");
  const foods = JSON.parse(root?.dataset.foods || "[]");
  const searchInput = document.getElementById("search-input");
  const resultsDiv = document.getElementById("results");

  function createRow(food) {
    const row = document.createElement("article");
    row.className = "food-row";

    const text = document.createElement("div");
    const title = document.createElement("strong");
    title.textContent = food.name;
    const note = document.createElement("p");
    note.textContent = food.note;
    text.append(title, note);

    const amount = document.createElement("div");
    amount.className = "salt-amount";
    const value = document.createElement("span");
    value.textContent = food.salt;
    const label = document.createElement("small");
    label.textContent = "muối ước tính";
    amount.append(value, label);

    row.append(text, amount);
    return row;
  }

  function render(list) {
    resultsDiv.replaceChildren();
    if (list.length === 0) {
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent = "Không tìm thấy món nào trong danh sách tham khảo.";
      resultsDiv.append(empty);
      return;
    }
    list.forEach((food) => resultsDiv.append(createRow(food)));
  }

  render(foods);
  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    render(foods.filter((food) => food.name.toLowerCase().includes(query)));
  });
</script>

<style>
  .salt-tool {
    max-width: 880px;
    margin: 0 auto;
    padding: 32px 16px 48px;
  }

  .hero {
    margin-bottom: 22px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 10px;
    font-size: 1.9rem;
    line-height: 1.2;
  }

  h2 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }

  .lead,
  .section-head p,
  .safety-card p {
    color: var(--ink-secondary);
    line-height: 1.65;
  }

  .safety-card,
  .lookup-card,
  .info-panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    padding: 18px;
  }

  .safety-card {
    margin-bottom: 16px;
    background: var(--brand-light);
  }

  ul {
    margin: 10px 0 0;
    padding-left: 20px;
  }

  li {
    margin: 7px 0;
    line-height: 1.5;
  }

  .section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .badge {
    flex: 0 0 auto;
    border-radius: 999px;
    background: #eef7f1;
    color: #217245;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .search-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 700;
  }

  #search-input {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font-size: 1rem;
    padding: 10px 12px;
  }

  .results {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .food-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 13px 14px;
    background: var(--bg-soft);
  }

  .food-row p {
    margin: 5px 0 0;
    color: var(--ink-secondary);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .salt-amount {
    min-width: 112px;
    text-align: right;
  }

  .salt-amount span {
    display: block;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--brand);
  }

  .salt-amount small {
    color: var(--ink-tertiary);
    font-size: 0.76rem;
  }

  .empty-state {
    border: 1px dashed var(--line);
    border-radius: 8px;
    color: var(--ink-secondary);
    margin: 0;
    padding: 14px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 16px;
  }

  @media (max-width: 700px) {
    .salt-tool {
      padding: 24px 14px 40px;
    }

    h1 {
      font-size: 1.55rem;
    }

    .section-head,
    .food-row {
      flex-direction: column;
    }

    .salt-amount {
      min-width: 0;
      text-align: left;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
