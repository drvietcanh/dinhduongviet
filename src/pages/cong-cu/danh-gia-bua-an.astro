---
import BaseLayout from "../../layouts/BaseLayout.astro";

const stableTools = [
  {
    title: "Đánh giá khẩu phần Việt",
    href: "/cong-cu/khau-phan-viet-clinical/",
    badge: "Đã kiểm v1",
    description: "Nhập món và gram để xem tổng năng lượng, carb, protein, fat từ khẩu phần, kèm cờ cần cá thể hóa.",
    note: "Không kê đơn khẩu phần điều trị.",
  },
  {
    title: "Tính carb trong bữa ăn",
    href: "/cong-cu/tinh-carb/",
    badge: "Đã kiểm v1",
    description: "Tập trung vào lượng carbohydrate theo món và khẩu phần.",
  },
  {
    title: "Tính GL từ bữa ăn",
    href: "/cong-cu/tinh-gl-bua-an/",
    badge: "Đã kiểm v1",
    description: "Ước tính tải đường huyết khi món có GI mapping phù hợp.",
  },
  {
    title: "Tính nhu cầu đạm",
    href: "/cong-cu/tinh-nhu-cau-dam/",
    badge: "Đã kiểm v1",
    description: "Xem khoảng đạm tham khảo với safety gate cho các nhóm cần cá thể hóa.",
  },
  {
    title: "Nhu cầu nước mỗi ngày",
    href: "/cong-cu/nuoc-uong/",
    badge: "Đã kiểm v1",
    description: "Ước tính nước cho người khỏe, chặn nhóm cần cá thể hóa.",
  },
];

const relatedTools = [
  {
    title: "So sánh bữa ăn",
    href: "/cong-cu/so-sanh-bua-an/",
    badge: "Đang hoàn thiện",
    description: "So sánh 2-4 món hoặc recipe cạnh nhau.",
  },
  {
    title: "Tra cứu thực phẩm Việt",
    href: "/cong-cu/tra-cuu-thuc-pham-viet/",
    badge: "Đang hoàn thiện",
    description: "Tra cứu nhanh dữ liệu thực phẩm để chọn món phù hợp với câu hỏi của bạn.",
  },
];
---

<BaseLayout
  title="Đánh giá bữa ăn | Dinh Dưỡng Việt"
  description="Hub chọn công cụ phù hợp để ước tính và giáo dục dinh dưỡng về bữa ăn."
>
  <style>
    .meal-hub {
      max-width: 980px;
      margin: 0 auto;
      padding: 28px 0 36px;
    }

    .meal-hub h1 {
      margin: 0 0 8px;
      font-size: 1.7rem;
      line-height: 1.25;
    }

    .meal-hub .lead {
      max-width: 760px;
      margin: 0 0 10px;
      color: var(--ink-secondary);
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .meal-hub .intro-note {
      max-width: 760px;
      margin: 0 0 24px;
      color: var(--ink-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .hub-section {
      margin-top: 28px;
    }

    .hub-section h2 {
      margin: 0 0 12px;
      font-size: 1.12rem;
      line-height: 1.35;
    }

    .hub-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .hub-card {
      display: flex;
      min-height: 148px;
      flex-direction: column;
      gap: 10px;
      padding: 17px 18px;
      color: inherit;
      text-decoration: none;
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      transition: all var(--transition);
      box-shadow: var(--shadow-sm);
    }

    .hub-card:hover {
      border-color: var(--brand-light2);
      box-shadow: var(--shadow);
      transform: translateY(-4px);
    }

    .hub-card.is-related {
      background: var(--bg-soft);
      border-style: dashed;
    }

    .hub-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .hub-card h3 {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.35;
    }

    .hub-card h3 span {
      color: var(--brand);
    }

    .hub-badge {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 4px 9px;
      border-radius: 999px;
      background: var(--brand-light);
      color: var(--brand-dark);
      font-size: 0.72rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .hub-card.is-related .hub-badge {
      background: var(--brand-light2);
      color: var(--brand-dark);
    }

    .hub-card p {
      margin: 0;
      color: var(--ink-secondary);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    .hub-card .note {
      margin-top: auto;
      color: var(--ink-tertiary);
      font-size: 0.8rem;
    }

    .safety-note {
      margin-top: 28px;
      padding: 15px 17px;
      color: var(--ink-secondary);
      background: var(--bg-soft);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    .safety-note strong {
      color: var(--ink);
    }

    @media (max-width: 700px) {
      .meal-hub {
        padding-top: 20px;
      }

      .meal-hub h1 {
        font-size: 1.45rem;
      }

      .hub-grid {
        grid-template-columns: 1fr;
      }

      .hub-card {
        min-height: 0;
        padding: 16px;
      }

      .hub-card-head {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>

  <main class="meal-hub">
    <h1>Đánh giá bữa ăn</h1>
    <p class="lead">Chọn công cụ phù hợp với mục tiêu của bạn.</p>
    <p class="intro-note">Các công cụ bên dưới dùng để ước tính và giáo dục dinh dưỡng, không thay thế tư vấn cá thể.</p>

    <section class="hub-section" aria-labelledby="stable-tools">
      <h2 id="stable-tools">Công cụ đã kiểm v1</h2>
      <div class="hub-grid">
        {stableTools.map((tool) => (
          <a class="hub-card" href={tool.href}>
            <div class="hub-card-head">
              <h3>{tool.title} <span>→</span></h3>
              <span class="hub-badge">{tool.badge}</span>
            </div>
            <p>{tool.description}</p>
            {tool.note && <p class="note">{tool.note}</p>}
          </a>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="related-tools">
      <h2 id="related-tools">Công cụ liên quan</h2>
      <div class="hub-grid">
        {relatedTools.map((tool) => (
          <a class="hub-card is-related" href={tool.href}>
            <div class="hub-card-head">
              <h3>{tool.title} <span>→</span></h3>
              <span class="hub-badge">{tool.badge}</span>
            </div>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <div class="safety-note">
      <strong>Lưu ý:</strong> Nếu bạn có bệnh thận, đái tháo đường dùng insulin/sulfonylurea, suy tim/hạn chế dịch, thai kỳ, trẻ em, ung thư/suy dinh dưỡng, rối loạn ăn uống hoặc sụt cân nhanh, hãy ưu tiên tư vấn cá thể. Kết quả phụ thuộc dữ liệu món ăn và khối lượng nhập.
    </div>
  </main>
</BaseLayout>
