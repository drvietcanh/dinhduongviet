---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng thiếu máu thiếu sắt";
const desc = "Bảng kiểm ăn uống và theo dõi khi có thiếu máu hoặc nguy cơ thiếu sắt.";
const items = [
  "Tôi biết kết quả công thức máu, ferritin hoặc xét nghiệm mà bác sĩ đã chỉ định",
  "Bữa ăn có nguồn sắt phù hợp (thịt/cá/trứng hoặc đậu, rau lá xanh theo khẩu phần)",
  "Tôi kết hợp nguồn vitamin C phù hợp và tránh uống trà/cà phê sát bữa giàu sắt",
  "Tôi đã trao đổi nguyên nhân mất máu, kinh nhiều, bệnh tiêu hóa hoặc kém hấp thu",
  "Tôi dùng viên sắt đúng liều/thời điểm và biết cách xử trí táo bón, buồn nôn",
  "Tôi theo dõi mệt, khó thở, hồi hộp, chóng mặt và lịch xét nghiệm lại",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-thieu-mau">
  <main class="anemia-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm huyết học</p>
      <h1>🩸 Checklist thiếu máu thiếu sắt</h1>
      <p>{desc} Thiếu máu có nhiều nguyên nhân; ăn uống không thay thế việc tìm nguyên nhân và điều trị.</p>
    </header>
    <form id="anemia-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-anemia /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Khó thở khi nghỉ, đau ngực, ngất, tim đập rất nhanh, đi ngoài phân đen/có máu hoặc mệt tăng nhanh.</p>
      <p class="warning">Không tự uống sắt liều cao kéo dài hoặc dùng thuốc “bổ máu” khi chưa biết nguyên nhân.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("anemia-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-anemia]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi triệu chứng, thuốc và mang xét nghiệm khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ hoặc chuyên gia dinh dưỡng về phần còn thiếu và nguyên nhân thiếu máu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .anemia-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .anemia-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
