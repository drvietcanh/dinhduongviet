---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi sốt xuất huyết";
const desc = "Bảng kiểm bù dịch, ăn uống và dấu hiệu cảnh báo khi sốt xuất huyết.";
const items = [
  "Tôi uống từng ngụm nhỏ dung dịch oresol/nước phù hợp và theo dõi lượng tiểu, không cố uống quá mức",
  "Tôi ăn mềm, dễ tiêu, chia nhỏ bữa và tiếp tục dinh dưỡng nếu không nôn",
  "Tôi dùng paracetamol đúng liều đã hướng dẫn và không dùng aspirin/ibuprofen",
  "Tôi theo dõi sốt, đau bụng, nôn, chảy máu, lừ đừ, tay chân lạnh và lượng nước tiểu",
  "Tôi tái khám/xét nghiệm đúng hẹn, đặc biệt khi hạ sốt nhưng mệt hơn hoặc uống kém",
  "Tôi biết dấu hiệu cảnh báo cần đến viện ngay và không tự truyền dịch tại nhà",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-sot-xuat-huyet">
  <main class="dengue-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm truyền nhiễm</p>
      <h1>🦟 Checklist sốt xuất huyết</h1>
      <p>{desc} Sốt xuất huyết có thể nặng nhanh quanh giai đoạn hạ sốt, cần theo dõi y tế sát.</p>
    </header>
    <form id="dengue-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-dengue /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Đến viện ngay khi</h2>
      <p>Đau bụng nhiều, nôn liên tục, chảy máu, lừ đừ, khó thở, tay chân lạnh, tiểu ít hoặc không uống được.</p>
      <p class="warning">Không dùng aspirin/ibuprofen, thuốc nam không rõ nguồn hoặc tự truyền dịch tại nhà.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("dengue-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-dengue]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký sốt, lượng uống, nước tiểu, thuốc và xét nghiệm khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Liên hệ cơ sở y tế hoặc bác sĩ truyền nhiễm về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .dengue-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .dengue-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
