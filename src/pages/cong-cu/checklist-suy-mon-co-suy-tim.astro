---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist suy tim và nguy cơ suy mòn cơ";
const desc = "Bảng kiểm theo dõi ăn uống, cân nặng và vận động khi suy tim có nguy cơ mất cơ.";
const items = [
  "Tôi ghi cân nặng, vòng bụng, mức phù và khó thở theo cùng một thời điểm mỗi ngày",
  "Tôi báo bác sĩ khi tăng cân nhanh, phù tăng, ăn kém hoặc mệt hơn thường lệ",
  "Tôi chia thành nhiều bữa nhỏ, chọn đủ năng lượng và đạm theo kế hoạch cá thể hóa",
  "Tôi theo đúng giới hạn muối và lượng dịch được kê; không tự nhịn ăn để giảm phù",
  "Tôi dùng thuốc suy tim đúng giờ, không tự ngừng lợi tiểu hoặc tự mua thực phẩm bổ sung",
  "Tôi vận động nhẹ/phục hồi chức năng khi được cho phép và dừng khi đau ngực, choáng hoặc khó thở tăng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-suy-mon-co-suy-tim">
  <main class="hf-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tim mạch – dinh dưỡng</p>
      <h1>💗 Checklist suy tim và nguy cơ suy mòn cơ</h1>
      <p>{desc} Mục tiêu là giữ sức cơ và phát hiện sớm ứ dịch; không thay thế kế hoạch của bác sĩ tim mạch.</p>
    </header>
    <form id="hf-form" class="card">
      <p class="hint">Đánh dấu những việc đã thực hiện:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-hf /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế sớm khi</h2>
      <p>Khó thở khi nghỉ hoặc khi nằm, đau ngực, ngất/choáng, lú lẫn, môi tím, phù tăng nhanh hoặc không ăn uống được.</p>
      <p class="warning">Không tự tăng/giảm lợi tiểu, tự bổ sung kali, thuốc “bổ tim” hay nhịn nước nếu chưa được hướng dẫn.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("hf-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-hf]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký cân nặng, phù, lượng ăn và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tim mạch hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .hf-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .hf-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
