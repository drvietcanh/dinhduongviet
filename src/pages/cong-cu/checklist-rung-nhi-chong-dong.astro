---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist rung nhĩ và thuốc chống đông";
const desc = "Bảng kiểm dùng thuốc an toàn, tương tác thực phẩm và dấu hiệu chảy máu ở người rung nhĩ.";
const items = [
  "Tôi biết tên thuốc, liều và giờ uống; không tự bỏ liều hoặc uống bù",
  "Tôi báo bác sĩ/dược sĩ trước khi dùng thuốc giảm đau, kháng sinh, thảo dược hoặc thực phẩm bổ sung",
  "Nếu dùng warfarin, tôi giữ lượng rau lá xanh tương đối ổn định và đi xét nghiệm INR đúng lịch",
  "Tôi hạn chế rượu bia và tránh hoạt động dễ chấn thương khi chưa được tư vấn",
  "Tôi biết dấu hiệu chảy máu bất thường: phân đen, tiểu máu, nôn máu, bầm lan rộng",
  "Tôi nhận diện dấu hiệu đột quỵ và biết gọi cấp cứu ngay",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-rung-nhi-chong-dong">
  <main class="afib-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tim mạch</p>
      <h1>💓 Checklist rung nhĩ và chống đông</h1>
      <p>{desc} Không tự thay đổi rau xanh, thuốc hoặc liều chống đông để “ổn định INR”.</p>
    </header>
    <form id="afib-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-afib /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu ngay</h2>
      <p>Méo miệng, yếu liệt, nói khó, đau đầu dữ dội; hoặc chảy máu không cầm, nôn máu, phân đen, ngất.</p>
      <p class="warning">Không tự ngừng chống đông trước thủ thuật hay khi thấy bầm nhẹ nếu chưa hỏi bác sĩ.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("afib-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-afib]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi giờ uống thuốc, INR và triệu chứng để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ tim mạch hoặc dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .afib-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .afib-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
