---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau viêm tụy cấp";
const desc = "Bảng kiểm theo dõi ăn lại, rượu bia, chất béo và dấu hiệu cảnh báo sau viêm tụy cấp.";
const items = [
  "Tôi biết nguyên nhân viêm tụy (sỏi mật, triglyceride, rượu hoặc thuốc) và kế hoạch xử lý nguyên nhân",
  "Tôi ăn lại theo hướng dẫn, bắt đầu từng bước với khẩu phần nhỏ, dễ tiêu và không tự nhịn kéo dài",
  "Tôi hạn chế chất béo theo kế hoạch, tránh rượu bia và đồ uống có đường",
  "Tôi uống dịch theo chỉ dẫn, không tự truyền dịch hoặc uống quá nhiều khi có bệnh tim/thận",
  "Tôi dùng thuốc đúng đơn và báo mọi thuốc giảm đau, thuốc mỡ máu, thảo dược hoặc thực phẩm bổ sung",
  "Tôi biết dấu hiệu tái nặng: đau thượng vị lan ra lưng, nôn, sốt, vàng da, bụng chướng hoặc choáng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-viem-tuy-cap">
  <main class="pancreas-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🩻 Checklist sau viêm tụy cấp</h1>
      <p>{desc} Ăn uống cần điều chỉnh theo mức độ bệnh và nguyên nhân, không tự điều trị tại nhà.</p>
    </header>
    <form id="pancreas-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-pancreas /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu khi</h2>
      <p>Đau bụng dữ dội tăng nhanh, nôn liên tục, sốt, vàng da, bụng chướng, khó thở, choáng hoặc lơ mơ.</p>
      <p class="warning">Không tự nhịn ăn, uống rượu “cho thông mật”, dùng men tụy hay thuốc giảm đau liều cao nếu chưa được kê.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("pancreas-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-pancreas]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký đau, ăn uống, thuốc và xét nghiệm khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .pancreas-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .pancreas-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
