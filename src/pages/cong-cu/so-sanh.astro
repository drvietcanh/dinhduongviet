---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  {
    icon: "⚖️",
    title: "So sánh thực phẩm",
    href: "/cong-cu/so-sanh-thuc-pham",
    badge: "Đã kiểm v1",
    description: "Đặt 2-4 thực phẩm cạnh nhau để so năng lượng, đạm, carb, chất béo, natri và các vi chất chính.",
    bestFor: "Khi bạn muốn chọn giữa các nguyên liệu hoặc món đơn lẻ theo 100 g."
  },
  {
    icon: "🍱",
    title: "So sánh bữa ăn",
    href: "/cong-cu/so-sanh-bua-an",
    badge: "Đã kiểm v1",
    description: "Chọn 2-4 món ăn để xem khác biệt về năng lượng, macro và một số khoáng chất trong mỗi suất.",
    bestFor: "Khi bạn đang phân vân giữa các lựa chọn bữa chính hoặc món ăn đã có công thức."
  }
];
---

<BaseLayout
  title="So sánh dinh dưỡng - Dinh dưỡng Việt"
  description="Hub chọn công cụ so sánh dinh dưỡng phù hợp: so sánh thực phẩm hoặc so sánh bữa ăn."
  canonical="/cong-cu/so-sanh"
  robots="noindex,follow"
>
  <style>
    .compare-hub { max-width: 980px; margin: 0 auto; padding: 24px 0 34px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 10px; color: var(--brand); font-weight: 700; font-size: 0.88rem; }
    .compare-hub h1 { margin: 0 0 8px; font-size: 1.8rem; line-height: 1.2; letter-spacing: 0; }
    .lead { max-width: 720px; color: var(--ink-secondary); font-size: 1rem; margin: 0 0 22px; }
    .tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 20px 0 18px; }
    .tool-card {
      display: flex;
      flex-direction: column;
      min-height: 260px;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card);
      color: inherit;
      text-decoration: none;
      box-shadow: var(--shadow-sm);
    }
    .tool-card:hover { border-color: var(--brand); box-shadow: var(--shadow); text-decoration: none; }
    .card-top { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
    .tool-icon { flex: 0 0 42px; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 8px; background: var(--brand-light); font-size: 1.4rem; }
    .card-title { min-width: 0; flex: 1; }
    .card-title h2 { margin: 0 0 5px; font-size: 1.08rem; line-height: 1.25; letter-spacing: 0; }
    .badge { display: inline-flex; align-items: center; min-height: 24px; padding: 3px 8px; border-radius: 999px; background: var(--bg-info); color: var(--accent); font-size: 0.74rem; font-weight: 700; white-space: nowrap; }
    .tool-card p { margin: 0 0 12px; color: var(--ink-secondary); font-size: 0.9rem; line-height: 1.55; }
    .best-for { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line-light); color: var(--ink-secondary); font-size: 0.84rem; line-height: 1.5; }
    .best-for strong { color: var(--ink); }
    .cta { margin-top: 14px; color: var(--brand); font-size: 0.9rem; font-weight: 700; }
    .note { margin-top: 18px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-soft); color: var(--ink-secondary); font-size: 0.88rem; line-height: 1.55; }
    .note strong { color: var(--ink); }
    @media (max-width: 700px) {
      .compare-hub { padding-top: 12px; }
      .compare-hub h1 { font-size: 1.45rem; }
      .tool-grid { grid-template-columns: 1fr; }
      .tool-card { min-height: 0; padding: 16px; }
      .card-top { align-items: center; }
    }
  </style>

  <main class="compare-hub">
    <span class="eyebrow">Công cụ so sánh</span>
    <h1>So sánh dinh dưỡng</h1>
    <p class="lead">Hub chọn công cụ phù hợp để so sánh bữa ăn, món ăn hoặc dữ liệu dinh dưỡng.</p>

    <div class="tool-grid">
      {tools.map(tool => (
        <a class="tool-card" href={tool.href}>
          <div class="card-top">
            <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
            <div class="card-title">
              <h2>{tool.title}</h2>
              <span class="badge">{tool.badge}</span>
            </div>
          </div>
          <p>{tool.description}</p>
          <div class="best-for"><strong>Nên dùng khi:</strong> {tool.bestFor}</div>
          <span class="cta">Mở công cụ →</span>
        </a>
      ))}
    </div>

    <div class="note">
      <strong>Lưu ý:</strong> Kết quả so sánh giúp đọc dữ liệu và đặt lựa chọn cạnh nhau, không thay thế tư vấn cá thể hóa cho bệnh thận, tim mạch, đái tháo đường, thai kỳ hoặc đang dùng thuốc.
    </div>
  </main>
</BaseLayout>
