---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau ghép gan";
const desc = "Bảng kiểm ăn uống, an toàn thực phẩm và thuốc sau ghép gan.";
const items = [
  "Tôi dùng thuốc chống thải ghép đúng giờ, không tự ngừng và báo bác sĩ khi quên liều",
  "Tôi hỏi trước khi dùng bưởi, nước bưởi, thảo dược, thực phẩm bổ sung hoặc thuốc không kê đơn",
  "Tôi ăn chín uống sôi, rửa tay và tránh thực phẩm sống/nguy cơ nhiễm khuẩn theo hướng dẫn",
  "Tôi theo dõi cân nặng, huyết áp, đường huyết và mỡ máu theo lịch sau ghép",
  "Tôi chọn khẩu phần đủ đạm, rau quả an toàn và hạn chế muối, đường, chất béo bão hòa",
  "Tôi biết dấu hiệu sốt, vàng da, nước tiểu sẫm, đau vùng gan hoặc nôn tiêu chảy để liên hệ đội ghép",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ghep-gan">
  <main class="transplant-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ghép tạng</p>
      <h1>🫁 Checklist dinh dưỡng sau ghép gan</h1>
      <p>{desc} Bảng kiểm hỗ trợ theo dõi hằng ngày, không thay thế phác đồ của đội ghép.</p>
    </header>
    <form id="transplant-form" class="card">
      <p class="hint">Đánh dấu những việc đã thực hiện:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-transplant /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội ghép ngay khi</h2>
      <p>Sốt, rét run, vàng da tăng, đau bụng vùng gan, nôn/tiêu chảy kéo dài, lú lẫn hoặc không uống được thuốc.</p>
      <p class="warning">Không tự đổi liều thuốc chống thải ghép, tự dùng kháng sinh hay dùng thảo dược “bổ gan”.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("transplant-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-transplant]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký ăn uống, triệu chứng, xét nghiệm và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với đội ghép hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .transplant-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .transplant-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
