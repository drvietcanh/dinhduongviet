---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng trẻ em";
const desc = "Bảng kiểm ăn bổ sung, tăng trưởng và an toàn bữa ăn cho trẻ nhỏ.";
const items = [
  "Tôi theo dõi cân nặng/chiều dài hoặc chiều cao trên biểu đồ tăng trưởng phù hợp",
  "Bữa ăn có đa dạng nhóm thực phẩm và nguồn sắt/đạm phù hợp tuổi",
  "Tôi tôn trọng tín hiệu đói/no, không ép ăn, không dùng màn hình để dụ ăn",
  "Thức ăn đúng độ thô theo tuổi và luôn có người giám sát khi trẻ ăn",
  "Tôi tránh mật ong trước 12 tháng, sữa chưa tiệt trùng và thực phẩm dễ hóc",
  "Tôi biết khi nào cần khám nếu trẻ sụt cân, tiêu chảy kéo dài hoặc nuốt khó",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-tre-em">
  <main class="child-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm nhi khoa</p>
      <h1>👶 Checklist dinh dưỡng trẻ em</h1>
      <p>{desc} Nhu cầu thay đổi theo tuổi, tăng trưởng và bệnh nền; trẻ dưới 2 tuổi không dùng bảng kcal người lớn.</p>
    </header>
    <form id="child-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-child /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám khi</h2>
      <p>Trẻ không tăng trưởng, sụt cân, nôn/tiêu chảy kéo dài, ho sặc khi ăn, táo bón nặng hoặc lừ đừ.</p>
      <p class="warning">Không tự dùng thuốc kích thích ăn, sữa tăng cân hoặc vitamin liều cao khi chưa hỏi bác sĩ.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("child-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-child]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi tăng trưởng và phản ứng của trẻ với món mới để trao đổi khi cần.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ nhi hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .child-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .child-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
