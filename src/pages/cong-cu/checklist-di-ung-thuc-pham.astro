---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dị ứng thực phẩm";
const desc = "Bảng kiểm phòng tránh dị nguyên, đọc nhãn và chuẩn bị kế hoạch an toàn khi ăn uống.";
const items = [
  "Tôi biết dị nguyên đã được bác sĩ xác nhận và mức độ phản ứng trước đây",
  "Tôi đọc thành phần, cảnh báo 'có thể chứa' và hỏi rõ khi ăn ngoài",
  "Gia đình/trường học/nơi làm việc biết cách tránh nhiễm chéo và nhận diện phản vệ",
  "Tôi có kế hoạch khẩn cấp và thuốc/ống tiêm được kê còn hạn (nếu có)",
  "Tôi có thực phẩm thay thế để vẫn đủ đạm, năng lượng và vi chất",
  "Tôi không tự thử lại dị nguyên hoặc loại bỏ nhiều nhóm khi chưa được hướng dẫn",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-di-ung-thuc-pham">
  <main class="allergy-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm dị ứng</p>
      <h1>⚠️ Checklist dị ứng thực phẩm</h1>
      <p>{desc} Dị ứng thực phẩm khác với không dung nạp; cần xác nhận và kế hoạch riêng.</p>
    </header>
    <form id="allergy-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-allergy /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Phản vệ là cấp cứu</h2>
      <p>Khó thở, khò khè, sưng môi/lưỡi/họng, khàn tiếng, choáng/ngất hoặc nổi mề đay toàn thân sau ăn cần gọi cấp cứu và dùng thuốc cấp cứu đã được kê theo kế hoạch.</p>
      <p class="warning">Không chờ xem có tự hết hay chỉ dùng thuốc uống khi có dấu hiệu đường thở hoặc tụt huyết áp.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("allergy-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-allergy]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Kiểm tra lại kế hoạch cùng gia đình/trường học và mang theo khi tái khám dị ứng.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ dị ứng hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .allergy-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .allergy-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
