---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sỏi thận";
const desc = "Bảng kiểm thói quen hỗ trợ phòng sỏi thận tái phát theo loại sỏi và xét nghiệm.";
const items = [
  "Tôi biết loại sỏi hoặc đã hỏi về phân tích sỏi/xét nghiệm nước tiểu",
  "Tôi uống nước theo mục tiêu bác sĩ dặn, có điều chỉnh nếu suy tim/thận",
  "Tôi giảm muối và món chế biến sẵn, nước chấm mặn",
  "Tôi duy trì canxi từ thực phẩm phù hợp, không tự kiêng canxi hoàn toàn",
  "Tôi hỏi rõ có cần điều chỉnh oxalat, purin, đường hoặc đạm theo loại sỏi",
  "Tôi biết dấu hiệu tắc nghẽn/nhiễm trùng cần khám ngay",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-soi-than">
  <main class="stone-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiết niệu</p>
      <h1>🪨 Checklist dinh dưỡng sỏi thận</h1>
      <p>{desc} Không có một chế độ ăn chung cho mọi loại sỏi; cần dựa trên phân tích sỏi và xét nghiệm.</p>
    </header>
    <form id="stone-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-stone /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám ngay khi</h2>
      <p>Đau quặn kèm sốt/rét run, tiểu rất ít hoặc bí tiểu, nôn không uống được, tiểu máu nhiều hoặc đau tăng nhanh.</p>
      <p class="warning">Không tự dùng thuốc lợi tiểu, thảo dược “tan sỏi” hoặc nhịn ăn để điều trị sỏi.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("stone-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-stone]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi lượng nước, cơn đau và xét nghiệm để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ tiết niệu hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .stone-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .stone-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
