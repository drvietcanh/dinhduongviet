---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist đái tháo đường thai kỳ";
const desc = "Bảng kiểm bữa ăn, đường huyết và tăng cân an toàn trong thai kỳ có đái tháo đường.";
const items = [
  "Tôi chia carbohydrate đều trong ngày, không bỏ bữa và có bữa phụ theo kế hoạch",
  "Tôi ghi đường huyết lúc đói/sau ăn đúng thời điểm và mang nhật ký khi tái khám",
  "Tôi chọn tinh bột giàu chất xơ, đủ đạm và rau; hạn chế nước ngọt, trà sữa, bánh kẹo",
  "Tôi vận động nhẹ sau ăn khi sản khoa cho phép và biết khi nào phải dừng",
  "Tôi dùng insulin/thuốc được kê đúng hướng dẫn, không tự dùng thuốc giảm cân hoặc thảo dược",
  "Tôi theo dõi tăng cân, huyết áp, phù, đau đầu, nhìn mờ và cử động thai theo hướng dẫn sản khoa",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-dai-thao-duong-thai-ky">
  <main class="gdm-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thai kỳ</p>
      <h1>🤰 Checklist đái tháo đường thai kỳ</h1>
      <p>{desc} Mục tiêu là kiểm soát đường huyết mà vẫn đủ năng lượng cho mẹ và thai.</p>
    </header>
    <form id="gdm-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-gdm /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ sản khoa khi</h2>
      <p>Đường huyết thấp/cao kéo dài, nôn không ăn uống được, đau đầu/nhìn mờ, phù tăng, đau bụng hoặc giảm cử động thai.</p>
      <p class="warning">Không tự nhịn ăn, tự giảm insulin hoặc áp dụng chế độ keto/giảm cân trong thai kỳ.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("gdm-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-gdm]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký đường huyết, bữa ăn, tăng cân và thuốc khi khám thai.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ sản khoa/nội tiết hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .gdm-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .gdm-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
