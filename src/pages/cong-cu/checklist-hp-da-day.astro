---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist viêm loét dạ dày và H. pylori";
const desc = "Bảng kiểm thuốc, ăn uống và theo dõi an toàn khi viêm loét dạ dày hoặc điều trị H. pylori.";
const items = [
  "Tôi dùng đủ phác đồ diệt H. pylori/thuốc dạ dày đúng giờ và hoàn tất liệu trình",
  "Tôi hỏi dược sĩ về tương tác với sắt, thuốc chống đông, thuốc tiểu đường và thực phẩm bổ sung",
  "Tôi tránh NSAID nếu chưa được bác sĩ cho phép, hạn chế rượu bia, thuốc lá và món gây kích ứng cá nhân",
  "Tôi ăn bữa nhỏ vừa đủ, không nằm ngay sau ăn và duy trì nước uống phù hợp",
  "Tôi làm xét nghiệm xác nhận tiệt trừ đúng thời điểm, không tự kết luận chỉ dựa vào hết đau",
  "Tôi biết dấu hiệu xuất huyết/thủng: nôn máu, phân đen, đau bụng đột ngột, choáng hoặc ngất",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-hp-da-day">
  <main class="ulcer-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🫃 Checklist viêm loét dạ dày và H. pylori</h1>
      <p>{desc} Ăn uống giúp giảm triệu chứng nhưng không thay thế phác đồ tiệt trừ và theo dõi.</p>
    </header>
    <form id="ulcer-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-ulcer /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Đến viện ngay khi</h2>
      <p>Nôn máu, đi ngoài phân đen, đau bụng dữ dội đột ngột, bụng cứng, choáng hoặc ngất.</p>
      <p class="warning">Không tự kéo dài PPI/kháng sinh, tự dùng NSAID hoặc ngừng phác đồ khi đỡ đau.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("ulcer-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-ulcer]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang phác đồ thuốc, triệu chứng và kết quả xét nghiệm H. pylori khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa hoặc dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .ulcer-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .ulcer-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
