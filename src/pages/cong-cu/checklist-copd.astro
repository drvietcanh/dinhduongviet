---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng COPD";
const desc = "Bảng kiểm ăn uống và theo dõi dinh dưỡng cho người bệnh phổi tắc nghẽn mạn tính.";
const items = [
  "Tôi theo dõi cân nặng và khối cơ, không để sụt cân kéo dài",
  "Tôi chia nhỏ bữa, nghỉ trước khi ăn và chọn món dễ nhai để đỡ hụt hơi",
  "Mỗi bữa có nguồn đạm và năng lượng phù hợp, không tự kiêng quá mức",
  "Tôi ngồi thẳng khi ăn, ăn chậm và dùng kỹ thuật thở đã được hướng dẫn",
  "Tôi uống nước theo chỉ định, nhất là khi có suy tim hoặc bệnh thận kèm theo",
  "Tôi biết kế hoạch khi đợt cấp và dấu hiệu cần liên hệ cơ sở y tế",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-copd">
  <main class="copd-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm hô hấp</p>
      <h1>🫁 Checklist dinh dưỡng COPD</h1>
      <p>{desc} Mục tiêu năng lượng, đạm và nước cần cá thể hóa theo mức khó thở và bệnh kèm.</p>
    </header>
    <form id="copd-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-copd /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ sớm khi</h2>
      <p>Khó thở tăng nhanh, tím tái, sốt, lơ mơ, đau ngực, ho ra máu hoặc không thể ăn uống vì hụt hơi.</p>
      <p class="warning">Không tự tăng thuốc giãn phế quản, steroid, oxy hoặc thực phẩm bổ sung để thay thế đánh giá đợt cấp.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("copd-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-copd]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, khó thở và khả năng ăn để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ hô hấp hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .copd-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .copd-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
