---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist kali và phốt pho khi bệnh thận";
const desc = "Bảng kiểm chuẩn bị trao đổi về kali, phốt pho và nhãn thực phẩm khi có bệnh thận.";
const items = [
  "Tôi biết giai đoạn bệnh thận/eGFR gần nhất của mình",
  "Tôi có kết quả kali máu gần đây để trao đổi",
  "Tôi có kết quả phốt pho máu gần đây hoặc biết bác sĩ có yêu cầu theo dõi",
  "Tôi đã hỏi rõ có cần hạn chế kali, phốt pho, muối hay nước hay không",
  "Tôi đọc nhãn thực phẩm và để ý phụ gia chứa chữ 'phosphate/phosphat'",
  "Tôi ghi lại thuốc, thực phẩm bổ sung và sản phẩm thay muối đang dùng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-than-kali-phot-pho">
  <main class="renal-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm an toàn</p>
      <h1>🫘 Checklist kali–phốt pho</h1>
      <p>{desc} Không dùng bảng kiểm này để tự cắt trái cây, sữa, đạm hoặc nước.</p>
    </header>
    <form id="renal-form" class="card">
      <p class="hint">Đánh dấu những thông tin bạn đã có trước lần trao đổi tiếp theo:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-renal /> <span>{item}</span></label>)}
      <button type="submit">Xem phần còn thiếu</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Không tự điều chỉnh theo bảng này</h2>
      <p>Kali và phốt pho có thể cần hạn chế, giữ nguyên hoặc bổ sung tùy giai đoạn bệnh, lọc máu, thuốc và xét nghiệm. Người có yếu cơ, hồi hộp, khó thở, lú lẫn hoặc nôn kéo dài cần liên hệ cơ sở y tế.</p>
      <p class="warning">Không tự dùng chất kết dính phốt pho, viên kali hoặc muối thay thế nếu chưa được kê/hướng dẫn.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("renal-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-renal]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã chuẩn bị đủ 6 mục</h2><p>Hãy vẫn mang danh sách thuốc và xét nghiệm thực tế đến buổi khám.</p>`
        : `<h2>Còn ${missing} mục nên chuẩn bị</h2><p>Ưu tiên hỏi bác sĩ/dinh dưỡng viên về mục còn thiếu; không suy ra mục tiêu kali hoặc phốt pho chỉ từ tên bệnh.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .renal-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .renal-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
