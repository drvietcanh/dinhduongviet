---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist đợt cấp viêm ruột";
const desc = "Bảng kiểm ăn uống và theo dõi khi viêm loét đại tràng hoặc Crohn bùng phát.";
const items = [
  "Tôi ghi số lần đi ngoài, máu trong phân, đau bụng, sốt, cân nặng và lượng uống",
  "Tôi bù dịch–điện giải từng ngụm theo hướng dẫn, không chỉ uống nước lọc khi tiêu chảy nhiều",
  "Tôi chia nhỏ bữa, chọn món dễ tiêu và tạm điều chỉnh chất xơ/chất béo theo triệu chứng",
  "Tôi vẫn cố duy trì năng lượng và đạm phù hợp, không tự nhịn ăn kéo dài",
  "Tôi dùng thuốc IBD đúng đơn và báo bác sĩ trước khi dùng NSAID, thuốc cầm tiêu chảy hoặc thảo dược",
  "Tôi biết dấu hiệu nặng: đau/chướng tăng, sốt, tim nhanh, tiểu ít, nôn hoặc đi ngoài máu nhiều",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ibd-dot-cap">
  <main class="ibd-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🧻 Checklist đợt cấp viêm ruột</h1>
      <p>{desc} Mức độ bùng phát cần được bác sĩ đánh giá; bảng kiểm không thay thế điều trị.</p>
    </header>
    <form id="ibd-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-ibd /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám ngay khi</h2>
      <p>Đau bụng dữ dội/chướng nhanh, sốt cao, tim nhanh, choáng, tiểu ít, nôn liên tục hoặc đi ngoài máu nhiều.</p>
      <p class="warning">Không tự dùng thuốc chống viêm NSAID, corticoid, kháng sinh hoặc thuốc cầm tiêu chảy để “cắt cơn”.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("ibd-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-ibd]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký phân, ăn uống, thuốc và cân nặng khi liên hệ đội tiêu hóa.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .ibd-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .ibd-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
