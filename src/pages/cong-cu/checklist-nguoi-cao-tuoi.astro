---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng người cao tuổi";
const desc = "Bảng kiểm chán ăn, sụt cân và nguy cơ giảm cơ ở người cao tuổi.";
const items = [
  "Tôi theo dõi cân nặng và lượng ăn theo tuần, không đợi đến khi sụt cân nhiều",
  "Mỗi bữa có nguồn đạm dễ ăn và đủ năng lượng theo bệnh nền",
  "Tôi chia nhỏ bữa, tăng mật độ dinh dưỡng thay vì ép ăn một bữa lớn",
  "Răng giả, đau miệng, khô miệng và khả năng nhai/nuốt đã được kiểm tra",
  "Tôi rà soát thuốc gây buồn nôn, khô miệng, táo bón hoặc mất vị giác",
  "Có vận động sức mạnh và thăng bằng phù hợp, kèm người hỗ trợ khi cần",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-nguoi-cao-tuoi">
  <main class="elderly-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm lão khoa</p>
      <h1>👵 Checklist dinh dưỡng người cao tuổi</h1>
      <p>{desc} Cần tìm nguyên nhân y khoa khi chán ăn hoặc sụt cân kéo dài.</p>
    </header>
    <form id="elderly-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-elderly /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Nên khám sớm khi</h2>
      <p>Sụt cân không chủ ý, yếu cơ/teo cơ, nuốt khó, lú lẫn, trầm cảm, nôn kéo dài, tiêu chảy hoặc không ăn uống được.</p>
      <p class="warning">Không tự ép ăn, dùng thuốc kích thích ăn hoặc sản phẩm tăng cơ khi chưa đánh giá nguyên nhân.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("elderly-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-elderly]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, lượng ăn và khả năng vận động để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ và hỏi bác sĩ/dinh dưỡng viên về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .elderly-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .elderly-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
