---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Bộ đổi đơn vị dinh dưỡng - Dinh dưỡng Việt">
  <section>
    <span class="badge">🔄 Công cụ</span>
    <h1>Bộ đổi đơn vị</h1>
    <p class="lead">
      Quy đổi đơn vị đo lường thường gặp ở mức tham khảo, có ghi chú khi giả định quy đổi có thể thay đổi theo dụng cụ và cách đo.
    </p>
  </section>

  <div class="safety-shell">
    <p><strong>Lưu ý:</strong> Đây là công cụ quy đổi đơn vị tham khảo, không dùng để kết luận khẩu phần phù hợp, lượng ăn an toàn, hay mục tiêu điều trị cá nhân.</p>
    <p>Kết quả có thể thay đổi theo loại thực phẩm, cách cắt hoặc nấu, và độ đầy của muỗng, cốc, chén hoặc ly. Khi cần độ chính xác cao, hãy kiểm tra nhãn sản phẩm hoặc cân thực tế.</p>
    <p>Người có bệnh nền, đang dùng thuốc, thai kỳ, trẻ em hoặc cần chế độ ăn điều trị nên hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi dùng kết quả để lên kế hoạch ăn uống.</p>
  </div>

  <section class="section card">
    <h2>🔁 Chọn bộ chuyển đổi</h2>
    <div class="converter-tabs" id="converter-tabs">
      <button class="cv-tab active" data-cv="weight">⚖️ Khối lượng</button>
      <button class="cv-tab" data-cv="energy">🔥 Năng lượng</button>
      <button class="cv-tab" data-cv="volume">🧪 Thể tích</button>
      <button class="cv-tab" data-cv="length">📏 Chiều dài</button>
      <button class="cv-tab" data-cv="temp">🌡️ Nhiệt độ</button>
    </div>

    <!-- Khối lượng -->
    <div class="cv-panel active" id="panel-weight">
      <h3>⚖️ Khối lượng</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="text" inputmode="decimal" class="cv-input" data-panel="weight" id="w-val" value="100" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="weight" id="w-from">
            <option value="g">Gram (g)</option>
            <option value="kg">Kilogram (kg)</option>
            <option value="mg">Miligram (mg)</option>
            <option value="oz">Ounce (oz)</option>
            <option value="lb">Pound (lb)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="weight" id="w-to">
            <option value="kg">Kilogram (kg)</option>
            <option value="g" selected>Gram (g)</option>
            <option value="mg">Miligram (mg)</option>
            <option value="oz">Ounce (oz)</option>
            <option value="lb">Pound (lb)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="w-result">0.1 kg</strong>
          <span class="cv-hint" id="w-hint" aria-live="polite">Quy đổi tham khảo giữa các đơn vị khối lượng.</span>
        </div>
      </div>
    </div>

    <!-- Năng lượng -->
    <div class="cv-panel" id="panel-energy">
      <h3>🔥 Năng lượng</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="text" inputmode="decimal" class="cv-input" data-panel="energy" id="e-val" value="100" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="energy" id="e-from">
            <option value="kcal">Kilocalorie (kcal)</option>
            <option value="kJ">Kilojoule (kJ)</option>
            <option value="cal">Calorie (cal)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="energy" id="e-to">
            <option value="kJ" selected>Kilojoule (kJ)</option>
            <option value="kcal">Kilocalorie (kcal)</option>
            <option value="cal">Calorie (cal)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="e-result">418.4 kJ</strong>
          <span class="cv-hint" id="e-hint" aria-live="polite">Quy đổi tham khảo giữa các đơn vị năng lượng.</span>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 kcal = 4.184 kJ. Trên nhãn thực phẩm: 1 kcal = 1 Calorie (viết hoa C).</p>
    </div>

    <!-- Thể tích -->
    <div class="cv-panel" id="panel-volume">
      <h3>🧪 Thể tích</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="text" inputmode="decimal" class="cv-input" data-panel="volume" id="v-val" value="1" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="volume" id="v-from">
            <option value="ml">Mililit (ml)</option>
            <option value="l">Lít (L)</option>
            <option value="cup">Cup (240ml)</option>
            <option value="tbsp">Tablespoon (15ml)</option>
            <option value="tsp">Teaspoon (5ml)</option>
            <option value="floz">Fluid ounce (29.57ml)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="volume" id="v-to">
            <option value="cup" selected>Cup (240ml)</option>
            <option value="ml">Mililit (ml)</option>
            <option value="l">Lít (L)</option>
            <option value="tbsp">Tablespoon (15ml)</option>
            <option value="tsp">Teaspoon (5ml)</option>
            <option value="floz">Fluid ounce (29.57ml)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="v-result">4.17 cups</strong>
          <span class="cv-hint" id="v-hint" aria-live="polite">Quy đổi tham khảo theo giả định thể tích chuẩn.</span>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 cup = 240 ml (chuẩn Mỹ). 1 tbsp = 15 ml, 1 tsp = 5 ml. Không mặc định 1 ml = 1 g cho mọi thực phẩm.</p>
    </div>

    <!-- Chiều dài -->
    <div class="cv-panel" id="panel-length">
      <h3>📏 Chiều dài</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="text" inputmode="decimal" class="cv-input" data-panel="length" id="l-val" value="170" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="length" id="l-from">
            <option value="cm">Centimet (cm)</option>
            <option value="m">Mét (m)</option>
            <option value="in">Inch (in)</option>
            <option value="ft">Feet (ft)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="length" id="l-to">
            <option value="in" selected>Inch (in)</option>
            <option value="cm">Centimet (cm)</option>
            <option value="m">Mét (m)</option>
            <option value="ft">Feet (ft)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="l-result">66.93 in</strong>
          <span class="cv-hint" id="l-hint" aria-live="polite">Quy đổi tham khảo giữa các đơn vị chiều dài.</span>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 m = 100 cm = 39.37 in = 3.28 ft. Đồ dùng trong nấu ăn (nồi, chảo) hay tính bằng cm.</p>
    </div>

    <!-- Nhiệt độ -->
    <div class="cv-panel" id="panel-temp">
      <h3>🌡️ Nhiệt độ</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="text" inputmode="decimal" class="cv-input" data-panel="temp" id="t-val" value="180" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="temp" id="t-from">
            <option value="c">°C (Celsius)</option>
            <option value="f">°F (Fahrenheit)</option>
            <option value="k">K (Kelvin)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="temp" id="t-to">
            <option value="f" selected>°F (Fahrenheit)</option>
            <option value="c">°C (Celsius)</option>
            <option value="k">K (Kelvin)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="t-result">356 °F</strong>
          <span class="cv-hint" id="t-hint" aria-live="polite">Quy đổi tham khảo giữa các thang nhiệt độ.</span>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 Lò nướng: 180°C = 356°F (gas mark 4). Công thức °F = °C × 9/5 + 32.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .converter-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .safety-shell {
    margin: 18px 0 20px;
    padding: 14px 16px;
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: var(--radius-lg);
    background: rgba(59, 130, 246, 0.05);
    color: var(--ink);
  }
  .safety-shell p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .safety-shell p + p { margin-top: 8px; }
  .cv-tab {
    padding: 8px 16px; border: 1px solid var(--card-border); border-radius: var(--radius);
    background: var(--card); cursor: pointer; font-size: 0.9rem; transition: all var(--transition);
  }
  .cv-tab:hover { background: var(--bg-soft); transform: translateY(-1px); }
  .cv-tab.active { background: var(--brand); color: #fff; border-color: var(--brand); }
  .cv-panel { display: none; }
  .cv-panel.active { display: block; }

  label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.9rem; }
  input, select {
    width: 100%; padding: 10px 12px; border: 1px solid var(--card-border);
    border-radius: var(--radius); font-size: 0.95rem; background: var(--card); box-sizing: border-box;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  input:focus, select:focus {
    outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
  }
  .cv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .cv-result strong {
    display: block;
    font-size: 1.6rem;
    padding: 8px 0;
    color: var(--brand);
  }
  .cv-hint {
    display: block;
    min-height: 2.8em;
    font-size: 0.82rem;
    color: var(--ink-secondary);
    line-height: 1.45;
  }
</style>

<script>
  const conv = {
    weight: {
      mg: 0.001, g: 1, kg: 1000, oz: 28.3495, lb: 453.592
    },
    energy: {
      cal: 1, kcal: 1000, kJ: 239.0057
    },
    volume: {
      ml: 1, l: 1000, cup: 240, tbsp: 15, tsp: 5, floz: 29.5735
    },
    length: {
      cm: 1, m: 100, in: 2.54, ft: 30.48
    },
    temp: {
      c: { toBase: v => v, fromBase: v => v },
      f: { toBase: v => (v - 32) * 5/9, fromBase: v => v * 9/5 + 32 },
      k: { toBase: v => v - 273.15, fromBase: v => v + 273.15 }
    }
  };

  const panels = ['weight', 'energy', 'volume', 'length', 'temp'];
  const panelName = { weight:'w', energy:'e', volume:'v', length:'l', temp:'t' };
  const maxAbs = 1e9;

  function parseLocalizedNumber(raw) {
    if (typeof raw !== 'string') return Number.NaN;
    const normalized = raw.trim().replace(',', '.');
    if (!normalized) return Number.NaN;
    const value = Number.parseFloat(normalized);
    return Number.isFinite(value) ? value : Number.NaN;
  }

  // Tabs
  document.querySelectorAll('.cv-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.cv-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.cv-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-' + tab.dataset.cv).classList.add('active');
    });
  });

  // Converters
  panels.forEach(p => {
    const prefix = panelName[p];
    const valEl = document.getElementById(prefix + '-val');
    const fromEl = document.getElementById(prefix + '-from');
    const toEl = document.getElementById(prefix + '-to');
    const resEl = document.getElementById(prefix + '-result');
    const hintEl = document.getElementById(prefix + '-hint');

    function update() {
      const val = parseLocalizedNumber(valEl.value);
      if (Number.isNaN(val)) {
        resEl.textContent = '—';
        hintEl.textContent = 'Nhập một số hợp lệ, ví dụ 1.5 hoặc 1,5.';
        return;
      }
      if (Math.abs(val) > maxAbs) {
        resEl.textContent = '—';
        hintEl.textContent = 'Giá trị quá lớn để quy đổi tham khảo trên màn hình này.';
        return;
      }
      if (p !== 'temp' && val < 0) {
        resEl.textContent = '—';
        hintEl.textContent = 'Vui lòng nhập số không âm cho bộ quy đổi này.';
        return;
      }

      if (p === 'temp') {
        const from = fromEl.value;
        const to = toEl.value;
        const inC = conv.temp[from].toBase(val);
        const out = conv.temp[to].fromBase(inC);
        resEl.textContent = out.toFixed(1) + ' °' + to.toUpperCase();
        hintEl.textContent = 'Quy đổi tham khảo giữa các thang nhiệt độ.';
      } else {
        const factor = conv[p][fromEl.value] / conv[p][toEl.value];
        const out = val * factor;
        const decimals = out < 0.01 ? 4 : out < 1 ? 3 : out < 100 ? 2 : 1;
        resEl.textContent = out.toFixed(decimals) + ' ' + toEl.value;
        if (p === 'volume') {
          hintEl.textContent = 'Quy đổi tham khảo theo giả định thể tích chuẩn; không áp dụng như nhau cho mọi thực phẩm.';
        } else {
          hintEl.textContent = 'Quy đổi tham khảo giữa các đơn vị cùng loại.';
        }
      }
    }

    valEl.addEventListener('input', update);
    fromEl.addEventListener('change', update);
    toEl.addEventListener('change', update);
    update(); // Init
  });
</script>
