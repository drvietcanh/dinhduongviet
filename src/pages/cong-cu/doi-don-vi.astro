---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Bộ đổi đơn vị dinh dưỡng - Dinh Dưỡng Việt">
  <section>
    <span class="badge">🔄 Công cụ</span>
    <h1>Bộ đổi đơn vị</h1>
    <p class="lead">
      Chuyển đổi nhanh giữa các đơn vị đo lường thường gặp trong dinh dưỡng và nấu ăn.
    </p>
  </section>

  <section class="section card">
    <h2>🔁 Chọn bộ chuyển đổi</h2>
    <div class="converter-tabs" id="converter-tabs">
      <button class="cv-tab active" data-cv="weight">⚖️ Khối lượng</button>
      <button class="cv-tab" data-cv="energy">🔥 Năng lượng</button>
      <button class="cv-tab" data-cv="volume">🧪 Thể tích</button>
      <button class="cv-tab" data-cv="length">📏 Chiều dài</button>
      <button class="cv-tab" data-cv="temp">🌡️ Nhiệt độ</button>
    </div>

    <!-- Khối lượng -->
    <div class="cv-panel active" id="panel-weight">
      <h3>⚖️ Khối lượng</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="number" class="cv-input" data-panel="weight" id="w-val" value="100" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="weight" id="w-from">
            <option value="g">Gram (g)</option>
            <option value="kg">Kilogram (kg)</option>
            <option value="mg">Miligram (mg)</option>
            <option value="oz">Ounce (oz)</option>
            <option value="lb">Pound (lb)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="weight" id="w-to">
            <option value="kg">Kilogram (kg)</option>
            <option value="g" selected>Gram (g)</option>
            <option value="mg">Miligram (mg)</option>
            <option value="oz">Ounce (oz)</option>
            <option value="lb">Pound (lb)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="w-result">0.1 kg</strong>
        </div>
      </div>
    </div>

    <!-- Năng lượng -->
    <div class="cv-panel" id="panel-energy">
      <h3>🔥 Năng lượng</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="number" class="cv-input" data-panel="energy" id="e-val" value="100" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="energy" id="e-from">
            <option value="kcal">Kilocalorie (kcal)</option>
            <option value="kJ">Kilojoule (kJ)</option>
            <option value="cal">Calorie (cal)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="energy" id="e-to">
            <option value="kJ" selected>Kilojoule (kJ)</option>
            <option value="kcal">Kilocalorie (kcal)</option>
            <option value="cal">Calorie (cal)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="e-result">418.4 kJ</strong>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 kcal = 4.184 kJ. Trên nhãn thực phẩm: 1 kcal = 1 Calorie (viết hoa C).</p>
    </div>

    <!-- Thể tích -->
    <div class="cv-panel" id="panel-volume">
      <h3>🧪 Thể tích</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="number" class="cv-input" data-panel="volume" id="v-val" value="1" step="0.1" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="volume" id="v-from">
            <option value="ml">Mililit (ml)</option>
            <option value="l">Lít (L)</option>
            <option value="cup">Cup (240ml)</option>
            <option value="tbsp">Tablespoon (15ml)</option>
            <option value="tsp">Teaspoon (5ml)</option>
            <option value="floz">Fluid ounce (29.57ml)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="volume" id="v-to">
            <option value="cup" selected>Cup (240ml)</option>
            <option value="ml">Mililit (ml)</option>
            <option value="l">Lít (L)</option>
            <option value="tbsp">Tablespoon (15ml)</option>
            <option value="tsp">Teaspoon (5ml)</option>
            <option value="floz">Fluid ounce (29.57ml)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="v-result">4.17 cups</strong>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 cup = 240 ml (chuẩn Mỹ). 1 tbsp = 15 ml, 1 tsp = 5 ml.</p>
    </div>

    <!-- Chiều dài -->
    <div class="cv-panel" id="panel-length">
      <h3>📏 Chiều dài</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="number" class="cv-input" data-panel="length" id="l-val" value="170" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="length" id="l-from">
            <option value="cm">Centimet (cm)</option>
            <option value="m">Mét (m)</option>
            <option value="in">Inch (in)</option>
            <option value="ft">Feet (ft)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="length" id="l-to">
            <option value="in" selected>Inch (in)</option>
            <option value="cm">Centimet (cm)</option>
            <option value="m">Mét (m)</option>
            <option value="ft">Feet (ft)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="l-result">66.93 in</strong>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 1 m = 100 cm = 39.37 in = 3.28 ft. Đồ dùng trong nấu ăn (nồi, chảo) hay tính bằng cm.</p>
    </div>

    <!-- Nhiệt độ -->
    <div class="cv-panel" id="panel-temp">
      <h3>🌡️ Nhiệt độ</h3>
      <div class="cv-grid">
        <div><label>Giá trị</label><input type="number" class="cv-input" data-panel="temp" id="t-val" value="180" /></div>
        <div>
          <label>Từ</label>
          <select class="cv-from" data-panel="temp" id="t-from">
            <option value="c">°C (Celsius)</option>
            <option value="f">°F (Fahrenheit)</option>
            <option value="k">K (Kelvin)</option>
          </select>
        </div>
        <div>
          <label>Sang</label>
          <select class="cv-to" data-panel="temp" id="t-to">
            <option value="f" selected>°F (Fahrenheit)</option>
            <option value="c">°C (Celsius)</option>
            <option value="k">K (Kelvin)</option>
          </select>
        </div>
        <div class="cv-result">
          <label>Kết quả</label>
          <strong id="t-result">356 °F</strong>
        </div>
      </div>
      <p class="muted" style="margin-top: 8px;">💡 Lò nướng: 180°C = 356°F (gas mark 4). Công thức °F = °C × 9/5 + 32.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .converter-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .cv-tab {
    padding: 8px 16px; border: 1px solid var(--line); border-radius: 8px;
    background: var(--card); cursor: pointer; font-size: 0.9rem; transition: all 0.15s;
  }
  .cv-tab:hover { background: var(--line-light); }
  .cv-tab.active { background: var(--brand); color: #fff; border-color: var(--brand); }
  .cv-panel { display: none; }
  .cv-panel.active { display: block; }

  label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.9rem; }
  input, select {
    width: 100%; padding: 10px 12px; border: 1px solid var(--line);
    border-radius: 8px; font-size: 0.95rem; background: var(--card); box-sizing: border-box;
  }
  .cv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .cv-result strong {
    display: block;
    font-size: 1.6rem;
    padding: 8px 0;
    color: var(--brand);
  }
</style>

<script>
  const conv = {
    weight: {
      mg: 0.001, g: 1, kg: 1000, oz: 28.3495, lb: 453.592
    },
    energy: {
      cal: 1, kcal: 1000, kJ: 239.0057
    },
    volume: {
      ml: 1, l: 1000, cup: 240, tbsp: 15, tsp: 5, floz: 29.5735
    },
    length: {
      cm: 1, m: 100, in: 2.54, ft: 30.48
    },
    temp: {
      c: { toBase: v => v, fromBase: v => v },
      f: { toBase: v => (v - 32) * 5/9, fromBase: v => v * 9/5 + 32 },
      k: { toBase: v => v - 273.15, fromBase: v => v + 273.15 }
    }
  };

  const panels = ['weight', 'energy', 'volume', 'length', 'temp'];
  const panelName = { weight:'w', energy:'e', volume:'v', length:'l', temp:'t' };

  // Tabs
  document.querySelectorAll('.cv-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.cv-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.cv-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-' + tab.dataset.cv).classList.add('active');
    });
  });

  // Converters
  panels.forEach(p => {
    const prefix = panelName[p];
    const valEl = document.getElementById(prefix + '-val');
    const fromEl = document.getElementById(prefix + '-from');
    const toEl = document.getElementById(prefix + '-to');
    const resEl = document.getElementById(prefix + '-result');

    function update() {
      const val = parseFloat(valEl.value);
      if (isNaN(val)) { resEl.textContent = '—'; return; }

      if (p === 'temp') {
        const from = fromEl.value;
        const to = toEl.value;
        const inC = conv.temp[from].toBase(val);
        const out = conv.temp[to].fromBase(inC);
        resEl.textContent = out.toFixed(1) + ' °' + to.toUpperCase();
      } else {
        const factor = conv[p][fromEl.value] / conv[p][toEl.value];
        const out = val * factor;
        const decimals = out < 0.01 ? 4 : out < 1 ? 3 : out < 100 ? 2 : 1;
        resEl.textContent = out.toFixed(decimals) + ' ' + toEl.value;
      }
    }

    valEl.addEventListener('input', update);
    fromEl.addEventListener('change', update);
    toEl.addEventListener('change', update);
    update(); // Init
  });
</script>
