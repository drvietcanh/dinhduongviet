---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist nhắc việc ăn uống hôm nay - Dinh Dưỡng Việt";
const desc = "Checklist nhắc việc ăn uống ở mức tham khảo, không dùng để kết luận khẩu phần đạt hay chưa đạt.";

const checklistItems = [
  {
    id: "q1",
    label: "Rau xanh",
    question: "Hôm nay tôi đã ghi nhận rau xanh trong bữa ăn.",
    note: "Ghi chú tham khảo: lượng rau thực tế có thể thay đổi theo món, cách nấu và khẩu phần từng người.",
  },
  {
    id: "q2",
    label: "Trái cây",
    question: "Hôm nay tôi đã ghi nhận một phần trái cây.",
    note: "Ghi chú tham khảo: người cần kiểm soát đường hoặc có chế độ ăn điều trị nên hỏi chuyên gia trước khi tự đặt giới hạn riêng.",
  },
  {
    id: "q3",
    label: "Nước uống",
    question: "Hôm nay tôi đã ghi nhận việc uống nước trong ngày.",
    note: "Ghi chú tham khảo: nhu cầu nước có thể khác nhau theo thời tiết, vận động, bệnh nền và thuốc đang dùng.",
  },
  {
    id: "q4",
    label: "Nguồn đạm",
    question: "Hôm nay tôi đã ghi nhận một nguồn đạm như thịt, cá, trứng, sữa, đậu hoặc lựa chọn tương tự.",
    note: "Ghi chú tham khảo: lượng đạm cần cá thể hóa nếu có bệnh thận, gout, thai kỳ, trẻ em hoặc chế độ ăn điều trị.",
  },
  {
    id: "q5",
    label: "Tinh bột",
    question: "Hôm nay tôi đã ghi nhận món có tinh bột như cơm, bún, phở, bánh mì hoặc món tương tự.",
    note: "Ghi chú tham khảo: checklist này không tính khẩu phần tinh bột hoặc mục tiêu carb cá nhân.",
  },
  {
    id: "q6",
    label: "Đồ uống có đường",
    question: "Hôm nay tôi đã ghi nhận tình trạng dùng đồ uống có đường.",
    note: "Ghi chú tham khảo: mục này chỉ để tự nhắc việc, không đánh giá kiểm soát đường huyết.",
    options: [
      { value: "khong", label: "Không dùng" },
      { value: "co", label: "Có dùng" },
      { value: "khong_ro", label: "Chưa ghi rõ" },
    ],
  },
  {
    id: "q7",
    label: "Rượu bia",
    question: "Hôm nay tôi đã ghi nhận tình trạng dùng rượu bia.",
    note: "Ghi chú tham khảo: người đang dùng thuốc, có bệnh nền hoặc cần chế độ ăn điều trị nên hỏi bác sĩ/chuyên gia.",
    options: [
      { value: "khong", label: "Không dùng" },
      { value: "co", label: "Có dùng" },
      { value: "khong_ro", label: "Chưa ghi rõ" },
    ],
  },
];
---

<BaseLayout title={title} description={desc} image="/logo.svg">
  <style>
    .checklist-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0;
    }
    .eyebrow {
      display: inline-block;
      margin-bottom: 12px;
      padding: 5px 12px;
      border-radius: 999px;
      background: var(--brand-light);
      color: var(--brand);
      font-size: 0.82rem;
      font-weight: 700;
    }
    h1 {
      margin: 0 0 10px;
      font-size: clamp(1.5rem, 4vw, 2rem);
      line-height: 1.2;
    }
    .lead {
      margin: 0 0 18px;
      color: var(--ink-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }
    .safety-shell {
      margin: 0 0 20px;
      padding: 14px 16px;
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-lg);
      background: rgba(59, 130, 246, 0.05);
      color: var(--ink);
    }
    .safety-shell p {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .safety-shell p + p { margin-top: 8px; }
    .checklist-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .check-item {
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }
    .check-item h2 {
      margin: 0 0 6px;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.35;
    }
    .check-item p {
      margin: 0 0 12px;
      color: var(--ink-secondary);
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .options {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .options label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 40px;
      padding: 7px 14px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      background: var(--bg-soft);
      cursor: pointer;
      font-size: 0.9rem;
      transition: all var(--transition);
    }
    .options label:hover {
      border-color: var(--brand);
      background: var(--brand-light);
      color: var(--brand);
    }
    .note {
      display: none;
      margin-top: 12px;
      padding: 10px 12px;
      border-radius: var(--radius);
      background: var(--bg-soft);
      color: var(--ink-secondary);
      font-size: 0.86rem;
      line-height: 1.5;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }
    .primary-action,
    .secondary-action {
      min-height: 44px;
      padding: 10px 18px;
      border-radius: var(--radius);
      border: 1px solid var(--brand);
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      transition: all var(--transition);
    }
    .primary-action {
      background: var(--brand);
      color: white;
    }
    .primary-action:hover {
      background: var(--brand-dark);
      border-color: var(--brand-dark);
      transform: translateY(-1px);
    }
    .primary-action:active {
      transform: translateY(0);
    }
    .secondary-action {
      background: var(--card);
      color: var(--brand);
    }
    .secondary-action:hover {
      background: var(--brand-light);
      transform: translateY(-1px);
    }
    .secondary-action:active {
      transform: translateY(0);
    }
    .result {
      display: none;
      margin-top: 22px;
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }
    .result h2 {
      margin: 0 0 8px;
      color: var(--ink);
      font-size: 1.08rem;
    }
    .result p {
      margin: 0;
      color: var(--ink-secondary);
      line-height: 1.55;
    }
    .result-list {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 8px;
    }
    .result-list li {
      padding: 10px 12px;
      border-radius: var(--radius);
      background: var(--bg-soft);
      color: var(--ink-secondary);
      overflow-wrap: anywhere;
    }
    @media (max-width: 600px) {
      .checklist-page,
      .safety-shell,
      .check-item,
      .result { min-width: 0; max-width: 100%; }
      .options { flex-direction: column; }
      .options label,
      .primary-action,
      .secondary-action { width: 100%; justify-content: center; }
      h1,
      .lead,
      .safety-shell p,
      .check-item h2,
      .check-item p { overflow-wrap: anywhere; }
    }
  </style>

  <main class="checklist-page">
    <span class="eyebrow">Checklist nhắc việc</span>
    <h1>Checklist ăn uống hôm nay</h1>
    <p class="lead">
      Đánh dấu các mục bạn muốn tự ghi nhận trong ngày. Công cụ chỉ tổng hợp số mục đã đánh dấu, không chấm điểm sức khỏe và không kết luận khẩu phần đạt hay chưa đạt.
    </p>

    <div class="safety-shell">
      <p><strong>Lưu ý:</strong> Checklist này chỉ để tự nhắc việc ở mức tham khảo, không dùng để tự chẩn đoán hoặc tự điều chỉnh chế độ điều trị.</p>
      <p>Người có bệnh nền, đang dùng thuốc, thai kỳ, trẻ em hoặc cần chế độ ăn điều trị nên hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi tự đặt mục tiêu ăn uống riêng.</p>
    </div>

    <form id="checklist-form" class="checklist-form">
      {checklistItems.map((item, index) => (
        <section class="check-item" data-item={item.id}>
          <h2>{index + 1}. {item.label}</h2>
          <p>{item.question}</p>
          <div class="options">
            {(item.options || [
              { value: "co", label: "Đã đánh dấu" },
              { value: "chua", label: "Chưa đánh dấu" },
            ]).map((option) => (
              <label>
                <input type="radio" name={item.id} value={option.value} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
          <div class="note">{item.note}</div>
        </section>
      ))}

      <div class="actions">
        <button class="primary-action" type="submit">Xem mục đã đánh dấu</button>
        <button class="secondary-action" type="reset">Đặt lại checklist</button>
      </div>
    </form>

    <section id="result" class="result" aria-live="polite"></section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ checklistItems }}>
  const form = document.getElementById("checklist-form");
  const result = document.getElementById("result");

  function createNode(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function showItemNote(input) {
    const item = input.closest(".check-item");
    const note = item?.querySelector(".note");
    if (note) note.style.display = "block";
  }

  function renderResult(formData) {
    const selectedItems = [];
    const unselectedItems = [];

    checklistItems.forEach((item) => {
      const value = formData.get(item.id);
      if (value && value !== "chua" && value !== "khong_ro") {
        selectedItems.push(item.label);
      } else {
        unselectedItems.push(item.label);
      }
    });

    const heading = createNode("h2", "", "Tổng hợp checklist");
    const summary = createNode(
      "p",
      "",
      `Bạn đã đánh dấu ${selectedItems.length}/${checklistItems.length} mục. Đây là tổng hợp nhắc việc, không phải điểm sức khỏe hoặc kết luận khẩu phần.`
    );

    const list = createNode("ul", "result-list");
    checklistItems.forEach((item) => {
      const value = formData.get(item.id);
      const label = value && value !== "chua" && value !== "khong_ro" ? "Mục đã đánh dấu" : "Mục chưa đánh dấu";
      list.appendChild(createNode("li", "", `${item.label}: ${label}`));
    });

    const safety = createNode(
      "p",
      "",
      "Nếu bạn cần chế độ ăn điều trị hoặc đang dùng thuốc, hãy trao đổi với bác sĩ hoặc chuyên gia dinh dưỡng trước khi thay đổi kế hoạch ăn uống."
    );
    safety.style.marginTop = "14px";

    result.replaceChildren(heading, summary, list, safety);
    result.style.display = "block";
    result.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    renderResult(new FormData(form));
  });

  form.addEventListener("reset", () => {
    result.replaceChildren();
    result.style.display = "none";
    form.querySelectorAll(".note").forEach((note) => {
      note.style.display = "none";
    });
  });

  form.querySelectorAll('input[type="radio"]').forEach((input) => {
    input.addEventListener("change", () => showItemNote(input));
  });
</script>
