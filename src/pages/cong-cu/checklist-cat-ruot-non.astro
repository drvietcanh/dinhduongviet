---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau cắt ruột non";
const desc = "Bảng kiểm ăn uống và theo dõi kém hấp thu sau phẫu thuật cắt ruột non.";
const items = [
  "Tôi ghi số lần đi ngoài, tính chất phân, cân nặng và lượng nước tiểu mỗi ngày",
  "Tôi chia thành nhiều bữa nhỏ, ăn chậm và điều chỉnh chất béo/chất xơ theo hướng dẫn",
  "Tôi bù dịch và điện giải đúng dung dịch được khuyên, không chỉ uống nước lọc khi tiêu chảy nhiều",
  "Tôi dùng vitamin, khoáng chất hoặc thuốc giảm tiêu chảy đúng đơn và tái xét nghiệm đúng lịch",
  "Tôi nhận biết thực phẩm làm đầy bụng, tiêu chảy hoặc đau quặn để trao đổi khi tái khám",
  "Tôi báo sớm khi khát nhiều, chóng mặt, tiểu ít, sốt, đau bụng tăng hoặc sụt cân tiếp tục",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-cat-ruot-non">
  <main class="bowel-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa – hậu phẫu</p>
      <h1>🩺 Checklist dinh dưỡng sau cắt ruột non</h1>
      <p>{desc} Khả năng hấp thu thay đổi theo đoạn ruột còn lại, cần kế hoạch riêng từ đội phẫu thuật và dinh dưỡng.</p>
    </header>
    <form id="bowel-form" class="card">
      <p class="hint">Đánh dấu những việc đã thực hiện:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-bowel /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế sớm khi</h2>
      <p>Tiêu chảy nhiều, nôn, khát dữ dội, chóng mặt, tiểu ít, sốt, đau bụng tăng hoặc không uống được.</p>
      <p class="warning">Không tự nhịn ăn, tự dùng thuốc cầm tiêu chảy kéo dài hoặc tự truyền dịch tại nhà.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("bowel-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-bowel]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký phân, dịch uống, cân nặng và thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa/phẫu thuật hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .bowel-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .bowel-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
