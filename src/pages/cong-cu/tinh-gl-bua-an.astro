---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { foods, recipes } from "../../data/nutrition";
import { findGlycemicIndexMapping } from "../../data/glycemic-index";
import { calculateRecipe } from "../../lib/nutrition";
import { GL_CLINICAL_CONTEXT_NOTE, GL_GLOBAL_SAFETY_NOTE, GL_TOTAL_CARB_NOTE } from "../../lib/glycemic-load-calculator";

const title = "Tính GL (tải lượng đường huyết) bữa ăn";
const desc = "Ước tính glycemic load dựa trên GI và tổng carbohydrate của khẩu phần, dùng cho giáo dục dinh dưỡng.";

function groupFor(category: string, name: string) {
  const text = `${category} ${name}`.toLowerCase();
  if (text.includes("đồ uống") || text.includes("sữa") || text.includes("trà") || text.includes("cà phê") || text.includes("bia")) return "do-uong";
  if (text.includes("trái cây") || text.includes("quả")) return "trai-cay";
  if (text.includes("bánh") || text.includes("chè") || text.includes("kẹo") || text.includes("đường")) return "banh-keo";
  if (text.includes("tinh bột") || text.includes("gạo") || text.includes("cơm") || text.includes("bún") || text.includes("phở") || text.includes("miến") || text.includes("khoai") || text.includes("ngô") || text.includes("bắp")) return "tinh-bot";
  return "khac";
}

function iconFor(group: string, type: "food" | "recipe") {
  if (type === "recipe") return "🍲";
  if (group === "tinh-bot") return "🍚";
  if (group === "trai-cay") return "🍎";
  if (group === "do-uong") return "🥛";
  if (group === "banh-keo") return "🍪";
  return "🥗";
}

function giPayload(slug: string, name: string) {
  const mapping = findGlycemicIndexMapping(slug, name);
  if (!mapping) {
    return {
      gi: null,
      giCategory: null,
      matchQuality: "no_gi" as const,
      sourceLabel: "",
      sourceUrl: "",
      note: "Chưa có GI phù hợp trong bảng curated v1.",
    };
  }

  return {
    gi: mapping.gi,
    giCategory: mapping.giCategory,
    matchQuality: mapping.matchQuality,
    sourceLabel: mapping.sourceLabel,
    sourceUrl: mapping.sourceUrl ?? "",
    note: mapping.note,
    appliesTo: mapping.appliesTo,
    notFor: mapping.notFor,
  };
}

const foodOptions = foods.map((food) => {
  const group = groupFor(food.category, food.name);
  return {
    id: food.id,
    slug: food.slug,
    type: "food" as const,
    name: food.name,
    aliases: food.aliases,
    category: food.category,
    group,
    icon: iconFor(group, "food"),
    carbPer100g: food.nutrients.carbG,
    glycemicIndex: giPayload(food.slug, food.name),
    defaultGrams: 100,
    defaultLabel: "100 g",
    basis: food.basis,
    edibleNote: food.edibleNote,
    source: food.sourceId,
    confidence: food.confidence,
    sourceConfidence: food.sourceConfidence ?? food.confidence,
    dataQuality: food.dataQuality,
    note: food.note,
  };
});

const recipeOptions = recipes.map((recipe) => {
  const nutrients = calculateRecipe(recipe);
  const servingWeight = recipe.servingWeightG || 100;
  const carbPer100g = servingWeight > 0 ? (nutrients.carbG / servingWeight) * 100 : null;
  const group = groupFor("Món ăn", recipe.name);
  return {
    id: `recipe:${recipe.slug}`,
    slug: recipe.slug,
    type: "recipe" as const,
    name: recipe.name,
    aliases: recipe.aliases,
    category: "Món ăn",
    group,
    icon: iconFor(group, "recipe"),
    carbPer100g,
    glycemicIndex: giPayload(recipe.slug, recipe.name),
    defaultGrams: servingWeight,
    defaultLabel: recipe.servingName ? `${recipe.servingName} (${servingWeight} g)` : `${servingWeight} g`,
    basis: `1 khẩu phần mẫu ${servingWeight} g`,
    edibleNote: recipe.portionNote ?? "",
    source: recipe.sourceId,
    confidence: recipe.confidence,
    sourceConfidence: recipe.confidence,
    dataQuality: recipe.sourceId === "recipe-estimate-v1" ? "recipe_estimate" : undefined,
    note: recipe.note,
  };
});

const glFoods = [...foodOptions, ...recipeOptions]
  .filter((item) => typeof item.carbPer100g === "number" && Number.isFinite(item.carbPer100g) && item.carbPer100g > 0)
  .sort((a, b) => {
    const withGi = (b.glycemicIndex.gi == null ? 0 : 1) - (a.glycemicIndex.gi == null ? 0 : 1);
    if (withGi !== 0) return withGi;
    const groupOrder = ["tinh-bot", "trai-cay", "do-uong", "banh-keo", "khac"];
    const diff = groupOrder.indexOf(a.group) - groupOrder.indexOf(b.group);
    return diff !== 0 ? diff : a.name.localeCompare(b.name, "vi");
  });

const quickSlugs = ["com-trang", "com-gao-lut", "bun-tuoi", "banh-pho-chin", "banh-mi", "khoai-lang", "bap-nep-luoc", "chuoi", "tao", "cam"];
const quickRefs = quickSlugs
  .map((slug) => glFoods.find((item) => item.slug === slug || item.id === slug))
  .filter(Boolean);

const glFoodJson = JSON.stringify(glFoods).replace(/</g, "\\u003c");
const quickRefJson = JSON.stringify(quickRefs).replace(/</g, "\\u003c");
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/tinh-gl-bua-an">
  <main class="content-page">
    <div class="page-header">
      <h1><span class="h-icon">⚖️</span><span class="h-text">Tính GL bữa ăn</span></h1>
      <p class="page-desc">{desc}</p>
    </div>

    <div class="gl-guide" aria-label="Phân loại GL tham khảo">
      <div class="gl-card low">
        <div class="gl-range">≤ 10</div>
        <div class="gl-label">GL thấp</div>
        <div class="gl-desc">phân loại giáo dục theo từng món/khẩu phần</div>
      </div>
      <div class="gl-card mid">
        <div class="gl-range">11-19</div>
        <div class="gl-label">GL trung bình</div>
        <div class="gl-desc">cần xem cùng lượng carb và bối cảnh cá nhân</div>
      </div>
      <div class="gl-card high">
        <div class="gl-range">≥ 20</div>
        <div class="gl-label">GL cao</div>
        <div class="gl-desc">không đồng nghĩa dự đoán chắc chắn đường huyết</div>
      </div>
    </div>

    <div class="info-note">
      <strong>V1 dùng total carbohydrate.</strong> {GL_TOTAL_CARB_NOTE}
    </div>

    <div class="section-label"><span class="sl-num">1</span> Chọn thực phẩm hoặc món ăn</div>
    <div class="builder">
      <div class="builder-top">
        <input id="food-search" type="search" placeholder="Tìm cơm, bún, phở, bánh mì, khoai, bắp, chuối..." class="builder-search" autocomplete="off" />
        <div class="filter-chips" id="filter-chips">
          <button class="chip active" type="button" data-group="all">Tất cả</button>
          <button class="chip" type="button" data-group="tinh-bot">Tinh bột</button>
          <button class="chip" type="button" data-group="trai-cay">Trái cây</button>
          <button class="chip" type="button" data-group="do-uong">Đồ uống</button>
          <button class="chip" type="button" data-group="banh-keo">Bánh/ngọt</button>
          <button class="chip" type="button" data-group="khac">Khác</button>
          <button class="chip" type="button" data-gi="mapped">Có GI</button>
        </div>
      </div>
      <div class="food-list" id="food-list"></div>
    </div>

    <div class="section-label"><span class="sl-num">2</span> Kết quả GL ước tính</div>
    <div class="meal-total" id="meal-total" style="display:none;">
      <div class="meal-head">
        <h2>Tổng bữa ăn</h2>
        <button class="reset-btn" id="reset-btn" type="button">Làm lại</button>
      </div>
      <div class="total-items" id="total-items"></div>
      <div class="total-bar">
        <div class="total-row">
          <span>Tổng GL ước tính</span>
          <span class="total-gl" id="total-gl">0</span>
        </div>
        <div class="total-row">
          <span>Tổng carb đã dùng để tính</span>
          <span id="total-carb">0 g</span>
        </div>
        <div class="reference-band">
          <div class="reference-fill" id="reference-fill"></div>
        </div>
        <div class="total-note" id="total-note">Phân loại GL là thông tin giáo dục, không phải mục tiêu điều trị chung.</div>
      </div>
      <div class="warning-list" id="warning-list" style="display:none;"></div>
    </div>

    <details class="quick-ref">
      <summary>Bảng GI curated v1 đang dùng</summary>
      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr><th>Mục</th><th>Carb/100g</th><th>GI</th><th>Match</th><th>Ghi chú</th></tr>
          </thead>
          <tbody id="quick-ref-body"></tbody>
        </table>
      </div>
    </details>

    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        <p>{GL_GLOBAL_SAFETY_NOTE}</p>
        <p>{GL_CLINICAL_CONTEXT_NOTE}</p>
        <p>Kết quả không thay thế theo dõi đường huyết cá nhân hoặc tư vấn dinh dưỡng cá thể.</p>
      </div>
    </div>

    <div class="related-links">
      <a href="/cong-cu/chi-so-gi" class="rl-btn">Tra chỉ số GI</a>
      <a href="/cong-cu/tinh-carb" class="rl-btn">Tính carb bữa ăn</a>
      <a href="/kien-thuc-dinh-duong/dai-thao-duong" class="rl-btn">Dinh dưỡng đái tháo đường</a>
      <a href="/kien-thuc-dinh-duong/tien-dai-thao-duong" class="rl-btn">Tiền đái tháo đường</a>
    </div>
  </main>

  <script is:inline id="gl-food-data" type="application/json" set:html={glFoodJson}></script>
  <script is:inline id="gl-quick-ref-data" type="application/json" set:html={quickRefJson}></script>

  <style>
    .content-page { max-width: 900px; margin:0 auto; padding:32px 20px; }
    .page-header { text-align:center; margin-bottom:28px; }
    .page-header h1 { display:flex; align-items:center; justify-content:center; gap:12px; margin:0 0 10px; }
    .h-icon { font-size:1.8rem; line-height:1; }
    .h-text { font-size:1.65rem; font-weight:800; letter-spacing:0; line-height:1.2; }
    .page-desc { max-width:660px; margin:0 auto; color:var(--ink-secondary); font-size:0.94rem; line-height:1.6; }
    .section-label { display:flex; align-items:center; gap:10px; font-weight:700; font-size:0.92rem; margin:24px 0 12px; color:var(--ink); }
    .sl-num { width:28px; height:28px; border-radius:50%; background:var(--brand-light); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.78rem; font-weight:800; flex-shrink:0; }
    .gl-guide { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
    .gl-card { text-align:center; padding:14px 12px; border-radius:var(--radius-lg); border:1px solid var(--card-border); background:var(--card); box-shadow:var(--shadow-sm); }
    .gl-card.low { border-color:#a5d6a7; }
    .gl-card.mid { border-color:#ffcc80; }
    .gl-card.high { border-color:#ef9a9a; }
    .gl-range { font-size:1.18rem; font-weight:800; }
    .gl-label { font-weight:700; margin:3px 0; }
    .gl-desc { font-size:0.76rem; color:var(--ink-secondary); line-height:1.4; }
    .info-note { padding:14px 16px; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:var(--radius-lg); color:var(--ink-secondary); font-size:0.86rem; line-height:1.55; margin-bottom:24px; }
    .builder { margin-bottom:20px; }
    .builder-top { margin-bottom:14px; }
    .builder-search { width:100%; min-height:46px; padding:12px 16px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:var(--card); color:inherit; font-size:1rem; box-sizing:border-box; transition: border-color var(--transition), box-shadow var(--transition); }
    .builder-search:focus { outline:none; border-color:var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }
    .filter-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    .chip { min-height:42px; padding:8px 14px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:var(--card); color:var(--ink-secondary); font-size:0.84rem; cursor:pointer; transition:all var(--transition); font-family:inherit; }
    .chip:hover { border-color:var(--brand); }
    .chip.active { background:var(--brand-light); color:var(--brand); border-color:var(--brand-light2); font-weight:600; }
    .food-list { display:flex; flex-direction:column; gap:8px; }
    :global(.food-item) { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:12px; padding:13px 16px; background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius-lg); transition:all var(--transition); box-shadow: var(--shadow-sm); }
    :global(.food-item:hover) { border-color:var(--brand-light2); transform: translateY(-2px); box-shadow: var(--shadow); }
    :global(.food-icon) { font-size:1.45rem; }
    :global(.food-info) { min-width:0; }
    :global(.food-name) { font-weight:700; font-size:0.94rem; }
    :global(.food-detail) { font-size:0.78rem; color:var(--ink-secondary); line-height:1.45; }
    :global(.food-meta) { color:var(--ink-tertiary); }
    :global(.badge-row) { display:flex; flex-wrap:wrap; gap:5px; margin-top:5px; }
    :global(.badge) { display:inline-flex; align-items:center; min-height:22px; padding:2px 7px; border-radius:999px; background:var(--bg-soft); border:1px solid var(--card-border); font-size:0.72rem; color:var(--ink-secondary); }
    :global(.badge.exact) { color:#2e7d32; border-color:#a5d6a7; }
    :global(.badge.close) { color:#00796b; border-color:#80cbc4; }
    :global(.badge.generic) { color:#e65100; border-color:#ffcc80; }
    :global(.badge.no_gi), :global(.badge.estimated) { color:#6d4c41; border-color:#bcaaa4; }
    :global(.gram-wrap) { display:flex; align-items:center; gap:6px; border:1px solid var(--card-border); border-radius:var(--radius); padding:0 9px; background:var(--bg); transition: border-color var(--transition), box-shadow var(--transition); }
    :global(.gram-wrap:focus-within) { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }
    :global(.gram-input) { width:74px; min-height:38px; border:none; background:transparent; color:var(--ink); font-size:0.9rem; outline:none; text-align:right; }
    :global(.gram-unit) { color:var(--ink-tertiary); font-size:0.8rem; }
    :global(.food-gl) { min-width:88px; text-align:right; font-weight:800; font-size:0.98rem; color:var(--brand); }
    :global(.food-add) { min-height:40px; padding:8px 14px; border:none; border-radius:var(--radius); background:var(--brand); color:white; font-weight:700; font-size:0.84rem; cursor:pointer; transition:all var(--transition); white-space:nowrap; font-family:inherit; }
    :global(.food-add:hover) { background:var(--brand-dark); transform:translateY(-1px); box-shadow:var(--shadow-sm); }
    :global(.food-add:active) { transform:translateY(0); box-shadow:none; }
    :global(.empty-state) { text-align:center; padding:22px; color:var(--ink-secondary); background:var(--card); border:1px dashed var(--card-border); border-radius:var(--radius-lg); }
    .meal-total { background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius-lg); padding:20px; margin-bottom:20px; box-shadow: var(--shadow-sm); }
    .meal-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .meal-head h2 { font-size:1.08rem; margin:0; }
    .total-items { margin-bottom:14px; }
    :global(.total-item) { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:8px; padding:9px 0; border-bottom:1px solid var(--card-border); font-size:0.9rem; }
    :global(.total-item:last-child) { border-bottom:none; }
    :global(.ti-del) { cursor:pointer; opacity:0.55; min-width:32px; min-height:32px; border:none; border-radius:var(--radius); background:transparent; color:var(--ink-secondary); font-size:1rem; transition: all var(--transition); }
    :global(.ti-del:hover) { opacity:1; background:var(--bg-soft); }
    :global(.ti-name) { min-width:0; }
    :global(.ti-sub) { display:block; font-size:0.76rem; color:var(--ink-tertiary); margin-top:2px; line-height:1.45; }
    :global(.ti-share) { font-size:0.8rem; color:var(--ink-secondary); text-align:right; }
    :global(.ti-gl) { font-weight:700; min-width:62px; text-align:right; }
    .total-row { display:flex; justify-content:space-between; font-size:0.94rem; padding:5px 0; gap:16px; }
    .total-gl { font-size:1.25rem; font-weight:800; color:var(--brand); }
    .reference-band { position:relative; height:10px; background:var(--card-border); border-radius:6px; margin:12px 0 6px; overflow:hidden; }
    .reference-fill { height:100%; border-radius:6px; background:var(--brand); transition:width 0.3s; }
    .total-note { font-size:0.82rem; color:var(--ink-secondary); text-align:center; line-height:1.5; }
    .warning-list { margin-top:12px; padding:12px 14px; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:var(--radius-lg); color:var(--ink-secondary); font-size:0.82rem; line-height:1.5; }
    .reset-btn { min-height:38px; padding:8px 16px; border:1px solid var(--card-border); border-radius:var(--radius); background:var(--card); color:var(--ink-secondary); font-size:0.85rem; cursor:pointer; transition:all var(--transition); font-family:inherit; }
    .reset-btn:hover { border-color:var(--brand); color:var(--brand); box-shadow:var(--shadow-sm); }
    .quick-ref { margin-top:24px; }
    .quick-ref summary { cursor:pointer; font-weight:700; color:var(--ink-secondary); min-height:40px; display:flex; align-items:center; }
    .table-wrap { overflow-x:auto; margin-top:12px; }
    .ref-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
    .ref-table th, .ref-table td { border:1px solid var(--card-border); padding:8px 12px; text-align:left; vertical-align:top; }
    .ref-table th { background:var(--brand-light); font-weight:700; color:var(--brand); }
    .ref-table tr:nth-child(even) { background:var(--bg-soft); }
    .safety-note { display:flex; align-items:flex-start; gap:12px; margin-top:20px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:var(--radius); font-size:0.84rem; line-height:1.6; }
    .safety-icon-col { flex-shrink:0; font-size:1.1rem; }
    .safety-text-col { flex:1; color:var(--ink-secondary); }
    .safety-text-col p { margin:0 0 8px; }
    .safety-text-col p:last-child { margin-bottom:0; }
    .related-links { margin-top:32px; display:flex; flex-wrap:wrap; gap:10px; }
    .rl-btn { display:inline-flex; align-items:center; gap:4px; min-height:38px; padding:8px 16px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:var(--card); color:var(--brand); text-decoration:none; font-size:0.85rem; font-weight:500; transition:all var(--transition); }
    .rl-btn:hover { background:var(--brand-light); border-color:var(--brand); box-shadow:var(--shadow-sm); }
    @media (max-width:720px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.26rem; }
      .gl-guide { grid-template-columns:1fr; }
      :global(.food-item) { grid-template-columns:auto minmax(0,1fr); }
      :global(.gram-wrap), :global(.food-gl), :global(.food-add) { grid-column:2; justify-self:stretch; }
      :global(.food-gl) { text-align:left; }
      :global(.food-add) { width:100%; }
      :global(.total-item) { grid-template-columns:auto minmax(0,1fr) auto; }
      :global(.ti-share) { grid-column:2 / span 2; text-align:left; }
    }
  </style>

  <script>
    import { calculateGlycemicLoadMeal, matchQualityLabel } from "../../lib/glycemic-load-calculator";

    const rawFoods = document.getElementById("gl-food-data")?.textContent || "[]";
    const rawQuickRefs = document.getElementById("gl-quick-ref-data")?.textContent || "[]";
    const foods = JSON.parse(rawFoods);
    const quickRefs = JSON.parse(rawQuickRefs);
    let filteredFoods = foods.slice(0, 80);
    let selected = [];
    let nextId = 0;
    let currentFilter = "all";
    let currentGiFilter = "all";
    let currentSearch = "";

    function normalize(value) {
      return String(value || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d");
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function formatNumber(value) {
      if (value == null || !Number.isFinite(value)) return "-";
      return Number.isInteger(value) ? String(value) : value.toFixed(1).replace(/\.0$/, "");
    }

    function categoryLabel(value) {
      if (value === "low") return "GI thấp";
      if (value === "medium") return "GI vừa";
      if (value === "high") return "GI cao";
      return "Chưa có GI";
    }

    function glCategoryText(value) {
      if (value === "low") return "GL thấp";
      if (value === "medium") return "GL trung bình";
      if (value === "high") return "GL cao";
      return "Chưa tính GL";
    }

    function estimateFoodGL(food, grams) {
      const result = calculateGlycemicLoadMeal([{
        name: food.name,
        slug: food.slug,
        grams,
        carbPer100g: food.carbPer100g,
        glycemicIndex: food.glycemicIndex,
      }]);
      return result.items[0];
    }

    function scoreFood(food, normalizedQuery) {
      if (!normalizedQuery) return 0;
      const names = [food.name, ...(food.aliases || [])].map(normalize).filter(Boolean);
      const haystack = normalize([food.name, food.category, food.basis, food.edibleNote, ...(food.aliases || [])].join(" "));
      const tokens = normalizedQuery.split(/\s+/).filter(Boolean);
      if (!tokens.every((token) => haystack.includes(token))) return Number.POSITIVE_INFINITY;
      if (names.some((name) => name === normalizedQuery)) return 0;
      if (names.some((name) => name.startsWith(normalizedQuery))) return 1;
      if (names.some((name) => name.split(/\s+/).some((token) => token === normalizedQuery))) return 2;
      if (names.some((name) => tokens.every((token) => name.split(/\s+/).some((part) => part.startsWith(token))))) return 3;
      if (names.some((name) => name.includes(normalizedQuery))) return 4;
      return 5;
    }

    function renderFoods(list) {
      const el = document.getElementById("food-list");
      if (!el) return;
      if (list.length === 0) {
        el.innerHTML = '<div class="empty-state">Không tìm thấy thực phẩm hoặc món ăn phù hợp.</div>';
        return;
      }
      el.innerHTML = list.slice(0, 80).map((food, idx) => {
        const estimate = estimateFoodGL(food, food.defaultGrams);
        const gi = food.glycemicIndex || {};
        const searchText = [food.name, food.category, food.basis, ...(food.aliases || [])].join(" ");
        return `
          <div class="food-item" data-idx="${idx}" data-search="${escapeHtml(normalize(searchText))}">
            <div class="food-icon">${food.icon}</div>
            <div class="food-info">
              <div class="food-name">${escapeHtml(food.name)}</div>
              <div class="food-detail">
                ${formatNumber(food.carbPer100g)} g carb/100g
                <span class="food-meta">· ${escapeHtml(food.category)} · ${escapeHtml(food.basis || "100g phần ăn được")}</span>
              </div>
              <div class="badge-row">
                <span class="badge ${escapeHtml(gi.matchQuality || "no_gi")}">${escapeHtml(matchQualityLabel(gi.matchQuality || "no_gi"))}</span>
                <span class="badge">${gi.gi == null ? "Chưa có GI" : `GI ${formatNumber(gi.gi)} · ${categoryLabel(gi.giCategory)}`}</span>
              </div>
            </div>
            <label class="gram-wrap">
              <input class="gram-input" type="number" min="0.1" max="2000" step="1" value="${Math.round(food.defaultGrams)}" aria-label="Khối lượng ${escapeHtml(food.name)}">
              <span class="gram-unit">g</span>
            </label>
            <div class="food-gl">${estimate?.gl == null ? "Chưa tính" : `~GL ${formatNumber(estimate.gl)}`}</div>
            <button class="food-add" type="button">Thêm</button>
          </div>
        `;
      }).join("");

      el.querySelectorAll(".food-item").forEach((item) => {
        const idx = Number(item.getAttribute("data-idx"));
        const food = filteredFoods[idx];
        const input = item.querySelector(".gram-input");
        const glEl = item.querySelector(".food-gl");
        const addBtn = item.querySelector(".food-add");
        input?.addEventListener("input", () => {
          const grams = Number(input.value);
          const estimate = estimateFoodGL(food, grams);
          glEl.textContent = estimate?.gl == null ? "Kiểm tra dữ liệu" : `~GL ${formatNumber(estimate.gl)}`;
        });
        addBtn?.addEventListener("click", () => {
          const grams = Number(input?.value);
          selected.push({
            rowId: nextId++,
            foodId: food.id,
            slug: food.slug,
            name: food.name,
            grams,
            carbPer100g: food.carbPer100g,
            glycemicIndex: food.glycemicIndex,
            sourceConfidence: food.sourceConfidence,
            dataQuality: food.dataQuality,
            icon: food.icon,
          });
          renderTotal();
        });
      });
    }

    function renderTotal() {
      const el = document.getElementById("meal-total");
      const itemsEl = document.getElementById("total-items");
      const glEl = document.getElementById("total-gl");
      const carbEl = document.getElementById("total-carb");
      const fillEl = document.getElementById("reference-fill");
      const noteEl = document.getElementById("total-note");
      const warningEl = document.getElementById("warning-list");
      if (!el || !itemsEl || !glEl || !carbEl || !fillEl || !noteEl || !warningEl) return;

      if (selected.length === 0) {
        el.style.display = "none";
        return;
      }
      el.style.display = "block";

      const result = calculateGlycemicLoadMeal(selected);
      glEl.textContent = formatNumber(result.totalGL);
      carbEl.textContent = `${formatNumber(result.totalCarbGrams)} g`;

      itemsEl.innerHTML = result.items.map((item, index) => {
        const row = selected[index];
        return `
          <div class="total-item">
            <button class="ti-del" type="button" data-id="${row.rowId}" aria-label="Xóa ${escapeHtml(item.name)}">×</button>
            <span class="ti-name">
              ${escapeHtml(row.icon || "")} ${escapeHtml(item.name)}
              <span class="ti-sub">${formatNumber(item.grams)} g · carb ${item.carbGrams == null ? "-" : `${formatNumber(item.carbGrams)} g`} · GI ${item.gi == null ? "-" : formatNumber(item.gi)} · ${escapeHtml(matchQualityLabel(item.matchQuality))} · ${glCategoryText(item.glCategory)}</span>
            </span>
            <span class="ti-share">${item.contributionPercent == null ? "" : `${formatNumber(item.contributionPercent)}%`}</span>
            <span class="ti-gl">${item.gl == null ? "-" : `GL ${formatNumber(item.gl)}`}</span>
          </div>
        `;
      }).join("");

      itemsEl.querySelectorAll(".ti-del").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-id"));
          selected = selected.filter((item) => item.rowId !== id);
          renderTotal();
        });
      });

      fillEl.style.width = `${Math.min(Math.round((result.totalGL / 30) * 100), 100)}%`;
      if (result.totalGLCategory === "low") {
        noteEl.textContent = "Tổng GL đang ở nhóm thấp theo phân loại giáo dục, nhưng đáp ứng đường huyết cá nhân vẫn có thể khác.";
      } else if (result.totalGLCategory === "medium") {
        noteEl.textContent = "Tổng GL đang ở nhóm trung bình theo phân loại giáo dục. Hãy xem cùng tổng carb, khẩu phần và kế hoạch cá nhân.";
      } else if (result.totalGLCategory === "high") {
        noteEl.textContent = "Tổng GL đang ở nhóm cao theo phân loại giáo dục. Đây là tín hiệu để rà khẩu phần, không phải căn cứ tự thay đổi thuốc.";
      } else {
        noteEl.textContent = "Chưa đủ dữ liệu để phân loại GL.";
      }

      const uniqueWarnings = Array.from(new Set(result.warnings)).slice(0, 12);
      if (uniqueWarnings.length) {
        warningEl.style.display = "block";
        warningEl.innerHTML = uniqueWarnings.map((warning) => `<div>${escapeHtml(warning)}</div>`).join("");
      } else {
        warningEl.style.display = "none";
        warningEl.innerHTML = "";
      }
    }

    function applyFilters() {
      const q = normalize(currentSearch.trim());
      filteredFoods = foods
        .map((food, order) => ({ food, order, score: scoreFood(food, q) }))
        .filter(({ food, score }) => {
          const groupOk = currentFilter === "all" || food.group === currentFilter;
          const giOk = currentGiFilter === "all" || food.glycemicIndex?.gi != null;
          return groupOk && giOk && Number.isFinite(score);
        })
        .sort((a, b) => a.score - b.score || a.food.name.localeCompare(b.food.name, "vi") || a.order - b.order)
        .map(({ food }) => food)
        .slice(0, 80);
      renderFoods(filteredFoods);
    }

    function renderQuickRefs() {
      const body = document.getElementById("quick-ref-body");
      if (!body) return;
      body.innerHTML = quickRefs.map((food) => {
        const gi = food.glycemicIndex || {};
        return `
          <tr>
            <td>${escapeHtml(food.name)}</td>
            <td>${formatNumber(food.carbPer100g)} g</td>
            <td>${gi.gi == null ? "-" : formatNumber(gi.gi)}</td>
            <td>${escapeHtml(matchQualityLabel(gi.matchQuality || "no_gi"))}</td>
            <td>${escapeHtml(gi.note || "")}</td>
          </tr>
        `;
      }).join("");
    }

    const search = document.getElementById("food-search");
    search?.addEventListener("input", function () {
      currentSearch = this.value;
      applyFilters();
    });

    const chips = document.querySelectorAll(".filter-chips .chip");
    chips.forEach((chip) => {
      chip.addEventListener("click", function () {
        if (this.hasAttribute("data-gi")) {
          currentGiFilter = currentGiFilter === "mapped" ? "all" : "mapped";
          this.classList.toggle("active", currentGiFilter === "mapped");
        } else {
          chips.forEach((item) => {
            if (!item.hasAttribute("data-gi")) item.classList.remove("active");
          });
          this.classList.add("active");
          currentFilter = this.getAttribute("data-group") || "all";
        }
        applyFilters();
      });
    });

    document.getElementById("reset-btn")?.addEventListener("click", () => {
      selected = [];
      renderTotal();
    });

    renderQuickRefs();
    renderFoods(filteredFoods);
  </script>
</BaseLayout>
