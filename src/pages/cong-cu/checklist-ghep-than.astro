---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau ghép thận";
const desc = "Bảng kiểm an toàn thực phẩm, thuốc và theo dõi chuyển hóa sau ghép thận.";
const items = [
  "Tôi dùng thuốc chống thải ghép đúng giờ và đã hỏi về mọi thực phẩm bổ sung",
  "Tôi tránh bưởi/bưởi chùm và các tương tác đã được trung tâm ghép cảnh báo",
  "Thịt, cá, trứng, sữa và rau quả được bảo quản/nấu chín an toàn",
  "Tôi theo dõi muối, đường huyết, huyết áp và cân nặng theo kế hoạch",
  "Tôi biết kết quả creatinine, kali, đường huyết và mỡ máu gần nhất",
  "Tôi biết số điện thoại trung tâm ghép khi sốt, nôn, tiêu chảy hoặc tiểu ít",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ghep-than">
  <main class="transplant-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ghép tạng</p>
      <h1>🫁 Checklist dinh dưỡng sau ghép thận</h1>
      <p>{desc} Hướng dẫn của trung tâm ghép luôn được ưu tiên hơn bảng kiểm chung.</p>
    </header>
    <form id="transplant-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-transplant /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần gọi trung tâm ghép khi</h2>
      <p>Sốt, rét run, nôn/tiêu chảy, tiểu ít, đau vùng ghép, phù, khó thở hoặc không giữ được thuốc.</p>
      <p class="warning">Không tự ngừng, đổi giờ hoặc đổi liều thuốc chống thải ghép; không dùng thảo dược khi chưa hỏi trung tâm.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("transplant-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-transplant]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi thuốc, xét nghiệm và triệu chứng để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi trung tâm ghép hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .transplant-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .transplant-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
