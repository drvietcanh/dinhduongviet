---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau xạ trị đầu cổ";
const desc = "Bảng kiểm ăn uống và chăm sóc miệng khi xạ trị vùng đầu cổ.";
const items = [
  "Tôi theo dõi cân nặng, lượng ăn, mức đau và khả năng nhai nuốt mỗi ngày",
  "Tôi chọn thức ăn mềm, ẩm, đủ năng lượng–đạm và chia thành nhiều bữa nhỏ",
  "Tôi điều chỉnh nhiệt độ, vị chua/cay/mặn theo mức đau rát và khô miệng",
  "Tôi uống từng ngụm nhỏ hoặc dùng sản phẩm hỗ trợ ẩm miệng theo hướng dẫn",
  "Tôi chăm sóc răng miệng nhẹ nhàng và tái khám nha khoa/ung bướu theo lịch",
  "Tôi báo sớm khi ho sặc, nghẹn, đau tăng, không ăn uống được hoặc sụt cân tiếp tục",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-xa-tri-dau-co">
  <main class="rt-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung thư</p>
      <h1>🦷 Checklist dinh dưỡng sau xạ trị đầu–cổ</h1>
      <p>{desc} Bảng kiểm hỗ trợ phục hồi ăn uống, không thay thế đánh giá nuốt và kế hoạch điều trị.</p>
    </header>
    <form id="rt-form" class="card">
      <p class="hint">Đánh dấu những việc đã thực hiện:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-rt /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội điều trị khi</h2>
      <p>Khó thở, sặc nhiều, không nuốt được nước, chảy máu, sốt, đau tăng nhanh hoặc không thể duy trì đủ nước và thuốc.</p>
      <p class="warning">Không tự ép ăn khi đang sặc, không tự dùng thuốc tê/xịt họng hoặc bỏ ống nuôi ăn nếu chưa được đánh giá.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("rt-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-rt]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký nuốt, lượng ăn, cân nặng và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ ung bướu, chuyên gia dinh dưỡng hoặc chuyên viên âm ngữ trị liệu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .rt-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .rt-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
