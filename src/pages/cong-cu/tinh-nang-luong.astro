---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Tính BMR & TDEE tham khảo | Dinh dưỡng Việt";
const pageDescription = "Công cụ ước tính năng lượng nền (BMR) và tổng tiêu hao mỗi ngày (TDEE) theo công thức Mifflin-St Jeor.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section>
    <span class="badge">📊 Công cụ</span>
    <h1>Tính năng lượng tham khảo (BMR & TDEE)</h1>
    <p class="lead">
      Công cụ này ước tính năng lượng nền theo Mifflin-St Jeor rồi nhân hệ số
      hoạt động để cho ra <strong>BMR</strong> và <strong>TDEE</strong> tham
      khảo ban đầu. Đây là mốc giáo dục cho người lớn, không phải toa năng
      lượng điều trị cá thể.
    </p>
  </section>

  <div class="disclaimer">
    ⚠️ <strong>Lưu ý:</strong> Kết quả chỉ mang tính tham khảo cho người trưởng
    thành từ 18 tuổi. Không dùng riêng kết quả này để tự chỉnh thuốc, insulin,
    lợi tiểu hoặc chế độ điều trị. Người có bệnh nền, đang dùng thuốc, thai kỳ,
    rối loạn ăn uống hoặc nhu cầu vận động đặc biệt nên hỏi bác sĩ hoặc chuyên
    gia dinh dưỡng.
  </div>

  <section class="section card">
    <h2>Nhập chỉ số cơ thể</h2>

    <div class="grid two energy-form-grid">
      <div>
        <label>Giới tính</label>
        <div class="energy-radio-row">
          <label class="energy-radio-option">
            <input type="radio" name="gender" value="male" checked /> Nam
          </label>
          <label class="energy-radio-option">
            <input type="radio" name="gender" value="female" /> Nữ
          </label>
        </div>
      </div>
      <div>
        <label for="age">Độ tuổi (năm)</label>
        <input type="number" id="age" inputmode="numeric" placeholder="Ví dụ: 30" min="18" max="100" />
      </div>
    </div>

    <div class="grid two energy-form-grid">
      <div>
        <label for="weight">Cân nặng (kg)</label>
        <input type="text" id="weight" inputmode="decimal" placeholder="Ví dụ: 65.5" />
      </div>
      <div>
        <label for="height">Chiều cao (cm)</label>
        <input type="number" id="height" inputmode="numeric" placeholder="Ví dụ: 170" />
      </div>
    </div>

    <div class="energy-select-block">
      <label for="activity">Mức độ vận động</label>
      <select id="activity" class="energy-select">
        <option value="1.2">Ít vận động (Làm việc văn phòng, không tập thể dục)</option>
        <option value="1.375">Vận động nhẹ (Tập thể dục nhẹ nhàng 1-3 ngày/tuần)</option>
        <option value="1.55" selected>Vận động vừa (Tập thể dục đều đặn 3-5 ngày/tuần)</option>
        <option value="1.725">Vận động nhiều (Chơi thể thao cường độ cao 6-7 ngày/tuần)</option>
        <option value="1.9">Vận động rất nặng (Vận động viên, lao động tay chân nặng)</option>
      </select>
    </div>

    <button type="button" id="calc-btn" class="cta-btn energy-submit">
      Tính năng lượng tham khảo
    </button>

    <p id="form-message" class="form-message" hidden></p>
  </section>

  <section id="result-section" class="section card energy-result-section" style="display:none;">
    <h2>Kết quả phân tích</h2>

    <div class="grid two energy-result-grid">
      <div class="energy-stat-card">
        <span class="muted energy-stat-label">Năng lượng nền (BMR)</span>
        <strong id="bmr-result" class="energy-stat-value energy-stat-value-brand">0</strong>
        <span class="energy-stat-unit">kcal / ngày</span>
        <p class="muted energy-stat-copy">Là lượng calo cơ thể đốt cháy khi nằm bất động để thở, bơm máu và duy trì hoạt động nền.</p>
      </div>

      <div class="energy-stat-card energy-stat-card-accent">
        <span class="energy-stat-label energy-stat-label-accent">Tổng tiêu hao (TDEE)</span>
        <strong id="tdee-result" class="energy-stat-value energy-stat-value-accent">0</strong>
        <span class="energy-stat-unit">kcal / ngày</span>
        <p class="energy-stat-copy energy-stat-copy-accent">Là ước tính tổng năng lượng tiêu hao mỗi ngày theo dữ liệu bạn nhập.</p>
      </div>
    </div>

    <div class="energy-save-block">
      <button type="button" id="save-target-btn" class="cta-btn cta-outline energy-save-button">💾 Lưu TDEE làm Mục tiêu vào Nhật Ký</button>
      <p id="save-msg" class="energy-save-message" hidden>✅ Đã lưu mục tiêu thành công!</p>
    </div>
    <div class="result-note energy-note-block">
      <h3 class="energy-note-title">🎯 Hướng dẫn đặt mục tiêu:</h3>
      <ul class="safe-list">
        <li><strong>Duy trì cân nặng:</strong> Xem TDEE như mốc mở đầu, rồi theo dõi lại cân nặng, vòng eo, cảm giác đói no và mức vận động thực tế.</li>
        <li><strong>Giảm hoặc tăng cân:</strong> Nên điều chỉnh từ từ. Không dùng riêng công cụ này để tự đặt mức cắt hoặc tăng kcal quá mạnh.</li>
        <li><strong>Theo dõi:</strong> Nếu cân nặng thay đổi nhanh, mệt nhiều, chóng mặt hoặc có triệu chứng bất thường, hãy dừng tự điều chỉnh và hỏi chuyên gia.</li>
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  label {
    display: block;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .energy-form-grid,
  .energy-select-block {
    margin-top: 15px;
  }
  .energy-radio-row {
    display:flex;
    gap:15px;
    padding-top:10px;
  }
  .energy-radio-option {
    display:flex;
    align-items:center;
    font-weight:normal;
    gap:5px;
    cursor:pointer;
  }
  input[type="text"], input[type="number"] {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    font-size: 1rem;
    background: var(--bg-elevated);
    color: var(--ink);
    box-sizing: border-box;
    transition: border-color var(--transition);
  }
  input:focus, select:focus {
    outline: none;
    border-color: var(--brand);
  }
  .energy-select {
    width:100%;
    padding:10px 12px;
    border:1px solid var(--card-border);
    border-radius:var(--radius);
    font-size:1rem;
    background:var(--bg-elevated);
    color:var(--ink);
  }
  .energy-submit {
    width: 100%;
    margin-top: 20px;
    text-align: center;
    border-radius: 12px;
  }
  .energy-result-section {
    border-color: var(--brand-light2);
    background: #f8fafc;
  }
  .energy-result-grid {
    margin-top:20px;
  }
  .energy-stat-card {
    background:var(--card);
    padding:20px;
    border-radius:var(--radius);
    border:1px solid var(--card-border);
    text-align:center;
  }
  .energy-stat-card-accent {
    background:var(--brand);
    color:white;
  }
  .energy-stat-label {
    display:block;
    margin-bottom:5px;
  }
  .energy-stat-label-accent {
    opacity:0.9;
  }
  .energy-stat-value {
    font-size:2.2rem;
    display:block;
  }
  .energy-stat-value-brand {
    color:var(--brand);
  }
  .energy-stat-value-accent {
    text-shadow:1px 1px 2px rgba(0,0,0,0.2);
  }
  .energy-stat-unit {
    font-weight:600;
  }
  .energy-stat-copy {
    font-size:0.85rem;
    margin-top:10px;
  }
  .energy-stat-copy-accent {
    opacity:0.9;
  }
  .energy-save-block {
    margin-top: 24px;
    text-align: center;
  }
  .energy-save-button {
    border-radius: 12px;
    width: 100%;
  }
  .energy-save-message {
    color: var(--brand);
    font-size: 0.9rem;
    margin-top: 10px;
  }


  .form-message {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: #fff7ed;
    color: #9a3412;
    border: 1px solid #fed7aa;
  }
  .result-note {
    padding: 16px;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid var(--card-border);
    line-height: 1.6;
  }
  .energy-note-block {
    margin-top:20px;
  }
  .energy-note-title {
    margin-top:0;
    font-size:1.1rem;
    color:var(--ink);
  }
  .safe-list { margin: 10px 0 0; padding-left: 18px; }
  .safe-list li + li { margin-top: 8px; }
</style>

<script>
  const calcBtn = document.getElementById("calc-btn");
  const formMessage = document.getElementById("form-message");
  const resultSection = document.getElementById("result-section");
  const bmrResult = document.getElementById("bmr-result");
  const tdeeResult = document.getElementById("tdee-result");

  function normalizeNumber(rawValue) {
    if (typeof rawValue !== "string") return Number.NaN;
    const normalized = rawValue.trim().replace(",", ".");
    return normalized ? Number.parseFloat(normalized) : Number.NaN;
  }

  function setMessage(msg) {
    formMessage.textContent = msg;
    formMessage.hidden = !msg;
  }

  calcBtn?.addEventListener("click", () => {
    setMessage("");
    resultSection.style.display = "none";

    const gender = document.querySelector('input[name="gender"]:checked').value;
    const rawAge = document.getElementById("age").value;
    const rawWeight = document.getElementById("weight").value;
    const rawHeight = document.getElementById("height").value;
    const activity = document.getElementById("activity").value;

    if (!rawAge || !rawWeight || !rawHeight) {
      setMessage("Vui lòng nhập đầy đủ Tuổi, Cân nặng và Chiều cao.");
      return;
    }

    const age = parseInt(rawAge, 10);
    const weight = normalizeNumber(rawWeight);
    const height = normalizeNumber(rawHeight);
    const actFactor = parseFloat(activity);

    if (!Number.isFinite(age) || !Number.isFinite(weight) || !Number.isFinite(height)) {
      setMessage("Dữ liệu nhập vào phải là số hợp lệ.");
      return;
    }

    if (age < 18 || age > 100) {
      setMessage("Công cụ này chỉ áp dụng cho người trưởng thành từ 18 - 100 tuổi.");
      return;
    }

    if (weight <= 0 || weight > 300 || height <= 0 || height > 250) {
      setMessage("Chỉ số cân nặng hoặc chiều cao không hợp lý.");
      return;
    }

    // Formula Mifflin-St Jeor
    // Nam: 10 * W + 6.25 * H - 5 * A + 5
    // Nữ: 10 * W + 6.25 * H - 5 * A - 161
    let bmr = (10 * weight) + (6.25 * height) - (5 * age);
    if (gender === "male") {
      bmr += 5;
    } else {
      bmr -= 161;
    }

    const tdee = bmr * actFactor;

    bmrResult.textContent = Math.round(bmr).toLocaleString('vi-VN');
    tdeeResult.textContent = Math.round(tdee).toLocaleString('vi-VN');

    resultSection.style.display = "block";

    window.scrollTo({
      top: resultSection.offsetTop - 20,
      behavior: "smooth"
    });

    // Setup Save button
    const saveBtn = document.getElementById("save-target-btn");
    const saveMsg = document.getElementById("save-msg");
    saveMsg.hidden = true;

    saveBtn.onclick = () => {
      const targetData = {
        kcal: Math.round(tdee),
        weight: weight,
        height: height,
        age: age,
        sex: gender,
        activity: actFactor
      };

      // Get existing targets if any
      let existing = {};
      try {
        const raw = localStorage.getItem("mt-target-v2");
        if(raw) existing = JSON.parse(raw);
      } catch(e){}

      // Merge
      const merged = { ...existing, ...targetData };
      localStorage.setItem("mt-target-v2", JSON.stringify(merged));

      saveMsg.hidden = false;
      setTimeout(() => { saveMsg.hidden = true; }, 3000);
    };
  });
</script>
