---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist đa thuốc ở người cao tuổi";
const desc = "Bảng kiểm rà soát thuốc, thực phẩm và nguy cơ suy dinh dưỡng ở người cao tuổi.";
const items = [
  "Tôi có danh sách đầy đủ thuốc kê đơn, không kê đơn, vitamin, thảo dược và thực phẩm bổ sung",
  "Tôi mang danh sách này khi khám và hỏi dược sĩ về cách uống cùng thức ăn, sữa hoặc nước trái cây",
  "Tôi theo dõi chán ăn, khô miệng, buồn nôn, táo bón, tiêu chảy, buồn ngủ và chóng mặt",
  "Tôi kiểm tra cân nặng, lượng ăn uống, đường huyết hoặc huyết áp theo nguy cơ cá nhân",
  "Tôi dùng hộp chia thuốc/lịch nhắc phù hợp và không tự nghiền, bẻ hoặc ngừng thuốc",
  "Tôi báo ngay khi lú lẫn mới, ngất, té ngã, khó nuốt hoặc không thể giữ thuốc trong người",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-da-thuoc-nguoi-cao-tuoi">
  <main class="poly-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm lão khoa</p>
      <h1>💊 Checklist đa thuốc ở người cao tuổi</h1>
      <p>{desc} Bảng kiểm hỗ trợ người bệnh và người chăm sóc chuẩn bị cho buổi rà soát thuốc.</p>
    </header>
    <form id="poly-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-poly /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế khi</h2>
      <p>Ngất, lú lẫn đột ngột, hạ đường huyết, chảy máu bất thường, khó thở, té ngã hoặc nôn không giữ được thuốc.</p>
      <p class="warning">Không tự bỏ thuốc, gấp đôi liều bù hoặc dùng thực phẩm bổ sung để thay thuốc điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("poly-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-poly]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang toàn bộ vỏ thuốc, danh sách thực phẩm bổ sung và nhật ký triệu chứng khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ hoặc dược sĩ lâm sàng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .poly-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .poly-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
