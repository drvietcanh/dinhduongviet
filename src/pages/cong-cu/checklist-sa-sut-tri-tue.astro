---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi sa sút trí tuệ sớm";
const desc = "Bảng kiểm ăn uống, an toàn và hỗ trợ người bệnh sa sút trí tuệ giai đoạn sớm.";
const items = [
  "Tôi theo dõi cân nặng, lượng ăn, uống nước và thay đổi khả năng tự ăn theo tuần",
  "Tôi duy trì giờ ăn quen thuộc, món quen vị và không gian yên tĩnh, đủ ánh sáng",
  "Tôi chuẩn bị thức ăn dễ nhai nuốt, cắt nhỏ và ngồi thẳng khi ăn",
  "Tôi kiểm tra hạn dùng, bảo quản thực phẩm và tránh để người bệnh tự ăn món nguy hiểm",
  "Tôi rà soát thuốc gây buồn ngủ, khô miệng, chán ăn hoặc tương tác với thực phẩm cùng bác sĩ/dược sĩ",
  "Tôi báo sớm khi sụt cân, ho sặc, bỏ ăn, mất nước, lú lẫn tăng hoặc thay đổi hành vi đột ngột",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-sa-sut-tri-tue">
  <main class="dementia-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm lão khoa</p>
      <h1>🧠 Checklist dinh dưỡng khi sa sút trí tuệ sớm</h1>
      <p>{desc} Bảng kiểm dành cho người bệnh và người chăm sóc, không thay thế đánh giá y khoa.</p>
    </header>
    <form id="dementia-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-dementia /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế sớm khi</h2>
      <p>Ho sặc hoặc khó thở sau ăn, không uống được, tiểu ít, sốt, sụt cân nhanh hoặc lú lẫn đột ngột.</p>
      <p class="warning">Không ép ăn, tự nghiền thuốc hoặc dùng sản phẩm “bổ não” thay cho đánh giá nguyên nhân.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("dementia-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-dementia]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký ăn uống, cân nặng, thuốc và tình huống khó khăn khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ lão khoa/thần kinh hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .dementia-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .dementia-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
