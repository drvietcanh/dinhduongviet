---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";

// Precompute all recipe data for embedding
const recipeData = recipes.map(r => {
  const n = calculateRecipe(r);
  return {
    slug: r.slug,
    name: r.name,
    tags: r.tags || [],
    kcal: n.energyKcal || 0,
    protein: n.proteinG || 0,
    fat: n.fatG || 0,
    carb: n.carbG || 0,
    fiber: n.fiberG || 0,
    sodium: n.sodiumMg || 0,
    satFat: n.satFatG || 0,
    sugar: n.sugarG || 0,
    servingName: r.servingName || "",
  };
});

// Meal-type classifier based on recipe name and tags
function classifyMeal(r) {
  const n = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
  // Breakfast
  if (["phở","bún","cháo","bánh mì","xôi","sữa","trứng","bánh cuốn","bánh ướt","bánh hỏi","bánh bèo","bánh giò","bánh đúc","bánh tráng","bánh căn","bánh khọt","bánh xèo","bánh cống","bánh dày","bánh cam","bánh gối","bánh chuối","bánh da lợn","bánh bò","bánh flan","chè bà ba","chè đậu"].some(k => n.includes(k))) return "sang";
  // Drink/dessert
  if (["chè","sinh tố","nước","trà","cà phê","sữa","kem","yaourt","sữa chua","đồ uống"].some(k => n.includes(k))) return "phu";
  // Soup/stew for dinner
  if (["canh","súp","lẩu","tiết canh","cháo lòng","cháo huyết","cháo lươn"].some(k => n.includes(k))) return "toi";
  return "trua"; // default to lunch
}

const MEAL_MAP = { sang: [], trua: [], chieu: [], toi: [], phu: [] };
recipeData.forEach(r => {
  const meal = classifyMeal(r);
  MEAL_MAP[meal].push(r);
});
const MEAL_KEYS = ["sang","trua","chieu","toi"];
const MEAL_VI = { sang: "🌅 Sáng", trua: "🌞 Trưa", chieu: "🌆 Chiều", toi: "🌙 Tối", phu: "🍿 Phụ" };
const MEAL_PCT = { sang: 0.25, trua: 0.35, chieu: 0.10, toi: 0.30 };
const DAY_NAMES = ["Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ Nhật"];

// Disease exclusion keywords
const DISEASE_RULES = {
  gout: { name: "🦶 Gout", exclude: ["lòng","óc","gan","thận","tim","cật","tiết canh","cháo lòng","dồi","nội tạng"], tip: "Tránh nội tạng, nước dùng xương hầm kỹ, hải sản nhiều purin. Uống đủ 2-2.5L nước/ngày." },
  tieuDuong: { name: "🩸 Tiểu đường", exclude: ["nước ngọt","siro","bánh ngọt","chè đường","mứt","kem","sữa đặc"], tip: "Ưu tiên món GI thấp, chia nhỏ bữa, tránh đường tinh chế. Kết hợp chất xơ mỗi bữa." },
  tangHuyetAp: { name: "🫀 Tăng huyết áp", exclude: ["mắm tôm","mắm nêm","chao","thịt nguội","xúc xích","dưa muối","cà muối","kim chi"], tip: "Hạn chế muối <5g/ngày. Tránh món kho rim mặn. Tăng rau quả giàu kali." },
  beoPhi: { name: "⚖️ Béo phì", exclude: ["chiên dầu","xào nhiều dầu","thịt ba chỉ","thịt mỡ","da gà","da vịt"], tip: "Kiểm soát khẩu phần. Ưu tiên món luộc/hấp. Ăn rau trước bữa chính." },
  suyThan: { name: "🫘 Suy thận", exclude: ["nước dùng","canh xương","lẩu","chuối","khoai tây","khoai lang","đu đủ","sầu riêng","mít"], tip: "Hạn chế đạm 0.6g/kg/ngày. Tránh thực phẩm giàu kali và phốt pho." },
  damMach: { name: "💔 Mỡ máu", exclude: ["thịt ba chỉ","thịt mỡ","da heo","da gà","óc heo","lòng","phủ tạng","chiên ngập dầu"], tip: "Hạn chế chất béo bão hòa. Tăng omega-3 (cá thu, cá basa). Nên ăn nhiều chất xơ." },
};

const ALL_DISEASE_KEYS = Object.keys(DISEASE_RULES);
---

<BaseLayout title="Lập thực đơn tuần tự động - Dinh Dưỡng Việt" canonical="/cong-cu/lap-thuc-don-tuan">
  <span class="badge">⭐ Công cụ</span>
  <h1>🗓️ Lập thực đơn tuần tự động</h1>
  <p class="lead">Tự động tạo thực đơn 7 ngày thông minh từ 400+ món ăn Việt, tối ưu theo calo mục tiêu và tình trạng sức khỏe của bạn.</p>

  <div class="disclaimer">Món ăn được gợi ý dựa trên nhóm calo. Kết quả mang tính tham khảo — bạn có thể thay đổi theo sở thích cá nhân.</div>

  <section class="card config-section">
    <div class="config-grid">
      <div class="conf-item">
        <label>🎯 Mục tiêu calo/ngày</label>
        <select id="calTarget">
          <option value="1500">1500 kcal — Giảm cân</option>
          <option value="1800">1800 kcal — Giảm nhẹ</option>
          <option value="2000" selected>2000 kcal — Duy trì</option>
          <option value="2300">2300 kcal — Tăng nhẹ</option>
          <option value="2600">2600 kcal — Tăng cơ</option>
          <option value="3000">3000 kcal — Vận động nhiều</option>
        </select>
      </div>
      <div class="conf-item">
        <label>🩺 Bệnh lý / Chế độ</label>
        <select id="diseaseFilter">
          <option value="">Không có</option>
          {ALL_DISEASE_KEYS.map(k => <option value={k}>{DISEASE_RULES[k].name}</option>)}
        </select>
      </div>
      <div class="conf-item">
        <label>🍳 Bữa sáng</label>
        <select id="breakfastMode">
          <option value="auto">Tự động</option>
          <option value="none">Không ăn sáng</option>
          <option value="light">Nhẹ (cháo/bánh mì)</option>
          <option value="heavy">Lớn (phở/bún/xôi)</option>
        </select>
      </div>
      <div class="conf-item">
        <label>🥗 Chế độ ăn</label>
        <select id="dietMode">
          <option value="">Không</option>
          <option value="it-natri">Ít natri</option>
          <option value="it-mo">Ít chất béo bão hòa</option>
          <option value="nhieu-xo">Nhiều chất xơ</option>
          <option value="it-do-ngot">Ít đường</option>
        </select>
      </div>
    </div>

    <div class="gen-row">
      <button class="btn-gen" onclick="generatePlan()">✨ Tạo thực đơn tuần</button>
      <button class="btn-outline" onclick="exportPlan()" id="exportBtn" style="display:none;">📤 Xuất văn bản</button>
    </div>
  </section>

  <div id="loading" class="loading-state">🔄 Đang tính toán thực đơn...</div>
  <div id="planContainer"></div>
  <div id="weekSummary" class="week-summary" style="display:none;"></div>
  <div id="healthTip" class="health-tip" style="display:none;"></div>

  <!-- Embedded recipe data for client script -->
  <div id="recipe-data-store" style="display:none" data-recipes={JSON.stringify(recipeData || [])} data-meal-map={JSON.stringify(Object.fromEntries(MEAL_KEYS.map(k => [k, MEAL_MAP[k].map(r => r.slug)])))}></div>

  <script is:inline>
(function() {
  var store = document.getElementById('recipe-data-store');
  var RECIPES = JSON.parse(store.getAttribute('data-recipes') || '[]');
  var MEAL_MAP = JSON.parse(store.getAttribute('data-meal-map') || '{}');
  var MEAL_KEYS = ["sang","trua","chieu","toi"];
  var MEAL_MAP = {JSON.stringify(Object.fromEntries(MEAL_KEYS.map(k => [k, MEAL_MAP[k].map(r => r.slug)])))};
  var MEAL_KEYS = ["sang","trua","chieu","toi"];
  var MEAL_VI = { sang:"🌅 Sáng", trua:"🌞 Trưa", chieu:"🌆 Chiều", toi:"🌙 Tối" };
  var MEAL_PCT = { sang:0.25, trua:0.35, chieu:0.10, toi:0.30 };
  var DAY_NAMES = ["Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ Nhật"];
  var K=1000;

  var DISEASE = {
    gout: { exclude: ["lòng","óc","gan","cật","tim","tiết canh","cháo lòng","dồi","nội tạng","phèo","lươn","ba ba"], tip: "⚠️ Tránh nội tạng, nước dùng xương hầm, hải sản nhiều purin. Uống 2-2.5L nước/ngày." },
    tieuDuong: { exclude: ["nước ngọt","siro","bánh ngọt","chè đường","mứt","kem","sữa đặc"], tip: "⚠️ Ưu tiên GI thấp, chia nhỏ bữa, tránh đường tinh chế. Kết hợp chất xơ mỗi bữa." },
    tangHuyetAp: { exclude: ["mắm tôm","mắm nêm","chao","thịt nguội","xúc xích","dưa muối","cà muối","kim chi","ruốc","mắm ruốc","cà pháo"], tip: "⚠️ Hạn chế muối <5g/ngày. Tránh món kho rim mặn. Tăng rau giàu kali." },
    beoPhi: { exclude: ["chiên dầu","xào nhiều dầu","thịt ba chỉ","thịt mỡ","da gà","da vịt","heo quay"], tip: "⚠️ Kiểm soát khẩu phần. Ưu tiên luộc/hấp. Ăn rau trước bữa chính." },
    suyThan: { exclude: ["nước dùng","canh xương","lẩu","chuối","khoai tây","khoai lang","đu đủ","sầu riêng","mít","nước dừa","bơ"], tip: "⚠️ Hạn chế đạm 0.6g/kg/ngày. Tránh thực phẩm giàu kali và phốt pho." },
    damMach: { exclude: ["thịt ba chỉ","thịt mỡ","da heo","da gà","óc heo","lòng","phủ tạng","chiên ngập dầu","mỡ lợn","mỡ gà"], tip: "⚠️ Hạn chế chất béo bão hòa. Tăng omega-3 (cá thu, cá basa). Nhiều chất xơ." },
  };

  var DIET_FILTERS = {
    "it-natri": function(r) { return r.sodium < 300; },
    "it-mo": function(r) { return r.satFat < 6; },
    "nhieu-xo": function(r) { return r.fiber >= 3; },
    "it-do-ngot": function(r) { return r.sugar < 10; },
  };

  // Pick recipe closest to target calories from a pool
  function pickBest(pool, targetCal, history) {
    if (pool.length === 0) return null;
    var available = history ? pool.filter(function(r) { return history.indexOf(r.slug) === -1; }) : pool.slice();
    if (available.length === 0) available = pool;

    var best = available[0];
    var bestDiff = Math.abs(best.kcal - targetCal);
    // Search up to 100 recipes for performance
    var limit = Math.min(100, available.length);
    for (var i = 1; i < limit; i++) {
      var diff = Math.abs(available[i].kcal - targetCal);
      if (diff < bestDiff) { bestDiff = diff; best = available[i]; }
    }
    return best;
  }

  window.generatePlan = function() {
    var $loading = document.getElementById('loading');
    $loading.style.display = 'block';

    setTimeout(function() {
      var calTarget = parseInt(document.getElementById('calTarget').value) || 2000;
      var disease = document.getElementById('diseaseFilter').value;
      var bfastMode = document.getElementById('breakfastMode').value;
      var dietMode = document.getElementById('dietMode').value;

      // Build pool
      var pool = RECIPES.filter(function(r){return r.kcal > 0;});

      // Disease filter
      if (disease && DISEASE[disease]) {
        var words = DISEASE[disease].exclude;
        pool = pool.filter(function(r) {
          var txt = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
          return !words.some(function(w){ return txt.indexOf(w) !== -1; });
        });
      }

      // Diet filter
      if (dietMode && DIET_FILTERS[dietMode]) {
        pool = pool.filter(DIET_FILTERS[dietMode]);
      }

      if (pool.length < 7) {
        $loading.style.display = 'none';
        document.getElementById('planContainer').innerHTML = '<div class="empty">😕 Không đủ món phù hợp. Thử bỏ bộ lọc.</div>';
        return;
      }

      // Build meal pools
      var mealPools = {};
      MEAL_KEYS.forEach(function(k) {
        var slugs = MEAL_MAP[k] || [];
        mealPools[k] = slugs.map(function(s) { return RECIPES.find(function(r){return r.slug===s;}) }).filter(Boolean);
      });
      // Fallback: recipes not in any meal map → lunch
      var leftover = pool.filter(function(r) {
        return !MEAL_KEYS.some(function(k){return (MEAL_MAP[k]||[]).indexOf(r.slug)!==-1;});
      });
      mealPools.trua = mealPools.trua.concat(leftover);

      // Breakfast mode: adjust morning pool
      if (bfastMode === 'none') {
        mealPools.sang = [];
        // redistribute breakfast calories
        MEAL_PCT.trua += 0.10;
        MEAL_PCT.toi += 0.10;
        MEAL_PCT.chieu += 0.05;
      } else if (bfastMode === 'light') {
        mealPools.sang = mealPools.sang.filter(function(r){return r.kcal < 350;});
      } else if (bfastMode === 'heavy') {
        mealPools.sang = mealPools.sang.filter(function(r){return r.kcal > 300;});
      }

      // Generate plan (7 days)
      var plan = [];
      var usedHistory = [];
      var weekTotals = { kcal:0, protein:0, fat:0, carb:0, fiber:0 };

      for (var day = 0; day < 7; day++) {
        var dayPlan = { meals: [], kcal: 0, protein: 0, fat: 0, carb: 0, fiber: 0 };

        MEAL_KEYS.forEach(function(meal) {
          var target = calTarget * (MEAL_PCT[meal] || 0);
          var mealPool = mealPools[meal] || [];
          var picked = [];

          // Pick 1 main recipe
          var first = pickBest(mealPool, target, usedHistory);
          if (first) {
            picked.push(first);
            usedHistory.push(first.slug);
            dayPlan.kcal += first.kcal;
            dayPlan.protein += first.protein;
            dayPlan.fat += first.fat;
            dayPlan.carb += first.carb;
            dayPlan.fiber += first.fiber;
          }

          // Add 2nd if calories are low (<60% target)
          if (first && dayPlan.kcal < calTarget * 0.6 && meal !== 'chieu') {
            var remTarget = target - first.kcal;
            var second = pickBest(mealPool, Math.max(remTarget, 150), usedHistory);
            if (second && second.slug !== first.slug) {
              picked.push(second);
              usedHistory.push(second.slug);
              dayPlan.kcal += second.kcal;
              dayPlan.protein += second.protein;
              dayPlan.fat += second.fat;
              dayPlan.carb += second.carb;
              dayPlan.fiber += second.fiber;
            }
          }

          dayPlan.meals.push({ meal: meal, items: picked, target: target });
        });

        // Add 1-2 snack items for calorie gap
        var calDiff = calTarget - dayPlan.kcal;
        if (calDiff > 150) {
          var snackPool = mealPools.phu || [];
          if (snackPool.length < 2) snackPool = leftover.concat(pool.filter(function(r){return r.kcal < 200;}));
          var snackCount = calDiff > 350 ? 2 : 1;
          for (var s = 0; s < snackCount; s++) {
            var snackTarget = Math.min(calDiff / (snackCount - s), 250);
            var snack = pickBest(snackPool, snackTarget, usedHistory);
            if (snack) {
              usedHistory.push(snack.slug);
              dayPlan.kcal += snack.kcal;
              dayPlan.protein += snack.protein;
              dayPlan.fat += snack.fat;
              dayPlan.carb += snack.carb;
              dayPlan.fiber += snack.fiber;
              dayPlan.meals.push({ meal: 'phu', items: [snack], target: snackTarget });
            }
          }
        }

        // Update week totals
        weekTotals.kcal += dayPlan.kcal;
        weekTotals.protein += dayPlan.protein;
        weekTotals.fat += dayPlan.fat;
        weekTotals.carb += dayPlan.carb;
        weekTotals.fiber += dayPlan.fiber;

        plan.push(dayPlan);
      }

      renderPlan(plan, calTarget, disease);
      renderWeekSummary(weekTotals);
      renderTip(disease, dietMode);

      document.getElementById('exportBtn').style.display = 'inline-block';
      $loading.style.display = 'none';
    }, 100);
  };

  function renderPlan(plan, calTarget, disease) {
    var html = plan.map(function(day, idx) {
      var diff = day.kcal - calTarget;
      var diffBadge = '';
      if (diff > 100) diffBadge = '<span class="badge-hi">+' + Math.round(diff) + ' kcal</span>';
      else if (diff < -100) diffBadge = '<span class="badge-lo">' + Math.round(diff) + ' kcal</span>';
      else diffBadge = '<span class="badge-ok">✓ ' + Math.round(day.kcal) + ' kcal</span>';

      var mealsHtml = day.meals.map(function(m) {
        if (!m.items || m.items.length === 0) return '';
        var label = MEAL_VI[m.meal] || '🍿 Phụ';
        var itemsHtml = m.items.map(function(item) {
          return '<a class="meal-badge" href="/mon-an/' + item.slug + '">' + item.name + ' <small>(' + Math.round(item.kcal) + ' kcal)</small></a>';
        }).join('');
        return '<div class="meal-row"><span class="meal-lbl">' + label + '</span><div class="meal-items">' + itemsHtml + '</div></div>';
      }).join('');

      return '<div class="day-card">' +
        '<div class="day-head" onclick="this.classList.toggle(\'collapsed\');this.nextElementSibling.classList.toggle(\'collapsed\')">' +
        '<span class="day-name">' + DAY_NAMES[idx] + '</span>' +
        '<span class="day-cal">' + diffBadge + '</span>' +
        '<span class="day-toggle">▼</span></div>' +
        '<div class="day-body">' + mealsHtml +
        '<div class="day-total">🥩 ' + day.protein.toFixed(0) + 'g · 🧈 ' + day.fat.toFixed(0) + 'g · 🌾 ' + day.carb.toFixed(0) + 'g · 🌱 ' + day.fiber.toFixed(0) + 'g xơ</div>' +
        '</div></div>';
    }).join('');

    document.getElementById('planContainer').innerHTML = '<div class="plan-grid">' + html + '</div>';
    document.getElementById('planContainer').scrollIntoView({ behavior:'smooth', block:'start' });
  }

  function renderWeekSummary(totals) {
    var avg = {
      kcal: totals.kcal / 7,
      protein: totals.protein / 7,
      fat: totals.fat / 7,
      carb: totals.carb / 7,
      fiber: totals.fiber / 7
    };
    document.getElementById('weekSummary').innerHTML =
      '<div class="ws-header">📊 Tổng kết tuần</div>' +
      '<div class="ws-grid">' +
      '<div class="ws-item"><div class="ws-val">🔥 ' + Math.round(avg.kcal) + '</div><div class="ws-lbl">kcal/ngày (TB)</div></div>' +
      '<div class="ws-item"><div class="ws-val">🥩 ' + avg.protein.toFixed(0) + 'g</div><div class="ws-lbl">Đạm/ngày</div></div>' +
      '<div class="ws-item"><div class="ws-val">🧈 ' + avg.fat.toFixed(0) + 'g</div><div class="ws-lbl">Béo/ngày</div></div>' +
      '<div class="ws-item"><div class="ws-val">🌾 ' + avg.carb.toFixed(0) + 'g</div><div class="ws-lbl">Carb/ngày</div></div>' +
      '<div class="ws-item"><div class="ws-val">🌱 ' + avg.fiber.toFixed(0) + 'g</div><div class="ws-lbl">Xơ/ngày</div></div>' +
      '<div class="ws-item"><div class="ws-val">🗓️ 7 ngày</div><div class="ws-lbl">' + Math.round(totals.kcal) + ' tổng kcal</div></div>' +
      '</div>';
    document.getElementById('weekSummary').style.display = 'block';
  }

  function renderTip(disease, dietMode) {
    var $tip = document.getElementById('healthTip');
    if (disease && DISEASE[disease]) {
      $tip.innerHTML = '<h3>💡 Lời khuyên ' + DISEASE[disease].tip + '</h3>';
      $tip.style.display = 'block';
    } else if (dietMode) {
      var tips = { 'it-natri':'Chọn thực phẩm tươi, hạn chế gia vị mặn. <5g muối/ngày.', 'it-mo':'Hạn chế thịt đỏ nhiều mỡ, ưu tiên cá và thịt gia cầm bỏ da.', 'nhieu-xo':'Mỗi bữa nên có rau/củ/quả. Đặt mục tiêu 25-30g xơ/ngày.', 'it-do-ngot':'Hạn chế đường bổ sung. Dùng trái cây tươi thay đồ ngọt.' };
      $tip.innerHTML = '<h3>💡 ' + (tips[dietMode] || '') + '</h3>';
      $tip.style.display = 'block';
    } else {
      $tip.style.display = 'none';
    }
  }

  window.exportPlan = function() {
    var text = '🗓️ THỰC ĐƠN TUẦN\n';
    text += 'Ngày: ' + new Date().toLocaleDateString('vi-VN') + '\n';
    text += 'Calo mục tiêu: ' + document.getElementById('calTarget').value + ' kcal/ngày\n';

    if (document.getElementById('diseaseFilter').value) {
      text += 'Bệnh lý: ' + document.getElementById('diseaseFilter').options[document.getElementById('diseaseFilter').selectedIndex].text + '\n';
    }
    text += '━━━━━━━━━━━━━━━━\n\n';

    var cards = document.querySelectorAll('.day-card');
    cards.forEach(function(card, idx) {
      text += DAY_NAMES[idx] + '\n';
      var rows = card.querySelectorAll('.meal-row');
      rows.forEach(function(row) {
        var lbl = row.querySelector('.meal-lbl');
        var items = row.querySelectorAll('.meal-badge');
        if (lbl) {
          var names = [];
          items.forEach(function(item) { names.push(item.textContent.trim()); });
          text += '  ' + lbl.textContent.trim() + ': ' + names.join(', ') + '\n';
        }
      });
      var total = card.querySelector('.day-total');
      if (total) text += '  ' + total.textContent.trim() + '\n';
      text += '\n';
    });

    // Copy to clipboard
    navigator.clipboard.writeText(text).then(function() {
      alert('✅ Đã sao chép thực đơn! Dán vào ghi chú hoặc chat.');
    }).catch(function() {
      // Fallback: create temp textarea
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      alert('✅ Đã sao chép thực đơn!');
    });
  };
})();
</script>

