---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";

// Precompute all recipe data for embedding
const recipeData = recipes.map(r => {
  const n = calculateRecipe(r);
  return {
    slug: r.slug,
    name: r.name,
    tags: r.tags || [],
    mealContexts: r.mealContexts || [],
    kcal: n.energyKcal || 0,
    protein: n.proteinG || 0,
    fat: n.fatG || 0,
    carb: n.carbG || 0,
    fiber: n.fiberG || 0,
    sodium: n.sodiumMg || 0,
    satFat: n.satFatG || 0,
    sugar: n.sugarG || 0,
    servingName: r.servingName || "",
  };
});

// Meal-type classifier based on recipe name and tags
function classifyMeal(r) {
  const n = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
  const mealContexts = r.mealContexts || [];
  if (mealContexts.includes("communal") || mealContexts.includes("dinner-heavy")) return "trua";
  // Breakfast
  if (["phở","bún","cháo","bánh mì","xôi","sữa","trứng","bánh cuốn","bánh ướt","bánh hỏi","bánh bèo","bánh giò","bánh đúc","bánh tráng","bánh căn","bánh khọt","bánh xèo","bánh cống","bánh dày","bánh cam","bánh gối","bánh chuối","bánh da lợn","bánh bò","bánh flan","chè bà ba","chè đậu"].some(k => n.includes(k))) return "sang";
  // Drink/dessert
  if (["chè","sinh tố","nước","trà","cà phê","sữa","kem","yaourt","sữa chua","đồ uống"].some(k => n.includes(k))) return "phu";
  // Lẩu thường là bữa tụ tập, nhiều nước dùng và dễ nặng bụng hơn; không ưu tiên xếp mặc định vào bữa tối.
  if (["lẩu"].some(k => n.includes(k))) return "trua";
  // Soup/stew for dinner
  if (["canh","súp","tiết canh","cháo lòng","cháo huyết","cháo lươn"].some(k => n.includes(k))) return "toi";
  return "trua"; // default to lunch
}

function isDinnerFriendly(r) {
  const mealContexts = r.mealContexts || [];
  if (mealContexts.includes("communal") || mealContexts.includes("dinner-heavy")) return false;
  if (mealContexts.includes("dinner-light")) return true;
  const n = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
  if (n.includes("lẩu") || n.includes(" lau ") || n.startsWith("lau ")) return false;
  if (r.kcal > 520) return false;
  if (r.fat > 18) return false;
  if (r.sodium > 700) return false;
  if (r.satFat > 6) return false;
  if (["chiên", "rán", "xôi", "nướng", "buffet"].some(k => n.includes(k))) return false;
  return true;
}

const MEAL_MAP = { sang: [], trua: [], chieu: [], toi: [], phu: [] };
recipeData.forEach(r => {
  const meal = classifyMeal(r);
  MEAL_MAP[meal].push(r);
});
const MEAL_KEYS = ["sang","trua","chieu","toi"];
const MEAL_VI = { sang: "🌅 Sáng", trua: "🌞 Trưa", chieu: "🌆 Chiều", toi: "🌙 Tối", phu: "🍿 Phụ" };
const MEAL_PCT = { sang: 0.25, trua: 0.35, chieu: 0.10, toi: 0.30 };
const DAY_NAMES = ["Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ Nhật"];

const SAFETY_GROUPS = {
  tieuDuong: "Đái tháo đường, tiền đái tháo đường, đang dùng insulin hoặc thuốc hạ đường huyết",
  tangHuyetAp: "Tăng huyết áp, bệnh tim mạch, suy tim hoặc đang dùng thuốc liên quan",
  suyThan: "Bệnh thận hoặc cần theo dõi kali/phospho/natri kỹ hơn",
  gout: "Gout hoặc acid uric cao",
  thaiKy: "Thai kỳ, cho con bú, trẻ em, người cao tuổi hoặc đang có nhu cầu dinh dưỡng đặc biệt",
};

const ALL_SAFETY_KEYS = Object.keys(SAFETY_GROUPS);
---

<BaseLayout title="Lập thực đơn tuần tự động - Dinh dưỡng Việt" canonical="/cong-cu/lap-thuc-don-tuan">
  <span class="badge">⭐ Công cụ</span>
  <h1>🗓️ Lập thực đơn tuần tự động</h1>
  <p class="lead">Gợi ý khung thực đơn 7 ngày ở mức tham khảo từ món Việt quen thuộc, giúp bạn sắp xếp bữa ăn nhiều ngày mà không thay thế tư vấn chuyên môn.</p>

  <div class="disclaimer">Khung thực đơn và các con số trong trang này chỉ là ước tính tham khảo. Nếu bạn có bệnh nền, dùng thuốc, mang thai, đang nuôi con bú, là trẻ em, người cao tuổi hoặc cần chế độ ăn cần theo dõi riêng, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi áp dụng.</div>

  <section class="card config-section">
    <div class="config-grid">
      <div class="conf-item">
        <label>🎯 Mức năng lượng tham khảo mỗi ngày</label>
        <select id="calTarget">
          <option value="1500">1500 kcal — Mốc tham khảo nhẹ</option>
          <option value="1800">1800 kcal — Mốc tham khảo vừa</option>
          <option value="2000" selected>2000 kcal — Mốc tham khảo phổ biến</option>
          <option value="2300">2300 kcal — Mốc tham khảo cao hơn</option>
          <option value="2600">2600 kcal — Mốc tham khảo cho ngày hoạt động nhiều</option>
          <option value="3000">3000 kcal — Mốc tham khảo rất cao</option>
        </select>
      </div>
      <div class="conf-item">
        <label>🩺 Trường hợp cần hỏi chuyên môn</label>
        <select id="diseaseFilter">
          <option value="">Không có</option>
          {ALL_SAFETY_KEYS.map(k => <option value={k}>{SAFETY_GROUPS[k]}</option>)}
        </select>
      </div>
      <div class="conf-item">
        <label>🍳 Bữa sáng</label>
        <select id="breakfastMode">
          <option value="auto">Tự động</option>
          <option value="none">Không ăn sáng</option>
          <option value="light">Nhẹ (cháo/bánh mì)</option>
          <option value="heavy">Lớn (phở/bún/xôi)</option>
        </select>
      </div>
      <div class="conf-item">
        <label>🥗 Ưu tiên tham khảo</label>
        <select id="dietMode">
          <option value="">Không</option>
          <option value="it-natri">Ít natri</option>
          <option value="it-mo">Ít chất béo bão hòa</option>
          <option value="nhieu-xo">Nhiều chất xơ</option>
          <option value="it-do-ngot">Ít đường</option>
        </select>
      </div>
    </div>

    <div class="gen-row">
      <button class="btn-gen" onclick="generatePlan()">✨ Tạo thực đơn tuần</button>
      <button class="btn-outline" onclick="exportPlan()" id="exportBtn" style="display:none;">📤 Xuất văn bản</button>
      <button class="btn-outline" onclick="openShoppingFromPlan()" id="shoppingBtn" style="display:none;">🛒 Tạo danh sách đi chợ</button>
    </div>
  </section>

  <div id="loading" class="loading-state">🔄 Đang tính toán thực đơn...</div>
  <div id="planContainer"></div>
  <div id="weekSummary" class="week-summary" style="display:none;"></div>
  <div id="healthTip" class="health-tip" style="display:none;"></div>

  <!-- Embedded recipe data for client script -->
  <div id="recipe-data-store" style="display:none" data-recipes={JSON.stringify(recipeData || [])} data-meal-map={JSON.stringify(Object.fromEntries(MEAL_KEYS.map(k => [k, MEAL_MAP[k].map(r => r.slug)])))}></div>

  <script is:inline>
(function() {
  var store = document.getElementById('recipe-data-store');
  var RECIPES = JSON.parse(store.getAttribute('data-recipes') || '[]');
  var MEAL_MAP = JSON.parse(store.getAttribute('data-meal-map') || '{}');
  var MEAL_KEYS = ["sang","trua","chieu","toi"];
  var MEAL_VI = { sang:"🌅 Sáng", trua:"🌞 Trưa", chieu:"🌆 Chiều", toi:"🌙 Tối" };
  var MEAL_PCT = { sang:0.25, trua:0.35, chieu:0.10, toi:0.30 };
  var DAY_NAMES = ["Thứ Hai","Thứ Ba","Thứ Tư","Thứ Năm","Thứ Sáu","Thứ Bảy","Chủ Nhật"];
  var PLAN_STORAGE_KEY = "ddv_week_plan_v1";
  var currentPlan = null;
  var SAFETY_GROUPS = {
    tieuDuong: "Đái tháo đường, tiền đái tháo đường, đang dùng insulin hoặc thuốc hạ đường huyết",
    tangHuyetAp: "Tăng huyết áp, bệnh tim mạch, suy tim hoặc đang dùng thuốc liên quan",
    suyThan: "Bệnh thận hoặc cần theo dõi kali/phospho/natri kỹ hơn",
    gout: "Gout hoặc acid uric cao",
    thaiKy: "Thai kỳ, cho con bú, trẻ em, người cao tuổi hoặc đang có nhu cầu dinh dưỡng đặc biệt"
  };

  var DIET_FILTERS = {
    "it-natri": function(r) { return r.sodium < 300; },
    "it-mo": function(r) { return r.satFat < 6; },
    "nhieu-xo": function(r) { return r.fiber >= 3; },
    "it-do-ngot": function(r) { return r.sugar < 10; },
  };

  function isDinnerFriendly(r) {
    var mealContexts = r.mealContexts || [];
    if (mealContexts.indexOf("communal") !== -1 || mealContexts.indexOf("dinner-heavy") !== -1) return false;
    if (mealContexts.indexOf("dinner-light") !== -1) return true;
    var n = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
    if (n.indexOf("lẩu") !== -1 || n.indexOf(" lau ") !== -1 || n.indexOf("lau ") === 0) return false;
    if (r.kcal > 520) return false;
    if (r.fat > 18) return false;
    if (r.sodium > 700) return false;
    if (r.satFat > 6) return false;
    return !["chiên", "rán", "xôi", "nướng", "buffet"].some(function(k) { return n.indexOf(k) !== -1; });
  }

  // Pick recipe closest to target calories from a pool
  function pickBest(pool, targetCal, history) {
    if (pool.length === 0) return null;
    var available = history ? pool.filter(function(r) { return history.indexOf(r.slug) === -1; }) : pool.slice();
    if (available.length === 0) available = pool;

    var best = available[0];
    var bestDiff = Math.abs(best.kcal - targetCal);
    // Search up to 100 recipes for performance
    var limit = Math.min(100, available.length);
    for (var i = 1; i < limit; i++) {
      var diff = Math.abs(available[i].kcal - targetCal);
      if (diff < bestDiff) { bestDiff = diff; best = available[i]; }
    }
    return best;
  }

  window.generatePlan = function() {
    var $loading = document.getElementById('loading');
    $loading.style.display = 'block';

    setTimeout(function() {
      var calTarget = parseInt(document.getElementById('calTarget').value) || 2000;
      var disease = document.getElementById('diseaseFilter').value;
      var bfastMode = document.getElementById('breakfastMode').value;
      var dietMode = document.getElementById('dietMode').value;

      // Build pool
      var pool = RECIPES.filter(function(r){return r.kcal > 0;});

      // Diet filter
      if (dietMode && DIET_FILTERS[dietMode]) {
        pool = pool.filter(DIET_FILTERS[dietMode]);
      }

      if (pool.length < 7) {
        $loading.style.display = 'none';
        renderEmptyState('😕 Chưa đủ món cho bộ lọc đang chọn. Hãy thử đổi mốc tham khảo hoặc bỏ bớt ưu tiên lọc.');
        renderWeekSummary(null);
        renderTip(disease, dietMode);
        return;
      }

      // Build meal pools
      var mealPools = {};
      MEAL_KEYS.forEach(function(k) {
        var slugs = MEAL_MAP[k] || [];
        mealPools[k] = slugs.map(function(s) { return RECIPES.find(function(r){return r.slug===s;}) }).filter(Boolean);
      });
      var originalDinnerPool = mealPools.toi.slice();
      mealPools.toi = mealPools.toi.filter(isDinnerFriendly);
      if (mealPools.toi.length < 8) {
        mealPools.toi = originalDinnerPool.filter(function(r) {
          if ((r.mealContexts || []).includes("communal") || (r.mealContexts || []).includes("dinner-heavy")) return false;
          if ((r.mealContexts || []).includes("dinner-light")) return true;
          var n = (r.name + " " + (r.tags || []).join(" ")).toLowerCase();
          return !n.includes("lẩu") && !n.includes(" lau ") && !n.startsWith("lau ");
        });
      }
      // Fallback: recipes not in any meal map → lunch
      var leftover = pool.filter(function(r) {
        return !MEAL_KEYS.some(function(k){return (MEAL_MAP[k]||[]).indexOf(r.slug)!==-1;});
      });
      mealPools.trua = mealPools.trua.concat(leftover);

      // Breakfast mode: adjust morning pool
      if (bfastMode === 'none') {
        mealPools.sang = [];
        // redistribute breakfast calories
        MEAL_PCT.trua += 0.10;
        MEAL_PCT.toi += 0.10;
        MEAL_PCT.chieu += 0.05;
      } else if (bfastMode === 'light') {
        mealPools.sang = mealPools.sang.filter(function(r){return r.kcal < 350;});
      } else if (bfastMode === 'heavy') {
        mealPools.sang = mealPools.sang.filter(function(r){return r.kcal > 300;});
      }

      // Generate plan (7 days)
      var plan = [];
      var usedHistory = [];
      var weekTotals = { kcal:0, protein:0, fat:0, carb:0, fiber:0 };

      for (var day = 0; day < 7; day++) {
        var dayPlan = { meals: [], kcal: 0, protein: 0, fat: 0, carb: 0, fiber: 0 };

        MEAL_KEYS.forEach(function(meal) {
          var target = calTarget * (MEAL_PCT[meal] || 0);
          var mealPool = mealPools[meal] || [];
          var picked = [];

          // Pick 1 main recipe
          var first = pickBest(mealPool, target, usedHistory);
          if (first) {
            picked.push(first);
            usedHistory.push(first.slug);
            dayPlan.kcal += first.kcal;
            dayPlan.protein += first.protein;
            dayPlan.fat += first.fat;
            dayPlan.carb += first.carb;
            dayPlan.fiber += first.fiber;
          }

          // Add 2nd if calories are low (<60% target)
          if (first && dayPlan.kcal < calTarget * 0.6 && meal !== 'chieu') {
            var remTarget = target - first.kcal;
            var second = pickBest(mealPool, Math.max(remTarget, 150), usedHistory);
            if (second && second.slug !== first.slug) {
              picked.push(second);
              usedHistory.push(second.slug);
              dayPlan.kcal += second.kcal;
              dayPlan.protein += second.protein;
              dayPlan.fat += second.fat;
              dayPlan.carb += second.carb;
              dayPlan.fiber += second.fiber;
            }
          }

          dayPlan.meals.push({ meal: meal, items: picked, target: target });
        });

        // Add 1-2 snack items for calorie gap
        var calDiff = calTarget - dayPlan.kcal;
        if (calDiff > 150) {
          var snackPool = mealPools.phu || [];
          if (snackPool.length < 2) snackPool = leftover.concat(pool.filter(function(r){return r.kcal < 200;}));
          var snackCount = calDiff > 350 ? 2 : 1;
          for (var s = 0; s < snackCount; s++) {
            var snackTarget = Math.min(calDiff / (snackCount - s), 250);
            var snack = pickBest(snackPool, snackTarget, usedHistory);
            if (snack) {
              usedHistory.push(snack.slug);
              dayPlan.kcal += snack.kcal;
              dayPlan.protein += snack.protein;
              dayPlan.fat += snack.fat;
              dayPlan.carb += snack.carb;
              dayPlan.fiber += snack.fiber;
              dayPlan.meals.push({ meal: 'phu', items: [snack], target: snackTarget });
            }
          }
        }

        // Update week totals
        weekTotals.kcal += dayPlan.kcal;
        weekTotals.protein += dayPlan.protein;
        weekTotals.fat += dayPlan.fat;
        weekTotals.carb += dayPlan.carb;
        weekTotals.fiber += dayPlan.fiber;

        plan.push(dayPlan);
      }

      currentPlan = {
        createdAt: new Date().toISOString(),
        calTarget: calTarget,
        disease: disease,
        dietMode: dietMode,
        days: plan.map(function(day, idx) {
          return {
            dayIndex: idx,
            dayName: DAY_NAMES[idx],
            recipeSlugs: day.meals.reduce(function(acc, meal) {
              (meal.items || []).forEach(function(item) { acc.push(item.slug); });
              return acc;
            }, [])
          };
        })
      };
      try { localStorage.setItem(PLAN_STORAGE_KEY, JSON.stringify(currentPlan)); } catch(e) {}

      renderPlan(plan, calTarget, disease);
      renderWeekSummary(weekTotals);
      renderTip(disease, dietMode);

      document.getElementById('exportBtn').style.display = 'inline-block';
      document.getElementById('shoppingBtn').style.display = 'inline-block';
      $loading.style.display = 'none';
    }, 100);
  };

  function renderPlan(plan, calTarget, disease) {
    var container = document.getElementById('planContainer');
    var grid = document.createElement('div');
    grid.className = 'plan-grid';

    plan.forEach(function(day, idx) {
      var dayCard = document.createElement('div');
      dayCard.className = 'day-card';

      var dayHead = document.createElement('button');
      dayHead.type = 'button';
      dayHead.className = 'day-head';

      var dayName = document.createElement('span');
      dayName.className = 'day-name';
      dayName.textContent = DAY_NAMES[idx];

      var dayCal = document.createElement('span');
      dayCal.className = 'day-cal';
      dayCal.textContent = Math.round(day.kcal) + ' kcal tham khảo';

      var dayToggle = document.createElement('span');
      dayToggle.className = 'day-toggle';
      dayToggle.textContent = '▼';

      dayHead.appendChild(dayName);
      dayHead.appendChild(dayCal);
      dayHead.appendChild(dayToggle);

      var dayBody = document.createElement('div');
      dayBody.className = 'day-body';

      dayHead.addEventListener('click', function() {
        dayHead.classList.toggle('collapsed');
        dayBody.classList.toggle('collapsed');
      });

      day.meals.forEach(function(m) {
        if (!m.items || m.items.length === 0) return;
        var row = document.createElement('div');
        row.className = 'meal-row';

        var label = document.createElement('span');
        label.className = 'meal-lbl';
        label.textContent = MEAL_VI[m.meal] || '🍿 Phụ';

        var itemsWrap = document.createElement('div');
        itemsWrap.className = 'meal-items';

        m.items.forEach(function(item) {
          var link = document.createElement('a');
          link.className = 'meal-badge';
          link.href = '/mon-an/' + item.slug;
          link.textContent = item.name;

          var small = document.createElement('small');
          small.textContent = '(' + Math.round(item.kcal) + ' kcal)';
          link.appendChild(small);
          itemsWrap.appendChild(link);
        });

        row.appendChild(label);
        row.appendChild(itemsWrap);
        dayBody.appendChild(row);
      });

      var total = document.createElement('div');
      total.className = 'day-total';
      total.textContent = 'Ước tính tham khảo: ' +
        'Đạm ' + day.protein.toFixed(0) + 'g · ' +
        'Béo ' + day.fat.toFixed(0) + 'g · ' +
        'Carb ' + day.carb.toFixed(0) + 'g · ' +
        'Xơ ' + day.fiber.toFixed(0) + 'g';

      dayBody.appendChild(total);
      dayCard.appendChild(dayHead);
      dayCard.appendChild(dayBody);
      grid.appendChild(dayCard);
    });

    container.replaceChildren(grid);
    container.scrollIntoView({ behavior:'smooth', block:'start' });
  }

  function renderWeekSummary(totals) {
    var summary = document.getElementById('weekSummary');
    if (!totals) {
      summary.replaceChildren();
      summary.style.display = 'none';
      return;
    }

    var avg = {
      kcal: totals.kcal / 7,
      protein: totals.protein / 7,
      fat: totals.fat / 7,
      carb: totals.carb / 7,
      fiber: totals.fiber / 7
    };
    var header = document.createElement('div');
    header.className = 'ws-header';
    header.textContent = '📊 Tổng kết tuần (tham khảo)';

    var grid = document.createElement('div');
    grid.className = 'ws-grid';

    [
      ['🔥 ' + Math.round(avg.kcal), 'kcal/ngày (TB)'],
      ['🥩 ' + avg.protein.toFixed(0) + 'g', 'Đạm/ngày'],
      ['🧈 ' + avg.fat.toFixed(0) + 'g', 'Béo/ngày'],
      ['🌾 ' + avg.carb.toFixed(0) + 'g', 'Carb/ngày'],
      ['🌱 ' + avg.fiber.toFixed(0) + 'g', 'Xơ/ngày'],
      ['🗓️ 7 ngày', Math.round(totals.kcal) + ' tổng kcal ước tính']
    ].forEach(function(entry) {
      var item = document.createElement('div');
      item.className = 'ws-item';

      var val = document.createElement('div');
      val.className = 'ws-val';
      val.textContent = entry[0];

      var lbl = document.createElement('div');
      lbl.className = 'ws-lbl';
      lbl.textContent = entry[1];

      item.appendChild(val);
      item.appendChild(lbl);
      grid.appendChild(item);
    });

    summary.replaceChildren(header, grid);
    summary.style.display = 'block';
  }

  function renderTip(disease, dietMode) {
    var $tip = document.getElementById('healthTip');
    $tip.replaceChildren();

    var fragments = [];
    if (disease && SAFETY_GROUPS[disease]) {
      fragments.push('Nhóm "' + SAFETY_GROUPS[disease] + '" cần hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi áp dụng thực đơn nhiều ngày.');
    }
    if (dietMode) {
      var tips = {
        'it-natri':'Nếu bạn đang ưu tiên ít natri, hãy xem kết quả như gợi ý tham khảo và kiểm tra lại khi có bệnh nền hoặc cần theo dõi riêng.',
        'it-mo':'Nếu bạn đang ưu tiên ít chất béo bão hòa, hãy xem kết quả như gợi ý tham khảo, không phải hướng dẫn cá thể hóa.',
        'nhieu-xo':'Nếu bạn đang ưu tiên nhiều chất xơ, hãy xem kết quả như gợi ý tham khảo và điều chỉnh cùng chuyên gia nếu có bệnh tiêu hóa, thận hoặc đái tháo đường.',
        'it-do-ngot':'Nếu bạn đang ưu tiên ít đường, hãy xem kết quả như gợi ý tham khảo và hỏi bác sĩ/chuyên gia khi đang theo dõi đường huyết hoặc dùng thuốc.'
      };
      if (tips[dietMode]) fragments.push(tips[dietMode]);
    }

    fragments.push('Không tự đổi thuốc, insulin, lợi tiểu hoặc chế độ ăn đang theo dõi dựa vào trang này.');

    if (fragments.length === 0) {
      $tip.style.display = 'none';
      return;
    }

    var title = document.createElement('h3');
    title.textContent = '💡 Lưu ý an toàn';
    $tip.appendChild(title);

    fragments.forEach(function(text) {
      var p = document.createElement('p');
      p.textContent = text;
      $tip.appendChild(p);
    });

    $tip.style.display = 'block';
  }

  function renderEmptyState(message) {
    var container = document.getElementById('planContainer');
    var empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = message;
    container.replaceChildren(empty);
  }

  window.exportPlan = function() {
    var text = '🗓️ THỰC ĐƠN TUẦN\n';
    text += 'Ngày: ' + new Date().toLocaleDateString('vi-VN') + '\n';
    text += 'Mốc năng lượng tham khảo: ' + document.getElementById('calTarget').value + ' kcal/ngày\n';

    if (document.getElementById('diseaseFilter').value) {
      text += 'Nhóm cần hỏi chuyên môn: ' + document.getElementById('diseaseFilter').options[document.getElementById('diseaseFilter').selectedIndex].text + '\n';
    }
    text += 'Lưu ý: đây là khung tham khảo, không thay thế tư vấn của bác sĩ hoặc chuyên gia dinh dưỡng.\n';
    text += '━━━━━━━━━━━━━━━━\n\n';

    var cards = document.querySelectorAll('.day-card');
    cards.forEach(function(card, idx) {
      text += DAY_NAMES[idx] + '\n';
      var rows = card.querySelectorAll('.meal-row');
      rows.forEach(function(row) {
        var lbl = row.querySelector('.meal-lbl');
        var items = row.querySelectorAll('.meal-badge');
        if (lbl) {
          var names = [];
          items.forEach(function(item) { names.push(item.textContent.trim()); });
          text += '  ' + lbl.textContent.trim() + ': ' + names.join(', ') + '\n';
        }
      });
      var total = card.querySelector('.day-total');
      if (total) text += '  ' + total.textContent.trim() + '\n';
      text += '\n';
    });

    // Copy to clipboard
    navigator.clipboard.writeText(text).then(function() {
      alert('✅ Đã sao chép thực đơn! Dán vào ghi chú hoặc chat.');
    }).catch(function() {
      // Fallback: create temp textarea
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      alert('✅ Đã sao chép thực đơn!');
    });
  };

  window.openShoppingFromPlan = function() {
    if (!currentPlan) {
      try { currentPlan = JSON.parse(localStorage.getItem(PLAN_STORAGE_KEY) || 'null'); } catch(e) {}
    }
    if (!currentPlan) {
      alert('Hãy tạo thực đơn tuần trước.');
      return;
    }
    window.location.href = '/cong-cu/danh-sach-di-cho?from=week-plan';
  };
})();
</script>

