---
import BaseLayout from "../../layouts/BaseLayout.astro";

const toolTitle = "Theo dõi sức khỏe";
const toolDesc =
  "Ghi nhật ký chỉ số sức khỏe để chuẩn bị thông tin khi trao đổi với bác sĩ hoặc chuyên gia.";

const safetySituations = [
  "Đang dùng thuốc huyết áp, thuốc hạ đường huyết, insulin, thuốc lợi tiểu hoặc nhiều thuốc cùng lúc",
  "Có triệu chứng như đau ngực, khó thở, ngất, lơ mơ, yếu liệt, run tay, vã mồ hôi hoặc mệt lả",
  "Đang mang thai, sau sinh, người cao tuổi yếu, trẻ em hoặc có bệnh nền phức tạp",
  "Có bệnh tim mạch, bệnh thận, bệnh gan, đái tháo đường, ung thư hoặc đang nằm viện",
  "Kết quả đo lặp lại khác thường so với sổ theo dõi hoặc chỉ dẫn trước đó của bác sĩ",
  "Muốn cá thể hóa chỉ số theo dõi, xét nghiệm hoặc kế hoạch dùng thuốc",
];

const prepItems = [
  "Ngày đo và thời điểm đo trong ngày",
  "Thiết bị đo, đơn vị đo và cách đo nếu có ghi chú",
  "Cân nặng, huyết áp, đường huyết, vòng eo hoặc xét nghiệm bạn muốn theo dõi",
  "Triệu chứng đi kèm, bữa ăn, vận động, giấc ngủ, stress hoặc rượu bia",
  "Danh sách thuốc đang dùng, liều đã được kê và thời điểm uống hoặc tiêm",
  "Kết quả xét nghiệm gần đây và sổ khám nếu có",
];
---

<BaseLayout title={`${toolTitle} | Dinh Dưỡng Việt`} description={toolDesc}>
  <main class="health-log-shell" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Nhật ký an toàn v1</p>
      <h1 id="page-title">{toolTitle}</h1>
      <p>
        Trang này chỉ giúp ghi lại chỉ số do bạn nhập để mang theo khi trao đổi
        với bác sĩ hoặc chuyên gia đang theo dõi. V1 không đặt ngưỡng cá nhân,
        không phân loại kết quả và không hướng dẫn thay đổi thuốc hay kế hoạch
        chăm sóc.
      </p>
    </section>

    <section class="notice-panel" aria-labelledby="scope-title">
      <h2 id="scope-title">Phạm vi hiện tại</h2>
      <p>
        Cân nặng, huyết áp, đường huyết, HbA1c, LDL, triglyceride và các chỉ số
        khác cần được cá thể hóa theo tuổi, chẩn đoán, thuốc, thai kỳ, bệnh nền,
        triệu chứng và kế hoạch theo dõi. Vì v1 chưa có quy trình khóa nguồn
        và duyệt lâm sàng riêng, công cụ này không diễn giải chỉ số và không
        thay thế tư vấn chuyên môn.
      </p>
    </section>

    <section class="log-panel" aria-labelledby="log-title">
      <div class="section-head">
        <p class="eyebrow">Ghi lại để trao đổi</p>
        <h2 id="log-title">Nhật ký chỉ số</h2>
        <p>
          Dữ liệu chỉ lưu trong trình duyệt của bạn. Hãy kiểm tra lại với thiết
          bị đo, sổ khám hoặc ứng dụng chính thức nếu cần dùng trong buổi khám.
        </p>
      </div>

      <div class="form-card" aria-label="Ghi nhật ký chỉ số sức khỏe">
        <label>
          Ngày đo
          <input id="ht-date" type="date" />
        </label>

        <label>
          Cân nặng (kg)
          <input id="ht-weight" type="number" inputmode="decimal" step="0.1" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          HA tâm thu
          <input id="ht-sys" type="number" inputmode="numeric" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          HA tâm trương
          <input id="ht-dia" type="number" inputmode="numeric" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          Đường huyết
          <input id="ht-glucose" type="number" inputmode="decimal" step="0.1" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          Vòng eo (cm)
          <input id="ht-waist" type="number" inputmode="decimal" step="0.1" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          HbA1c (%)
          <input id="ht-a1c" type="number" inputmode="decimal" step="0.1" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          LDL
          <input id="ht-ldl" type="number" inputmode="decimal" step="0.01" min="0" placeholder="Nhập nếu có" />
        </label>

        <label>
          Triglyceride
          <input id="ht-tg" type="number" inputmode="decimal" step="0.01" min="0" placeholder="Nhập nếu có" />
        </label>

        <label class="full-width">
          Ghi chú triệu chứng, bữa ăn, thuốc hoặc bối cảnh đo
          <textarea id="ht-note" rows="3" placeholder="Ví dụ: sau bữa tối, vừa vận động, đang dùng thuốc theo toa"></textarea>
        </label>

        <div class="button-row">
          <button type="button" class="primary-button" id="ht-save">Lưu vào nhật ký</button>
          <button type="button" class="secondary-button" id="ht-clear-form">Xóa form</button>
          <button type="button" class="secondary-button" id="ht-export">Xuất CSV</button>
        </div>
      </div>

      <div class="summary-strip" id="ht-summary" aria-live="polite"></div>
      <div class="table-card" id="ht-table" aria-live="polite"></div>
    </section>

    <section class="situation-panel" aria-labelledby="situation-title">
      <p class="eyebrow">Khi nào cần hỏi chuyên môn?</p>
      <h2 id="situation-title">Các tình huống cần cá thể hóa</h2>
      <div class="situation-grid">
        {safetySituations.map((item) => (
          <article class="situation-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="result-panel" aria-labelledby="result-title">
      <p class="result-label">Định hướng</p>
      <h2 id="result-title">Không đủ điều kiện đưa khuyến nghị cá nhân ở v1</h2>
      <p>
        Nếu có triệu chứng bất thường, kết quả lặp lại khác thường, đang dùng
        thuốc, đang mang thai hoặc có bệnh nền phức tạp, hãy liên hệ bác sĩ hoặc
        cơ sở y tế đang theo dõi. Không dùng trang này để thay đổi thuốc, lịch
        dùng thuốc, bữa ăn hoặc kế hoạch chăm sóc nếu chưa trao đổi với bác sĩ.
      </p>
    </section>

    <section class="prep-panel" aria-labelledby="prep-title">
      <p class="eyebrow">Chuẩn bị thông tin</p>
      <h2 id="prep-title">Nên mang theo khi đi hỏi</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>

  <script>
    (function () {
      var STORAGE_KEY = "health-track-v1";
      var entries = [];
      var fields = [
        ["weight", "Cân nặng", "kg"],
        ["sys", "HA tâm thu", ""],
        ["dia", "HA tâm trương", ""],
        ["glucose", "Đường huyết", ""],
        ["waist", "Vòng eo", "cm"],
        ["a1c", "HbA1c", "%"],
        ["ldl", "LDL", ""],
        ["tg", "Triglyceride", ""],
      ];

      function $(id) {
        return document.getElementById(id);
      }

      function today() {
        var now = new Date();
        var y = now.getFullYear();
        var m = String(now.getMonth() + 1).padStart(2, "0");
        var d = String(now.getDate()).padStart(2, "0");
        return y + "-" + m + "-" + d;
      }

      function readNumber(id) {
        var raw = $(id).value;
        if (raw === "") return null;
        var value = Number(raw);
        return Number.isFinite(value) ? value : null;
      }

      function load() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          entries = raw ? JSON.parse(raw) : [];
        } catch (error) {
          entries = [];
        }
        if (!Array.isArray(entries)) entries = [];
      }

      function persist() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
        } catch (error) {
          // Keep the page usable even if localStorage is unavailable.
        }
      }

      function clearForm() {
        fields.forEach(function (field) {
          $("ht-" + field[0]).value = "";
        });
        $("ht-note").value = "";
      }

      function setMessage(text, tone) {
        var el = $("ht-summary");
        el.textContent = text;
        el.className = "summary-strip" + (tone ? " is-" + tone : "");
      }

      function saveEntry() {
        var entry = {
          id: String(Date.now()),
          date: $("ht-date").value || today(),
          note: $("ht-note").value.trim(),
        };
        fields.forEach(function (field) {
          entry[field[0]] = readNumber("ht-" + field[0]);
        });

        var hasMetric = fields.some(function (field) {
          return entry[field[0]] !== null;
        });
        if (!hasMetric && !entry.note) {
          setMessage("Hãy nhập ít nhất một chỉ số hoặc ghi chú để lưu nhật ký.", "warn");
          return;
        }

        entries.push(entry);
        entries.sort(function (a, b) {
          return a.date < b.date ? -1 : a.date > b.date ? 1 : 0;
        });
        persist();
        render();
        clearForm();
        setMessage("Đã lưu nhật ký. Trang không diễn giải chỉ số hoặc đưa khuyến nghị cá nhân.", "ok");
      }

      function deleteEntry(id) {
        entries = entries.filter(function (entry) {
          return entry.id !== id;
        });
        persist();
        render();
        setMessage("Đã xóa một dòng nhật ký.", "ok");
      }

      function formatMetric(entry, field) {
        var value = entry[field[0]];
        if (value === null || value === undefined) return "";
        return String(value) + (field[2] ? " " + field[2] : "");
      }

      function render() {
        var table = $("ht-table");
        if (!entries.length) {
          table.innerHTML =
            '<div class="empty-state">Chưa có dữ liệu. Bạn có thể dùng trang này như nhật ký local để chuẩn bị thông tin đi khám.</div>';
          setMessage("0 dòng nhật ký. Không có diễn giải chỉ số.", "");
          return;
        }

        var latest = entries.slice().reverse();
        var html =
          '<div class="table-scroll"><table class="ht-table"><thead><tr><th>Ngày</th><th>Chỉ số đã ghi</th><th>Ghi chú</th><th></th></tr></thead><tbody>';
        latest.forEach(function (entry) {
          var metrics = fields
            .map(function (field) {
              var text = formatMetric(entry, field);
              return text ? field[1] + ": " + text : "";
            })
            .filter(Boolean)
            .join("; ");
          html +=
            "<tr><td>" +
            entry.date +
            "</td><td>" +
            escapeHtml(metrics || "Chỉ có ghi chú") +
            "</td><td>" +
            escapeHtml(entry.note || "") +
            '</td><td><button type="button" class="small-button" data-delete="' +
            entry.id +
            '">Xóa</button></td></tr>';
        });
        html += "</tbody></table></div>";
        table.innerHTML = html;
        Array.prototype.forEach.call(table.querySelectorAll("[data-delete]"), function (button) {
          button.addEventListener("click", function () {
            deleteEntry(button.getAttribute("data-delete"));
          });
        });
        setMessage(entries.length + " dòng nhật ký. Trang chỉ lưu dữ liệu bạn nhập.", "ok");
      }

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function exportCSV() {
        if (!entries.length) {
          setMessage("Chưa có dữ liệu để xuất CSV.", "warn");
          return;
        }
        var header = ["Ngay"].concat(fields.map(function (field) { return field[1]; }), ["Ghi chu"]);
        var rows = entries.map(function (entry) {
          return [entry.date]
            .concat(fields.map(function (field) {
              var value = entry[field[0]];
              return value === null || value === undefined ? "" : value;
            }))
            .concat([entry.note || ""]);
        });
        var csv = [header].concat(rows).map(function (row) {
          return row.map(function (cell) {
            return '"' + String(cell).replace(/"/g, '""') + '"';
          }).join(",");
        }).join("\n");
        var blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
        var link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "nhat-ky-suc-khoe-" + today() + ".csv";
        link.click();
        URL.revokeObjectURL(link.href);
      }

      $("ht-date").value = today();
      $("ht-save").addEventListener("click", saveEntry);
      $("ht-clear-form").addEventListener("click", clearForm);
      $("ht-export").addEventListener("click", exportCSV);
      load();
      render();
    })();
  </script>

  <style is:global>
    .health-log-shell {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 0 44px;
    }

    .health-log-shell section {
      margin-bottom: 18px;
    }

    .hero-panel,
    .notice-panel,
    .log-panel,
    .situation-panel,
    .result-panel,
    .prep-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .hero-panel {
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.08), rgba(34, 197, 94, 0.08));
    }

    .eyebrow,
    .result-label {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .health-log-shell h1,
    .health-log-shell h2 {
      margin: 0 0 10px;
      line-height: 1.25;
    }

    .health-log-shell h1 {
      font-size: 1.75rem;
    }

    .health-log-shell h2 {
      font-size: 1.16rem;
    }

    .health-log-shell p,
    .health-log-shell li,
    .health-log-shell label {
      color: var(--ink-secondary);
      line-height: 1.65;
    }

    .health-log-shell p {
      margin: 0;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .form-card {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      background: var(--bg);
    }

    .form-card label {
      display: grid;
      gap: 6px;
      font-weight: 700;
      font-size: 0.88rem;
    }

    .form-card input,
    .form-card textarea {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      background: var(--card);
      color: var(--ink);
      font: inherit;
      padding: 10px 12px;
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    .form-card input:focus,
    .form-card textarea:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .form-card textarea {
      resize: vertical;
    }

    .full-width,
    .button-row {
      grid-column: 1 / -1;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .primary-button,
    .secondary-button,
    .small-button {
      min-height: 42px;
      border-radius: var(--radius);
      border: 1px solid var(--card-border);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      padding: 10px 14px;
      transition: background var(--transition), border-color var(--transition), transform var(--transition);
    }

    .primary-button {
      background: var(--brand);
      border-color: var(--brand);
      color: #fff;
    }

    .primary-button:hover {
      background: var(--brand-dark);
      border-color: var(--brand-dark);
      transform: translateY(-1px);
    }

    .primary-button:active {
      transform: translateY(0);
    }

    .secondary-button,
    .small-button {
      background: var(--card);
      color: var(--ink);
    }

    .secondary-button:hover {
      border-color: var(--brand);
      color: var(--brand);
      transform: translateY(-1px);
    }

    .secondary-button:active {
      transform: translateY(0);
    }

    .small-button {
      min-height: 34px;
      padding: 6px 10px;
      font-size: 0.8rem;
    }

    .small-button:hover {
      border-color: var(--brand);
      color: var(--brand);
    }

    .summary-strip {
      margin: 14px 0;
      padding: 12px 14px;
      border-radius: var(--radius);
      background: var(--brand-light);
      color: var(--ink-secondary);
      font-weight: 700;
    }

    .summary-strip.is-ok {
      background: #e8f5ee;
      color: #217245;
    }

    .summary-strip.is-warn {
      background: #fff7ed;
      color: #9a3412;
    }

    .table-card {
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }

    .table-scroll {
      overflow-x: auto;
    }

    .ht-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 680px;
      font-size: 0.86rem;
    }

    .ht-table th,
    .ht-table td {
      padding: 10px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }

    .ht-table th {
      color: var(--ink-secondary);
      font-size: 0.78rem;
    }

    .empty-state {
      padding: 18px;
      color: var(--ink-secondary);
      text-align: center;
    }

    .situation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .situation-card {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 12px;
      background: var(--bg);
    }

    .situation-card span {
      display: inline-grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      flex: 0 0 auto;
      background: var(--brand-light);
      color: var(--brand);
      font-weight: 900;
    }

    .prep-panel ul {
      margin: 0;
      padding-left: 20px;
    }

    @media (max-width: 700px) {
      .health-log-shell {
        padding: 18px 0 34px;
      }

      .hero-panel,
      .notice-panel,
      .log-panel,
      .situation-panel,
      .result-panel,
      .prep-panel {
        padding: 16px;
      }

      .form-card,
      .situation-grid {
        grid-template-columns: 1fr;
      }

      .button-row {
        display: grid;
      }

      .primary-button,
      .secondary-button {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
