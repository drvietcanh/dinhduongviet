---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist nhiễm trùng tiểu tái diễn";
const desc = "Bảng kiểm uống nước, thuốc và dấu hiệu cảnh báo khi nhiễm trùng tiểu tái diễn.";
const items = [
  "Tôi ghi số lần tái phát, triệu chứng, kết quả cấy nước tiểu và thuốc đã dùng",
  "Tôi uống đủ theo bệnh nền và chỉ dẫn, không cố uống quá nhiều nếu suy tim hoặc bệnh thận",
  "Tôi dùng kháng sinh đúng đơn, đủ thời gian và báo tác dụng phụ/tiêu chảy",
  "Tôi không tự mua kháng sinh, thuốc lợi tiểu, thuốc nam hoặc sản phẩm cranberry thay điều trị",
  "Tôi trao đổi về táo bón, tiểu không hết, sỏi, phì đại tuyến tiền liệt hoặc yếu tố làm tái phát",
  "Tôi biết dấu hiệu sốt, rét run, đau hông lưng, nôn hoặc lơ mơ cần khám sớm",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-nhiem-trung-tieu-tai-dien">
  <main class="uti-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thận – tiết niệu</p>
      <h1>🚻 Checklist nhiễm trùng tiểu tái diễn</h1>
      <p>{desc} Cần tìm nguyên nhân và cấy nước tiểu khi phù hợp, không chỉ xử lý từng đợt.</p>
    </header>
    <form id="uti-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-uti /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám ngay khi</h2>
      <p>Sốt hoặc rét run, đau hông lưng, nôn, tiểu ra máu nhiều, tụt huyết áp, lú lẫn hoặc đang mang thai.</p>
      <p class="warning">Không trì hoãn khám để tự uống nước ép, cranberry hoặc thuốc còn thừa.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("uti-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-uti]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký triệu chứng, kết quả xét nghiệm và danh sách thuốc khi khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ thận–tiết niệu về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .uti-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .uti-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
