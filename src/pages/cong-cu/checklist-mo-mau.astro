---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng mỡ máu";
const desc = "Bảng kiểm thói quen hỗ trợ kiểm soát cholesterol và triglyceride cao.";
const items = [
  "Tôi biết kết quả LDL-C, HDL-C, triglyceride gần nhất và mục tiêu bác sĩ đặt ra",
  "Tôi giảm đồ uống có đường, bánh kẹo và tinh bột tinh chế thường xuyên",
  "Tôi hạn chế rượu bia, đặc biệt khi triglyceride cao",
  "Tôi ưu tiên cá, đậu, rau, ngũ cốc nguyên hạt và chất béo không bão hòa",
  "Tôi giảm thịt chế biến, da/mỡ động vật và món chiên nhiều lần",
  "Tôi dùng statin hoặc thuốc khác đúng hướng dẫn và đã báo mọi thực phẩm bổ sung",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-mo-mau">
  <main class="lipid-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chuyển hóa</p>
      <h1>🫀 Checklist mỡ máu</h1>
      <p>{desc} Thay đổi ăn uống cần đi cùng vận động, thuốc và theo dõi xét nghiệm theo chỉ định.</p>
    </header>
    <form id="lipid-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-lipid /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần trao đổi sớm</h2>
      <p>Triglyceride rất cao, đau bụng dữ dội, bệnh gan/thận, đang mang thai hoặc có nhiều thuốc dùng cùng lúc.</p>
      <p class="warning">Không tự ngừng statin, không dùng niacin/dầu cá liều cao và không coi thực phẩm bổ sung là thay thế điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("lipid-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-lipid]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi nhật ký ăn uống và mang danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ, sau đó trao đổi mục còn thiếu với bác sĩ hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .lipid-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .lipid-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
