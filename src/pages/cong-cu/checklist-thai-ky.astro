---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng thai kỳ";
const desc = "Bảng kiểm thói quen ăn uống, vi chất và an toàn thực phẩm trong thai kỳ.";
const items = [
  "Tôi đã hỏi bác sĩ về acid folic, sắt, i-ốt, vitamin D và liều phù hợp",
  "Tôi ăn đa dạng, có đạm, rau quả, tinh bột giàu chất xơ và chất béo lành mạnh",
  "Thịt, cá, trứng, sữa được nấu chín/pasteur hóa; tránh thực phẩm sống hoặc chưa tiệt trùng",
  "Tôi chọn cá ít thủy ngân và hỏi về lượng cá phù hợp tại địa phương",
  "Tôi theo dõi tăng cân, huyết áp và đường huyết theo lịch khám thai",
  "Tôi biết dấu hiệu cần liên hệ: nôn nhiều, mất nước, đau đầu/nhìn mờ hoặc phù bất thường",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-thai-ky">
  <main class="pregnancy-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm sản khoa</p>
      <h1>🤰 Checklist dinh dưỡng thai kỳ</h1>
      <p>{desc} Nhu cầu thay đổi theo tuổi thai, BMI trước thai kỳ và bệnh nền.</p>
    </header>
    <form id="pregnancy-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-pregnancy /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Không tự dùng liều cao</h2>
      <p>Không tự tăng vitamin A, sắt, i-ốt, thảo dược hoặc sản phẩm giảm buồn nôn. Hỏi bác sĩ nếu có đái tháo đường thai kỳ, tăng huyết áp, thiếu máu hoặc nôn nghén nặng.</p>
      <p class="warning">Đau đầu dữ dội, nhìn mờ, đau bụng, ra máu, khó thở hoặc không uống được nước cần liên hệ cơ sở sản khoa.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("pregnancy-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-pregnancy]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi triệu chứng, thuốc và lịch khám thai để trao đổi với bác sĩ.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ sản khoa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .pregnancy-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .pregnancy-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
