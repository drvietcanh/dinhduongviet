---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi điều trị HIV/ARV";
const desc = "Bảng kiểm ăn uống, tương tác thuốc và an toàn thực phẩm khi điều trị HIV.";
const items = [
  "Tôi dùng ARV đúng giờ, đúng điều kiện với thức ăn (đói/no) theo hướng dẫn của đội điều trị",
  "Tôi báo mọi thuốc, thuốc dạ dày, vitamin, thảo dược và thực phẩm bổ sung để kiểm tra tương tác",
  "Tôi ăn đủ năng lượng–đạm, theo dõi cân nặng, tiêu chảy, buồn nôn và loét miệng",
  "Tôi dùng nước sạch, ăn chín uống sôi và tránh thực phẩm sống/nguy cơ nhiễm khuẩn",
  "Tôi theo dõi mỡ máu, đường huyết, chức năng gan/thận và tác dụng phụ theo lịch",
  "Tôi biết dấu hiệu cần khám: sốt kéo dài, tiêu chảy nhiều, sụt cân nhanh, khó thở hoặc lú lẫn",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-hiv-arv">
  <main class="hiv-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm truyền nhiễm</p>
      <h1>🧬 Checklist dinh dưỡng khi điều trị HIV/ARV</h1>
      <p>{desc} Dinh dưỡng hỗ trợ sức khỏe và khả năng dung nạp thuốc, không thay thế ARV.</p>
    </header>
    <form id="hiv-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-hiv /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội điều trị khi</h2>
      <p>Sốt kéo dài, tiêu chảy/mất nước, nôn không giữ được ARV, phát ban nặng, khó thở hoặc sụt cân nhanh.</p>
      <p class="warning">Không tự ngừng ARV, đổi giờ uống hoặc dùng thảo dược/thực phẩm bổ sung để thay thuốc.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("hiv-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-hiv]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang lịch uống ARV, nhật ký triệu chứng và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với đội HIV hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .hiv-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .hiv-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
