    <p class="lead">
      Đánh giá khẩu phần ăn thực tế của bạn bằng đơn vị dễ hiểu — tô, bát, chén, miếng, ly.
      So sánh với nhu cầu theo bệnh lý, phát hiện thiếu đạm, dư muối, dư đường.
    </p>
  </section>

  <div class="kpc-layout">
    <!-- Column 1: Patient Profile -->
    <div class="kpc-sidebar">
      <div class="kpc-card">
        <h2>🩺 Hồ sơ bệnh nhân</h2>
        <div class="kpc-form-grid">
          <div class="kpc-field">
            <label>Giới tính</label>
            <select id="kpc-sex">
              <option value="male">Nam</option>
              <option value="female">Nữ</option>
            </select>
          </div>
          <div class="kpc-field">
            <label>Tuổi</label>
            <input type="number" id="kpc-age" min="10" max="120" value="45" />
          </div>
          <div class="kpc-field">
            <label>Cân nặng (kg)</label>
            <input type="number" id="kpc-weight" min="20" max="300" step="0.1" value="60" />
          </div>
          <div class="kpc-field">
            <label>Chiều cao (cm)</label>
            <input type="number" id="kpc-height" min="100" max="250" step="1" value="160" />
          </div>
          <div class="kpc-field" style="grid-column:1/-1;">
            <div id="kpc-bmi-box" style="background:var(--bg-elevated);padding:8px 12px;border-radius:8px;font-size:0.9rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
              <span><strong>📊 BMI:</strong> <span id="kpc-bmi">—</span></span>
              <span id="kpc-bmi-status" style="font-weight:600;"></span>
            </div>
          </div>
        </div>
        <div class="kpc-field" style="margin-top:8px;">
          <label>Hoạt động thể lực</label>
          <select id="kpc-activity">
            <option value="1.2">Nằm/ngồi nhiều</option>
            <option value="1.375">Nhẹ (đi lại trong nhà)</option>
            <option value="1.55" selected>Trung bình (làm việc nhẹ)</option>
            <option value="1.725">Nặng (lao động chân tay)</option>
          </select>
        </div>

        <div style="margin-top:14px;">
          <label><strong>Bệnh nền</strong></label>
          <div id="kpc-disease-list" class="kpc-disease-grid">
            <!-- Filled by JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- Column 2: Meal Entry + Results -->
    <div class="kpc-main">
      <!-- Meal entry -->
      <div class="kpc-card">
        <h2>🍜 Thêm món ăn</h2>
        <div class="kpc-add-row">
          <input type="text" id="kpc-search" placeholder="Tìm món..." autocomplete="off" />
          <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">
            <span id="kpc-unit-label" style="font-size:0.85rem;color:var(--ink-secondary);">1 suất</span>
            <input type="number" id="kpc-qty" value="1" min="0.25" step="0.25" style="width:65px;" />
            <button id="kpc-add-btn" class="kpc-btn">➕ Thêm</button>
          </div>
        </div>
        <div id="kpc-suggestions" class="kpc-suggestions" style="display:none;"></div>
        <div id="kpc-added-list" style="margin-top:10px;">
          <div class="kpc-empty">Chưa có món nào. Gõ tên món để thêm.</div>
        </div>
      </div>

      <!-- Results -->
      <div id="kpc-results" class="kpc-card" style="display:none;">
        <h2>📊 Kết quả khẩu phần</h2>

        <div class="kpc-totals-grid">
          <div class="kpc-total-box kpc-tot-kcal">
            <span class="kpc-tot-label">🔥 Năng lượng</span>
            <span class="kpc-tot-val"><span id="kpc-rkcal">0</span> / <span id="kpc-tkcal">0</span> kcal</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bkcal" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-pro">
            <span class="kpc-tot-label">🥩 Đạm</span>
            <span class="kpc-tot-val"><span id="kpc-rprot">0</span> / <span id="kpc-tprot">0</span> g</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bprot" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-fat">
            <span class="kpc-tot-label">🧈 Béo</span>
            <span class="kpc-tot-val"><span id="kpc-rfat">0</span> / <span id="kpc-tfat">0</span> g</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bfat" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-carb">
            <span class="kpc-tot-label">🍚 Carb</span>
            <span class="kpc-tot-val"><span id="kpc-rcarb">0</span> / <span id="kpc-tcarb">0</span> g</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bcarb" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-fiber">
            <span class="kpc-tot-label">🌿 Chất xơ</span>
            <span class="kpc-tot-val"><span id="kpc-rxo">0</span> / <span id="kpc-txo">0</span> g</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bxo" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-na">
            <span class="kpc-tot-label">🧂 Natri</span>
            <span class="kpc-tot-val"><span id="kpc-rna">0</span> / <span id="kpc-tna">0</span> mg</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bna" style="width:0%"></div></div>
          </div>
          <div class="kpc-total-box kpc-tot-sugar">
            <span class="kpc-tot-label">🍬 Đường</span>
            <span class="kpc-tot-val"><span id="kpc-rduong">0</span> / <span id="kpc-tduong">0</span> g</span>
            <div class="kpc-bar"><div class="kpc-bar-fill" id="kpc-bduong" style="width:0%"></div></div>
          </div>
        </div>

      <!-- Disease-specific targets display -->
        <div id="kpc-disease-targets" style="display:none;margin-top:12px;padding:10px;background:var(--bg-warning, #fff8e1);border-radius:8px;font-size:0.85rem;">
          <strong>📋 Chỉnh sửa theo bệnh lý:</strong>
          <div id="kpc-disease-desc"></div>
        </div>

        <!-- Disease meal plan link -->
        <div id="kpc-plan-link" style="display:none;margin-top:10px;">
          <a class="kpc-btn" id="kpc-mealplan-btn" style="display:inline-block;text-decoration:none;font-size:0.85rem;" href="/cong-cu/ke-hoach-bua-an" target="_blank">
            🥗 Gợi ý thực đơn
          </a>
          <span style="font-size:0.8rem;color:var(--ink-tertiary);margin-left:6px;">Mở công cụ lập thực đơn với thông số phù hợp</span>
        </div>

        <!-- Warnings -->
        <div id="kpc-warnings" style="margin-top:12px;"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .kpc-layout { display: grid; grid-template-columns: 340px 1fr; gap: 20px; align-items: start; }
  @media (max-width: 800px) { .kpc-layout { grid-template-columns: 1fr; } }

  .kpc-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 18px; margin-bottom: 16px; }
  .kpc-card h2 { font-size: 1.05rem; margin-bottom: 12px; }

  .kpc-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .kpc-field { margin-bottom: 4px; }
  .kpc-field label { font-size: 0.8rem; font-weight: 600; color: var(--ink-secondary); display: block; margin-bottom: 2px; }
  .kpc-field select, .kpc-field input { width: 100%; min-height: 38px; border: 1.5px solid var(--line); border-radius: 8px; padding: 0 10px; font-size: 0.88rem; background: var(--bg-elevated); color: var(--ink); box-sizing: border-box; }

  .kpc-disease-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 6px; }
  .kpc-disease-item { display: flex; align-items: center; gap: 4px; font-size: 0.82rem; cursor: pointer; padding: 5px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg-elevated); transition: all 0.15s; }
  .kpc-disease-item:hover { border-color: var(--brand); }
  .kpc-disease-item input { margin: 0; }
  .kpc-disease-item.selected { border-color: var(--brand); background: #e8f5e9; }
  [data-theme="dark"] .kpc-disease-item.selected { background: #1a3a1a; }

  .kpc-add-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .kpc-add-row input[type="text"] { flex: 1; min-width: 180px; min-height: 40px; border: 1.5px solid var(--line); border-radius: 8px; padding: 0 12px; font-size: 0.9rem; background: var(--bg-elevated); color: var(--ink); }
  .kpc-add-row input[type="text"]:focus { outline: none; border-color: var(--brand); }
  .kpc-add-row input[type="number"] { min-height: 40px; border: 1.5px solid var(--line); border-radius: 8px; padding: 0 8px; font-size: 0.9rem; background: var(--bg-elevated); color: var(--ink); text-align: center; }
  .kpc-btn { padding: 10px 18px; background: var(--brand); color: #fff; border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .kpc-btn:hover { background: var(--brand-dark); }

  .kpc-suggestions { position: absolute; background: var(--card); border: 1px solid var(--line); border-radius: 8px; max-height: 240px; overflow-y: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.15); z-index: 100; min-width: 320px; }
  .kpc-sug-item { padding: 8px 14px; cursor: pointer; display: flex; justify-content: space-between; font-size: 0.88rem; gap: 16px; }
  .kpc-sug-item:hover { background: var(--card-hover); }
  .kpc-sug-detail { color: var(--ink-tertiary); font-size: 0.78rem; white-space: nowrap; }

  .kpc-empty { text-align: center; padding: 24px; color: var(--ink-tertiary); font-size: 0.9rem; }

  .kpc-added-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 5px; background: var(--bg-elevated); flex-wrap: wrap; gap: 4px; }
  .kpc-added-name { font-weight: 500; font-size: 0.9rem; }
  .kpc-added-info { font-size: 0.82rem; color: var(--ink-secondary); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .kpc-added-qty { display: flex; gap: 4px; align-items: center; }
  .kpc-added-qty input { width: 50px; min-height: 30px; border: 1px solid var(--line); border-radius: 5px; padding: 0 4px; text-align: center; font-size: 0.85rem; background: var(--card); color: var(--ink); }
  .kpc-added-del { background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #ef5350; padding: 2px 6px; border-radius: 4px; }
  .kpc-added-del:hover { background: #ffebee; }

  .kpc-totals-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .kpc-total-box { padding: 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg-elevated); }
  .kpc-tot-label { font-size: 0.78rem; color: var(--ink-secondary); }
  .kpc-tot-val { font-size: 0.95rem; font-weight: 700; display: block; margin: 2px 0 6px; }
  .kpc-bar { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .kpc-bar-fill { height: 100%; border-radius: 3px; transition: width 0.3s; }
  .kpc-tot-kcal .kpc-bar-fill { background: #e53935; }
  .kpc-tot-pro .kpc-bar-fill { background: #ef5350; }
  .kpc-tot-fat .kpc-bar-fill { background: #ff9800; }
  .kpc-tot-carb .kpc-bar-fill { background: #2196f3; }
  .kpc-tot-fiber .kpc-bar-fill { background: #4caf50; }
  .kpc-tot-na .kpc-bar-fill { background: #9c27b0; }
  .kpc-tot-sugar .kpc-bar-fill { background: #ff5722; }
  .kpc-bar-fill.over { background: #d32f2f; }
  .kpc-bar-fill.warn { background: #f57c00; }
  .kpc-bar-fill.ok { background: #388e3c; }
  .kpc-bar-fill.low { background: #fdd835; }

  .kpc-warn-item { display: flex; gap: 8px; align-items: flex-start; padding: 8px 12px; margin-bottom: 6px; border-radius: 8px; font-size: 0.88rem; }
  .kpc-warn-red { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
  .kpc-warn-yellow { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
  .kpc-warn-green { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  [data-theme="dark"] .kpc-warn-red { background: #3a1a1a; border-color: #5a2a2a; color: #fca5a5; }
  [data-theme="dark"] .kpc-warn-yellow { background: #3a3a1a; border-color: #5a5a2a; color: #fde68a; }
  [data-theme="dark"] .kpc-warn-green { background: #1a3a1a; border-color: #2a5a2a; color: #86efac; }

  .kpc-disease-targets { font-size: 0.85rem; }
  .kpc-disease-targets ul { margin: 4px 0 0 16px; padding: 0; }
  .kpc-disease-targets li { margin-bottom: 2px; }
</style>

<script>
(function() {
  // ── DATA ──
  var DISHES = JSON.parse(document.getElementById('kpc-dish-data').textContent);
  var DISEASES = JSON.parse(document.getElementById('kpc-disease-data').textContent);

  // ── STATE ──
  var patient = { sex:'female', age:45, weight:60, height:160, activity:1.55, diseases:[] };
  var added = []; // {dish, qty}

  // ── DOM REFS ──
  var $ = function(id) { return document.getElementById(id); };

  // ── DISEASE CHECKBOXES ──
  function renderDiseaseCheckboxes() {
    var container = $('kpc-disease-list');
    container.innerHTML = DISEASES.map(function(d) {
      return '<label class="kpc-disease-item" data-id="'+d.id+'">'+
        '<input type="checkbox" value="'+d.id+'" />'+
        '<span>'+d.icon+' '+d.name+'</span>'+
      '</label>';
    }).join('');
    container.querySelectorAll('input').forEach(function(cb) {
      cb.addEventListener('change', function() {
        var item = this.closest('.kpc-disease-item');
        if(this.checked) { item.classList.add('selected'); } else { item.classList.remove('selected'); }
        updateDiseases();
      });
    });
  }

  function updateDiseases() {
    var checked = [];
    $('kpc-disease-list').querySelectorAll('input:checked').forEach(function(cb) {
      checked.push(cb.value);
    });
    patient.diseases = checked;
    calc();
  }

  // ── SEARCH ──
  var searchTimeout = null;
  $('kpc-search').addEventListener('input', function() {
    var q = this.value.toLowerCase().trim();
    var sug = $('kpc-suggestions');
    if (!q) { sug.style.display = 'none'; return; }
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(function() {
      var matches = DISHES.filter(function(d) {
        return d.name.toLowerCase().indexOf(q) !== -1 || d.cat.toLowerCase().indexOf(q) !== -1;
      });
      if (matches.length === 0) { sug.style.display = 'none'; return; }
      sug.innerHTML = matches.slice(0, 15).map(function(d) {
        var kcalStr = d.kcal + ' kcal';
        var catStr = d.cat;
        return '<div class="kpc-sug-item" data-id="'+d.id+'">'+
          '<span><strong>'+d.name+'</strong> <span style="color:var(--ink-tertiary);font-size:0.78rem;">1 '+d.unit+'</span></span>'+
          '<span class="kpc-sug-detail">'+kcalStr+' · '+catStr+'</span>'+
        '</div>';
      }).join('');
      sug.style.display = 'block';
    }, 150);
  });

  document.addEventListener('click', function(e) {
    var target = e.target.closest('.kpc-sug-item');
    if (!target) {
      if (!e.target.closest('#kpc-search') && !e.target.closest('.kpc-suggestions')) {
        $('kpc-suggestions').style.display = 'none';
      }
      return;
    }
    var dishId = target.dataset.id;
    var dish = DISHES.find(function(d) { return d.id === dishId; });
    if (dish) {
      $('kpc-search').value = dish.name;
      $('kpc-unit-label').textContent = '1 ' + dish.unit + ' ≈ ' + dish.unitWt + 'g';
      $('kpc-search').dataset.selId = dishId;
    }
    $('kpc-suggestions').style.display = 'none';
  });

  $('kpc-search').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); $('kpc-add-btn').click(); }
  });

  // ── ADD / REMOVE ──
  $('kpc-add-btn').addEventListener('click', function() {
    var selId = $('kpc-search').dataset.selId;
    if (!selId) { alert('Chọn món từ gợi ý.'); return; }
    var dish = DISHES.find(function(d) { return d.id === selId; });
    if (!dish) { alert('Không tìm thấy món.'); return; }
    var qty = parseFloat($('kpc-qty').value) || 1;
    added.push({ dish: dish, qty: qty });
    renderAdded();
    calc();
    $('kpc-search').value = '';
    $('kpc-search').dataset.selId = '';
    $('kpc-unit-label').textContent = '1 suất';
    $('kpc-qty').value = 1;
    $('kpc-suggestions').style.display = 'none';
  });

  function renderAdded() {
    var list = $('kpc-added-list');
    if (added.length === 0) {
      list.innerHTML = '<div class="kpc-empty">Chưa có món nào. Gõ tên món để thêm.</div>';
      return;
    }
    list.innerHTML = added.map(function(item, i) {
      var d = item.dish;
      return '<div class="kpc-added-item">'+
        '<span class="kpc-added-name">'+d.name+'</span>'+
        '<div class="kpc-added-info">'+
          '<div class="kpc-added-qty">'+
            '<input type="number" value="'+item.qty+'" min="0.25" step="0.25" data-idx="'+i+'" />'+
            '<span style="font-size:0.82rem;">'+d.unit+'</span>'+
          '</div>'+
          '<span>🔥 ' + Math.round(d.kcal * item.qty) + ' · 🥩' + Math.round(d.p * item.qty) + 'g · 🧈' + Math.round(d.f * item.qty) + 'g · 🍚' + Math.round(d.c * item.qty) + 'g</span>'+
          '<button class="kpc-added-del" data-idx="'+i+'">✕</button>'+
        '</div>'+
      '</div>';
    }).join('');
    // Qty change
    list.querySelectorAll('input[type="number"]').forEach(function(inp) {
      inp.addEventListener('change', function() {
        var idx = parseInt(this.dataset.idx);
        var val = parseFloat(this.value) || 0;
        if (idx >= 0 && idx < added.length) {
          added[idx].qty = Math.max(0.25, val);
          renderAdded();
          calc();
        }
      });
    });
    // Delete
    list.querySelectorAll('.kpc-added-del').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(this.dataset.idx);
        if (idx >= 0 && idx < added.length) {
          added.splice(idx, 1);
          renderAdded();
          calc();
        }
      });
    });
  }

  // ── PATIENT FORM ──
  function bindPatientForm() {
    var fields = ['sex','age','weight','height','activity'];
    fields.forEach(function(id) {
      var el = $('kpc-' + id);
      if (!el) return;
      el.addEventListener('change', function() {
        var val = el.type === 'checkbox' ? el.checked : el.value;
        if (id === 'sex') patient.sex = val;
        else if (id === 'age') patient.age = parseInt(val) || 30;
        else if (id === 'weight') patient.weight = parseFloat(val) || 60;
        else if (id === 'height') patient.height = parseFloat(val) || 160;
        else if (id === 'activity') patient.activity = parseFloat(val) || 1.55;
        calcBMI();
        calc();
      });
    });
  }

  // ── CALC ──
  function calcBMI() {
    var w = patient.weight, h = patient.height;
    if (w > 0 && h > 0) {
      var bmi = w / ((h/100) * (h/100));
      $('kpc-bmi').textContent = bmi.toFixed(1);
      var s = '';
      if (bmi < 18.5) s = '🟡 Thiếu cân';
      else if (bmi < 23) s = '🟢 Bình thường';
      else if (bmi < 25) s = '🟡 Thừa cân';
      else if (bmi < 30) s = '🟠 Béo phì độ 1';
      else s = '🔴 Béo phì độ 2+';
      $('kpc-bmi-status').textContent = s;
    }
  }
  // Run on load
  calcBMI();

  function calc() {
    // 1. Basal targets
    var w = patient.weight, h = patient.height, age = patient.age;
    var bmr = patient.sex === 'male'
      ? (10 * w + 6.25 * h - 5 * age + 5)
      : (10 * w + 6.25 * h - 5 * age - 161);
    var tdee = Math.round(bmr * patient.activity);
    var tgt = {
      kcal: tdee,
      protein: Math.round(w * 1.0),
      fat: Math.round(tdee * 0.25 / 9),
      carb: Math.round(tdee * 0.55 / 4),
      xo: 25,
      na: 2300,
      duong: 25,
    };

    // 2. Apply disease adjustments
    var diseaseDesc = [];
    var activeD = [];
    patient.diseases.forEach(function(did) {
      var d = DISEASES.find(function(x) { return x.id === did; });
      if (d) activeD.push(d);
    });

    // Default flags
    var activeFlags = {};

    activeD.forEach(function(d) {
      // Energy
      if (d.adjustEnergy) tgt.kcal = Math.round(tgt.kcal * d.adjustEnergy);
      // Protein range (midpoint)
      if (d.adjustProt) {
        var mid = (d.adjustProt[0] + d.adjustProt[1]) / 2;
        tgt.protein = Math.round(w * mid);
      }
      // Sodium
      if (d.sodiumMax && d.sodiumMax < tgt.na) tgt.na = d.sodiumMax;
      // Flags
      if (d.flag) {
        d.flag.forEach(function(f) { activeFlags[f] = true; });
      }
      diseaseDesc.push(d.icon + ' ' + d.name + ': ' + d.desc);
    });

    // Recalculate carb/fat based on adjusted kcal and protein
    var protKcal = tgt.protein * 4;
    var fatKcal = tdee * 0.25; // 25% from fat baseline
    if (activeD.some(function(d) { return d.id === 'ganNhiemMo'; })) {
      fatKcal = tdee * 0.20; // lower fat
    }
    tgt.fat = Math.round(fatKcal / 9);
    var carbKcal = Math.max(0, tgt.kcal - protKcal - fatKcal);
    tgt.carb = Math.round(carbKcal / 4);

    // Fiber: adjust for diabetes
    if (activeFlags['sugar'] || activeFlags['carbHigh']) tgt.xo = 30;
    // Sugar: adjust for diabetes
    if (activeFlags['sugar']) tgt.duong = 15;

    // Show disease targets
    var dtEl = $('kpc-disease-targets');
    var plEl = $('kpc-plan-link');
    if (activeD.length > 0) {
      dtEl.style.display = 'block';
      $('kpc-disease-desc').innerHTML = '<ul>' + diseaseDesc.map(function(s) {
        return '<li>' + s + '</li>';
      }).join('') + '</ul>';
      // Update meal plan link with disease info
      var diseaseIds = activeD.map(function(d) { return d.id; }).join(',');
      var planBtn = $('kpc-mealplan-btn');
      var params = [];
      params.push('w=' + patient.weight);
      params.push('age=' + patient.age);
      params.push('sex=' + patient.sex);
      params.push('act=' + patient.activity);
      if (diseaseIds) params.push('dis=' + diseaseIds);
      planBtn.href = '/cong-cu/ke-hoach-bua-an?' + params.join('&');
      plEl.style.display = 'block';
    } else {
      dtEl.style.display = 'none';
      plEl.style.display = 'none';
    }

    // 3. Calculate actual intake
    var actual = { kcal:0, p:0, f:0, c:0, xo:0, na:0, duong:0 };
    added.forEach(function(item) {
      var d = item.dish;
      var q = item.qty || 1;
      actual.kcal += d.kcal * q;
      actual.p += d.p * q;
      actual.f += d.f * q;
      actual.c += d.c * q;
      actual.xo += d.xo * q;
      actual.na += d.na * q;
      actual.duong += d.duong * q;
    });

    // 4. Update UI
    $('kpc-rkcal').textContent = Math.round(actual.kcal);
    $('kpc-tkcal').textContent = tgt.kcal;
    $('kpc-rprot').textContent = Math.round(actual.p);
    $('kpc-tprot').textContent = tgt.protein;
    $('kpc-rfat').textContent = Math.round(actual.f);
    $('kpc-tfat').textContent = tgt.fat;
    $('kpc-rcarb').textContent = Math.round(actual.c);
    $('kpc-tcarb').textContent = tgt.carb;
    $('kpc-rxo').textContent = actual.xo.toFixed(1);
    $('kpc-txo').textContent = tgt.xo;
    $('kpc-rna').textContent = Math.round(actual.na);
    $('kpc-tna').textContent = tgt.na;
    $('kpc-rduong').textContent = Math.round(actual.duong);
    $('kpc-tduong').textContent = tgt.duong;

    setBar('kpc-bkcal', actual.kcal, tgt.kcal);
    setBar('kpc-bprot', actual.p, tgt.protein);
    setBar('kpc-bfat', actual.f, tgt.fat);
    setBar('kpc-bcarb', actual.c, tgt.carb);
    setBar('kpc-bxo', actual.xo, tgt.xo, true);
    setBar('kpc-bna', actual.na, tgt.na);
    setBar('kpc-bduong', actual.duong, tgt.duong);

    // 5. Warnings
    var warns = [];
    var pctKcal = (actual.kcal / tgt.kcal) * 100;
    var pctP = (actual.p / tgt.protein) * 100;
    var pctNa = (actual.na / tgt.na) * 100;
    var pctDuong = (actual.duong / tgt.duong) * 100;
    var pctXo = (actual.xo / tgt.xo) * 100;
    var pctFat = (actual.f / tgt.fat) * 100;

    // Check for high-purine foods (gout flag)
    var hasHighPurin = false;
    if (activeFlags['purin']) {
      added.forEach(function(item) {
        if (item.dish.purin === 1) hasHighPurin = true;
      });
    }

    // Energy
    if (pctKcal > 130) {
      warns.push({ level:'red', msg:'🔴 Dư năng lượng (' + Math.round(pctKcal) + '% mục tiêu). Giảm khẩu phần hoặc tăng vận động.' });
    } else if (pctKcal < 60) {
      warns.push({ level:'red', msg:'🔴 Thiếu năng lượng (' + Math.round(pctKcal) + '% mục tiêu). Cần ăn thêm.' });
    } else if (pctKcal < 80) {
      warns.push({ level:'yellow', msg:'🟡 Năng lượng hơi thấp (' + Math.round(pctKcal) + '%). Cố gắng ăn thêm.' });
    }

    // Protein
    if (pctP < 50) {
      warns.push({ level:'red', msg:'🔴 Thiếu đạm nghiêm trọng (' + Math.round(pctP) + '%). Thêm thịt, cá, trứng, đậu phụ.' });
    } else if (pctP < 70) {
      warns.push({ level:'yellow', msg:'🟡 Hơi thiếu đạm (' + Math.round(pctP) + '%). Nên bổ sung thêm.' });
    } else if (pctP >= 90 && pctP <= 110) {
      warns.push({ level:'green', msg:'🟢 Đạm đạt yêu cầu. Tốt!' });
    }

    // Fat
    if (pctFat > 130) {
      warns.push({ level:'yellow', msg:'🟡 Nhiều chất béo (' + Math.round(pctFat) + '%). Hạn chế đồ chiên rán, mỡ động vật.' });
    }

    // Sodium
    if (pctNa > 100) {
      warns.push({ level:'red', msg:'🧂 Dư natri (' + Math.round(pctNa) + '% giới hạn). Hạn chế muối, nước mắm, đồ chế biến sẵn.' });
    } else if (pctNa > 80) {
      warns.push({ level:'yellow', msg:'🧂 Natri gần ngưỡng (' + Math.round(pctNa) + '%). Chú ý giảm muối.' });
    }

    // Sugar
    if (pctDuong > 100) {
      warns.push({ level:'red', msg:'🍬 Dư đường (' + Math.round(pctDuong) + '% giới hạn). Hạn chế bánh kẹo, nước ngọt, chè.' });
    } else if (pctDuong > 80) {
      warns.push({ level:'yellow', msg:'🍬 Đường gần ngưỡng (' + Math.round(pctDuong) + '%). Theo dõi lượng đường nạp vào.' });
    }

    // Fiber
    if (pctXo < 50) {
      warns.push({ level:'red', msg:'🌿 Thiếu chất xơ (' + Math.round(pctXo) + '%). Thêm rau xanh, trái cây, ngũ cốc nguyên hạt.' });
    } else if (pctXo < 80) {
      warns.push({ level:'yellow', msg:'🌿 Chất xơ hơi thấp (' + Math.round(pctXo) + '%). Nên ăn thêm rau.' });
    }

    // Purine warning for gout
    if (activeFlags['purin'] && hasHighPurin) {
      warns.push({ level:'red', msg:'🦶 Thực phẩm nhiều purin phát hiện. Tránh nội tạng, nước hầm xương, hải sản vỏ.' });
    }

    // Combined disease warnings
    if (activeFlags['protein'] && pctP > 110) {
      warns.push({ level:'red', msg:'🫘 Lượng đạm có thể quá cao cho bệnh thận. Tham khảo ý kiến bác sĩ.' });
    }

    if (warns.length === 0) {
      warns.push({ level:'green', msg:'✅ Khẩu phần cân đối. Duy trì thói quen tốt này!' });
    }

    // Render warnings
    var warnEl = $('kpc-warnings');
    warnEl.innerHTML = warns.map(function(w) {
      var cls = w.level === 'red' ? 'kpc-warn-red' : (w.level === 'yellow' ? 'kpc-warn-yellow' : 'kpc-warn-green');
      return '<div class="kpc-warn-item ' + cls + '">' + w.msg + '</div>';
    }).join('');

    $('kpc-results').style.display = 'block';
  }

  function setBar(elId, actual, target, isFiber) {
    var el = document.getElementById(elId);
    if (!el) return;
    var pct = target > 0 ? Math.min((actual / target) * 100, 200) : 0;
    el.style.width = Math.min(pct, 100) + '%';
    // color class
    el.className = 'kpc-bar-fill';
    if (pct > 120) {
      el.classList.add('over');
    } else if (pct > 100) {
      el.classList.add('warn');
    } else if (isFiber && pct < 50) {
      el.classList.add('low');
    } else if (pct >= 80 && pct <= 100) {
      el.classList.add('ok');
    } else if (pct < 50) {
      el.classList.add('low');
    }
  }

  // ── INIT ──
  renderDiseaseCheckboxes();
  bindPatientForm();
  // Trigger initial calc
  calc();
})();
</script>
</BaseLayout>
