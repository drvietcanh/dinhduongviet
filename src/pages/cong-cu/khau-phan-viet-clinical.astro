---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { foods, recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";
import { MEAL_ASSESSMENT_GLOBAL_SAFETY_NOTE, MEAL_ASSESSMENT_MEDICATION_SAFETY_NOTE } from "../../lib/vietnamese-meal-assessment";

const title = "Đánh giá khẩu phần Việt";
const desc = "Ước tính năng lượng và chất chính từ món Việt đã nhập, dùng cho giáo dục dinh dưỡng và nhận diện trường hợp cần cá thể hóa.";

function groupFor(category: string, name: string) {
  const text = `${category} ${name}`.toLowerCase();
  if (text.includes("đồ uống") || text.includes("sữa") || text.includes("trà") || text.includes("cà phê") || text.includes("bia")) return "do-uong";
  if (text.includes("trái cây") || text.includes("quả")) return "trai-cay";
  if (text.includes("rau") || text.includes("củ")) return "rau-cu";
  if (text.includes("thịt") || text.includes("cá") || text.includes("trứng") || text.includes("đậu") || text.includes("hải sản")) return "dam";
  if (text.includes("gạo") || text.includes("cơm") || text.includes("bún") || text.includes("phở") || text.includes("miến") || text.includes("khoai") || text.includes("bánh")) return "tinh-bot";
  return "khac";
}

function iconFor(group: string, type: "food" | "recipe") {
  if (type === "recipe") return "🍲";
  if (group === "tinh-bot") return "🍚";
  if (group === "dam") return "🥩";
  if (group === "rau-cu") return "🥬";
  if (group === "trai-cay") return "🍎";
  if (group === "do-uong") return "🥛";
  return "🥗";
}

const foodOptions = foods.map((food) => {
  const group = groupFor(food.category, food.name);
  const n = food.nutrients;
  return {
    id: food.id,
    slug: food.slug,
    type: "food" as const,
    name: food.name,
    aliases: food.aliases,
    category: food.category,
    group,
    icon: iconFor(group, "food"),
    defaultGrams: 100,
    defaultLabel: "100 g",
    basis: food.basis,
    edibleNote: food.edibleNote,
    energyKcalPer100g: n.energyKcal,
    carbGPer100g: n.carbG,
    proteinGPer100g: n.proteinG,
    fatGPer100g: n.fatG,
    fiberGPer100g: n.fiberG ?? null,
    sodiumMgPer100g: n.sodiumMg ?? null,
    sugarGPer100g: n.sugarG ?? null,
    sourceId: food.sourceId,
    confidence: food.confidence,
    dataQuality: food.dataQuality,
    sourceReviewStatus: food.sourceReviewStatus,
    needsExternalSource: food.needsExternalSource,
    needsDietitianReview: food.needsDietitianReview,
  };
});

const recipeOptions = recipes.map((recipe) => {
  const n = calculateRecipe(recipe);
  const servingWeight = recipe.servingWeightG || 100;
  const per100 = (value: number | undefined) => value == null ? null : (value / servingWeight) * 100;
  const group = groupFor("Món ăn", recipe.name);
  return {
    id: `recipe:${recipe.slug}`,
    slug: recipe.slug,
    type: "recipe" as const,
    name: recipe.name,
    aliases: recipe.aliases,
    category: "Món ăn",
    group,
    icon: iconFor(group, "recipe"),
    defaultGrams: servingWeight,
    defaultLabel: recipe.servingName ? `${recipe.servingName} (${servingWeight} g)` : `${servingWeight} g`,
    basis: `1 khẩu phần mẫu ${servingWeight} g`,
    edibleNote: recipe.portionNote ?? "",
    energyKcalPer100g: per100(n.energyKcal),
    carbGPer100g: per100(n.carbG),
    proteinGPer100g: per100(n.proteinG),
    fatGPer100g: per100(n.fatG),
    fiberGPer100g: per100(n.fiberG),
    sodiumMgPer100g: per100(n.sodiumMg),
    sugarGPer100g: per100(n.sugarG),
    sourceId: recipe.sourceId,
    confidence: recipe.confidence,
    dataQuality: recipe.sourceId === "recipe-estimate-v1" ? "recipe_estimate" : undefined,
    sourceReviewStatus: undefined,
    needsExternalSource: false,
    needsDietitianReview: false,
  };
});

const assessmentItems = [...foodOptions, ...recipeOptions].sort((a, b) => {
  const order = ["tinh-bot", "dam", "rau-cu", "trai-cay", "do-uong", "khac"];
  const diff = order.indexOf(a.group) - order.indexOf(b.group);
  return diff !== 0 ? diff : a.name.localeCompare(b.name, "vi");
});

const quickSlugs = ["com-trang", "pho-bo", "bun-bo-hue", "uc-ga", "dau-phu", "rau-muong", "chuoi", "sua-tuoi"];
const quickRefs = quickSlugs
  .map((slug) => assessmentItems.find((item) => item.slug === slug || item.id === slug))
  .filter(Boolean)
  .slice(0, 8);
const itemJson = JSON.stringify(assessmentItems).replace(/</g, "\\u003c");
const quickJson = JSON.stringify(quickRefs).replace(/</g, "\\u003c");
---

<BaseLayout title={`${title} - Dinh Dưỡng Việt`} description={desc} canonical="/cong-cu/khau-phan-viet-clinical">
  <main class="meal-page">
    <header class="page-header">
      <p class="eyebrow">Công cụ giáo dục dinh dưỡng</p>
      <h1>{title}</h1>
      <p class="page-desc">{desc}</p>
    </header>

    <aside class="safety-banner">
      <strong>Lưu ý an toàn</strong>
      <span>{MEAL_ASSESSMENT_GLOBAL_SAFETY_NOTE} {MEAL_ASSESSMENT_MEDICATION_SAFETY_NOTE}</span>
    </aside>

    <section class="tool-shell" aria-label="Đánh giá khẩu phần Việt">
      <div class="panel">
        <div class="section-label"><span>1</span> Thông tin chung</div>
        <div class="form-grid">
          <label class="form-row" for="age">
            <span>Tuổi</span>
            <input id="age" type="number" value="35" min="13" max="120" />
          </label>
          <label class="form-row" for="sex">
            <span>Giới tính</span>
            <select id="sex">
              <option value="female">Nữ</option>
              <option value="male">Nam</option>
            </select>
          </label>
          <label class="form-row" for="weight">
            <span>Cân nặng</span>
            <div class="with-unit"><input id="weight" type="number" value="60" min="20" max="250" step="0.1" /><em>kg</em></div>
          </label>
          <label class="form-row" for="height">
            <span>Chiều cao</span>
            <div class="with-unit"><input id="height" type="number" value="160" min="100" max="230" /><em>cm</em></div>
          </label>
          <label class="form-row" for="activity">
            <span>Hoạt động</span>
            <select id="activity">
              <option value="low">Ít vận động</option>
              <option value="moderate" selected>Vừa phải</option>
              <option value="high">Hoạt động cao</option>
            </select>
          </label>
          <label class="form-row" for="generalGoal">
            <span>Mục tiêu chung</span>
            <select id="generalGoal">
              <option value="healthy_eating" selected>Ăn lành mạnh</option>
              <option value="maintain">Duy trì</option>
              <option value="mild_weight_loss">Giảm cân nhẹ</option>
              <option value="mild_weight_gain">Tăng cân nhẹ</option>
            </select>
          </label>
          <label class="form-row" for="mealMode">
            <span>Phạm vi nhập</span>
            <select id="mealMode">
              <option value="meal" selected>Một bữa</option>
              <option value="day">Cả ngày</option>
            </select>
          </label>
        </div>

        <fieldset class="flags">
          <legend>Cờ cần cá thể hóa</legend>
          <label><input type="checkbox" id="diabetesMedicationRisk" /> ĐTĐ dùng insulin/sulfonylurea</label>
          <label><input type="checkbox" id="chronicKidneyDisease" /> Bệnh thận mạn</label>
          <label><input type="checkbox" id="dialysis" /> Đang lọc máu</label>
          <label><input type="checkbox" id="heartFailureFluidRestriction" /> Suy tim hoặc hạn chế dịch</label>
          <label><input type="checkbox" id="hypertension" /> Tăng huyết áp đơn thuần</label>
          <label><input type="checkbox" id="medicallyPrescribedLowSalt" /> Đang được kê ăn nhạt chặt chẽ</label>
          <label><input type="checkbox" id="goutHistory" /> Tiền sử gout ổn định</label>
          <label><input type="checkbox" id="goutAcuteOrSevere" /> Gout đợt cấp/nặng</label>
          <label><input type="checkbox" id="cirrhosisAscites" /> Xơ gan/cổ trướng/phù</label>
          <label><input type="checkbox" id="pregnancyLactation" /> Thai kỳ/cho con bú</label>
          <label><input type="checkbox" id="childTeen" /> Trẻ em/vị thành niên</label>
          <label><input type="checkbox" id="cancerMalnutrition" /> Ung thư/suy dinh dưỡng</label>
          <label><input type="checkbox" id="eatingDisorder" /> Rối loạn ăn uống</label>
          <label><input type="checkbox" id="rapidUnintentionalWeightLoss" /> Sụt cân nhanh không chủ ý</label>
          <label><input type="checkbox" id="acuteIllness" /> Bệnh cấp/nôn/tiêu chảy/sốt/mất nước/khó thở/phù tăng nhanh</label>
          <label><input type="checkbox" id="vegetarian" /> Ăn chay</label>
          <label><input type="checkbox" id="foodAllergy" /> Dị ứng thực phẩm</label>
          <label><input type="checkbox" id="frailElderly" /> Người cao tuổi yếu</label>
        </fieldset>
      </div>

      <div class="panel">
        <div class="section-label"><span>2</span> Chọn món hoặc thực phẩm</div>
        <input id="item-search" class="search" type="search" placeholder="Tìm cơm, phở, cá, rau, sữa..." autocomplete="off" />
        <div class="chips" id="chips">
          <button type="button" class="chip active" data-group="all">Tất cả</button>
          <button type="button" class="chip" data-group="tinh-bot">Tinh bột</button>
          <button type="button" class="chip" data-group="dam">Đạm</button>
          <button type="button" class="chip" data-group="rau-cu">Rau/củ</button>
          <button type="button" class="chip" data-group="trai-cay">Trái cây</button>
          <button type="button" class="chip" data-group="do-uong">Đồ uống</button>
        </div>
        <div id="item-list" class="item-list"></div>
      </div>

      <section id="result" class="panel result-panel" aria-live="polite">
        <div class="section-label"><span>3</span> Kết quả</div>
        <div class="result-head">
          <div id="mode-badge" class="mode-badge">Ước tính giáo dục</div>
          <button type="button" id="reset-btn" class="ghost-btn">Làm lại</button>
        </div>
        <div id="input-error" class="input-error" hidden></div>
        <div class="totals-grid">
          <div><span>Năng lượng</span><strong id="total-energy">0 kcal</strong></div>
          <div><span>Carb</span><strong id="total-carb">0 g</strong></div>
          <div><span>Protein</span><strong id="total-protein">0 g</strong></div>
          <div><span>Chất béo</span><strong id="total-fat">0 g</strong></div>
          <div><span>Chất xơ</span><strong id="total-fiber">—</strong></div>
          <div><span>Natri</span><strong id="total-sodium">—</strong></div>
          <div><span>Đường</span><strong id="total-sugar">—</strong></div>
        </div>
        <div id="selected-list" class="selected-list"></div>
        <div id="mode-messages" class="message-list"></div>
        <div id="suggestions" class="message-list"></div>
        <div id="warnings" class="warning-list"></div>
      </section>
    </section>

    <details class="quick-ref">
      <summary>Một số mục dữ liệu nhanh</summary>
      <div id="quick-ref-body" class="quick-grid"></div>
    </details>
  </main>

  <script id="meal-item-data" type="application/json" set:html={itemJson}></script>
  <script id="meal-quick-data" type="application/json" set:html={quickJson}></script>

  <style>
    .meal-page { max-width: 1040px; margin: 0 auto; padding: 28px 18px 42px; }
    .page-header { text-align: center; margin-bottom: 18px; }
    .eyebrow { margin: 0 0 6px; color: var(--brand); font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0; }
    .page-header h1 { margin: 0 0 8px; font-size: 1.75rem; letter-spacing: 0; }
    .page-desc { max-width: 720px; margin: 0 auto; color: var(--ink-secondary); line-height: 1.6; font-size: 0.95rem; }
    .safety-banner { display: flex; gap: 12px; align-items: flex-start; margin: 18px 0 20px; padding: 14px 16px; border: 1px solid #f5c26b; background: #fff8e8; border-radius: 8px; color: #6d4b08; font-size: 0.88rem; line-height: 1.55; }
    [data-theme="dark"] .safety-banner { background: #33270d; color: #f7d890; border-color: #6d551d; }
    .tool-shell { display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); gap: 16px; align-items: start; }
    .panel { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
    .section-label { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; font-weight: 800; font-size: 0.94rem; }
    .section-label span { width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--brand-light); color: var(--brand); font-size: 0.78rem; flex-shrink: 0; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .form-row { display: grid; gap: 4px; color: var(--ink-secondary); font-size: 0.8rem; font-weight: 700; }
    .form-row input, .form-row select, .search { width: 100%; min-height: 42px; border: 1.5px solid var(--line); border-radius: 8px; padding: 0 10px; background: var(--bg-elevated); color: var(--ink); box-sizing: border-box; font: inherit; }
    .with-unit { display: flex; align-items: center; border: 1.5px solid var(--line); border-radius: 8px; background: var(--bg-elevated); overflow: hidden; }
    .with-unit input { border: 0; min-width: 0; }
    .with-unit em { padding: 0 10px; color: var(--ink-tertiary); font-style: normal; font-size: 0.8rem; }
    .flags { margin: 14px 0 0; padding: 0; border: 0; display: grid; grid-template-columns: 1fr; gap: 7px; }
    .flags legend { margin-bottom: 8px; font-weight: 800; font-size: 0.86rem; }
    .flags label { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 7px 9px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-elevated); font-size: 0.82rem; cursor: pointer; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 12px; }
    .chip, .ghost-btn { min-height: 38px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink-secondary); padding: 7px 11px; font: inherit; font-size: 0.82rem; cursor: pointer; }
    .chip.active { background: var(--brand-light); color: var(--brand); border-color: var(--brand-light2); font-weight: 800; }
    .item-list, .selected-list { display: grid; gap: 8px; }
    :global(.meal-item), :global(.selected-item) { display: grid; grid-template-columns: auto minmax(0,1fr) auto auto; align-items: center; gap: 10px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-elevated); }
    :global(.item-icon) { font-size: 1.35rem; }
    :global(.item-name) { font-weight: 800; font-size: 0.92rem; }
    :global(.item-detail) { color: var(--ink-secondary); font-size: 0.76rem; line-height: 1.45; }
    :global(.grams) { width: 76px; min-height: 38px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink); padding: 0 8px; font: inherit; }
    :global(.add-btn), :global(.remove-btn) { min-height: 38px; border: 0; border-radius: 8px; padding: 7px 11px; background: var(--brand); color: white; font: inherit; font-weight: 800; cursor: pointer; }
    :global(.remove-btn) { background: #d9534f; }
    .result-panel { grid-column: 1 / -1; }
    .result-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 12px; }
    .mode-badge { display: inline-flex; align-items: center; min-height: 30px; padding: 5px 10px; border-radius: 999px; background: #e8f5ee; color: #217245; font-size: 0.78rem; font-weight: 900; }
    .mode-badge.caution { background: #fff3d8; color: #8a5a00; }
    .mode-badge.clinical { background: #ffe4e1; color: #9b2c24; }
    .input-error { margin-bottom: 10px; padding: 10px 12px; background: #ffe4e1; color: #9b2c24; border-radius: 8px; font-size: 0.86rem; }
    .totals-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; margin-bottom: 12px; }
    .totals-grid div { border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: var(--bg-elevated); }
    .totals-grid span { display: block; color: var(--ink-secondary); font-size: 0.74rem; margin-bottom: 4px; }
    .totals-grid strong { font-size: 0.95rem; }
    .message-list, .warning-list { display: grid; gap: 7px; margin-top: 10px; }
    :global(.msg), :global(.warn) { padding: 9px 11px; border-radius: 8px; font-size: 0.86rem; line-height: 1.45; }
    :global(.msg) { background: var(--brand-light); color: var(--ink); }
    :global(.warn) { background: #fff8e8; color: #6d4b08; border: 1px solid #f5c26b; }
    .quick-ref { margin-top: 16px; border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; background: var(--card); }
    .quick-ref summary { cursor: pointer; font-weight: 800; }
    .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px; margin-top: 10px; }
    :global(.quick-card) { border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: var(--bg-elevated); font-size: 0.82rem; }
    @media (max-width: 820px) {
      .tool-shell { grid-template-columns: 1fr; }
      .totals-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      :global(.meal-item), :global(.selected-item) { grid-template-columns: auto minmax(0,1fr); }
      :global(.grams), :global(.add-btn), :global(.remove-btn) { grid-column: span 1; width: 100%; }
    }
    @media (max-width: 520px) {
      .form-grid { grid-template-columns: 1fr; }
      .totals-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { calculateVietnameseMealAssessment } from "../../lib/vietnamese-meal-assessment";

    const itemData = JSON.parse(document.getElementById("meal-item-data").textContent || "[]");
    const quickData = JSON.parse(document.getElementById("meal-quick-data").textContent || "[]");
    const selected = [];
    let activeGroup = "all";
    const flagIds = [
      "diabetesMedicationRisk", "chronicKidneyDisease", "dialysis", "heartFailureFluidRestriction",
      "hypertension", "medicallyPrescribedLowSalt", "goutHistory", "goutAcuteOrSevere",
      "cirrhosisAscites", "pregnancyLactation", "childTeen", "cancerMalnutrition",
      "eatingDisorder", "rapidUnintentionalWeightLoss", "acuteIllness", "vegetarian",
      "foodAllergy", "frailElderly",
    ];

    const $ = (id) => document.getElementById(id);
    const fmt = (value, unit, digits = 0) => value == null ? "—" : `${Number(value).toLocaleString("vi-VN", { maximumFractionDigits: digits })} ${unit}`;
    const escapeHtml = (value) => String(value ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    function compactSource(item) {
      const bits = [item.defaultLabel, item.sourceId, item.confidence === "low" ? "ước tính" : ""].filter(Boolean);
      return bits.join(" · ");
    }

    function renderItems() {
      const q = ($("item-search").value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").trim();
      const list = itemData
        .filter((item) => activeGroup === "all" || item.group === activeGroup)
        .filter((item) => {
          if (!q) return true;
          const text = [item.name, item.category, ...(item.aliases || [])].join(" ").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
          return text.includes(q);
        })
        .slice(0, 24);

      $("item-list").innerHTML = list.length ? list.map((item) => `
        <div class="meal-item" data-id="${escapeHtml(item.id)}">
          <span class="item-icon">${item.icon}</span>
          <div>
            <div class="item-name">${escapeHtml(item.name)}</div>
            <div class="item-detail">${escapeHtml(item.category)} · ${escapeHtml(compactSource(item))}</div>
          </div>
          <input class="grams" type="number" min="1" max="3000" step="1" value="${Number(item.defaultGrams || 100)}" aria-label="Gram cho ${escapeHtml(item.name)}" />
          <button class="add-btn" type="button">Thêm</button>
        </div>
      `).join("") : '<div class="msg">Không tìm thấy món phù hợp.</div>';

      document.querySelectorAll(".meal-item .add-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const row = btn.closest(".meal-item");
          const item = itemData.find((entry) => entry.id === row.dataset.id);
          const grams = Number(row.querySelector(".grams").value);
          if (item) {
            selected.push({ ...item, grams });
            renderSelected();
            calculate();
          }
        });
      });
    }

    function renderSelected() {
      $("selected-list").innerHTML = selected.length ? selected.map((item, index) => `
        <div class="selected-item">
          <span class="item-icon">${item.icon}</span>
          <div>
            <div class="item-name">${escapeHtml(item.name)}</div>
            <div class="item-detail">${fmt(item.grams, "g")} · ${escapeHtml(item.sourceId || "")}</div>
          </div>
          <button class="remove-btn" type="button" data-index="${index}">Xóa</button>
        </div>
      `).join("") : '<div class="msg">Chưa có món nào. Chọn món ở phần trên để bắt đầu.</div>';

      document.querySelectorAll(".remove-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          selected.splice(Number(btn.dataset.index), 1);
          renderSelected();
          calculate();
        });
      });
    }

    function collectFlags() {
      return flagIds.reduce((acc, id) => {
        acc[id] = Boolean($(id)?.checked);
        return acc;
      }, {});
    }

    function modeLabel(mode) {
      if (mode === "auto") return "Ước tính giáo dục";
      if (mode === "caution") return "Tham khảo có lưu ý";
      return "Cần cá thể hóa";
    }

    function renderMessages(id, messages, cls) {
      $(id).innerHTML = messages.length ? messages.map((msg) => `<div class="${cls}">${escapeHtml(msg)}</div>`).join("") : "";
    }

    function calculate() {
      const result = calculateVietnameseMealAssessment({
        age: Number($("age").value),
        sex: $("sex").value,
        weightKg: Number($("weight").value),
        heightCm: Number($("height").value),
        activity: $("activity").value,
        generalGoal: $("generalGoal").value,
        mealMode: $("mealMode").value,
        selectedItems: selected,
        flags: collectFlags(),
      });

      const error = $("input-error");
      error.hidden = !result.error;
      error.textContent = result.error || "";

      const badge = $("mode-badge");
      badge.textContent = modeLabel(result.mode);
      badge.className = `mode-badge ${result.mode === "caution" ? "caution" : result.mode === "clinical_no_auto" ? "clinical" : ""}`;

      $("total-energy").textContent = fmt(result.totals.energyKcal, "kcal");
      $("total-carb").textContent = fmt(result.totals.carbG, "g", 1);
      $("total-protein").textContent = fmt(result.totals.proteinG, "g", 1);
      $("total-fat").textContent = fmt(result.totals.fatG, "g", 1);
      $("total-fiber").textContent = fmt(result.totals.fiberG, "g", 1);
      $("total-sodium").textContent = fmt(result.totals.sodiumMg, "mg", 0);
      $("total-sugar").textContent = fmt(result.totals.sugarG, "g", 1);

      renderMessages("mode-messages", result.modeMessages, "msg");
      renderMessages("suggestions", result.suggestions, "msg");
      renderMessages("warnings", result.warnings.slice(0, 8), "warn");
    }

    $("chips").addEventListener("click", (event) => {
      const btn = event.target.closest(".chip");
      if (!btn) return;
      activeGroup = btn.dataset.group;
      document.querySelectorAll(".chip").forEach((chip) => chip.classList.toggle("active", chip === btn));
      renderItems();
    });

    ["age", "sex", "weight", "height", "activity", "generalGoal", "mealMode", "item-search"].forEach((id) => {
      $(id)?.addEventListener("input", () => id === "item-search" ? renderItems() : calculate());
      $(id)?.addEventListener("change", () => id === "item-search" ? renderItems() : calculate());
    });
    flagIds.forEach((id) => $(id)?.addEventListener("change", calculate));
    $("reset-btn").addEventListener("click", () => {
      selected.splice(0, selected.length);
      renderSelected();
      calculate();
    });

    $("quick-ref-body").innerHTML = quickData.map((item) => `
      <div class="quick-card">
        <strong>${escapeHtml(item.name)}</strong><br />
        ${fmt(item.energyKcalPer100g, "kcal", 0)} / 100g · carb ${fmt(item.carbGPer100g, "g", 1)}<br />
        <span>${escapeHtml(compactSource(item))}</span>
      </div>
    `).join("");

    renderItems();
    renderSelected();
    calculate();
  </script>
</BaseLayout>
