---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Dinh dưỡng thai kỳ | Dinh Dưỡng Việt";
const description =
  "Định hướng an toàn về các tình huống cần hỏi bác sĩ sản khoa hoặc chuyên gia dinh dưỡng khi xem dinh dưỡng trong thai kỳ và cho con bú.";

const situations = [
  "Đang mang thai, chuẩn bị mang thai hoặc đang cho con bú và muốn đặt nhu cầu dinh dưỡng riêng",
  "Mang đa thai, từng sinh non, từng thai lưu, hoặc có thai kỳ nguy cơ cao",
  "Buồn nôn, nôn ói kéo dài, ăn uống kém, sụt cân hoặc tăng cân rất nhanh",
  "Thiếu máu, thiếu sắt, thiếu vitamin D, thiếu canxi hoặc có kết quả xét nghiệm bất thường",
  "Đái tháo đường thai kỳ, tăng huyết áp thai kỳ, tiền sản giật, bệnh thận, bệnh gan hoặc bệnh tim mạch",
  "BMI trước thai kỳ quá thấp, béo phì, rối loạn ăn uống hoặc tiền sử phẫu thuật tiêu hóa",
  "Đang dùng thuốc dài ngày, thuốc chống đông, thuốc tuyến giáp, thuốc chống động kinh hoặc nhiều thực phẩm bổ sung",
  "Ăn chay nghiêm ngặt, dị ứng nhiều nhóm thực phẩm hoặc khó tiếp cận thực phẩm đa dạng",
  "Muốn tự đặt năng lượng, tăng cân, đạm, sắt, canxi, folate, DHA hoặc vitamin theo từng giai đoạn",
];

const prepItems = [
  "Tuổi thai, số thai, cân nặng trước thai kỳ và cân nặng hiện tại",
  "Tình trạng ăn uống trong 3-7 ngày gần đây, gồm bữa chính, bữa phụ, sữa và thực phẩm bổ sung",
  "Bệnh nền, thuốc đang dùng, tiền sử thai kỳ và triệu chứng mới xuất hiện",
  "Kết quả xét nghiệm, siêu âm, chẩn đoán và hướng dẫn đã nhận từ bác sĩ sản khoa",
];

const safeNextSteps = [
  "Dùng trang này như danh sách nhắc việc trước khi hỏi chuyên môn.",
  "Không tự đặt năng lượng, tăng cân, đạm hoặc vi chất cho thai kỳ chỉ từ một công cụ trực tuyến.",
  "Nếu có dấu hiệu bất thường, hãy liên hệ cơ sở y tế hoặc bác sĩ đang theo dõi thai kỳ.",
];
---

<BaseLayout title={title} description={description} canonical="/cong-cu/dinh-duong-thai-ky">
  <main class="pregnancy-nutrition-shell" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Công cụ an toàn v1</p>
      <h1 id="page-title">Dinh dưỡng thai kỳ</h1>
      <p>
        Công cụ này chỉ giúp định hướng các tình huống cần hỏi bác sĩ sản khoa
        hoặc chuyên gia dinh dưỡng. V1 không tính năng lượng, tăng cân, đạm,
        sắt, canxi, folate, DHA hay vitamin riêng cho từng thai kỳ.
      </p>
    </section>

    <section class="notice-panel" aria-labelledby="scope-title">
      <h2 id="scope-title">Phạm vi hiện tại</h2>
      <p>
        Dinh dưỡng khi mang thai và cho con bú phụ thuộc vào tuổi thai, số thai,
        cân nặng trước thai kỳ, bệnh nền, thuốc, xét nghiệm, triệu chứng và kế
        hoạch theo dõi sản khoa. Vì chưa có source-lock và quy trình duyệt sản
        khoa riêng, trang này không đưa số dinh dưỡng cá nhân hoặc khuyến nghị
        tăng cân theo từng người.
      </p>
    </section>

    <section class="situation-panel" aria-labelledby="situation-title">
      <div class="section-head">
        <p class="eyebrow">Khi nào cần hỏi chuyên môn?</p>
        <h2 id="situation-title">Các tình huống cần cá thể hóa</h2>
        <p>
          Nếu có một hoặc nhiều tình huống dưới đây, hãy chuẩn bị thông tin và
          trao đổi trực tiếp với bác sĩ sản khoa hoặc chuyên gia dinh dưỡng.
        </p>
      </div>

      <div class="situation-grid">
        {situations.map((item) => (
          <article class="situation-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="result-panel" aria-labelledby="result-title">
      <p class="result-label">Định hướng</p>
      <h2 id="result-title">Cần hỏi bác sĩ sản khoa hoặc chuyên gia dinh dưỡng</h2>
      <p>
        Không đủ điều kiện đưa khuyến nghị cá nhân ở v1. Hãy mang theo thông
        tin thai kỳ, khẩu phần, thuốc, thực phẩm bổ sung và xét nghiệm để được
        đánh giá phù hợp với từng người.
      </p>
      <ul>
        {safeNextSteps.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="prep-panel" aria-labelledby="prep-title">
      <p class="eyebrow">Chuẩn bị thông tin</p>
      <h2 id="prep-title">Nên mang theo khi đi hỏi</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>

  <style is:global>
    .pregnancy-nutrition-shell {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 0 44px;
    }

    .pregnancy-nutrition-shell section {
      margin-bottom: 18px;
    }

    .hero-panel,
    .notice-panel,
    .situation-panel,
    .result-panel,
    .prep-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .hero-panel {
      background: linear-gradient(135deg, rgba(5, 150, 105, 0.05), rgba(59, 130, 246, 0.05));
    }

    .eyebrow,
    .result-label {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .pregnancy-nutrition-shell h1,
    .pregnancy-nutrition-shell h2 {
      margin: 0 0 10px;
      line-height: 1.25;
    }

    .pregnancy-nutrition-shell h1 {
      font-size: 1.75rem;
    }

    .pregnancy-nutrition-shell h2 {
      font-size: 1.16rem;
    }

    .pregnancy-nutrition-shell p,
    .pregnancy-nutrition-shell li {
      color: var(--ink-secondary);
      line-height: 1.65;
    }

    .pregnancy-nutrition-shell p {
      margin: 0;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .situation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .situation-card {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 12px;
      background: var(--bg-soft);
    }

    .situation-card span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: #fff3cd;
      color: #7a4b00;
      font-weight: 900;
    }

    .result-panel {
      border-color: rgba(16, 185, 129, 0.15);
      background: rgba(16, 185, 129, 0.05);
    }

    .result-panel ul,
    .prep-panel ul {
      margin: 10px 0 0;
      padding-left: 20px;
    }

    @media (max-width: 640px) {
      .pregnancy-nutrition-shell {
        padding: 12px 0 34px;
      }

      .hero-panel,
      .notice-panel,
      .situation-panel,
      .result-panel,
      .prep-panel {
        padding: 16px;
        border-radius: var(--radius-lg);
      }

      .pregnancy-nutrition-shell h1 {
        font-size: 1.45rem;
      }

      .situation-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
