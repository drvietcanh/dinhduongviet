---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "🧮 Dinh dưỡng thai kỳ — nhu cầu theo từng giai đoạn";
const desc = "Tính nhu cầu calo, đạm, sắt, canxi, DHA, folate cho mẹ bầu theo tam cá nguyệt và cho con bú.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/dinh-duong-thai-ky">
  <main class="content-page">
    <div class="page-header">
      <h1>
        <span class="h-icon">🧮</span>
        <span class="h-text">Dinh dưỡng thai kỳ</span>
      </h1>
      <p class="page-desc">{desc}</p>
    </div>

    <!-- Section: Nhập thông tin -->
    <div class="section-label"><span class="sl-num">1</span> Thông tin của bạn</div>
    <div class="card form-card">
      <div class="form-grid">
        <div class="form-row">
          <label for="weight">⚖️ Cân nặng trước mang thai</label>
          <div class="input-wrap"><input type="number" id="weight" value="55" min="30" max="120"><span class="input-suffix">kg</span></div>
        </div>
        <div class="form-row">
          <label for="height">📏 Chiều cao</label>
          <div class="input-wrap"><input type="number" id="height" value="160" min="130" max="190"><span class="input-suffix">cm</span></div>
        </div>
        <div class="form-row">
          <label for="age">🎂 Tuổi</label>
          <div class="input-wrap"><input type="number" id="age" value="28" min="15" max="50"><span class="input-suffix">tuổi</span></div>
        </div>
        <div class="form-row">
          <label for="stage">🤰 Giai đoạn</label>
          <div class="input-wrap stage-wrap">
            <select id="stage">
              <option value="t1">Tam cá nguyệt 1 (tuần 1–13)</option>
              <option value="t2">Tam cá nguyệt 2 (tuần 14–26)</option>
              <option value="t3">Tam cá nguyệt 3 (tuần 27–40)</option>
              <option value="bf">Cho con bú (0–6 tháng)</option>
            </select>
            <span class="stage-arrow">▼</span>
          </div>
        </div>
      </div>
      <button class="btn-calc" onclick="calculate()">✨ Tính nhu cầu dinh dưỡng</button>
    </div>

    <!-- Result -->
    <div id="result" style="display:none;">
      <!-- Section: Tăng cân -->
      <div class="section-label"><span class="sl-num">2</span> Mục tiêu tăng cân</div>
      <div class="gain-card">
        <div class="gain-header">
          <span class="gain-emoji">⚖️</span>
          <div>
            <div class="gain-title">Tăng cân khuyến nghị</div>
            <div class="gain-subtitle">Dựa trên BMI trước mang thai · Hướng dẫn IOM</div>
          </div>
        </div>
        <div class="gain-visual">
          <div class="gain-bar-label">
            <span id="gain-current" class="gain-current">0 kg</span>
            <span id="gain-target-text" class="gain-target">mục tiêu: 0 kg</span>
          </div>
          <div class="gain-bar-track">
            <div class="gain-bar-fill" id="gain-fill" style="width:0%"></div>
          </div>
        </div>
        <div class="gain-note" id="gain-note"></div>
      </div>

      <!-- Section: Dinh dưỡng -->
      <div class="section-label"><span class="sl-num">3</span> Nhu cầu dinh dưỡng theo giai đoạn</div>
      <div class="nutrient-grid" id="nutrient-grid"></div>

      <!-- Section: Thực phẩm -->
      <div class="section-label"><span class="sl-num">4</span> Thực phẩm nên ăn</div>
      <div class="food-card">
        <div class="food-lists" id="food-lists"></div>
      </div>

      <!-- Section: Tránh -->
      <div class="section-label" style="margin-top:24px;"><span class="sl-num">5</span> Thực phẩm cần tránh</div>
      <div class="avoid-card">
        <div class="avoid-grid">
          <div class="avoid-row avoid-head">
            <span class="avoid-cell avoid-cell-a">⛔ Tránh</span>
            <span class="avoid-cell avoid-cell-b">Lý do</span>
            <span class="avoid-cell avoid-cell-c">✅ Thay thế</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Rượu bia</span>
            <span class="avoid-cell avoid-cell-b">Nguy cơ dị tật thai nhi (FAS)</span>
            <span class="avoid-cell avoid-cell-c">Nước lọc, nước dừa, sữa</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Cá biển lớn (cá thu, kiếm, ngừ đại dương)</span>
            <span class="avoid-cell avoid-cell-b">Nhiều thủy ngân</span>
            <span class="avoid-cell avoid-cell-c">Cá nhỏ: chép, rô, tôm, cua</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Thịt/cá sống (gỏi, sushi, tái)</span>
            <span class="avoid-cell avoid-cell-b">Nhiễm khuẩn, ký sinh trùng</span>
            <span class="avoid-cell avoid-cell-c">Nấu chín kỹ</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Trứng sống (lòng đào, kem tươi)</span>
            <span class="avoid-cell avoid-cell-b">Nguy cơ Salmonella</span>
            <span class="avoid-cell avoid-cell-c">Trứng chín kỹ</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Phô mai mềm chưa tiệt trùng</span>
            <span class="avoid-cell avoid-cell-b">Nguy cơ Listeria</span>
            <span class="avoid-cell avoid-cell-c">Phô mai tiệt trùng</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Gan động vật</span>
            <span class="avoid-cell avoid-cell-b">Quá nhiều vitamin A, ngộ độc thai</span>
            <span class="avoid-cell avoid-cell-c">Thịt nạc, trứng, cá</span>
          </div>
          <div class="avoid-row">
            <span class="avoid-cell avoid-cell-a">Caffeine &gt; 200mg/ngày</span>
            <span class="avoid-cell avoid-cell-b">Tăng nguy cơ sảy thai</span>
            <span class="avoid-cell avoid-cell-c">Giới hạn 1–2 tách cà phê nhỏ</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Safety -->
    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        <strong style="color:var(--ink);display:block;margin-bottom:4px;">Thông tin tham khảo</strong>
        Dựa trên khuyến nghị của <strong>WHO</strong>, <strong>Viện Dinh dưỡng Quốc gia</strong>, và <strong>ACOG</strong>. Mỗi thai kỳ khác nhau — hãy tham khảo bác sĩ sản khoa để có chế độ dinh dưỡng phù hợp nhất.
      </div>
    </div>
  </main>

  <style>
    .content-page { max-width: 800px; margin: 0 auto; padding: 32px 20px; }

    /* ── Header ── */
    .page-header { text-align:center; margin-bottom:28px; }
    .page-header h1 { display:flex; align-items:center; justify-content:center; gap:12px; margin:0 0 10px; }
    .h-icon { font-size:1.8rem; line-height:1; }
    .h-text { font-size:1.65rem; font-weight:800; letter-spacing:-0.02em; line-height:1.2; }
    .page-desc { max-width:560px; margin:0 auto; color:var(--ink-secondary); font-size:0.92rem; line-height:1.6; }

    /* ── Section labels ── */
    .section-label { display:flex; align-items:center; gap:10px; font-weight:700; font-size:0.9rem; margin:0 0 12px; color:var(--ink); }
    .sl-num { width:28px; height:28px; border-radius:50%; background:var(--brand-light); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.78rem; font-weight:800; flex-shrink:0; }

    /* ── Form ── */
    .form-card { background:var(--card); border:2px solid var(--line); border-radius:16px; padding:24px; margin-bottom:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04); transition:border-color 0.2s; }
    .form-card:focus-within { border-color:var(--brand); }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; margin-bottom:18px; }
    .form-row { }
    .form-row label { display:block; font-size:0.82rem; font-weight:600; margin-bottom:5px; color:var(--ink-secondary); }
    .input-wrap { display:flex; align-items:center; background:var(--bg); border:1px solid var(--line); border-radius:10px; transition:border-color 0.15s; }
    .input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 2px rgba(46,125,50,0.1); }
    .input-wrap input, .input-wrap select { flex:1; border:none; background:transparent; padding:11px 12px; font-size:0.92rem; color:var(--ink); outline:none; box-sizing:border-box; width:100%; }
    .input-wrap select { appearance:none; -webkit-appearance:none; cursor:pointer; font-weight:500; }
    .input-suffix { padding-right:12px; font-size:0.78rem; color:var(--ink-tertiary); font-weight:500; }
    .stage-wrap { position:relative; }
    .stage-arrow { position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:0.65rem; color:var(--ink-tertiary); pointer-events:none; }

    .btn-calc { width:100%; padding:14px; border:none; border-radius:12px; background:linear-gradient(135deg,#2e7d32,#388e3c); color:white; font-size:1rem; font-weight:700; cursor:pointer; transition:all 0.15s; font-family:inherit; box-shadow:0 2px 8px rgba(46,125,50,0.2); }
    .btn-calc:hover { opacity:0.9; transform:translateY(-1px); box-shadow:0 4px 12px rgba(46,125,50,0.3); }
    .btn-calc:active { transform:translateY(0); }

    /* ── Gain card ── */
    .gain-card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:22px; margin-bottom:24px; box-shadow:0 2px 6px rgba(0,0,0,0.04); }
    .gain-header { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
    .gain-emoji { font-size:1.8rem; line-height:1; }
    .gain-title { font-weight:700; font-size:0.95rem; }
    .gain-subtitle { font-size:0.78rem; color:var(--ink-tertiary); margin-top:2px; }
    .gain-visual { }
    .gain-bar-label { display:flex; justify-content:space-between; margin-bottom:6px; font-size:0.85rem; }
    .gain-current { font-weight:600; }
    .gain-target { font-weight:600; color:var(--brand); }
    .gain-bar-track { height:14px; background:var(--line); border-radius:10px; overflow:hidden; }
    .gain-bar-fill { height:100%; border-radius:10px; background:linear-gradient(90deg,#43a047,#66bb6a); transition:width 0.5s; }
    .gain-note { font-size:0.82rem; color:var(--ink-secondary); line-height:1.5; margin-top:10px; padding:10px 14px; background:var(--bg-soft); border-radius:8px; }

    /* ── Nutrient grid ── */
    .nutrient-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:12px; margin-bottom:24px; }
    .nutrient-card { position:relative; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:18px 14px 14px; text-align:center; transition:border-color 0.15s, transform 0.15s; }
    .nutrient-card:hover { border-color:var(--brand-light2); transform:translateY(-2px); }
    .nutrient-icon { font-size:1.4rem; line-height:1; }
    .nutrient-name { font-weight:600; font-size:0.78rem; margin:8px 0 4px; color:var(--ink-secondary); text-transform:uppercase; letter-spacing:0.04em; }
    .nutrient-value { font-size:1.35rem; font-weight:800; color:var(--brand); line-height:1.2; }
    .nutrient-unit { font-size:0.7rem; color:var(--ink-tertiary); margin-bottom:6px; }
    .nutrient-desc { font-size:0.75rem; color:var(--ink-tertiary); line-height:1.4; }

    /* ── Food sources ── */
    .food-card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:20px; margin-bottom:24px; }
    .food-lists { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:10px; }
    .food-source { padding:12px 16px; background:var(--bg-soft); border-radius:10px; border-left:3px solid var(--brand-light2); }
    .food-source strong { color:var(--brand); font-size:0.85rem; display:block; margin-bottom:5px; }
    .food-source span { font-size:0.81rem; color:var(--ink-secondary); line-height:1.6; }

    /* ── Avoid grid ── */
    .avoid-card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:0; overflow:hidden; margin-bottom:24px; }
    .avoid-grid { display:flex; flex-direction:column; }
    .avoid-row { display:grid; grid-template-columns:1fr 1fr 1fr; gap:0; }
    .avoid-row:not(:last-child) { border-bottom:1px solid var(--line-light); }
    .avoid-head { background:#ffebee; }
    [data-theme="dark"] .avoid-head { background:#2a1212; }
    .avoid-cell { padding:10px 12px; font-size:0.8rem; line-height:1.4; display:flex; align-items:center; }
    .avoid-cell-a { font-weight:600; }
    .avoid-cell-b { color:var(--ink-secondary); font-size:0.76rem; }
    .avoid-cell-c { color:var(--brand); font-weight:500; }
    .avoid-head .avoid-cell { font-weight:700; font-size:0.82rem; color:#b71c1c; }
    [data-theme="dark"] .avoid-head .avoid-cell { color:#ef9a9a; }

    /* ── Safety ── */
    .safety-note { display:flex; align-items:flex-start; gap:12px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--line-light); border-radius:12px; font-size:0.82rem; line-height:1.6; }
    .safety-icon-col { flex-shrink:0; font-size:1.1rem; }
    .safety-text-col { flex:1; color:var(--ink-secondary); }

    /* ── Responsive ── */
    @media (max-width:600px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.25rem; }
      .form-grid { grid-template-columns:1fr; gap:12px; }
      .nutrient-grid { grid-template-columns:repeat(2,1fr); gap:8px; }
      .food-lists { grid-template-columns:1fr; }
      .avoid-row { grid-template-columns:1fr; }
      .avoid-cell { padding:8px 12px; }
      .avoid-cell-b { display:none; }
    }
  </style>

  <script is:inline>
  function calculate() {
    var weight = parseFloat(document.getElementById('weight').value) || 55;
    var height = parseFloat(document.getElementById('height').value) || 160;
    var stage = document.getElementById('stage').value;
    var age = parseFloat(document.getElementById('age').value) || 28;

    var bmi = weight / ((height/100)*(height/100));

    // Weight gain recommendations (IOM guidelines)
    var gainRange, gainTarget, gainNote;
    if (bmi < 18.5) { gainRange = [12, 18]; gainNote = "Bạn có BMI thấp hơn chuẩn. Cần tăng cân nhiều hơn."; }
    else if (bmi < 25) { gainRange = [11, 16]; gainNote = "BMI bình thường. Duy trì tăng cân đều đặn."; }
    else if (bmi < 30) { gainRange = [7, 11]; gainNote = "Hơi thừa cân. Tăng cân ít hơn, kiểm soát khẩu phần."; }
    else { gainRange = [5, 9]; gainNote = "Béo phì. Tăng cân tối thiểu, cần theo dõi sát."; }

    // Gain by stage
    var gainPct;
    if (stage === 't1') gainPct = 0.15;
    else if (stage === 't2') gainPct = 0.55;
    else if (stage === 't3') gainPct = 0.85;
    else gainPct = 1;

    var currentGain = (gainRange[0] + (gainRange[1]-gainRange[0])*0.3) * gainPct;
    var targetText = 'mục tiêu: ' + gainRange[0] + '–' + gainRange[1] + ' kg';

    document.getElementById('gain-current').textContent = Math.round(currentGain*10)/10 + ' kg (ước tính)';
    document.getElementById('gain-target-text').textContent = targetText;
    document.getElementById('gain-fill').style.width = Math.min(currentGain / gainRange[1] * 100, 100) + '%';
    document.getElementById('gain-note').textContent = gainNote;

    // BMR
    var bmr = 655 + (9.6 * weight) + (1.8 * height) - (4.7 * age);

    // Calorie needs by stage
    var calMultiplier;
    if (stage === 't1') calMultiplier = 1.0; // +0 kcal day 1
    else if (stage === 't2') calMultiplier = 1.1; // +300
    else if (stage === 't3') calMultiplier = 1.2; // +450
    else calMultiplier = 1.25; // breastfeeding +500

    var calories = Math.round(bmr * calMultiplier * 1.2); // light activity

    // Nutrients by stage
    var nutrients = [];
    var base = {};

    if (stage === 't1') {
      base = { protein: 60, iron: 27, calcium: 800, folate: 600, dha: 200, fiber: 25, vitD: 600 };
    } else if (stage === 't2') {
      base = { protein: 75, iron: 27, calcium: 1000, folate: 600, dha: 300, fiber: 28, vitD: 600 };
    } else if (stage === 't3') {
      base = { protein: 85, iron: 27, calcium: 1200, folate: 600, dha: 300, fiber: 30, vitD: 800 };
    } else { // breastfeeding
      base = { protein: 80, iron: 15, calcium: 1200, folate: 500, dha: 300, fiber: 28, vitD: 800 };
    }

    nutrients.push(
      { icon: '🔥', name: 'Năng lượng', value: calories, unit: 'kcal/ngày', desc: stage === 't1' ? 'Chưa cần tăng thêm năng lượng' : stage === 't2' ? 'Cần thêm ~300 kcal/ngày' : stage === 't3' ? 'Cần thêm ~450 kcal/ngày' : 'Cần thêm ~500 kcal/ngày' },
      { icon: '🥩', name: 'Đạm', value: base.protein + 'g', unit: '/ngày', desc: stage === 'bf' ? 'Cần nhiều đạm để sản xuất sữa' : 'Cần cho sự phát triển của thai' },
      { icon: '🩸', name: 'Sắt', value: base.iron + 'mg', unit: '/ngày', desc: 'Ngừa thiếu máu — uống kèm vitamin C' },
      { icon: '🦴', name: 'Canxi', value: base.calcium + 'mg', unit: '/ngày', desc: 'Cho xương thai nhi. Nếu thiếu, cơ thể mẹ mất canxi từ xương' },
      { icon: '🍃', name: 'Folate (B9)', value: base.folate + 'mcg', unit: '/ngày', desc: 'Ngừa dị tật ống thần kinh — uống từ trước khi mang thai' },
      { icon: '🐟', name: 'DHA', value: base.dha + 'mg', unit: '/ngày', desc: 'Phát triển não bộ và mắt thai nhi' },
      { icon: '🌾', name: 'Chất xơ', value: base.fiber + 'g', unit: '/ngày', desc: 'Ngừa táo bón thai kỳ' },
      { icon: '☀️', name: 'Vitamin D', value: base.vitD + 'IU', unit: '/ngày', desc: 'Hấp thu canxi — nên tắm nắng 15 phút/ngày' }
    );

    // Render nutrient grid
    var grid = document.getElementById('nutrient-grid');
    grid.innerHTML = nutrients.map(function(n) {
      return '<div class="nutrient-card">' +
        '<div class="nutrient-icon">' + n.icon + '</div>' +
        '<div class="nutrient-name">' + n.name + '</div>' +
        '<div class="nutrient-value">' + n.value + '</div>' +
        '<div class="nutrient-unit">' + n.unit + '</div>' +
        '<div class="nutrient-desc">' + n.desc + '</div>' +
      '</div>';
    }).join('');

    // Food sources
    var foodsList = document.getElementById('food-lists');
    foodsList.innerHTML = [
      { title: '🥩 Đạm', items: 'Thịt nạc (heo, gà, bò) 100–150g/ngày · Trứng 1–2 quả · Cá 2–3 bữa/tuần · Đậu hũ 150g · Sữa 200ml' },
      { title: '🩸 Sắt', items: 'Thịt bò (80g chứa ~3mg sắt) · Tim, cật · Rau bina, cải ngọt (kèm vitamin C để hấp thu) · Đậu đỗ, hạt điều' },
      { title: '🦴 Canxi', items: 'Sữa 200ml (240mg) · Sữa chua 1 hộp · Cá nhỏ ăn cả xương (cá trích, cá cơm) · Rau ngót, cải xoăn · Tôm khô' },
      { title: '🍃 Folate', items: 'Rau xanh đậm: cải bó xôi, cải ngọt (200g ~200mcg) · Măng tây · Bơ · Các loại đậu · Bổ sung viên 400mcg/ngày' },
      { title: '🐟 DHA', items: 'Cá hồi (100g ~1000mg DHA) · Cá thu · Cá trích · Trứng gà (đặc biệt trứng omega-3) · Tảo biển (nếu ăn chay)' },
    ].map(function(s) {
      return '<div class="food-source"><strong>' + s.title + '</strong><span>' + s.items + '</span></div>';
    }).join('');

    document.getElementById('result').style.display = 'block';
    window.scrollTo({ top: document.getElementById('result').offsetTop - 20, behavior: 'smooth' });
  }

  // Auto-calculate on load
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(calculate, 100);
  });
  </script>
</BaseLayout>
