---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng ung thư đại trực tràng";
const desc = "Bảng kiểm ăn uống và theo dõi tiêu hóa trước/sau điều trị ung thư đại trực tràng.";
const items = [
  "Tôi ghi số lần đi tiêu, dạng phân, đau bụng, máu/nhầy và thay đổi sau điều trị",
  "Tôi duy trì đạm/năng lượng và chia nhỏ bữa khi nhanh no hoặc buồn nôn",
  "Tôi biết khi nào cần giảm tạm chất xơ thô theo hướng dẫn sau mổ/đợt tiêu chảy",
  "Tôi bù nước/điện giải phù hợp và theo dõi lượng tiểu",
  "Nếu có hậu môn nhân tạo, tôi biết cách theo dõi lượng và tính chất dịch ra",
  "Tôi mang danh sách thuốc, hóa trị/xạ trị và triệu chứng khi tái khám",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ung-thu-dai-truc-trang">
  <main class="colorectal-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung bướu–tiêu hóa</p>
      <h1>🧻 Checklist ung thư đại trực tràng</h1>
      <p>{desc} Khẩu phần cần điều chỉnh theo vị trí mổ, hậu môn nhân tạo, hóa trị và chức năng ruột.</p>
    </header>
    <form id="colorectal-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-colorectal /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần báo đội điều trị</h2>
      <p>Đau bụng tăng, bụng chướng, không trung tiện/đi tiêu, nôn, sốt, máu nhiều, hậu môn nhân tạo ra dịch quá nhiều hoặc tiểu ít.</p>
      <p class="warning">Không tự dùng thuốc cầm tiêu chảy, thuốc xổ hoặc tăng chất xơ khi nghi tắc ruột.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("colorectal-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-colorectal]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi triệu chứng và lượng ăn để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ ung bướu/ngoại khoa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .colorectal-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .colorectal-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
