---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { foods, recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";

const foodData = foods.map(f => ({
  id: f.id, slug: f.slug, name: f.name, category: f.category,
  kcal: f.nutrients.energyKcal || 0, protein: f.nutrients.proteinG || 0,
  fat: f.nutrients.fatG || 0, carb: f.nutrients.carbG || 0,
  fiber: f.nutrients.fiberG || 0, sodium: f.nutrients.sodiumMg || 0,
  cholesterol: f.nutrients.cholesterolMg || 0, satFat: f.nutrients.satFatG || 0,
  sugar: f.nutrients.sugarG || 0, calcium: f.nutrients.calciumMg || 0,
  iron: f.nutrients.ironMg || 0, potassium: f.nutrients.potassiumMg || 0,
}));

const recipeData = recipes.map(r => {
  const n = calculateRecipe(r);
  return {
    slug: r.slug, name: r.name, servingName: r.servingName || "", servingWeightG: r.servingWeightG || 0,
    kcal: n.energyKcal || 0, protein: n.proteinG || 0, fat: n.fatG || 0,
    carb: n.carbG || 0, fiber: n.fiberG || 0, sodium: n.sodiumMg || 0,
    sugar: n.sugarG || 0, satFat: n.satFatG || 0, cholesterol: n.cholesterolMg || 0,
  };
});
---
<BaseLayout title="Nhật ký ăn uống | Dinh Dưỡng Việt" description="Ghi chép bữa ăn hằng ngày và tổng hợp dữ liệu dinh dưỡng ở mức tham khảo." robots="noindex,follow">
  <div id="mt-root">
    <div style="margin-bottom:20px">
      <h1>📓 Nhật ký ăn uống</h1>
      <p style="color:var(--ink-secondary);">Ghi lại bữa ăn hằng ngày và xem tổng hợp dữ liệu đã nhập ở mức tham khảo, không thay thế tư vấn chuyên môn.</p>
      <div class="mt-safety-note">
        Nhật ký này lưu trên trình duyệt của bạn. Nếu bạn có bệnh nền, đang dùng thuốc, mang thai, là trẻ em, người cao tuổi hoặc cần chế độ ăn điều trị, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi dùng dữ liệu này để thay đổi chế độ ăn.
      </div>
    </div>

    <div class="mt-nav">
      <button class="mt-btn mt-btn-icon" onclick="MT.changeDate(-1)" title="Ngày trước">◀</button>
      <div style="flex:1;text-align:center;">
        <input type="date" id="mt-date" onchange="MT.goDate(this.value)" />
      </div>
      <button class="mt-btn mt-btn-icon" onclick="MT.changeDate(1)" title="Ngày sau">▶</button>
      <button class="mt-btn" onclick="MT.goToday()">Hôm nay</button>
      <button class="mt-btn" id="mt-copy-btn" onclick="MT.copyFromYesterday()" title="Sao chép từ hôm qua" style="display:none;">📋 Hôm qua</button>
      <button class="mt-btn" onclick="MT.exportCSV()" title="Xuất CSV tất cả nhật ký">📤 CSV</button>
      <button class="mt-btn" onclick="MT.exportPDF()" title="Xuất PDF ngày hiện tại">🖨️ PDF</button>
      <button class="mt-btn" onclick="MT.clearAllData()" title="Xóa toàn bộ nhật ký đang lưu trên thiết bị">🗑️ Xóa dữ liệu</button>
    </div>

    <div class="mt-summary" id="mt-summary"></div>
    <div class="mt-week-summary" id="mt-week-summary"></div>
    <div id="mt-meals"></div>

    <div style="text-align:center;margin:20px 0;">
      <button class="mt-btn mt-add-btn" onclick="MT.showAddDialog()">+ Thêm thực phẩm / món ăn</button>
    </div>

  </div>

  <div id="mt-overlay" class="mt-overlay" onclick="if(event.target===this)MT.hideAddDialog()">
    <div class="mt-dialog" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <strong>➕ Thêm thực phẩm / món ăn</strong>
        <button class="mt-btn-close" onclick="MT.hideAddDialog()">✕</button>
      </div>
      <input type="text" id="mt-search" class="mt-search-input" placeholder="Gõ tên thực phẩm hoặc món ăn..." oninput="MT.search(this.value)" autocomplete="off" />
      <div class="mt-search-results" id="mt-search-results"><div class="mt-hint">Gõ tên để tìm kiếm...</div></div>
    </div>
  </div>

  <div id="mt-overlay-port" class="mt-overlay" onclick="if(event.target===this)MT.hidePortionDialog()">
    <div class="mt-dialog" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <strong id="mt-port-title">⚖️ Chọn khẩu phần</strong>
        <button class="mt-btn-close" onclick="MT.hidePortionDialog()">✕</button>
      </div>
      <div id="mt-port-body"></div>
    </div>
  </div>

  <div id="mt-overlay-edit" class="mt-overlay" onclick="if(event.target===this)MT.hideEditDialog()">
    <div class="mt-dialog" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <strong id="mt-edit-title">✏️ Sửa khẩu phần</strong>
        <button class="mt-btn-close" onclick="MT.hideEditDialog()">✕</button>
      </div>
      <div id="mt-edit-body"></div>
    </div>
  </div>

  <script is:inline id="mt-foods" type="application/json" set:html={JSON.stringify(foodData)}></script>
  <script is:inline id="mt-recipes" type="application/json" set:html={JSON.stringify(recipeData)}></script>

  <script is:inline>
(function() {
  const FOODS = JSON.parse(document.getElementById("mt-foods").textContent);
  const RECIPES = JSON.parse(document.getElementById("mt-recipes").textContent);
  const SK = "mt-diary-v2";
  const TARGET_SK = "mt-target-v2";
  const MEAL_SLOTS = [
    { id: "sang", icon: "🌅", name: "Sáng" },
    { id: "trua", icon: "🌞", name: "Trưa" },
    { id: "chieu", icon: "🌆", name: "Chiều" },
    { id: "toi", icon: "🌙", name: "Tối" },
    { id: "phu", icon: "🍿", name: "Phụ" },
  ];

  const SAFETY_MESSAGE = "Nếu bạn có bệnh nền, đang dùng thuốc, mang thai, là trẻ em, người cao tuổi hoặc cần chế độ ăn điều trị, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi thay đổi chế độ ăn dựa vào nhật ký này.";

  let cur = new Date();
  let log = {};
  let targets = {};
  let addSlot = "sang";
  let pending = null;

  function fmt(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    return y + "-" + m + "-" + dd;
  }

  function ds() { return fmt(cur); }

  function dayLabel(d) {
    var days = ["CN", "T2", "T3", "T4", "T5", "T6", "T7"];
    var t = new Date();
    var a = fmt(d), b = fmt(t);
    if (a === b) return "Hôm nay";
    var y = new Date(t); y.setDate(y.getDate() - 1);
    if (a === fmt(y)) return "Hôm qua";
    var tom = new Date(t); tom.setDate(tom.getDate() + 1);
    if (a === fmt(tom)) return "Ngày mai";
    return days[d.getDay()] + ", " + d.getDate() + "/" + (d.getMonth() + 1);
  }

  function ensureDayLog(key) {
    if (!log[key]) {
      log[key] = { sang: [], trua: [], chieu: [], toi: [], phu: [] };
    }
    return log[key];
  }

  function load() {
    try {
      const raw = localStorage.getItem(SK);
      if (raw) log = JSON.parse(raw);
    } catch (e) {}
    if (!log || typeof log !== "object") log = {};
  }

  function loadTargets() {
    try {
      const raw = localStorage.getItem(TARGET_SK);
      if (raw) targets = JSON.parse(raw);
    } catch (e) {}
    if (!targets || typeof targets !== "object" || Array.isArray(targets)) targets = {};
  }

  function targetFor(key) {
    var value = Number(targets[key]);
    return Number.isFinite(value) && value > 0 ? value : null;
  }

  function save() {
    try {
      localStorage.setItem(SK, JSON.stringify(log));
    } catch (e) {}
  }

  function lookupItem(it) {
    if (it.type === "food") {
      return FOODS.find(function(x) { return x.id === it.id; }) || null;
    }
    if (it.type === "packaged") {
      return it;
    }
    return RECIPES.find(function(x) { return x.slug === it.id; }) || null;
  }

  function getName(it) {
    var found = lookupItem(it);
    return found ? found.name : String(it.id);
  }

  function getTypeLabel(it) {
    if (it.type === "packaged") return "Đóng gói";
    return it.type === "food" ? "Thực phẩm" : "Món ăn";
  }

  function getN(it) {
    var r = { kcal:0, protein:0, fat:0, carb:0, fiber:0, sodium:0, satFat:0, sugar:0, chol:0, ca:0, fe:0, k:0 };
    if (it.type === "packaged") {
      var pn = it.nutrients || {};
      var base = Number(it.serving) || 100;
      var ratio = it.amount / base;
      r.kcal = (Number(pn.energyKcal) || 0) * ratio;
      r.protein = (Number(pn.proteinG) || 0) * ratio;
      r.fat = (Number(pn.fatG) || 0) * ratio;
      r.carb = (Number(pn.carbG) || 0) * ratio;
      r.fiber = (Number(pn.fiberG) || 0) * ratio;
      r.sodium = (Number(pn.sodiumMg) || 0) * ratio;
      r.sugar = (Number(pn.sugarG) || 0) * ratio;
      return r;
    }
    if (it.type === "food") {
      var f = lookupItem(it);
      if (!f) return r;
      var ratio = it.amount / 100;
      r.kcal = f.kcal * ratio;
      r.protein = f.protein * ratio;
      r.fat = f.fat * ratio;
      r.carb = f.carb * ratio;
      r.fiber = (f.fiber || 0) * ratio;
      r.sodium = (f.sodium || 0) * ratio;
      r.satFat = (f.satFat || 0) * ratio;
      r.sugar = (f.sugar || 0) * ratio;
      r.ca = (f.calcium || 0) * ratio;
      r.fe = (f.iron || 0) * ratio;
      r.k = (f.potassium || 0) * ratio;
      return r;
    }
    var rec = lookupItem(it);
    if (!rec) return r;
    var p = it.amount / (rec.servingWeightG || 100);
    r.kcal = rec.kcal * p;
    r.protein = rec.protein * p;
    r.fat = rec.fat * p;
    r.carb = rec.carb * p;
    r.fiber = (rec.fiber || 0) * p;
    r.sodium = (rec.sodium || 0) * p;
    r.satFat = (rec.satFat || 0) * p;
    r.sugar = (rec.sugar || 0) * p;
    return r;
  }

  function sumDay(dayLog) {
    var t = { kcal:0, protein:0, fat:0, carb:0, fiber:0, sodium:0, satFat:0, sugar:0, chol:0, ca:0, fe:0, k:0 };
    Object.keys(dayLog).forEach(function(slot) {
      (dayLog[slot] || []).forEach(function(it) {
        var n = getN(it);
        Object.keys(t).forEach(function(key) { t[key] += n[key] || 0; });
      });
    });
    t.kcal = Math.round(t.kcal);
    t.protein = Math.round(t.protein);
    t.fat = Math.round(t.fat);
    t.carb = Math.round(t.carb);
    t.fiber = Math.round(t.fiber * 10) / 10;
    t.sodium = Math.round(t.sodium);
    t.satFat = Math.round(t.satFat * 10) / 10;
    t.sugar = Math.round(t.sugar * 10) / 10;
    t.ca = Math.round(t.ca);
    t.fe = Math.round(t.fe * 10) / 10;
    t.k = Math.round(t.k);
    return t;
  }

  function metricChip(icon, label, value) {
    var chip = document.createElement("div");
    chip.className = "mt-neutral-chip";
    chip.textContent = icon + " " + label + " " + value;
    return chip;
  }

  function targetMetric(label, value, target, unit, color) {
    var item = document.createElement("div");
    item.className = "mt-target-metric";
    var percent = Math.round((value / target) * 100);
    var head = document.createElement("div");
    head.className = "mt-target-metric-head";
    var name = document.createElement("span");
    name.textContent = label;
    var count = document.createElement("strong");
    count.textContent = value + "/" + target + unit + " · " + percent + "%";
    head.appendChild(name);
    head.appendChild(count);
    var track = document.createElement("div");
    track.className = "mt-target-track";
    var fill = document.createElement("div");
    fill.className = "mt-target-fill";
    fill.style.width = Math.min(percent, 100) + "%";
    fill.style.background = color;
    track.appendChild(fill);
    item.appendChild(head);
    item.appendChild(track);
    return item;
  }

  function hasEntries(dayLog) {
    return !!dayLog && Object.keys(dayLog).some(function(slot) {
      return Array.isArray(dayLog[slot]) && dayLog[slot].length > 0;
    });
  }

  function renderSummary(totals) {
    var el = document.getElementById("mt-summary");
    el.replaceChildren();

    var top = document.createElement("div");
    top.className = "mt-summary-top";

    var dateEl = document.createElement("span");
    dateEl.className = "mt-summary-date";
    dateEl.textContent = dayLabel(cur);

    var kcalEl = document.createElement("span");
    kcalEl.className = "mt-summary-kcal";
    kcalEl.textContent = "Tổng hợp dữ liệu đã nhập trong ngày";

    top.appendChild(dateEl);
    top.appendChild(kcalEl);

    var body = document.createElement("div");
    body.className = "mt-neutral-summary";

    body.appendChild(metricChip("🔥", "Năng lượng", totals.kcal + " kcal"));
    body.appendChild(metricChip("🥩", "Đạm", totals.protein + "g"));
    body.appendChild(metricChip("🧈", "Béo", totals.fat + "g"));
    body.appendChild(metricChip("🍚", "Carb", totals.carb + "g"));
    body.appendChild(metricChip("🌿", "Chất xơ", totals.fiber.toFixed(1) + "g"));
    body.appendChild(metricChip("🧂", "Natri", totals.sodium + "mg"));

    var note = document.createElement("div");
    note.className = "mt-summary-note";
    note.textContent = "Đây là tổng hợp trung tính từ dữ liệu đã nhập, không phải đánh giá kiểm soát bệnh hay mục tiêu điều trị.";

    var safety = document.createElement("div");
    safety.className = "mt-summary-safety";
    safety.textContent = SAFETY_MESSAGE;

    el.appendChild(top);
    el.appendChild(body);

    var targetRows = [
      { key: "kcal", label: "Năng lượng", value: totals.kcal, unit: " kcal", color: "#f97316" },
      { key: "protein", label: "Đạm", value: totals.protein, unit: "g", color: "#ef4444" },
      { key: "carb", label: "Carb", value: totals.carb, unit: "g", color: "#3b82f6" },
      { key: "fat", label: "Chất béo", value: totals.fat, unit: "g", color: "#eab308" },
    ].filter(function(metric) { return targetFor(metric.key) !== null; });

    var targetBox = document.createElement("div");
    targetBox.className = "mt-target-summary";
    if (targetRows.length) {
      var targetTitle = document.createElement("p");
      targetTitle.className = "mt-target-title";
      targetTitle.textContent = "Tiến độ theo mục tiêu bạn đã lưu";
      targetBox.appendChild(targetTitle);
      targetRows.forEach(function(metric) {
        targetBox.appendChild(targetMetric(metric.label, metric.value, targetFor(metric.key), metric.unit, metric.color));
      });
    } else {
      var targetEmpty = document.createElement("p");
      targetEmpty.className = "mt-target-empty";
      targetEmpty.textContent = "Chưa có mục tiêu số để đối chiếu. Bạn có thể lưu mốc năng lượng hoặc macro từ công cụ bên dưới.";
      var targetLink = document.createElement("a");
      targetLink.href = "/cong-cu/tinh-nang-luong";
      targetLink.textContent = "Ước tính năng lượng tham khảo →";
      targetBox.appendChild(targetEmpty);
      targetBox.appendChild(targetLink);
    }
    el.appendChild(targetBox);
    el.appendChild(note);
    el.appendChild(safety);
  }

  function renderWeekSummary() {
    var el = document.getElementById("mt-week-summary");
    el.replaceChildren();
    var days = [];
    for (var i = 6; i >= 0; i--) {
      var date = new Date(cur);
      date.setDate(date.getDate() - i);
      days.push(fmt(date));
    }
    var tracked = days.filter(function(key) { return hasEntries(log[key]); });
    if (!tracked.length) return;

    var totalKcal = 0;
    var totalProtein = 0;
    tracked.forEach(function(key) {
      var totals = sumDay(log[key]);
      totalKcal += totals.kcal;
      totalProtein += totals.protein;
    });
    var card = document.createElement("div");
    card.className = "mt-week-card";
    var title = document.createElement("strong");
    title.textContent = "Tóm tắt 7 ngày";
    var copy = document.createElement("p");
    copy.textContent = tracked.length + "/7 ngày đã có dữ liệu · Trung bình " + Math.round(totalKcal / tracked.length) + " kcal và " + Math.round(totalProtein / tracked.length) + "g đạm/ngày.";
    card.appendChild(title);
    card.appendChild(copy);
    var kcalTarget = targetFor("kcal");
    if (kcalTarget) {
      var targetCopy = document.createElement("span");
      targetCopy.className = "mt-week-target";
      targetCopy.textContent = "Mốc năng lượng đã lưu: " + kcalTarget + " kcal/ngày.";
      card.appendChild(targetCopy);
    }
    el.appendChild(card);
  }

  function renderMeals(dl) {
    var el = document.getElementById("mt-meals");
    el.replaceChildren();

    MEAL_SLOTS.forEach(function(slot) {
      var items = dl[slot.id] || [];
      var sum = items.reduce(function(acc, it) {
        var n = getN(it);
        acc.kcal += n.kcal;
        acc.protein += n.protein;
        return acc;
      }, { kcal: 0, protein: 0 });

      var meal = document.createElement("div");
      meal.className = "mt-meal";

      var head = document.createElement("div");
      head.className = "mt-meal-header";
      head.addEventListener("click", function() {
        meal.classList.toggle("collapsed");
      });

      var icon = document.createElement("span");
      icon.className = "mt-meal-icon";
      icon.textContent = slot.icon;

      var name = document.createElement("span");
      name.className = "mt-meal-name";
      name.textContent = slot.name;

      var sumText = document.createElement("span");
      sumText.className = "mt-meal-sum";
      sumText.textContent = "🔥 " + Math.round(sum.kcal) + " kcal · Đạm " + Math.round(sum.protein) + "g";

      var toggle = document.createElement("span");
      toggle.className = "mt-meal-toggle";
      toggle.textContent = "▼";

      head.appendChild(icon);
      head.appendChild(name);
      head.appendChild(sumText);
      head.appendChild(toggle);

      var body = document.createElement("div");
      body.className = "mt-meal-items";

      if (items.length === 0) {
        var empty = document.createElement("div");
        empty.className = "mt-empty";
        empty.textContent = 'Chưa có dữ liệu trong bữa này. Nhấn "+" để thêm.';
        body.appendChild(empty);
      } else {
        items.forEach(function(it, idx) {
          body.appendChild(renderItem(it, slot.id, idx));
        });
      }

      var addBtn = document.createElement("button");
      addBtn.className = "mt-add-small";
      addBtn.textContent = "+ Thêm";
      addBtn.addEventListener("click", function(e) {
        e.stopPropagation();
        showAddDialogForSlot(slot.id);
      });
      body.appendChild(addBtn);

      meal.appendChild(head);
      meal.appendChild(body);
      el.appendChild(meal);
    });
  }

  function renderItem(it, slotId, idx) {
    var n = getN(it);
    var wrap = document.createElement("div");
    wrap.className = "mt-item";

    var info = document.createElement("div");
    info.className = "mt-item-info";

    var strong = document.createElement("strong");
    strong.textContent = getName(it);

    var tag = document.createElement("span");
    tag.className = "mt-item-tag";
    tag.textContent = getTypeLabel(it);

    var amount = document.createElement("span");
    amount.className = "mt-item-amount";
    amount.textContent = it.amount + "g";

    info.appendChild(strong);
    info.appendChild(tag);
    info.appendChild(amount);

    var nutri = document.createElement("div");
    nutri.className = "mt-item-nutri";
    nutri.textContent = "🔥" + Math.round(n.kcal) + " · P" + Math.round(n.protein) + " · F" + Math.round(n.fat) + " · C" + Math.round(n.carb);

    var actions = document.createElement("div");
    actions.className = "mt-item-actions";

    var editBtn = document.createElement("button");
    editBtn.className = "mt-btn-sm";
    editBtn.title = "Sửa";
    editBtn.textContent = "✏️";
    editBtn.addEventListener("click", function(e) {
      e.stopPropagation();
      editItem(slotId, idx);
    });

    var delBtn = document.createElement("button");
    delBtn.className = "mt-btn-sm";
    delBtn.title = "Xóa";
    delBtn.textContent = "🗑️";
    delBtn.addEventListener("click", function(e) {
      e.stopPropagation();
      deleteItem(slotId, idx);
    });

    actions.appendChild(editBtn);
    actions.appendChild(delBtn);

    wrap.appendChild(info);
    wrap.appendChild(nutri);
    wrap.appendChild(actions);
    return wrap;
  }

  function updateCopyBtn() {
    var btn = document.getElementById("mt-copy-btn");
    if (!btn) return;
    var y = new Date(cur); y.setDate(y.getDate() - 1);
    var yl = log[fmt(y)];
    btn.style.display = (yl && Object.values(yl).some(function(a) { return a.length > 0; })) ? "" : "none";
  }

  function renderHint(message) {
    var res = document.getElementById("mt-search-results");
    res.replaceChildren();
    var hint = document.createElement("div");
    hint.className = "mt-hint";
    hint.textContent = message;
    res.appendChild(hint);
  }

  function renderSearchResults(items) {
    var res = document.getElementById("mt-search-results");
    res.replaceChildren();
    items.forEach(function(item) {
      var row = document.createElement("div");
      row.className = "mt-search-item";
      row.addEventListener("click", function() {
        showPortionDialog(item.type, item.id);
      });

      var icon = document.createElement("div");
      icon.className = "mt-si-icon";
      icon.textContent = item.type === "food" ? "🥬" : "🍲";

      var info = document.createElement("div");
      info.className = "mt-si-info";

      var strong = document.createElement("strong");
      strong.textContent = item.name;

      var type = document.createElement("span");
      type.className = "mt-si-type";
      type.textContent = item.type === "food" ? item.cat : "Món ăn";

      info.appendChild(strong);
      info.appendChild(type);

      var kcal = document.createElement("div");
      kcal.className = "mt-si-kcal";
      kcal.textContent = "🔥 " + Math.round(item.kcal) + " kcal" + (item.type === "food" ? "/100g" : "/" + (item.servingName || "khẩu phần"));

      row.appendChild(icon);
      row.appendChild(info);
      row.appendChild(kcal);
      res.appendChild(row);
    });
  }

  function renderPortionDialog(type, id) {
    pending = { type: type, id: id };
    var name = getName(pending);
    document.getElementById("mt-port-title").textContent = type === "food" ? "🥬 Thêm thực phẩm" : "🍲 Thêm món ăn";

    var body = document.getElementById("mt-port-body");
    body.replaceChildren();

    var intro = document.createElement("p");
    intro.style.marginBottom = "8px";
    intro.style.color = "var(--ink-secondary)";
    intro.style.fontSize = "0.9rem";
    intro.textContent = name;

    var amountLabel = document.createElement("label");
    amountLabel.textContent = "Khẩu phần (g) ";
    var amountInput = document.createElement("input");
    amountInput.type = "number";
    amountInput.id = "mt-port-amount";
    var selected = lookupItem({ type: type, id: id });
    amountInput.value = String(type === "recipe" && selected ? (selected.servingWeightG || 100) : 100);
    amountInput.min = "1";
    amountInput.step = "5";
    amountLabel.appendChild(amountInput);

    var slotLabel = document.createElement("label");
    slotLabel.textContent = "Bữa ăn ";
    var slotSelect = document.createElement("select");
    slotSelect.id = "mt-port-slot";
    MEAL_SLOTS.forEach(function(slot) {
      var opt = document.createElement("option");
      opt.value = slot.id;
      opt.textContent = slot.icon + " " + slot.name;
      slotSelect.appendChild(opt);
    });
    slotSelect.value = addSlot;
    slotLabel.appendChild(slotSelect);

    var preview = document.createElement("div");
    preview.id = "mt-port-preview";
    preview.style.fontSize = "0.85rem";
    preview.style.color = "var(--ink-tertiary)";
    preview.style.marginBottom = "12px";

    var actions = document.createElement("div");
    actions.style.display = "flex";
    actions.style.gap = "8px";

    var ok = document.createElement("button");
    ok.className = "mt-btn";
    ok.textContent = "✅ Thêm";
    ok.addEventListener("click", confirmAdd);

    var cancel = document.createElement("button");
    cancel.className = "mt-btn mt-btn-secondary";
    cancel.textContent = "Hủy";
    cancel.addEventListener("click", hidePortionDialog);

    actions.appendChild(ok);
    actions.appendChild(cancel);

    body.appendChild(intro);
    body.appendChild(amountLabel);
    body.appendChild(slotLabel);
    body.appendChild(preview);
    body.appendChild(actions);

    amountInput.addEventListener("input", function() { updatePreview(type, id); });
    updatePreview(type, id);
    document.getElementById("mt-overlay-port").style.display = "flex";
  }

  function updatePreview(type, id) {
    var amt = parseFloat(document.getElementById("mt-port-amount").value) || 100;
    var n = getN({ type: type, id: id, amount: amt });
    document.getElementById("mt-port-preview").textContent =
      "🔥 " + Math.round(n.kcal) + " kcal · P" + Math.round(n.protein) + "g · F" + Math.round(n.fat) + "g · C" + Math.round(n.carb) + "g";
  }

  function renderEditDialog(slotId, idx) {
    var it = ensureDayLog(ds())[slotId][idx];
    if (!it) return;
    document.getElementById("mt-edit-title").textContent = "✏️ Sửa khẩu phần";

    var body = document.getElementById("mt-edit-body");
    body.replaceChildren();

    var intro = document.createElement("p");
    intro.style.marginBottom = "8px";
    intro.style.color = "var(--ink-secondary)";
    intro.style.fontSize = "0.9rem";
    intro.textContent = getName(it);

    var amountLabel = document.createElement("label");
    amountLabel.textContent = "Khẩu phần (g) ";
    var amountInput = document.createElement("input");
    amountInput.type = "number";
    amountInput.id = "mt-edit-amount";
    amountInput.value = String(it.amount);
    amountInput.min = "1";
    amountInput.step = "5";
    amountLabel.appendChild(amountInput);

    var actions = document.createElement("div");
    actions.style.display = "flex";
    actions.style.gap = "8px";
    actions.style.marginTop = "12px";

    var ok = document.createElement("button");
    ok.className = "mt-btn";
    ok.textContent = "💾 Lưu";
    ok.addEventListener("click", function() { confirmEdit(slotId, idx); });

    var cancel = document.createElement("button");
    cancel.className = "mt-btn mt-btn-secondary";
    cancel.textContent = "Hủy";
    cancel.addEventListener("click", hideEditDialog);

    actions.appendChild(ok);
    actions.appendChild(cancel);

    body.appendChild(intro);
    body.appendChild(amountLabel);
    body.appendChild(actions);

    document.getElementById("mt-overlay-edit").style.display = "flex";
  }

  function render() {
    var dayLog = ensureDayLog(ds());
    renderSummary(sumDay(dayLog));
    renderWeekSummary();
    renderMeals(dayLog);
    updateCopyBtn();
  }

  function changeDate(delta) {
    cur.setDate(cur.getDate() + delta);
    document.getElementById("mt-date").value = ds();
    render();
  }

  function goDate(val) {
    var p = val.split("-");
    cur = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
    render();
  }

  function goToday() {
    cur = new Date();
    document.getElementById("mt-date").value = ds();
    render();
  }

  function showAddDialog() {
    addSlot = "sang";
    openSearch();
  }

  function showAddDialogForSlot(slotId) {
    addSlot = slotId;
    openSearch();
  }

  function openSearch() {
    document.getElementById("mt-search").value = "";
    renderHint("Gõ tên để tìm kiếm...");
    document.getElementById("mt-overlay").style.display = "flex";
    setTimeout(function() { document.getElementById("mt-search").focus(); }, 100);
  }

  function hideAddDialog() {
    document.getElementById("mt-overlay").style.display = "none";
  }

  function search(q) {
    var query = q.toLowerCase().trim();
    if (!query) {
      renderHint("Gõ tên để tìm kiếm...");
      return;
    }

    var fm = FOODS.filter(function(f) { return f.name.toLowerCase().includes(query); }).slice(0, 6);
    var rm = RECIPES.filter(function(r) { return r.name.toLowerCase().includes(query); }).slice(0, 6);
    var all = [];
    fm.forEach(function(f) { all.push({ type: "food", id: f.id, name: f.name, kcal: f.kcal, cat: f.category }); });
    rm.forEach(function(r) { all.push({ type: "recipe", id: r.slug, name: r.name, kcal: r.kcal, servingName: r.servingName }); });
    all = all.slice(0, 10);

    if (!all.length) {
      renderHint("Không tìm thấy - thử từ khóa khác");
      return;
    }
    renderSearchResults(all);
  }

  function showPortionDialog(type, id) {
    renderPortionDialog(type, id);
  }

  function hidePortionDialog() {
    document.getElementById("mt-overlay-port").style.display = "none";
    pending = null;
  }

  function confirmAdd() {
    if (!pending) return;
    var slotId = document.getElementById("mt-port-slot").value;
    var amt = parseFloat(document.getElementById("mt-port-amount").value) || 100;
    ensureDayLog(ds())[slotId].push({ type: pending.type, id: pending.id, amount: amt });
    save();
    hidePortionDialog();
    hideAddDialog();
    render();
  }

  function editItem(slotId, idx) {
    renderEditDialog(slotId, idx);
  }

  function hideEditDialog() {
    document.getElementById("mt-overlay-edit").style.display = "none";
  }

  function confirmEdit(slotId, idx) {
    var amt = parseFloat(document.getElementById("mt-edit-amount").value);
    if (!amt || amt <= 0) return;
    var item = ensureDayLog(ds())[slotId][idx];
    if (item) item.amount = amt;
    save();
    hideEditDialog();
    render();
  }

  function deleteItem(slotId, idx) {
    if (!confirm("Xóa mục này khỏi nhật ký?")) return;
    ensureDayLog(ds())[slotId].splice(idx, 1);
    save();
    render();
  }

  function copyFromYesterday() {
    var y = new Date(cur);
    y.setDate(y.getDate() - 1);
    var yl = log[fmt(y)];
    if (!yl) {
      alert("Không có dữ liệu hôm qua");
      return;
    }
    var target = ensureDayLog(ds());
    MEAL_SLOTS.forEach(function(slot) {
      target[slot.id] = (yl[slot.id] || []).map(function(it) {
        return { type: it.type, id: it.id, amount: it.amount };
      });
    });
    save();
    render();
    alert("✅ Đã sao chép từ " + dayLabel(y));
  }

  function clearAllData() {
    if (!confirm("Xóa toàn bộ nhật ký đang lưu trên thiết bị này?")) return;
    log = {};
    try {
      localStorage.removeItem(SK);
    } catch (e) {}
    render();
    updateCopyBtn();
    alert("✅ Đã xóa dữ liệu nhật ký lưu trên thiết bị.");
  }

  function exportCSV() {
    var allData = [];
    Object.keys(log).forEach(function(date) {
      var dl = log[date];
      if (!dl) return;
      Object.keys(dl).forEach(function(slotId) {
        (dl[slotId] || []).forEach(function(it) {
          var n = getN(it);
          allData.push({
            date: date,
            meal: slotId,
            name: getName(it),
            type: getTypeLabel(it),
            amount: it.amount + "g",
            kcal: Math.round(n.kcal),
            protein: Math.round(n.protein),
            fat: Math.round(n.fat),
            carb: Math.round(n.carb),
            fiber: n.fiber.toFixed(1),
            sodium: Math.round(n.sodium),
          });
        });
      });
    });
    if (allData.length === 0) {
      alert("Chưa có dữ liệu nhật ký");
      return;
    }
    allData.sort(function(a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
    var rows = [["Ngày", "Bữa", "Tên", "Loại", "Khẩu phần", "Kcal", "Đạm(g)", "Béo(g)", "Carb(g)", "Xơ(g)", "Natri(mg)"]];
    allData.forEach(function(r) {
      rows.push([r.date, r.meal, r.name, r.type, r.amount, r.kcal, r.protein, r.fat, r.carb, r.fiber, r.sodium]);
    });
    var csv = rows.map(function(r) {
      return r.map(function(v) { return '"' + String(v).replace(/"/g, '""') + '"'; }).join(",");
    }).join("\n");
    var blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "nhat-ky-an-uong.csv";
    a.click();
  }

  function exportPDF() {
    var d = ds();
    var dl = ensureDayLog(d);
    var totals = sumDay(dl);
    var h = '<html><head><meta charset="utf-8"><title>Nhật ký ăn uống - ' + d + '</title>';
    h += '<style>body{font-family:sans-serif;max-width:700px;margin:20px auto;padding:20px;color:#222;}h1{font-size:20px;margin-bottom:4px;}.sub{color:#666;font-size:13px;margin-bottom:20px;}table{width:100%;border-collapse:collapse;margin:10px 0;}th,td{padding:6px 8px;text-align:left;border-bottom:1px solid #ddd;font-size:13px;}th{background:#f5f5f5;font-size:12px;}.slot{background:#eef7f2;padding:6px 10px;margin-top:16px;font-weight:bold;font-size:14px;}.sum{background:#f6f8fa;padding:10px;border-radius:6px;margin-top:16px;font-size:13px;}@media print{body{margin:0;padding:15px;}}</style></head><body>';
    h += '<h1>📓 Nhật ký ăn uống</h1><div class="sub">' + dayLabel(cur) + ' — ' + d + '</div>';
    MEAL_SLOTS.forEach(function(slot) {
      var items = dl[slot.id] || [];
      if (!items.length) return;
      h += '<div class="slot">' + slot.icon + ' ' + slot.name + '</div>';
      h += '<table><tr><th>Tên</th><th>Loại</th><th>Khẩu phần</th><th>Kcal</th><th>Đạm</th><th>Béo</th><th>Carb</th></tr>';
      items.forEach(function(it) {
        var n = getN(it);
        h += '<tr><td>' + getName(it) + '</td><td>' + getTypeLabel(it) + '</td><td>' + it.amount + 'g</td><td>' + Math.round(n.kcal) + '</td><td>' + Math.round(n.protein) + 'g</td><td>' + Math.round(n.fat) + 'g</td><td>' + Math.round(n.carb) + 'g</td></tr>';
      });
      h += '</table>';
    });
    h += '<div class="sum"><b>Tổng hợp dữ liệu đã nhập:</b> 🔥 ' + totals.kcal + ' kcal | 🥩 Đạm ' + totals.protein + 'g | 🧈 Béo ' + totals.fat + 'g | 🍚 Carb ' + totals.carb + 'g | 🌿 Chất xơ ' + totals.fiber.toFixed(1) + 'g | 🧂 Natri ' + totals.sodium + 'mg</div>';
    h += '<div style="margin-top:12px;font-size:11px;color:#666;">' + SAFETY_MESSAGE + '</div>';
    h += '</body></html>';

    var win = window.open('', '_blank', 'width=700,height=600,scrollbars=yes');
    if (!win) {
      alert('Trình duyệt chặn popup. Cho phép popup để xuất PDF.');
      return;
    }
    win.document.write(h);
    win.document.close();
    win.focus();
    setTimeout(function() { win.print(); }, 300);
  }

  window.MT = {
    changeDate: changeDate,
    goDate: goDate,
    goToday: goToday,
    showAddDialog: showAddDialog,
    showAddDialogForSlot: showAddDialogForSlot,
    hideAddDialog: hideAddDialog,
    search: search,
    showPortionDialog: showPortionDialog,
    hidePortionDialog: hidePortionDialog,
    confirmAdd: confirmAdd,
    editItem: editItem,
    hideEditDialog: hideEditDialog,
    confirmEdit: confirmEdit,
    deleteItem: deleteItem,
    copyFromYesterday: copyFromYesterday,
    clearAllData: clearAllData,
    exportCSV: exportCSV,
    exportPDF: exportPDF,
  };

  document.addEventListener("DOMContentLoaded", function() {
    load();
    loadTargets();
    document.getElementById("mt-date").value = ds();
    render();
  });
})();
</script>

<style is:global>
