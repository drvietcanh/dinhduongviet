---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi hóa trị";
const desc = "Bảng kiểm ăn uống và an toàn thực phẩm cho người đang hóa trị hoặc có nguy cơ giảm bạch cầu.";
const items = [
  "Tôi đã hỏi ê-kíp điều trị về thực phẩm cần tránh và mức an toàn riêng",
  "Thịt, cá, trứng được nấu chín kỹ; sữa/nước dùng là loại an toàn, còn hạn",
  "Rau quả được rửa dưới vòi nước sạch và bảo quản tách khỏi thực phẩm sống",
  "Tôi chia nhỏ bữa và có lựa chọn dễ ăn khi buồn nôn hoặc nhanh no",
  "Tôi theo dõi lượng nước tiểu, nôn ói, tiêu chảy và khả năng uống nước",
  "Tôi có kế hoạch chăm sóc miệng khi đau rát, loét miệng hoặc khô miệng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-hoa-tri">
  <main class="chemo-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung bướu</p>
      <h1>🎗️ Checklist dinh dưỡng khi hóa trị</h1>
      <p>{desc} Mức hạn chế thực phẩm phụ thuộc phác đồ, xét nghiệm và hướng dẫn của trung tâm điều trị.</p>
    </header>
    <form id="chemo-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-chemo /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Khi nào cần gọi cơ sở điều trị?</h2>
      <p>Sốt theo ngưỡng trung tâm điều trị đã dặn, rét run, khó thở, lú lẫn, nôn không giữ được nước, tiêu chảy nhiều, chảy máu, đau miệng khiến không uống được hoặc tiểu rất ít.</p>
      <p class="warning">Không tự dùng thuốc hạ sốt, kháng sinh, men vi sinh hay thực phẩm bổ sung để che lấp triệu chứng khi chưa hỏi ê-kíp ung bướu.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("chemo-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-chemo]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi triệu chứng và mang danh sách này khi tái khám.</p>`
        : `<h2>Còn ${missing} mục nên làm rõ</h2><p>Hãy hỏi điều dưỡng, bác sĩ ung bướu hoặc chuyên gia dinh dưỡng trước khi tự thay đổi chế độ ăn.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .chemo-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .chemo-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
