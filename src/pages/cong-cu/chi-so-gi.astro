---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Chỉ số GI thực phẩm Việt";
const desc =
  "Tìm hiểu ý nghĩa chỉ số GI ở mức tham khảo và các tình huống cần hỏi bác sĩ hoặc chuyên gia.";

const safetySituations = [
  "Đang có đái tháo đường, tiền đái tháo đường, rối loạn đường huyết hoặc từng hạ đường huyết",
  "Đang dùng insulin, sulfonylurea hoặc thuốc hạ đường huyết khác",
  "Đang mang thai, cho con bú, là trẻ em, người cao tuổi yếu hoặc đang sụt cân",
  "Có bệnh thận, bệnh gan, bệnh tim mạch hoặc đang dùng nhiều thuốc cùng lúc",
  "Muốn biết một món cụ thể có phù hợp với bữa ăn, thuốc hoặc mục tiêu chăm sóc cá nhân hay không",
];

const limits = [
  "GI chỉ mô tả tốc độ làm tăng đường huyết của thực phẩm chứa carbohydrate trong điều kiện thử nghiệm.",
  "GI không đủ để quyết định một món có phù hợp cho từng người hay từng bệnh nền hay không.",
  "Khẩu phần, lượng carbohydrate thực tế, cách chế biến, món ăn đi kèm, vận động và thuốc đang dùng đều có thể làm thay đổi đáp ứng sau ăn.",
  "V1 không đặt mốc GI, carb hoặc chỉ số theo dõi cá nhân.",
];

const prepareItems = [
  "Tên món, khẩu phần thực tế và thời điểm ăn trong ngày",
  "Các món ăn kèm, nước uống, nước chấm hoặc món tráng miệng trong cùng bữa",
  "Thuốc đang dùng, triệu chứng hạ đường huyết nếu từng có và kết quả theo dõi gần đây",
  "Lời dặn hiện tại của bác sĩ hoặc chuyên gia về carbohydrate, bữa ăn và theo dõi đường huyết",
];

const relatedLinks = [
  {
    href: "/cong-cu/tinh-carb",
    title: "Tính carb trong bữa ăn",
    desc: "Ước tính lượng carbohydrate từ khẩu phần thực tế.",
  },
  {
    href: "/cong-cu/tinh-gl-bua-an",
    title: "Tính GL từ bữa ăn",
    desc: "Ước tính tải đường huyết của bữa ăn trong phạm vi đã kiểm v1.",
  },
  {
    href: "/cong-cu/khau-phan-viet-clinical",
    title: "Đánh giá khẩu phần Việt",
    desc: "Xem khẩu phần ở mức giáo dục dinh dưỡng, không thay thế tư vấn cá nhân.",
  },
  {
    href: "/cong-cu/muc-tieu-dinh-duong",
    title: "Mục tiêu dinh dưỡng",
    desc: "Định hướng mục tiêu dinh dưỡng với cờ cần cá thể hóa.",
  },
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/chi-so-gi">
  <main class="gi-page">
    <section class="hero">
      <p class="eyebrow">Trang tham khảo</p>
      <h1>Chỉ số GI thực phẩm Việt</h1>
      <p class="lead">
        Trang này chỉ giải thích GI như một khái niệm tham khảo về thực phẩm chứa carbohydrate.
        Không dùng trang này để tự kết luận một món ăn phù hợp hay không phù hợp với bệnh nền,
        thuốc đang dùng hoặc mục tiêu chăm sóc cá nhân.
      </p>
    </section>

    <section class="safety-card" aria-labelledby="safety-title">
      <h2 id="safety-title">Khi nào cần hỏi chuyên môn?</h2>
      <p>
        Nếu bạn có bệnh nền, đang dùng thuốc hoặc cần cá thể hóa bữa ăn, hãy trao đổi với bác sĩ
        hoặc chuyên gia dinh dưỡng trước khi thay đổi khẩu phần, lượng carb hoặc kế hoạch theo dõi.
      </p>
      <ul>
        {safetySituations.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="info-grid" aria-label="Giới hạn của GI">
      <article class="info-panel">
        <h2>GI cho biết điều gì?</h2>
        <p>
          GI là một cách mô tả tương đối tốc độ làm tăng đường huyết sau khi ăn một thực phẩm
          chứa carbohydrate. Con số này có thể thay đổi theo giống thực phẩm, độ chín, cách nấu,
          cách bảo quản và khẩu phần thực tế.
        </p>
      </article>

      <article class="info-panel">
        <h2>Trang này không làm gì?</h2>
        <ul>
          {limits.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section class="info-grid" aria-label="Chuẩn bị thông tin">
      <article class="info-panel">
        <h2>Nên mang theo khi đi khám</h2>
        <ul>
          {prepareItems.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="info-panel">
        <h2>Công cụ liên quan đã kiểm</h2>
        <div class="link-list">
          {relatedLinks.map((link) => (
            <a href={link.href} class="tool-link">
              <strong>{link.title}</strong>
              <span>{link.desc}</span>
            </a>
          ))}
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .gi-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 32px 16px 48px;
  }

  .hero {
    margin-bottom: 22px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 10px;
    font-size: 1.9rem;
    line-height: 1.2;
  }

  h2 {
    margin: 0 0 10px;
    font-size: 1.15rem;
  }

  .lead,
  .safety-card p,
  .info-panel p,
  .tool-link span {
    color: var(--ink-secondary);
    line-height: 1.65;
  }

  .safety-card,
  .info-panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    padding: 18px;
  }

  .safety-card {
    margin-bottom: 16px;
    background: var(--brand-light);
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 16px;
  }

  ul {
    margin: 10px 0 0;
    padding-left: 20px;
  }

  li {
    margin: 7px 0;
    line-height: 1.5;
  }

  .link-list {
    display: grid;
    gap: 10px;
  }

  .tool-link {
    display: block;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px;
    color: inherit;
    text-decoration: none;
    background: var(--bg-soft);
  }

  .tool-link:hover {
    border-color: var(--brand);
  }

  .tool-link strong,
  .tool-link span {
    display: block;
  }

  .tool-link span {
    margin-top: 4px;
    font-size: 0.86rem;
  }

  @media (max-width: 700px) {
    .gi-page {
      padding: 24px 14px 40px;
    }

    h1 {
      font-size: 1.55rem;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
