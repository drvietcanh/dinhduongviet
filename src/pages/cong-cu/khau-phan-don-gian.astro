---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Khẩu phần tham khảo";
const desc =
  "Tìm hiểu khẩu phần ở mức tham khảo bằng chén, muỗng, lát hoặc miếng, không dùng để kết luận bữa ăn đủ chất hay phù hợp cho bệnh.";

const portionGroups = [
  {
    title: "Tinh bột",
    items: [
      "1 chén cơm trắng",
      "1 bát bún tươi vừa",
      "1 bát bánh phở vừa",
      "1 củ khoai lang cỡ vừa",
      "2 lát bánh mì nguyên cám",
    ],
  },
  {
    title: "Đạm",
    items: [
      "1 miếng thịt nạc cỡ lòng bàn tay",
      "1 miếng cá phi lê cỡ lòng bàn tay",
      "1 quả trứng",
      "1 miếng đậu phụ",
      "10-12 con tôm cỡ vừa",
    ],
  },
  {
    title: "Rau và trái cây",
    items: [
      "1 bát rau luộc",
      "1 đĩa rau sống",
      "1 quả cam cỡ vừa",
      "1 quả chuối cỡ vừa",
      "2 lát dưa hấu",
    ],
  },
  {
    title: "Dụng cụ dân gian",
    items: [
      "1 muỗng canh dầu ăn",
      "1 muỗng cà phê đường",
      "1 ly sữa khoảng 200 ml",
      "1 nắm nhỏ các loại hạt",
      "1 lát phô mai",
    ],
  },
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/khau-phan-don-gian">
  <main class="content-page portion-page">
    <header class="page-header">
      <h1>🥣 Khẩu phần tham khảo</h1>
      <p class="page-desc">{desc}</p>
    </header>

    <section class="safety-shell" aria-label="Luu y tham khao">
      <p>
        Công cụ này chỉ cung cấp thông tin tham khảo để giúp bạn hiểu cách gọi một khẩu phần bằng chén,
        muỗng, lát, miếng hoặc ly. Đây không phải khẩu phần cá nhân và không dùng để đánh giá bữa ăn theo
        mục tiêu dinh dưỡng hoặc bệnh lý cụ thể.
      </p>
      <p>
        Khẩu phần thực tế phụ thuộc món ăn, cách chế biến, khối lượng thật, dụng cụ đo và bối cảnh sức khỏe.
        Nếu cần khẩu phần điều trị hoặc mục tiêu cá nhân, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng.
      </p>
    </section>

    <section class="intro-panel" aria-labelledby="portion-intro-title">
      <h2 id="portion-intro-title">Khẩu phần là gì?</h2>
      <p>
        Khẩu phần là một cách gọi nhanh để hình dung lượng thực phẩm thường gặp. Cùng một tên gọi như
        <em>1 chén</em>, <em>1 ly</em> hay <em>1 muỗng</em> có thể khác nhau giữa các gia đình, quán ăn
        hoặc nhãn sản phẩm.
      </p>
      <p>
        Các ví dụ dưới đây chỉ để minh họa cách hiểu khẩu phần ở mức định hướng. Không nên dùng riêng các ví
        dụ này để tự xây dựng thực đơn, mục tiêu giảm cân, tăng cân hay chế độ ăn điều trị.
      </p>
    </section>

    <section class="group-grid" aria-label="Vi du khau phan tham khao">
      {portionGroups.map((group) => (
        <article class="group-card">
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="notes-panel" aria-labelledby="portion-notes-title">
      <h2 id="portion-notes-title">Ghi chú khi dùng khẩu phần tham khảo</h2>
      <ul>
        <li>Kiểm tra lại nhãn sản phẩm nếu thực phẩm có ghi khẩu phần trên bao bì.</li>
        <li>Dụng cụ đong như chén, muỗng, ly chỉ là ước lượng và có thể khác nhau.</li>
        <li>Khối lượng thực tế thay đổi theo cách cắt, nấu, nén, xới hoặc lượng đá, nước đi kèm.</li>
        <li>Không dùng công cụ này để tự chẩn đoán vấn đề dinh dưỡng hoặc tự điều chỉnh thuốc.</li>
      </ul>
    </section>

    <section class="clinical-shell" aria-label="Can hoi chuyen gia khi can">
      <p>
        Người có tiểu đường, bệnh thận, bệnh tim mạch, gout, suy tim, ung thư, thai kỳ, trẻ em, người cao
        tuổi, rối loạn ăn uống hoặc đang dùng thuốc nên hỏi bác sĩ hoặc chuyên gia dinh dưỡng nếu cần khẩu
        phần cá nhân.
      </p>
      <p>
        Không tự chỉnh insulin, thuốc hạ đường huyết, lợi tiểu hoặc chế độ điều trị dựa trên công cụ này.
      </p>
    </section>
  </main>

  <style>
    .portion-page {
      max-width: 920px;
      margin: 0 auto;
    }
    .page-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .page-desc {
      max-width: 680px;
      margin: 10px auto 0;
      color: var(--ink-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .safety-shell,
    .intro-panel,
    .notes-panel,
    .clinical-shell,
    .group-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 18px;
    }
    .safety-shell,
    .clinical-shell {
      background: var(--brand-light);
    }
    .safety-shell,
    .intro-panel,
    .group-grid,
    .notes-panel,
    .clinical-shell {
      margin-bottom: 18px;
    }
    .safety-shell p,
    .intro-panel p,
    .clinical-shell p {
      margin: 0;
      color: var(--ink-secondary);
      line-height: 1.6;
      font-size: 0.94rem;
    }
    .safety-shell p + p,
    .intro-panel p + p,
    .clinical-shell p + p {
      margin-top: 10px;
    }
    .intro-panel h2,
    .notes-panel h2,
    .group-card h2 {
      margin: 0 0 10px;
      font-size: 1.05rem;
    }
    .group-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .group-card ul,
    .notes-panel ul {
      margin: 0;
      padding-left: 18px;
      color: var(--ink-secondary);
      line-height: 1.6;
      font-size: 0.93rem;
    }
    .group-card li + li,
    .notes-panel li + li {
      margin-top: 8px;
    }
    @media (max-width: 700px) {
      .group-grid {
        grid-template-columns: 1fr;
      }
      .safety-shell,
      .intro-panel,
      .notes-panel,
      .clinical-shell,
      .group-card {
        padding: 16px;
      }
    }
  </style>
</BaseLayout>
