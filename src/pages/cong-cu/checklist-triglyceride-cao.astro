---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist triglyceride rất cao";
const desc = "Bảng kiểm ăn uống và thuốc khi triglyceride tăng cao, giúp giảm nguy cơ viêm tụy.";
const items = [
  "Tôi biết mức triglyceride gần nhất và đã hẹn kiểm tra lại theo chỉ định",
  "Tôi ngừng rượu bia và giảm mạnh đồ uống có đường, bánh kẹo, đường thêm",
  "Tôi rà soát đái tháo đường, suy giáp, bệnh thận/gan và thuốc có thể làm tăng triglyceride",
  "Tôi chọn khẩu phần chất béo phù hợp theo bác sĩ, tránh món chiên và ăn quá nhiều một lần",
  "Tôi dùng fibrate/statin/dầu cá kê đơn đúng hướng dẫn và báo mọi thực phẩm bổ sung",
  "Tôi biết dấu hiệu viêm tụy: đau bụng dữ dội lan ra lưng, nôn, sốt hoặc bụng chướng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-triglyceride-cao">
  <main class="tg-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chuyển hóa</p>
      <h1>🧪 Checklist triglyceride rất cao</h1>
      <p>{desc} Khi mức rất cao, cần phối hợp bác sĩ nội tiết/tim mạch; ăn kiêng đơn độc có thể không đủ.</p>
    </header>
    <form id="tg-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-tg /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu khi</h2>
      <p>Đau bụng dữ dội vùng thượng vị lan ra lưng, nôn liên tục, sốt, bụng chướng hoặc choáng.</p>
      <p class="warning">Không tự dùng dầu cá liều cao, niacin, fibrate hoặc nhịn ăn để hạ triglyceride.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("tg-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-tg]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi thuốc, rượu bia, đồ uống có đường và xét nghiệm để tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ nội tiết/tim mạch hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .tg-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .tg-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
