---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Advanced food filter — filter 667+ thực phẩm VN theo chất dinh dưỡng, tags, nhóm
---

<BaseLayout title="Lọc thực phẩm nâng cao - Dinh Dưỡng Việt">
  <section>
    <span class="badge">🔬 Công cụ</span>
    <h1>Lọc thực phẩm nâng cao</h1>
    <p class="lead">
      Lọc thực phẩm theo tên, nhóm và chỉ số dinh dưỡng ở mức dữ liệu tham khảo.
      Các bộ lọc bên dưới chỉ giúp sắp xếp dữ liệu trung tính, không thay thế tư vấn của bác sĩ hoặc chuyên gia dinh dưỡng.
    </p>
  </section>

  <section class="section card safety-shell">
    <p>
      Dữ liệu trong v1 chủ yếu hiển thị theo <strong>100g phần ăn được</strong>. Không dùng công cụ này để kết luận thực phẩm
      nào “an toàn”, “phù hợp”, hay “nên/không nên ăn” cho bệnh nền. Nếu bạn có đái tháo đường, bệnh thận, tăng huyết áp,
      gout, suy tim, đang dùng thuốc, đang mang thai, là trẻ em hoặc người cao tuổi, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng
      khi cần cá thể hóa.
    </p>
  </section>

  <section class="section card">
    <h2>🔍 Bộ lọc</h2>
    <form id="filter-form">
      <!-- Tìm kiếm từ khoá -->
      <div style="margin-bottom: 14px;">
        <label for="keyword">Từ khoá</label>
        <input type="text" id="keyword" placeholder="Gõ tên thực phẩm..." style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid var(--line);font-size:1rem;box-sizing:border-box;" />
      </div>

      <div class="grid-filters">
        <!-- Nhóm thực phẩm -->
        <div>
          <label>Nhóm thực phẩm</label>
          <select id="category">
            <option value="">Tất cả</option>
            <option value="Tinh bột">Tinh bột</option>
            <option value="Thịt">Thịt</option>
            <option value="Cá">Cá</option>
            <option value="Hải sản">Hải sản</option>
            <option value="Trứng sữa">Trứng & Sữa</option>
            <option value="Đậu">Đậu & Hạt</option>
            <option value="Rau xanh">Rau xanh</option>
            <option value="Củ quả">Củ quả</option>
            <option value="Trái cây">Trái cây</option>
            <option value="Nấm">Nấm</option>
            <option value="Dầu mỡ">Dầu mỡ</option>
            <option value="Gia vị">Gia vị</option>
            <option value="Rau gia vị">Rau gia vị</option>
            <option value="Hạt">Hạt</option>
            <option value="Đồ uống">Đồ uống</option>
            <option value="Bánh kẹo">Bánh kẹo</option>
            <option value="Nước dùng">Nước dùng</option>
            <option value="Thịt chế biến">Thịt chế biến</option>
          </select>
        </div>

        <!-- Trạng thái -->
        <div>
          <label>Trạng thái</label>
          <select id="state">
            <option value="">Tất cả</option>
            <option value="raw">Sống / Tươi</option>
            <option value="cooked">Đã nấu chín</option>
            <option value="processed">Chế biến sẵn</option>
            <option value="dried">Khô / Sấy</option>
            <option value="roasted">Rang</option>
          </select>
        </div>

        <!-- Năng lượng -->
        <div>
          <label>Năng lượng (kcal/100g)</label>
          <div class="range-group">
            <input type="number" id="kcal-min" placeholder="Tối thiểu" min="0" />
            <span>→</span>
            <input type="number" id="kcal-max" placeholder="Tối đa" min="0" />
          </div>
        </div>

        <!-- Đạm -->
        <div>
          <label>Đạm (g/100g)</label>
          <div class="range-group">
            <input type="number" id="protein-min" placeholder="Tối thiểu" min="0" step="0.1" />
            <span>→</span>
            <input type="number" id="protein-max" placeholder="Tối đa" min="0" step="0.1" />
          </div>
        </div>

        <!-- Chất xơ -->
        <div>
          <label>Chất xơ (g/100g)</label>
          <div class="range-group">
            <input type="number" id="fiber-min" placeholder="Tối thiểu" min="0" step="0.1" />
            <span>→</span>
            <input type="number" id="fiber-max" placeholder="Tối đa" min="0" step="0.1" />
          </div>
        </div>

        <!-- Natri -->
        <div>
          <label>Natri (mg/100g)</label>
          <div class="range-group">
            <input type="number" id="sodium-min" placeholder="Tối thiểu" min="0" />
            <span>→</span>
            <input type="number" id="sodium-max" placeholder="Tối đa" min="0" />
          </div>
        </div>

        <!-- Sắt -->
        <div>
          <label>Sắt (mg/100g)</label>
          <div class="range-group">
            <input type="number" id="iron-min" placeholder="Tối thiểu" min="0" step="0.1" />
            <span>→</span>
            <input type="number" id="iron-max" placeholder="Tối đa" min="0" step="0.1" />
          </div>
        </div>

        <!-- Canxi -->
        <div>
          <label>Canxi (mg/100g)</label>
          <div class="range-group">
            <input type="number" id="calcium-min" placeholder="Tối thiểu" min="0" />
            <span>→</span>
            <input type="number" id="calcium-max" placeholder="Tối đa" min="0" />
          </div>
        </div>
      </div>

      <!-- Tags -->
      <div style="margin-top: 14px;">
        <label>Bộ lọc nhanh theo dữ liệu</label>
        <div class="tag-filters">
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="low-sodium" /> 🧂 Ít natri (&lt;120mg)</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="low-fat" /> 🥩 Ít béo (&lt;3g)</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="high-potassium" /> 🥔 Nhiều kali (&gt;250mg)</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="low-purine" /> 🫘 Ít purin</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="high-purine" /> ⚠️ Nhiều purin</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="glycemic-index-low" /> 🟢 GI thấp</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="glycemic-index-high" /> 🔴 GI cao</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="high-fat" /> 🔺 Nhiều béo</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="high-sodium" /> ⚠️ Nhiều natri</label>
          <label class="tag-chip"><input type="checkbox" class="tag-cb" data-tag="low-potassium" /> ⬇️ Ít kali</label>
        </div>
      </div>

      <button type="submit" class="btn" style="margin-top: 16px;">🔍 Lọc</button>
    </form>
  </section>

  <section id="results-section" style="margin-top: 20px; display:none;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <h2 style="margin:0;">Kết quả</h2>
      <span id="result-count" class="muted">— thực phẩm</span>
    </div>
    <div id="results-list" class="results-grid"></div>
  </section>
</BaseLayout>

<style>
  label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.9rem; }
  select { width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:8px; font-size:0.95rem; background:white; }
  .grid-filters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .range-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .range-group input {
    flex: 1;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.9rem;
    min-width: 0;
  }
  .range-group span { color: var(--ink-tertiary); }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border: 1px solid #d1d5db;
    border-radius: 16px;
    font-size: 0.85rem;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.15s;
    user-select: none;
  }
  .tag-chip:hover { border-color: #60a5fa; background: var(--bg-info); }
  .tag-chip input { display: none; }
  .tag-chip:has(input:checked) {
    border-color: #2563eb;
    background: #dbeafe;
    box-shadow: 0 0 0 1px #2563eb;
  }

  .btn {
    padding: 12px 28px;
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .btn:hover { background: var(--brand-dark); }

  .safety-shell p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-secondary);
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }
  .food-card {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s;
    background: var(--card);
  }
  .food-card:hover { border-color: #93c5fd; background: var(--card-hover); }
  .fc-name { font-weight: 600; font-size: 0.95rem; margin-bottom: 4px; }
  .fc-detail { font-size: 0.8rem; color: #6b7280; display: flex; flex-wrap: wrap; gap: 4px; }
  .fc-detail span { white-space: nowrap; }
  .fc-cat {
    font-size: 0.75rem;
    color: #6b7280;
    background: var(--line-light);
    padding: 2px 8px;
    border-radius: 10px;
    display: inline-block;
    margin-bottom: 4px;
  }

  .empty-state {
    padding: 18px;
    border: 1px dashed var(--line);
    border-radius: 10px;
    background: var(--bg-soft);
    color: var(--ink-secondary);
  }

  .empty-state p {
    margin: 0;
    line-height: 1.6;
  }
</style>

<script>
  let allFoods = [];
  const sourceNote = 'Dữ liệu tham khảo theo 100g phần ăn được. Thiếu dữ liệu sẽ hiện trung tính, không suy đoán.';

  fetch('/api-foods.json')
    .then(r => r.json())
    .then(d => {
      allFoods = Array.isArray(d) ? d : (d.foods || []);
      document.getElementById('results-section').style.display = 'block';
      // Initial show
      document.getElementById('filter-form')?.dispatchEvent(new Event('submit', { cancelable: true }));
    });

  document.getElementById('filter-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!allFoods.length) return;

    const keyword = normalizeText(document.getElementById('keyword').value);
    const category = document.getElementById('category').value;
    const state = document.getElementById('state').value;
    const kcalMin = maybeFloat('kcal-min');
    const kcalMax = maybeFloat('kcal-max');
    const proteinMin = maybeFloat('protein-min');
    const proteinMax = maybeFloat('protein-max');
    const fiberMin = maybeFloat('fiber-min');
    const fiberMax = maybeFloat('fiber-max');
    const sodiumMin = maybeFloat('sodium-min');
    const sodiumMax = maybeFloat('sodium-max');
    const ironMin = maybeFloat('iron-min');
    const ironMax = maybeFloat('iron-max');
    const calciumMin = maybeFloat('calcium-min');
    const calciumMax = maybeFloat('calcium-max');

    const selectedTags = [...document.querySelectorAll('.tag-cb:checked')].map(cb => cb.dataset.tag);

    const filtered = allFoods.filter(f => {
      const n = f.nutrients || {};
      const tags = f.tags || [];

      // Keyword
      const searchHaystack = [
        f.name,
        f.category,
        f.name_en,
        ...(f.aliases || []),
      ].filter(Boolean).map(normalizeText);
      if (keyword && !searchHaystack.some(text => text.includes(keyword))) {
        return false;
      }

      // Category
      if (category && f.category !== category) return false;

      // State
      if (state && f.state !== state) return false;

      // Numeric ranges
      if (!inRange(n.energyKcal, kcalMin, kcalMax)) return false;
      if (!inRange(n.proteinG, proteinMin, proteinMax)) return false;
      if (!inRange(n.fiberG, fiberMin, fiberMax)) return false;
      if (!inRange(n.sodiumMg, sodiumMin, sodiumMax)) return false;
      if (!inRange(n.ironMg, ironMin, ironMax)) return false;
      if (!inRange(n.calciumMg, calciumMin, calciumMax)) return false;

      // Tags filter (AND logic)
      if (selectedTags.length && !selectedTags.every(t => tags.includes(t))) return false;

      return true;
    });

    displayResults(filtered);
  });

  function maybeFloat(id) {
    const v = document.getElementById(id).value;
    return v === '' ? undefined : parseFloat(v);
  }

  function inRange(val, min, max) {
    if (val == null) return true;
    if (min !== undefined && val < min) return false;
    if (max !== undefined && val > max) return false;
    return true;
  }

  function displayResults(foods) {
    const list = document.getElementById('results-list');
    const count = document.getElementById('result-count');

    count.textContent = foods.length + ' thực phẩm';
    list.replaceChildren();

    if (!foods.length) {
      const empty = document.createElement('div');
      empty.className = 'empty-state';

      const message = document.createElement('p');
      message.textContent = 'Không tìm thấy thực phẩm nào. Hãy nới lỏng bộ lọc hoặc thử từ khóa khác.';

      const note = document.createElement('p');
      note.textContent = sourceNote;

      empty.appendChild(message);
      empty.appendChild(note);
      list.appendChild(empty);
      document.getElementById('results-section').style.display = 'block';
      return;
    }

    // Sort by name
    foods.sort((a, b) => a.name.localeCompare(b.name, 'vi'));

    const fragment = document.createDocumentFragment();

    foods.forEach(f => {
      const n = f.nutrients || {};
      const slug = f.slug || f.id;
      const card = document.createElement('a');
      card.className = 'food-card';
      card.href = `/thuc-pham/${slug}`;

      if (f.category) {
        const cat = document.createElement('div');
        cat.className = 'fc-cat';
        cat.textContent = f.category;
        card.appendChild(cat);
      }

      const name = document.createElement('div');
      name.className = 'fc-name';
      name.textContent = f.name;
      card.appendChild(name);

      const detail = document.createElement('div');
      detail.className = 'fc-detail';

      appendMetric(detail, n.energyKcal, '🔥', 'kcal');
      appendMetric(detail, n.proteinG, '🥩', 'g đạm');
      appendMetric(detail, n.fatG, '🫒', 'g béo');
      appendMetric(detail, n.carbG, '🍚', 'g glucid');
      appendMetric(detail, n.fiberG, '🌿', 'g xơ');
      appendMetric(detail, n.sodiumMg, '🧂', 'mg natri');

      card.appendChild(detail);
      fragment.appendChild(card);
    });

    list.appendChild(fragment);
  }

  function appendMetric(container, value, icon, unitLabel) {
    if (value == null) return;
    const chip = document.createElement('span');
    chip.textContent = `${icon} ${formatNumber(value)} ${unitLabel}`;
    container.appendChild(chip);
  }

  function formatNumber(value) {
    if (!Number.isFinite(value)) return '—';
    if (value >= 100) return value.toLocaleString('vi-VN', { maximumFractionDigits: 0 });
    if (value >= 10) return value.toLocaleString('vi-VN', { maximumFractionDigits: 1 });
    return value.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
  }

  function normalizeText(value) {
    return (value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .trim();
  }

  // Auto-filter on any change
  document.querySelectorAll('#filter-form input, #filter-form select').forEach(el => {
    el.addEventListener('change', () => {
      document.getElementById('filter-form')?.dispatchEvent(new Event('submit', { cancelable: true }));
    });
    if (el.tagName === 'INPUT' && el.type !== 'checkbox') {
      el.addEventListener('input', debounce(() => {
        document.getElementById('filter-form')?.dispatchEvent(new Event('submit', { cancelable: true }));
      }, 300));
    }
  });

  function debounce(fn, ms) {
    let timer;
    return function() {
      clearTimeout(timer);
      timer = setTimeout(fn, ms);
    };
  }
</script>
