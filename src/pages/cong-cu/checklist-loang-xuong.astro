---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng loãng xương";
const desc = "Bảng kiểm thói quen hỗ trợ xương và giảm nguy cơ té ngã ở người lớn tuổi.";
const items = [
  "Tôi có nguồn canxi từ thực phẩm phù hợp (sữa, cá nhỏ ăn cả xương, đậu phụ...)",
  "Tôi biết tình trạng vitamin D/xét nghiệm và chỉ dùng bổ sung theo hướng dẫn",
  "Mỗi ngày có đủ đạm và năng lượng, không ăn kiêng quá mức làm sụt cân",
  "Tôi vận động chịu lực và tập sức mạnh phù hợp khả năng, có hỏi bác sĩ khi đau",
  "Tôi rà soát thuốc có thể gây chóng mặt/buồn ngủ và kiểm tra thị lực, thăng bằng",
  "Nhà ở đủ sáng, lối đi gọn, có tay vịn và giày dép chống trượt",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-loang-xuong">
  <main class="bone-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm xương khớp</p>
      <h1>🦴 Checklist loãng xương</h1>
      <p>{desc} Đây là bảng nhắc việc; mật độ xương và thuốc điều trị cần được đánh giá chuyên môn.</p>
    </header>
    <form id="bone-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-bone /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Đau lưng/hông sau va chạm nhẹ, giảm chiều cao nhanh, gãy xương bất thường, té ngã lặp lại hoặc yếu cơ tăng dần.</p>
      <p class="warning">Không tự dùng liều cao canxi/vitamin D, thuốc xương hoặc ngừng thuốc đang kê.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("bone-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-bone]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục duy trì và mang danh sách thuốc, thực phẩm bổ sung khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hãy chọn một thay đổi nhỏ và trao đổi phần còn thiếu với bác sĩ hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .bone-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .bone-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
