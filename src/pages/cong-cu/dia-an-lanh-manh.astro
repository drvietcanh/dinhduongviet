---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Đĩa ăn lành mạnh | Dinh dưỡng Việt";
const desc = "Định hướng cách nhìn bữa ăn theo mô hình đĩa ăn, kèm các tình huống cần cá thể hóa với bác sĩ hoặc chuyên gia dinh dưỡng.";

const cautionGroups = [
  "Đái tháo đường, bệnh thận, lọc máu, suy tim, xơ gan hoặc bệnh gan tiến triển.",
  "Tăng huyết áp, gout, rối loạn mỡ máu, bệnh tim mạch hoặc đang dùng thuốc dài ngày.",
  "Thai kỳ, cho con bú, trẻ em, người cao tuổi yếu, sụt cân nhanh hoặc suy dinh dưỡng.",
  "Đang dùng insulin, thuốc hạ đường huyết, thuốc lợi tiểu, thuốc huyết áp hoặc thuốc chống đông.",
  "Muốn thay đổi khẩu phần để xử trí triệu chứng, xét nghiệm hoặc bệnh nền.",
];

const prepItems = [
  "Chẩn đoán, xét nghiệm gần đây và thuốc đang dùng.",
  "Ghi lại bữa ăn 2-3 ngày, kèm giờ ăn và triệu chứng nếu có.",
  "Mục đích khi hỏi tư vấn: duy trì ăn uống, kiểm soát triệu chứng, chuẩn bị bữa cho gia đình hoặc thay đổi thói quen.",
  "Các món thường ăn, món phải kiêng theo bác sĩ và khó khăn khi mua hoặc nấu ăn.",
];

const relatedTools = [
  {
    href: "/cong-cu/khau-phan-viet-clinical",
    title: "Đánh giá khẩu phần Việt",
    text: "Ước tính khẩu phần để giáo dục dinh dưỡng, có cờ cần cá thể hóa.",
    badge: "Đã kiểm v1",
  },
  {
    href: "/cong-cu/muc-tieu-dinh-duong",
    title: "Mục tiêu dinh dưỡng",
    text: "Định hướng mục tiêu dinh dưỡng tham khảo với cờ cần cá thể hóa.",
    badge: "Đã kiểm v1",
  },
  {
    href: "/cong-cu/nuoc-uong",
    title: "Nhu cầu nước mỗi ngày",
    text: "Ước tính nước cho người khỏe, có chặn nhóm cần cá thể hóa.",
    badge: "Đã kiểm v1",
  },
];
---

<BaseLayout title={title} description={desc}>
  <main class="plate-shell" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Định hướng an toàn v1</p>
      <h1 id="page-title">Đĩa ăn lành mạnh</h1>
      <p>
        Công cụ này chỉ giúp bạn nhìn bữa ăn theo hướng cân đối và chuẩn bị câu hỏi khi cần tư vấn cá thể.
        Nội dung không thay thế bác sĩ hoặc chuyên gia dinh dưỡng, và không dùng để tự đổi thuốc hay chế độ chăm sóc bệnh nền.
      </p>
    </section>

    <section class="notice-panel" aria-label="Phạm vi an toàn">
      <h2>Phạm vi ở v1</h2>
      <p>
        Trang không đưa tỷ lệ đĩa, khẩu phần, kcal, macro, nước, natri, kali hoặc phospho cá nhân cho từng bệnh nền.
        Nếu bạn có bệnh nền, thuốc đang dùng hoặc kết quả xét nghiệm cần theo dõi, hãy dùng thông tin ở đây như gợi ý chuẩn bị khi trao đổi với chuyên gia.
      </p>
    </section>

    <section class="grid-two" aria-label="Định hướng bữa ăn">
      <article class="info-card">
        <h2>Cách nhìn bữa ăn</h2>
        <p>
          Một bữa ăn thường nên có rau hoặc trái cây phù hợp, nguồn tinh bột, nguồn đạm và nước uống.
          Tỷ lệ cụ thể phụ thuộc sức khỏe, thuốc, tuổi, mức vận động và mục tiêu chăm sóc.
        </p>
      </article>

      <article class="info-card">
        <h2>Không phải đơn cá nhân</h2>
        <p>
          Trang không kết luận món nào phù hợp cho một bệnh cụ thể, không đưa thực đơn bắt buộc và không thay thế kế hoạch do bác sĩ hoặc chuyên gia dinh dưỡng lập.
        </p>
      </article>
    </section>

    <section class="check-panel" aria-label="Tình huống cần cá thể hóa">
      <h2>Khi nào cần hỏi chuyên gia?</h2>
      <ul>
        {cautionGroups.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="check-panel" aria-label="Thông tin nên chuẩn bị">
      <h2>Thông tin nên mang theo</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="related-panel" aria-label="Công cụ liên quan">
      <h2>Công cụ liên quan đã kiểm</h2>
      <div class="related-grid">
        {relatedTools.map((tool) => (
          <a class="related-card" href={tool.href}>
            <span>{tool.badge}</span>
            <strong>{tool.title}</strong>
            <p>{tool.text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .plate-shell {
      max-width: 880px;
      margin: 0 auto;
      padding: 24px 0 40px;
    }

    .hero-panel,
    .notice-panel,
    .info-card,
    .check-panel,
    .related-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .hero-panel {
      margin-bottom: 16px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    h1 {
      font-size: 1.65rem;
      margin-bottom: 10px;
    }

    h2 {
      font-size: 1.08rem;
      margin-bottom: 10px;
    }

    p,
    li {
      color: var(--ink-secondary);
      font-size: 0.94rem;
      line-height: 1.65;
    }

    .notice-panel {
      background: var(--brand-light);
      margin-bottom: 16px;
      border-color: var(--brand-light2);
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 16px;
    }

    .check-panel {
      margin-bottom: 16px;
    }

    .check-panel ul {
      margin: 0;
      padding-left: 1.2rem;
    }

    .check-panel li + li {
      margin-top: 8px;
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .related-card {
      display: block;
      min-height: 100%;
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      color: inherit;
      text-decoration: none;
      background: var(--bg);
      transition: all var(--transition);
    }

    .related-card:hover {
      border-color: var(--brand-light2);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .related-card span {
      display: inline-flex;
      margin-bottom: 10px;
      padding: 4px 8px;
      border-radius: 999px;
      color: var(--brand);
      background: var(--brand-light);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .related-card strong {
      display: block;
      margin-bottom: 6px;
      color: var(--ink);
    }

    .related-card p {
      margin-bottom: 0;
      font-size: 0.86rem;
    }

    @media (max-width: 720px) {
      .plate-shell {
        padding: 16px 0 28px;
      }

      .hero-panel,
      .notice-panel,
      .info-card,
      .check-panel,
      .related-panel {
        padding: 16px;
      }

      .grid-two,
      .related-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
