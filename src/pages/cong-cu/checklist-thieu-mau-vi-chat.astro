---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist thiếu máu và vi chất";
const desc = "Bảng kiểm dinh dưỡng, xét nghiệm và dùng sắt/B12/folate an toàn khi thiếu máu.";
const items = [
  "Tôi biết loại thiếu máu và nguyên nhân đang được đánh giá, không chỉ tự uống sắt",
  "Tôi dùng sắt, vitamin B12 hoặc folate đúng liều; báo táo bón, buồn nôn, phát ban hoặc tê bì",
  "Tôi tách sắt khỏi canxi, thuốc kháng acid và một số thuốc khác theo hướng dẫn dược sĩ",
  "Tôi ăn đa dạng thực phẩm giàu sắt, B12, folate và vitamin C phù hợp bệnh nền",
  "Tôi tái xét nghiệm công thức máu/ferritin/B12/folate đúng lịch và không tự dừng khi mới đỡ mệt",
  "Tôi biết dấu hiệu cần khám: khó thở khi nghỉ, đau ngực, ngất, đi ngoài phân đen hoặc yếu liệt mới",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-thieu-mau-vi-chat">
  <main class="anemia-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm huyết học</p>
      <h1>🩸 Checklist thiếu máu và vi chất</h1>
      <p>{desc} Cần tìm nguyên nhân mất máu/kém hấp thu/bệnh mạn trước khi chọn bổ sung.</p>
    </header>
    <form id="anemia-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-anemia /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Khó thở khi nghỉ, đau ngực, ngất, tim đập nhanh kéo dài, đi ngoài phân đen hoặc yếu liệt/tê bì mới xuất hiện.</p>
      <p class="warning">Không tự truyền sắt, dùng folate liều cao che lấp thiếu B12 hoặc tự bổ sung kéo dài không xét nghiệm.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("anemia-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-anemia]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang kết quả xét nghiệm, nhật ký ăn uống và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ nội khoa/huyết học hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .anemia-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .anemia-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
