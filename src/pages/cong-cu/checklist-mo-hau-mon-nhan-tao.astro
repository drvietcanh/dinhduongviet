---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi có hậu môn nhân tạo";
const desc = "Bảng kiểm ăn uống, lượng dịch và chăm sóc hậu môn nhân tạo.";
const items = [
  "Tôi ghi lượng và tính chất phân/dịch trong túi, cân nặng, lượng uống và nước tiểu",
  "Tôi uống dung dịch bù điện giải phù hợp khi output tăng, không chỉ uống nước lọc",
  "Tôi ăn chậm, thử từng món mới và nhai kỹ; biết thực phẩm có thể gây tắc hoặc nhiều hơi",
  "Tôi ăn đủ năng lượng–đạm và dùng thuốc/vi chất theo kế hoạch của đội phẫu thuật",
  "Tôi thay túi đúng kỹ thuật, giữ da quanh stoma sạch khô và theo dõi rò rỉ/kích ứng",
  "Tôi biết dấu hiệu nguy hiểm: không có output kèm đau quặn, nôn, bụng chướng, sốt hoặc mất nước",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-mo-hau-mon-nhan-tao">
  <main class="ostomy-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm hậu phẫu tiêu hóa</p>
      <h1>👜 Checklist hậu môn nhân tạo</h1>
      <p>{desc} Mục tiêu là duy trì dinh dưỡng, tránh mất nước và phát hiện sớm biến chứng.</p>
    </header>
    <form id="ostomy-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-ostomy /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ đội phẫu thuật khi</h2>
      <p>Không có output kèm đau quặn/nôn/chướng bụng, output rất nhiều, chóng mặt, tiểu ít, sốt hoặc stoma tím/đen.</p>
      <p class="warning">Không tự dùng thuốc cầm tiêu chảy, tự nhét vật vào stoma hoặc nhịn ăn kéo dài.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("ostomy-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-ostomy]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký output, dịch uống, cân nặng và vật tư khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với điều dưỡng stoma, bác sĩ phẫu thuật hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .ostomy-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .ostomy-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
