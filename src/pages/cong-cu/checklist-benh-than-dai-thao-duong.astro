---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist bệnh thận do đái tháo đường";
const desc = "Bảng kiểm phối hợp theo dõi đường huyết, thận và dinh dưỡng ở người đái tháo đường.";
const items = [
  "Tôi biết eGFR và albumin niệu gần nhất, cùng xu hướng theo thời gian",
  "Tôi theo dõi đường huyết/HbA1c và huyết áp theo kế hoạch",
  "Tôi giảm natri, đọc nhãn thực phẩm và không tự dùng muối thay thế",
  "Tôi biết mục tiêu đạm, kali, phốt pho và nước phải cá thể hóa",
  "Tôi rà soát thuốc bảo vệ thận, thuốc giảm đau, thảo dược và thực phẩm bổ sung",
  "Tôi theo dõi phù, cân nặng, lượng tiểu và dấu hiệu hạ đường huyết",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-benh-than-dai-thao-duong">
  <main class="dkd-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thận–nội tiết</p>
      <h1>🫘 Checklist bệnh thận do đái tháo đường</h1>
      <p>{desc} Chế độ ăn phụ thuộc eGFR, albumin niệu, xét nghiệm điện giải và thuốc.</p>
    </header>
    <form id="dkd-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-dkd /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ bác sĩ khi</h2>
      <p>Phù/khó thở tăng, tiểu ít, đường huyết hạ lặp lại, yếu cơ/hồi hộp, nôn nhiều hoặc lú lẫn.</p>
      <p class="warning">Không tự giảm đạm, kali, phốt pho, nước hoặc ngừng thuốc tiểu đường/bảo vệ thận.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("dkd-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-dkd]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi đường huyết, huyết áp, cân nặng và xét nghiệm khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ thận/nội tiết hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .dkd-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .dkd-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
