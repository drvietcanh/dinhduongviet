---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng gan nhiễm mỡ";
const desc = "Bảng kiểm thói quen hỗ trợ cải thiện gan nhiễm mỡ do chuyển hóa hoặc liên quan rượu bia.";
const items = [
  "Tôi biết nguyên nhân chính là chuyển hóa, rượu bia hay bệnh/thuốc khác theo bác sĩ",
  "Tôi giảm đồ uống có đường, bánh kẹo và khẩu phần dư năng lượng",
  "Nếu uống rượu bia, tôi đã trao đổi kế hoạch ngừng hoàn toàn với bác sĩ",
  "Tôi ưu tiên rau, đậu, ngũ cốc nguyên hạt, cá và chất béo không bão hòa",
  "Tôi giảm thịt chế biến, mỡ/da động vật và món chiên nhiều lần",
  "Tôi vận động phù hợp và theo dõi cân nặng, men gan, đường huyết, mỡ máu",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-gan-nhiem-mo">
  <main class="fatty-liver-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm gan chuyển hóa</p>
      <h1>🧡 Checklist gan nhiễm mỡ</h1>
      <p>{desc} Mục tiêu giảm cân và vận động cần điều chỉnh theo bệnh nền, không giảm cấp tốc.</p>
    </header>
    <form id="fatty-liver-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-fatty-liver /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Không dùng “detox gan”</h2>
      <p>Thảo dược, viên giải độc hoặc nhịn ăn có thể gây độc gan và tương tác thuốc. Vàng da, nước tiểu sẫm, đau bụng tăng, nôn hoặc lú lẫn cần khám sớm.</p>
      <p class="warning">Không tự ngừng thuốc đang kê và không tự kết luận mức độ xơ hóa chỉ từ men gan.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("fatty-liver-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-fatty-liver]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, vận động và xét nghiệm để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Chọn một thay đổi nhỏ và hỏi bác sĩ/dinh dưỡng viên về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .fatty-liver-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .fatty-liver-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
