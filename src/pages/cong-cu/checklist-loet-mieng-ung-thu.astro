---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist loét miệng khi điều trị ung thư";
const desc = "Bảng kiểm chăm sóc miệng và ăn uống khi loét miệng, khô miệng sau hóa trị hoặc xạ trị.";
const items = [
  "Tôi đã hỏi đội điều trị về dung dịch vệ sinh miệng và bàn chải phù hợp",
  "Tôi chọn thức ăn mềm, ẩm, nguội/vừa ấm và chia nhỏ bữa",
  "Tôi tránh cay, chua, quá mặn, rượu bia, thuốc lá và thức ăn cứng sắc",
  "Tôi uống từng ngụm nhỏ theo khả năng và theo giới hạn nước nếu có bệnh nền",
  "Tôi theo dõi đau, chảy máu, mảng trắng, sốt và khả năng nuốt",
  "Tôi đã hỏi về thuốc giảm đau, dinh dưỡng bổ sung hoặc hỗ trợ nuốt nếu cần",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-loet-mieng-ung-thu">
  <main class="mucositis-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung bướu</p>
      <h1>👄 Checklist loét miệng khi điều trị ung thư</h1>
      <p>{desc} Mục tiêu là giảm đau và duy trì uống/ăn an toàn, không cố chịu đựng.</p>
    </header>
    <form id="mucositis-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-mucositis /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần gọi đội điều trị</h2>
      <p>Không uống được, đau tăng nhanh, chảy máu, sốt, mảng trắng lan rộng, sặc khi nuốt hoặc tiểu ít.</p>
      <p class="warning">Không tự bôi thuốc tê, kháng sinh, corticoid hoặc dùng nước súc miệng có cồn khi chưa được hướng dẫn.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("mucositis-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-mucositis]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi mức đau, lượng uống và món dung nạp được để báo đội điều trị.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ ung bướu, điều dưỡng hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .mucositis-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .mucositis-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
