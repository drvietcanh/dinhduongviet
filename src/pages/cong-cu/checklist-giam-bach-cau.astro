---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist giảm bạch cầu và an toàn thực phẩm";
const desc = "Bảng kiểm vệ sinh thực phẩm cho người điều trị ung thư có nguy cơ giảm bạch cầu.";
const items = [
  "Tôi biết ngưỡng sốt và số điện thoại gọi đội điều trị",
  "Tôi rửa tay, dụng cụ và bề mặt; tách thực phẩm sống với chín",
  "Thịt, cá, trứng, hải sản được nấu chín kỹ; không dùng đồ sống/tái",
  "Tôi dùng sữa/nước ép pasteur hóa, nước sạch và thực phẩm còn hạn",
  "Thức ăn thừa được làm nguội/bảo quản đúng cách và hâm nóng kỹ",
  "Người chăm sóc biết không mang món tự làm không rõ bảo quản vào bệnh viện",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-giam-bach-cau">
  <main class="neutropenia-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung bướu</p>
      <h1>🧤 Checklist giảm bạch cầu</h1>
      <p>{desc} Ưu tiên vệ sinh và an toàn thực phẩm chuẩn; không cần kiêng cực đoan mọi rau quả nếu đội điều trị không yêu cầu.</p>
    </header>
    <form id="neutropenia-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-neutropenia /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Sốt khi giảm bạch cầu là cấp cứu</h2>
      <p>Sốt theo ngưỡng đội điều trị đã dặn, rét run, khó thở, lú lẫn, đau họng, tiêu chảy hoặc đau quanh catheter cần gọi ngay.</p>
      <p class="warning">Không tự dùng kháng sinh, thuốc hạ sốt hoặc chờ đến sáng hôm sau khi đã được dặn gọi khẩn.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("neutropenia-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-neutropenia]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi nhiệt độ, triệu chứng và lần ăn uống để báo đội điều trị.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi điều dưỡng/bác sĩ ung bướu về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .neutropenia-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .neutropenia-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
