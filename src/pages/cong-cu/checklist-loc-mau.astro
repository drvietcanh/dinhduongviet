---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi lọc máu";
const desc = "Bảng kiểm chuẩn bị ăn uống, thuốc và xét nghiệm cho người đang chạy thận nhân tạo hoặc lọc màng bụng.";
const items = [
  "Tôi biết cân nặng khô/mục tiêu và cách theo dõi tăng cân giữa các lần lọc",
  "Tôi có giới hạn nước và muối bằng văn bản từ trung tâm lọc máu",
  "Tôi biết kali/phốt pho gần nhất và mục tiêu được cá thể hóa theo xét nghiệm",
  "Mỗi ngày có đủ đạm/năng lượng theo hướng dẫn, không tự kiêng quá mức",
  "Tôi mang danh sách thuốc, chất gắn phosphate, vitamin và thực phẩm bổ sung khi tái khám",
  "Tôi biết dấu hiệu cần gọi trung tâm: khó thở, phù nhanh, yếu cơ, hồi hộp hoặc đau ngực",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-loc-mau">
  <main class="dialysis-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thận</p>
      <h1>🩺 Checklist dinh dưỡng khi lọc máu</h1>
      <p>{desc} Lịch lọc, lượng nước và điện giải phải theo trung tâm điều trị của bạn.</p>
    </header>
    <form id="dialysis-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-dialysis /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Không tự điều chỉnh</h2>
      <p>Không tự uống thêm nước, dùng muối thay thế, bỏ chất gắn phosphate hoặc đổi thuốc khi chưa hỏi trung tâm lọc máu.</p>
      <p class="warning">Khó thở, đau ngực, lơ mơ, yếu liệt, hồi hộp hoặc tăng cân/phù nhanh cần liên hệ y tế ngay.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("dialysis-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-dialysis]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi lượng uống, cân nặng và triệu chứng để trao đổi khi lọc.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi điều dưỡng, bác sĩ thận hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .dialysis-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .dialysis-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
