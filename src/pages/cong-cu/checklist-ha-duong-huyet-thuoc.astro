---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist hạ đường huyết do thuốc";
const desc = "Bảng kiểm phòng và xử trí hạ đường huyết liên quan insulin hoặc thuốc kích thích tiết insulin.";
const items = [
  "Tôi biết ngưỡng hạ đường huyết của mình và luôn có 15 g đường hấp thu nhanh bên người",
  "Tôi kiểm tra lại đường huyết sau 15 phút và lặp lại theo hướng dẫn nếu vẫn thấp",
  "Tôi ăn đủ bữa/phụ theo kế hoạch, không bỏ bữa sau khi dùng insulin hoặc sulfonylurea",
  "Tôi rà soát vận động, rượu bia, bệnh thận/gan và thuốc mới có thể làm tăng nguy cơ hạ đường huyết",
  "Người thân biết không cho ăn/uống khi tôi lơ mơ, biết dùng glucagon nếu đã được kê và gọi cấp cứu",
  "Tôi ghi lại thời điểm, mức đường huyết, thuốc và bữa ăn để bác sĩ điều chỉnh an toàn",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ha-duong-huyet-thuoc">
  <main class="hypo-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm đái tháo đường</p>
      <h1>🩸 Checklist hạ đường huyết do thuốc</h1>
      <p>{desc} Bảng kiểm hỗ trợ an toàn, không thay thế điều chỉnh thuốc của đội điều trị.</p>
    </header>
    <form id="hypo-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-hypo /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu khi</h2>
      <p>Co giật, bất tỉnh, không nuốt được, lú lẫn kéo dài hoặc đường huyết vẫn thấp sau xử trí lặp lại.</p>
      <p class="warning">Không tự giảm/ngừng insulin hoặc sulfonylurea; không cho người lơ mơ ăn/uống vì có thể sặc.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("hypo-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-hypo]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký hạ đường huyết, thuốc, bữa ăn và vận động khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ đái tháo đường hoặc dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .hypo-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .hypo-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
