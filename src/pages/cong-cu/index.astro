---
import BaseLayout from "../../layouts/BaseLayout.astro";
const siteTitle = "Công cụ dinh dưỡng | Dinh Dưỡng Việt";
const siteDesc = "Công cụ dinh dưỡng đơn giản cho người Việt: tính BMI, nước uống, đường, muối, đĩa ăn lành mạnh.";

const toolGroups = [
  {
    title: "Bắt đầu với dữ liệu thực phẩm",
    summary: "Dành cho nhu cầu tra nhanh calo, so sánh món và lên ý tưởng bữa ăn từ dữ liệu sẵn có.",
    items: [
      { icon: "🇻🇳", name: "Tra cứu thực phẩm Việt", href: "/cong-cu/tra-cuu-thuc-pham-viet", desc: "Tra cứu thành phần dinh dưỡng thực phẩm Việt ở mức tham khảo, kèm ghi chú về nguồn và giới hạn dữ liệu.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔎", name: "Lọc thực phẩm", href: "/cong-cu/loc-thuc-pham", desc: "Lọc thực phẩm theo nhóm và chỉ số dinh dưỡng để thu hẹp lựa chọn nhanh hơn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "⚖️", name: "So sánh dinh dưỡng", href: "/cong-cu/so-sanh", desc: "Hub chọn đúng công cụ để so sánh thực phẩm hoặc bữa ăn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "⚖️", name: "So sánh thực phẩm", href: "/cong-cu/so-sanh-thuc-pham", desc: "So sánh thành phần dinh dưỡng giữa các thực phẩm, không gắn nhãn tốt hay xấu.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍱", name: "So sánh bữa ăn", href: "/cong-cu/so-sanh-bua-an", desc: "So sánh dữ liệu dinh dưỡng giữa các bữa ăn để nhìn rõ khác biệt khẩu phần.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📦", name: "Thêm thực phẩm đóng gói", href: "/cong-cu/them-thuc-pham-dong-goi", desc: "Nhập dữ liệu từ nhãn thực phẩm để lưu và tra lại về sau.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Chỉ số cơ thể",
    summary: "Phù hợp khi cần nhìn nhanh cân nặng, vòng eo và các mốc theo dõi cơ bản của bản thân.",
    items: [
      { icon: "⚖️", name: "Tính BMI tham khảo", href: "/cong-cu/bmi", desc: "Tính BMI ở mức tham khảo và nhắc các giới hạn của chỉ số này, không thay thế đánh giá lâm sàng.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📏", name: "Tìm hiểu tỷ lệ mỡ cơ thể", href: "/cong-cu/ti-le-mo-co-the", desc: "Giải thích cách hiểu tỷ lệ mỡ cơ thể và giới hạn của các phương pháp ước tính, không phải máy tính cá nhân.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🎯", name: "Mục tiêu cân nặng", href: "/cong-cu/muc-tieu-can-nang", desc: "Định hướng mục tiêu cân nặng tham khảo với cờ cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📊", name: "Theo dõi sức khỏe", href: "/cong-cu/theo-doi-suc-khoe", desc: "Ghi nhật ký chỉ số sức khỏe và nhắc các tình huống cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🏆", name: "Bảng xếp hạng thực phẩm", href: "/cong-cu/bang-xep-hang", desc: "Sắp xếp dữ liệu dinh dưỡng thực phẩm ở mức tham khảo, không kết luận thực phẩm tốt hay xấu.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Năng lượng và khẩu phần",
    summary: "Dùng khi muốn ước tính nhu cầu năng lượng, đạm và lượng ăn phù hợp hơn với mục tiêu hằng ngày.",
    items: [
      { icon: "🔥", name: "Calo tiêu thụ khi tập", href: "/cong-cu/tinh-calo-tieu-thu", desc: "Ước tính năng lượng tiêu hao khi vận động ở mức tham khảo, không dùng để đặt mục tiêu giảm cân, ăn bù hoặc điều trị.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🥩", name: "Tính nhu cầu đạm", href: "/cong-cu/tinh-nhu-cau-dam", desc: "Ước tính lượng đạm theo cân nặng, bệnh lý và mục tiêu chính.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🎯", name: "Mục tiêu dinh dưỡng", href: "/cong-cu/muc-tieu-dinh-duong", desc: "Định hướng mục tiêu dinh dưỡng tham khảo với cờ cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🥣", name: "Khẩu phần đơn giản", href: "/cong-cu/khau-phan-don-gian", desc: "Tìm hiểu khẩu phần ở mức tham khảo, không dùng để kết luận bữa ăn đủ chất hay phù hợp cho bệnh.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔬", name: "Đánh giá khẩu phần Việt", href: "/cong-cu/khau-phan-viet-clinical", desc: "Ước tính khẩu phần Việt để giáo dục dinh dưỡng, có cờ cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔁", name: "Đổi đơn vị", href: "/cong-cu/doi-don-vi", desc: "Quy đổi đơn vị thực phẩm ở mức tham khảo, có ghi chú giới hạn khi quy đổi theo dụng cụ hoặc thể tích.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Carb, đường huyết, GI/GL",
    summary: "Hữu ích nhất cho người cần kiểm soát đường huyết, chọn tinh bột hợp lý và đọc bữa ăn có hệ thống hơn.",
    items: [
      { icon: "🌾", name: "Chỉ số GI thực phẩm Việt", href: "/cong-cu/chi-so-gi", desc: "Tìm hiểu ý nghĩa chỉ số GI ở mức tham khảo và các tình huống cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "⚖️", name: "Tính GL từ bữa ăn", href: "/cong-cu/tinh-gl-bua-an", desc: "Ghép nhiều thực phẩm để ước tính tải đường huyết của cả bữa ăn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔢", name: "Tính carb trong bữa ăn", href: "/cong-cu/tinh-carb", desc: "Ước tính lượng carb trong món và khẩu phần Việt.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧋", name: "Đường trong đồ uống", href: "/cong-cu/duong-do-uong", desc: "Tra cứu lượng đường tham khảo trong một số đồ uống, không dùng để kết luận đồ uống tốt hay xấu.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🩸", name: "Theo dõi đường huyết", href: "/cong-cu/theo-doi-duong-huyet", desc: "Ghi nhật ký đường huyết và nhắc các tình huống cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Muối, nước, bệnh mạn",
    summary: "Tập trung vào những chỉ số cần thận trọng hơn khi có bệnh nền, thai kỳ, trẻ em hoặc đang dùng thuốc.",
    items: [
      { icon: "💧", name: "Nhu cầu nước mỗi ngày", href: "/cong-cu/nuoc-uong", desc: "Ước tính nước cho người khỏe, có chặn nhóm cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧂", name: "Muối trong món ăn", href: "/cong-cu/nuoc-muoi-mon-an", desc: "Tra cứu muối ước tính trong món ăn và nhắc các tình huống cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🤰", name: "Dinh dưỡng thai kỳ", href: "/cong-cu/dinh-duong-thai-ky", desc: "Nhắc các tình huống cần cá thể hóa khi đánh giá dinh dưỡng trong thai kỳ.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "👶", name: "Nhu cầu dinh dưỡng trẻ em", href: "/cong-cu/nhu-cau-dinh-duong-tre-em", desc: "Nhắc các tình huống cần cá thể hóa khi đánh giá nhu cầu dinh dưỡng của trẻ.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "💊", name: "Tương tác thuốc - thực phẩm", href: "/cong-cu/tuong-tac-thuoc-thuc-pham", desc: "Xem nhanh các tình huống cần lưu ý khi dùng thuốc cùng bữa ăn hoặc thực phẩm cụ thể.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "💊", name: "Tương tác thuốc", href: "/cong-cu/tuong-tac-thuoc", desc: "Xem nhanh nguy cơ khi phối hợp nhiều thuốc hoặc dùng thuốc trên nền bệnh mạn.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Thực đơn, đi chợ, nhật ký",
    summary: "Phù hợp khi đã có mục tiêu tương đối rõ và muốn biến nó thành việc làm được mỗi ngày.",
    items: [
      { icon: "✅", name: "Checklist ăn uống hôm nay", href: "/cong-cu/checklist-an-uong", desc: "Checklist nhắc việc ăn uống ở mức tham khảo, không dùng để kết luận khẩu phần đạt hay chưa đạt.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍽️", name: "Đĩa ăn lành mạnh", href: "/cong-cu/dia-an-lanh-manh", desc: "Định hướng đĩa ăn chung và nhắc các tình huống cần cá thể hóa khi có bệnh nền.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📋", name: "Kế hoạch bữa ăn", href: "/cong-cu/ke-hoach-bua-an", desc: "Lập khung bữa ăn tham khảo và nhắc các trường hợp cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧪", name: "Đánh giá bữa ăn", href: "/cong-cu/danh-gia-bua-an", desc: "Hub chọn công cụ phù hợp để đánh giá bữa ăn: khẩu phần, carb, GL, đạm, nước và so sánh món.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🗓️", name: "Lập thực đơn tuần", href: "/cong-cu/lap-thuc-don-tuan", desc: "Gợi ý khung thực đơn tuần ở mức tham khảo và nhắc các trường hợp cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🛒", name: "Danh sách đi chợ", href: "/cong-cu/danh-sach-di-cho", desc: "Tạo danh sách đi chợ tham khảo để nhắc việc mua thực phẩm, không dùng để kết luận khẩu phần đủ chất hay phù hợp cho bệnh.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧮", name: "Nhật ký ăn uống", href: "/cong-cu/nhat-ky", desc: "Ghi lại bữa ăn và chỉ số ở mức theo dõi cá nhân, kèm nhắc khi cần hỏi bác sĩ hoặc chuyên gia.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍳", name: "Tìm món từ nguyên liệu", href: "/cong-cu/tim-mon-tu-nguyen-lieu", desc: "Gợi ý ý tưởng món ăn từ nguyên liệu bạn nhập ở mức tham khảo, không thay thế tư vấn chuyên môn.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Năng lượng nâng cao",
    summary: "Nhóm này hữu ích khi bạn đã quen công cụ cơ bản và cần ước tính sâu hơn về năng lượng hoặc macro.",
    items: [
      { icon: "🥗", name: "Tính macro tham khảo", href: "/cong-cu/tinh-macro", desc: "Quy đổi năng lượng mục tiêu thành gram carb, đạm và chất béo theo tỷ lệ tham khảo, không thay thế tư vấn cá thể hóa.", status: "Tham khảo v1", statusType: "stable" },
      { icon: "🔥", name: "Tính năng lượng tham khảo", href: "/cong-cu/tinh-nang-luong", desc: "Ước tính BMR/TDEE cho người trưởng thành ở mức tham khảo, có nhắc giới hạn khi có bệnh nền hoặc nhu cầu điều trị.", status: "Tham khảo v1", statusType: "stable" },
    ],
  },
];
const quickStarts = [
  {
    title: "Tôi muốn giảm cân an toàn",
    desc: "Bắt đầu từ mục tiêu cân nặng, năng lượng nền và một công cụ nhìn lại bữa ăn hằng ngày.",
    links: [
      { href: "/cong-cu/muc-tieu-can-nang", label: "Mục tiêu cân nặng" },
      { href: "/cong-cu/tinh-nang-luong", label: "Tính năng lượng" },
      { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn" },
    ],
  },
  {
    title: "Tôi cần kiểm soát đường huyết",
    desc: "Đi theo thứ tự carb, GL bữa ăn rồi mới theo dõi số đo để tránh đoán mò bằng cảm giác.",
    links: [
      { href: "/cong-cu/tinh-carb", label: "Tính carb" },
      { href: "/cong-cu/tinh-gl-bua-an", label: "Tính GL bữa ăn" },
      { href: "/cong-cu/theo-doi-duong-huyet", label: "Theo dõi đường huyết" },
    ],
  },
  {
    title: "Tôi muốn tra nhanh thực phẩm Việt",
    desc: "Phù hợp khi cần so sánh món, xem calo hoặc lên ý tưởng bữa ăn gia đình.",
    links: [
      { href: "/cong-cu/tra-cuu-thuc-pham-viet", label: "Tra cứu thực phẩm Việt" },
      { href: "/cong-cu/so-sanh-thuc-pham", label: "So sánh thực phẩm" },
      { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
    ],
  },
];
const totalTools = toolGroups.reduce((sum, group) => sum + group.items.length, 0);
const starterLinks = [
  { href: "/cong-cu/tra-cuu-thuc-pham-viet", label: "Tra cứu thực phẩm Việt" },
  { href: "/cong-cu/tinh-carb", label: "Tính carb" },
  { href: "/cong-cu/bmi", label: "BMI" },
  { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
];
---

<BaseLayout title={siteTitle} description={siteDesc} canonical="/cong-cu">
  <style is:global>
    .cctools { max-width: 980px; margin: 0 auto; padding: 24px 0; }
    .cctools h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .cctools .lead { color: var(--ink-secondary); font-size: 0.95rem; margin-bottom: 18px; }
    .cc-summary { color: var(--ink-secondary); font-size: 0.88rem; margin-bottom: 24px; }
    .cc-group { margin-top: 28px; }
    .cc-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .cc-group-head h2 { margin: 0; font-size: 1.15rem; }
    .cc-count { color: var(--ink-tertiary); font-size: 0.82rem; white-space: nowrap; }
    .cc-group-summary { margin: -2px 0 12px; color: var(--ink-secondary); font-size: 0.84rem; line-height: 1.55; max-width: 760px; }
    .cc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .cc-card {
      display: block;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: var(--radius-lg);
      padding: 20px;
      text-decoration: none;
      color: inherit;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 24px -6px rgba(0,0,0,0.05);
    }
    [data-theme="dark"] .cc-card {
      background: rgba(30, 41, 59, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .cc-card:hover {
      border-color: var(--brand-light2);
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 12px 32px -4px rgba(5, 150, 105, 0.15);
    }
    .cc-top { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
    .cc-icon { font-size: 1.35rem; line-height: 1; }
    .cc-card h3 { margin: 0; font-size: 1rem; font-weight: 700; flex: 1; }
    .cc-card h3 span { color: var(--brand); }
    .cc-card p { margin: 0; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.5; }
    .cc-status { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 9px; border-radius: 999px; background: var(--brand-light); color: var(--brand); font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .cc-status.is-stable { background: #e8f5ee; color: #217245; }
    .cc-note { margin-top: 24px; padding: 16px; background: var(--brand-light); border-radius: var(--radius-lg); font-size: 0.85rem; color: var(--ink-secondary); }
    .cc-note strong { color: var(--ink); }
    .cc-note-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .cc-note-links a { display: inline-flex; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--brand-light2); background: var(--card); color: var(--brand-dark); font-size: 0.8rem; font-weight: 600; text-decoration: none; }
    .cc-note-links a:hover { background: var(--brand-subtle); }
    .cc-quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 18px 0 28px; }
    .cc-quick-card { background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 16px; }
    .cc-quick-card h2 { margin: 0 0 6px; font-size: 0.98rem; }
    .cc-quick-card p { margin: 0 0 10px; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.55; }
    .cc-quick-links { display: flex; flex-wrap: wrap; gap: 8px; }
    .cc-quick-links a { text-decoration: none; font-size: 0.8rem; font-weight: 600; color: var(--brand); background: var(--card); border: 1px solid var(--card-border); border-radius: 999px; padding: 6px 10px; }
    .cc-quick-links a:hover { border-color: var(--brand-light2); background: var(--brand-light); }
    @media(max-width:700px) {
      .cc-grid { grid-template-columns: 1fr; }
      .cc-quick-grid { grid-template-columns: 1fr; }
      .cc-card { min-height: 44px; padding: 16px; }
      .cc-group-head { align-items: flex-start; flex-direction: column; gap: 2px; }
    }
    @media (max-width: 600px) {
      .cc-card h3 { font-size: 0.95rem; }
      .cc-card p { font-size: 0.82rem; }
    }
</style>

  <div class="cctools">
    <h1>🛠️ Công cụ</h1>
    <p class="lead">{siteDesc}</p>
    <p class="cc-summary">Hiện có {totalTools} công cụ, chia theo nhu cầu sử dụng. Kết quả chỉ dùng ở mức tham khảo và cần cá thể hóa khi có bệnh nền, thuốc đang dùng, thai kỳ hoặc mục tiêu điều trị.</p>

    <section aria-labelledby="quick-start-tools">
      <div class="cc-group-head" style="margin-bottom: 10px;">
        <h2 id="quick-start-tools">Bắt đầu nhanh</h2>
        <span class="cc-count">3 lộ trình gợi ý</span>
      </div>
      <div class="cc-quick-grid">
        {quickStarts.map((item) => (
          <div class="cc-quick-card">
            <h2>{item.title}</h2>
            <p>{item.desc}</p>
            <div class="cc-quick-links">
              {item.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {toolGroups.map(group => (
      <section class="cc-group" aria-labelledby={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>
        <div class="cc-group-head">
          <h2 id={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>{group.title}</h2>
          <span class="cc-count">{group.items.length} công cụ</span>
        </div>
        <p class="cc-group-summary">{group.summary}</p>
        <div class="cc-grid">
          {group.items.map(t => (
            <a href={t.href} class="cc-card">
              <div class="cc-top">
                <span class="cc-icon">{t.icon}</span>
                <h3>{t.name} <span>→</span></h3>
                {t.status && <span class:list={["cc-status", t.statusType === "stable" && "is-stable"]}>{t.status}</span>}
              </div>
              <p>{t.desc}</p>
            </a>
          ))}
        </div>
      </section>
      ))}

    <div class="cc-note">
      <strong>📌 Nếu đang mới bắt đầu:</strong> Hãy mở 1 công cụ tra cứu dữ liệu, 1 công cụ đọc bữa ăn, và 1 công cụ theo dõi cơ bản trước. Như vậy sẽ dễ áp dụng hơn là nhảy ngay vào các công cụ nâng cao.
      <div class="cc-note-links">
        {starterLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
  </div>
</BaseLayout>

