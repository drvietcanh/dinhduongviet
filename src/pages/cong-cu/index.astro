---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getToolMethodology } from "../../data/tool-methodology";
const siteTitle = "Công cụ dinh dưỡng | Dinh dưỡng Việt";
const siteDesc = "Công cụ dinh dưỡng gọn, dễ dùng cho người Việt: tra cứu thực phẩm, đọc bữa ăn và theo dõi các chỉ số cơ bản.";
function splitToolCopy(desc) {
  const parts = desc.split(". ");
  const actionText = (parts.shift() ?? desc).trim().replace(/[.!?]+$/, "");
  const useWhenText = parts.join(". ").trim().replace(/^Dùng khi:?\s*/i, "").replace(/[.!?]+$/, "");
  return {
    action: actionText ? `${actionText}.` : desc,
    useWhen: useWhenText || "cần áp dụng ngay vào bữa ăn hoặc chỉ số hằng ngày",
  };
}

function displayToolStatus(tool) {
  const methodology = getToolMethodology(tool.href);
  if (!methodology || !/v1/i.test(methodology.status)) return tool.status;
  if (methodology.formulas && methodology.formulas.length > 0) return "Đã kiểm công thức";
  return methodology.status.replace(/\s*v1\b/gi, "").replace(/\s{2,}/g, " ").trim();
}

const toolGroups = [
  {
    title: "Bắt đầu với dữ liệu thực phẩm",
    summary: "Dành cho tra nhanh calo, so sánh món và lên ý tưởng bữa ăn từ dữ liệu sẵn có.",
    items: [
      { icon: "🇻🇳", name: "Bảng TP thực phẩm Việt", href: "/cong-cu/tra-cuu-thuc-pham-viet", desc: "Tra thành phần dinh dưỡng thực phẩm Việt. Có nguồn dữ liệu và giới hạn dùng.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔎", name: "Lọc thực phẩm", href: "/cong-cu/loc-thuc-pham", desc: "Lọc thực phẩm theo nhóm và chỉ số dinh dưỡng. Dùng khi cần thu hẹp lựa chọn nhanh.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "⚖️", name: "So sánh thực phẩm", href: "/cong-cu/so-sanh-thuc-pham", desc: "So sánh thành phần dinh dưỡng giữa nhiều thực phẩm. Dùng khi cần chọn nhanh giữa các lựa chọn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍱", name: "So sánh bữa ăn", href: "/cong-cu/so-sanh-bua-an", desc: "So sánh dữ liệu dinh dưỡng giữa các bữa ăn. Dùng khi cần nhìn rõ khác biệt khẩu phần.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📦", name: "Thêm thực phẩm đóng gói", href: "/cong-cu/them-thuc-pham-dong-goi", desc: "Nhập dữ liệu từ nhãn sản phẩm và lưu trên thiết bị. Dùng khi món chưa có trong dữ liệu sẵn có.", status: "Bổ trợ", statusType: "support" },
    ],
  },
  {
    title: "Chỉ số cơ thể",
    summary: "Phù hợp khi cần nhìn nhanh cân nặng, vòng eo và các mốc theo dõi cơ bản.",
    items: [
      { icon: "⚖️", name: "Tính BMI tham khảo", href: "/cong-cu/bmi", desc: "Tính BMI ở mức tham khảo. Có nhắc giới hạn của chỉ số này.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🎯", name: "Mục tiêu cân nặng", href: "/cong-cu/muc-tieu-can-nang", desc: "Định hướng mục tiêu cân nặng tham khảo. Dùng khi cần một mốc bắt đầu rõ hơn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📊", name: "Theo dõi sức khỏe", href: "/cong-cu/theo-doi-suc-khoe", desc: "Ghi nhật ký chỉ số sức khỏe. Dùng khi cần theo dõi nhiều chỉ số cùng lúc.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Năng lượng và khẩu phần",
    summary: "Dùng khi muốn ước tính năng lượng, đạm và lượng ăn phù hợp hơn với mục tiêu hằng ngày.",
    items: [
      { icon: "🔥", name: "Calo tiêu thụ khi tập", href: "/cong-cu/tinh-calo-tieu-thu", desc: "Ước tính năng lượng tiêu hao khi vận động. Không dùng để đặt mục tiêu giảm cân hay ăn bù.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🥩", name: "Tính nhu cầu đạm", href: "/cong-cu/tinh-nhu-cau-dam", desc: "Ước tính lượng đạm theo cân nặng, bệnh lý và mục tiêu chính.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🎯", name: "Mục tiêu dinh dưỡng", href: "/cong-cu/muc-tieu-dinh-duong", desc: "Định hướng mục tiêu dinh dưỡng tham khảo. Dùng khi cần một mốc bắt đầu rõ hơn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔬", name: "Đánh giá khẩu phần Việt", href: "/cong-cu/khau-phan-viet-clinical", desc: "Ước tính khẩu phần Việt để giáo dục dinh dưỡng. Có cờ cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔁", name: "Đổi đơn vị", href: "/cong-cu/doi-don-vi", desc: "Quy đổi đơn vị thực phẩm ở mức tham khảo. Dùng khi cần đổi theo dụng cụ hoặc thể tích.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📐", name: "Tra cứu nhu cầu dinh dưỡng", href: "/cong-cu/tra-cuu-nhu-cau-dinh-duong", desc: "Tra năng lượng, đạm, béo, bột đường, vitamin và khoáng chất theo nhóm tuổi, giới, lao động và sinh lý.", status: "Có bảng RNI 2026", statusType: "stable" },
    ],
  },
  {
    title: "Carb, đường huyết, GI/GL",
    summary: "Hữu ích nhất khi cần kiểm soát đường huyết, chọn tinh bột hợp lý và đọc bữa ăn rõ hơn.",
    items: [
      { icon: "🌾", name: "Chỉ số GI thực phẩm Việt", href: "/cong-cu/chi-so-gi", desc: "Tra chỉ số GI của thực phẩm Việt. Dùng khi cần chọn tinh bột hợp lý hơn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "⚖️", name: "Tính GL từ bữa ăn", href: "/cong-cu/tinh-gl-bua-an", desc: "Ghép nhiều thực phẩm để ước tính tải đường huyết của cả bữa ăn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🔢", name: "Tính carb trong bữa ăn", href: "/cong-cu/tinh-carb", desc: "Ước tính lượng carb trong món và khẩu phần Việt.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧋", name: "Đường trong đồ uống", href: "/cong-cu/duong-do-uong", desc: "Tra lượng đường tham khảo trong một số đồ uống. Dùng khi cần đọc nhanh trước khi chọn.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
  {
    title: "Muối, nước, bệnh mạn",
    summary: "Tập trung vào những chỉ số cần thận trọng hơn khi có bệnh nền, thai kỳ hoặc trẻ em.",
    items: [
      { icon: "💧", name: "Nhu cầu nước mỗi ngày", href: "/cong-cu/nuoc-uong", desc: "Ước tính nước cho người khỏe. Có chặn nhóm cần cá thể hóa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧂", name: "Muối trong món ăn", href: "/cong-cu/nuoc-muoi-mon-an", desc: "Tra muối ước tính trong món ăn. Dùng khi cần đọc nhanh cho tăng huyết áp hoặc tim mạch.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🤰", name: "Dinh dưỡng thai kỳ", href: "/cong-cu/dinh-duong-thai-ky", desc: "Tính BMI trước thai kỳ, khoảng tăng cân, năng lượng theo tam cá nguyệt và mốc vi chất tham khảo.", status: "Có công thức tham khảo", statusType: "stable" },
      { icon: "👶", name: "Nhu cầu dinh dưỡng trẻ em", href: "/cong-cu/nhu-cau-dinh-duong-tre-em", desc: "Tra khoảng năng lượng theo tuổi, giới và mức vận động cho trẻ 2–18 tuổi; có cổng an toàn tăng trưởng.", status: "Có bảng kcal tham khảo", statusType: "stable" },
    ],
  },
  {
    title: "Thuốc, thực phẩm & bệnh mạn",
    summary: "Tra các cặp tương tác thường gặp để chuẩn bị câu hỏi cho bác sĩ hoặc dược sĩ; không phải máy kiểm tra đơn thuốc cá nhân.",
    items: [
      { icon: "💊", name: "Tương tác thuốc - thực phẩm", href: "/cong-cu/tuong-tac-thuoc-thuc-pham", desc: "Tra cứu có nguồn về warfarin, statin, thuốc tuyến giáp, kháng sinh, thuốc huyết áp, thuốc đái tháo đường và thực phẩm thường gặp.", status: "Có nguồn lâm sàng", statusType: "stable" },
    ],
  },
  {
    title: "Thực đơn, đi chợ, nhật ký",
    summary: "Phù hợp khi đã có mục tiêu tương đối rõ và muốn biến nó thành việc làm được mỗi ngày.",
    items: [
      { icon: "📓", name: "Nhật ký ăn uống", href: "/cong-cu/nhat-ky", desc: "Ghi thực phẩm và món ăn theo từng bữa, rồi xem tổng hợp ngày và tuần.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "✅", name: "Checklist ăn uống hôm nay", href: "/cong-cu/checklist-an-uong", desc: "Checklist nhắc việc ăn uống trong ngày. Không dùng để kết luận khẩu phần đã đủ hay chưa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍽️", name: "Đĩa ăn lành mạnh", href: "/cong-cu/dia-an-lanh-manh", desc: "Định hướng đĩa ăn chung. Dùng khi cần nhìn nhanh tỷ lệ nhóm thực phẩm.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "📋", name: "Kế hoạch bữa ăn", href: "/cong-cu/ke-hoach-bua-an", desc: "Lập khung bữa ăn tham khảo. Dùng khi cần bắt đầu từ một nhịp ăn rõ hơn.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🧪", name: "Đánh giá bữa ăn", href: "/cong-cu/danh-gia-bua-an", desc: "Chọn đúng công cụ để đọc bữa ăn: khẩu phần, carb, GL, đạm, nước hoặc so sánh món.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🗓️", name: "Lập thực đơn tuần", href: "/cong-cu/lap-thuc-don-tuan", desc: "Gợi ý khung thực đơn tuần tham khảo. Dùng khi cần nhìn cả tuần thay vì từng bữa.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🛒", name: "Danh sách đi chợ", href: "/cong-cu/danh-sach-di-cho", desc: "Tạo danh sách đi chợ tham khảo để nhắc việc mua thực phẩm.", status: "Đã kiểm v1", statusType: "stable" },
      { icon: "🍳", name: "Tìm món từ nguyên liệu", href: "/cong-cu/tim-mon-tu-nguyen-lieu", desc: "Gợi ý món ăn từ nguyên liệu bạn đang có. Dùng khi cần ý tưởng nấu nhanh.", status: "Đã kiểm v1", statusType: "stable" },
    ],
  },
];
const quickStarts = [
  {
    title: "Tôi muốn giảm cân an toàn",
    desc: "Bắt đầu từ mục tiêu cân nặng, khung bữa ăn và một công cụ nhìn lại bữa ăn hằng ngày.",
    links: [
      { href: "/cong-cu/muc-tieu-can-nang", label: "Mục tiêu cân nặng" },
      { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
      { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn" },
    ],
  },
  {
    title: "Tôi cần kiểm soát đường huyết",
    desc: "Đi theo thứ tự carb, GL bữa ăn rồi theo dõi sức khỏe nếu cần ghi nhiều chỉ số cùng lúc.",
    links: [
      { href: "/cong-cu/tinh-carb", label: "Tính carb" },
      { href: "/cong-cu/tinh-gl-bua-an", label: "Tính GL bữa ăn" },
      { href: "/cong-cu/theo-doi-suc-khoe", label: "Theo dõi sức khỏe" },
    ],
  },
  {
    title: "Tôi muốn tra nhanh thực phẩm Việt",
    desc: "Phù hợp khi cần so sánh món, xem calo hoặc lên ý tưởng bữa ăn gia đình.",
    links: [
      { href: "/cong-cu/tra-cuu-thuc-pham-viet", label: "Bảng TP thực phẩm Việt" },
      { href: "/cong-cu/so-sanh-thuc-pham", label: "So sánh thực phẩm" },
      { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
    ],
  },
];
const totalTools = toolGroups.reduce((sum, group) => sum + group.items.length, 0);
const starterLinks = [
  { href: "/cong-cu/tra-cuu-thuc-pham-viet", label: "Bảng TP thực phẩm Việt" },
  { href: "/cong-cu/tinh-carb", label: "Tính carb" },
  { href: "/cong-cu/bmi", label: "BMI" },
  { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
];
const holdBackTools = [
  { name: "So sánh dinh dưỡng", reason: "Chỉ là trang trung gian dẫn sang 2 công cụ so sánh cụ thể, nên làm dài thêm một bước bấm mà không tăng giá trị." },
  { name: "Bảng xếp hạng thực phẩm", reason: "Dễ tạo cảm giác chấm điểm thực phẩm theo kiểu tốt - xấu, trong khi dữ liệu dinh dưỡng cần đặt trong ngữ cảnh khẩu phần và bệnh cảnh." },
  { name: "Tỷ lệ mỡ cơ thể", reason: "Nghiêng về giải thích khái niệm hơn là hành động trực tiếp; nên để như bài kiến thức hoặc công cụ phụ thay vì lối vào chính." },
  { name: "Khẩu phần đơn giản", reason: "Vai trò đang chồng với đánh giá khẩu phần Việt và đĩa ăn lành mạnh, nên không cần nổi bật ngang hàng." },
  { name: "Tính macro tham khảo", reason: "Chỉ phù hợp khi người dùng đã có nền về năng lượng và mục tiêu rõ; không nên là tool lõi cho số đông." },
  { name: "Tính năng lượng tham khảo", reason: "Vẫn hữu ích, nhưng nên là công cụ lớp hai sau khi đã xác định mục tiêu cân nặng và bữa ăn cơ bản." },
  { name: "Tương tác thuốc", reason: "Khung nhắc việc chung không có danh sách thuốc và nguồn theo từng hoạt chất; giữ ở lớp phụ để tránh người dùng nhầm là máy kiểm tra đơn thuốc." },
];
---

<BaseLayout title={siteTitle} description={siteDesc} canonical="/cong-cu">
  <style is:global>
    .cctools { max-width: 980px; margin: 0 auto; padding: 24px 0; }
    .cctools h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .cctools .lead { color: var(--ink-secondary); font-size: 0.95rem; margin-bottom: 18px; }
    .cc-summary { color: var(--ink-secondary); font-size: 0.88rem; margin-bottom: 24px; }
    .cc-search-panel { margin: 0 0 26px; padding: 14px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--bg-soft); }
    .cc-search-label { display: block; margin-bottom: 7px; color: var(--ink); font-size: 0.82rem; font-weight: 800; }
    .cc-search-row { display: flex; align-items: center; gap: 8px; }
    .cc-search-row input { flex: 1 1 auto; min-width: 0; min-height: 44px; padding: 9px 12px; border: 1px solid var(--card-border); border-radius: 12px; background: var(--card); color: var(--ink); font: inherit; }
    .cc-search-row input:focus { outline: 0; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5,150,105,.12); }
    .cc-search-clear { min-height: 36px; padding: 5px 10px; border: 1px solid var(--card-border); border-radius: 999px; background: var(--card); color: var(--ink-secondary); cursor: pointer; font: inherit; font-size: .76rem; font-weight: 750; }
    .cc-search-clear:hover { border-color: var(--brand-light2); color: var(--brand-dark); }
    .cc-search-summary { margin: 7px 0 0; color: var(--ink-tertiary); font-size: .76rem; }
    .cc-group { margin-top: 28px; }
    .cc-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .cc-group-head h2 { margin: 0; font-size: 1.15rem; }
    .cc-count { color: var(--ink-tertiary); font-size: 0.82rem; white-space: nowrap; }
    .cc-group-summary { margin: -2px 0 12px; color: var(--ink-secondary); font-size: 0.84rem; line-height: 1.5; max-width: 760px; }
    .cc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .cc-card {
      display: block;
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: var(--radius-lg);
      padding: 20px;
      text-decoration: none;
      color: inherit;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 24px -6px rgba(0,0,0,0.05);
      min-height: 100%;
    }
    [data-theme="dark"] .cc-card {
      background: rgba(30, 41, 59, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .cc-card:hover {
      border-color: var(--brand-light2);
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 12px 32px -4px rgba(5, 150, 105, 0.15);
    }
    .cc-top { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
    .cc-icon { font-size: 1.35rem; line-height: 1; }
    .cc-card h3 { margin: 0; font-size: 1rem; font-weight: 700; flex: 1; }
    .cc-card h3 span { color: var(--brand); }
    .cc-card p { margin: 0; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.5; }
    .cc-card p strong { color: var(--ink); font-size: 0.86rem; }
    .cc-usewhen {
      margin-top: 7px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .cc-card-cta {
      display: flex;
      justify-content: flex-end;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px dashed var(--line);
      color: var(--brand-dark);
      font-size: 0.8rem;
      font-weight: 700;
    }
    .cc-status { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 9px; border-radius: 999px; background: var(--brand-light); color: var(--brand); font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .cc-status.is-stable { background: #e8f5ee; color: #217245; }
    .cc-note { margin-top: 24px; padding: 16px; background: var(--brand-light); border-radius: var(--radius-lg); font-size: 0.85rem; color: var(--ink-secondary); }
    .cc-note strong { color: var(--ink); }
    .cc-note-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .cc-note-links a { display: inline-flex; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--brand-light2); background: var(--card); color: var(--brand-dark); font-size: 0.8rem; font-weight: 600; text-decoration: none; }
    .cc-note-links a:hover { background: var(--brand-subtle); }
    .cc-holdback-list { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 12px; }
    .cc-holdback-card { border: 1px dashed var(--card-border); border-radius: 16px; background: var(--bg-soft); padding: 16px; }
    .cc-holdback-card h3 { margin: 0 0 6px; font-size: 0.95rem; }
    .cc-holdback-card p { margin: 0; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.55; }
    .cc-quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 18px 0 28px; }
    .cc-quick-card { background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 16px; }
    .cc-quick-card h2 { margin: 0 0 6px; font-size: 0.98rem; }
    .cc-quick-card p { margin: 0 0 10px; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.55; }
    .cc-quick-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
    .cc-quick-links a { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; text-decoration: none; font-size: 0.8rem; font-weight: 600; color: var(--brand); background: var(--card); border: 1px solid var(--card-border); border-radius: 999px; padding: 6px 10px; text-align: center; }
    .cc-quick-links a:hover { border-color: var(--brand-light2); background: var(--brand-light); }
    @media(max-width:700px) {
      .cc-grid { grid-template-columns: 1fr; }
      .cc-quick-grid { grid-template-columns: 1fr; }
      .cc-holdback-list { grid-template-columns: 1fr; }
      .cc-card { min-height: 44px; padding: 16px; }
      .cc-group-head { align-items: flex-start; flex-direction: column; gap: 2px; }
      .cc-quick-links { grid-template-columns: 1fr; }
      .cc-search-row { align-items: stretch; flex-direction: column; }
      .cc-search-clear { width: 100%; }
    }
    @media (max-width: 600px) {
      .cc-card h3 { font-size: 0.95rem; }
      .cc-card p { font-size: 0.82rem; }
    }
</style>

  <div class="cctools">
    <h1>🛠️ Công cụ</h1>
    <p class="lead">{siteDesc}</p>
    <p class="cc-summary">Hiện có {totalTools} công cụ được ưu tiên hiển thị trên trang chính. Kết quả chỉ dùng ở mức tham khảo và cần cá thể hóa khi có bệnh nền, thuốc đang dùng, thai kỳ hoặc mục tiêu điều trị.</p>

    <div class="cc-search-panel" role="search" aria-label="Tìm công cụ dinh dưỡng">
      <label class="cc-search-label" for="tool-library-search">Tìm nhanh trong {totalTools} công cụ</label>
      <div class="cc-search-row">
        <input id="tool-library-search" type="search" placeholder="Ví dụ: carb, huyết áp, thai kỳ, đi chợ…" autocomplete="off" aria-describedby="tool-search-summary" />
        <button id="tool-search-clear" class="cc-search-clear" type="button" hidden>Xóa tìm kiếm</button>
      </div>
      <p id="tool-search-summary" class="cc-search-summary" role="status" aria-live="polite">Đang hiển thị toàn bộ công cụ theo nhóm nhu cầu.</p>
    </div>

    <section aria-labelledby="quick-start-tools">
      <div class="cc-group-head" style="margin-bottom: 10px;">
        <h2 id="quick-start-tools">Bắt đầu nhanh</h2>
        <span class="cc-count">3 lộ trình gợi ý</span>
      </div>
      <div class="cc-quick-grid">
        {quickStarts.map((item) => (
          <div class="cc-quick-card">
            <h2>{item.title}</h2>
            <p>{item.desc}</p>
            <div class="cc-quick-links">
              {item.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {toolGroups.map(group => (
      <section class="cc-group" data-tool-group aria-labelledby={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>
        <div class="cc-group-head">
          <h2 id={`group-${group.title.replace(/\s+/g, "-").toLowerCase()}`}>{group.title}</h2>
          <span class="cc-count">{group.items.length} công cụ</span>
        </div>
        <p class="cc-group-summary">{group.summary}</p>
        <div class="cc-grid">
          {group.items.map(t => (
            <a href={t.href} class="cc-card" data-tool-card data-tool-search={`${group.title} ${t.name} ${t.desc} ${t.status ?? ""} ${t.href}`}>
              <div class="cc-top">
                <span class="cc-icon">{t.icon}</span>
                <h3>{t.name}</h3>
                {t.status && <span class:list={["cc-status", t.statusType === "stable" && "is-stable"]}>{displayToolStatus(t)}</span>}
              </div>
              <p><strong>{splitToolCopy(t.desc).action}</strong></p>
              <p class="cc-usewhen">Dùng khi: {splitToolCopy(t.desc).useWhen}</p>
              <div class="cc-card-cta">Mở công cụ</div>
            </a>
          ))}
        </div>
      </section>
      ))}

    <div class="cc-note">
      <strong>📌 Nếu đang mới bắt đầu:</strong> Hãy mở 1 công cụ tra cứu dữ liệu, 1 công cụ đọc bữa ăn, và 1 công cụ theo dõi cơ bản trước. Như vậy sẽ dễ áp dụng hơn là nhảy ngay vào các công cụ nâng cao.
      <div class="cc-note-links">
        {starterLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>

    <section class="cc-group" aria-labelledby="hold-back-tools">
      <div class="cc-group-head">
        <h2 id="hold-back-tools">Công cụ không nên đặt nổi bật lúc này</h2>
        <span class="cc-count">{holdBackTools.length} mục nên để sau</span>
      </div>
      <p class="cc-group-summary">Những mục dưới đây không nhất thiết phải xóa vĩnh viễn, nhưng không nên là công cụ lõi trên bề mặt chính cho người dùng phổ thông ở thời điểm hiện tại.</p>
      <div class="cc-holdback-list">
        {holdBackTools.map((item) => (
          <article class="cc-holdback-card">
            <h3>{item.name}</h3>
            <p>{item.reason}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    var input = document.getElementById('tool-library-search');
    var clear = document.getElementById('tool-search-clear');
    var summary = document.getElementById('tool-search-summary');
    var groups = Array.from(document.querySelectorAll('[data-tool-group]'));
    if (!input || !groups.length) return;
    var params = new URLSearchParams(window.location.search);
    var initialQuery = params.get('q') || '';
    var allCards = Array.from(document.querySelectorAll('[data-tool-card]'));
    if (initialQuery) input.value = initialQuery;

    function normalize(value) {
      return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'd').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function applyToolSearch() {
      var query = normalize(input.value);
      var visible = 0;
      groups.forEach(function(group) {
        var groupVisible = 0;
        group.querySelectorAll('[data-tool-card]').forEach(function(card) {
          var matches = !query || normalize(card.getAttribute('data-tool-search')).indexOf(query) !== -1;
          card.hidden = !matches;
          if (matches) groupVisible += 1;
        });
        group.hidden = Boolean(query && groupVisible === 0);
        visible += groupVisible;
      });
      if (clear) clear.hidden = !query;
      if (summary) summary.textContent = query
        ? ('Tìm thấy ' + visible.toLocaleString('vi-VN') + ' / ' + allCards.length.toLocaleString('vi-VN') + ' công cụ phù hợp.')
        : 'Đang hiển thị toàn bộ công cụ theo nhóm nhu cầu.';
    }

    function syncUrl() {
      var next = new URLSearchParams(window.location.search);
      var value = input.value.trim();
      if (value) next.set('q', value); else next.delete('q');
      var nextUrl = window.location.pathname + (next.toString() ? '?' + next.toString() : '') + window.location.hash;
      window.history.replaceState({}, '', nextUrl);
    }

    input.addEventListener('input', function() { applyToolSearch(); syncUrl(); });
    clear && clear.addEventListener('click', function() { input.value = ''; input.focus(); applyToolSearch(); syncUrl(); });
    applyToolSearch();
  })();
</script>

