---
import BaseLayout from "../../layouts/BaseLayout.astro";
const siteTitle = "Công cụ dinh dưỡng | Dinh Dưỡng Việt";
const siteDesc = "Công cụ dinh dưỡng đơn giản cho người Việt: tính BMI, nước uống, đường, muối, đĩa ăn lành mạnh.";

const featured = [
  { icon: "🔥", name: "Calo tiêu thụ khi tập", href: "/cong-cu/tinh-calo-tieu-thu", desc: "Tính calo đốt cháy khi đi bộ, chạy, bơi, xe đạp, tập gym. 26 môn tập, kèm calo tương đương thực phẩm." },
  { icon: "📏", name: "Tỷ lệ mỡ cơ thể & WHR", href: "/cong-cu/ti-le-mo-co-the", desc: "Ước tính % mỡ cơ thể (US Navy), chỉ số eo/mông (WHR), BMI. Có mức độ mỡ nội tạng." },
  { icon: "🥩", name: "Tính nhu cầu đạm", href: "/cong-cu/tinh-nhu-cau-dam", desc: "Lượng đạm theo cân nặng & bệnh lý: suy thận, gout, tăng cơ, giảm cân, ăn chay. 13 nhóm đối tượng." },
  { icon: "💊", name: "Tương tác thuốc – thực phẩm", href: "/cong-cu/tuong-tac-thuoc-thuc-pham", desc: "Tra thực phẩm cần tránh khi dùng 15 loại thuốc thường gặp: metformin, warfarin, statin, lợi tiểu..." },
  { icon: "🩸", name: "Theo dõi đường huyết", href: "/cong-cu/theo-doi-duong-huyet", desc: "Ghi nhật ký đường huyết đói/sau ăn, xem biểu đồ 7 ngày, đánh giá kiểm soát tiểu đường." },
  { icon: "🍽️", name: "Đĩa ăn lành mạnh", href: "/cong-cu/dia-an-lanh-manh", desc: "Chia đĩa theo bệnh: 1/2 rau, 1/4 tinh bột, 1/4 đạm. Có chọn bệnh để tuỳ chỉnh." },
  { icon: "👶", name: "Nhu cầu dinh dưỡng trẻ em", href: "/cong-cu/nhu-cau-dinh-duong-tre-em", desc: "Tính nhu cầu năng lượng, đạm, canxi, sắt, kẽm cho trẻ 0–14 tuổi. Kèm hướng dẫn ăn dặm." },
  { icon: "🤰", name: "Dinh dưỡng thai kỳ", href: "/cong-cu/dinh-duong-thai-ky", desc: "Nhu cầu calo, sắt, canxi, DHA, folate cho mẹ bầu. Tuỳ chỉnh theo tam cá nguyệt, BMI trước mang thai." },
  { icon: "🌾", name: "Chỉ số GI thực phẩm Việt", href: "/cong-cu/chi-so-gi", desc: "Tra GI của cơm, bún, phở, bánh mì, trái cây Việt. Phân loại thấp/vừa/cao, kèm gợi ý thay thế." },
  { icon: "⚖️", name: "Tính GL từ bữa ăn (mới)", href: "/cong-cu/tinh-gl-bua-an", desc: "Ghép nhiều thực phẩm tính tổng GL bữa ăn. Biết ngay bữa này có an toàn cho đường huyết." },
  { icon: "🔢", name: "Tính carb trong bữa ăn", href: "/cong-cu/tinh-carb", desc: "Tính nhanh lượng carb thực tế trong cơm, bún, phở, trái cây. Hữu ích cho người tiểu đường type 1 & 2." },
  { icon: "⚖️", name: "Tính BMI & Vòng eo", href: "/cong-cu/bmi", desc: "BMI ngưỡng châu Á. Kết hợp vòng eo & WHR phát hiện béo bụng, mỡ nội tạng." },
  { icon: "💧", name: "Nhu cầu nước mỗi ngày", href: "/cong-cu/nuoc-uong", desc: "Tính nước theo cân nặng, vận động, thời tiết. Cảnh báo mất nước khi nóng." },
  { icon: "🧋", name: "Đường trong đồ uống", href: "/cong-cu/duong-do-uong", desc: "1 ly trà sữa, nước ngọt, cà phê sữa, nước tăng lực — bao nhiêu đường? Khuyến nghị WHO." },
  { icon: "🧂", name: "Muối trong món ăn", href: "/cong-cu/nuoc-muoi-mon-an", desc: "Tra nhanh lượng muối ẩn trong phở, bún, bánh mì, nước chấm. Biết kiêng sớm." },
  { icon: "✅", name: "Checklist ăn uống hôm nay", href: "/cong-cu/checklist-an-uong", desc: "7 câu hỏi nhanh: rau, đạm, nước, đường, muối — bạn đã đủ chưa?" },
  { icon: "🧮", name: "Nhật ký ăn uống", href: "/cong-cu/nhat-ky", desc: "Ghi chép & phân tích dinh dưỡng bữa ăn hàng ngày, so sánh với mục tiêu." },
  { icon: "📋", name: "Kế hoạch bữa ăn", href: "/cong-cu/ke-hoach-bua-an", desc: "Cá nhân hóa thực đơn theo bệnh lý: tiểu đường, thận, gout, tăng huyết áp." },
  { icon: "🎯", name: "Mục tiêu cân nặng", href: "/cong-cu/muc-tieu-can-nang", desc: "Tính BMR, TDEE, lộ trình giảm/tăng cân 1-6 tháng. Cơ bản cho mọi kế hoạch." },
  { icon: "📊", name: "Theo dõi sức khỏe", href: "/cong-cu/theo-doi-suc-khoe", desc: "Tổng hợp huyết áp, đường huyết, mỡ máu, cân nặng. Cảnh báo nguy cơ." },
  { icon: "🔬", name: "Khẩu phần Clinical", href: "/cong-cu/khau-phan-viet-clinical", desc: "Bảng điểm toàn diện bữa ăn: 18 chỉ số dinh dưỡng đối chiếu khuyến nghị." },
];
---

<BaseLayout title={siteTitle} description={siteDesc}>
  <style is:global>
    .cctools { max-width: 800px; margin: 0 auto; padding: 24px 0; }
    .cctools h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .cctools .lead { color: var(--ink-secondary); font-size: 0.95rem; margin-bottom: 28px; }
    .cc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .cc-card { display: block; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; text-decoration: none; color: inherit; transition: all 0.2s; }
    .cc-card:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.06); }
    .cc-icon { font-size: 2rem; margin-bottom: 8px; }
    .cc-card h3 { margin: 0 0 4px; font-size: 1rem; font-weight: 700; }
    .cc-card h3 span { color: var(--brand); }
    .cc-card p { margin: 0; font-size: 0.82rem; color: var(--ink-secondary); line-height: 1.5; }
    .cc-note { margin-top: 24px; padding: 14px 16px; background: var(--brand-dim); border-radius: 10px; font-size: 0.85rem; color: var(--ink-secondary); }
    .cc-note strong { color: var(--ink); }
    @media(max-width:600px) { .cc-grid { grid-template-columns: 1fr; } }
    @media (max-width: 600px) {
    .tool-grid { grid-template-columns: 1fr; gap: 10px; }
    .tool-card { padding: 14px; }
    .tool-card h3 { font-size: 0.9rem; }
    .tool-card p { font-size: 0.82rem; }
    .section-label { font-size: 1.1rem; }
  }
</style>

  <div class="cctools">
    <h1>🛠️ Công cụ</h1>
    <p class="lead">{siteDesc}</p>

    <div class="cc-grid">
      {featured.map(t => (
        <a href={t.href} class="cc-card">
          <div class="cc-icon">{t.icon}</div>
          <h3>{t.name} <span>→</span></h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>

    <div class="cc-note">
      <strong>📌 Còn nhiều công cụ hơn?</strong> Ngoài 15 cái trên, web còn có tra thực phẩm, món ăn, lập thực đơn tuần, danh sách đi chợ, so sánh món ăn… Xem thêm ở thanh menu bên trên. Tất cả đều miễn phí, không cần đăng ký.
    </div>
  </div>
</BaseLayout>

