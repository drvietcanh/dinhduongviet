---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Tương tác thuốc - thực phẩm | Dinh dưỡng Việt";
const description =
  "Nhắc các tình huống cần hỏi bác sĩ hoặc dược sĩ khi dùng thuốc cùng thực phẩm.";

const riskGroups = [
  "Đang dùng thuốc theo toa hoặc thuốc dùng dài ngày cho bệnh mạn tính",
  "Dùng nhiều thuốc cùng lúc, gồm cả thực phẩm bổ sung",
  "Thuốc chống đông, thuốc đái tháo đường, thuốc huyết áp, thuốc lợi tiểu",
  "Bệnh thận, bệnh gan, bệnh tim mạch hoặc bệnh ung thư",
  "Đang mang thai, cho con bú, trẻ em hoặc người cao tuổi yếu",
  "Có triệu chứng bất thường sau khi dùng thuốc",
];

const prepItems = [
  "Tên thuốc, hàm lượng, số lần dùng trong ngày",
  "Thực phẩm bổ sung, thảo dược, vitamin hoặc khoáng chất đang dùng",
  "Thói quen ăn uống đặc biệt, rượu bia, nước ép, cà phê hoặc sữa nếu có",
  "Bệnh nền, thai kỳ/cho con bú, dị ứng thuốc và triệu chứng mới xuất hiện",
];

const interactionCards = [
  {
    id: "warfarin-vitamin-k",
    index: "01",
    title: "Warfarin (Sintrom) × rau giàu vitamin K",
    medicines: "Warfarin/acenocoumarol",
    foods: "Rau muống, rau ngót, cải xanh, bông cải và các rau lá xanh",
    action: "Không tự kiêng hoàn toàn. Cố gắng giữ lượng rau xanh tương đối ổn định giữa các ngày và báo nơi theo dõi chống đông nếu thay đổi nhiều; INR cần được kiểm tra theo lịch.",
    caution: "Không tự tăng/giảm liều chỉ vì một bữa ăn.",
  },
  {
    id: "statin-grapefruit",
    index: "02",
    title: "Một số statin × bưởi chùm (grapefruit)",
    medicines: "Đặc biệt simvastatin; atorvastatin cũng cần xem lượng dùng",
    foods: "Bưởi chùm/grapefruit và nước ép grapefruit",
    action: "Kiểm tra đúng tên statin và tờ hướng dẫn. Không suy ra rằng mọi loại statin đều phải tránh; rosuvastatin có hướng dẫn khác.",
    caution: "Bưởi Việt Nam không mặc nhiên đồng nhất với grapefruit; nếu không chắc loại quả, hỏi dược sĩ.",
  },
  {
    id: "levothyroxine-minerals",
    index: "03",
    title: "Levothyroxine × canxi, sắt, cà phê và đậu nành",
    medicines: "Levothyroxine (thuốc tuyến giáp)",
    foods: "Viên canxi/sắt, multivitamin, thuốc kháng acid; cà phê, đậu nành hoặc chất xơ cao",
    action: "Uống theo đúng hướng dẫn, thường là lúc đói. Canxi và sắt thường cần cách ít nhất 4 giờ; kiểm tra lại với nhãn thuốc và dược sĩ vì chế phẩm có thể khác nhau.",
    caution: "Không tự đổi giờ uống hoặc nghiền thuốc trộn vào sữa/công thức đậu nành.",
  },
  {
    id: "ciprofloxacin-minerals",
    index: "04",
    title: "Ciprofloxacin × sữa, canxi và khoáng chất",
    medicines: "Ciprofloxacin",
    foods: "Sữa/sữa chua dùng riêng, nước tăng cường canxi; viên sắt, kẽm, magiê hoặc nhôm",
    action: "Không uống ciprofloxacin cùng một ly sữa hoặc đồ uống bổ sung canxi. Khoảng cách với khoáng chất phụ thuộc nhãn chế phẩm; dược sĩ cần xác nhận lịch dùng cụ thể.",
    caution: "Không tự áp dụng một khoảng cách cho mọi kháng sinh hoặc mọi dạng thuốc.",
  },
  {
    id: "acei-potassium",
    index: "05",
    title: "ACEi/ARB/spironolactone × kali bổ sung",
    medicines: "Một số thuốc ức chế men chuyển, chẹn thụ thể angiotensin hoặc spironolactone",
    foods: "Muối thay thế chứa kali, viên kali và sản phẩm bổ sung điện giải",
    action: "Không tự dùng muối kali hay viên kali, nhất là khi có bệnh thận. Việc ăn chuối/cà chua không nên bị cấm máy móc; cần dựa vào xét nghiệm và toa thuốc.",
    caution: "Hỏi bác sĩ về kali máu, eGFR và mọi sản phẩm có chữ potassium/kali trên nhãn.",
  },
  {
    id: "diabetes-alcohol",
    index: "06",
    title: "Insulin/thuốc hạ đường huyết × rượu bia hoặc bỏ bữa",
    medicines: "Insulin và một số thuốc hạ đường huyết",
    foods: "Rượu bia, đặc biệt khi uống lúc đói hoặc bỏ bữa",
    action: "Rượu có thể làm đường huyết hạ hoặc tăng tùy tình huống. Không uống lúc đói; trao đổi kế hoạch an toàn với người đang theo dõi, nhất là khi dùng insulin.",
    caution: "Run, vã mồ hôi, lú lẫn hoặc ngất cần được xử trí y tế khẩn cấp.",
  },
  {
    id: "tacrolimus-grapefruit",
    index: "07",
    title: "Tacrolimus/cyclosporine × grapefruit",
    medicines: "Tacrolimus, cyclosporine và một số thuốc ghép tạng",
    foods: "Bưởi chùm/grapefruit và nước ép grapefruit",
    action: "Tránh grapefruit nếu đội ghép tạng đã dặn như vậy và uống thuốc theo cùng một cách với hoặc không cùng thức ăn mỗi ngày. Mọi thay đổi phải báo đội ghép.",
    caution: "Không tự đổi nhãn hiệu, dạng bào chế hoặc thực phẩm bổ sung.",
  },
  {
    id: "maoi-tyramine",
    index: "08",
    title: "MAOI/linezolid × thực phẩm giàu tyramine",
    medicines: "Thuốc ức chế monoamine oxidase (MAOI) hoặc linezolid",
    foods: "Một số thực phẩm lên men/ủ lâu, phô mai già, thịt cá lên men hoặc quá chín",
    action: "Chỉ dùng danh sách hạn chế do bác sĩ/dược sĩ cung cấp cho đúng thuốc. Không tự áp dụng danh sách chung cho mọi thuốc chống trầm cảm.",
    caution: "Đau đầu dữ dội, đau ngực, hồi hộp hoặc huyết áp tăng đột ngột cần cấp cứu.",
  },
  {
    id: "iron-calcium-tea",
    index: "09",
    title: "Viên sắt × sữa, trà, cà phê và chất xơ cao",
    medicines: "Sắt bổ sung",
    foods: "Sữa/canxi, trà, cà phê và bữa rất giàu chất xơ",
    action: "Không dùng cùng thời điểm với sữa/canxi hoặc thuốc kháng acid; thường cần cách khoảng 2 giờ theo hướng dẫn. Hỏi dược sĩ nếu đang dùng nhiều thuốc.",
    caution: "Không tự tăng liều sắt khi chưa xác định nguyên nhân thiếu máu.",
  },
  {
    id: "metformin-alcohol",
    index: "10",
    title: "Metformin × uống nhiều rượu bia",
    medicines: "Metformin",
    foods: "Rượu bia, đặc biệt uống nhiều hoặc kèm bỏ bữa",
    action: "Rượu làm tăng nguy cơ tác dụng phụ nghiêm trọng ở một số người. Trao đổi với bác sĩ, nhất là khi có bệnh thận, gan, tim hoặc đang mất nước.",
    caution: "Không tự ngừng metformin để uống rượu; hãy hỏi người kê đơn.",
  },
] as const;
---

<BaseLayout title={title} description={description} canonical="/cong-cu/tuong-tac-thuoc-thuc-pham" robots="noindex,follow">
  <main class="drug-food-page">
    <section class="hero" aria-labelledby="page-title">
      <p class="eyebrow">Bảng tra cứu có nguồn</p>
      <h1 id="page-title">Tương tác thuốc - thực phẩm</h1>
      <p class="lead">
        Tra nhanh các cặp thuốc - thực phẩm thường gặp ở người bệnh mạn tính Việt Nam.
        Nội dung giúp bạn chuẩn bị câu hỏi, không chấm nguy cơ cá nhân và không thay thế
        tờ hướng dẫn thuốc, bác sĩ hoặc dược sĩ.
      </p>
    </section>

    <section class="warning-band" aria-label="Lưu ý quan trọng">
      <h2>Khi nào cần hỏi chuyên môn?</h2>
      <p>
        Nếu bạn đang dùng thuốc theo toa, thuốc dùng dài ngày cho bệnh mạn tính, thuốc
        chống đông, thuốc đái tháo đường, thuốc huyết áp, thuốc lợi tiểu, thuốc ghép tạng,
        hoặc đang mang thai/cho con bú, hãy hỏi bác sĩ hoặc dược sĩ trước khi thay đổi
        cách dùng thuốc, thực phẩm bổ sung hay chế độ ăn.
      </p>
    </section>

    <section class="tool-panel" aria-labelledby="check-title">
      <div class="panel-copy">
        <p class="eyebrow">Tra cứu nhanh</p>
        <h2 id="check-title">Tìm theo thuốc hoặc thực phẩm</h2>
        <p>
          Gõ tên thuốc, món ăn hoặc nhóm bệnh để lọc các thẻ bên dưới. Kết quả là
          thông tin giáo dục có nguồn; chế phẩm, liều và bệnh nền có thể làm hướng dẫn khác đi.
        </p>
      </div>

      <form class="safety-form" id="interaction-form">
        <label for="interaction-search">Từ khóa</label>
        <input id="interaction-search" name="interaction-search" type="search" placeholder="Ví dụ: warfarin, bưởi, canxi, kali" autocomplete="off" />
        <div class="form-actions">
          <button type="submit">Lọc tương tác</button>
          <button type="button" class="secondary-button" id="clear-interaction-search">Xóa lọc</button>
        </div>
      </form>

      <div class="result-panel" id="safety-result" aria-live="polite">
        <p class="result-label">Định hướng</p>
        <h3><span id="interaction-count">{interactionCards.length}</span> nhóm tương tác đang hiển thị</h3>
        <p>
          Chọn đúng tên thuốc và dạng bào chế trên toa trước khi áp dụng bất kỳ khoảng
          cách uống nào. Nếu không thấy cặp bạn cần, hãy hỏi dược sĩ thay vì suy đoán.
        </p>
        <ul>
          <li>Không tự thay đổi cách dùng thuốc hoặc liều dùng dựa trên trang này.</li>
          <li>Nếu có triệu chứng bất thường sau khi dùng thuốc, hãy liên hệ cơ sở y tế hoặc người đang theo dõi cho bạn.</li>
        </ul>
      </div>
    </section>

    <section class="interaction-section" aria-labelledby="interaction-title">
      <div class="section-head">
        <p class="eyebrow">Các cặp thường gặp</p>
        <h2 id="interaction-title">Đọc lưu ý theo nhóm thuốc</h2>
        <p class="section-intro">Các ví dụ dưới đây được chọn vì liên quan đến đái tháo đường, tăng huyết áp, bệnh thận, rối loạn mỡ máu, tuyến giáp, ghép tạng và thiếu máu.</p>
      </div>
      <div class="interaction-grid" id="interaction-grid">
        {interactionCards.map((item) => (
          <article class="interaction-card" data-search={`${item.title} ${item.medicines} ${item.foods} ${item.action} ${item.caution}`}>
            <div class="interaction-card-head">
              <span class="interaction-index" aria-hidden="true">{item.index}</span>
              <h3>{item.title}</h3>
            </div>
            <dl>
              <div><dt>Thuốc</dt><dd>{item.medicines}</dd></div>
              <div><dt>Thực phẩm/đồ uống</dt><dd>{item.foods}</dd></div>
            </dl>
            <p class="action-copy"><strong>Nên làm:</strong> {item.action}</p>
            <p class="caution-copy"><strong>Cần nhớ:</strong> {item.caution}</p>
          </article>
        ))}
      </div>
      <p class="no-results" id="interaction-empty" hidden>Chưa có thẻ khớp từ khóa. Tên hoạt chất, tên thương mại và dạng bào chế có thể khác nhau — hãy gửi ảnh/toa thuốc cho dược sĩ.</p>
    </section>

    <section class="risk-section" aria-labelledby="risk-title">
      <div class="section-head">
        <p class="eyebrow">Cờ cần cá thể hóa</p>
        <h2 id="risk-title">Những nhóm nên hỏi trước</h2>
      </div>
      <div class="risk-grid">
        {riskGroups.map((item) => (
          <article class="risk-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sources-section" aria-labelledby="sources-title">
      <div>
        <p class="eyebrow">Đọc thêm có kiểm chứng</p>
        <h2 id="sources-title">Nguồn và bài viết liên quan</h2>
      </div>
      <p>
        Xem bài <a href="/kien-thuc-dinh-duong/tuong-tac-thuoc-thuc-pham-thuong-gap">Thuốc và thực phẩm: 10 tương tác thường gặp</a>
        để hiểu cách chuẩn bị câu hỏi cho bác sĩ/dược sĩ. Các nguồn chính gồm
        <a href="https://medlineplus.gov/druginfo/meds/a682461.html" rel="noopener noreferrer">MedlinePlus về levothyroxine</a>,
        <a href="https://medlineplus.gov/druginfo/meds/a688016.html" rel="noopener noreferrer">ciprofloxacin</a>,
        <a href="https://medlineplus.gov/druginfo/meds/a601117.html" rel="noopener noreferrer">tacrolimus</a> và
        <a href="https://www.nhs.uk/medicines/statins/" rel="noopener noreferrer">NHS về statin</a>.
      </p>
    </section>

    <section class="prep-section" aria-labelledby="prep-title">
      <div>
        <p class="eyebrow">Chuẩn bị khi đi hỏi</p>
        <h2 id="prep-title">Thông tin nên mang theo</h2>
      </div>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="small-note">
        Trang này không thay thế tư vấn chuyên môn và không tạo khuyến nghị riêng
        cho thuốc đang dùng.
      </p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const form = document.getElementById("interaction-form");
      const search = document.getElementById("interaction-search");
      const clear = document.getElementById("clear-interaction-search");
      const count = document.getElementById("interaction-count");
      const empty = document.getElementById("interaction-empty");
      const cards = Array.from(document.querySelectorAll(".interaction-card"));

      if (!(form instanceof HTMLFormElement) || !(search instanceof HTMLInputElement) || !(clear instanceof HTMLButtonElement) || !count || !empty) {
        return;
      }

      const applyFilter = () => {
        const query = search.value.trim().toLocaleLowerCase("vi");
        let visible = 0;
        cards.forEach((card) => {
          const text = (card.getAttribute("data-search") || card.textContent || "").toLocaleLowerCase("vi");
          const match = !query || text.includes(query);
          card.toggleAttribute("hidden", !match);
          if (match) visible += 1;
        });
        count.textContent = String(visible);
        empty.toggleAttribute("hidden", visible !== 0);
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilter();
      });
      search.addEventListener("input", applyFilter);
      clear.addEventListener("click", () => {
        search.value = "";
        applyFilter();
        search.focus();
      });
    })();
  </script>

  <style>
    .drug-food-page {
      display: grid;
      gap: 24px;
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 16px 56px;
    }

    .hero,
    .warning-band,
    .tool-panel,
    .risk-section,
    .prep-section {
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }

    .hero {
      padding: 28px;
      background: linear-gradient(135deg, rgba(5, 150, 105, 0.05) 0%, rgba(59, 130, 246, 0.05) 100%);
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    h1,
    h2,
    h3,
    p {
      overflow-wrap: anywhere;
    }

    h1 {
      margin: 0;
      color: var(--brand-dark);
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.08;
      letter-spacing: 0;
    }

    h2 {
      margin: 0;
      color: var(--ink);
      font-size: 1.35rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    h3 {
      margin: 4px 0 8px;
      color: var(--ink);
      font-size: 1.18rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .lead {
      max-width: 760px;
      margin: 14px 0 0;
      color: var(--ink-secondary);
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .warning-band {
      padding: 22px;
      border-color: rgba(245, 158, 11, 0.15);
      background: rgba(245, 158, 11, 0.05);
    }

    .warning-band p,
    .panel-copy p,
    .prep-section p {
      color: var(--ink-secondary);
      line-height: 1.6;
    }

    .tool-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
      gap: 20px;
      align-items: start;
      padding: 24px;
    }

    .panel-copy p {
      margin: 10px 0 0;
    }

    .safety-form {
      display: grid;
      gap: 10px;
    }

    .safety-form label {
      color: var(--ink);
      font-weight: 700;
    }

    .safety-form input,
    .safety-form button {
      width: 100%;
      min-height: 46px;
      border-radius: var(--radius);
      font: inherit;
    }

    .safety-form input {
      border: 1px solid var(--card-border);
      background: var(--card);
      color: var(--ink);
      padding: 0 14px;
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    .safety-form input:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .form-actions {
      display: grid;
      grid-template-columns: 1fr 110px;
      gap: 8px;
    }

    .safety-form button {
      border: 0;
      background: var(--brand);
      color: #ffffff;
      font-weight: 800;
      cursor: pointer;
      transition: all var(--transition);
    }

    .safety-form .secondary-button {
      border: 1px solid var(--card-border);
      background: transparent;
      color: var(--ink-secondary);
    }

    .safety-form button:hover {
      background: var(--brand-dark);
      transform: translateY(-1px);
    }

    .safety-form button:active {
      transform: translateY(0);
    }

    .interaction-section,
    .sources-section {
      padding: 24px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow-sm);
    }

    .section-intro,
    .sources-section p {
      margin: 8px 0 0;
      color: var(--ink-secondary);
      line-height: 1.6;
    }

    .sources-section a {
      color: var(--brand-dark);
      font-weight: 700;
    }

    .interaction-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 18px;
    }

    .interaction-card {
      display: grid;
      gap: 12px;
      padding: 18px;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      background: var(--bg-soft);
    }

    .interaction-card[hidden] {
      display: none;
    }

    .interaction-card-head {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 10px;
      align-items: start;
    }

    .interaction-index {
