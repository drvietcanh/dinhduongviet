          "Thuốc bổ sung kali — không tự ý uống thêm kali khi dùng nhóm này (nguy cơ tăng kali máu)",
          "Cam thảo — tăng huyết áp, giảm kali"
        ],
        tip: "Nếu ho khan kéo dài do thuốc, hỏi bác sĩ đổi sang nhóm ARB (Losartan, Telmisartan)."
      },
      corticosteroid: {
        name: "Corticosteroid (Prednisolone, Methylprednisolone, Medrol)",
        drugClass: "Thuốc chống viêm (lupus, hen suyễn, dị ứng, viêm khớp)",
        do: [
          "Uống CÙNG bữa ăn hoặc ngay sau ăn — giảm kích ứng dạ dày",
          "Bổ sung canxi 1000–1200mg/ngày + vitamin D — phòng loãng xương",
          "Hạn chế muối, đường — phòng cao huyết áp và tiểu đường do thuốc"
        ],
        avoid: [
          "Cam thảo — tác dụng phụ cộng hưởng gây tăng huyết áp, giảm kali",
          "Đồ ngọt, nước ngọt — corticosteroid làm tăng đường huyết",
          "Rượu bia — tăng nguy cơ loét dạ dày"
        ],
        tip: "Dùng liều thấp nhất có thể, thời gian ngắn nhất. Không ngừng đột ngột nếu dùng &gt;2 tuần — phải giảm dần."
      },
      calcium: {
        name: "Canxi (thuốc bổ)",
        drugClass: "Bổ sung khoáng chất",
        do: [
          "Uống sau ăn — hấp thu tốt hơn, ít kích ứng dạ dày",
          "Chia làm 2 lần/ngày nếu liều ≥ 500mg",
          "Uống kèm vitamin D để tăng hấp thu"
        ],
        avoid: [
          "Uống cùng lúc với thuốc sắt, levothyroxine — cách ít nhất 2 giờ",
          "Uống cùng bữa ăn nhiều chất xơ (cám, yến mạch) — giảm hấp thu canxi",
          "Uống canxi carbonate với nước cam — tốt, nhưng canxi citrate uống lúc nào cũng được"
        ],
        tip: "Canxi citrate hấp thu tốt hơn, không cần uống cùng thức ăn — phù hợp người giảm acid dạ dày."
      },
      iron: {
        name: "Sắt (Ferrous sulfate, Ferrous gluconate)",
        drugClass: "Bổ sung khoáng chất (thiếu máu)",
        do: [
          "Uống lúc đói — hấp thu tốt nhất (nếu không kích ứng dạ dày)",
          "Uống kèm vitamin C (nước cam, ớt chuông) — tăng hấp thu sắt gấp 3–6 lần",
          "Nếu bị táo bón, tăng rau xanh và uống đủ nước"
        ],
        avoid: [
          "Uống cùng trà, cà phê — tanin làm giảm hấp thu sắt (cách ít nhất 1 giờ)",
          "Uống cùng canxi, sữa, thuốc kháng acid — giảm hấp thu",
          "Uống cùng bữa ăn nhiều chất xơ — làm giảm hấp thu"
        ],
        tip: "Phân đen khi uống sắt là bình thường. Nếu táo bón nặng, hỏi dược sĩ đổi sang dạng sắt hữu cơ (iron bisglycinate)."
      },
      'vitamin-k': {
        name: "Vitamin K (nếu đang dùng Warfarin)",
        drugClass: "Tương tác với thuốc chống đông",
        do: [
          "Duy trì lượng vitamin K ỔN ĐỊNH hàng ngày qua thực phẩm"
        ],
        avoid: [
          "Tăng/giảm đột ngột rau xanh giàu vitamin K",
          "Thuốc bổ sung vitamin K (trừ khi có chỉ định)",
          "Nước ép nam việt quất, nước bưởi"
        ],
        tip: "Bạn KHÔNG cần kiêng rau — ăn rau bình thường, nhưng ĐỀU đặn, không hôm nhiều hôm ít."
      },
      thyroid: {
        name: "Thuốc kháng giáp (Methimazole, PTU)",
        drugClass: "Thuốc điều trị cường giáp",
        do: [
          "Uống thuốc theo chỉ định, không tự ý ngừng",
          "Theo dõi cân nặng — tăng cân quá nhanh khi kiểm soát được cường giáp là bình thường"
