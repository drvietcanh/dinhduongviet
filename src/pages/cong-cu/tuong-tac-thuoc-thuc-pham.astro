---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Tương tác thuốc - thực phẩm | Dinh Dưỡng Việt";
const description =
  "Nhắc các tình huống cần hỏi bác sĩ hoặc dược sĩ khi dùng thuốc cùng thực phẩm.";

const riskGroups = [
  "Đang dùng thuốc theo toa hoặc thuốc dùng dài ngày cho bệnh mạn tính",
  "Dùng nhiều thuốc cùng lúc, gồm cả thực phẩm bổ sung",
  "Thuốc chống đông, thuốc đái tháo đường, thuốc huyết áp, thuốc lợi tiểu",
  "Bệnh thận, bệnh gan, bệnh tim mạch hoặc bệnh ung thư",
  "Đang mang thai, cho con bú, trẻ em hoặc người cao tuổi yếu",
  "Có triệu chứng bất thường sau khi dùng thuốc",
];

const prepItems = [
  "Tên thuốc, hàm lượng, số lần dùng trong ngày",
  "Thực phẩm bổ sung, thảo dược, vitamin hoặc khoáng chất đang dùng",
  "Thói quen ăn uống đặc biệt, rượu bia, nước ép, cà phê hoặc sữa nếu có",
  "Bệnh nền, thai kỳ/cho con bú, dị ứng thuốc và triệu chứng mới xuất hiện",
];

const scenarios = [
  ["general", "Chỉ muốn đọc lưu ý chung"],
  ["prescription", "Đang dùng thuốc theo toa"],
  ["many", "Dùng nhiều thuốc cùng lúc"],
  ["blood", "Thuốc chống đông hoặc thuốc tim mạch"],
  ["diabetes", "Thuốc đái tháo đường hoặc đường huyết"],
  ["fluid", "Thuốc huyết áp, lợi tiểu hoặc điện giải"],
  ["seizure", "Thuốc chống động kinh"],
  ["cancer", "Thuốc ung thư"],
  ["organ", "Bệnh thận, gan hoặc tim mạch"],
  ["pregnancy", "Mang thai hoặc cho con bú"],
  ["age", "Trẻ em, người cao tuổi hoặc người dễ suy kiệt"],
  ["symptom", "Có triệu chứng bất thường sau khi dùng thuốc"],
] as const;
---

<BaseLayout title={title} description={description} canonical="/cong-cu/tuong-tac-thuoc-thuc-pham">
  <main class="drug-food-page">
    <section class="hero" aria-labelledby="page-title">
      <p class="eyebrow">Công cụ an toàn v1</p>
      <h1 id="page-title">Tương tác thuốc - thực phẩm</h1>
      <p class="lead">
        Công cụ này chỉ giúp nhắc các tình huống cần hỏi bác sĩ hoặc dược sĩ.
        Không dùng để tự thay đổi thuốc, liều dùng hoặc tự kết luận một thuốc
        dùng chung với thực phẩm là phù hợp cho cá nhân bạn.
      </p>
    </section>

    <section class="warning-band" aria-label="Lưu ý quan trọng">
      <h2>Khi nào cần hỏi chuyên môn?</h2>
      <p>
        Nếu bạn đang dùng thuốc theo toa, thuốc dùng dài ngày cho bệnh mạn tính, thuốc
        chống đông, thuốc đái tháo đường, thuốc huyết áp, thuốc lợi tiểu, thuốc
        chống động kinh, thuốc ung thư, hoặc đang mang thai/cho con bú,
        hãy hỏi bác sĩ hoặc dược sĩ trước khi thay đổi cách dùng thuốc hay chế
        độ ăn.
      </p>
    </section>

    <section class="tool-panel" aria-labelledby="check-title">
      <div class="panel-copy">
        <p class="eyebrow">Định hướng an toàn</p>
        <h2 id="check-title">Chọn tình huống gần nhất</h2>
        <p>
          V1 không tra cứu tương tác cá nhân và không phân mức độ tương tác. Kết quả
          chỉ là lời nhắc để chuẩn bị thông tin trước khi hỏi bác sĩ hoặc dược sĩ.
        </p>
      </div>

      <form class="safety-form" id="interaction-form">
        <label for="scenario">Tình huống</label>
        <select id="scenario" name="scenario">
          {scenarios.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
        <button type="submit">Xem nhắc nhở</button>
      </form>

      <div class="result-panel" id="safety-result" aria-live="polite">
        <p class="result-label">Định hướng</p>
        <h3>Cần hỏi bác sĩ hoặc dược sĩ</h3>
        <p>
          Không đủ điều kiện đưa kết luận cá nhân ở v1. Hãy mang danh sách thuốc,
          thực phẩm bổ sung và thói quen ăn uống để hỏi người phụ trách chuyên môn.
        </p>
        <ul>
          <li>Không tự thay đổi cách dùng thuốc hoặc liều dùng dựa trên trang này.</li>
          <li>Nếu có triệu chứng bất thường sau khi dùng thuốc, hãy liên hệ cơ sở y tế hoặc người đang theo dõi cho bạn.</li>
        </ul>
      </div>
    </section>

    <section class="risk-section" aria-labelledby="risk-title">
      <div class="section-head">
        <p class="eyebrow">Cờ cần cá thể hóa</p>
        <h2 id="risk-title">Những nhóm nên hỏi trước</h2>
      </div>
      <div class="risk-grid">
        {riskGroups.map((item) => (
          <article class="risk-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="prep-section" aria-labelledby="prep-title">
      <div>
        <p class="eyebrow">Chuẩn bị khi đi hỏi</p>
        <h2 id="prep-title">Thông tin nên mang theo</h2>
      </div>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="small-note">
        Trang này không thay thế tư vấn chuyên môn và không tạo khuyến nghị riêng
        cho thuốc đang dùng.
      </p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const messages = {
        general: "Hãy dùng trang này như danh sách nhắc việc. Khi có thuốc đang dùng hoặc bệnh nền, cần hỏi bác sĩ hoặc dược sĩ.",
        prescription: "Thuốc theo toa cần được xem cùng bệnh nền, liều dùng và lịch dùng thực tế. Hãy hỏi bác sĩ hoặc dược sĩ trước khi thay đổi chế độ ăn liên quan.",
        many: "Dùng nhiều thuốc cùng lúc làm nguy cơ nhầm lẫn cao hơn. Hãy chuẩn bị đầy đủ tên thuốc và thực phẩm bổ sung để được rà soát.",
        blood: "Nhóm thuốc tim mạch hoặc chống đông cần được cá thể hóa theo hồ sơ đang theo dõi. Trang này không đưa kết luận dùng chung cho từng thuốc.",
        diabetes: "Thuốc đường huyết cần được theo dõi theo bữa ăn, triệu chứng và chỉ dẫn chuyên môn. Hãy hỏi người đang theo dõi nếu muốn đổi chế độ ăn.",
        fluid: "Thuốc huyết áp, lợi tiểu hoặc điện giải cần xem kèm xét nghiệm và tình trạng bệnh nền. Không tự thay đổi thuốc dựa trên nội dung này.",
        seizure: "Thuốc chống động kinh cần được xem theo hồ sơ dùng thuốc, triệu chứng và lịch theo dõi. Hãy hỏi bác sĩ hoặc dược sĩ trước khi đổi thực phẩm bổ sung hay chế độ ăn.",
        cancer: "Thuốc ung thư cần được theo dõi cá thể theo phác đồ và tình trạng ăn uống. Hãy hỏi đội ngũ đang chăm sóc trước khi đổi thực phẩm bổ sung hay chế độ ăn.",
        organ: "Bệnh thận, gan hoặc tim mạch cần đánh giá cá thể. Hãy hỏi bác sĩ hoặc dược sĩ trước khi thay đổi thực phẩm hay thực phẩm bổ sung.",
        pregnancy: "Thai kỳ và cho con bú cần được tư vấn riêng. Hãy hỏi bác sĩ hoặc dược sĩ trước khi dùng thêm thực phẩm bổ sung hoặc thay đổi thuốc.",
        age: "Trẻ em, người cao tuổi hoặc người dễ suy kiệt cần được xem theo hồ sơ sức khỏe, bệnh nền và thuốc đang dùng.",
        symptom: "Nếu có triệu chứng bất thường sau khi dùng thuốc, hãy liên hệ cơ sở y tế hoặc người đang theo dõi cho bạn.",
      };

      const form = document.getElementById("interaction-form");
      const select = document.getElementById("scenario");
      const result = document.getElementById("safety-result");

      if (!(form instanceof HTMLFormElement) || !(select instanceof HTMLSelectElement) || !result) {
        return;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const key = select.value;
        const message = messages[key] || messages.general;
        result.innerHTML = `
          <p class="result-label">Định hướng</p>
          <h3>Cần hỏi bác sĩ hoặc dược sĩ</h3>
          <p>${message}</p>
          <ul>
            <li>Không đủ điều kiện đưa kết luận cá nhân ở v1.</li>
            <li>Không tự thay đổi cách dùng thuốc hoặc liều dùng dựa trên trang này.</li>
          </ul>
        `;
      });
    })();
  </script>

  <style>
    .drug-food-page {
      display: grid;
      gap: 24px;
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 16px 56px;
    }

    .hero,
    .warning-band,
    .tool-panel,
    .risk-section,
    .prep-section {
      border: 1px solid #d8e2ee;
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .hero {
      padding: 28px;
      background: linear-gradient(135deg, #f7fbff 0%, #eef7f2 100%);
    }

    .eyebrow {
      margin: 0 0 8px;
      color: #0f766e;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    h1,
    h2,
    h3,
    p {
      overflow-wrap: anywhere;
    }

    h1 {
      margin: 0;
      color: #12324a;
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.08;
      letter-spacing: 0;
    }

    h2 {
      margin: 0;
      color: #16324a;
      font-size: 1.35rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    h3 {
      margin: 4px 0 8px;
      color: #12324a;
      font-size: 1.18rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .lead {
      max-width: 760px;
      margin: 14px 0 0;
      color: #334155;
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .warning-band {
      padding: 22px;
      border-color: #f2c78f;
      background: #fff8ed;
    }

    .warning-band p,
    .panel-copy p,
    .prep-section p {
      color: #334155;
      line-height: 1.6;
    }

    .tool-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
      gap: 20px;
      align-items: start;
      padding: 24px;
    }

    .panel-copy p {
      margin: 10px 0 0;
    }

    .safety-form {
      display: grid;
      gap: 10px;
    }

    .safety-form label {
      color: #1f2937;
      font-weight: 700;
    }

    .safety-form select,
    .safety-form button {
      width: 100%;
      min-height: 46px;
      border-radius: 8px;
      font: inherit;
    }

    .safety-form select {
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #111827;
      padding: 0 12px;
    }

    .safety-form button {
      border: 0;
      background: #0f766e;
      color: #ffffff;
      font-weight: 800;
      cursor: pointer;
    }

    .result-panel {
      grid-column: 1 / -1;
      padding: 18px;
      border: 1px solid #b7d6ce;
      border-radius: 8px;
      background: #f0fdfa;
      color: #234;
    }

    .result-label {
      margin: 0;
      color: #0f766e;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .result-panel p {
      margin: 0 0 10px;
      line-height: 1.58;
    }

    .result-panel ul,
    .prep-section ul {
      margin: 10px 0 0;
      padding-left: 1.2rem;
      color: #334155;
      line-height: 1.58;
    }

    .risk-section,
    .prep-section {
      padding: 24px;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .risk-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .risk-card {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 10px;
      align-items: start;
      min-height: 86px;
      padding: 14px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }

    .risk-card span {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: #e0f2fe;
      color: #075985;
      font-weight: 900;
    }

    .risk-card p {
      margin: 0;
      color: #334155;
      line-height: 1.45;
    }

    .prep-section {
      display: grid;
      grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1fr);
      gap: 18px;
    }

    .small-note {
      grid-column: 1 / -1;
      margin: 0;
      padding-top: 12px;
      border-top: 1px solid #e2e8f0;
      font-size: 0.95rem;
    }

    @media (max-width: 760px) {
      .drug-food-page {
        padding: 20px 12px 40px;
      }

      .hero,
      .warning-band,
      .tool-panel,
      .risk-section,
      .prep-section {
        padding: 18px;
      }

      .tool-panel,
      .prep-section {
        grid-template-columns: 1fr;
      }

      .risk-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
