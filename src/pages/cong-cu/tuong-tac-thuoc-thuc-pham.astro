        drugClass: "Thuốc hạ huyết áp",
        do: [
          "Hạn chế muối dưới 5g/ngày",
          "Ăn nhiều rau xanh, trái cây (giàu kali)",
          "Uống đủ nước"
        ],
        avoid: [
