          "Uống CÙNG giờ mỗi ngày"
        ],
        avoid: [
          "Cà phê, trà, nước cam — uống cách thuốc ít nhất 60 phút",
          "Sữa, sữa chua, phô mai, canxi — uống cách ít nhất 2 giờ",
          "Thuốc sắt, omeprazol — uống cách ít nhất 2 giờ",
          "Đậu nành, bột đậu nành lượng lớn — ăn cách 2 giờ"
        ],
        tip: "Nếu quên uống sáng, uống ngay khi nhớ, trừ khi gần tới liều kế. Đặt báo thức để uống thuốc cùng giờ."
      },
      warfarin: {
        name: "Warfarin",
        drugClass: "Thuốc chống đông máu",
        do: [
          "Giữ lượng rau xanh ĂN ĐỀU hàng ngày — quan trọng nhất!",
          "Theo dõi INR đều đặn"
        ],
        avoid: [
          "Tăng đột ngột lượng rau xanh giàu vitamin K: cải bó xôi, cải xoăn, rau ngót, rau dền, bông cải, bắp cải",
          "Nước ép nam việt quất (cranberry juice) — tăng tác dụng warfarin",
          "Nước bưởi ép — tăng nguy cơ chảy máu",
          "Rượu bia nhiều — ảnh hưởng chuyển hóa thuốc",
          "Thuốc bổ sung vitamin K, thảo dược: nhân sâm, bạch quả, đinh hương"
        ],
        tip: "KHÔNG cần kiêng rau xanh hoàn toàn — chỉ cần giữ LƯỢNG ỔN ĐỊNH mỗi ngày. Đột ngột ăn nhiều/ít rau mới nguy hiểm."
      },
      statin: {
        name: "Statin (Atorvastatin, Rosuvastatin, Simvastatin)",
        drugClass: "Thuốc giảm mỡ máu",
        do: [
          "Uống vào buổi tối (hầu hết statin hiệu quả hơn khi uống tối)",
          "Kết hợp chế độ ăn giảm mỡ bão hòa và tăng chất xơ"
        ],
        avoid: [
          "Nước bưởi ép (grapefruit juice) — tăng nồng độ thuốc, nguy cơ tổn thương cơ",
          "Rượu bia nhiều — tăng nguy cơ tổn thương gan",
          "Thực phẩm giàu chất béo bão hòa: mỡ heo, da gà, da vịt, dầu dừa"
        ],
        tip: "Nếu bị đau cơ khi dùng statin, báo bác sĩ — có thể đổi thuốc hoặc giảm liều. Không tự ý ngừng."
      },
      allopurinol: {
        name: "Allopurinol",
        drugClass: "Thuốc hạ acid uric (gout)",
        do: [
          "Uống nhiều nước 2–3 lít/ngày — giúp thải acid uric",
          "Uống sau ăn để giảm kích ứng dạ dày"
        ],
        avoid: [
          "Rượu bia — đặc biệt bia (làm tăng acid uric và giảm tác dụng thuốc)",
          "Nội tạng (gan, lòng, tim), hải sản vỏ cứng",
          "Nước ngọt có gas, nước ép trái cây đóng hộp (fructose)"
        ],
        tip: "Có thể bùng phát đợt gout cấp trong 1–2 tháng đầu dùng allopurinol — uống thuốc đều, không ngừng đột ngột."
      },
      furosemide: {
        name: "Furosemide (Lasix)",
        drugClass: "Thuốc lợi tiểu (tăng huyết áp, suy tim, phù)",
        do: [
          "Uống vào buổi sáng — tránh tiểu đêm",
          "Ăn chuối, cam, bưởi, khoai lang, cà chua — bổ sung kali"
        ],
        avoid: [
          "Cam thảo — giảm tác dụng lợi tiểu, tăng huyết áp",
          "Muối — hạn chế dưới 5g/ngày",
          "Rượu bia — làm mất nước, rối loạn điện giải"
        ],
        tip: "Theo dõi cân nặng hàng ngày — tăng &gt;2kg trong 2 ngày báo phù. Nếu chuột rút hoặc yếu cơ, kiểm tra kali máu."
      },
