    function showDrug(key) {
      if (!key) { document.getElementById('result').style.display = 'none'; return; }
      var d = DRUGS[key];
      if (!d) return;

      var html = '<div class="drug-card">';
      html += '<h2>💊 '+d.name+'</h2>';
      html += '<div class="drug-class">'+d.drugClass+'</div>';

      html += '<h4>✅ Nên làm</h4><ul>';
      for (var i=0;i<d.do.length;i++) html += '<li><strong>'+d.do[i]+'</li>';
      html += '</ul>';

      html += '<h4>❌ Tránh / Lưu ý</h4><ul>';
      for (var i=0;i<d.avoid.length;i++) html += '<li>'+d.avoid[i]+'</li>';
      html += '</ul>';

      html += '<div class="tip-box">💡 <strong>Mẹo:</strong> '+d.tip+'</div>';
      html += '</div>';

      document.getElementById('result').innerHTML = html;
      document.getElementById('result').style.display = 'block';
    }

    window.showDrug = showDrug;
  })();
  </script>
