---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau đột quỵ";
const desc = "Bảng kiểm ăn uống, nuốt và phục hồi sau đột quỵ.";
const items = [
  "Tôi đã được đánh giá nuốt và biết dạng thức ăn/nước an toàn, không tự đổi độ đặc",
  "Tôi ngồi thẳng, ăn chậm, từng miếng nhỏ và giữ tư thế sau ăn theo hướng dẫn",
  "Tôi theo dõi lượng ăn, nước uống, cân nặng và dấu hiệu ho/sặc trong mỗi bữa",
  "Tôi ăn đủ năng lượng–đạm, kiểm soát muối/đường và bệnh nền tim mạch phù hợp",
  "Tôi dùng thuốc nghiền/qua sonde chỉ khi dược sĩ xác nhận, không tự bẻ thuốc giải phóng kéo dài",
  "Tôi biết dấu hiệu tái phát đột quỵ hoặc viêm phổi hít cần gọi cấp cứu",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-phuc-hoi-sau-dot-quy">
  <main class="stroke-rehab-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thần kinh–phục hồi</p>
      <h1>🧠 Checklist dinh dưỡng sau đột quỵ</h1>
      <p>{desc} Phối hợp bác sĩ, chuyên viên âm ngữ trị liệu và dinh dưỡng để giảm sặc và mất cơ.</p>
    </header>
    <form id="stroke-rehab-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-stroke-rehab /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Gọi cấp cứu khi</h2>
      <p>Méo miệng/yếu liệt mới, nói khó đột ngột, khó thở, tím tái, ho sặc kéo dài, sốt hoặc lơ mơ.</p>
      <p class="warning">Không ép uống nước khi đang sặc, không tự cho ăn qua sonde hoặc đổi thuốc nghiền.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("stroke-rehab-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-stroke-rehab]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký nuốt, lượng ăn, cân nặng và danh sách thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với đội đột quỵ, âm ngữ trị liệu hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .stroke-rehab-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .stroke-rehab-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
