    // ---- Focus foods ----
    var focusHtml = '';
    if (age === '0-6m') {
      focusHtml = '<p><strong>Sữa mẹ</strong> là thức ăn hoàn chỉnh. Nếu không đủ: sữa công thức số 1 pha đúng hướng dẫn.</p>';
    } else if (age === '6-12m') {
      focusHtml = '<p><strong>🥩 Đạm:</strong> thịt nạc heo, gà, bò, cá lóc, tôm, lươn, trứng, đậu phụ (nghiền nhuyễn)</p><p><strong>🥦 Rau:</strong> rau ngót, cải bó xôi, bí đỏ, cà rốt, bông cải</p><p><strong>🫘 Dầu ăn:</strong> dầu oliu, dầu mè, dầu cá — 2–3 muỗng cafe/ngày</p><p><strong>🍎 Trái cây:</strong> chuối, đu đủ, bơ, táo, thanh long</p>';
    } else if (age === '1-3y') {
      focusHtml = '<p><strong>🥩 Đạm:</strong> thịt (30–40g/bữa), cá, trứng (1 quả/ngày), tôm, đậu hũ</p><p><strong>🥦 Rau xanh:</strong> rau ngót, cải bó xôi, mồng tơi, bí đỏ</p><p><strong>🍳 Chất béo:</strong> dầu ăn 2 muỗng cafe/ngày, phô mai, bơ</p><p><strong>🍼 Sữa:</strong> 300–500ml sữa tươi nguyên kem + sữa chua</p>';
