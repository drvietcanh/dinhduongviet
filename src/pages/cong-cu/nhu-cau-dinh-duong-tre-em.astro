      focusHtml = '<p><strong>🦴 Canxi & Vit D:</strong> sữa 300ml/ngày + phô mai + cá nhỏ + tắm nắng 20 phút/ngày</p><p><strong>🥩 Đạm:</strong> thịt, cá, trứng, đậu — 70–100g/bữa</p><p><strong>🩸 Sắt:</strong> thịt bò, tim, lòng đỏ trứng, rau xanh đậm + cam</p><p><strong>💧 Nước:</strong> 1,2–1,6 lít/ngày (kể cả súp, canh, sữa)</p>';
    } else {
      focusHtml = '<p><strong>🦴 Canxi (quan trọng nhất!):</strong> sữa 400–500ml/ngày + sữa chua + phô mai + cải xoăn + cá hồi</p><p><strong>🥩 Đạm:</strong> thịt (100–150g/bữa), cá, trứng, tôm, đậu nành, hạt</p><p><strong>🩸 Sắt (bé gái):</strong> thịt bò, tim, lòng đỏ trứng, rau dền, cải bó xôi</p><p><strong>🌰 Kẽm:</strong> tôm đồng, hàu, thịt bò, lòng đỏ trứng, hạt bí, đậu</p><p><strong>💧 Nước:</strong> 1,6–2 lít/ngày. Hạn chế nước ngọt, trà sữa!</p>';
