---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Nhu cầu dinh dưỡng trẻ em | Dinh Dưỡng Việt";
const description =
  "Định hướng an toàn về các tình huống cần hỏi bác sĩ hoặc chuyên gia dinh dưỡng khi xem nhu cầu dinh dưỡng cho trẻ em.";

const situations = [
  "Trẻ dưới 2 tuổi, sinh non, nhẹ cân khi sinh hoặc có vấn đề bú/ăn kéo dài",
  "Trẻ chậm tăng cân, sụt cân, thừa cân, béo phì hoặc chậm tăng chiều cao",
  "Trẻ có bệnh thận, gan, tim mạch, tiêu hóa, nội tiết, dị ứng thực phẩm hoặc bệnh mạn tính",
  "Trẻ có đái tháo đường, rối loạn chuyển hóa, ung thư, suy dinh dưỡng hoặc nguy cơ suy kiệt",
  "Trẻ kén ăn nặng, rối loạn ăn uống, ăn rất ít nhóm thực phẩm hoặc ăn chay nghiêm ngặt",
  "Trẻ đang dùng thuốc dài ngày, thực phẩm bổ sung liều cao hoặc nhiều sản phẩm cùng lúc",
  "Trẻ có triệu chứng như mệt nhiều, phù, nôn ói kéo dài, tiêu chảy kéo dài hoặc sốt",
  "Gia đình muốn tính khẩu phần cụ thể, sữa, ăn dặm hoặc bữa ăn học đường",
  "Có kết quả xét nghiệm, chẩn đoán hoặc khuyến cáo y tế cần được giải thích",
];

const prepItems = [
  "Tuổi, giới, cân nặng, chiều cao và biểu đồ tăng trưởng nếu có",
  "Thói quen ăn trong 3-7 ngày gần đây, gồm sữa, bữa chính, bữa phụ và nước uống",
  "Bệnh nền, dị ứng, thuốc đang dùng, thực phẩm bổ sung và triệu chứng mới",
  "Kết quả xét nghiệm, chẩn đoán hoặc hướng dẫn đã nhận từ cơ sở y tế",
];

const safeNextSteps = [
  "Dùng trang này như danh sách nhắc việc trước khi hỏi chuyên môn.",
  "Không tự đặt khẩu phần, năng lượng hay vi chất cho trẻ chỉ từ một công cụ trực tuyến.",
  "Nếu trẻ có triệu chứng bất thường hoặc thay đổi tăng trưởng nhanh, hãy liên hệ cơ sở y tế.",
];
---

<BaseLayout title={title} description={description} canonical="/cong-cu/nhu-cau-dinh-duong-tre-em">
  <main class="child-nutrition-shell" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Công cụ an toàn v1</p>
      <h1 id="page-title">Nhu cầu dinh dưỡng trẻ em</h1>
      <p>
        Công cụ này chỉ giúp định hướng các tình huống cần hỏi bác sĩ hoặc
        chuyên gia dinh dưỡng. V1 không tính nhu cầu năng lượng, đạm, chất béo,
        carb hay vi chất riêng cho từng trẻ.
      </p>
    </section>

    <section class="notice-panel" aria-labelledby="scope-title">
      <h2 id="scope-title">Phạm vi hiện tại</h2>
      <p>
        Trẻ em cần được xem theo tuổi, tốc độ tăng trưởng, bệnh nền, thuốc đang
        dùng, khẩu phần thực tế và bối cảnh gia đình. Vì chưa có source-lock và
        quy trình duyệt nhi khoa riêng, trang này không đưa số dinh dưỡng cá
        nhân hay đánh giá tăng trưởng tự động.
      </p>
    </section>

    <section class="situation-panel" aria-labelledby="situation-title">
      <div class="section-head">
        <p class="eyebrow">Khi nào cần hỏi chuyên môn?</p>
        <h2 id="situation-title">Các tình huống cần cá thể hóa</h2>
        <p>
          Nếu có một hoặc nhiều tình huống dưới đây, hãy chuẩn bị thông tin và
          trao đổi trực tiếp với bác sĩ hoặc chuyên gia dinh dưỡng.
        </p>
      </div>

      <div class="situation-grid">
        {situations.map((item) => (
          <article class="situation-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="result-panel" aria-labelledby="result-title">
      <p class="result-label">Định hướng</p>
      <h2 id="result-title">Cần hỏi bác sĩ hoặc chuyên gia dinh dưỡng</h2>
      <p>
        Không đủ điều kiện đưa khuyến nghị cá nhân ở v1. Hãy mang theo thông
        tin tăng trưởng, khẩu phần, thuốc và xét nghiệm để được đánh giá phù
        hợp với từng trẻ.
      </p>
      <ul>
        {safeNextSteps.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="prep-panel" aria-labelledby="prep-title">
      <p class="eyebrow">Chuẩn bị thông tin</p>
      <h2 id="prep-title">Nên mang theo khi đi hỏi</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>

  <style is:global>
    .child-nutrition-shell {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 0 44px;
    }

    .child-nutrition-shell section {
      margin-bottom: 18px;
    }

    .hero-panel,
    .notice-panel,
    .situation-panel,
    .result-panel,
    .prep-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .hero-panel {
      background: linear-gradient(135deg, rgba(5, 150, 105, 0.05), rgba(59, 130, 246, 0.05));
    }

    .eyebrow,
    .result-label {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .child-nutrition-shell h1,
    .child-nutrition-shell h2 {
      margin: 0 0 10px;
      line-height: 1.25;
    }

    .child-nutrition-shell h1 {
      font-size: 1.75rem;
    }

    .child-nutrition-shell h2 {
      font-size: 1.16rem;
    }

    .child-nutrition-shell p,
    .child-nutrition-shell li {
      color: var(--ink-secondary);
      line-height: 1.65;
    }

    .child-nutrition-shell p {
      margin: 0;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .situation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .situation-card {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 12px;
      background: var(--bg-soft);
    }

    .situation-card span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: #fff3cd;
      color: #7a4b00;
      font-weight: 900;
    }

    .result-panel {
      border-color: rgba(16, 185, 129, 0.15);
      background: rgba(16, 185, 129, 0.05);
    }

    .result-panel ul,
    .prep-panel ul {
      margin: 10px 0 0;
      padding-left: 20px;
    }

    @media (max-width: 640px) {
      .child-nutrition-shell {
        padding: 12px 0 34px;
      }

      .hero-panel,
      .notice-panel,
      .situation-panel,
      .result-panel,
      .prep-panel {
        padding: 16px;
        border-radius: var(--radius-lg);
      }

      .child-nutrition-shell h1 {
        font-size: 1.45rem;
      }

      .situation-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
