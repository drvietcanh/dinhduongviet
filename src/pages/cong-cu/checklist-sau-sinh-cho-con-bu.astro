---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau sinh và cho con bú";
const desc = "Bảng kiểm ăn uống, vi chất, thuốc và an toàn khi chăm sóc mẹ sau sinh.";
const items = [
  "Tôi ăn đủ bữa, đủ đạm và rau quả, uống theo khát và nhu cầu cho con bú, không ép uống quá mức",
  "Tôi tiếp tục sắt/acid folic/vitamin D hoặc vi chất khác theo hướng dẫn sau sinh",
  "Tôi hỏi bác sĩ/dược sĩ trước khi dùng thuốc giảm cân, thảo dược, rượu bia hoặc thực phẩm bổ sung",
  "Tôi theo dõi chảy máu, sốt, đau đầu/nhìn mờ, đau ngực, khó thở và vết mổ/vết khâu",
  "Tôi nhận hỗ trợ khi đau, thiếu ngủ, khó cho bú, ăn kém hoặc không có người chăm sóc",
  "Tôi biết dấu hiệu trầm cảm sau sinh và có người tin cậy để báo khi buồn bã, tuyệt vọng hoặc có ý nghĩ tự hại",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-sau-sinh-cho-con-bu">
  <main class="postpartum-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm sản khoa</p>
      <h1>🤱 Checklist sau sinh và cho con bú</h1>
      <p>{desc} Không cần kiêng khem cực đoan; ưu tiên bữa ăn đa dạng, nghỉ ngơi và hỗ trợ phù hợp.</p>
    </header>
    <form id="postpartum-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-postpartum /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ y tế ngay khi</h2>
      <p>Chảy máu nhiều, sốt, đau đầu/nhìn mờ, đau ngực/khó thở, đau bụng tăng hoặc có ý nghĩ tự hại/làm hại em bé.</p>
      <p class="warning">Không tự dùng thuốc giảm cân, thuốc an thần, rượu bia hoặc thảo dược khi đang cho con bú.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("postpartum-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-postpartum]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang danh sách thuốc, vi chất và các triệu chứng khi tái khám sau sinh.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ sản khoa, nhi khoa hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .postpartum-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .postpartum-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
