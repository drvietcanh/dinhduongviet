---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist suy giáp và tương tác thuốc–thực phẩm";
const desc = "Bảng kiểm dùng levothyroxine, khoảng cách với thực phẩm bổ sung và theo dõi suy giáp.";
const items = [
  "Tôi uống levothyroxine đúng giờ theo hướng dẫn, nhất quán trước ăn hoặc theo lịch bác sĩ",
  "Tôi giữ khoảng cách phù hợp với sắt, canxi, thuốc kháng acid, đậu nành hoặc chất xơ bổ sung",
  "Tôi báo bác sĩ mọi thuốc mới, vitamin, biotin, thực phẩm bổ sung và thay đổi chế độ ăn lớn",
  "Tôi xét nghiệm TSH/FT4 đúng lịch, đặc biệt sau đổi liều, mang thai hoặc thay đổi cân nặng",
  "Tôi theo dõi mệt, lạnh, táo bón, tăng cân hoặc hồi hộp, run, sụt cân sau đổi thuốc",
  "Tôi không tự dùng iod, rong biển, “thuốc tuyến giáp” hoặc tự tăng/giảm liều",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-suy-giap-thuoc">
  <main class="thyroid-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm nội tiết</p>
      <h1>🦋 Checklist suy giáp và tương tác thuốc</h1>
      <p>{desc} Mục tiêu là dùng thuốc ổn định và đọc đúng xét nghiệm, không tự điều trị theo triệu chứng.</p>
    </header>
    <form id="thyroid-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-thyroid /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần liên hệ bác sĩ khi</h2>
      <p>Hồi hộp/đau ngực, lơ mơ, khó thở, sưng phù tăng, thay đổi triệu chứng rõ sau đổi liều hoặc đang mang thai.</p>
      <p class="warning">Không tự ngừng levothyroxine, tự bổ sung iod/biotin liều cao hoặc đổi nhãn thuốc mà không báo bác sĩ.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("thyroid-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-thyroid]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang kết quả TSH/FT4, danh sách thuốc và thời điểm uống khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ nội tiết hoặc dược sĩ về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .thyroid-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .thyroid-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
