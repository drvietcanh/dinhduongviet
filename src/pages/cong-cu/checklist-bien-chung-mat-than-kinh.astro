---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist biến chứng mắt và thần kinh đái tháo đường";
const desc = "Bảng kiểm theo dõi mắt, cảm giác, an toàn đi lại và chăm sóc hằng ngày ở người đái tháo đường.";
const items = [
  "Tôi biết lịch khám đáy mắt/ võng mạc và báo ngay khi nhìn mờ hoặc ruồi bay mới xuất hiện",
  "Tôi kiểm tra cảm giác tê, bỏng rát, đau hoặc mất cảm giác ở chân",
  "Tôi giữ lối đi đủ sáng, dùng giày dép phù hợp và phòng té ngã",
  "Tôi kiểm tra chân mỗi ngày dù không thấy đau",
  "Tôi ghi đường huyết, hạ đường huyết và thuốc để trao đổi khi tái khám",
  "Tôi biết dấu hiệu thần kinh cấp: yếu liệt, méo miệng, nói khó, lú lẫn",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-bien-chung-mat-than-kinh">
  <main class="complications-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm đái tháo đường</p>
      <h1>👁️ Checklist mắt và thần kinh</h1>
      <p>{desc} Bảng kiểm không thay thế khám mắt, khám thần kinh hoặc đánh giá nguy cơ bàn chân.</p>
    </header>
    <form id="complications-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-complications /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần cấp cứu khi</h2>
      <p>Giảm thị lực đột ngột, đau mắt dữ dội, yếu liệt một bên, méo miệng, nói khó, lú lẫn hoặc mất thăng bằng cấp tính.</p>
      <p class="warning">Không tự lái xe khi nhìn mờ, chóng mặt hoặc có dấu hiệu thần kinh.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("complications-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-complications]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi triệu chứng, đường huyết và lịch khám mắt/thần kinh.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ đái tháo đường, mắt hoặc thần kinh về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .complications-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .complications-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
