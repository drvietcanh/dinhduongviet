---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng và vận động khi thoái hóa khớp";
const desc = "Bảng kiểm cân nặng, vận động và dinh dưỡng hỗ trợ người bệnh thoái hóa khớp.";
const items = [
  "Tôi theo dõi cân nặng và đặt mục tiêu giảm từ từ nếu thừa cân theo hướng dẫn chuyên môn",
  "Tôi vận động ít tác động, tập sức cơ và thăng bằng trong giới hạn đau được cho phép",
  "Tôi ăn đủ đạm, rau quả và thực phẩm giàu canxi; hỏi trước khi dùng vitamin D/canxi bổ sung",
  "Tôi hạn chế đồ uống có đường, rượu bia và chế độ ăn cực đoan gây mất cơ",
  "Tôi rà soát thuốc giảm đau, bệnh dạ dày–thận và báo mọi thực phẩm bổ sung đang dùng",
  "Tôi biết dấu hiệu cần khám: khớp sưng nóng đỏ, sốt, đau tăng nhanh, yếu liệt hoặc té ngã",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-thoai-hoa-khop">
  <main class="oa-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm cơ xương khớp</p>
      <h1>🦴 Checklist thoái hóa khớp</h1>
      <p>{desc} Dinh dưỡng hỗ trợ kiểm soát cân nặng và sức cơ, không thay thế chẩn đoán nguyên nhân đau khớp.</p>
    </header>
    <form id="oa-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-oa /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Khớp sưng nóng đỏ kèm sốt, đau dữ dội sau chấn thương, không chịu lực được, yếu liệt hoặc té ngã nhiều lần.</p>
      <p class="warning">Không tự dùng corticoid, thuốc giảm đau kéo dài, glucosamine hay “thuốc tái tạo sụn” thay khám chuyên khoa.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("oa-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-oa]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký đau, vận động, cân nặng và thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ cơ xương khớp hoặc chuyên gia dinh dưỡng.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .oa-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .oa-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
