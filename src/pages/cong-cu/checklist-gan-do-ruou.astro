---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng khi bệnh gan do rượu";
const desc = "Bảng kiểm ngừng rượu, dinh dưỡng và theo dõi an toàn ở người bệnh gan do rượu.";
const items = [
  "Tôi đã trao đổi kế hoạch ngừng rượu an toàn và biết cai rượu đột ngột có thể cần giám sát y tế",
  "Tôi ăn đều nhiều bữa, đủ năng lượng và đạm theo bác sĩ, không nhịn ăn để “giải độc gan”",
  "Tôi báo bác sĩ mọi thuốc, paracetamol, thảo dược, vitamin hoặc sản phẩm bổ sung đang dùng",
  "Tôi theo dõi cân nặng, vòng bụng, phù, vàng da, lượng ăn và số lần nôn/tiêu chảy",
  "Tôi được đánh giá thiếu vitamin/khoáng chất và dùng bổ sung đúng liều khi có chỉ định",
  "Tôi biết dấu hiệu cấp cứu: run nhiều, co giật, lú lẫn, nôn máu, phân đen, sốt hoặc đau bụng tăng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-gan-do-ruou">
  <main class="alcohol-liver-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm gan mật</p>
      <h1>🍺 Checklist bệnh gan do rượu</h1>
      <p>{desc} Ngừng rượu là nền tảng, nhưng cần hỗ trợ y tế và kế hoạch dinh dưỡng cá thể hóa.</p>
    </header>
    <form id="alcohol-liver-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-alcohol-liver /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần đi khám/cấp cứu khi</h2>
      <p>Run, ảo giác, co giật sau giảm rượu; lú lẫn, nôn máu, phân đen, sốt, vàng da tăng nhanh hoặc đau bụng dữ dội.</p>
      <p class="warning">Không tự cai rượu một mình khi đã uống nhiều/kéo dài, không nhịn ăn và không tự dùng thuốc an thần.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("alcohol-liver-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-alcohol-liver]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký rượu, ăn uống, triệu chứng và thuốc khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ gan mật hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .alcohol-liver-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .alcohol-liver-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
