---
// bang-xep-hang.astro - Bảng sắp xếp dữ liệu dinh dưỡng thực phẩm Việt
import BaseLayout from "../../layouts/BaseLayout.astro";

const CATEGORIES = [
  "Đạm: giảm dần",
  "Năng lượng: tăng dần",
  "Chất xơ: giảm dần",
  "Sắt: giảm dần",
  "Canxi: giảm dần",
  "Vitamin C: giảm dần",
  "Đường: tăng dần",
  "Béo bão hòa: tăng dần",
];

const config = [
  { id: "protein", title: "Đạm trong thực phẩm", key: "proteinG", sort: -1, unit: "g", direction: "giảm dần" },
  { id: "lowcal", title: "Năng lượng trong thực phẩm", key: "energyKcal", sort: 1, unit: "kcal", direction: "tăng dần" },
  { id: "fiber", title: "Chất xơ trong thực phẩm", key: "fiberG", sort: -1, unit: "g", direction: "giảm dần" },
  { id: "iron", title: "Sắt trong thực phẩm", key: "ironMg", sort: -1, unit: "mg", direction: "giảm dần" },
  { id: "calcium", title: "Canxi trong thực phẩm", key: "calciumMg", sort: -1, unit: "mg", direction: "giảm dần" },
  { id: "vitc", title: "Vitamin C trong thực phẩm", key: "vitaminCMg", sort: -1, unit: "mg", direction: "giảm dần" },
  { id: "sugar", title: "Đường trong thực phẩm", key: "sugarG", sort: 1, unit: "g", direction: "tăng dần" },
  { id: "satfat", title: "Béo bão hòa trong thực phẩm", key: "saturatedFatG", sort: 1, unit: "g", direction: "tăng dần" },
];
---

<BaseLayout
  title="Bảng sắp xếp dữ liệu dinh dưỡng thực phẩm - Dinh Dưỡng Việt"
  description="Sắp xếp thực phẩm theo đạm, năng lượng, chất xơ, sắt, canxi, vitamin C, đường và béo bão hòa ở mức dữ liệu tham khảo."
  canonical="/cong-cu/bang-xep-hang"
>
  <style>
    .app-container { max-width: 1100px; margin: 0 auto; padding: 0; }
    .badge { display: inline-block; background: var(--brand-light); color: var(--brand); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; }
    h1 { font-size: clamp(1.5rem, 3.5vw, 2rem); margin: 0 0 8px; }
    .lead { color: var(--ink-secondary); margin-bottom: 18px; font-size: 1.05rem; }

    .safety-shell {
      margin: 0 0 22px;
      padding: 14px 16px;
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: var(--radius-lg);
      background: rgba(59, 130, 246, 0.05);
      color: var(--ink);
    }
    .safety-shell p { margin: 0; font-size: 0.92rem; line-height: 1.55; }
    .safety-shell p + p { margin-top: 8px; }

    section,
    .safety-shell,
    .app-container,
    .rank-card,
    .legend { min-width: 0; max-width: 100%; }

    .rank-nav { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; max-width: 100%; }
    .rank-nav button {
      padding: 8px 14px; border: 1px solid var(--card-border); border-radius: var(--radius);
      background: var(--card); cursor: pointer; font-size: 0.88rem; transition: all var(--transition);
      color: var(--ink); font-weight: 600;
    }
    .rank-nav button:hover { border-color: var(--brand); background: var(--bg-soft); transform: translateY(-1px); }
    .rank-nav button:active { transform: translateY(0); }
    .rank-nav button.active { background: var(--brand); color: white; border-color: var(--brand); }

    .rank-card { display: none; }
    .rank-card.active { display: block; }
    .rank-card h2 { margin-bottom: 4px; }
    .rank-card .rank-note { margin: 0 0 12px; color: var(--ink-secondary); font-size: 0.88rem; }

    .rank-list { border: 1px solid var(--card-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); box-shadow: var(--shadow-sm); }
    .rank-item {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) max-content;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-bottom: 1px solid var(--card-border);
      transition: background var(--transition);
    }
    .rank-item:last-child { border-bottom: 0; }
    .rank-item:hover { background: var(--bg-soft); }

    .rank-num {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.85rem; flex-shrink: 0;
      background: var(--brand-light); color: var(--brand);
    }

    .rank-info { min-width: 0; }
    .rank-name { font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
    .rank-cat { font-size: 0.8rem; color: var(--ink-tertiary); margin-top: 2px; }
    .rank-val { font-weight: 700; font-size: 1.05rem; color: var(--brand); text-align: right; white-space: nowrap; }
    .rank-unit { font-weight: 400; color: var(--ink-tertiary); font-size: 0.85rem; }

    .loading, .empty-state {
      text-align: center;
      padding: 44px 18px;
      color: var(--ink-tertiary);
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      background: var(--card);
    }

    .legend { margin-top: 24px; padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; font-size: 0.85rem; color: var(--ink-secondary); }
    .legend h3 { margin: 0 0 8px; color: var(--ink); }
    .legend ul { margin-bottom: 0; padding-left: 18px; }
    .legend li + li { margin-top: 6px; }

    @media (max-width: 600px) {
      h1 { font-size: 1.45rem; line-height: 1.22; overflow-wrap: anywhere; }
      .lead,
      .safety-shell p,
      .rank-card .rank-note,
      .legend { overflow-wrap: anywhere; }
      .rank-nav button { font-size: 0.8rem; padding: 7px 10px; max-width: 100%; }
      .rank-item { grid-template-columns: 36px minmax(0, 1fr); gap: 10px; }
      .rank-val { grid-column: 2; text-align: left; font-size: 0.95rem; }
    }
  </style>

  <section>
    <span class="badge">Dữ liệu tham khảo</span>
    <h1>Bảng sắp xếp dữ liệu dinh dưỡng</h1>
    <p class="lead">
      Sắp xếp thực phẩm Việt theo từng chỉ số dinh dưỡng ở mức tham khảo, không kết luận thực phẩm tốt hay xấu.
    </p>
  </section>

  <div class="safety-shell">
    <p><strong>Lưu ý:</strong> Đây là bảng sắp xếp dữ liệu dinh dưỡng, không phải công cụ chọn thực phẩm nên ăn hoặc không nên ăn.</p>
    <p>Dữ liệu có thể thay đổi theo giống, phần ăn được, cách chế biến, nhãn sản phẩm và nguồn dữ liệu. Các giá trị hiển thị theo 100g phần ăn được khi dữ liệu có sẵn.</p>
    <p>Người có bệnh nền, đang dùng thuốc, thai kỳ, trẻ em hoặc cần chế độ ăn điều trị nên hỏi bác sĩ hoặc chuyên gia dinh dưỡng trước khi dùng dữ liệu để lên kế hoạch ăn uống.</p>
  </div>

  <div class="app-container" id="rank-app">
    <div class="rank-nav" id="rank-nav" aria-label="Chọn chỉ số dinh dưỡng để sắp xếp">
      {CATEGORIES.map((cat, i) => (
        <button type="button" data-id={config[i].id} class={i === 0 ? "active" : ""}>{cat}</button>
      ))}
    </div>

    <div id="rank-content">
      <div class="loading">Đang tải dữ liệu...</div>
    </div>

    <div class="legend">
      <h3>Ghi chú dữ liệu</h3>
      <ul>
        <li>Danh sách chỉ sắp xếp các thực phẩm có số liệu ở chỉ số đang xem; dữ liệu thiếu được loại khỏi phép sắp xếp thay vì suy đoán là 0.</li>
        <li>Giá trị 0 được giữ như một số liệu thật nếu có trong dữ liệu nguồn.</li>
        <li>Không gọi natri là muối nếu chưa có quy đổi rõ.</li>
        <li>Các nhãn tăng dần/giảm dần chỉ mô tả thứ tự số liệu, không phải đánh giá sức khỏe.</li>
      </ul>
    </div>
  </div>

  <script is:inline define:vars={{ rankConfig: config }}>
    const CATS = Object.freeze(rankConfig);
    const LIMIT = 15;

    const EXCLUDE_LOW_CAL = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống", "Hạt"];
    const EXCLUDE_PROTEIN = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];
    const EXCLUDE_FIBER = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống", "Trứng sữa"];
    const EXCLUDE_IRON = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];
    const EXCLUDE_CALCIUM = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];
    const EXCLUDE_VITC = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];
    const EXCLUDE_LOW_SUGAR = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];
    const EXCLUDE_LOW_SAT = ["Dầu mỡ", "Gia vị", "Nước dùng", "Đồ uống"];

    const EXCLUDE_MAP = {
      protein: EXCLUDE_PROTEIN,
      lowcal: EXCLUDE_LOW_CAL,
      fiber: EXCLUDE_FIBER,
      iron: EXCLUDE_IRON,
      calcium: EXCLUDE_CALCIUM,
      vitc: EXCLUDE_VITC,
      sugar: EXCLUDE_LOW_SUGAR,
      satfat: EXCLUDE_LOW_SAT,
    };

    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function formatValue(value) {
      if (value === null || value === undefined || Number.isNaN(Number(value))) return "—";
      const number = Number(value);
      return Number.isInteger(number) ? String(number) : number.toFixed(1);
    }

    function getRankedFoods(foods, cat) {
      const exclude = EXCLUDE_MAP[cat.id] || [];
      return foods
        .filter((food) => !exclude.includes(food.category))
        .filter((food) => {
          const value = food.nutrients?.[cat.key];
          return value !== undefined && value !== null && Number.isFinite(Number(value)) && Number(value) >= 0;
        })
        .sort((a, b) => cat.sort * (Number(a.nutrients[cat.key]) - Number(b.nutrients[cat.key])))
        .slice(0, LIMIT);
    }

    function renderRankCard(foods, cat, index) {
      const card = el("section", `rank-card${index === 0 ? " active" : ""}`);
      card.dataset.cat = cat.id;

      card.appendChild(el("h2", "", cat.title));
      card.appendChild(el("p", "rank-note", `Danh sách sắp xếp ${cat.direction} theo số liệu ${cat.unit} trên 100g phần ăn được khi dữ liệu có sẵn.`));

      const ranked = getRankedFoods(foods, cat);
      if (!ranked.length) {
        card.appendChild(el("div", "empty-state", "Chưa có dữ liệu cho chỉ số này."));
        return card;
      }

      const list = el("div", "rank-list");
      ranked.forEach((food, itemIndex) => {
        const item = el("div", "rank-item");
        item.appendChild(el("div", "rank-num", String(itemIndex + 1)));

        const info = el("div", "rank-info");
        info.appendChild(el("div", "rank-name", food.name || "Chưa có tên"));
        info.appendChild(el("div", "rank-cat", food.category || "Chưa có nhóm"));
        item.appendChild(info);

        const value = el("div", "rank-val");
        value.append(document.createTextNode(`${formatValue(food.nutrients?.[cat.key])} `));
        value.appendChild(el("span", "rank-unit", cat.unit));
        item.appendChild(value);

        list.appendChild(item);
      });

      card.appendChild(list);
      return card;
    }

    async function init() {
      const content = document.getElementById("rank-content");

      try {
        const res = await fetch("/api-foods.json");
        const foods = await res.json();

        const fragment = document.createDocumentFragment();
        CATS.forEach((cat, index) => {
          fragment.appendChild(renderRankCard(foods, cat, index));
        });
        content.replaceChildren(fragment);
      } catch (error) {
        content.replaceChildren(el("div", "empty-state", "Chưa tải được dữ liệu. Vui lòng thử lại sau."));
      }

      document.getElementById("rank-nav").addEventListener("click", function(e) {
        const btn = e.target.closest("button");
        if (!btn) return;
        document.querySelectorAll("#rank-nav button").forEach((button) => button.classList.remove("active"));
        btn.classList.add("active");
        document.querySelectorAll(".rank-card").forEach((card) => card.classList.remove("active"));
        const card = document.querySelector(`.rank-card[data-cat="${btn.dataset.id}"]`);
        if (card) card.classList.add("active");
      });
    }

    init();
  </script>
</BaseLayout>
