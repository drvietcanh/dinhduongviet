---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng hội chứng ruột kích thích";
const desc = "Bảng kiểm theo dõi triệu chứng và thói quen ăn uống khi nghi IBS.";
const items = [
  "Tôi ghi đau bụng, đầy hơi, số lần và dạng phân cùng món ăn/thời điểm",
  "Tôi ăn đều bữa, nhai chậm và tránh bỏ bữa rồi ăn quá nhiều",
  "Tôi tăng chất xơ hòa tan từ từ và điều chỉnh theo đáp ứng",
  "Tôi nhận diện tác nhân cá nhân thay vì tự kiêng quá nhiều nhóm thực phẩm",
  "Tôi theo dõi stress, giấc ngủ, vận động và chu kỳ triệu chứng",
  "Tôi biết dấu hiệu báo động cần khám để loại trừ bệnh khác",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ruot-kich-thich">
  <main class="ibs-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🌀 Checklist hội chứng ruột kích thích</h1>
      <p>{desc} IBS cần được đánh giá phù hợp; không tự áp dụng chế độ loại trừ nghiêm ngặt kéo dài.</p>
    </header>
    <form id="ibs-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-ibs /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần khám</h2>
      <p>Máu trong phân, sốt, sụt cân, thiếu máu, tiêu chảy về đêm, nôn kéo dài, khởi phát sau tuổi 50 hoặc tiền sử gia đình ung thư đại trực tràng.</p>
      <p class="warning">Không tự dùng kháng sinh, thuốc cầm tiêu chảy hoặc chế độ loại trừ nhiều nhóm khi chưa được đánh giá.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("ibs-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-ibs]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi nhật ký triệu chứng và mang theo khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ tiêu hóa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .ibs-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .ibs-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
