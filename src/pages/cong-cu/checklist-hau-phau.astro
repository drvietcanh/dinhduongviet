---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng sau phẫu thuật";
const desc = "Bảng kiểm cho người bệnh và người chăm sóc khi bắt đầu ăn uống, theo dõi tiêu hóa và hồi phục sau mổ.";
const items = [
  "Tôi đã biết rõ chế độ ăn và tốc độ chuyển từ lỏng sang mềm/rắn do ê-kíp dặn",
  "Mỗi bữa có nguồn đạm phù hợp với loại phẫu thuật và bệnh nền",
  "Tôi chia nhỏ bữa nếu nhanh no hoặc ăn kém, thay vì cố ăn thật nhiều một lần",
  "Tôi theo dõi lượng nước và biết giới hạn riêng nếu bác sĩ yêu cầu hạn chế",
  "Tôi ghi nhận buồn nôn, nôn, tiêu chảy, táo bón hoặc đầy bụng bất thường",
  "Tôi biết số điện thoại/kênh liên hệ khi không ăn uống được hoặc vết mổ xấu đi",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-hau-phau">
  <main class="postop-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chăm sóc</p>
      <h1>🩹 Checklist dinh dưỡng sau phẫu thuật</h1>
      <p>{desc} Mỗi loại mổ có hướng dẫn khác nhau; ưu tiên giấy ra viện và chỉ định của bác sĩ.</p>
    </header>
    <form id="postop-form" class="card">
      <p class="hint">Đánh dấu những điều đã được chuẩn bị hoặc đang theo dõi:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-postop /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Dấu hiệu cần liên hệ sớm</h2>
      <p>Không uống/ăn được, nôn lặp lại, đau bụng tăng, bụng chướng nhanh, sốt, lú lẫn, khó thở, tiểu rất ít, tiêu chảy nhiều hoặc vết mổ đỏ/sưng/chảy dịch bất thường.</p>
      <p class="warning">Không tự dùng sữa bổ sung, men tiêu hóa, thuốc nhuận tràng hay thực phẩm chức năng nếu chưa hỏi ê-kíp điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("postop-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-postop]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi nhật ký ăn uống và triệu chứng để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục nên làm rõ</h2><p>Hãy hỏi điều dưỡng, bác sĩ phẫu thuật hoặc chuyên gia dinh dưỡng trước khi tự thay đổi khẩu phần.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .postop-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .postop-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
