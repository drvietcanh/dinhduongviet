---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng chăm sóc giảm nhẹ";
const desc = "Bảng kiểm ăn uống và kiểm soát triệu chứng theo mục tiêu chăm sóc giảm nhẹ.";
const items = [
  "Tôi đã trao đổi mục tiêu ưu tiên của người bệnh: dễ chịu, tỉnh táo, ăn theo thích hay duy trì sức",
  "Tôi cho ăn/uống lượng nhỏ theo khả năng, không ép khi người bệnh mệt, buồn nôn hoặc không muốn ăn",
  "Tôi chọn món mềm, ẩm, mùi vị quen và chăm sóc miệng để giảm khô miệng/đau rát",
  "Tôi báo đội chăm sóc về đau, buồn nôn, táo bón, tiêu chảy, khó nuốt hoặc khó thở",
  "Tôi hiểu khi nào giảm xét nghiệm, thuốc bổ sung hoặc can thiệp dinh dưỡng không còn phù hợp mục tiêu",
  "Tôi có kế hoạch hỗ trợ người chăm sóc, ghi nhận mong muốn trước của người bệnh và biết nơi liên hệ",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-cham-soc-giam-nhe">
  <main class="palliative-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm chăm sóc toàn diện</p>
      <h1>🕊️ Checklist dinh dưỡng chăm sóc giảm nhẹ</h1>
      <p>{desc} Không có một mục tiêu cân nặng hay khẩu phần bắt buộc cho mọi người bệnh.</p>
    </header>
    <form id="palliative-form" class="card">
      <p class="hint">Đánh dấu những việc đã thống nhất:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-palliative /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần gọi đội chăm sóc khi</h2>
      <p>Đau hoặc khó thở không kiểm soát, nôn nhiều, bứt rứt/lú lẫn mới, không nuốt được thuốc hoặc người chăm sóc kiệt sức.</p>
      <p class="warning">Không ép ăn/uống, tự đặt ống nuôi ăn hoặc tự ngừng thuốc thiết yếu mà chưa trao đổi với đội điều trị.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("palliative-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-palliative]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Ghi lại mục tiêu chăm sóc và số liên hệ để cả gia đình thống nhất.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với đội chăm sóc giảm nhẹ, bác sĩ và người bệnh về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .palliative-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .palliative-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
