    :global(.ti-carb) { font-weight:700; min-width:58px; text-align:right; }
    .total-row { display:flex; justify-content:space-between; font-size:0.94rem; padding:5px 0; gap:16px; }
    .total-carb { font-size:1.25rem; font-weight:800; color:var(--brand); }
