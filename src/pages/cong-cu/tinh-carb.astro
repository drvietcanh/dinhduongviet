      :global(.food-detail) { font-size:0.76rem; }
      :global(.gram-wrap), :global(.food-carb), :global(.food-add) { grid-column:2; justify-self:stretch; }
      :global(.food-carb) { text-align:left; }
      :global(.food-add) { width:100%; }
      :global(.total-item) { grid-template-columns:auto minmax(0,1fr) auto; }
      :global(.ti-share) { grid-column:2 / span 2; text-align:left; }
      .mobile-summary-bar { left:10px; right:10px; bottom:calc(8px + env(safe-area-inset-bottom, 0px)); max-width:520px; margin:0 auto; }
      .msb-main { font-size:0.84rem; }
      .msb-main strong { font-size:0.92rem; }
      .msb-sub { font-size:0.68rem; }
    }
  </style>

  <script>
    import { calculateCarbMeal } from "../../lib/carb-calculator";

    const rawFoods = document.getElementById("carb-food-data")?.textContent || "[]";
    const rawQuickRefs = document.getElementById("carb-quick-ref-data")?.textContent || "[]";
    const foods = JSON.parse(rawFoods);
    const quickRefs = JSON.parse(rawQuickRefs);
    let filteredFoods = foods.slice(0, 80);
    let selected = [];
    let nextId = 0;
    let currentFilter = "all";
    let currentSearch = "";

    function normalize(value) {
      return String(value || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d");
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function formatNumber(value) {
      if (value == null || !Number.isFinite(value)) return "-";
      return Number.isInteger(value) ? String(value) : value.toFixed(1).replace(/\.0$/, "");
    }

    function estimateFoodCarb(food, grams) {
      const result = calculateCarbMeal([{ name: food.name, slug: food.slug, grams, carbPer100g: food.carbPer100g }]);
      return result.items[0]?.carbGrams ?? null;
    }

    function scoreFood(food, normalizedQuery) {
      if (!normalizedQuery) return 0;
      const names = [food.name, ...(food.aliases || [])].map(normalize).filter(Boolean);
      const haystack = normalize([food.name, food.category, food.basis, food.edibleNote, ...(food.aliases || [])].join(" "));
      const tokens = normalizedQuery.split(/\s+/).filter(Boolean);
      if (!tokens.every((token) => haystack.includes(token))) return Number.POSITIVE_INFINITY;
      if (names.some((name) => name === normalizedQuery)) return 0;
      if (names.some((name) => name.startsWith(normalizedQuery))) return 1;
      if (names.some((name) => name.split(/\s+/).some((token) => token === normalizedQuery))) return 2;
      if (names.some((name) => tokens.every((token) => name.split(/\s+/).some((part) => part.startsWith(token))))) return 3;
      if (names.some((name) => name.includes(normalizedQuery))) return 4;
      return 5;
    }

    function renderFoods(list) {
      const el = document.getElementById("food-list");
      if (!el) return;
      if (list.length === 0) {
        el.innerHTML = '<div class="empty-state">Không tìm thấy thực phẩm hoặc món ăn phù hợp.</div>';
        return;
      }
      el.innerHTML = list.slice(0, 80).map((food, idx) => {
        const carb = estimateFoodCarb(food, food.defaultGrams);
        const searchText = [food.name, food.category, food.basis, ...(food.aliases || [])].join(" ");
        return `
          <div class="food-item" data-idx="${idx}" data-search="${escapeHtml(normalize(searchText))}">
            <div class="food-icon">${food.icon}</div>
            <div class="food-info">
              <div class="food-name">${escapeHtml(food.name)}</div>
              <div class="food-detail">
                ${formatNumber(food.carbPer100g)} g carb/100g
                <span class="food-meta">· ${escapeHtml(food.category)} · ${escapeHtml(food.basis || "100g phần ăn được")}</span>
              </div>
            </div>
            <label class="gram-wrap">
              <input class="gram-input" type="number" min="0.1" max="2000" step="1" value="${Math.round(food.defaultGrams)}" aria-label="Khối lượng ${escapeHtml(food.name)}">
              <span class="gram-unit">g</span>
            </label>
            <div class="food-carb">~${formatNumber(carb)} g</div>
            <button class="food-add" type="button">Thêm</button>
          </div>
        `;
      }).join("");

      el.querySelectorAll(".food-item").forEach((item) => {
        const idx = Number(item.getAttribute("data-idx"));
        const food = filteredFoods[idx];
        const input = item.querySelector(".gram-input");
        const carbEl = item.querySelector(".food-carb");
        const addBtn = item.querySelector(".food-add");
        input?.addEventListener("input", () => {
          const grams = Number(input.value);
          const carb = estimateFoodCarb(food, grams);
          carbEl.textContent = carb == null ? "Kiểm tra gram" : `~${formatNumber(carb)} g`;
        });
        addBtn?.addEventListener("click", () => {
          const grams = Number(input?.value);
          selected.push({
            rowId: nextId++,
            foodId: food.id,
            slug: food.slug,
            name: food.name,
            grams,
            carbPer100g: food.carbPer100g,
            sourceConfidence: food.sourceConfidence,
            dataQuality: food.dataQuality,
            icon: food.icon,
          });
          renderTotal();
        });
      });
    }

    function renderTotal() {
      const el = document.getElementById("meal-total");
      const emptyEl = document.getElementById("meal-total-empty");
      const itemsEl = document.getElementById("total-items");
      const carbEl = document.getElementById("total-carb");
      const mobileBar = document.getElementById("mobile-summary-bar");
      const mobileTotalCarb = document.getElementById("mobile-total-carb");
      const mobileItemCount = document.getElementById("mobile-item-count");
      const servingEl = document.getElementById("carb-servings");
      const fillEl = document.getElementById("reference-fill");
      const noteEl = document.getElementById("total-note");
      const warningEl = document.getElementById("warning-list");
      if (!el || !itemsEl || !carbEl || !servingEl || !fillEl || !noteEl || !warningEl) return;

      if (selected.length === 0) {
        el.style.display = "none";
        if (emptyEl) emptyEl.style.display = "flex";
        if (mobileBar) mobileBar.style.display = "none";
        return;
      }
      el.style.display = "block";
      if (emptyEl) emptyEl.style.display = "none";

      const result = calculateCarbMeal(selected);
      carbEl.textContent = `${formatNumber(result.totalCarbGrams)} g`;
      if (mobileTotalCarb) mobileTotalCarb.textContent = `${formatNumber(result.totalCarbGrams)} g carb`;
      if (mobileItemCount) mobileItemCount.textContent = `${selected.length} món`;
      if (mobileBar) mobileBar.style.display = window.innerWidth <= 720 ? "block" : "none";
      servingEl.textContent = `${formatNumber(result.carbServings)} phần carb (${result.carbServingGrams} g/phần)`;

      itemsEl.innerHTML = result.items.map((item, index) => {
        const row = selected[index];
        return `
          <div class="total-item">
            <button class="ti-del" type="button" data-id="${row.rowId}" aria-label="Xóa ${escapeHtml(item.name)}">×</button>
            <span class="ti-name">
              ${escapeHtml(row.icon || "")} ${escapeHtml(item.name)}
              <span class="ti-sub">${formatNumber(item.grams)} g · ${formatNumber(item.carbPer100g)} g carb/100g</span>
            </span>
            <span class="ti-share">${item.contributionPercent == null ? "" : `${formatNumber(item.contributionPercent)}%`}</span>
            <span class="ti-carb">${item.carbGrams == null ? "-" : `${formatNumber(item.carbGrams)} g`}</span>
          </div>
        `;
      }).join("");

      itemsEl.querySelectorAll(".ti-del").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-id"));
          selected = selected.filter((item) => item.rowId !== id);
          renderTotal();
        });
      });

      if (window.innerWidth <= 720) {
        requestAnimationFrame(() => {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }

      fillEl.style.width = `${Math.min(Math.round((result.totalCarbGrams / 60) * 100), 100)}%`;
      if (result.totalCarbGrams >= 45 && result.totalCarbGrams <= 60) {
        noteEl.textContent = "Tổng carb đang nằm trong mốc 45-60 g thường dùng làm ví dụ giáo dục cho một bữa chính ở nhiều người lớn; mục tiêu cá nhân có thể khác.";
      } else if (result.totalCarbGrams > 60) {
        noteEl.textContent = "Tổng carb cao hơn mốc ví dụ 45-60 g. Đây không tự động là sai, nhưng nên xem lại khẩu phần và kế hoạch cá nhân nếu bạn cần kiểm soát đường huyết.";
      } else {
        noteEl.textContent = "Tổng carb thấp hơn mốc ví dụ 45-60 g. Mức phù hợp còn tùy thuốc, vận động, mục tiêu đường huyết và nhu cầu năng lượng.";
      }

      if (result.warnings.length) {
        warningEl.style.display = "block";
        warningEl.innerHTML = result.warnings.map((warning) => `<div>${escapeHtml(warning)}</div>`).join("");
      } else {
        warningEl.style.display = "none";
        warningEl.innerHTML = "";
      }
    }

    function applyFilters() {
      const q = normalize(currentSearch.trim());
      filteredFoods = foods
        .map((food, order) => ({ food, order, score: scoreFood(food, q) }))
        .filter(({ food, score }) => (currentFilter === "all" || food.group === currentFilter) && Number.isFinite(score))
        .sort((a, b) => a.score - b.score || a.food.name.localeCompare(b.food.name, "vi") || a.order - b.order)
        .map(({ food }) => food)
        .slice(0, 80);
      renderFoods(filteredFoods);
    }

    function renderQuickRefs() {
      const body = document.getElementById("quick-ref-body");
      if (!body) return;
      body.innerHTML = quickRefs.map((food) => `
        <tr>
          <td>${escapeHtml(food.name)}</td>
          <td>${escapeHtml(food.basis || food.defaultLabel || "100 g")}</td>
          <td>${formatNumber(food.carbPer100g)} g</td>
          <td>${escapeHtml(food.confidence || "unknown")} · ${escapeHtml(food.source || "")}</td>
        </tr>
      `).join("");
    }

    const search = document.getElementById("food-search");
    search?.addEventListener("input", function () {
      currentSearch = this.value;
      applyFilters();
    });

    const chips = document.querySelectorAll(".filter-chips .chip");
    chips.forEach((chip) => {
      chip.addEventListener("click", function () {
        chips.forEach((item) => item.classList.remove("active"));
        this.classList.add("active");
        currentFilter = this.getAttribute("data-group") || "all";
        applyFilters();
      });
    });

    document.getElementById("reset-btn")?.addEventListener("click", () => {
      selected = [];
      renderTotal();
    });
    document.getElementById("mobile-summary-bar")?.addEventListener("click", () => {
      document.getElementById("meal-total")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    window.addEventListener("resize", renderTotal);

    renderQuickRefs();
    renderFoods(filteredFoods);
    renderTotal();
  </script>
</BaseLayout>
