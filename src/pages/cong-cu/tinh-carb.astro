    .meal-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .meal-head h2 { font-size:1.08rem; margin:0; }
    .total-items { margin-bottom:14px; }
    :global(.total-item) { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid var(--card-border); font-size:0.9rem; }
    :global(.total-item:last-child) { border-bottom:none; }
