    :global(.food-item) { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:12px; padding:13px 16px; background:rgba(255, 255, 255, 0.65); backdrop-filter: blur(16px); border:1px solid rgba(255, 255, 255, 0.5); border-radius:var(--radius-lg); transition:all var(--transition); box-shadow: 0 4px 24px -6px rgba(0,0,0,0.05); }
