    .safety-text-col p:last-child { margin-bottom:0; }
    @media (max-width:720px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.26rem; }
      .page-desc { font-size:0.88rem; line-height:1.55; }
      .section-label { margin:20px 0 10px; font-size:0.88rem; }
      .rec-card { padding:14px 15px; }
      .rec-value { font-size:1.04rem; }
      .rec-note { font-size:0.75rem; }
