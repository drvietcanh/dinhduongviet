    [data-theme="dark"] .rec-card { background: rgba(30, 41, 59, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); }
    .rec-label { font-size:0.8rem; color:var(--ink-secondary); margin-bottom:6px; }
    .rec-value { font-size:1.15rem; font-weight:700; color:var(--brand); }
    .rec-note { font-size:0.78rem; color:var(--ink-tertiary); margin-top:4px; line-height:1.4; }
    .builder { margin-bottom:20px; }
