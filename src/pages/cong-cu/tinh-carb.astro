    .reset-btn { min-height:38px; padding:8px 16px; border:1px solid var(--card-border); border-radius:var(--radius); background:var(--card); color:var(--ink-secondary); font-size:0.85rem; cursor:pointer; transition:all var(--transition); font-family:inherit; }
    .reset-btn:hover { border-color:var(--brand); color:var(--brand); background:var(--card); box-shadow:var(--shadow-sm); }
    .mobile-summary-bar { position:fixed; left:12px; right:12px; bottom:calc(10px + env(safe-area-inset-bottom, 0px)); z-index:40; border:none; border-radius:14px; background:rgba(5,150,105,0.96); color:#fff; padding:10px 12px; box-shadow:0 12px 28px rgba(0,0,0,0.14); text-align:left; display:none; }
    .msb-main { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:0.88rem; }
    .msb-main strong { font-size:0.96rem; }
    .msb-sub { display:block; margin-top:3px; font-size:0.72rem; opacity:0.9; }
    .quick-ref { margin-top:24px; }
    .quick-ref summary { cursor:pointer; font-weight:700; color:var(--ink-secondary); min-height:40px; display:flex; align-items:center; }
    .table-wrap { overflow-x:auto; margin-top:12px; }
    .ref-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
    .ref-table th, .ref-table td { border:1px solid var(--card-border); padding:8px 12px; text-align:left; vertical-align:top; }
    .ref-table th { background:var(--brand-light); font-weight:700; color:var(--brand); }
    .ref-table tr:nth-child(even) { background:var(--bg-soft); }
    .safety-note { display:flex; align-items:flex-start; gap:12px; margin-top:20px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:var(--radius); font-size:0.84rem; line-height:1.6; }
