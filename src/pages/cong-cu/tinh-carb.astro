    :global(.gram-wrap:focus-within) { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }
    :global(.gram-input) { width:74px; min-height:38px; border:none; background:transparent; color:var(--ink); font-size:0.9rem; outline:none; text-align:right; }
    :global(.gram-unit) { color:var(--ink-tertiary); font-size:0.8rem; }
    :global(.food-carb) { min-width:78px; text-align:right; font-weight:800; font-size:0.98rem; color:var(--brand); }
    :global(.food-add) { min-height:40px; padding:8px 16px; border:none; border-radius:var(--radius); background:var(--brand); color:white; font-weight:700; font-size:0.84rem; cursor:pointer; transition:all var(--transition); white-space:nowrap; font-family:inherit; }
    :global(.food-add:hover) { background:var(--brand-dark); transform:translateY(-1px); box-shadow: var(--shadow-sm); }
    :global(.food-add:active) { transform:translateY(0); box-shadow: none; }
    :global(.empty-state) { text-align:center; padding:22px; color:var(--ink-secondary); background:var(--bg-soft); border:1px dashed var(--card-border); border-radius:var(--radius-lg); }
