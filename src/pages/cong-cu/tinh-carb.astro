---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { foods, recipes } from "../../data/nutrition";
import { calculateRecipe } from "../../lib/nutrition";
import { CARB_CONTEXT_NOTE, CARB_GLOBAL_SAFETY_NOTE } from "../../lib/carb-calculator";

const title = "Tính carbohydrate trong bữa ăn";
const desc = "Ước tính tổng carbohydrate từ thực phẩm và món ăn trong dữ liệu Dinh Dưỡng Việt.";

function groupFor(category: string, name: string) {
  const text = `${category} ${name}`.toLowerCase();
  if (text.includes("đồ uống") || text.includes("sữa") || text.includes("trà") || text.includes("cà phê") || text.includes("bia")) return "do-uong";
  if (text.includes("trái cây") || text.includes("quả")) return "trai-cay";
  if (text.includes("bánh") || text.includes("chè") || text.includes("kẹo") || text.includes("đường")) return "banh-keo";
  if (text.includes("tinh bột") || text.includes("gạo") || text.includes("cơm") || text.includes("bún") || text.includes("phở") || text.includes("miến") || text.includes("khoai") || text.includes("ngô") || text.includes("bắp")) return "tinh-bot";
  return "khac";
}

function iconFor(group: string, type: "food" | "recipe") {
  if (type === "recipe") return "🍲";
  if (group === "tinh-bot") return "🍚";
  if (group === "trai-cay") return "🍎";
  if (group === "do-uong") return "🥛";
  if (group === "banh-keo") return "🍪";
  return "🥗";
}

const foodOptions = foods.map((food) => {
  const group = groupFor(food.category, food.name);
  return {
    id: food.id,
    slug: food.slug,
    type: "food" as const,
    name: food.name,
    aliases: food.aliases,
    category: food.category,
    group,
    icon: iconFor(group, "food"),
    carbPer100g: food.nutrients.carbG,
    defaultGrams: 100,
    defaultLabel: "100 g",
    basis: food.basis,
    edibleNote: food.edibleNote,
    source: food.sourceId,
    confidence: food.confidence,
    sourceConfidence: food.sourceConfidence ?? food.confidence,
    dataQuality: food.dataQuality,
    sourceReviewStatus: food.sourceReviewStatus,
    note: food.note,
  };
});

const recipeOptions = recipes.map((recipe) => {
  const nutrients = calculateRecipe(recipe);
  const servingWeight = recipe.servingWeightG || 100;
  const carbPer100g = servingWeight > 0 ? (nutrients.carbG / servingWeight) * 100 : null;
  const group = groupFor("Món ăn", recipe.name);
  return {
    id: `recipe:${recipe.slug}`,
    slug: recipe.slug,
    type: "recipe" as const,
    name: recipe.name,
    aliases: recipe.aliases,
    category: "Món ăn",
    group,
    icon: iconFor(group, "recipe"),
    carbPer100g,
    defaultGrams: servingWeight,
    defaultLabel: recipe.servingName ? `${recipe.servingName} (${servingWeight} g)` : `${servingWeight} g`,
    basis: `1 khẩu phần mẫu ${servingWeight} g`,
    edibleNote: recipe.portionNote ?? "",
    source: recipe.sourceId,
    confidence: recipe.confidence,
    sourceConfidence: recipe.confidence,
    dataQuality: recipe.sourceId === "recipe-estimate-v1" ? "recipe_estimate" : undefined,
    sourceReviewStatus: undefined,
    note: recipe.note,
  };
});

const carbFoods = [...foodOptions, ...recipeOptions]
  .filter((item) => typeof item.carbPer100g === "number" && Number.isFinite(item.carbPer100g) && item.carbPer100g >= 0)
  .sort((a, b) => {
    const groupOrder = ["tinh-bot", "trai-cay", "do-uong", "banh-keo", "khac"];
    const diff = groupOrder.indexOf(a.group) - groupOrder.indexOf(b.group);
    return diff !== 0 ? diff : a.name.localeCompare(b.name, "vi");
  });

const quickSlugs = ["com-trang", "com-gao-lut", "bun-tuoi", "banh-mi", "chuoi", "xoai", "sua-tuoi", "tra-sua"];
const quickRefs = quickSlugs
  .map((slug) => carbFoods.find((item) => item.slug === slug || item.id === slug))
  .filter(Boolean)
  .slice(0, 8);
const carbFoodJson = JSON.stringify(carbFoods).replace(/</g, "\\u003c");
const quickRefJson = JSON.stringify(quickRefs).replace(/</g, "\\u003c");
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/tinh-carb">
  <main class="content-page">
    <div class="page-header">
      <h1><span class="h-icon">🔢</span><span class="h-text">Tính carbohydrate trong bữa ăn</span></h1>
      <p class="page-desc">{desc}</p>
    </div>

    <div class="rec-box" aria-label="Mốc giáo dục về đếm carb">
      <div class="rec-card">
        <div class="rec-label">Quy đổi giáo dục</div>
        <div class="rec-value"><strong>15 g</strong> carb</div>
        <div class="rec-note">thường được gọi là 1 phần carb trong tài liệu giáo dục</div>
      </div>
      <div class="rec-card">
        <div class="rec-label">Ví dụ học đếm carb</div>
        <div class="rec-value"><strong>45-60 g</strong> / bữa</div>
        <div class="rec-note">không phải mục tiêu chung cho mọi người</div>
      </div>
    </div>

    <div class="builder-layout">
      <section class="builder-main">
        <div class="section-label"><span class="sl-num">1</span> Chọn thực phẩm hoặc món ăn</div>
        <div class="builder">
          <div class="builder-top">
            <input id="food-search" type="search" placeholder="Tìm cơm, bún, phở, bánh mì, trái cây, sữa..." class="builder-search cc-input" autocomplete="off" />
            <div class="filter-chips" id="filter-chips">
              <button class="chip active" type="button" data-group="all">Tất cả</button>
              <button class="chip" type="button" data-group="tinh-bot">Tinh bột</button>
              <button class="chip" type="button" data-group="trai-cay">Trái cây</button>
              <button class="chip" type="button" data-group="do-uong">Đồ uống</button>
              <button class="chip" type="button" data-group="banh-keo">Bánh/ngọt</button>
              <button class="chip" type="button" data-group="khac">Khác</button>
            </div>
          </div>
          <div class="food-list" id="food-list"></div>
        </div>
      </section>

      <aside class="builder-side">
        <div class="section-label builder-side-label"><span class="sl-num">2</span> Kết quả bữa ăn</div>
        <div class="meal-total card animate-result" id="meal-total" style="display:none; padding: 20px;">
          <div class="meal-head">
            <h2>Tổng carbohydrate ước tính</h2>
            <button class="reset-btn" id="reset-btn" type="button">Làm lại</button>
          </div>
          <div class="total-items" id="total-items"></div>
          <div class="total-bar">
            <div class="total-row">
              <span>Tổng carb</span>
              <span class="total-carb" id="total-carb">0 g</span>
            </div>
            <div class="total-row">
              <span>Số phần carb ước tính</span>
              <span id="carb-servings">0 phần</span>
            </div>
            <div class="reference-band">
              <div class="reference-fill" id="reference-fill"></div>
            </div>
            <div class="total-note" id="total-note">Mốc 45-60 g chỉ là ví dụ giáo dục, không phải mục tiêu bắt buộc.</div>
          </div>
          <div class="warning-list" id="warning-list" style="display:none;"></div>
        </div>
        <div class="meal-total-empty" id="meal-total-empty">
          <strong>Chưa có món nào</strong>
          <span>Thêm thực phẩm hoặc món ăn để xem tổng carb ngay tại đây.</span>
        </div>
      </aside>
    </div>

    <button class="mobile-summary-bar" id="mobile-summary-bar" type="button" style="display:none;" aria-label="Xem tổng carbohydrate của bữa ăn">
      <span class="msb-main">
        <strong id="mobile-total-carb">0 g</strong>
        <span id="mobile-item-count">0 món</span>
      </span>
      <span class="msb-sub">Chạm để xem</span>
    </button>

    <details class="quick-ref">
      <summary>Bảng tra nhanh từ dữ liệu hiện có</summary>
      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr><th>Mục</th><th>Dữ liệu gốc</th><th>Carb/100g</th><th>Ghi chú</th></tr>
          </thead>
          <tbody id="quick-ref-body"></tbody>
        </table>
      </div>
    </details>

    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        <p>{CARB_GLOBAL_SAFETY_NOTE}</p>
        <p>{CARB_CONTEXT_NOTE}</p>
        <p>Mốc 15 g/phần carb và 45-60 g/bữa chỉ là thông tin giáo dục tùy chọn; mục tiêu cá nhân cần theo thuốc, đường huyết và kế hoạch điều trị.</p>
      </div>
    </div>
  </main>

  <script is:inline id="carb-food-data" type="application/json" set:html={carbFoodJson}></script>
  <script is:inline id="carb-quick-ref-data" type="application/json" set:html={quickRefJson}></script>

  <style>
