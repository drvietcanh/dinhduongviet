---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "🔢 Tính carb (tinh bột) trong bữa ăn";
const desc = "Tính nhanh lượng carb trong cơm, bún, phở, bánh mì, trái cây — so sánh với khuyến nghị cho người tiểu đường.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/tinh-carb">
  <main class="content-page">
    <div class="page-header">
      <h1><span class="h-icon">🔢</span><span class="h-text">Tính carb trong bữa ăn</span></h1>
      <p class="page-desc">{desc}</p>
    </div>

    <!-- Khuyến nghị -->
    <div class="rec-box">
      <div class="rec-card highlight">
        <div class="rec-label">Khuyến nghị cho người tiểu đường</div>
        <div class="rec-value"><strong>45–60g</strong> carb / bữa chính</div>
        <div class="rec-note">~15–20g carb / bữa phụ</div>
      </div>
      <div class="rec-card">
        <div class="rec-label">1 phần tinh bột = 15g carb</div>
        <div class="rec-value">≈ 1 lát bánh mì</div>
        <div class="rec-note">hoặc ⅓ chén cơm, ½ chén cháo</div>
      </div>
    </div>

    <div class="section-label"><span class="sl-num">1</span> Chọn thực phẩm</div>

    <!-- Meal builder -->
    <div class="builder">
      <div class="builder-top">
        <input id="food-search" type="text" placeholder="Tìm thực phẩm (cơm, bún, phở, bánh mì, trái cây...)" class="builder-search">
        <div class="filter-chips" id="filter-chips">
          <button class="chip active" data-group="all">📋 Tất cả</button>
          <button class="chip" data-group="tinh-bot">🍚 Tinh bột</button>
          <button class="chip" data-group="trai-cay">🍎 Trái cây</button>
          <button class="chip" data-group="do-uong">🧋 Đồ uống</button>
          <button class="chip" data-group="banh-keo">🍪 Bánh kẹo</button>
        </div>
      </div>

      <!-- Food list -->
      <div class="food-list" id="food-list"></div>
    </div>

    <!-- Meal total -->
    <div class="section-label"><span class="sl-num">2</span> Kết quả bữa ăn</div>
    <div class="meal-total" id="meal-total" style="display:none;">
      <h2>📊 Tổng bữa ăn của bạn</h2>
      <div class="total-items" id="total-items"></div>
      <div class="total-bar">
        <div class="total-row">
          <span>Tổng carb:</span>
          <span class="total-carb" id="total-carb">0g</span>
        </div>
        <div class="total-row">
          <span>Khuyến nghị bữa chính:</span>
          <span>45–60g</span>
        </div>
        <div class="progress-bg">
          <div class="progress-fill" id="progress-fill" style="width:0%;"></div>
        </div>
        <div class="total-note" id="total-note">Thêm thực phẩm để bắt đầu tính</div>
      </div>
      <button class="reset-btn" id="reset-btn">🔄 Làm lại</button>
    </div>

    <!-- Quick reference table -->
    <details style="margin-top:24px;">
      <summary style="cursor:pointer;font-weight:600;color:var(--ink-secondary);">📖 Bảng tra nhanh carb thực phẩm Việt</summary>
      <div style="overflow-x:auto;margin-top:12px;">
        <table class="ref-table">
          <thead><tr><th>Thực phẩm</th><th>Khẩu phần</th><th>Carb (g)</th><th>Tương đương</th></tr></thead>
          <tbody>
            <tr><td>Cơm trắng</td><td>1 bát con (130g)</td><td>~50g</td><td>3.3 phần tinh bột</td></tr>
            <tr><td>Bún tươi</td><td>1 bát (200g)</td><td>~45g</td><td>3 phần</td></tr>
            <tr><td>Phở</td><td>1 tô (250g)</td><td>~55g</td><td>3.7 phần</td></tr>
            <tr><td>Bánh mì ổ</td><td>1 ổ nhỏ (80g)</td><td>~42g</td><td>2.8 phần</td></tr>
            <tr><td>Miến</td><td>1 bát (200g)</td><td>~50g</td><td>3.3 phần</td></tr>
            <tr><td>Xôi</td><td>1 bát (150g)</td><td>~55g</td><td>3.7 phần</td></tr>
            <tr><td>Khoai lang luộc</td><td>1 củ vừa (150g)</td><td>~35g</td><td>2.3 phần</td></tr>
            <tr><td>Khoai tây luộc</td><td>1 củ vừa (150g)</td><td>~25g</td><td>1.7 phần</td></tr>
            <tr><td>Chuối chín</td><td>1 quả vừa (100g)</td><td>~22g</td><td>1.5 phần</td></tr>
            <tr><td>Xoài chín</td><td>1 quả vừa (200g)</td><td>~30g</td><td>2 phần</td></tr>
            <tr><td>Nước ngọt có gas</td><td>1 lon (330ml)</td><td>~39g</td><td>2.6 phần</td></tr>
            <tr><td>Sữa tươi không đường</td><td>1 ly (200ml)</td><td>~10g</td><td>0.7 phần</td></tr>
          </tbody>
        </table>
      </div>
    </details>

    <!-- Safety note -->
    <div class="safety-note">
      <div class="safety-icon-col">⚠️</div>
      <div class="safety-text-col">
        Đây là ước tính dựa trên dữ liệu thực phẩm Việt Nam (Bộ Y tế). Lượng carb thực tế có thể thay đổi theo cách chế biến, thương hiệu và khẩu phần. Người tiểu đường nên tham khảo ý kiến bác sĩ hoặc chuyên viên dinh dưỡng để điều chỉnh chế độ ăn phù hợp.
      </div>
    </div>
  </main>

  <style>
    .content-page { max-width: 800px; margin:0 auto; padding: 32px 20px; }
    .page-header { text-align:center; margin-bottom:28px; }
    .page-header h1 { display:flex; align-items:center; justify-content:center; gap:12px; margin:0 0 10px; }
    .h-icon { font-size:1.8rem; line-height:1; }
    .h-text { font-size:1.65rem; font-weight:800; letter-spacing:-0.02em; line-height:1.2; }
    .page-desc { max-width:560px; margin:0 auto; color:var(--ink-secondary); font-size:0.92rem; line-height:1.6; }

    .section-label { display:flex; align-items:center; gap:10px; font-weight:700; font-size:0.9rem; margin:24px 0 12px; color:var(--ink); }
    .section-label:first-of-type { margin-top:0; }
    .sl-num { width:28px; height:28px; border-radius:50%; background:var(--brand-light); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.78rem; font-weight:800; flex-shrink:0; }

    .form-card { background:var(--card); border:2px solid var(--line); border-radius:16px; padding:24px; margin-bottom:8px; }
    .form-card:focus-within { border-color:var(--brand); }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; margin-bottom:18px; }
    .form-row label { display:block; font-size:0.82rem; font-weight:600; margin-bottom:5px; color:var(--ink-secondary); }
    .input-wrap { display:flex; align-items:center; background:var(--bg); border:1px solid var(--line); border-radius:10px; }
    .input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 2px rgba(46,125,50,0.1); }
    .input-wrap input, .input-wrap select { flex:1; border:none; background:transparent; padding:11px 12px; font-size:0.92rem; color:var(--ink); outline:none; width:100%; }
    .input-wrap select { appearance:none; -webkit-appearance:none; cursor:pointer; font-weight:500; }
    .input-suffix { padding-right:12px; font-size:0.78rem; color:var(--ink-tertiary); font-weight:500; }
    .stage-wrap { position:relative; }
    .stage-arrow { position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:0.65rem; color:var(--ink-tertiary); pointer-events:none; }

    .btn-calc { width:100%; padding:14px; border:none; border-radius:12px; background:linear-gradient(135deg,#2e7d32,#388e3c); color:white; font-size:1rem; font-weight:700; cursor:pointer; font-family:inherit; box-shadow:0 2px 8px rgba(46,125,50,0.2); }
    .btn-calc:hover { opacity:0.9; transform:translateY(-1px); }

    .card-plain { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:20px; margin-bottom:8px; }

    .safety-note { display:flex; align-items:flex-start; gap:12px; margin-top:20px; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--line-light); border-radius:12px; font-size:0.82rem; line-height:1.6; }
    .safety-icon-col { flex-shrink:0; font-size:1.1rem; }
    .safety-text-col { flex:1; color:var(--ink-secondary); }

    /* Page-specific styles */
    .rec-box { display:flex; gap:14px; margin-bottom:28px; flex-wrap:wrap; justify-content:center; }
    .rec-card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:16px 22px; text-align:center; flex:1; min-width:200px; }
    .rec-card.highlight { border-color:var(--brand); background:var(--brand-light); }
    .rec-label { font-size:0.8rem; color:var(--ink-secondary); margin-bottom:6px; }
    .rec-value { font-size:1.2rem; font-weight:700; color:var(--brand); }
    .rec-note { font-size:0.78rem; color:var(--ink-tertiary); margin-top:4px; }

    .builder { margin-bottom:20px; }
    .builder-top { margin-bottom:14px; }
    .builder-search { width:100%; padding:12px 16px; border:2px solid var(--line); border-radius:12px; background:var(--card); color:inherit; font-size:1rem; box-sizing:border-box; }
    .builder-search:focus { outline:none; border-color:var(--brand); }
    .filter-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
    .chip { padding:6px 14px; border:1px solid var(--line); border-radius:20px; background:var(--card); color:var(--ink-secondary); font-size:0.82rem; cursor:pointer; transition:all 0.15s; font-family:inherit; }
    .chip:hover { border-color:var(--brand); }
    .chip.active { background:var(--brand-light); color:var(--brand); border-color:var(--brand-light2); font-weight:600; }

    .food-list { display:flex; flex-direction:column; gap:6px; }
    .food-item { display:flex; align-items:center; gap:12px; padding:12px 16px; background:var(--card); border:1px solid var(--line); border-radius:12px; transition:all 0.15s; }
    .food-item.hidden { display:none; }
    .food-item:hover { border-color:var(--brand-light2); }
    .food-icon { font-size:1.5rem; }
    .food-info { flex:1; min-width:0; }
    .food-name { font-weight:600; font-size:0.9rem; }
    .food-detail { font-size:0.78rem; color:var(--ink-secondary); }
    .food-portion { text-align:right; min-width:120px; }
    .food-portion select { padding:4px 8px; border:1px solid var(--line); border-radius:8px; background:var(--card); color:var(--ink); font-size:0.82rem; }
    .food-carb { min-width:70px; text-align:right; font-weight:700; font-size:0.95rem; color:var(--brand); }
    .food-add { padding:6px 14px; border:none; border-radius:10px; background:var(--brand); color:white; font-weight:600; font-size:0.82rem; cursor:pointer; transition:all 0.15s; white-space:nowrap; }
    .food-add:hover { opacity:0.85; }
    .food-add:disabled { opacity:0.4; cursor:default; }

    .meal-total { background:var(--card); border:2px solid var(--brand-light2); border-radius:16px; padding:20px; margin-bottom:20px; }
    .meal-total h2 { font-size:1.1rem; margin:0 0 14px; }
    .total-items { margin-bottom:14px; }
    .total-item { display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--line-light); font-size:0.9rem; }
    .total-item:last-child { border-bottom:none; }
    .total-item .ti-del { cursor:pointer; opacity:0.4; font-size:0.9rem; padding:2px 6px; border-radius:4px; }
    .total-item .ti-del:hover { opacity:1; background:var(--bg-soft); }
    .total-item .ti-name { flex:1; }
    .total-item .ti-carb { font-weight:600; min-width:50px; text-align:right; }
    .total-row { display:flex; justify-content:space-between; font-size:0.92rem; padding:4px 0; }
    .total-carb { font-size:1.2rem; font-weight:700; color:var(--brand); }
    .progress-bg { height:10px; background:var(--line); border-radius:6px; margin:12px 0 6px; overflow:hidden; }
    .progress-fill { height:100%; border-radius:6px; background:var(--brand); transition:width 0.3s; }
    .progress-fill.warn { background:#e67e22; }
    .progress-fill.high { background:#c0392b; }
    .total-note { font-size:0.82rem; color:var(--ink-tertiary); text-align:center; }
    .reset-btn { margin-top:12px; padding:8px 20px; border:1px solid var(--line); border-radius:20px; background:var(--card); color:var(--ink-secondary); font-size:0.85rem; cursor:pointer; transition:all 0.15s; font-family:inherit; }
    .reset-btn:hover { border-color:var(--brand); color:var(--brand); }

    .ref-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
    .ref-table th, .ref-table td { border:1px solid var(--line); padding:8px 12px; text-align:left; }
    .ref-table th { background:var(--brand-light); font-weight:700; color:var(--brand); }
    .ref-table tr:nth-child(even) { background:var(--bg-soft); }

    @media (max-width:600px) {
      .content-page { padding:20px 14px; }
      .h-text { font-size:1.25rem; }
      .form-grid { grid-template-columns:1fr; gap:12px; }
    }
  </style>

  <script>
  (function(){
    // Food data: name, icon, base portion in grams, carb per 100g, group, common portions
    var foods = [
      // Tinh bột
      {name:"Cơm trắng",icon:"🍚",portion:130,carb100:39.0,group:"tinh-bot",portions:[{label:"1 bát con (130g)",g:130},{label:"1 bát đầy (200g)",g:200},{label:"1 bát cơm bụi (250g)",g:250}]},
      {name:"Cơm gạo lứt",icon:"🍚",portion:130,carb100:35.0,group:"tinh-bot",portions:[{label:"1 bát con (130g)",g:130},{label:"1 bát đầy (200g)",g:200}]},
      {name:"Bún tươi",icon:"🍜",portion:200,carb100:22.5,group:"tinh-bot",portions:[{label:"1 bát (200g)",g:200},{label:"1 tô lớn (300g)",g:300}]},
      {name:"Phở",icon:"🍜",portion:250,carb100:22.0,group:"tinh-bot",portions:[{label:"1 tô (250g)",g:250},{label:"1 tô đặc biệt (350g)",g:350}]},
      {name:"Bánh mì ổ",icon:"🥖",portion:80,carb100:52.6,group:"tinh-bot",portions:[{label:"1 ổ nhỏ (80g)",g:80},{label:"1 ổ vừa (120g)",g:120},{label:"1 ổ lớn (150g)",g:150}]},
      {name:"Miến",icon:"🍜",portion:200,carb100:25.0,group:"tinh-bot",portions:[{label:"1 bát (200g)",g:200},{label:"1 tô (300g)",g:300}]},
      {name:"Xôi",icon:"🍚",portion:150,carb100:37.0,group:"tinh-bot",portions:[{label:"1 bát (150g)",g:150},{label:"1 đĩa (250g)",g:250}]},
      {name:"Bánh phở",icon:"🍜",portion:200,carb100:31.7,group:"tinh-bot",portions:[{label:"1 bát (200g)",g:200},{label:"1 tô (300g)",g:300}]},
      {name:"Nui",icon:"🍝",portion:200,carb100:30.0,group:"tinh-bot",portions:[{label:"1 bát (200g)",g:200}]},
      {name:"Bánh cuốn",icon:"🫘",portion:150,carb100:25.0,group:"tinh-bot",portions:[{label:"1 đĩa (150g)",g:150},{label:"1 suất (200g)",g:200}]},
      {name:"Bánh đa",icon:"🥟",portion:100,carb100:30.0,group:"tinh-bot",portions:[{label:"1 bát (100g)",g:100}]},
      {name:"Cháo",icon:"🥣",portion:250,carb100:10.0,group:"tinh-bot",portions:[{label:"1 bát (250ml)",g:250},{label:"1 tô (350ml)",g:350}]},
      // Củ
      {name:"Khoai lang luộc",icon:"🍠",portion:150,carb100:23.0,group:"tinh-bot",portions:[{label:"1 củ vừa (150g)",g:150},{label:"1 củ nhỏ (100g)",g:100},{label:"1 củ lớn (200g)",g:200}]},
      {name:"Khoai tây luộc",icon:"🥔",portion:150,carb100:17.0,group:"tinh-bot",portions:[{label:"1 củ vừa (150g)",g:150},{label:"1 củ nhỏ (100g)",g:100}]},
      {name:"Khoai môn",icon:"🧋",portion:100,carb100:25.2,group:"tinh-bot",portions:[{label:"1 miếng (100g)",g:100}]},
      {name:"Sắn luộc",icon:"🫘",portion:150,carb100:36.4,group:"tinh-bot",portions:[{label:"1 củ vừa (150g)",g:150}]},
      {name:"Ngô (bắp) luộc",icon:"🌽",portion:150,carb100:22.0,group:"tinh-bot",portions:[{label:"1 trái vừa (150g)",g:150}]},
      // Trái cây
      {name:"Chuối chín",icon:"🍌",portion:100,carb100:22.0,group:"trai-cay",portions:[{label:"1 quả nhỏ (80g)",g:80},{label:"1 quả vừa (100g)",g:100},{label:"1 quả lớn (130g)",g:130}]},
      {name:"Xoài chín",icon:"🥭",portion:200,carb100:15.0,group:"trai-cay",portions:[{label:"1 quả vừa (200g)",g:200},{label:"1 quả nhỏ (150g)",g:150}]},
      {name:"Thanh long",icon:"🫐",portion:200,carb100:12.0,group:"trai-cay",portions:[{label:"1 quả vừa (200g)",g:200}]},
      {name:"Ổi",icon:"🫑",portion:150,carb100:10.0,group:"trai-cay",portions:[{label:"1 quả vừa (150g)",g:150}]},
      {name:"Đu đủ",icon:"🥝",portion:200,carb100:9.0,group:"trai-cay",portions:[{label:"1 miếng (200g)",g:200}]},
      {name:"Sầu riêng",icon:"🤤",portion:100,carb100:27.0,group:"trai-cay",portions:[{label:"1 múi (100g)",g:100},{label:"2 múi (200g)",g:200}]},
      {name:"Nhãn",icon:"🫐",portion:100,carb100:22.0,group:"trai-cay",portions:[{label:"1 chùm (100g)",g:100}]},
      {name:"Vải",icon:"🫐",portion:100,carb100:20.0,group:"trai-cay",portions:[{label:"1 chùm (100g)",g:100},{label:"1 chùm lớn (200g)",g:200}]},
      {name:"Nho",icon:"🍇",portion:100,carb100:16.0,group:"trai-cay",portions:[{label:"1 chùm (100g)",g:100},{label:"1 chùm lớn (200g)",g:200}]},
      // Đồ uống
      {name:"Nước ngọt có gas",icon:"🥤",portion:330,carb100:12.0,group:"do-uong",portions:[{label:"1 lon (330ml)",g:330},{label:"1 chai (500ml)",g:500}]},
      {name:"Trà sữa",icon:"🧋",portion:500,carb100:9.0,group:"do-uong",portions:[{label:"Size M (500ml)",g:500},{label:"Size L (700ml)",g:700}]},
      {name:"Sữa tươi không đường",icon:"🥛",portion:200,carb100:5.0,group:"do-uong",portions:[{label:"1 ly (200ml)",g:200},{label:"1 hộp (250ml)",g:250}]},
      {name:"Sữa tươi có đường",icon:"🥛",portion:200,carb100:8.0,group:"do-uong",portions:[{label:"1 ly (200ml)",g:200},{label:"1 hộp (250ml)",g:250}]},
      {name:"Nước cam ép",icon:"🧃",portion:200,carb100:11.0,group:"do-uong",portions:[{label:"1 ly (200ml)",g:200}]},
      {name:"Bia",icon:"🍺",portion:330,carb100:3.0,group:"do-uong",portions:[{label:"1 lon (330ml)",g:330},{label:"1 chai (450ml)",g:450}]},
      // Bánh kẹo
      {name:"Bánh bích quy",icon:"🍪",portion:30,carb100:75.0,group:"banh-keo",portions:[{label:"3 cái (30g)",g:30},{label:"5 cái (50g)",g:50}]},
      {name:"Bánh ngọt",icon:"🍰",portion:80,carb100:50.0,group:"banh-keo",portions:[{label:"1 miếng (80g)",g:80},{label:"1 miếng lớn (120g)",g:120}]},
      {name:"Kem",icon:"🍦",portion:100,carb100:25.0,group:"banh-keo",portions:[{label:"1 ly (100g)",g:100}]},
      {name:"Socola",icon:"🍫",portion:30,carb100:60.0,group:"banh-keo",portions:[{label:"1 thanh nhỏ (30g)",g:30},{label:"1 thanh lớn (80g)",g:80}]},
      {name:"Bánh tráng trộn",icon:"🫓",portion:50,carb100:78.0,group:"banh-keo",portions:[{label:"1 túi (50g)",g:50}]},
    ];

    var selected = []; // { name, carb, icon, id }
    var nextId = 0;

    function renderFoods(list) {
      var el = document.getElementById('food-list');
      if (!el) return;
      if (list.length === 0) {
        el.innerHTML = '<div style="text-align:center;padding:20px;color:var(--ink-secondary);">❌ Không tìm thấy thực phẩm phù hợp</div>';
        return;
      }
      el.innerHTML = list.map(function(f, idx) {
        var carbPerPortion = Math.round(f.carb100 * f.portion / 100);
        var portionOpts = f.portions.map(function(p, pi) {
          var carb = Math.round(f.carb100 * p.g / 100);
          return '<option value="' + p.g + '"' + (pi === 0 ? ' selected' : '') + '>' + p.label + ' (~' + carb + 'g carb)</option>';
        }).join('');
        return '<div class="food-item" data-idx="' + idx + '">' +
          '<div class="food-icon">' + f.icon + '</div>' +
          '<div class="food-info">' +
            '<div class="food-name">' + f.name + '</div>' +
            '<div class="food-detail">' + f.carb100 + 'g carb / 100g</div>' +
          '</div>' +
          '<div class="food-portion">' +
            '<select class="portion-select" onchange="window._updateCarb(this, ' + idx + ', ' + f.carb100 + ')">' + portionOpts + '</select>' +
          '</div>' +
          '<div class="food-carb" id="food-carb-' + idx + '">~' + carbPerPortion + 'g</div>' +
          '<button class="food-add" onclick="window._addFood(' + idx + ')">+ Thêm</button>' +
        '</div>';
      }).join('');
    }

    window._updateCarb = function(sel, idx, carb100) {
      var g = parseInt(sel.value);
      var carb = Math.round(carb100 * g / 100);
      var el = document.getElementById('food-carb-' + idx);
      if (el) el.textContent = '~' + carb + 'g';
    };

    window._addFood = function(idx) {
      var f = filteredFoods[idx];
      var sel = document.querySelector('.food-item[data-idx="' + idx + '"] .portion-select');
      var g = sel ? parseInt(sel.value) : f.portion;
      var carb = Math.round(f.carb100 * g / 100);
      selected.push({ id: nextId++, name: f.name, carb: carb, icon: f.icon });
      renderTotal();
    };

    function renderTotal() {
      var el = document.getElementById('meal-total');
      var itemsEl = document.getElementById('total-items');
      var carbEl = document.getElementById('total-carb');
      var fillEl = document.getElementById('progress-fill');
      var noteEl = document.getElementById('total-note');

      if (selected.length === 0) {
        el.style.display = 'none';
        return;
      }
      el.style.display = 'block';

      var total = selected.reduce(function(s, i) { return s + i.carb; }, 0);
      carbEl.textContent = total + 'g';

      itemsEl.innerHTML = selected.map(function(i) {
        return '<div class="total-item">' +
          '<span class="ti-del" onclick="window._removeFood(' + i.id + ')">✕</span>' +
          '<span>' + i.icon + '</span>' +
          '<span class="ti-name">' + i.name + '</span>' +
          '<span class="ti-carb">' + i.carb + 'g</span>' +
        '</div>';
      }).join('');

      var pct = Math.min(Math.round(total / 60 * 100), 100);
      fillEl.style.width = pct + '%';
      fillEl.className = 'progress-fill' + (total > 60 ? ' high' : total > 45 ? ' warn' : '');

      if (total < 30) noteEl.textContent = '✅ Thấp — Bữa nhẹ, hợp lý cho kiểm soát đường huyết';
      else if (total <= 45) noteEl.textContent = '👍 Vừa phải — Bữa ăn nhẹ, phù hợp người ăn kiêng carb';
      else if (total <= 60) noteEl.textContent = '👌 Đạt — Trong khuyến nghị bữa chính (45-60g)';
      else if (total <= 80) noteEl.textContent = '⚠️ Hơi cao — Cân nhắc giảm bớt tinh bột trong bữa này';
      else noteEl.textContent = '🛑 Cao — Bữa này nhiều carb. Thử giảm khẩu phần hoặc chọn thực phẩm ít carb hơn';
    }

    window._removeFood = function(id) {
      selected = selected.filter(function(i) { return i.id !== id; });
      renderTotal();
    };

    // Filter state
    var filteredFoods = foods.slice();
    var currentFilter = 'all';
    var currentSearch = '';

    function applyFilters() {
      filteredFoods = foods.filter(function(f) {
        if (currentFilter !== 'all' && f.group !== currentFilter) return false;
        if (currentSearch) {
          var q = currentSearch.toLowerCase().trim();
          return f.name.toLowerCase().indexOf(q) >= 0;
        }
        return true;
      });
      renderFoods(filteredFoods);
    }

    // Search
    var search = document.getElementById('food-search');
    if (search) {
      search.addEventListener('input', function() {
        currentSearch = this.value;
        applyFilters();
      });
    }

    // Filter chips
    var chips = document.querySelectorAll('.filter-chips .chip');
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        chips.forEach(function(c) { c.classList.remove('active'); });
        this.classList.add('active');
        currentFilter = this.getAttribute('data-group');
        applyFilters();
      });
    });

    // Reset
    var reset = document.getElementById('reset-btn');
    if (reset) {
      reset.addEventListener('click', function() {
        selected = [];
        renderTotal();
      });
    }

    // Init
    renderFoods(foods);
  })();
  </script>
</BaseLayout>
