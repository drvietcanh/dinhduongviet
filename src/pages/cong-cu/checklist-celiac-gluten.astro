---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist bệnh celiac và chế độ không gluten";
const desc = "Bảng kiểm chẩn đoán, đọc nhãn và dinh dưỡng khi cần chế độ không gluten.";
const items = [
  "Tôi đã trao đổi việc xét nghiệm/chẩn đoán trước khi tự loại gluten khỏi khẩu phần",
  "Tôi đọc nhãn và nhận biết nguồn lúa mì, lúa mạch, lúa mạch đen cùng nguy cơ nhiễm chéo",
  "Tôi dùng dụng cụ/bề mặt riêng khi cần và chọn thực phẩm tự nhiên không gluten an toàn",
  "Tôi ăn đủ năng lượng, đạm, chất xơ và theo dõi táo bón/tiêu chảy khi đổi chế độ",
  "Tôi kiểm tra sắt, B12, folate, vitamin D, canxi và bổ sung theo xét nghiệm",
  "Tôi biết dấu hiệu cần khám: sụt cân, mất nước, đau bụng tăng, phù, thiếu máu hoặc phản ứng sau ăn",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-celiac-gluten">
  <main class="celiac-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm tiêu hóa</p>
      <h1>🌾 Checklist celiac và không gluten</h1>
      <p>{desc} Không phải mọi đầy bụng đều là celiac; cần đánh giá chuyên khoa trước khi kiêng nghiêm ngặt.</p>
    </header>
    <form id="celiac-form" class="card">
      <p class="hint">Đánh dấu những việc đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-celiac /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Sụt cân nhanh, tiêu chảy kéo dài, mất nước, phù, thiếu máu nặng hoặc đau bụng dữ dội.</p>
      <p class="warning">Không tự loại gluten trước xét nghiệm nếu chưa hỏi bác sĩ vì có thể làm sai lệch kết quả.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("celiac-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-celiac]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Mang nhật ký triệu chứng, nhãn thực phẩm và kết quả vi chất khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Trao đổi với bác sĩ tiêu hóa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .celiac-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .celiac-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
