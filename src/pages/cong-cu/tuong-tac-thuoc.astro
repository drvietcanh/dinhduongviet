---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Tương tác thuốc | Dinh dưỡng Việt";
const description =
  "Nhắc các tình huống cần hỏi bác sĩ hoặc dược sĩ khi đang dùng thuốc, thực phẩm bổ sung hoặc thay đổi chế độ ăn.";

const riskGroups = [
  "Đang dùng thuốc theo toa hoặc thuốc dùng dài ngày",
  "Dùng nhiều thuốc cùng lúc, gồm cả thực phẩm bổ sung",
  "Thuốc chống đông, thuốc tim mạch, thuốc huyết áp hoặc thuốc lợi tiểu",
  "Thuốc đái tháo đường hoặc thuốc có nguy cơ hạ đường huyết",
  "Thuốc tuyến giáp, thuốc chống động kinh, thuốc ung thư hoặc thuốc giảm đau kháng viêm",
  "Bệnh thận, bệnh gan, bệnh tim mạch, đái tháo đường hoặc ung thư",
  "Đang mang thai, cho con bú, trẻ em, người cao tuổi hoặc người dễ suy kiệt",
  "Có triệu chứng bất thường sau khi dùng thuốc",
];

const prepItems = [
  "Tên thuốc, hàm lượng, số lần dùng trong ngày và thời điểm thường dùng",
  "Thực phẩm bổ sung, thảo dược, vitamin hoặc khoáng chất đang dùng",
  "Bệnh nền, dị ứng thuốc, thai kỳ/cho con bú và triệu chứng mới xuất hiện",
  "Thay đổi gần đây về ăn uống, rượu bia, cà phê, nước ép, sữa hoặc bữa ăn",
];

const situations = [
  ["general", "Chỉ muốn đọc lưu ý chung"],
  ["prescription", "Đang dùng thuốc theo toa"],
  ["many", "Dùng nhiều thuốc cùng lúc"],
  ["blood", "Thuốc chống đông hoặc thuốc tim mạch"],
  ["diabetes", "Thuốc đái tháo đường hoặc đường huyết"],
  ["pressure", "Thuốc huyết áp hoặc thuốc lợi tiểu"],
  ["thyroid", "Thuốc tuyến giáp"],
  ["antibiotic", "Thuốc kháng sinh"],
  ["pain", "Thuốc giảm đau hoặc kháng viêm"],
  ["pregnancy", "Mang thai, cho con bú, trẻ em hoặc người cao tuổi"],
  ["symptom", "Có triệu chứng bất thường sau khi dùng thuốc"],
];
---

<BaseLayout title={title} description={description} canonical="/cong-cu/tuong-tac-thuoc" robots="noindex,follow">
  <main class="drug-safety" aria-labelledby="page-title">
    <section class="hero-panel">
      <p class="eyebrow">Công cụ an toàn v1</p>
      <h1 id="page-title">Tương tác thuốc</h1>
      <p>
        Công cụ này chỉ giúp nhắc các tình huống cần hỏi bác sĩ hoặc dược sĩ.
        Không dùng để tự thay đổi thuốc, liều dùng, lịch dùng thuốc hoặc tự
        kết luận một phối hợp thuốc - thực phẩm là phù hợp cho cá nhân bạn.
      </p>
    </section>

    <section class="notice-panel" aria-labelledby="notice-title">
      <h2 id="notice-title">Khi nào cần hỏi chuyên môn?</h2>
      <p>
        Nếu bạn đang dùng thuốc theo toa, thuốc dùng dài ngày, thuốc chống đông,
        thuốc tim mạch, thuốc huyết áp, thuốc lợi tiểu, thuốc đái tháo đường,
        thuốc tuyến giáp, thuốc chống động kinh, thuốc ung thư, thuốc giảm đau
        kháng viêm, hoặc đang mang thai/cho con bú, hãy hỏi bác sĩ hoặc dược sĩ
        trước khi thay đổi cách dùng thuốc, thực phẩm bổ sung hay chế độ ăn.
      </p>
    </section>

    <section class="check-panel" aria-labelledby="check-title">
      <div class="section-head">
        <p class="eyebrow">Định hướng an toàn</p>
        <h2 id="check-title">Chọn tình huống gần nhất</h2>
        <p>
          V1 không tra cứu tương tác cá nhân, không phân mức nguy cơ và không
          đưa hướng xử trí riêng cho từng thuốc. Kết quả chỉ là lời nhắc để
          chuẩn bị thông tin trước khi hỏi người phụ trách chuyên môn.
        </p>
      </div>

      <form class="safety-form" id="drug-safety-form">
        <label for="situation">Tình huống</label>
        <select id="situation" name="situation">
          {situations.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
        <button type="submit">Xem nhắc nhở</button>
      </form>

      <div class="result-panel" id="safety-result" aria-live="polite">
        <p class="result-label">Định hướng</p>
        <h3>Cần hỏi bác sĩ hoặc dược sĩ</h3>
        <p>
          Không đủ điều kiện đưa kết luận cá nhân ở v1. Hãy mang danh sách thuốc,
          thực phẩm bổ sung và thói quen ăn uống để hỏi người phụ trách chuyên môn.
        </p>
        <ul>
          <li>Không tự thay đổi cách dùng thuốc hoặc liều dùng dựa trên trang này.</li>
          <li>Nếu có triệu chứng bất thường sau khi dùng thuốc, hãy liên hệ cơ sở y tế hoặc người đang theo dõi cho bạn.</li>
        </ul>
      </div>
    </section>

    <section class="risk-panel" aria-labelledby="risk-title">
      <p class="eyebrow">Cờ cần cá thể hóa</p>
      <h2 id="risk-title">Những nhóm nên hỏi trước</h2>
      <div class="risk-grid">
        {riskGroups.map((item) => (
          <article class="risk-card">
            <span aria-hidden="true">!</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="prep-panel" aria-labelledby="prep-title">
      <p class="eyebrow">Chuẩn bị khi đi hỏi</p>
      <h2 id="prep-title">Thông tin nên mang theo</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>
      <p>
        Trang này không thay thế tư vấn chuyên môn và không tạo khuyến nghị
        riêng cho thuốc đang dùng.
      </p>
    </section>
  </main>

  <script is:inline>
    (() => {
      const messages = {
        general: "Hãy dùng trang này như danh sách nhắc việc. Khi có thuốc đang dùng, bệnh nền hoặc thực phẩm bổ sung, cần hỏi bác sĩ hoặc dược sĩ.",
        prescription: "Thuốc theo toa cần được xem cùng bệnh nền, liều dùng, lịch dùng và xét nghiệm liên quan. Hãy hỏi bác sĩ hoặc dược sĩ trước khi đổi chế độ ăn liên quan.",
        many: "Dùng nhiều thuốc cùng lúc làm nguy cơ nhầm lẫn cao hơn. Hãy chuẩn bị đầy đủ tên thuốc, liều dùng và thực phẩm bổ sung để được rà soát.",
        blood: "Nhóm thuốc tim mạch hoặc chống đông cần được cá thể hóa theo hồ sơ đang theo dõi. Trang này không đưa kết luận dùng chung cho từng thuốc.",
        diabetes: "Thuốc đường huyết cần được xem theo bữa ăn, triệu chứng và kế hoạch theo dõi. Hãy hỏi người đang theo dõi nếu muốn đổi chế độ ăn.",
        pressure: "Thuốc huyết áp hoặc lợi tiểu cần xem kèm xét nghiệm, triệu chứng và tình trạng bệnh nền. Không tự thay đổi thuốc dựa trên nội dung này.",
        thyroid: "Thuốc tuyến giáp cần được xem theo lịch dùng thực tế, xét nghiệm và hướng dẫn chuyên môn. Trang này không đưa quy tắc dùng riêng cho cá nhân.",
        antibiotic: "Thuốc kháng sinh cần được dùng theo hướng dẫn chuyên môn và loại thuốc cụ thể. Hãy hỏi bác sĩ hoặc dược sĩ khi có thắc mắc về thức ăn, sữa hoặc thực phẩm bổ sung.",
        pain: "Thuốc giảm đau hoặc kháng viêm có thể liên quan bệnh nền, dạ dày, thận, tim mạch và thuốc đang dùng. Hãy hỏi người phụ trách chuyên môn khi cần thay đổi.",
        pregnancy: "Thai kỳ, cho con bú, trẻ em và người cao tuổi cần được tư vấn riêng theo hồ sơ sức khỏe và thuốc đang dùng.",
        symptom: "Nếu có triệu chứng bất thường sau khi dùng thuốc, hãy liên hệ cơ sở y tế hoặc người đang theo dõi cho bạn.",
      };

      const form = document.getElementById("drug-safety-form");
      const select = document.getElementById("situation");
      const result = document.getElementById("safety-result");

      if (!(form instanceof HTMLFormElement) || !(select instanceof HTMLSelectElement) || !result) {
        return;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const key = select.value;
        const message = messages[key] || messages.general;
        result.innerHTML = `
          <p class="result-label">Định hướng</p>
          <h3>Cần hỏi bác sĩ hoặc dược sĩ</h3>
          <p>${message}</p>
          <ul>
            <li>Không đủ điều kiện đưa kết luận cá nhân ở v1.</li>
            <li>Không tự thay đổi cách dùng thuốc hoặc liều dùng dựa trên trang này.</li>
          </ul>
        `;
      });
    })();
  </script>

  <style is:global>
    .drug-safety {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 0 44px;
    }

    .drug-safety section {
      margin-bottom: 18px;
    }

    .hero-panel,
    .notice-panel,
    .check-panel,
    .risk-panel,
    .prep-panel {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .hero-panel {
      background: linear-gradient(135deg, rgba(5, 150, 105, 0.05), rgba(245, 158, 11, 0.05));
    }

    .eyebrow,
    .result-label {
      margin: 0 0 8px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .drug-safety h1,
    .drug-safety h2,
    .drug-safety h3 {
      margin: 0 0 10px;
      line-height: 1.25;
    }

    .drug-safety h1 {
      font-size: 1.75rem;
    }

    .drug-safety h2 {
      font-size: 1.16rem;
    }

    .drug-safety p,
    .drug-safety li {
      color: var(--ink-secondary);
      line-height: 1.65;
    }

    .drug-safety p {
      margin: 0;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .safety-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      align-items: end;
      margin-bottom: 14px;
    }

    .safety-form label {
      grid-column: 1 / -1;
      font-weight: 800;
      color: var(--ink);
    }

    .safety-form select,
    .safety-form button {
      min-height: 46px;
      border-radius: var(--radius);
      font: inherit;
    }

    .safety-form select {
      width: 100%;
      border: 1px solid var(--card-border);
      background: var(--card);
      color: var(--ink);
      padding: 0 12px;
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    .safety-form select:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .safety-form button {
      border: 0;
      background: var(--brand);
      color: white;
      cursor: pointer;
      font-weight: 800;
      padding: 0 18px;
      transition: all var(--transition);
    }

    .safety-form button:hover {
      background: var(--brand-dark);
      transform: translateY(-1px);
    }

    .safety-form button:active {
      transform: translateY(0);
    }

    .result-panel {
      border: 1px solid rgba(16, 185, 129, 0.15);
      background: rgba(16, 185, 129, 0.05);
      border-radius: var(--radius-lg);
      padding: 16px;
    }

    .result-panel ul,
    .prep-panel ul {
      margin: 10px 0 0;
      padding-left: 20px;
    }

    .risk-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .risk-card {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
      align-items: start;
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 12px;
      background: var(--bg-soft);
    }

    .risk-card span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: #fff3cd;
      color: #7a4b00;
      font-weight: 900;
    }

    .prep-panel p {
      margin-top: 12px;
    }

    @media (max-width: 640px) {
      .drug-safety {
        padding: 12px 0 34px;
      }

      .hero-panel,
      .notice-panel,
      .check-panel,
      .risk-panel,
      .prep-panel {
        padding: 16px;
        border-radius: var(--radius-lg);
      }

      .drug-safety h1 {
        font-size: 1.45rem;
      }

      .safety-form {
        grid-template-columns: 1fr;
      }

      .risk-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
