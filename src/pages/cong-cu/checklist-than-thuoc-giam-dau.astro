---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist bệnh thận và thuốc giảm đau";
const desc = "Bảng kiểm rà soát thuốc giảm đau, mất nước và xét nghiệm khi có nguy cơ tổn thương thận.";
const items = [
  "Tôi ghi đầy đủ tên/liều/tần suất thuốc giảm đau, thuốc cảm và thuốc không kê đơn",
  "Tôi báo bác sĩ nếu dùng ibuprofen, naproxen, diclofenac hoặc NSAID khác kéo dài",
  "Tôi biết creatinine/eGFR và huyết áp gần nhất nếu đang được theo dõi thận",
  "Tôi tránh tự dùng thuốc khi đang nôn, tiêu chảy, sốt/mất nước hoặc uống rượu nhiều",
  "Tôi hỏi trước khi dùng thuốc nam, thực phẩm bổ sung hoặc thuốc cản quang/thủ thuật",
  "Tôi theo dõi phù, tiểu ít, nước tiểu bất thường, buồn nôn hoặc mệt tăng",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-than-thuoc-giam-dau">
  <main class="analgesic-kidney-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm thận–thuốc</p>
      <h1>💊 Checklist thận và thuốc giảm đau</h1>
      <p>{desc} Không tự ngừng thuốc kê đơn; hãy mang toàn bộ danh sách thuốc để bác sĩ đánh giá.</p>
    </header>
    <form id="analgesic-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-analgesic /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần khám sớm khi</h2>
      <p>Tiểu ít rõ, phù/khó thở, đau hông lưng, nôn nhiều, lú lẫn hoặc mệt tăng sau khi dùng thuốc.</p>
      <p class="warning">Không tự “bù nước” quá mức khi có suy tim/thận và không tự đổi sang thuốc nam.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("analgesic-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-analgesic]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi thuốc, huyết áp và lượng tiểu để trao đổi khi tái khám.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ/dược sĩ hoặc chuyên gia thận về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .analgesic-kidney-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .analgesic-kidney-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
