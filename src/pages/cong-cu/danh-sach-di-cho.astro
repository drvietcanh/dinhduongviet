---
// danh-sach-di-cho.astro — Tạo danh sách đi chợ từ món ăn
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Danh sách đi chợ - Dinh Dưỡng Việt">
  <style>
    .app-container { max-width: 1100px; margin: 0 auto; padding: 0; }
    .badge { display: inline-block; background: var(--brand-light); color: var(--brand); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; }
    h1 { font-size: 2rem; margin: 0 0 8px; }
    .lead { color: var(--ink-secondary); margin-bottom: 24px; font-size: 1.1rem; }

    .layout { display: flex; gap: 24px; }
    .recipe-panel { flex: 1; }
    .list-panel { flex: 1; position: sticky; top: 20px; align-self: flex-start; background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-sm); }

    .search-box { margin-bottom: 16px; }
    .search-box input {
      width: 100%; padding: 10px 14px; border: 1px solid var(--card-border); border-radius: var(--radius);
      font-size: 0.95rem; box-sizing: border-box; transition: border-color var(--transition), box-shadow var(--transition);
      background: var(--bg); color: var(--ink);
    }
    .search-box input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15); }

    .recipe-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-bottom: 1px solid var(--line-light); cursor: pointer;
      transition: background var(--transition);
    }
    .recipe-item:hover { background: var(--bg-soft); }
    .recipe-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--brand); cursor: pointer; flex-shrink: 0; }
    .ri-name { font-weight: 600; flex: 1; }
    .ri-calo { color: var(--ink-tertiary); font-size: 0.85rem; white-space: nowrap; }
    .ri-checked { color: var(--brand); }
    .count-badge {
      display: inline-block; background: var(--brand); color: white;
      border-radius: 12px; padding: 2px 10px; font-size: 0.75rem; font-weight: 700;
      margin-left: 6px;
    }

    .recipe-group { margin-bottom: 16px; }
    .group-label { font-weight: 700; color: var(--ink); padding: 8px 12px; background: var(--bg-soft); border-radius: var(--radius); margin-bottom: 6px; font-size: 0.9rem; border: 1px solid var(--card-border); }

    /* Shopping list */
    .list-panel h2 { margin: 0 0 16px; font-size: 1.2rem; display: flex; align-items: center; gap: 8px; color: var(--brand-dark); }
    .empty-list { text-align: center; padding: 40px 20px; color: var(--ink-secondary); background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.15); border-radius: var(--radius-lg); }
    .empty-list .icon { font-size: 2.5rem; margin-bottom: 8px; }

    .list-section { margin-bottom: 20px; }
    .list-section-title {
      font-weight: 700; font-size: 0.95rem; color: var(--brand-dark);
      padding-bottom: 6px; border-bottom: 2px solid var(--card-border); margin-bottom: 8px;
    }
    .list-item {
      display: flex; align-items: center; gap: 8px;
      padding: 8px; border-bottom: 1px solid var(--line-light); font-size: 0.9rem;
    }
    .list-item input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--brand); cursor: pointer; flex-shrink: 0; }
    .li-name { flex: 1; }
    .li-amt { color: var(--ink-tertiary); font-size: 0.85rem; white-space: nowrap; }
    .li-checked { text-decoration: line-through; color: var(--ink-tertiary); }

    .empty-msg { display: none; text-align: center; padding: 20px; color: #999; }
    .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .clear-btn {
      padding: 6px 14px; background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius);
      cursor: pointer; font-size: 0.8rem; color: var(--ink-secondary); font-weight: 600; transition: all var(--transition);
    }
    .clear-btn:hover { background: var(--bg-soft); transform: translateY(-1px); }
    .clear-btn:active { transform: translateY(0); }
    .bridge-actions { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
    .bridge-actions a,
    .bridge-actions button {
      display:inline-flex; align-items:center; gap:6px; padding:8px 12px; border-radius:var(--radius);
      border:1px solid var(--card-border); background:var(--card); color:var(--brand); font-weight:700;
      text-decoration:none; cursor:pointer; font-size:0.86rem;
    }
    .bridge-actions button:hover,
    .bridge-actions a:hover { background:var(--brand-light); border-color:var(--brand); }

    @media (max-width: 768px) {
      .layout { flex-direction: column; }
      .list-panel { position: static; }
    }
  </style>

  <section>
    <span class="badge">🛒 Công cụ</span>
    <h1>Danh sách đi chợ</h1>
    <p class="lead">
      Tạo danh sách nhắc việc đi chợ từ các món bạn chọn, với số lượng nguyên liệu ở mức tham khảo
      để bạn dễ chỉnh lại theo gia đình và kế hoạch nấu ăn thực tế.
    </p>
    <div class="empty-list" style="text-align:left;padding:16px 18px;margin-bottom:24px">
      <p style="margin:0 0 8px"><strong>Lưu ý:</strong> Công cụ này chỉ giúp gom nguyên liệu để nhắc việc đi chợ.</p>
      <p style="margin:0 0 8px">Không kết luận danh sách này đủ chất, cân đối, hay phù hợp cho bệnh nền.</p>
      <p style="margin:0">Hãy kiểm tra dị ứng, hạn dùng, nhãn sản phẩm, điều kiện bảo quản và hỏi bác sĩ hoặc chuyên gia dinh dưỡng nếu bạn cần chế độ ăn điều trị.</p>
    </div>
  </section>

  <div class="app-container" id="shop-app">
    <div class="layout">
      <!-- Recipe selection panel -->
      <div class="recipe-panel">
        <div class="bridge-actions">
          <button type="button" id="load-week-plan">Nạp từ thực đơn tuần</button>
          <a href="/cong-cu/lap-thuc-don-tuan">Lập thực đơn</a>
        </div>
        <div class="search-box">
          <input type="text" id="recipe-search" placeholder="🔍 Tìm món ăn...">
        </div>
        <div id="recipe-list">
          <div style="text-align:center;padding:40px;color:#999">⏳ Đang tải...</div>
        </div>
      </div>

      <!-- Shopping list panel -->
      <div class="list-panel">
        <div class="header-row">
          <h2>🛍️ Danh sách mua</h2>
          <button class="clear-btn" id="clear-btn" style="display:none">🗑️ Xoá hết</button>
        </div>
        <div id="list-content">
          <div class="empty-list">
            <div class="icon">🛒</div>
            <p>Chưa chọn món nào</p>
            <p style="font-size:0.85rem">Chọn món bên trái, danh sách nguyên liệu sẽ hiện ra ở đây</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Data
    let recipes = [];
    let foods = [];
    let selected = new Set();
    const WEEK_PLAN_KEY = "ddv_week_plan_v1";

    const CAT_ORDER = [
      "Rau xanh", "Củ quả", "Nấm", "Trái cây", "Rau gia vị",
      "Thịt", "Cá", "Hải sản", "Thịt chế biến", "Trứng sữa",
      "Tinh bột", "Đậu", "Hạt", "Gia vị", "Dầu mỡ", "Đồ uống", "Nước dùng", "Bánh kẹo"
    ];

    function normalizeText(value) {
      return (value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
    }

    function formatWeight(totalG) {
      if (!Number.isFinite(totalG) || totalG <= 0) {
        return "—";
      }

      return totalG >= 1000
        ? `${(totalG / 1000).toFixed(1)} kg`
        : `${Math.round(totalG)} g`;
    }

    function clearNode(node) {
      node.replaceChildren();
    }

    function buildHintLine(text, center = false) {
      const line = document.createElement("p");
      line.style.marginTop = "16px";
      line.style.fontSize = "0.85rem";
      line.style.color = "#888";
      if (center) line.style.textAlign = "center";
      line.textContent = text;
      return line;
    }

    function renderRecipeEmpty(container, query) {
      clearNode(container);
      const box = document.createElement("div");
      box.style.textAlign = "center";
      box.style.padding = "40px";
      box.style.color = "#999";
      box.textContent = query
        ? `Không tìm thấy món "${query}"`
        : "Chưa có món phù hợp";
      container.appendChild(box);
    }

    function renderListEmpty(content) {
      clearNode(content);
      const wrapper = document.createElement("div");
      wrapper.className = "empty-list";

      const icon = document.createElement("div");
      icon.className = "icon";
      icon.textContent = "🛒";

      const title = document.createElement("p");
      title.textContent = "Chưa chọn món nào";

      const helper = document.createElement("p");
      helper.style.fontSize = "0.85rem";
      helper.textContent = "Chọn món bên trái để tạo danh sách nhắc việc đi chợ ở đây";

      wrapper.append(icon, title, helper);
      content.appendChild(wrapper);
    }

    // Load data
    Promise.all([
      fetch("/api-recipes.json").then(r => r.json()),
      fetch("/api-foods.json").then(r => r.json())
    ]).then(([r, f]) => {
      // Only recipes with ingredients
      recipes = r.filter(rec => rec.ingredients && rec.ingredients.length > 0);
      foods = f;
      maybeLoadWeekPlan();
      renderRecipes();
      updateList();
    }).catch(() => {
      const container = document.getElementById("recipe-list");
      renderRecipeEmpty(container, "");
      container.firstChild.textContent = "Chưa tải được dữ liệu món ăn. Hãy thử tải lại trang.";
    });

    // Render recipe list
    function renderRecipes(filter = "") {
      const q = normalizeText(filter);
      const container = document.getElementById("recipe-list");

      let filtered = q
        ? recipes.filter(r =>
            normalizeText(r.name).includes(q) ||
            (r.aliases && r.aliases.some(a => normalizeText(a).includes(q)))
          )
        : recipes;

      if (!filtered.length) {
        renderRecipeEmpty(container, filter.trim());
        return;
      }

      clearNode(container);

      const groups = {};
      filtered.forEach(r => {
        const letter = r.name.charAt(0).toUpperCase();
        if (!groups[letter]) groups[letter] = [];
        groups[letter].push(r);
      });

      const letters = Object.keys(groups).sort();
      letters.forEach(letter => {
        const group = document.createElement("div");
        group.className = "recipe-group";

        const label = document.createElement("div");
        label.className = "group-label";
        label.append(document.createTextNode(`${letter} `));

        const count = document.createElement("span");
        count.className = "count-badge";
        count.textContent = String(groups[letter].length);
        label.appendChild(count);
        group.appendChild(label);

        groups[letter].forEach(r => {
          const checked = selected.has(r.id);

          const item = document.createElement("label");
          item.className = `recipe-item${checked ? " ri-checked" : ""}`;

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.dataset.id = r.id;
          checkbox.checked = checked;

          const name = document.createElement("span");
          name.className = "ri-name";
          name.textContent = r.name;

          const calo = document.createElement("span");
          calo.className = "ri-calo";
          const kcal = Number.isFinite(r?.nutrients?.energyKcal) ? r.nutrients.energyKcal : "—";
          calo.textContent = `${kcal} kcal`;

          checkbox.addEventListener("change", function() {
            const id = this.dataset.id;
            if (this.checked) {
              selected.add(id);
            } else {
              selected.delete(id);
            }
            updateList();
            renderRecipes(document.getElementById("recipe-search").value);
          });

          item.append(checkbox, name, calo);
          group.appendChild(item);
        });

        container.appendChild(group);
      });
    }

    // Search
    document.getElementById("recipe-search").addEventListener("input", function() {
      renderRecipes(this.value);
    });

    document.getElementById("load-week-plan").addEventListener("click", function() {
      if (loadWeekPlanSelection(true)) {
        renderRecipes(document.getElementById("recipe-search").value);
        updateList();
      }
    });

    function maybeLoadWeekPlan() {
      const params = new URLSearchParams(window.location.search);
      if (params.get("from") === "week-plan") {
        loadWeekPlanSelection(false);
      }
    }

    function loadWeekPlanSelection(showMessage) {
      let plan = null;
      try { plan = JSON.parse(localStorage.getItem(WEEK_PLAN_KEY) || "null"); } catch(e) {}
      if (!plan || !Array.isArray(plan.days)) {
        if (showMessage) alert("Chưa có thực đơn tuần đã lưu. Hãy tạo thực đơn trước.");
        return false;
      }

      const slugs = new Set();
      plan.days.forEach(function(day) {
        (day.recipeSlugs || []).forEach(function(slug) { slugs.add(slug); });
      });
      if (!slugs.size) {
        if (showMessage) alert("Thực đơn tuần chưa có món để tạo danh sách.");
        return false;
      }

      selected.clear();
      recipes.forEach(function(recipe) {
        if (slugs.has(recipe.slug) || slugs.has(recipe.id)) selected.add(recipe.id);
      });
      if (showMessage) alert("Đã nạp " + selected.size + " món từ thực đơn tuần.");
      return selected.size > 0;
    }

    // Build shopping list
    function updateList() {
      const content = document.getElementById("list-content");
      const clearBtn = document.getElementById("clear-btn");

      if (selected.size === 0) {
        renderListEmpty(content);
        clearBtn.style.display = "none";
        return;
      }

      clearBtn.style.display = "";

      // Aggregate ingredients
      const foodMap = {};
      foods.forEach(f => foodMap[f.id] = f);

      const agg = {}; // foodId -> { name, category, totalG, recipes: [] }
      selected.forEach(rid => {
        const rec = recipes.find(r => r.id === rid);
        if (!rec || !rec.ingredients) return;
        rec.ingredients.forEach(ing => {
          if (!agg[ing.foodId]) {
            const food = foodMap[ing.foodId];
            agg[ing.foodId] = {
              name: ing.note || (food ? food.name : ing.foodId),
              category: food ? food.category : "Khác",
              totalG: 0,
              recipes: []
            };
          }
          agg[ing.foodId].totalG += ing.amountG || 0;
          if (!agg[ing.foodId].recipes.includes(rec.name)) {
            agg[ing.foodId].recipes.push(rec.name);
          }
        });
      });

      // Group by category
      const catGroups = {};
      Object.values(agg).forEach(item => {
        const cat = item.category || "Khác";
        if (!catGroups[cat]) catGroups[cat] = [];
        catGroups[cat].push(item);
      });

      clearNode(content);

      const summary = document.createElement("p");
      summary.style.margin = "0 0 12px";
      summary.style.fontSize = "0.9rem";
      summary.style.color = "#555";

      const totalItems = Object.keys(agg).length;
      summary.append(
        document.createTextNode("📋 "),
        Object.assign(document.createElement("strong"), { textContent: String(totalItems) }),
        document.createTextNode(" nguyên liệu tham khảo cho "),
        Object.assign(document.createElement("strong"), { textContent: String(selected.size) }),
        document.createTextNode(" món")
      );

      const shopList = document.createElement("div");
      shopList.id = "shop-list";
      const usedCats = Object.keys(catGroups).filter(c => catGroups[c].length > 0);
      const sortedCats = CAT_ORDER.filter(c => usedCats.includes(c)).concat(usedCats.filter(c => !CAT_ORDER.includes(c)));

      sortedCats.forEach(cat => {
        const items = catGroups[cat].sort((a, b) => a.name.localeCompare(b.name, "vi"));
        const section = document.createElement("div");
        section.className = "list-section";

        const sectionTitle = document.createElement("div");
        sectionTitle.className = "list-section-title";
        sectionTitle.textContent = `${cat} (${items.length})`;
        section.appendChild(sectionTitle);

        items.forEach(item => {
          const amt = formatWeight(item.totalG);
          const tooltip = item.recipes.join(", ");

          const listItem = document.createElement("label");
          listItem.className = "list-item";
          listItem.title = tooltip;

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.addEventListener("change", function() {
            listItem.classList.toggle("li-checked", this.checked);
          });

          const name = document.createElement("span");
          name.className = "li-name";
          name.textContent = item.name;

          const amount = document.createElement("span");
          amount.className = "li-amt";
          amount.textContent = amt;

          listItem.append(checkbox, name, amount);
          section.appendChild(listItem);
        });

        shopList.appendChild(section);
      });

      content.append(summary, shopList);
      content.appendChild(buildHintLine("☑️ Tick vào ô để đánh dấu đã mua", true));
    }

    // Clear all
    document.getElementById("clear-btn").addEventListener("click", function() {
      selected.clear();
      renderRecipes(document.getElementById("recipe-search").value);
      updateList();
    });
  </script>
</BaseLayout>
