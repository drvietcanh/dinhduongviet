---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Sàng lọc nguy cơ suy dinh dưỡng";
const desc = "Công cụ giáo dục giúp nhận diện khi nào người lớn nên được đánh giá dinh dưỡng chuyên môn.";
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/sang-loc-suy-dinh-duong">
  <main class="screening-page">
    <header class="page-header">
      <p class="eyebrow">Sàng lọc giáo dục</p>
      <h1>🔎 Sàng lọc nguy cơ suy dinh dưỡng</h1>
      <p>{desc} Dựa trên các dấu hiệu thường dùng trong khung GLIM; không phải công cụ chẩn đoán.</p>
    </header>

    <form id="screening-form" class="screening-form">
      <section class="form-card">
        <h2>1. Thông tin cơ bản</h2>
        <div class="field-grid">
          <label>Tuổi (năm)<input id="age" type="number" min="18" max="120" required /></label>
          <label>Chiều cao (cm)<input id="height" type="number" min="100" max="230" required /></label>
          <label>Cân nặng hiện tại (kg)<input id="current-weight" type="number" min="20" max="300" step="0.1" required /></label>
          <label>Cân nặng 6 tháng trước (kg)<input id="previous-weight" type="number" min="20" max="300" step="0.1" required /></label>
        </div>
      </section>

      <section class="form-card">
        <h2>2. Ăn uống và bệnh gần đây</h2>
        <label class="choice"><input name="intake" type="checkbox" value="reduced" /> Ăn giảm rõ rệt trong khoảng 1–2 tuần gần đây</label>
        <label class="choice"><input name="intake" type="checkbox" value="absorption" /> Khó nuốt, nôn, tiêu chảy kéo dài hoặc bệnh đường ruột làm giảm hấp thu</label>
        <label class="choice"><input name="inflammation" type="checkbox" /> Đang có bệnh cấp nặng, nhiễm trùng hoặc bệnh mạn có viêm hoạt động</label>
      </section>

      <button class="submit-btn" type="submit">Đánh giá nguy cơ</button>
    </form>

    <section id="result" class="result-card" aria-live="polite" hidden></section>

    <section class="method-card">
      <h2>Cách đọc kết quả</h2>
      <p>GLIM thường cần ít nhất một dấu hiệu hình thái (sụt cân, BMI thấp hoặc giảm khối cơ) và một yếu tố nguyên nhân (giảm ăn/kém hấp thu hoặc viêm). Kết quả tại đây chỉ giúp quyết định có nên trao đổi với nhân viên y tế.</p>
      <p class="warning">Nếu sụt cân nhanh, yếu nhiều, không ăn uống được, nôn kéo dài, khó thở, phù hoặc có bệnh nặng, hãy liên hệ cơ sở y tế sớm.</p>
    </section>
  </main>

  <script>
    const form = document.getElementById("screening-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const age = Number(document.getElementById("age")?.value);
      const height = Number(document.getElementById("height")?.value) / 100;
      const current = Number(document.getElementById("current-weight")?.value);
      const previous = Number(document.getElementById("previous-weight")?.value);
      const bmi = current / (height * height);
      const loss = previous > 0 ? ((previous - current) / previous) * 100 : 0;
      const lowBmi = age >= 70 ? bmi < 20 : bmi < 18.5;
      const weightLoss = loss > 5;
      const etiologic = [...document.querySelectorAll('input[name="intake"]:checked, input[name="inflammation"]:checked')].length > 0;
      const phenotypic = lowBmi || weightLoss;
      const needsReview = phenotypic && etiologic;
      const possibleRisk = phenotypic || etiologic;
      result.hidden = false;
      result.className = `result-card ${needsReview ? "result-high" : possibleRisk ? "result-watch" : "result-low"}`;
      result.innerHTML = `
        <h2>${needsReview ? "Nên được đánh giá dinh dưỡng sớm" : possibleRisk ? "Có dấu hiệu cần theo dõi" : "Chưa thấy dấu hiệu sàng lọc rõ"}</h2>
        <div class="metrics"><span>BMI: <strong>${bmi.toFixed(1)}</strong></span><span>Sụt cân: <strong>${Math.max(0, loss).toFixed(1)}%</strong></span></div>
        <p>${needsReview ? "Bạn có cả dấu hiệu hình thái và yếu tố nguyên nhân. Hãy mang kết quả này đến bác sĩ/chuyên gia dinh dưỡng; không tự dùng sản phẩm bổ sung thay thế đánh giá." : possibleRisk ? "Một số dấu hiệu đang hiện diện. Theo dõi cân nặng, lượng ăn và triệu chứng; nên trao đổi chuyên môn nếu kéo dài hoặc nặng lên." : "Kết quả này không loại trừ suy dinh dưỡng. Nếu bạn vẫn sụt cân, yếu cơ hoặc ăn kém, hãy đi đánh giá trực tiếp."}</p>
        <small>Đây là sàng lọc tham khảo, không phải chẩn đoán GLIM hoàn chỉnh.</small>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>

  <style>
    .screening-page { max-width: 820px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align:center; margin-bottom:22px; }
    .eyebrow { margin:0 0 8px; color:var(--brand); font-weight:800; font-size:.8rem; text-transform:uppercase; }
    h1 { margin:0 0 10px; font-size:1.7rem; }
    h2 { margin:0 0 10px; font-size:1.1rem; }
    p { color:var(--ink-secondary); line-height:1.6; }
    .screening-form { display:grid; gap:14px; }
    .form-card, .result-card, .method-card { padding:20px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:var(--card); box-shadow:var(--shadow-sm); }
    .field-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    label { display:grid; gap:6px; color:var(--ink); font-weight:700; }
    input[type="number"] { min-height:42px; border:1px solid var(--card-border); border-radius:var(--radius); background:var(--bg); color:var(--ink); padding:9px; font:inherit; }
    .choice { display:flex; grid-template-columns:none; align-items:flex-start; gap:9px; margin:10px 0; font-weight:500; line-height:1.5; }
    .choice input { margin-top:4px; accent-color:var(--brand); }
    .submit-btn { min-height:46px; border:0; border-radius:var(--radius); background:var(--brand); color:#fff; font:inherit; font-weight:800; cursor:pointer; }
    .result-card { margin-top:16px; }
    .result-card h2 { color:var(--brand); }
    .result-high { border-color:#e07a5f; background:#fff7f3; }
    .result-watch { border-color:#d6a84f; background:#fffaf0; }
    .result-low { border-color:var(--brand-light2); }
    .metrics { display:flex; gap:16px; flex-wrap:wrap; margin:12px 0; color:var(--ink-secondary); }
    .result-card small { color:var(--ink-tertiary); }
    .warning { color:#a3432d; font-weight:700; }
    .method-card { margin-top:16px; }
    @media (max-width:650px) { .screening-page { padding:22px 14px 42px; } .field-grid { grid-template-columns:1fr; } h1 { font-size:1.4rem; } }
  </style>
</BaseLayout>
