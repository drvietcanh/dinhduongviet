---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Checklist dinh dưỡng ung thư tụy";
const desc = "Bảng kiểm nhận diện kém hấp thu, sụt cân và chuẩn bị trao đổi về enzyme tụy.";
const items = [
  "Tôi ghi cân nặng, lượng ăn, số lần đi ngoài và đặc điểm phân (nhờn, nổi, khó xả)",
  "Tôi đã hỏi bác sĩ về suy tụy ngoại tiết và enzyme tụy nếu có chỉ định",
  "Tôi duy trì đạm/năng lượng và không tự kiêng chất béo hoàn toàn",
  "Tôi chia nhỏ bữa, ăn món dễ dung nạp và theo dõi buồn nôn/đầy bụng",
  "Tôi theo dõi đường huyết và vàng da theo kế hoạch điều trị",
  "Tôi biết dấu hiệu cần gọi đội điều trị: nôn, đau tăng, mất nước hoặc sụt cân nhanh",
];
---

<BaseLayout title={title} description={desc} canonical="/cong-cu/checklist-ung-thu-tuy">
  <main class="pancreas-page">
    <header class="page-header">
      <p class="eyebrow">Bảng kiểm ung bướu–tiêu hóa</p>
      <h1>🟡 Checklist dinh dưỡng ung thư tụy</h1>
      <p>{desc} Kém hấp thu cần được đánh giá; không tự mua enzyme hoặc thực phẩm bổ sung.</p>
    </header>
    <form id="pancreas-form" class="card">
      <p class="hint">Đánh dấu những điều đã chuẩn bị:</p>
      {items.map((item) => <label class="check"><input type="checkbox" data-pancreas /> <span>{item}</span></label>)}
      <button type="submit">Xem tổng hợp</button>
    </form>
    <section id="result" class="card result" aria-live="polite" hidden></section>
    <section class="card warning-card">
      <h2>Cần báo đội điều trị</h2>
      <p>Đau bụng tăng, nôn dai dẳng, tiêu phân mỡ nhiều, vàng da tăng, sốt, lơ mơ, tiểu ít hoặc không ăn uống được.</p>
      <p class="warning">Không tự tăng enzyme tụy, steroid, thuốc giảm đau hoặc kiêng chất béo nghiêm ngặt.</p>
    </section>
  </main>
  <script is:inline define:vars={{ total: items.length }}>
    const form = document.getElementById("pancreas-form");
    const result = document.getElementById("result");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const done = document.querySelectorAll("[data-pancreas]:checked").length;
      const missing = total - done;
      result.hidden = false;
      result.innerHTML = missing === 0
        ? `<h2>Đã rà đủ ${total} mục</h2><p>Tiếp tục ghi cân nặng, phân và triệu chứng để trao đổi ở lần khám kế tiếp.</p>`
        : `<h2>Còn ${missing} mục cần làm rõ</h2><p>Hỏi bác sĩ ung bướu/tiêu hóa hoặc chuyên gia dinh dưỡng về phần còn thiếu.</p>`;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
  <style>
    .pancreas-page { max-width: 760px; margin: 0 auto; padding: 32px 18px 52px; }
    .page-header { text-align: center; margin-bottom: 22px; }
    .eyebrow { margin: 0 0 8px; color: var(--brand); font-weight: 800; font-size: .8rem; text-transform: uppercase; }
    h1 { margin: 0 0 10px; font-size: 1.75rem; } h2 { margin: 0 0 10px; font-size: 1.1rem; }
    p { color: var(--ink-secondary); line-height: 1.6; }
    .card { padding: 20px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-sm); }
    .hint { margin-top: 0; font-weight: 700; }
    .check { display: flex; align-items: flex-start; gap: 10px; margin: 13px 0; color: var(--ink); line-height: 1.5; }
    .check input { margin-top: 4px; accent-color: var(--brand); }
    button { width: 100%; min-height: 46px; margin-top: 8px; border: 0; border-radius: var(--radius); background: var(--brand); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
    .result, .warning-card { margin-top: 16px; } .result h2 { color: var(--brand); }
    .warning { color: #a3432d; font-weight: 700; }
    @media (max-width: 650px) { .pancreas-page { padding: 22px 14px 42px; } h1 { font-size: 1.45rem; } }
  </style>
</BaseLayout>
