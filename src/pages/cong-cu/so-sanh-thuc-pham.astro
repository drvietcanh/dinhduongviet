---
// so-sanh-thuc-pham.astro — So sánh dinh dưỡng thực phẩm
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="So sánh dinh dưỡng thực phẩm - Dinh Dưỡng Việt">
  <style>
    .app-container { max-width: 1100px; margin: 0 auto; padding: 0; }
    .badge { display: inline-block; background: var(--bg-success); color: var(--brand); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 12px; }
    h1 { font-size: 2rem; margin: 0 0 8px; }
    .lead { color: var(--ink-secondary); margin-bottom: 12px; font-size: 1.05rem; line-height: 1.6; }
    .safety-shell {
      margin: 0 0 24px;
      padding: 14px 16px;
      border-radius: 12px;
      background: var(--bg-soft);
      border: 1px solid var(--line);
      color: var(--ink-secondary);
      font-size: 0.94rem;
      line-height: 1.65;
    }
    .safety-shell strong { color: var(--ink); }

    .search-box { position: relative; margin-bottom: 24px; }
    .search-box input {
      width: 100%; padding: 12px 16px; border: 2px solid var(--line); border-radius: 12px;
      font-size: 1rem; box-sizing: border-box; transition: border-color .2s;
    }
    .search-box input:focus { outline: none; border-color: #2e7d32; }

    .slot-container { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
    .slot {
      flex: 1; min-width: 160px; max-width: 250px; position: relative;
      background: var(--bg-highlight); border: 2px dashed #ccc; border-radius: 12px;
      padding: 40px 12px; text-align: center; transition: all .2s; cursor: pointer;
      min-height: 80px; display: flex; align-items: center; justify-content: center;
    }
    .slot.filled { border-style: solid; border-color: #2e7d32; background: var(--card-hover); }
    .slot .placeholder { color: var(--ink-tertiary); font-size: 0.9rem; }
    .slot .food-name { font-weight: 700; font-size: 1.05rem; color: #1b5e20; }
    .slot .remove-btn {
      position: absolute; top: 6px; right: 8px; background: none; border: none;
      color: #c62828; cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 2px 6px;
    }
    .slot .remove-btn:hover { color: #b71c1c; }

    .suggestions {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 100;
      background: var(--card); border: 1px solid var(--line); border-radius: 0 0 12px 12px;
      max-height: 320px; overflow-y: auto; display: none; box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }
    .suggestions.open { display: block; }
    .suggestion-item {
      padding: 10px 16px; cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; gap: 12px; border-bottom: 1px solid var(--line-light);
    }
    .suggestion-item:hover,
    .suggestion-item.is-active { background: #eef5ef; }
    .suggestion-item .s-name { font-weight: 500; }
    .suggestion-item .s-cat { font-size: 0.8rem; color: var(--ink-tertiary); text-align: right; }
    .suggestion-empty { color: #999; cursor: default; }

    .compare-area { margin-top: 24px; }
    .compare-table-wrap { overflow-x: auto; }
    .compare-table {
      width: 100%; border-collapse: separate; border-spacing: 0;
      border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06);
      min-width: 640px;
    }
    .compare-table th, .compare-table td {
      padding: 10px 14px; text-align: center; border-bottom: 1px solid #f0f0f0;
      vertical-align: top;
    }
    .compare-table thead th {
      background: #2e7d32; color: white; font-weight: 600;
      font-size: 0.95rem;
    }
    .compare-table thead th:first-child { text-align: left; }
    .compare-table tbody td:first-child {
      text-align: left; font-weight: 500; color: var(--ink);
      background: #fafafa; min-width: 160px;
    }
    .compare-table tbody tr:hover td:first-child { background: #f0f4f0; }
    .compare-table tbody tr:last-child td { border-bottom: none; }

    .section-label { font-weight: 700; background: #e8f5e9 !important; color: #1b5e20; }
    .metric-unit { color: var(--ink-tertiary); font-weight: 400; font-size: 0.85rem; }
    .value-main { display: block; font-weight: 600; color: var(--ink); }
    .value-main.is-higher { color: #1f4fa3; }
    .value-main.is-lower { color: #5b6472; }
    .value-note { display: block; margin-top: 4px; font-size: 0.78rem; color: var(--ink-tertiary); }

    .compare-note {
      margin-top: 12px; font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.6;
    }

    .empty-state { text-align: center; padding: 60px 20px; color: #999; }
    .empty-state .icon { font-size: 3rem; margin-bottom: 12px; }

    .add-more { display: inline-block; margin-top: 8px; }
    .add-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 20px; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9;
      border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 0.9rem;
    }
    .add-btn:hover { background: #c8e6c9; }
    .add-btn.disabled { opacity: .4; cursor: not-allowed; }

    @media (max-width: 700px) {
      h1 { font-size: 1.55rem; }
      .lead { font-size: 0.98rem; }
      .slot { min-width: 140px; max-width: none; }
      .compare-table { min-width: 580px; }
    }
  </style>

  <section>
    <span class="badge">🔬 Công cụ</span>
    <h1>So sánh dinh dưỡng thực phẩm</h1>
    <p class="lead">
      Chọn 2–4 thực phẩm để so sánh thành phần dinh dưỡng ở mức dữ liệu tham khảo. Công cụ này chỉ giúp nhìn khác biệt số liệu giữa các thực phẩm, không thay thế tư vấn chuyên môn hay quyết định chế độ ăn cá thể hóa.
    </p>
    <p class="safety-shell">
      <strong>Ghi chú dữ liệu:</strong> Số liệu trong v1 chủ yếu hiển thị theo <strong>100g phần ăn được</strong>. Nếu có quy đổi gram, đó chỉ là quy đổi tham khảo. Không dùng công cụ này để tự quyết định chế độ ăn điều trị hoặc tự chỉnh thuốc, insulin, lợi tiểu. Nếu bạn có đái tháo đường, bệnh thận, tăng huyết áp, gout, suy tim, đang dùng thuốc, đang mang thai, là trẻ em hoặc người cao tuổi, hãy hỏi bác sĩ hoặc chuyên gia dinh dưỡng khi cần cá thể hóa.
    </p>
  </section>

  <div class="app-container" id="compare-app">
    <div class="search-box" style="position:relative">
      <input type="text" id="food-search" placeholder="🔍 Tìm thực phẩm... (ví dụ: thịt heo, trứng gà, nước mắm)" autocomplete="off">
      <div class="suggestions" id="suggestions"></div>
    </div>

    <div class="slot-container" id="slot-container"></div>

    <div class="compare-area" id="compare-area">
      <div class="empty-state" id="empty-state">
        <div class="icon">🥗</div>
        <p>Chọn ít nhất 2 thực phẩm để xem bảng so sánh dữ liệu.</p>
      </div>
      <div id="table-area" style="display:none"></div>
    </div>
  </div>

  <script>
    let foods = [];
    let selected = [];
    let currentMatches = [];
    let currentFocus = -1;
    const MAX_SLOTS = 4;

    const NUTRIENTS = [
      { key: "energyKcal", label: "Năng lượng", unit: "kcal", lower: false },
      { key: "proteinG", label: "Đạm", unit: "g", lower: false },
      { key: "carbG", label: "Glucid", unit: "g", lower: false },
      { key: "fatG", label: "Chất béo", unit: "g", lower: false },
      { key: "saturatedFatG", label: "Béo bão hòa", unit: "g", lower: false },
      { key: "fiberG", label: "Chất xơ", unit: "g", lower: false },
      { key: "sugarG", label: "Đường", unit: "g", lower: false },
      { key: "cholesterolMg", label: "Cholesterol", unit: "mg", lower: false },
      { key: "sodiumMg", label: "Natri", unit: "mg", lower: false },
      { key: "potassiumMg", label: "Kali", unit: "mg", lower: false },
      { key: "calciumMg", label: "Canxi", unit: "mg", lower: false },
      { key: "ironMg", label: "Sắt", unit: "mg", lower: false },
      { key: "zincMg", label: "Kẽm", unit: "mg", lower: false },
      { key: "phosphorusMg", label: "Phốt pho", unit: "mg", lower: false },
      { key: "vitaminCMg", label: "Vitamin C", unit: "mg", lower: false },
      { key: "vitaminAUg", label: "Vitamin A", unit: "µg", lower: false },
      { key: "folateUg", label: "Folate (B9)", unit: "µg", lower: false },
    ];

    const text = {
      noSuggestion: "Không tìm thấy thực phẩm phù hợp",
      minTwo: "Chọn ít nhất 2 thực phẩm để xem bảng so sánh dữ liệu.",
    };

    const searchInput = document.getElementById("food-search");
    const suggestionsEl = document.getElementById("suggestions");
    const slotContainer = document.getElementById("slot-container");
    const compareArea = document.getElementById("compare-area");
    const emptyState = document.getElementById("empty-state");
    const tableArea = document.getElementById("table-area");

    function createNode(tag, className, textValue) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (textValue !== undefined && textValue !== null) node.textContent = textValue;
      return node;
    }

    function normalizeText(value) {
      return String(value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d")
        .replace(/Đ/g, "D")
        .toLowerCase()
        .trim();
    }

    async function loadData() {
      const res = await fetch("/api-foods.json");
      const raw = await res.json();
      foods = raw.sort((a, b) => a.name.localeCompare(b.name, "vi"));
      renderSlots();
    }

    function getNut(food, key) {
      const val = food?.nutrients?.[key];
      return (val === undefined || val === null) ? null : val;
    }

    function getGlycemicLoad(food) {
      const n = food?.nutrients;
      if (!n) return null;
      return (n.glycemicIndex != null && n.carbG != null)
        ? Math.round(n.glycemicIndex * n.carbG / 100)
        : null;
    }

    function formatVal(v) {
      if (v === null || v === undefined) return "—";
      return Number.isInteger(v) ? String(v) : v.toFixed(1);
    }

    function getSection(key) {
      if (["energyKcal"].includes(key)) return "⚡ Năng lượng";
      if (["proteinG", "carbG", "fatG", "saturatedFatG", "fiberG", "sugarG"].includes(key)) return "🥩 Thành phần đa lượng";
      if (["cholesterolMg", "sodiumMg", "potassiumMg"].includes(key)) return "🧂 Khoáng đa lượng";
      if (["calciumMg", "ironMg", "zincMg", "phosphorusMg"].includes(key)) return "🦴 Vi khoáng";
      return "🍊 Vitamin";
    }

    function addFood(food) {
      if (!food || selected.length >= MAX_SLOTS) return;
      if (selected.find((s) => s.id === food.id)) return;
      selected.push(food);
      searchInput.value = "";
      currentMatches = [];
      closeSuggestions();
      renderSlots();
      renderComparison();
    }

    function removeFood(idx) {
      selected.splice(idx, 1);
      renderSlots();
      renderComparison();
    }

    function renderSlots() {
      slotContainer.replaceChildren();
      for (let i = 0; i < MAX_SLOTS; i++) {
        const slot = createNode("div", "slot" + (selected[i] ? " filled" : ""));
        if (selected[i]) {
          const name = createNode("span", "food-name", selected[i].name);
          const removeBtn = createNode("button", "remove-btn", "✕");
          removeBtn.type = "button";
          removeBtn.setAttribute("aria-label", "Xóa");
          removeBtn.addEventListener("click", () => removeFood(i));
          slot.appendChild(name);
          slot.appendChild(removeBtn);
        } else {
          const placeholder = createNode("span", "placeholder", i === 0 ? "Chọn thực phẩm..." : "...");
          slot.appendChild(placeholder);
        }
        slotContainer.appendChild(slot);
      }

      let addMore = slotContainer.parentNode.querySelector(".add-more");
      if (!addMore) {
        addMore = createNode("div", "add-more");
        slotContainer.parentNode.appendChild(addMore);
      }
      addMore.replaceChildren();
      const canAdd = selected.length > 0 && selected.length < MAX_SLOTS;
      if (canAdd) {
        const btn = createNode("button", "add-btn", "＋ Thêm thực phẩm");
        btn.type = "button";
        btn.addEventListener("click", () => searchInput.focus());
        addMore.appendChild(btn);
      } else if (selected.length >= MAX_SLOTS) {
        addMore.appendChild(createNode("span", "add-btn disabled", `✓ Đã đủ ${MAX_SLOTS} thực phẩm`));
      }
    }

    function setSuggestionActive() {
      const items = suggestionsEl.querySelectorAll(".suggestion-item[data-index]");
      items.forEach((item, index) => {
        item.classList.toggle("is-active", index === currentFocus);
      });
    }

    function closeSuggestions() {
      suggestionsEl.classList.remove("open");
      suggestionsEl.replaceChildren();
      currentFocus = -1;
    }

    function buildHighlightedName(name) {
      const frag = document.createDocumentFragment();
      frag.appendChild(document.createTextNode(name));
      return frag;
    }

    function renderSuggestions(matches, query) {
      suggestionsEl.replaceChildren();
      if (!matches.length) {
        const empty = createNode("div", "suggestion-item suggestion-empty", text.noSuggestion);
        suggestionsEl.appendChild(empty);
        suggestionsEl.classList.add("open");
        currentFocus = -1;
        return;
      }

      matches.forEach((food, index) => {
        const item = createNode("div", "suggestion-item");
        item.dataset.id = food.id;
        item.dataset.index = String(index);

        const nameSpan = createNode("span", "s-name");
        nameSpan.appendChild(buildHighlightedName(food.name));

        const catSpan = createNode("span", "s-cat", food.category || "");
        item.appendChild(nameSpan);
        item.appendChild(catSpan);
        item.addEventListener("click", () => addFood(food));
        suggestionsEl.appendChild(item);
      });

      suggestionsEl.classList.add("open");
      currentFocus = -1;
    }

    function getMatches(query) {
      const q = normalizeText(query);
      if (!q) return [];
      const selectedIds = new Set(selected.map((s) => s.id));
      return foods.filter((f) => {
        if (selectedIds.has(f.id)) return false;
        const aliases = Array.isArray(f.aliases) ? f.aliases : [];
        return normalizeText(f.name).includes(q) || aliases.some((a) => normalizeText(a).includes(q));
      }).slice(0, 10);
    }

    searchInput.addEventListener("input", function() {
      currentMatches = getMatches(this.value);
      if (!this.value.trim()) {
        closeSuggestions();
        return;
      }
      renderSuggestions(currentMatches, this.value);
    });

    document.addEventListener("click", function(e) {
      if (!e.target.closest(".search-box")) closeSuggestions();
    });

    searchInput.addEventListener("keydown", function(e) {
      const items = suggestionsEl.querySelectorAll(".suggestion-item[data-index]");
      if (!items.length) return;
      if (e.key === "ArrowDown") {
        currentFocus = Math.min(currentFocus + 1, items.length - 1);
        setSuggestionActive();
        e.preventDefault();
      } else if (e.key === "ArrowUp") {
        currentFocus = Math.max(currentFocus - 1, 0);
        setSuggestionActive();
        e.preventDefault();
      } else if (e.key === "Enter" && currentFocus >= 0 && currentMatches[currentFocus]) {
        e.preventDefault();
        addFood(currentMatches[currentFocus]);
      }
    });

    function getExtremes(values) {
      const nums = values.filter((v) => v !== null);
      if (!nums.length) return { max: null, min: null };
      return { max: Math.max(...nums), min: Math.min(...nums) };
    }

    function appendValueCell(row, value, comparison) {
      const td = document.createElement("td");
      if (value === null) {
        td.textContent = "—";
        row.appendChild(td);
        return;
      }

      const main = createNode("span", "value-main", formatVal(value));
      if (comparison.max !== null && comparison.min !== null && comparison.max !== comparison.min) {
        if (value === comparison.max) main.classList.add("is-higher");
        if (value === comparison.min) main.classList.add("is-lower");
      }
      td.appendChild(main);

      if (comparison.max !== null && comparison.min !== null && comparison.max !== comparison.min) {
        if (value === comparison.max) {
          td.appendChild(createNode("span", "value-note", "Cao hơn trong nhóm so sánh"));
        } else if (value === comparison.min) {
          td.appendChild(createNode("span", "value-note", "Thấp hơn trong nhóm so sánh"));
        }
      }
      row.appendChild(td);
    }

    function renderComparison() {
      if (selected.length < 2) {
        emptyState.style.display = "";
        emptyState.querySelector("p").textContent = text.minTwo;
        tableArea.style.display = "none";
        tableArea.replaceChildren();
        return;
      }

      emptyState.style.display = "none";
      tableArea.style.display = "";
      tableArea.replaceChildren();

      const wrap = createNode("div", "compare-table-wrap");
      const table = createNode("table", "compare-table");
      const thead = document.createElement("thead");
      const headRow = document.createElement("tr");
      headRow.appendChild(createNode("th", "", "Chỉ số"));
      selected.forEach((food) => headRow.appendChild(createNode("th", "", food.name)));
      thead.appendChild(headRow);
      table.appendChild(thead);

      const tbody = document.createElement("tbody");
      let currentSection = "";

      for (const nutrient of NUTRIENTS) {
        const section = getSection(nutrient.key);
        if (section !== currentSection) {
          const sectionRow = document.createElement("tr");
          const sectionCell = createNode("td", "section-label", section);
          sectionCell.colSpan = selected.length + 1;
          sectionRow.appendChild(sectionCell);
          tbody.appendChild(sectionRow);
          currentSection = section;
        }

        const values = selected.map((food) => getNut(food, nutrient.key));
        if (values.every((value) => value === null)) continue;

        const row = document.createElement("tr");
        const labelCell = document.createElement("td");
        labelCell.appendChild(document.createTextNode(nutrient.label + " "));
        labelCell.appendChild(createNode("span", "metric-unit", `(${nutrient.unit})`));
        row.appendChild(labelCell);

        const extremes = getExtremes(values);
        values.forEach((value) => appendValueCell(row, value, extremes));
        tbody.appendChild(row);
      }

      const glValues = selected.map((food) => getGlycemicLoad(food));
      if (glValues.some((value) => value !== null)) {
        const sectionRow = document.createElement("tr");
        const sectionCell = createNode("td", "section-label", "🍚 Glycemic Load tham khảo");
        sectionCell.colSpan = selected.length + 1;
        sectionRow.appendChild(sectionCell);
        tbody.appendChild(sectionRow);

        const glRow = document.createElement("tr");
        glRow.appendChild(createNode("td", "", "GL ước tính"));
        const extremes = getExtremes(glValues);
        glValues.forEach((value) => appendValueCell(glRow, value, extremes));
        tbody.appendChild(glRow);
      }

      table.appendChild(tbody);
      wrap.appendChild(table);
      tableArea.appendChild(wrap);
      tableArea.appendChild(createNode(
        "p",
        "compare-note",
        "Ghi chú: các nhãn “cao hơn trong nhóm so sánh” hoặc “thấp hơn trong nhóm so sánh” chỉ mô tả chênh lệch dữ liệu trong bảng hiện tại, không phải kết luận sức khỏe hay khuyến nghị điều trị."
      ));
    }

    loadData();
  </script>
</BaseLayout>
