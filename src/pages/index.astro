---
import BaseLayout from "../layouts/BaseLayout.astro";
import AutoSearch from "../components/AutoSearch.astro";
import FoodIcon from "../components/FoodIcon.astro";
import DataSummary from "../components/DataSummary.astro";
import NutrientStats from "../components/NutrientStats.astro";
import { articles } from "../data/articles";
import { foods, recipes } from "../data/nutrition";
import { calculateRecipe, foodBySlug } from "../lib/nutrition";

const phoRecipe = recipes.find((recipe) => recipe.slug === "pho-bo")!;
const phoNutrients = calculateRecipe(phoRecipe);
const categories = [...new Set(foods.map((f) => f.category))];
const popularSlugs = ["com-trang", "thit-bo-nac", "trung-ga", "rau-muong", "ca-thu", "chuoi"];
const popularFoods = popularSlugs.map((slug) => foodBySlug(slug)).filter(Boolean) as typeof foods;
const toolPageModules = import.meta.glob("./cong-cu/*.astro");
const toolCount = Object.keys(toolPageModules).filter((path) => !path.endsWith("/index.astro")).length;
const toolCards = [
  { href: "/cong-cu/nhat-ky", icon: "📓", name: "Nhật ký ăn uống", desc: "Ghi bữa ăn và xem tổng hợp theo ngày, tuần" },
  { href: "/cong-cu/muc-tieu-can-nang", icon: "🎯", name: "Mục tiêu cân nặng", desc: "Ước tính nhu cầu và chọn mục tiêu phù hợp" },
  { href: "/cong-cu/bmi", icon: "⚖️", name: "BMI", desc: "Đánh giá nhanh cân nặng theo ngưỡng châu Á" },
  { href: "/cong-cu/so-sanh-thuc-pham", icon: "🔬", name: "So sánh thực phẩm", desc: "Đặt nhiều thực phẩm cạnh nhau để chọn nhanh" },
  { href: "/cong-cu/chi-so-gi", icon: "🌾", name: "Chỉ số GI thực phẩm", desc: "Tra GI của cơm, bún, phở và trái cây Việt" },
  { href: "/cong-cu/tinh-gl-bua-an", icon: "⚖️", name: "Tính GL bữa ăn", desc: "Ước tính tải đường huyết của cả bữa ăn" },
  { href: "/cong-cu/theo-doi-suc-khoe", icon: "📊", name: "Theo dõi sức khỏe", desc: "Theo dõi huyết áp, đường huyết và mỡ máu" },
  { href: "/cong-cu/ke-hoach-bua-an", icon: "📋", name: "Kế hoạch bữa ăn", desc: "Gợi ý khung bữa ăn dễ áp dụng mỗi ngày" },
  { href: "/cong-cu/dinh-duong-thai-ky", icon: "🧮", name: "Dinh dưỡng thai kỳ", desc: "Nhắc các chỉ số nên theo dõi trong thai kỳ" },
  { href: "/cong-cu/nhu-cau-dinh-duong-tre-em", icon: "👶", name: "Nhu cầu trẻ em", desc: "Xem mốc nhu cầu dinh dưỡng theo nhóm tuổi" },
  { href: "/cong-cu/tinh-calo-tieu-thu", icon: "🔥", name: "Calo tiêu thụ khi tập", desc: "Ước tính calo tiêu hao theo từng môn tập" },
];
const quickJourneys = [
  { href: "/theo-benh/tieu-duong", icon: "🩸", label: "Đái tháo đường", desc: "carb · GI/GL · thực đơn" },
  { href: "/theo-benh/cao-huyet-ap", icon: "🫀", label: "Tăng huyết áp", desc: "muối · DASH · món Việt" },
  { href: "/theo-benh/benh-than", icon: "🫘", label: "Bệnh thận", desc: "đạm · kali · phốt pho" },
  { href: "/cong-cu/so-sanh-thuc-pham", icon: "🔬", label: "So sánh nhanh", desc: "18 chỉ số dinh dưỡng" },
];
const homepageHighlights = [
  { value: articles.length, label: "bài viết", note: "theo bệnh, lối sống và hiểu lầm thường gặp" },
  { value: foods.length, label: "thực phẩm", note: "có khẩu phần, vi chất và nguồn dữ liệu" },
  { value: recipes.length, label: "món Việt", note: "ước tính theo công thức, có cảnh báo thực hành" },
];
---

<BaseLayout
  title="Dinh dưỡng Việt - Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam"
  description="Tra cứu calo, protein, carb, chất béo của thực phẩm và món ăn Việt Nam; đồng thời đọc bài dinh dưỡng theo bệnh và dùng các công cụ theo dõi sức khỏe tham khảo."
  canonical="/"
>
  <section class="hero">
    <div class="hero-copy">
      <span class="hero-badge animate-fade-in">🇻🇳 Dữ liệu thực phẩm Việt · Biên tập theo bệnh · Không cổ vũ mẹo cực đoan</span>
      <h1 class="animate-fade-in-up">Ăn uống dễ hiểu hơn, <span class="brand-text">quyết định an toàn hơn</span></h1>
      <p class="hero-desc animate-fade-in-up" style="animation-delay: 0.1s;">Một bản đồ dinh dưỡng cho bữa ăn Việt: tra số liệu khi cần, đọc theo bệnh khi cần an toàn, và đổi lời khuyên thành khẩu phần có thể làm ngay.</p>
      <div class="hero-search animate-fade-in-up" style="animation-delay: 0.2s;"><AutoSearch /></div>
      <div class="hero-actions animate-fade-in-up" style="animation-delay: 0.3s;">
        <a class="cta-btn" href="/tim-kiem">🔎 Tìm trong toàn site</a>
        <a class="cta-btn" href="/ban-do-benh">🩺 Xem theo bệnh</a>
        <a class="cta-btn cta-outline" href="/cong-cu/nhat-ky">📓 Ghi bữa ăn</a>
      </div>
      <div class="hero-trust animate-fade-in-up" style="animation-delay: 0.38s;" aria-label="Thông tin độ tin cậy">
        <span>📚 {articles.length} bài viết</span>
        <span>🥬 {foods.length} thực phẩm</span>
        <span>🍜 {recipes.length} món ăn</span>
        <span>🛠️ {toolCount} công cụ</span>
      </div>
    </div>
    <aside class="hero-panel animate-fade-in-up" style="animation-delay: 0.16s;" aria-label="Điều hướng nhanh">
      <div class="hero-panel-head">
        <span>Sổ tay hôm nay</span>
        <strong>Chọn một việc nhỏ</strong>
      </div>
      <div class="journey-list">
        {quickJourneys.map((item) => (
          <a href={item.href} class="journey-item">
            <span class="journey-icon">{item.icon}</span>
            <span>
              <strong>{item.label}</strong>
              <small>{item.desc}</small>
            </span>
          </a>
        ))}
      </div>
      <div class="hero-panel-note">
        <span>✨</span>
        <p>Thiết kế theo hướng phòng khám đời thường: ít khẩu hiệu, nhiều “nên ăn gì, tránh gì, khi nào cần hỏi bác sĩ”.</p>
      </div>
    </aside>
  </section>

  <section class="home-proof-strip" aria-label="Tóm tắt dữ liệu trên trang">
    {homepageHighlights.map((item) => (
      <div class="proof-card">
        <strong>{item.value.toLocaleString("vi-VN")}</strong>
        <span>{item.label}</span>
        <small>{item.note}</small>
      </div>
    ))}
  </section>

  <section class="home-flow" aria-label="Lối vào nhanh">
    <a href="/ban-do-benh" class="flow-card flow-primary">
      <span class="flow-icon">🗺️</span>
      <span><strong>Bản đồ bệnh đầy đủ</strong><small>Tra dinh dưỡng theo 21 nhóm chuyên khoa</small></span>
      <b>Khám phá →</b>
    </a>
    <a href="/dung-tin-ngay" class="flow-card">
      <span class="flow-icon">🔍</span>
      <span><strong>Đừng Tin Ngay</strong><small>Kiểm chứng hiểu lầm phổ biến về ăn uống</small></span>
      <b>Xem nhanh →</b>
    </a>
    <a href="/phuong-phap" class="flow-card">
      <span class="flow-icon">🔬</span>
      <span><strong>Nguồn & phương pháp</strong><small>Dữ liệu, giới hạn và cách biên tập</small></span>
      <b>Đọc thêm →</b>
    </a>
  </section>

  <section class="clinical-lens" aria-label="Chọn theo tình huống">
    <div class="lens-copy">
      <span class="section-kicker">Đọc theo tình huống</span>
      <h2>Không chỉ “bao nhiêu calo”, mà là “có hợp với mình không?”</h2>
      <p>Trang được sắp như một bàn hướng dẫn nhỏ: tra thực phẩm khi cần số liệu, đọc theo bệnh khi cần an toàn, dùng công cụ khi muốn đổi thành khẩu phần cụ thể.</p>
    </div>
    <div class="lens-grid">
      <a href="/thuc-pham" class="lens-card">
        <span>🥬</span>
        <strong>Tra thực phẩm</strong>
        <small>100g, khẩu phần, vi chất, độ tin cậy dữ liệu</small>
      </a>
      <a href="/mon-an" class="lens-card">
        <span>🍜</span>
        <strong>Xem món Việt</strong>
        <small>Ước tính theo công thức, có cảnh báo muối/dầu</small>
      </a>
      <a href="/kien-thuc-dinh-duong" class="lens-card">
        <span>📚</span>
        <strong>Đọc bài theo chủ đề</strong>
        <small>Nên ăn, hạn chế, khi nào cần hỏi bác sĩ</small>
      </a>
      <a href="/cong-cu" class="lens-card">
        <span>🛠️</span>
        <strong>Dùng công cụ</strong>
        <small>Carb, GL, đạm, nước, nhật ký, theo dõi sức khỏe</small>
      </a>
    </div>
  </section>

  <section class="section entry-grid">
    <div class="section-header">
      <div>
        <span class="section-kicker">Chọn đúng lối vào</span>
        <h2>Bạn đang cần gì hôm nay?</h2>
      </div>
    </div>
    <div class="entry-cards">
      <a href="/kien-thuc-dinh-duong" class="entry-card card-healthy">
        <div class="entry-icon">🥗</div>
        <div class="entry-title">Tôi muốn ăn lành mạnh hơn</div>
        <div class="entry-desc">Tháp dinh dưỡng, đĩa ăn, giảm muối, giảm đường, đọc nhãn thực phẩm</div>
      </a>
      <a href="/ban-do-benh" class="entry-card card-medical">
        <div class="entry-icon">🩺</div>
        <div class="entry-title">Tôi đang có bệnh</div>
        <div class="entry-desc">Đái tháo đường, tăng huyết áp, gout, thận, gan, dạ dày, mỡ máu</div>
      </a>
      <a href="/cong-cu/muc-tieu-can-nang" class="entry-card card-weight">
        <div class="entry-icon">⚖️</div>
        <div class="entry-title">Tôi muốn giảm cân / tăng cân</div>
        <div class="entry-desc">Ước tính nhu cầu năng lượng và chọn hướng theo dõi phù hợp</div>
      </a>
      <a href="/cong-cu/nhat-ky" class="entry-card card-diet">
        <div class="entry-icon">📓</div>
        <div class="entry-title">Tôi muốn ghi lại bữa ăn</div>
        <div class="entry-desc">Ghi thực phẩm và món ăn theo từng bữa, rồi xem tổng hợp ngày và tuần</div>
      </a>
    </div>
  </section>

  <section class="section start-here">
    <div class="section-header">
      <div>
        <span class="section-kicker">Lộ trình thường gặp</span>
        <h2>Bắt đầu từ đây</h2>
      </div>
      <a href="/ban-do-benh" class="view-all">Xem lộ trình theo vấn đề →</a>
    </div>
    <div class="start-grid">
        <a href="/theo-benh/tieu-duong" class="start-card">
        <div class="start-title">Đái tháo đường</div>
        <p>Bài nền, thực đơn mẫu, hỏi đáp và công cụ theo dõi.</p>
        <span>Xem nhanh →</span>
      </a>
        <a href="/theo-benh/cao-huyet-ap" class="start-card">
        <div class="start-title">Tăng huyết áp</div>
        <p>Giảm muối đúng cách, DASH và gợi ý món ăn Việt.</p>
        <span>Xem nhanh →</span>
      </a>
        <a href="/theo-benh/gan-nhiem-mo" class="start-card">
        <div class="start-title">Gan nhiễm mỡ</div>
        <p>Hướng dẫn ăn uống thực tế, thực đơn gọn và sai lầm cần tránh.</p>
        <span>Xem nhanh →</span>
      </a>
        <a href="/theo-benh/da-day-trao-nguoc" class="start-card">
        <div class="start-title">Dạ dày, tá tràng</div>
        <p>Lựa chọn bữa ăn dễ chịu hơn, món nên tránh và cách ăn ngoài hàng.</p>
        <span>Xem nhanh →</span>
      </a>
      <a href="/cong-cu/muc-tieu-can-nang" class="start-card">
        <div class="start-title">Giảm cân an toàn</div>
        <p>Tính nhu cầu năng lượng, đặt mục tiêu và lập bữa ăn hợp lý hơn.</p>
        <span>Xem nhanh →</span>
      </a>
      <a href="/dung-tin-ngay" class="start-card">
        <div class="start-title">Kiểm chứng thông tin</div>
        <p>Khi gặp tin đồn về sữa hạt, mật ong, gạo lứt, nước ép, hãy kiểm tra tại đây.</p>
        <span>Xem nhanh →</span>
      </a>
    </div>
  </section>

  <!-- Dashboard health alerts -->
  <section class="section" id="ha-root" style="display:none;">
    <div class="section-header"><h2>🩺 Cảnh báo sức khỏe</h2><a href="/cong-cu/theo-doi-suc-khoe" class="view-all">📊 Xem chi tiết →</a></div>
    <div id="ha-alerts"></div>
    <div id="ha-good" style="display:none;text-align:center;padding:16px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);">
      <div style="font-size:2rem;margin-bottom:6px;">✅</div>
      <div style="font-weight:600;font-size:0.95rem;">Các chỉ số gần đây trong ngưỡng an toàn</div>
      <div style="font-size:0.82rem;color:var(--ink-tertiary);margin-top:4px;">Tiếp tục theo dõi định kỳ tại <a href="/cong-cu/theo-doi-suc-khoe">📊 Theo dõi sức khỏe</a></div>
    </div>
  </section>

  <script>
(function() {
  // Dashboard health alerts from health-track-v1
  try {
    var ra = localStorage.getItem("health-track-v1");
    if(ra) {
      var data = JSON.parse(ra);
      if(data && data.length > 0) {
        data.sort(function(a,b){return a.date<b.date?1:a.date>b.date?-1:0;});
        var l = data[0];

        // Load goals
        var goals = null;
        try { var gs = localStorage.getItem("health-goals-v1"); if(gs) goals=JSON.parse(gs); } catch(e){}

        // Load weight/height from meal tracker targets
        var mtWeight = 65, mtHeight = 168;
        try {
          var mt = localStorage.getItem("mt-target-v2");
          if(mt) { var mtp = JSON.parse(mt); if(mtp.weight) mtWeight=mtp.weight; if(mtp.height) mtHeight=mtp.height; }
        } catch(e){}

        var alerts = [];

        // BP
        if(l.sys && l.sys >= 140) alerts.push({severity:"cao",icon:"🫀",title:"Huyết áp tâm thu cao",msg:"<strong>"+l.sys+"</strong> mmHg — nguy cơ tăng huyết áp. Giảm muối &lt;5g/ngày.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Giảm muối, hạn chế rượu bia, tập thể dục."});
        else if(l.sys && l.sys >= 130) alerts.push({severity:"vua",icon:"🫀",title:"Huyết áp tâm thu cao nhẹ",msg:"<strong>"+l.sys+"</strong> mmHg — tiền tăng huyết áp.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Theo dõi thường xuyên, giảm muối."});

        if(l.dia && l.dia >= 90) alerts.push({severity:"cao",icon:"🫀",title:"Huyết áp tâm trương cao",msg:"<strong>"+l.dia+"</strong> mmHg.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Giảm muối &lt;5g, tăng rau xanh, hạn chế rượu."});
        else if(l.dia && l.dia >= 80) alerts.push({severity:"vua",icon:"🫀",title:"HA tâm trương cao nhẹ",msg:"<strong>"+l.dia+"</strong> mmHg.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Theo dõi và giảm muối."});

        // Blood glucose
        if(l.glucose && l.glucose > 7.0) alerts.push({severity:"cao",icon:"🩸",title:"Đường huyết cao",msg:"<strong>"+l.glucose.toFixed(1)+"</strong> mmol/L — nguy cơ đái tháo đường.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Hạn chế tinh bột tinh chế, tăng chất xơ, khám bác sĩ."});
        else if(l.glucose && l.glucose >= 5.6 && l.glucose <= 7.0) alerts.push({severity:"vua",icon:"🩸",title:"Đường huyết cao nhẹ",msg:"<strong>"+l.glucose.toFixed(1)+"</strong> mmol/L — tiền đái tháo đường.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Giảm đường, tăng chất xơ, tập thể dục."});

        // HbA1c
        if(l.a1c && l.a1c > 7.0) alerts.push({severity:"cao",icon:"🩸",title:"HbA1c > mục tiêu",msg:"<strong>"+l.a1c.toFixed(1)+"%</strong> — cần kiểm soát đường huyết tốt hơn.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Chế độ ăn GI thấp, theo dõi đường huyết hàng ngày."});

        // Waist
        if(l.waist) {
          if(l.waist > 90) alerts.push({severity:"cao",icon:"📏",title:"Vòng eo lớn",msg:"<strong>"+l.waist+" cm</strong> — nguy cơ béo bụng, mỡ nội tạng.",link:"/cong-cu/bmi",tip:"Giảm calo, tăng vận động, hạn chế đường."});
          else if(l.waist > 80) alerts.push({severity:"vua",icon:"📏",title:"Vòng eo lớn nhẹ",msg:"<strong>"+l.waist+" cm</strong> — theo dõi.",link:"/cong-cu/bmi",tip:"Duy trì chế độ ăn lành mạnh."});
        }

        // BMI from mt weight
        if(mtWeight && mtHeight) {
          var bmi = mtWeight / ((mtHeight/100)*(mtHeight/100));
          if(bmi >= 30) alerts.push({severity:"cao",icon:"⚖️",title:"Béo phì (BMI "+bmi.toFixed(1)+")",msg:"BMI <strong>"+bmi.toFixed(1)+"</strong> — &ge;30: béo phì độ I.",link:"/cong-cu/bmi",tip:"Giảm 300-500 kcal/ngày, tăng vận động."});
          else if(bmi >= 25) alerts.push({severity:"vua",icon:"⚖️",title:"Béo phì nhẹ (BMI "+bmi.toFixed(1)+")",msg:"BMI <strong>"+bmi.toFixed(1)+"</strong> — &ge;25 (châu Á): thừa cân.",link:"/cong-cu/bmi",tip:"Giảm tinh bột tinh chế, tăng rau xanh."});
        }

        // LDL
        if(l.ldl && l.ldl > 3.4) alerts.push({severity:"cao",icon:"🧪",title:"LDL cholesterol cao",msg:"<strong>"+l.ldl.toFixed(2)+"</strong> mmol/L — nguy cơ xơ vữa mạch.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Giảm mỡ bão hòa, đồ chiên. Tăng chất xơ hòa tan."});
        else if(l.ldl && l.ldl >= 2.6) alerts.push({severity:"vua",icon:"🧪",title:"LDL cao nhẹ",msg:"<strong>"+l.ldl.toFixed(2)+"</strong> mmol/L.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Theo dõi chế độ ăn, hạn chế mỡ bão hòa."});

        // Triglyceride
        if(l.tg && l.tg > 2.3) alerts.push({severity:"cao",icon:"🧪",title:"Triglyceride cao",msg:"<strong>"+l.tg.toFixed(2)+"</strong> mmol/L — nguy cơ viêm tụy.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Giảm đường, tinh bột tinh chế, rượu bia."});
        else if(l.tg && l.tg >= 1.7) alerts.push({severity:"vua",icon:"🧪",title:"Triglyceride cao nhẹ",msg:"<strong>"+l.tg.toFixed(2)+"</strong> mmol/L.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Hạn chế đường và rượu."});

        var root = document.getElementById("ha-root");
        var al = document.getElementById("ha-alerts");
        var good = document.getElementById("ha-good");
        if(!root || !al) return;

        if(alerts.length > 0) {
          root.style.display="";
          al.innerHTML = '<div class="health-alert-grid">'+
            alerts.map(function(a) {
              return '<div class="card ha-card ha-'+a.severity+'">'+
                '<div class="ha-icon">'+a.icon+'</div>'+
                '<div class="ha-body">'+
                  '<div class="ha-title">'+a.title+'</div>'+
                  '<div class="ha-msg">'+a.msg+'</div>'+
                  '<div class="ha-tip">💡 '+a.tip+'</div>'+
                  '<a href="'+a.link+'" class="ha-link">Xem hướng dẫn →</a>'+
                '</div>'+
              '</div>';
            }).join("")+
          '</div>';
        } else {
          root.style.display="";
          good.style.display="";
        }
      }
    }
  } catch(e) {}
})();
</script>

