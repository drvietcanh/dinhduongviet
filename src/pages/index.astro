---
import BaseLayout from "../layouts/BaseLayout.astro";
import AutoSearch from "../components/AutoSearch.astro";
import FoodIcon from "../components/FoodIcon.astro";
import HomeIcon from "../components/HomeIcon.astro";
import { articles } from "../data/articles";
import { foods, recipes } from "../data/nutrition";
import { calculateRecipe, foodBySlug } from "../lib/nutrition";

const publicFoods = foods.filter((food) =>
  food.sourceReviewStatus !== "candidate_pending_dietitian_review"
  && food.sourceReviewStatus !== "recipe_estimate_only"
);
const toolPageModules = import.meta.glob("./cong-cu/*.astro");
const toolCount = Object.keys(toolPageModules).filter((path) => !path.endsWith("/index.astro")).length;
const popularSlugs = ["com-trang", "thit-bo-nac", "trung-ga", "rau-muong", "ca-thu", "chuoi"];
const popularFoods = popularSlugs.map((slug) => foodBySlug(slug)).filter(Boolean) as typeof foods;
const categories = [...new Set(foods.map((food) => food.category))].slice(0, 8);
const phoRecipe = recipes.find((recipe) => recipe.slug === "pho-bo")!;
const phoNutrients = calculateRecipe(phoRecipe);

const quickJourneys = [
  { href: "/theo-benh/tieu-duong", icon: "activity", label: "Đái tháo đường", desc: "Carb, GI/GL và thực đơn" },
  { href: "/theo-benh/cao-huyet-ap", icon: "heart", label: "Tăng huyết áp", desc: "Muối, DASH và món Việt" },
  { href: "/theo-benh/benh-than", icon: "leaf", label: "Bệnh thận", desc: "Đạm, kali và phốt pho" },
  { href: "/cong-cu/so-sanh-thuc-pham", icon: "scale", label: "So sánh thực phẩm", desc: "Đặt các lựa chọn cạnh nhau" },
] as const;
const entryCards = [
  { href: "/thuc-pham", icon: "search", title: "Tra thực phẩm", desc: "Xem năng lượng, đạm, carb, chất béo và vi chất theo 100 g." },
  { href: "/theo-benh", icon: "heart", title: "Đọc theo bệnh", desc: "Đi từ bài nền tảng đến thực đơn và công cụ phù hợp bệnh cảnh." },
  { href: "/cong-cu", icon: "calculator", title: "Dùng công cụ", desc: "Tính khẩu phần, carb, GL, đạm, nước và các chỉ số tham khảo." },
  { href: "/cong-cu/nhat-ky", icon: "journal", title: "Ghi bữa ăn", desc: "Lưu bữa ăn trên thiết bị và xem lại theo ngày hoặc tuần." },
] as const;
const diseaseCards = [
  { href: "/theo-benh/tieu-duong", label: "Đái tháo đường", desc: "Carb, đường huyết, thực đơn" },
  { href: "/theo-benh/cao-huyet-ap", label: "Tăng huyết áp", desc: "Giảm muối, DASH, theo dõi" },
  { href: "/theo-benh/gout-axit-uric", label: "Gout", desc: "Purin, đồ uống, cân nặng" },
  { href: "/theo-benh/mo-mau-tim-mach", label: "Mỡ máu, tim mạch", desc: "Chất béo, chất xơ, món Việt" },
  { href: "/theo-benh/da-day-trao-nguoc", label: "Dạ dày, trào ngược", desc: "Khẩu phần, thời điểm ăn" },
  { href: "/theo-benh/benh-than", label: "Bệnh thận", desc: "Đạm, kali, phốt pho" },
] as const;
const toolCards = [
  { href: "/cong-cu/tinh-carb", icon: "calculator", name: "Tính carb bữa ăn", desc: "Cộng lượng carb theo món và khẩu phần." },
  { href: "/cong-cu/tinh-gl-bua-an", icon: "activity", name: "Tính GL bữa ăn", desc: "Ước tính tải đường huyết của cả bữa." },
  { href: "/cong-cu/tinh-nhu-cau-dam", icon: "scale", name: "Nhu cầu đạm", desc: "Xem khoảng đạm theo cân nặng và bối cảnh." },
  { href: "/cong-cu/ke-hoach-bua-an", icon: "clipboard", name: "Kế hoạch bữa ăn", desc: "Biến mục tiêu thành một khung ăn dễ làm." },
  { href: "/cong-cu/sang-loc-suy-dinh-duong", icon: "shield", name: "Sàng lọc suy dinh dưỡng", desc: "Nhận biết nguy cơ để đi khám đúng lúc." },
  { href: "/cong-cu/tra-cuu-nhu-cau-dinh-duong", icon: "book", name: "Nhu cầu dinh dưỡng", desc: "Tra cứu theo tuổi, giới và sinh lý." },
] as const;
const featuredArticles = articles.filter((article) => article.featured && article.series !== "dung-tin-ngay").slice(0, 3);
---

<BaseLayout title="Dinh dưỡng Việt - Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam" description="Tra cứu calo, protein, carb, chất béo của thực phẩm và món ăn Việt Nam; đồng thời đọc bài dinh dưỡng theo bệnh và dùng các công cụ theo dõi sức khỏe tham khảo." canonical="/">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-main">
      <div class="hero-eyebrow"><HomeIcon name="shield" size={18} /> Dữ liệu Việt Nam · Biên tập có nguồn</div>
      <h1 id="home-title">Hiểu bữa ăn Việt.<br /><span>Chọn điều phù hợp hơn.</span></h1>
      <p class="hero-lead">Tra số liệu thực phẩm, đọc hướng dẫn theo bệnh và dùng công cụ để biến lời khuyên dinh dưỡng thành việc có thể làm hôm nay.</p>
      <div class="hero-search" aria-label="Tìm kiếm trong Dinh dưỡng Việt"><AutoSearch /></div>
      <div class="hero-actions">
        <a class="button button-primary" href="/thuc-pham"><HomeIcon name="search" size={19} /> Tra thực phẩm</a>
        <a class="button button-secondary" href="/theo-benh"><HomeIcon name="heart" size={19} /> Xem theo bệnh</a>
      </div>
      <div class="trust-row" aria-label="Quy mô thư viện">
        <span><strong>{publicFoods.length.toLocaleString("vi-VN")}</strong> thực phẩm</span>
        <span><strong>{recipes.length.toLocaleString("vi-VN")}</strong> món ăn</span>
        <span><strong>{articles.length.toLocaleString("vi-VN")}</strong> bài viết</span>
        <span><strong>{toolCount}</strong> công cụ</span>
      </div>
    </div>
    <aside class="hero-guide" aria-labelledby="guide-title">
      <div class="guide-heading"><span class="icon-box"><HomeIcon name="sparkles" size={21} /></span><div><span class="overline">Bắt đầu nhanh</span><h2 id="guide-title">Bạn đang quan tâm điều gì?</h2></div></div>
      <div class="guide-list">
        {quickJourneys.map((item) => (
          <a href={item.href} class="guide-link"><span class="guide-icon"><HomeIcon name={item.icon} size={20} /></span><span class="guide-copy"><strong>{item.label}</strong><small>{item.desc}</small></span><HomeIcon name="arrow" size={18} /></a>
        ))}
      </div>
      <p class="guide-note"><HomeIcon name="shield" size={17} /> Nội dung tham khảo, không thay thế tư vấn y tế cá nhân.</p>
    </aside>
  </section>

  <section class="home-section" aria-labelledby="entry-title">
    <div class="section-heading"><div><span class="overline">Chọn đúng lối vào</span><h2 id="entry-title">Bạn muốn làm gì?</h2></div></div>
    <div class="entry-grid">
      {entryCards.map((item) => (
        <a href={item.href} class="entry-card"><span class="entry-icon"><HomeIcon name={item.icon} size={25} /></span><span class="entry-copy"><strong>{item.title}</strong><small>{item.desc}</small></span><span class="card-arrow"><HomeIcon name="arrow" size={19} /></span></a>
      ))}
    </div>
  </section>

  <section class="continue-card" id="continue-panel" hidden aria-labelledby="continue-title">
    <span class="icon-box"><HomeIcon name="activity" size={22} /></span>
    <div><span class="overline">Dữ liệu trên thiết bị</span><h2 id="continue-title">Tiếp tục theo dõi sức khỏe</h2><p>Bạn đã có dữ liệu đã lưu. Hãy mở nhật ký để xem lại diễn biến và chuẩn bị câu hỏi khi đi khám.</p></div>
    <a class="button button-secondary" href="/cong-cu/theo-doi-suc-khoe">Mở theo dõi <HomeIcon name="arrow" size={18} /></a>
  </section>

  <section class="home-section" aria-labelledby="disease-title">
    <div class="section-heading"><div><span class="overline">Thư viện theo bệnh</span><h2 id="disease-title">Đi thẳng tới bệnh cảnh cần tìm</h2></div><a class="section-link" href="/theo-benh">Xem tất cả bệnh <HomeIcon name="arrow" size={18} /></a></div>
    <div class="disease-grid">
      {diseaseCards.map((item, index) => (
        <a class="disease-card" href={item.href}><span class="disease-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><span><strong>{item.label}</strong><small>{item.desc}</small></span><HomeIcon name="arrow" size={18} /></a>
      ))}
    </div>
  </section>

  <section class="home-section split-section" aria-labelledby="tools-title">
    <div class="section-heading split-heading"><div><span class="overline">Từ đọc sang làm</span><h2 id="tools-title">Công cụ thiết thực cho bữa ăn</h2><p>Ưu tiên công cụ có mục đích rõ, công thức minh bạch và giới hạn sử dụng được giải thích ngay trên trang.</p></div><a class="section-link" href="/cong-cu">Xem {toolCount} công cụ <HomeIcon name="arrow" size={18} /></a></div>
    <div class="tool-grid">
      {toolCards.map((item) => (
        <a class="tool-card" href={item.href}><span class="tool-icon"><HomeIcon name={item.icon} size={22} /></span><span><strong>{item.name}</strong><small>{item.desc}</small></span><HomeIcon name="arrow" size={17} /></a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="food-title">
    <div class="section-heading"><div><span class="overline">Tra nhanh dữ liệu</span><h2 id="food-title">Thực phẩm quen thuộc</h2></div><a class="section-link" href="/thuc-pham">Mở thư viện thực phẩm <HomeIcon name="arrow" size={18} /></a></div>
    <div class="food-grid">
      {popularFoods.map((food) => (
        <a class="food-card" href={`/thuc-pham/${food.slug}`}><span class="food-icon"><FoodIcon category={food.category} /></span><span class="food-copy"><small>{food.category}</small><strong>{food.name}</strong><span>{food.nutrients.energyKcal} kcal · {food.nutrients.proteinG} g đạm / 100 g</span></span><HomeIcon name="arrow" size={17} /></a>
      ))}
    </div>
    <div class="category-row" aria-label="Nhóm thực phẩm phổ biến">
      {categories.map((category) => { const count = foods.filter((food) => food.category === category).length; return <a href={`/thuc-pham?category=${encodeURIComponent(category)}#food-results`}>{category}<span>{count}</span></a>; })}
    </div>
  </section>

  <section class="home-section editorial-grid" aria-labelledby="reading-title">
    <div class="recipe-feature">
      <span class="overline">Món ăn theo khẩu phần</span><h2>Phở bò — một tô có gì?</h2><p>Ước tính từ bánh phở, thịt bò, nước dùng và rau trong một khẩu phần tham khảo.</p>
      <dl class="nutrition-summary">
        <div><dt>Năng lượng</dt><dd>{Math.round(phoNutrients.energyKcal)} kcal</dd></div><div><dt>Đạm</dt><dd>{phoNutrients.proteinG.toFixed(1)} g</dd></div><div><dt>Carb</dt><dd>{phoNutrients.carbG.toFixed(1)} g</dd></div><div><dt>Natri</dt><dd>{Math.round(phoNutrients.sodiumMg ?? 0).toLocaleString("vi-VN")} mg</dd></div>
      </dl>
      <a class="text-link" href="/mon-an/pho-bo">Xem cách tính và đổi khẩu phần <HomeIcon name="arrow" size={18} /></a>
    </div>
    <div class="reading-panel">
      <div class="section-heading compact-heading"><div><span class="overline">Đọc có định hướng</span><h2 id="reading-title">Bài viết nổi bật</h2></div></div>
      <div class="article-list">
        {featuredArticles.map((article) => (
          <a href={`/kien-thuc-dinh-duong/${article.slug}`}><span><small>{article.categoryName}</small><strong>{article.title}</strong><span>{article.readTime} phút đọc</span></span><HomeIcon name="arrow" size={18} /></a>
        ))}
      </div>
      <a class="text-link" href="/kien-thuc-dinh-duong">Xem toàn bộ bài viết <HomeIcon name="arrow" size={18} /></a>
    </div>
  </section>

  <section class="method-strip" aria-label="Cam kết nội dung">
    <span class="icon-box"><HomeIcon name="check" size={21} /></span><div><strong>Đọc nguồn và giới hạn trước khi áp dụng</strong><p>Mỗi công cụ và bài viết đều nêu mục đích, cách tính hoặc nguồn tham khảo; trường hợp có bệnh nền cần được cá thể hóa.</p></div><a href="/phuong-phap">Phương pháp dữ liệu <HomeIcon name="arrow" size={18} /></a>
  </section>
</BaseLayout>

<script>
  try {
    const saved = localStorage.getItem("health-track-v1");
    const panel = document.getElementById("continue-panel");
    if (saved && JSON.parse(saved)?.length && panel) panel.hidden = false;
  } catch {}
</script>

<style>
  :global(.home-icon) { display:block; flex:0 0 auto; }
  .home-hero,.home-section,.continue-card,.method-strip { max-width:1120px; margin-inline:auto; }
  .home-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr); gap:clamp(28px,5vw,64px); align-items:center; padding:clamp(40px,7vw,76px) clamp(22px,5vw,64px); border:1px solid var(--line); border-radius:28px; background:linear-gradient(145deg,var(--card),color-mix(in srgb,var(--brand) 7%,var(--card))); box-shadow:var(--shadow-sm); }
  .hero-main { min-width:0; }
  .hero-eyebrow,.overline { color:var(--brand-dark); font-size:.78rem; font-weight:800; letter-spacing:.055em; text-transform:uppercase; }
  .hero-eyebrow { display:flex; align-items:center; gap:8px; margin-bottom:18px; }
  .home-hero h1 { max-width:780px; margin:0; color:var(--ink); font-size:clamp(2.35rem,5vw,4.5rem); line-height:1.02; letter-spacing:-.055em; text-wrap:balance; }
  .home-hero h1 span { color:var(--brand-dark); }
  .hero-lead { max-width:680px; margin:22px 0 26px; color:var(--ink-secondary); font-size:clamp(1rem,1.8vw,1.15rem); line-height:1.7; text-wrap:pretty; }
  .hero-search { max-width:680px; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:48px; padding:10px 18px; border:1px solid transparent; border-radius:12px; font-size:.94rem; font-weight:800; text-decoration:none; transition:background-color .18s ease,border-color .18s ease,color .18s ease,box-shadow .18s ease; }
  .button:hover { text-decoration:none; }
  .button-primary { background:var(--brand); color:#fff; box-shadow:0 8px 20px -14px var(--brand); }
  .button-primary:hover { background:var(--brand-dark); color:#fff; }
  .button-secondary { border-color:var(--line); background:var(--card); color:var(--ink); }
  .button-secondary:hover { border-color:var(--brand-light2); background:var(--brand-light); color:var(--brand-dark); }
  .trust-row { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:20px; color:var(--ink-secondary); font-size:.82rem; }
  .trust-row span { display:inline-flex; gap:4px; white-space:nowrap; }
  .trust-row strong { color:var(--ink); font-variant-numeric:tabular-nums; }
  .hero-guide { padding:22px; border:1px solid var(--line); border-radius:20px; background:var(--card); box-shadow:var(--shadow-sm); }
  .guide-heading { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
  .guide-heading h2 { margin:3px 0 0; font-size:1.05rem; }
  .icon-box,.guide-icon,.entry-icon,.tool-icon { display:grid; place-items:center; flex:0 0 auto; color:var(--brand-dark); background:var(--brand-light); }
  .icon-box { width:42px; height:42px; border-radius:12px; }
  .guide-list { display:grid; gap:8px; }
  .guide-link { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:11px; min-height:64px; padding:9px 10px; border:1px solid transparent; border-radius:13px; color:var(--ink); text-decoration:none; transition:background-color .18s ease,border-color .18s ease; }
  .guide-link:hover { border-color:var(--line); background:var(--bg-soft); text-decoration:none; }
  .guide-icon { width:38px; height:38px; border-radius:11px; }
  .guide-copy,.entry-copy,.tool-card>span:nth-child(2),.food-copy,.disease-card>span:nth-child(2) { min-width:0; display:grid; gap:3px; }
  .guide-copy strong,.entry-copy strong,.tool-card strong,.food-copy strong,.disease-card strong { color:var(--ink); font-size:.91rem; line-height:1.35; }
  .guide-copy small,.entry-copy small,.tool-card small,.disease-card small { color:var(--ink-secondary); font-size:.79rem; line-height:1.45; }
  .guide-note { display:flex; align-items:flex-start; gap:8px; margin:16px 0 0; padding-top:14px; border-top:1px solid var(--line); color:var(--ink-tertiary); font-size:.76rem; line-height:1.45; }
  .home-section { margin-top:clamp(42px,7vw,72px); }
  .section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:20px; }
  .section-heading h2 { margin:4px 0 0; font-size:clamp(1.45rem,2.6vw,2rem); line-height:1.2; letter-spacing:-.03em; }
  .section-heading p { max-width:700px; margin:8px 0 0; color:var(--ink-secondary); line-height:1.6; }
  .section-link,.text-link,.method-strip>a { display:inline-flex; align-items:center; gap:7px; min-height:44px; color:var(--brand-dark); font-size:.86rem; font-weight:800; text-decoration:none; white-space:nowrap; }
  .section-link:hover,.text-link:hover,.method-strip>a:hover { color:var(--brand); text-decoration:underline; text-underline-offset:4px; }
  .entry-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
  .entry-card { position:relative; display:grid; grid-template-columns:auto minmax(0,1fr); align-items:start; gap:13px; min-height:178px; padding:20px; border:1px solid var(--line); border-radius:18px; background:var(--card); color:var(--ink); text-decoration:none; transition:border-color .18s ease,box-shadow .18s ease,background-color .18s ease; }
  .entry-card:hover { border-color:var(--brand-light2); background:color-mix(in srgb,var(--brand) 3%,var(--card)); box-shadow:var(--shadow-sm); text-decoration:none; }
  .entry-icon { width:44px; height:44px; border-radius:13px; }
  .entry-copy strong { font-size:1rem; }
  .card-arrow { position:absolute; right:18px; bottom:17px; color:var(--brand); }
  .continue-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:16px; margin-top:32px; padding:18px 20px; border:1px solid var(--brand-light2); border-radius:18px; background:var(--brand-light); }
  .continue-card[hidden] { display:none; }
  .continue-card h2 { margin:2px 0 3px; font-size:1.05rem; }
  .continue-card p { margin:0; color:var(--ink-secondary); font-size:.84rem; line-height:1.5; }
  .disease-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border:1px solid var(--line); border-radius:18px; overflow:hidden; background:var(--card); }
  .disease-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:13px; min-height:92px; padding:16px 18px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); color:var(--ink); text-decoration:none; transition:background-color .18s ease; }
  .disease-card:nth-child(3n) { border-right:0; }
  .disease-card:nth-last-child(-n+3) { border-bottom:0; }
  .disease-card:hover { background:var(--bg-soft); text-decoration:none; }
  .disease-number { color:var(--brand); font-size:.76rem; font-weight:900; font-variant-numeric:tabular-nums; }
  .split-section { padding:clamp(24px,4vw,38px); border-radius:22px; background:var(--bg-soft); }
  .split-heading { align-items:flex-start; }
  .tool-grid,.food-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .tool-card,.food-card { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:12px; min-height:96px; padding:15px; border:1px solid var(--line); border-radius:15px; background:var(--card); color:var(--ink); text-decoration:none; transition:border-color .18s ease,box-shadow .18s ease; }
  .tool-card:hover,.food-card:hover { border-color:var(--brand-light2); box-shadow:var(--shadow-sm); text-decoration:none; }
  .tool-icon { width:40px; height:40px; border-radius:12px; }
  .food-icon { width:44px; height:44px; display:grid; place-items:center; border-radius:12px; background:var(--bg-soft); }
  .food-copy small { color:var(--brand-dark); font-size:.71rem; font-weight:800; text-transform:uppercase; letter-spacing:.04em; }
  .food-copy span { color:var(--ink-secondary); font-size:.77rem; line-height:1.4; }
  .category-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
  .category-row a { display:inline-flex; align-items:center; gap:7px; min-height:38px; padding:7px 11px; border:1px solid var(--line); border-radius:999px; background:var(--card); color:var(--ink-secondary); font-size:.78rem; font-weight:700; text-decoration:none; }
  .category-row a:hover { border-color:var(--brand-light2); color:var(--brand-dark); text-decoration:none; }
