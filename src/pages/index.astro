---
import BaseLayout from "../layouts/BaseLayout.astro";
import AutoSearch from "../components/AutoSearch.astro";
import FoodIcon from "../components/FoodIcon.astro";
import DataSummary from "../components/DataSummary.astro";
import NutrientStats from "../components/NutrientStats.astro";
import { foods, recipes } from "../data/nutrition";
import { calculateRecipe, foodBySlug, allTags, tagLabel } from "../lib/nutrition";

const phoRecipe = recipes.find((recipe) => recipe.slug === "pho-bo")!;
const phoNutrients = calculateRecipe(phoRecipe);
const categories = [...new Set(foods.map((f) => f.category))];
const popularSlugs = ["com-trang", "thit-bo-nac", "trung-ga", "rau-muong", "ca-thu", "chuoi"];
const popularFoods = popularSlugs.map((slug) => foodBySlug(slug)).filter(Boolean) as typeof foods;
const toolCards = [
  { href: "/cong-cu/muc-tieu-can-nang", icon: "🎯", name: "Mục tiêu cân nặng", desc: "Tính BMR, TDEE, lộ trình giảm/tăng" },
  { href: "/cong-cu/bmi", icon: "⚖️", name: "BMI & vòng eo", desc: "Đánh giá béo phì châu Á, WHR" },
  { href: "/cong-cu/chi-so-gi", icon: "🌾", name: "Chỉ số GI thực phẩm", desc: "Tra GI cơm, bún, phở, trái cây Việt" },
  { href: "/cong-cu/tinh-gl-bua-an", icon: "⚖️", name: "Tính GL bữa ăn", desc: "Biết ngay bữa này có an toàn cho đường huyết" },
  { href: "/cong-cu/theo-doi-suc-khoe", icon: "📊", name: "Theo dõi sức khỏe", desc: "Huyết áp, đường huyết, mỡ máu" },
  { href: "/cong-cu/dinh-duong-thai-ky", icon: "🧮", name: "Dinh dưỡng thai kỳ", desc: "Calo, sắt, canxi, DHA từng tam cá nguyệt" },
  { href: "/cong-cu/nhu-cau-dinh-duong-tre-em", icon: "👶", name: "Nhu cầu trẻ em", desc: "Năng lượng, đạm, canxi 0–14 tuổi" },
  { href: "/cong-cu/tinh-calo-tieu-thu", icon: "🔥", name: "Calo tiêu thụ khi tập", desc: "26 môn tập, calo tương đương thực phẩm" },
  { href: "/cong-cu/ti-le-mo-co-the", icon: "📏", name: "Tỷ lệ mỡ cơ thể", desc: "US Navy, WHR, đánh giá mỡ nội tạng" },
];
---

<BaseLayout
  title="Dinh Dưỡng Việt - Tra cứu dinh dưỡng thực phẩm và món ăn Việt Nam"
  description="Tra cứu calo, protein, carb, chất béo của thực phẩm và món ăn Việt Nam; đồng thời đọc bài dinh dưỡng theo bệnh và dùng các công cụ theo dõi sức khỏe tham khảo."
  canonical="/"
>
  <section class="hero">
    <span class="hero-badge animate-fade-in">🇻🇳 Thực phẩm Việt Nam — Có nguồn gốc</span>
    <h1 class="animate-fade-in-up">Ăn gì cũng biết <span class="brand-text">bao nhiêu calo</span></h1>
    <p class="hero-desc animate-fade-in-up" style="animation-delay: 0.1s;">Tra nhanh calo, protein, carb, chất béo của thực phẩm và món ăn Việt Nam theo 100g hoặc khẩu phần.</p>
    <div class="hero-search animate-fade-in-up" style="animation-delay: 0.2s;"><AutoSearch /></div>
    <div class="hero-actions animate-fade-in-up" style="animation-delay: 0.3s;">
      <a class="cta-btn" href="/thuc-pham">🥬 Tra thực phẩm</a>
      <a class="cta-btn" href="/mon-an">🍜 Tra món ăn</a>
      <a class="cta-btn cta-outline" href="/ban-do-benh">🩺 Bệnh lý</a>
      <a class="cta-btn cta-outline" href="/dung-tin-ngay">🔍 Đừng Tin Ngay</a>
      <a class="cta-btn cta-outline" href="/cong-cu/bang-xep-hang">🏆 Xếp hạng</a>
    </div>
  </section>

  <!-- Đừng Tin Ngay promo ribbon -->
  <section class="dtn-ribbon">
    <a href="/dung-tin-ngay" class="dtn-ribbon-link">
      <span class="dtn-ribbon-icon">🔍</span>
      <span class="dtn-ribbon-text"><strong>Đừng Tin Ngay!</strong> — Những hiểu lầm phổ biến về dinh dưỡng</span>
      <span class="dtn-ribbon-action">Xem tất cả →</span>
    </a>
  </section>

  <!-- Bản đồ bệnh promo ribbon -->
  <section class="map-ribbon">
    <a href="/ban-do-benh" class="map-ribbon-link">
      <span class="map-ribbon-icon">🗺️</span>
      <span class="map-ribbon-text"><strong>Bản đồ bệnh mạn tính</strong> — Tra cứu dinh dưỡng theo từng bệnh, 21 nhóm bệnh theo chuyên khoa</span>
      <span class="map-ribbon-action">Khám phá →</span>
    </a>
  </section>

  <section class="section entry-grid">
    <div class="entry-cards">
      <a href="/kien-thuc-dinh-duong" class="entry-card card-healthy">
        <div class="entry-icon">🥗</div>
        <div class="entry-title">Tôi muốn ăn lành mạnh hơn</div>
        <div class="entry-desc">Tháp dinh dưỡng, đĩa ăn lành mạnh, giảm muối, giảm đường, đọc nhãn thực phẩm</div>
      </a>
      <a href="/ban-do-benh" class="entry-card card-medical">
        <div class="entry-icon">🩺</div>
        <div class="entry-title">Tôi đang có bệnh</div>
        <div class="entry-desc">Tiểu đường, cao huyết áp, gout, thận, gan, dạ dày, mỡ máu — ăn gì, kiêng gì?</div>
      </a>
      <a href="/cong-cu/muc-tieu-can-nang" class="entry-card card-weight">
        <div class="entry-icon">⚖️</div>
        <div class="entry-title">Tôi muốn giảm cân / tăng cân</div>
        <div class="entry-desc">Tính BMR, TDEE, mục tiêu calo, kế hoạch giảm cân khoa học, tăng cơ</div>
      </a>
      <a href="/cong-cu/ke-hoach-bua-an" class="entry-card card-diet">
        <div class="entry-icon">📋</div>
        <div class="entry-title">Tôi cần thực đơn cụ thể</div>
        <div class="entry-desc">Thực đơn 1 ngày, bữa sáng, bữa tối, ăn ngoài hàng, kế hoạch bữa ăn cá nhân</div>
      </a>
    </div>
  </section>

  <DataSummary />

  <!-- Dashboard health alerts -->
  <section class="section" id="ha-root" style="display:none;">
    <div class="section-header"><h2>🩺 Cảnh báo sức khỏe</h2><a href="/cong-cu/theo-doi-suc-khoe" class="view-all">📊 Xem chi tiết →</a></div>
    <div id="ha-alerts"></div>
    <div id="ha-good" style="display:none;text-align:center;padding:16px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);">
      <div style="font-size:2rem;margin-bottom:6px;">✅</div>
      <div style="font-weight:600;font-size:0.95rem;">Các chỉ số gần đây trong ngưỡng an toàn</div>
      <div style="font-size:0.82rem;color:var(--ink-tertiary);margin-top:4px;">Tiếp tục theo dõi định kỳ tại <a href="/cong-cu/theo-doi-suc-khoe">📊 Theo dõi sức khỏe</a></div>
    </div>
  </section>

  <!-- Meal tracker alert banner -->
  <section class="section" id="mt-banner-root" style="display:none;">
    <div class="section-header"><h2>📓 Nhật ký ăn uống hôm nay</h2><a href="/cong-cu/nhat-ky" class="view-all">Xem chi tiết →</a></div>
    <div id="mt-banner" style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);padding:16px;">
      <div id="mt-banner-content"></div>
    </div>
  </section>

  <script>
(function() {
  // Dashboard health alerts from health-track-v1
  try {
    var ra = localStorage.getItem("health-track-v1");
    if(ra) {
      var data = JSON.parse(ra);
      if(data && data.length > 0) {
        data.sort(function(a,b){return a.date<b.date?1:a.date>b.date?-1:0;});
        var l = data[0];

        // Load goals
        var goals = null;
        try { var gs = localStorage.getItem("health-goals-v1"); if(gs) goals=JSON.parse(gs); } catch(e){}

        // Load weight/height from meal tracker targets
        var mtWeight = 65, mtHeight = 168;
        try {
          var mt = localStorage.getItem("mt-target-v2");
          if(mt) { var mtp = JSON.parse(mt); if(mtp.weight) mtWeight=mtp.weight; if(mtp.height) mtHeight=mtp.height; }
        } catch(e){}

        var alerts = [];

        // BP
        if(l.sys && l.sys >= 140) alerts.push({severity:"cao",icon:"🫀",title:"Huyết áp tâm thu cao",msg:"<strong>"+l.sys+"</strong> mmHg — nguy cơ tăng huyết áp. Giảm muối &lt;5g/ngày.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Giảm muối, hạn chế rượu bia, tập thể dục."});
        else if(l.sys && l.sys >= 130) alerts.push({severity:"vua",icon:"🫀",title:"Huyết áp tâm thu cao nhẹ",msg:"<strong>"+l.sys+"</strong> mmHg — tiền tăng huyết áp.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Theo dõi thường xuyên, giảm muối."});

        if(l.dia && l.dia >= 90) alerts.push({severity:"cao",icon:"🫀",title:"Huyết áp tâm trương cao",msg:"<strong>"+l.dia+"</strong> mmHg.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Giảm muối &lt;5g, tăng rau xanh, hạn chế rượu."});
        else if(l.dia && l.dia >= 80) alerts.push({severity:"vua",icon:"🫀",title:"HA tâm trương cao nhẹ",msg:"<strong>"+l.dia+"</strong> mmHg.",link:"/kien-thuc-dinh-duong/benh-tim-mach",tip:"Theo dõi và giảm muối."});

        // Blood glucose
        if(l.glucose && l.glucose > 7.0) alerts.push({severity:"cao",icon:"🩸",title:"Đường huyết cao",msg:"<strong>"+l.glucose.toFixed(1)+"</strong> mmol/L — nguy cơ đái tháo đường.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Hạn chế tinh bột tinh chế, tăng chất xơ, khám bác sĩ."});
        else if(l.glucose && l.glucose >= 5.6 && l.glucose <= 7.0) alerts.push({severity:"vua",icon:"🩸",title:"Đường huyết cao nhẹ",msg:"<strong>"+l.glucose.toFixed(1)+"</strong> mmol/L — tiền tiểu đường.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Giảm đường, tăng chất xơ, tập thể dục."});

        // HbA1c
        if(l.a1c && l.a1c > 7.0) alerts.push({severity:"cao",icon:"🩸",title:"HbA1c > mục tiêu",msg:"<strong>"+l.a1c.toFixed(1)+"%</strong> — cần kiểm soát đường huyết tốt hơn.",link:"/kien-thuc-dinh-duong/dai-thao-duong",tip:"Chế độ ăn GI thấp, theo dõi đường huyết hàng ngày."});

        // Waist
        if(l.waist) {
          if(l.waist > 90) alerts.push({severity:"cao",icon:"📏",title:"Vòng eo lớn",msg:"<strong>"+l.waist+" cm</strong> — nguy cơ béo bụng, mỡ nội tạng.",link:"/cong-cu/bmi",tip:"Giảm calo, tăng vận động, hạn chế đường."});
          else if(l.waist > 80) alerts.push({severity:"vua",icon:"📏",title:"Vòng eo lớn nhẹ",msg:"<strong>"+l.waist+" cm</strong> — theo dõi.",link:"/cong-cu/bmi",tip:"Duy trì chế độ ăn lành mạnh."});
        }

        // BMI from mt weight
        if(mtWeight && mtHeight) {
          var bmi = mtWeight / ((mtHeight/100)*(mtHeight/100));
          if(bmi >= 30) alerts.push({severity:"cao",icon:"⚖️",title:"Béo phì (BMI "+bmi.toFixed(1)+")",msg:"BMI <strong>"+bmi.toFixed(1)+"</strong> — &ge;30: béo phì độ I.",link:"/cong-cu/bmi",tip:"Giảm 300-500 kcal/ngày, tăng vận động."});
          else if(bmi >= 25) alerts.push({severity:"vua",icon:"⚖️",title:"Béo phì nhẹ (BMI "+bmi.toFixed(1)+")",msg:"BMI <strong>"+bmi.toFixed(1)+"</strong> — &ge;25 (châu Á): thừa cân.",link:"/cong-cu/bmi",tip:"Giảm tinh bột tinh chế, tăng rau xanh."});
        }

        // LDL
        if(l.ldl && l.ldl > 3.4) alerts.push({severity:"cao",icon:"🧪",title:"LDL cholesterol cao",msg:"<strong>"+l.ldl.toFixed(2)+"</strong> mmol/L — nguy cơ xơ vữa mạch.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Giảm mỡ bão hòa, đồ chiên. Tăng chất xơ hòa tan."});
        else if(l.ldl && l.ldl >= 2.6) alerts.push({severity:"vua",icon:"🧪",title:"LDL cao nhẹ",msg:"<strong>"+l.ldl.toFixed(2)+"</strong> mmol/L.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Theo dõi chế độ ăn, hạn chế mỡ bão hòa."});

        // Triglyceride
        if(l.tg && l.tg > 2.3) alerts.push({severity:"cao",icon:"🧪",title:"Triglyceride cao",msg:"<strong>"+l.tg.toFixed(2)+"</strong> mmol/L — nguy cơ viêm tụy.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Giảm đường, tinh bột tinh chế, rượu bia."});
        else if(l.tg && l.tg >= 1.7) alerts.push({severity:"vua",icon:"🧪",title:"Triglyceride cao nhẹ",msg:"<strong>"+l.tg.toFixed(2)+"</strong> mmol/L.",link:"/kien-thuc-dinh-duong/roi-loan-mo-mau",tip:"Hạn chế đường và rượu."});

        var root = document.getElementById("ha-root");
        var al = document.getElementById("ha-alerts");
        var good = document.getElementById("ha-good");
        if(!root || !al) return;

        if(alerts.length > 0) {
          root.style.display="";
          al.innerHTML = '<div class="health-alert-grid">'+
            alerts.map(function(a) {
              return '<div class="card ha-card ha-'+a.severity+'">'+
                '<div class="ha-icon">'+a.icon+'</div>'+
                '<div class="ha-body">'+
                  '<div class="ha-title">'+a.title+'</div>'+
                  '<div class="ha-msg">'+a.msg+'</div>'+
                  '<div class="ha-tip">💡 '+a.tip+'</div>'+
                  '<a href="'+a.link+'" class="ha-link">Xem hướng dẫn →</a>'+
                '</div>'+
              '</div>';
            }).join("")+
          '</div>';
        } else {
          root.style.display="";
          good.style.display="";
        }
      }
    }
  } catch(e) {}
})();
</script>

  <!-- Meal tracker dashboard banner -->
  <script>
(function() {
  try {
    var raw = localStorage.getItem("mt-diary-v2");
    if(!raw) return;
    var log = JSON.parse(raw);
    if(typeof log !== "object") return;
    var d = new Date();
    var y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,"0"), dd = String(d.getDate()).padStart(2,"0");
    var today = y+"-"+m+"-"+dd;
    var dayLog = log[today];
    if(!dayLog) return;

    // Compute totals
    var totals = {kcal:0,protein:0,fat:0,carb:0,fiber:0};
    var hasData = false;
    Object.values(dayLog).forEach(function(items) {
      (items||[]).forEach(function() { hasData = true; });
    });
    if(!hasData) return;

    // Load targets
    var tgtEnergy = 2000, tgtProtein = 60, tgtFiber = 25;
    try {
      var mt = localStorage.getItem("mt-target-v2");
      if(mt) {
        var tgt = JSON.parse(mt);
        if(tgt && tgt.weight) {
          var a = tgt.age||30, s = tgt.sex||"male", w = tgt.weight, h = tgt.height||168;
          var ac = tgt.activity||1.55, gl = tgt.goal||"maintain";
          var bmr = s==="male" ? 10*w+6.25*h-5*a+5 : 10*w+6.25*h-5*a-161;
          tgtEnergy = Math.round(bmr*ac);
          if(gl==="lose") tgtEnergy = Math.round(tgtEnergy*0.85);
          else if(gl==="gain") tgtEnergy = Math.round(tgtEnergy*1.15);
          tgtProtein = Math.round(w*(gl==="gain"?2.0:1.4));
        }
      }
    } catch(e){}

    var kcal = 0, protein = 0, fiber = 0, fat = 0, carb = 0;
    var foodNames = [];
    Object.keys(dayLog).forEach(function(slot) {
      (dayLog[slot]||[]).forEach(function(it) {
        kcal += it.kcal||0;
        protein += it.protein||0;
        fiber += it.fiber||0;
        fat += it.fat||0;
        carb += it.carb||0;
        if(it.name) foodNames.push(it.name);
      });
    });

    // We don't have full nutrient data in log, only IDs. Use the search approach:
    // Display just calorie total based on entry counts. More accurate from the actual tool.

    var count = 0;
    Object.values(dayLog).forEach(function(items){count += (items||[]).length;});

    var root = document.getElementById("mt-banner-root");
    if(!root) return;

    var pctKcal = Math.min(Math.round(kcal/tgtEnergy*100), 999);
    var pctProtein = Math.min(Math.round(protein/tgtProtein*100), 999);

    root.style.display = "";
    document.getElementById("mt-banner-content").innerHTML =
      '<div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:space-between;">'+
        '<div style="display:flex;align-items:center;gap:10px;">'+
          '<span style="font-size:1.8rem;">📓</span>'+
          '<div><div style="font-size:0.95rem;font-weight:600;">Đã ghi '+count+' thực phẩm/món hôm nay</div>'+
          '<div style="font-size:0.82rem;color:var(--ink-tertiary);">Nhật ký ăn uống cá nhân</div></div>'+
        '</div>'+
        '<div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;">'+
          '<div style="text-align:center;"><span style="font-size:1.2rem;font-weight:700;color:var(--brand);">'+Math.round(kcal)+'</span><br><span style="font-size:0.75rem;color:var(--ink-tertiary);">/'+tgtEnergy+' kcal</span></div>'+
          '<div class="mt-banner-ring"><svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="var(--line)" stroke-width="4"/><circle cx="20" cy="20" r="16" fill="none" stroke="#e74c3c" stroke-width="4" stroke-dasharray="'+Math.min(pctKcal,100)*1.005+',100" stroke-dashoffset="25" stroke-linecap="round"/><text x="20" y="20" text-anchor="middle" dominant-baseline="central" font-size="8" font-weight="bold" fill="var(--ink)">'+pctKcal+'%</text></svg></div>'+
          '<a href="/cong-cu/nhat-ky" class="cta-btn" style="font-size:0.82rem;padding:6px 16px;">📝 Ghi tiếp →</a>'+
        '</div>'+
      '</div>'+
      '<div style="margin-top:10px;font-size:0.82rem;color:var(--ink-secondary);display:flex;gap:16px;flex-wrap:wrap;">'+
        '<span>🔥 '+Math.round(kcal)+'/'+tgtEnergy+' kcal</span>'+
        '<span>🥩 Đạm ~'+Math.round(protein)+'/'+tgtProtein+'g</span>'+
      '</div>';
  } catch(e) {}
})();
</script>

  <section class="section">
    <div class="section-header"><h2>🩺 Lối tắt theo mục tiêu sức khỏe</h2><a href="/ban-do-benh" class="view-all">Xem tất cả →</a></div>
    <div class="health-grid">
      <a class="card health-card" href="/ban-do-benh#tieu-duong"><span class="health-icon">🩸</span><div><h3>Tiểu đường</h3><p class="muted">Chế độ ăn, thực đơn, hiểu lầm</p></div></a>
      <a class="card health-card" href="/ban-do-benh#huyet-ap"><span class="health-icon">🫀</span><div><h3>Cao huyết áp</h3><p class="muted">Giảm muối, DASH, thực đơn</p></div></a>
      <a class="card health-card" href="/ban-do-benh#gout"><span class="health-icon">🦶</span><div><h3>Gout</h3><p class="muted">Purin, đạm, thực đơn mẫu</p></div></a>
      <a class="card health-card" href="/ban-do-benh#mo-mau-suy-tim"><span class="health-icon">❤️</span><div><h3>Mỡ máu • Tim mạch</h3><p class="muted">Giảm mỡ máu, chế độ ăn tim mạch</p></div></a>
      <a class="card health-card" href="/ban-do-benh#da-day"><span class="health-icon">😣</span><div><h3>Dạ dày • Trào ngược</h3><p class="muted">Thực đơn mềm, tránh đồ chua</p></div></a>
      <a class="card health-card" href="/ban-do-benh#than"><span class="health-icon">🫘</span><div><h3>Suy thận • Sỏi thận</h3><p class="muted">Kiểm soát kali, phốt pho, đạm</p></div></a>
    </div>
    <div class="health-grid" style="margin-top:10px;">
      <a class="card health-card" href="/ban-do-benh#beo-phi"><span class="health-icon">⚖️</span><div><h3>Béo phì • Giảm cân</h3><p class="muted">Calo, BMI, kế hoạch giảm cân</p></div></a>
