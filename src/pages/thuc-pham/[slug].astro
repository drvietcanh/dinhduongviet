---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortionCalculator from "../../components/PortionCalculator.astro";
import MacroPie from "../../components/MacroPie.astro";
import NutritionBars from "../../components/NutritionBars.astro";
import DRIWidget from "../../components/DRIWidget.astro";
import HealthAlert from "../../components/HealthAlert.astro";
import GlycemicLoad from "../../components/GlycemicLoad.astro";
import VNHealthScore from "../../components/VNHealthScore.astro";
import AddToDiary from "../../components/AddToDiary.astro";
import { foods } from "../../data/nutrition";
import { confidenceLabel, detailNutrients, foodBySlug, foodPublicNote, formatValue, sourceFor, allTags, tagLabel } from "../../lib/nutrition";
import { foodSlugAliases } from "../../lib/food-slug-aliases";

export function getStaticPaths() {
  return [
    ...foods.map((food) => ({ params: { slug: food.slug } })),
    ...Object.keys(foodSlugAliases).map((slug) => ({ params: { slug } }))
  ];
}

const requestedSlug = Astro.params.slug ?? "";
const canonicalSlug = foodSlugAliases[requestedSlug] ?? requestedSlug;
const food = foodBySlug(canonicalSlug);
if (!food) return Astro.redirect("/tim-kiem");
if (requestedSlug !== canonicalSlug) return Astro.redirect(`/thuc-pham/${canonicalSlug}`);
const source = sourceFor(food.sourceId);
const qualityLabels: Record<string, string> = {
  source_verified: "Đã đối chiếu nguồn trực tiếp",
  reviewed_keep_current: "Đã rà soát sơ bộ, giữ số hiện tại",
  recipe_estimate_only: "Dữ liệu ước tính từ công thức",
  needs_better_source: "Cần nguồn tốt hơn",
  candidate_pending_dietitian_review: "Có candidate chờ duyệt chuyên môn",
  needs_external_source: "Cần nguồn ngoài để đối chiếu",
};
const qualityNote = food.sourceReviewStatus ? qualityLabels[food.sourceReviewStatus] : "";
const publicNote = foodPublicNote(food);
const needsReview = Boolean(
  food.needsDietitianReview ||
  food.needsExternalSource ||
  food.sourceReviewStatus === "needs_better_source" ||
  food.sourceReviewStatus === "candidate_pending_dietitian_review" ||
  food.sourceReviewStatus === "needs_external_source"
);
const qualityTone = food.confidence === "high" && !needsReview
  ? "is-verified"
  : needsReview || food.confidence === "low"
    ? "is-review"
    : "is-caution";
const qualityBadge = food.confidence === "high" && !needsReview
  ? "Nguồn chắc"
  : needsReview
    ? "Cần rà soát"
    : food.confidence === "low"
      ? "Ước tính tham khảo"
      : "Cần đối chiếu";
const sourceHref = source?.url ?? "/phuong-phap";
const reviewMailto = `mailto:drvietcanh@gmail.com?subject=${encodeURIComponent(`Rà soát dữ liệu thực phẩm: ${food.name}`)}`;
const pageDescription = `Tra cứu 100g ${food.name}: khoảng ${Math.round(food.nutrients.energyKcal ?? 0)} kcal, ${Math.round(food.nutrients.proteinG ?? 0)}g đạm, ${Math.round(food.nutrients.carbG ?? 0)}g carb và ${Math.round(food.nutrients.fatG ?? 0)}g chất béo.`;
const nextFoodLinks = [
  { href: `/cong-cu/so-sanh-thuc-pham?left=${food.slug}`, label: "So sánh thực phẩm", note: "Đặt cạnh món khác để nhìn khác biệt nhanh." },
  { href: "/cong-cu/ke-hoach-bua-an", label: "Đưa vào bữa ăn", note: "Xem thực phẩm này hợp với khung bữa nào." },
  { href: "/mon-an", label: "Xem món liên quan", note: "Đi tiếp sang các món thường dùng thực phẩm này." },
];
const heroMetrics = [
  { label: "Năng lượng", value: `${Math.round(food.nutrients.energyKcal ?? 0)} kcal` },
  { label: "Protein", value: `${Math.round(food.nutrients.proteinG ?? 0)} g` },
  { label: "Carb", value: `${Math.round(food.nutrients.carbG ?? 0)} g` },
  { label: "Chất xơ", value: food.nutrients.fiberG == null ? "Chưa có" : `${formatValue(food.nutrients.fiberG)} g` }
];
const heroTags = allTags(food).slice(0, 3);
const coreNutrientKeys = ["energyKcal", "proteinG", "carbG", "fatG"] as const;
const presentDetailKeys = detailNutrients.filter((key) => food.nutrients[key] != null);
const missingDetailKeys = detailNutrients.filter((key) => food.nutrients[key] == null);
const coreComplete = coreNutrientKeys.every((key) => food.nutrients[key] != null);
const completenessPct = Math.round((presentDetailKeys.length / detailNutrients.length) * 100);
const completenessLabel = completenessPct >= 70
  ? "Rất đầy đủ"
  : completenessPct >= 45
    ? "Khá đầy đủ"
    : "Đủ macro, vi chất còn mỏng";
const missingPreview = missingDetailKeys
  .slice(0, 5)
  .map((key) => ({
    glycemicIndex: "GI",
    saturatedFatG: "béo bão hòa",
    cholesterolMg: "cholesterol",
    phosphorusMg: "phốt pho",
    potassiumMg: "kali",
    calciumMg: "canxi",
    ironMg: "sắt",
    zincMg: "kẽm",
    magnesiumMg: "magie",
    seleniumMcg: "selen",
    vitaminAUg: "vitamin A",
    vitaminCMg: "vitamin C",
    vitaminDMcg: "vitamin D",
    vitaminEMg: "vitamin E",
    vitaminB12Mcg: "vitamin B12",
    fiberG: "chất xơ",
    sugarG: "đường",
    sodiumMg: "natri",
    energyKcal: "năng lượng",
    proteinG: "đạm",
    carbG: "carb",
    fatG: "béo",
  }[key] ?? String(key)))
  .join(", ");
const detailMeta = [
  { label: "Quy đổi", value: food.basis },
  { label: "Nguồn", value: source?.name ?? food.sourceId },
  { label: "Độ tin cậy", value: confidenceLabel(food.confidence) },
  { label: "Độ phủ", value: `${presentDetailKeys.length}/${detailNutrients.length} chỉ số` },
];

// JSON-LD Food structured data
var foodSchema = {
  "@context": "https://schema.org",
  "@type": "Food",
  "name": "100g " + food.name,
  "description": "100g " + food.name + " chứa " + Math.round(food.nutrients.energyKcal) + " kcal, " + Math.round(food.nutrients.proteinG) + "g protein, " + Math.round(food.nutrients.fatG) + "g chất béo, " + Math.round(food.nutrients.carbG) + "g carbohydrate.",
  "image": "https://dinh-duong-viet.pages.dev/og-default.png",
  "author": {
    "@type": "Organization",
    "name": "Dinh dưỡng Việt"
  },
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": Math.round(food.nutrients.energyKcal ?? 0) + " kcal",
    "proteinContent": Math.round(food.nutrients.proteinG ?? 0) + " g",
    "fatContent": Math.round(food.nutrients.fatG ?? 0) + " g",
    "carbohydrateContent": Math.round(food.nutrients.carbG ?? 0) + " g",
    "fiberContent": Math.round(food.nutrients.fiberG ?? 0) + " g",
    "sodiumContent": Math.round(food.nutrients.sodiumMg ?? 0) + " mg"
  },
  "category": food.category,
  "servingSize": "100g"
};
---

<BaseLayout
  title={`100g ${food.name} bao nhiêu calo? - Dinh dưỡng Việt`}
  description={pageDescription}
  canonical={`/thuc-pham/${canonicalSlug}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(foodSchema)}></script>
  <section class="detail-hero">
    <div class="detail-topline">
      <a href="/thuc-pham" class="back-link">Danh sách thực phẩm</a>
      <span class={`badge quality-badge ${qualityTone}`}>{food.category} · {qualityBadge}</span>
    </div>
    <div class="detail-heading">
      <div class="detail-copy">
        <p class="eyebrow">Theo 100g phần ăn được</p>
        <h1>100g {food.name}</h1>
        <p class="lead">{food.edibleNote}</p>
        <div class="detail-actions">
          <button class="action-chip" onclick="shareRecipe()" title="Chia sẻ">Chia sẻ</button>
          <button class="action-chip" onclick="window.print()" title="In / Xuất PDF">In / PDF</button>
        </div>
      </div>
      <div class="detail-media">
        {food.imageUrl && <img src={food.imageUrl} alt={food.name} class="food-img detail-image" loading="lazy" decoding="async" fetchpriority="low" onerror="this.closest('.detail-media')?.classList.add('is-fallback'); this.remove();" />}
        <div class="detail-media-fallback" aria-hidden="true">
          <span>🥣</span>
          <strong>{food.name}</strong>
        </div>
      </div>
    </div>
    <div class="detail-metrics" aria-label="Tóm tắt dinh dưỡng">
      {heroMetrics.map((metric) => (
        <div class="metric-card">
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
        </div>
      ))}
    </div>
    {heroTags.length > 0 && (
      <div class="detail-tags">
        {heroTags.map((tag) => <span class="tag">{tagLabel(tag)}</span>)}
      </div>
    )}
    <div class="detail-meta-strip" aria-label="Thông tin đọc nhanh">
      {detailMeta.map((item) => (
        <div class="meta-pill">
          <span>{item.label}</span>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>
    <div class="detail-note-card">
      <h2>Đọc nhanh</h2>
      <p>Số liệu mặc định áp theo 100g phần ăn được. Nếu bạn ăn ít hơn hoặc nhiều hơn mức này, hãy đổi lại khẩu phần trước khi so sánh.</p>
      <p class="public-note">{publicNote}</p>
    </div>
    <AddToDiary type="food" itemId={food.id} defaultAmount={100} />
  </section>

  <HealthAlert nutrients={food.nutrients} name={food.name} category={food.category} />

  <div id="vn-crossref" class="crossref-shell" data-slug={food.slug} data-name={food.name} data-exkcal={food.nutrients.energyKcal}></div>

  <section class="section">
    <PortionCalculator nutrients={food.nutrients} baseAmountG={100} defaultAmountG={100} title={`Đổi khẩu phần ${food.name}`} />
  </section>

  <section class="section card next-step-card">
    <div class="section-head">
      <h2>Bước tiếp theo</h2>
      <p>Ba hướng đi gọn nhất sau khi đã đọc xong một thực phẩm riêng lẻ.</p>
    </div>
    <div class="next-step-grid">
      {nextFoodLinks.map((link) => (
        <a href={link.href} class="next-step-link">
          <strong>{link.label}</strong>
          <span>{link.note}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <VNHealthScore nutrients={food.nutrients} name={food.name} />
  </section>

  {food.nutrients.glycemicIndex != null && (
    <section class="section">
      <GlycemicLoad glycemicIndex={food.nutrients.glycemicIndex} carbG={food.nutrients.carbG} />
    </section>
  )}

  <section class="section grid two detail-secondary-grid">
    <div class="card">
      <h3 class="detail-card-title">🥧 Phân bố năng lượng</h3>
      <MacroPie proteinG={food.nutrients.proteinG ?? 0} fatG={food.nutrients.fatG ?? 0} carbG={food.nutrients.carbG ?? 0} />
    </div>
    <div class="card">
      <h3 class="detail-card-title">📊 % RDI tham khảo</h3>
      <NutritionBars nutrients={food.nutrients} />
    </div>
  </section>

  <section class="section">
    <div class="card source-card">
      <div class="section-head">
        <h2>Nguồn dữ liệu</h2>
        <p>Đọc nhanh nguồn, mức tin cậy và lưu ý dùng số liệu.</p>
      </div>
      <div class="source-facts">
        <div class="source-fact">
          <span>Nguồn</span>
          <strong>{source?.name ?? food.sourceId}</strong>
        </div>
        <div class="source-fact">
          <span>Mức tin cậy</span>
          <strong>{confidenceLabel(food.confidence)}</strong>
        </div>
        <div class="source-fact">
          <span>Cơ sở quy đổi</span>
          <strong>{food.basis}</strong>
        </div>
        <div class="source-fact">
          <span>Thành phần đã có</span>
          <strong>{presentDetailKeys.length}/{detailNutrients.length} chỉ số</strong>
        </div>
      </div>
      <div class={`data-completeness-card ${coreComplete ? "is-ok" : "is-warning"}`}>
        <div>
          <span class="data-completeness-kicker">Độ đầy đủ dữ liệu</span>
          <strong>{completenessLabel} · {completenessPct}%</strong>
        </div>
        <p>
          {coreComplete
            ? "Đã có đủ 4 chỉ số nền tảng: năng lượng, đạm, carb và chất béo."
            : "Thiếu ít nhất một chỉ số nền tảng, cần kiểm lại trước khi dùng để so sánh khẩu phần."}
          {missingPreview && ` Một số chỉ số chưa có: ${missingPreview}.`}
        </p>
      </div>
      {qualityNote && (
        <div class="quality-note">
          <span>{qualityNote}</span>
          {food.basisNote && <p>{food.basisNote}</p>}
          {food.needsDietitianReview && <p>Cần bác sĩ hoặc chuyên gia dinh dưỡng duyệt trước khi dùng để thay đổi dữ liệu chính.</p>}
        </div>
      )}
      <div class="source-copy">
        <p><strong>Lưu ý sai số:</strong> {publicNote}</p>
        <p>Khi cần dùng chặt hơn, nên đối chiếu lại với nguồn gốc và trạng thái chế biến thực tế.</p>
      </div>
      <div class="source-actions">
        <a href={sourceHref} target={source?.url ? "_blank" : undefined} rel={source?.url ? "noreferrer" : undefined}>{source?.url ? "Mở nguồn gốc dữ liệu" : "Xem phương pháp và nguồn dữ liệu"}</a>
        <a href={reviewMailto}>Báo dữ liệu cần rà soát</a>
      </div>
    </div>
  </section>

  <section class="section">
    <DRIWidget nutrients={food.nutrients} name={food.name} />
  </section>
  <script is:inline>
    function shareRecipe() {
      var title = document.title;
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function(){});
      } else {
        navigator.clipboard.writeText(url).then(function() {
          alert('Đã sao chép đường dẫn!');
        }).catch(function(){});
      }
    }
  </script>
</BaseLayout>

<style>
  .detail-hero {
    display: grid;
    gap: 18px;
    margin-bottom: 8px;
  }

  .detail-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    color: var(--ink-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--brand);
  }

  .detail-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 360px);
    gap: 20px;
    align-items: start;
  }

  .detail-copy h1 {
    margin: 4px 0 10px;
  }

  .eyebrow {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .action-chip {
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    padding: 9px 14px;
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  .detail-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .detail-media {
    width: 100%;
  }

  .detail-media-fallback {
    display: none;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: linear-gradient(135deg, var(--bg-soft), var(--brand-light));
    color: var(--ink);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    padding: 16px;
  }

  .detail-media-fallback span {
    font-size: 2rem;
  }

  .detail-media.is-fallback .detail-media-fallback {
    display: flex;
  }

  .detail-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .metric-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    padding: 12px 14px;
  }

  .metric-card span {
    display: block;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    margin-bottom: 6px;
  }

  .metric-card strong {
    font-size: 1rem;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .detail-tags .tag {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--card-border);
    color: var(--ink-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .detail-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meta-pill {
    display: inline-flex;
    min-height: 46px;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .meta-pill span {
    color: var(--ink-tertiary);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .meta-pill strong {
    margin-top: 3px;
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .detail-note-card,
  .crossref-shell:empty {
    display: none;
  }

  .detail-note-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--brand) 6%, var(--card));
    padding: 14px 16px;
    display: block;
  }

  .detail-note-card h2,
  .section-head h2 {
    margin: 0 0 6px;
    font-size: 1.02rem;
  }

  .detail-note-card p,
  .section-head p {
    margin: 0;
    color: var(--ink-secondary);
  }

  .detail-note-card .public-note {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--card-border);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .quality-badge {
    border: 1px solid var(--card-border);
  }

  .quality-badge.is-verified {
    background: color-mix(in srgb, #10b981 13%, var(--card));
    color: #047857;
    border-color: color-mix(in srgb, #10b981 32%, var(--card-border));
  }

  .quality-badge.is-caution {
    background: color-mix(in srgb, #f59e0b 14%, var(--card));
    color: #92400e;
    border-color: color-mix(in srgb, #f59e0b 34%, var(--card-border));
  }

  .quality-badge.is-review {
    background: color-mix(in srgb, #ef4444 10%, var(--card));
    color: #991b1b;
    border-color: color-mix(in srgb, #ef4444 28%, var(--card-border));
  }

  [data-theme="dark"] .quality-badge.is-verified {
    color: #6ee7b7;
  }

  [data-theme="dark"] .quality-badge.is-caution {
    color: #fbbf24;
  }

  [data-theme="dark"] .quality-badge.is-review {
    color: #fca5a5;
  }

  .section-head {
    margin-bottom: 12px;
  }
  .detail-secondary-grid {
    margin-top: 20px;
  }
  .detail-card-title {
    margin-bottom: 16px;
  }
  .vn-ref-card {
    padding:14px 16px;
  }
  .vn-ref-head {
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
  }
  .vn-ref-source {
    color:var(--ink-secondary);
    font-size:0.84rem;
  }
  .vn-ref-link {
    margin-left:auto;
    color:var(--brand-dark);
    font-weight:600;
    white-space:nowrap;
    transition:color var(--transition);
  }
  .vn-ref-meta {
    margin-top:10px;
    display:flex;
    gap:16px;
    flex-wrap:wrap;
  }
  .vn-ref-meta-label {
    color:#888;
  }
  .vn-ref-diff {
    color:#e65100;
    font-weight:600;
  }
  .vn-ref-match {
    color:#2e7d32;
  }
  .vn-ref-warning {
    margin-top:8px;
    background:#fff3e0;
    padding:8px 12px;
    border-radius:6px;
    font-size:0.85rem;
  }
  .next-step-card { padding: 18px; }
  .next-step-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .next-step-link {
    display: flex;
    min-height: 88px;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 13px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
  }

  .next-step-link strong {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .next-step-link span {
    margin-top: 10px;
    color: var(--ink-secondary);
    font-size: 0.79rem;
    line-height: 1.45;
  }

  .next-step-link:hover {
    border-color: var(--brand-light2);
    background: var(--brand-light);
    color: var(--brand-dark);
  }

  .quality-note {
    margin-top: 12px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-sm);
    padding: 10px 12px;
    color: var(--ink-secondary);
    font-size: 0.92rem;
