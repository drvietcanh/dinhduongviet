<script is:inline>
  (async function() {
    function normalize(value) {
      return String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }
    function normalizeWithMarks(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/[^\p{L}\p{N}]+/gu, ' ')
        .trim();
    }
    function tokenOverlapRatio(left, right) {
      var leftTokens = normalize(left).split(' ').filter(function(token){ return token.length >= 2; });
      var rightTokens = normalize(right).split(' ').filter(function(token){ return token.length >= 2; });
      if (!leftTokens.length || !rightTokens.length) return 0;
      var rightSet = new Set(rightTokens);
      var overlap = leftTokens.filter(function(token){ return rightSet.has(token); }).length;
      return overlap / Math.min(leftTokens.length, rightTokens.length);
    }
    function isPlausibleCrossref(slug, appName, refName) {
      var allowedTransforms = new Set(['com-trang', 'com-gao-lut', 'gao-te', 'gao-nep', 'gao-lut', 'bot-gao', 'bot-mi', 'bot-nghe', 'mi-goi']);
      if (allowedTransforms.has(slug)) return true;
      if (!refName || /^\d+$/.test(String(refName).trim())) return false;
      var appPlain = normalize(appName);
      var refPlain = normalize(refName);
      if (appPlain === refPlain && normalizeWithMarks(appName) !== normalizeWithMarks(refName)) return false;
      return tokenOverlapRatio(appName, refName) >= 0.5;
    }
    var container = document.getElementById('vn-crossref');
    if (!container) return;
    var slug = container.getAttribute('data-slug');
    var appName = container.getAttribute('data-name') || slug;
    if (!slug) return;
    try {
      var crResponse = await fetch('/vn-crossref.json');
      var cr = await crResponse.json();
      var ref = cr[slug];
      if (!ref) return;
      if (!isPlausibleCrossref(slug, appName, ref.name)) return;
      var vnResponse = await fetch('/api/vietnam-foods.json');
      var vn = await vnResponse.json();
      var vnFood = vn.find(function(f){return f.code===ref.code});
      if (!vnFood || vnFood.energy_kcal == null) return;
      var exKcalStr = container.getAttribute('data-exkcal');
      var exKcal = exKcalStr ? parseFloat(exKcalStr) : null;
      var diff = exKcal !== null ? Math.abs(exKcal - vnFood.energy_kcal) : 0;
      var pct = exKcal !== null && vnFood.energy_kcal > 0 ? Math.round(diff / vnFood.energy_kcal * 100) : null;
      var html = '<div class="card vn-ref-card">';
      html += '<div class="section-head"><h2>Nguồn dữ liệu Việt</h2><p>Đối chiếu nhanh với mã tương ứng trong Bảng thành phần thực phẩm Việt Nam 2007.</p></div>';
      html += '<div class="vn-ref-head"><div><strong>Bảng TP thực phẩm Việt 2007</strong><span class="vn-ref-source"> · Viện Dinh Dưỡng</span></div><a href="/cong-cu/tra-cuu-thuc-pham-viet" class="vn-ref-link">Mở bảng Việt →</a></div>';
      html += '<div class="vn-ref-meta"><div><span class="vn-ref-meta-label">Tương ứng:</span> <strong>' + ref.name + '</strong></div><div><span class="vn-ref-meta-label">Năng lượng VN 2007:</span> <strong>' + vnFood.energy_kcal + ' kcal</strong>' + (pct !== null && pct > 15 ? ' <span class="vn-ref-diff">(lệch ' + pct + '%)</span>' : ' <span class="vn-ref-match">Phù hợp</span>') + '</div><div><span class="vn-ref-meta-label">Mã số:</span> <strong>#' + vnFood.code + '</strong></div></div>';
      if (pct !== null && pct > 30) {
        html += '<div class="vn-ref-warning">Số liệu hiện tại vẫn nên xem là ước tính. Khi cần dùng chính thức, ưu tiên đối chiếu lại theo mã #' + vnFood.code + ' của Viện Dinh Dưỡng.</div>';
      }
      html += '</div>';
      container.innerHTML = html;
    } catch (err) {}
  })();
</script>
