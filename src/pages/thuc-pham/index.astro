---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchBox from "../../components/SearchBox.astro";
import DataSummary from "../../components/DataSummary.astro";
import { foods } from "../../data/nutrition";
import { tagLabel } from "../../lib/nutrition";

const groups = foods.reduce<Record<string, typeof foods>>((acc, food) => {
  acc[food.category] ??= [];
  acc[food.category].push(food);
  return acc;
}, {});
const categories = Object.keys(groups).sort((a, b) => a.localeCompare(b, "vi"));
---

<BaseLayout
  title="Danh sách thực phẩm - Dinh Dưỡng Việt"
  description="Tra cứu danh sách thực phẩm theo nhóm, calo, đạm, natri và các tag dinh dưỡng để chọn món phù hợp hơn cho bữa ăn hằng ngày."
  canonical="/thuc-pham"
>
  <section>
    <h1>Danh sách thực phẩm</h1>
    <p class="lead">Trang này phù hợp khi bạn muốn tra nhanh từng thực phẩm trước khi ghép thành bữa ăn.</p>
    <div style="margin-top: 18px;">
      <SearchBox />
    </div>
    <div class="quick-start-panel">
      <div class="quick-start-copy">
        <strong>Bắt đầu nhanh</strong>
        <p>Nếu chưa biết lọc từ đâu, hãy chọn một mục tiêu trước rồi mới dùng bộ lọc chi tiết.</p>
      </div>
      <div class="quick-start-links">
        <a href="/thuc-pham?profile=diabetes">🩸 ĐTĐ: ưu tiên GI/GL thấp</a>
        <a href="/thuc-pham?profile=hypertension">❤️ THA: ưu tiên ít natri</a>
        <a href="/thuc-pham?profile=weight">⚖️ Giảm cân: kcal thấp, xơ cao</a>
      </div>
    </div>
    <details class="filter-panel" aria-label="Bộ lọc thực phẩm nâng cao" open>
      <summary class="filter-panel-summary">
        <div class="panel-head">
          <div>
            <strong>Lọc thực phẩm theo dữ liệu nền</strong>
            <p>Trang này dùng chuẩn theo 100g để so bản chất thực phẩm trước khi chuyển sang khẩu phần thực tế.</p>
          </div>
          <div class="panel-summary-side">
            <span class="panel-base">Chuẩn 100g ăn được</span>
            <span class="panel-toggle-text"></span>
          </div>
        </div>
      </summary>
      <div class="filter-panel-body">
      <div class="filter-row">
        <label>
          <span>Nhóm</span>
          <select id="category-filter">
            <option value="all">Tất cả nhóm</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
        <label>
          <span>Sắp xếp</span>
          <select id="sort-select">
            <option value="name-asc">Tên A→Z</option>
            <option value="name-desc">Tên Z→A</option>
            <option value="calo-asc">Calo thấp → cao</option>
            <option value="calo-desc">Calo cao → thấp</option>
            <option value="protein-desc">Đạm cao → thấp</option>
            <option value="sodium-asc">Natri thấp → cao</option>
            <option value="fiber-desc">Chất xơ cao → thấp</option>
          </select>
        </label>
        <label>
          <span>Gợi ý lọc nhanh</span>
          <select id="profile-filter">
            <option value="all">Không áp dụng</option>
            <option value="diabetes">ĐTĐ: ưu tiên GI/GL thấp</option>
            <option value="hypertension">THA: ưu tiên ít natri</option>
            <option value="gout">Gout: ưu tiên ít purin</option>
            <option value="ckd">Thận: lọc natri/kali thấp</option>
            <option value="weight">Giảm cân: kcal thấp, xơ cao</option>
          </select>
        </label>
      </div>
      <div class="filter-row numeric-row">
        <label><span>Kcal tối đa</span><input id="max-kcal" type="number" min="0" step="10" placeholder="vd 150" /></label>
        <label><span>Đạm tối thiểu</span><input id="min-protein" type="number" min="0" step="1" placeholder="g/100g" /></label>
        <label><span>Carb tối đa</span><input id="max-carb" type="number" min="0" step="1" placeholder="g/100g" /></label>
        <label><span>Natri tối đa</span><input id="max-sodium" type="number" min="0" step="10" placeholder="mg/100g" /></label>
        <button id="reset-filters" class="button secondary" type="button">Xóa lọc</button>
      </div>
      <p class="muted" style="margin:10px 0 0; font-size:0.83rem;">
        Bộ lọc này chỉ giúp sàng nhanh theo dữ liệu dinh dưỡng. Với bệnh thận hoặc chế độ ăn điều trị, vẫn cần cá thể hóa theo xét nghiệm, thuốc và tư vấn bác sĩ.
      </p>
      <p class="muted filter-summary" id="filter-summary"></p>
      </div>
    </details>
    <div class="quick-nav" style="margin-top: 12px;">
      <span class="muted" style="font-size: 0.85rem;">Nhảy nhanh: </span>
      {Object.entries(groups).map(([category, items]) => (
        <a class="badge" href={`#${encodeURIComponent(category)}`}>{category} · {items.length}</a>
      ))}
    </div>
  </section>

  <DataSummary compact />

  <section class="section">
    <div class="usage-strip">
      <div class="usage-step">
        <strong>1. Chọn nhóm hoặc mục tiêu</strong>
        <p>Dùng hồ sơ lọc nhanh nếu bạn đang ưu tiên đường huyết, natri hay cân nặng.</p>
      </div>
      <div class="usage-step">
        <strong>2. So theo 100g</strong>
        <p>Trang này phù hợp để đối chiếu bản chất thực phẩm trước khi ghép thành món hay khẩu phần.</p>
      </div>
      <div class="usage-step">
        <strong>3. Mở chi tiết khi cần</strong>
        <p>Đi sâu vào từng thực phẩm nếu bạn cần GI, kali, natri hoặc các tag liên quan bệnh lý.</p>
      </div>
    </div>
    <div class="cross-cta-strip">
      <a href="/cong-cu/so-sanh-thuc-pham">So sánh thực phẩm →</a>
      <a href="/cong-cu/ke-hoach-bua-an">Đưa vào kế hoạch bữa ăn →</a>
      <a href="/mon-an">Xem tiếp các món ăn hoàn chỉnh →</a>
    </div>
  </section>

  <!-- Tag filter bar -->
  <details class="tag-filter-panel" open>
    <summary class="tag-filter-summary">
      <strong>Lọc theo tag</strong>
      <span class="tag-filter-toggle"></span>
    </summary>
    <div class="filter-bar">
      <button class="badge filter-btn active" data-filter="all">Tất cả</button>
      <button class="badge filter-btn" data-filter="vegan">🌱 Thuần chay</button>
      <button class="badge filter-btn" data-filter="high-protein">💪 Nhiều đạm</button>
      <button class="badge filter-btn" data-filter="low-fat">🌿 Ít béo</button>
      <button class="badge filter-btn" data-filter="glycemic-index-low">⬇ GI thấp</button>
      <button class="badge filter-btn" data-filter="glycemic-index-high">⬆ GI cao</button>
      <button class="badge filter-btn" data-filter="low-purine">🟢 Ít purin</button>
      <button class="badge filter-btn" data-filter="high-purine">🔴 Nhiều purin</button>
      <button class="badge filter-btn" data-filter="low-sodium">🧂 Ít natri</button>
      <button class="badge filter-btn" data-filter="high-sodium">🧂 Nhiều natri</button>
      <button class="badge filter-btn" data-filter="high-fiber">🌿 Giàu xơ</button>
      <button class="badge filter-btn" data-filter="high-calcium">🦴 Nhiều canxi</button>
    </div>
  </details>

  <!-- Foods rendered client-side from JSON -->
  <div id="foods-container">
    <div class="food-loading-grid" id="foods-loading" aria-hidden="true">
      <div class="food-loading-card"></div>
      <div class="food-loading-card"></div>
      <div class="food-loading-card"></div>
      <div class="food-loading-card"></div>
      <div class="food-loading-card"></div>
      <div class="food-loading-card"></div>
    </div>
  </div>
  <div class="empty-state" id="foods-empty-state" hidden>
    <strong>Không có thực phẩm nào khớp bộ lọc hiện tại.</strong>
    <p>Thử bỏ bớt một điều kiện hoặc chuyển sang nhóm rộng hơn để so sánh lại.</p>
  </div>
</BaseLayout>

<style>
  .quick-nav { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .usage-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .usage-step {
    padding: 12px 14px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    background: var(--bg-soft);
  }
  .usage-step strong {
    display: block;
    margin-bottom: 4px;
    font-size: 0.86rem;
  }
  .usage-step p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .quick-start-panel {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
  }
  .quick-start-copy strong { display: block; margin-bottom: 4px; font-size: 0.9rem; }
  .quick-start-copy p { margin: 0; color: var(--ink-secondary); font-size: 0.84rem; line-height: 1.55; }
  .quick-start-links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .quick-start-links a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--card);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .quick-start-links a:hover { border-color: var(--brand-light2); color: var(--brand-dark); background: var(--brand-light); }
  .filter-panel {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .filter-panel-summary { cursor: pointer; list-style: none; }
  .filter-panel-summary::-webkit-details-marker { display: none; }
  .filter-panel-body { margin-top: 12px; }
  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .panel-head strong {
    display: block;
    margin-bottom: 3px;
    font-size: 0.92rem;
  }
  .panel-head p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .panel-base {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-tertiary);
    font-size: 0.74rem;
    white-space: nowrap;
  }
  .panel-summary-side {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .panel-toggle-text {
    display: none;
    min-height: 28px;
    align-items: center;
    font-size: 0.78rem;
    color: var(--brand-dark);
    font-weight: 700;
  }
  .filter-summary {
    margin-top: 10px;
    min-height: 20px;
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
  }
  .filter-row + .filter-row { margin-top: 10px; }
  .filter-row label { display: grid; gap: 5px; }
  .filter-row label span {
    font-size: 0.82rem;
    color: var(--ink-secondary);
    font-weight: 600;
  }
  .filter-row select,
  .filter-row input {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    background: var(--card);
    color: inherit;
    transition: all var(--transition);
  }
  .filter-row select:focus,
  .filter-row input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    outline: none;
  }
  .numeric-row { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .tag-filter-panel {
    margin: 16px 0;
    padding: 12px 14px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .tag-filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    list-style: none;
  }
  .tag-filter-summary::-webkit-details-marker { display: none; }
  .tag-filter-summary strong {
    font-size: 0.86rem;
  }
  .tag-filter-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-size: 0.78rem;
    color: var(--brand-dark);
    font-weight: 700;
  }
  .tag-filter-panel[open] .tag-filter-toggle::before { content: "Ẩn tag"; }
  .tag-filter-panel:not([open]) .tag-filter-toggle::before { content: "Mở tag"; }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .filter-btn { cursor: pointer; border: 1px solid var(--card-border); border-radius: var(--radius-lg); user-select: none; transition: all var(--transition); background: var(--card); color: var(--ink-secondary); box-shadow: var(--shadow-sm); }
  .filter-btn:hover { border-color: var(--brand-light2); color: var(--brand); box-shadow: var(--shadow); transform: translateY(-1px); }
  .filter-btn.active { background: var(--brand); color: white; border-color: var(--brand); box-shadow: var(--shadow); transform: none; font-weight: 500; }
  :global(.food-group-title) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
  }
  :global(.food-group-meta) {
    color: var(--ink-tertiary);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  :global(.food-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  :global(.food-card) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    background: var(--card);
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    min-height: 100%;
  }
  :global(.food-card:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
    border-color: var(--brand-light2);
  }
  :global(.food-card-icon) {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: var(--bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.45rem;
  }
  :global(.food-card-body) {
    flex: 1;
    min-width: 0;
    width: 100%;
  }
  :global(.food-card-topline) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    margin-bottom: 6px;
  }
  :global(.food-card-topline h3) {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.food-card-base) {
    font-size: 0.74rem;
    color: var(--ink-tertiary);
    white-space: nowrap;
  }
  :global(.food-card-metrics) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
  }
  :global(.food-card-metrics span) {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-secondary);
    font-size: 0.76rem;
  }
  :global(.food-card-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 28px;
  }
  :global(.food-card-cta) {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  :global(.food-card-cta span) {
    color: var(--brand-dark);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .cross-cta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .cross-cta-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cross-cta-strip a:hover {
    border-color: var(--brand-light2);
    background: var(--brand-light);
    color: var(--brand-dark);
  }
  :global(.food-mini-tag) {
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.food-fit-tag) { font-weight: 600; }
  :global(.food-fit-green) { background: #e8f5e9; color: #2e7d32; }
  :global(.food-fit-red) { background: #fce4ec; color: #c62828; }
  :global(.food-fit-blue) { background: #e8eaf6; color: #283593; }
  :global(.food-fit-amber) { background: #fff8e1; color: #f57f17; }
  .empty-state {
    margin-top: 16px;
    padding: 20px 18px;
    border: 1px dashed var(--card-border);
    border-radius: 14px;
    background: var(--bg-soft);
    text-align: center;
  }
  .empty-state strong {
    display: block;
    margin-bottom: 6px;
    font-size: 0.92rem;
  }
  .empty-state p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .food-loading-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .food-loading-card {
    min-height: 116px;
    border-radius: 12px;
    background: linear-gradient(90deg, var(--bg-soft) 25%, var(--bg-elevated) 50%, var(--bg-soft) 75%);
    background-size: 200% 100%;
    animation: foodShimmer 1.4s ease-in-out infinite;
  }
  @keyframes foodShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .food-group.is-empty { display: none; }
  @media (max-width: 760px) {
    .usage-strip { grid-template-columns: 1fr; }
    .quick-start-panel { grid-template-columns: 1fr; }
    .quick-start-links { justify-content: flex-start; }
    .panel-head { flex-direction: column; }
    .filter-row,
    .numeric-row { grid-template-columns: 1fr; }
    .food-loading-grid { grid-template-columns: 1fr; }
    .filter-panel { padding: 12px 14px; }
    .filter-panel-summary .panel-head { margin-bottom: 0; }
    .filter-panel-body { margin-top: 14px; }
    .panel-summary-side {
      width: 100%;
      justify-content: space-between;
    }
    .panel-toggle-text { display: inline-flex; }
    .filter-panel[open] .panel-toggle-text::before { content: "Ẩn bộ lọc"; }
    .filter-panel:not([open]) .panel-toggle-text::before { content: "Mở bộ lọc"; }
    .quick-nav { display: none; }
    .tag-filter-panel {
      padding: 12px 14px;
    }
  }
  @media (max-width: 600px) {
    :global(.food-grid) { grid-template-columns: 1fr; gap: 10px; }
    :global(.food-card) { padding: 12px; gap: 9px; }
    :global(.food-card-topline) { align-items: flex-start; flex-direction: column; gap: 4px; }
    :global(.food-card-topline h3) { font-size: 0.92rem; }
    :global(.food-card-base) { font-size: 0.72rem; }
    :global(.food-card-metrics) { gap: 5px; }
    :global(.food-card-metrics span) { font-size: 0.74rem; }
    .filter-btn { padding: 8px 12px; font-size: 0.8rem; min-height: 44px; }
  }
</style>

<script is:inline>
  var foodsData = null;
  var loaded = false;
  var activeTag = 'all';
  var categoryFilter = document.getElementById('category-filter');
  var sortSelect = document.getElementById('sort-select');
  var profileFilter = document.getElementById('profile-filter');
  var maxKcal = document.getElementById('max-kcal');
  var minProtein = document.getElementById('min-protein');
  var maxCarb = document.getElementById('max-carb');
  var maxSodium = document.getElementById('max-sodium');
  var summary = document.getElementById('filter-summary');
  var foodsEmptyState = document.getElementById('foods-empty-state');
  var filterPanel = document.querySelector('.filter-panel');
  var tagFilterPanel = document.querySelector('.tag-filter-panel');
  var params = new URLSearchParams(window.location.search);

  if (filterPanel && window.innerWidth <= 760) {
    filterPanel.removeAttribute('open');
  }
  if (tagFilterPanel && window.innerWidth <= 760) {
    tagFilterPanel.removeAttribute('open');
  }

  function numberValue(el) {
    if (!el || el.value === '') return null;
    var value = Number(el.value);
    return Number.isFinite(value) ? value : null;
  }

  function tagsOf(card) {
    return (card.getAttribute('data-tags') || '').split(' ').filter(Boolean);
  }

  function hasTag(card, tag) {
    return tagsOf(card).indexOf(tag) >= 0;
  }

  function labelOf(tag) {
    var map = {
      'vegan': 'Thuần chay',
      'high-protein': 'Nhiều đạm',
      'low-fat': 'Ít béo',
      'glycemic-index-low': 'GI thấp',
      'glycemic-index-high': 'GI cao',
      'low-purine': 'Ít purin',
      'high-purine': 'Nhiều purin',
      'low-sodium': 'Ít natri',
      'high-sodium': 'Nhiều natri',
      'high-fiber': 'Giàu xơ',
      'high-calcium': 'Nhiều canxi'
    };
    return map[tag] || tag;
  }

  function matchesProfile(card, profile) {
    var kcal = Number(card.getAttribute('data-kcal') || 0);
    var fiber = Number(card.getAttribute('data-fiber') || 0);
    var sodium = Number(card.getAttribute('data-sodium') || 0);
    var potassium = Number(card.getAttribute('data-potassium') || 0);
    if (profile === 'diabetes') return hasTag(card, 'glycemic-load-low') || hasTag(card, 'glycemic-index-low');
    if (profile === 'hypertension') return sodium <= 100 || hasTag(card, 'low-sodium');
    if (profile === 'gout') return hasTag(card, 'low-purine');
    if (profile === 'ckd') return sodium <= 100 && potassium <= 150;
    if (profile === 'weight') return kcal <= 150 && (fiber >= 2 || hasTag(card, 'low-fat'));
    return true;
  }

  function sortCards() {
    var val = sortSelect?.value || 'name-asc';
    document.querySelectorAll('.food-group').forEach(function(group) {
      var grid = group.querySelector('.food-grid');
      if (!grid) return;
      var cards = Array.from(grid.querySelectorAll('.food-card'));
      cards.sort(function(a, b) {
        var aName = (a.querySelector('h3')?.textContent || '');
        var bName = (b.querySelector('h3')?.textContent || '');
        if (val === 'name-asc') return aName.localeCompare(bName, 'vi');
        if (val === 'name-desc') return bName.localeCompare(aName, 'vi');
        if (val === 'calo-asc') return (parseFloat(a.getAttribute('data-kcal') || '0')) - (parseFloat(b.getAttribute('data-kcal') || '0'));
        if (val === 'calo-desc') return (parseFloat(b.getAttribute('data-kcal') || '0')) - (parseFloat(a.getAttribute('data-kcal') || '0'));
        if (val === 'protein-desc') return (parseFloat(b.getAttribute('data-protein') || '0')) - (parseFloat(a.getAttribute('data-protein') || '0'));
        if (val === 'sodium-asc') return (parseFloat(a.getAttribute('data-sodium') || '0')) - (parseFloat(b.getAttribute('data-sodium') || '0'));
        if (val === 'fiber-desc') return (parseFloat(b.getAttribute('data-fiber') || '0')) - (parseFloat(a.getAttribute('data-fiber') || '0'));
        return 0;
      });
      cards.forEach(function(card) { grid.appendChild(card); });
    });
  }

  function applyFilters() {
    var selectedCategory = categoryFilter?.value || 'all';
    var selectedProfile = profileFilter?.value || 'all';
    var maxKcalValue = numberValue(maxKcal);
    var minProteinValue = numberValue(minProtein);
    var maxCarbValue = numberValue(maxCarb);
    var maxSodiumValue = numberValue(maxSodium);
    var visible = 0;

    document.querySelectorAll('.food-card').forEach(function(card) {
      var tags = tagsOf(card);
      var category = card.getAttribute('data-category') || '';
      var kcal = Number(card.getAttribute('data-kcal') || 0);
      var protein = Number(card.getAttribute('data-protein') || 0);
      var carb = Number(card.getAttribute('data-carb') || 0);
      var sodium = Number(card.getAttribute('data-sodium') || 0);
      var ok = true;
      if (activeTag !== 'all' && tags.indexOf(activeTag) < 0) ok = false;
      if (selectedCategory !== 'all' && category !== selectedCategory) ok = false;
      if (maxKcalValue !== null && kcal > maxKcalValue) ok = false;
      if (minProteinValue !== null && protein < minProteinValue) ok = false;
      if (maxCarbValue !== null && carb > maxCarbValue) ok = false;
      if (maxSodiumValue !== null && sodium > maxSodiumValue) ok = false;
      if (!matchesProfile(card, selectedProfile)) ok = false;
      card.style.display = ok ? '' : 'none';
      if (ok) visible += 1;
    });

    document.querySelectorAll('.food-group').forEach(function(group) {
      var hasVisible = Array.from(group.querySelectorAll('.food-card')).some(function(card) {
        return card.style.display !== 'none';
      });
      group.classList.toggle('is-empty', !hasVisible);
    });
    if (summary) summary.textContent = 'Đang hiển thị ' + visible + ' / ' + document.querySelectorAll('.food-card').length + ' thực phẩm.';
    if (foodsEmptyState) foodsEmptyState.hidden = visible !== 0;
  }

  document.addEventListener('click', function(e) {
    var target = e.target;
    var btn = target.closest('.filter-btn');
    if (btn) {
      activeTag = btn.getAttribute('data-filter') || 'all';
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyFilters();
      return;
    }
    if (target.closest('#reset-filters')) {
      activeTag = 'all';
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-filter') === 'all'); });
      if (categoryFilter) categoryFilter.value = 'all';
      if (profileFilter) profileFilter.value = 'all';
      [maxKcal, minProtein, maxCarb, maxSodium].forEach(function(el) { if (el) el.value = ''; });
      applyFilters();
    }
  });

  [categoryFilter, profileFilter, maxKcal, minProtein, maxCarb, maxSodium].forEach(function(el) {
    el?.addEventListener('input', applyFilters);
    el?.addEventListener('change', applyFilters);
  });
  function applyUrlPresets() {
    var profile = params.get('profile');
    var category = params.get('category');
    var tag = params.get('tag');
    if (profile && profileFilter?.querySelector('option[value="' + CSS.escape(profile) + '"]')) profileFilter.value = profile;
    if (category && categoryFilter?.querySelector('option[value="' + CSS.escape(category) + '"]')) categoryFilter.value = category;
    if (tag && document.querySelector('.filter-btn[data-filter="' + CSS.escape(tag) + '"]')) {
      activeTag = tag;
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-filter') === tag); });
    }
    if (params.get('maxKcal') && maxKcal) maxKcal.value = params.get('maxKcal');
    if (params.get('minProtein') && minProtein) minProtein.value = params.get('minProtein');
    if (params.get('maxCarb') && maxCarb) maxCarb.value = params.get('maxCarb');
    if (params.get('maxSodium') && maxSodium) maxSodium.value = params.get('maxSodium');
  }
  sortSelect?.addEventListener('change', function() {
    sortCards();
    applyFilters();
  });

  function renderFoods(data) {
    foodsData = data;
    loaded = true;
    // Group by category (index 2)
    var groups = {};
    for (var i = 0; i < data.length; i++) {
      var item = data[i];
      var cat = item[2];
      if (!groups[cat]) groups[cat] = [];
      groups[cat].push(item);
    }
    var cats = Object.keys(groups).sort(function(a,b) { return a.localeCompare(b, 'vi'); });
    var container = document.getElementById('foods-container');
    var html = '';
    for (var c = 0; c < cats.length; c++) {
      var catName = cats[c];
      var items = groups[catName];
      html += '<section class="section food-group" id="' + encodeURIComponent(catName) + '" data-category="' + catName + '">';
      html += '<div class="food-group-title"><h2 style="display:flex;align-items:center;gap:8px;margin:0;"><span class="fi">' + getIcon(catName) + '</span> ' + catName + '</h2><span class="food-group-meta">' + items.length + ' mục</span></div>';
      html += '<div class="grid three food-grid" style="margin-top:12px;">';
      for (var i = 0; i < items.length; i++) {
        html += renderCard(items[i]);
      }
      html += '</div></section>';
    }
    container.innerHTML = html;
    document.getElementById('foods-loading')?.remove();
    applyFilters();
  }

  function getIcon(cat) {
    var icons = {
      'Tinh bột': '🍚','Rau củ': '🥬','Trái cây': '🍎','Thịt': '🥩','Cá': '🐟','Hải sản': '🦐','Trứng': '🥚',
      'Sữa': '🥛','Đậu': '🫘','Hạt': '🥜','Dầu': '🫒','Gia vị': '🧂','Đồ uống': '🥤','Bánh kẹo': '🍪','Khác': '📦'
    };
    return icons[cat] || '🍽️';
  }

  function renderCard(item) {
    var s = item[0], n = item[1], t = item[10], kcal = item[3], p = item[4], cb = item[5], fat = item[6], fb = item[7];
    var tagList = (t || '').split(' ').filter(Boolean);
    var quickFits = [];
    if (tagList.indexOf('low-sodium') >= 0) quickFits.push({ label: 'THA', tone: 'green' });
    if (tagList.indexOf('low-purine') >= 0) quickFits.push({ label: 'Gout', tone: 'red' });
    if (tagList.indexOf('glycemic-index-low') >= 0) quickFits.push({ label: 'ĐTĐ', tone: 'blue' });
    if (Number(kcal) <= 150) quickFits.push({ label: 'Nhẹ kcal', tone: 'amber' });
    var metricList = ['<span>' + kcal + ' kcal</span>'];
    if (p > 0) metricList.push('<span>Đạm ' + p + 'g</span>');
    if (cb > 0) metricList.push('<span>Carb ' + cb + 'g</span>');
    else if (fb > 0) metricList.push('<span>Xơ ' + fb + 'g</span>');
    else if (Number(item[8]) > 0) metricList.push('<span>Natri ' + item[8] + 'mg</span>');
    var tagHtml = tagList.slice(0, 1).map(function(tag) {
      return '<span class="food-mini-tag">' + labelOf(tag) + '</span>';
    }).join('');
    var fitHtml = quickFits.slice(0, Math.max(0, 2 - (tagHtml ? 1 : 0))).map(function(fit) {
      return '<span class="food-mini-tag food-fit-tag food-fit-' + fit.tone + '">' + fit.label + '</span>';
    }).join('');
    return '<a class="food-card" href="/thuc-pham/' + s + '" data-tags="' + t + '" data-category="' + item[2] + '" data-kcal="' + kcal + '" data-protein="' + p + '" data-carb="' + cb + '" data-fat="' + fat + '" data-fiber="' + fb + '" data-sodium="' + item[8] + '" data-potassium="' + item[9] + '" data-gi="' + item[11] + '">' +
      '<div class="food-card-icon">' + getIcon(item[2]) + '</div>' +
      '<div class="food-card-body">' +
        '<div class="food-card-topline"><h3>' + n + '</h3><span class="food-card-base">Theo 100g</span></div>' +
        '<div class="food-card-metrics">' + metricList.join('') + '</div>' +
        '<div class="food-card-tags">' + tagHtml + fitHtml + '</div>' +
        '<div class="food-card-cta"><span>Xem chi tiết</span></div>' +
      '</div>' +
    '</a>';
  }

  // Quick nav rebuild
  function refreshQuickNav() {
    var nav = document.querySelector('.quick-nav');
    if (!nav || !foodsData) return;
    var groups = {};
    for (var i = 0; i < foodsData.length; i++) {
      var cat = foodsData[i][2];
      if (!groups[cat]) groups[cat] = 0;
      groups[cat]++;
    }
    var cats = Object.keys(groups).sort(function(a,b) { return a.localeCompare(b, 'vi'); });
    var inner = '<span class="muted" style="font-size:0.85rem;">Nhảy nhanh: </span>';
    for (var c = 0; c < cats.length; c++) {
      inner += '<a class="badge" href="#' + encodeURIComponent(cats[c]) + '">' + cats[c] + ' · ' + groups[cats[c]] + '</a>';
    }
    nav.innerHTML = inner;
  }

  applyUrlPresets();
  // Load data lazy
  if ('requestIdleCallback' in window) {
    requestIdleCallback(function() {
      fetch('/api/foods-full.json').then(function(r) { return r.json(); }).then(renderFoods).then(refreshQuickNav);
    });
  } else {
    setTimeout(function() {
      fetch('/api/foods-full.json').then(function(r) { return r.json(); }).then(renderFoods).then(refreshQuickNav);
    }, 500);
  }
</script>
