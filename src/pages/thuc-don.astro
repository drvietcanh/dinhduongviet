---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articles } from "../data/articles";

const menus = articles.filter((article) => article.displayCategory === "thuc-don");
const menuGroups = [
  { key: "noi-tiet", title: "Đái tháo đường, gout và chuyển hóa", emoji: "🩸" },
  { key: "tim-mach", title: "Tim mạch, huyết áp và mỡ máu", emoji: "❤️" },
  { key: "tieu-hoa", title: "Dạ dày, gan và tiêu hóa", emoji: "🍲" },
  { key: "than-tiet-nieu", title: "Thận và tiết niệu", emoji: "🫘" },
  { key: "phu-nu-nhi", title: "Phụ nữ, trẻ em và người cao tuổi", emoji: "👪" },
];
const groupedSlugs = new Set(menuGroups.flatMap((group) => menus.filter((article) => article.specialty === group.key).map((article) => article.slug)));
const otherMenus = menus.filter((article) => !groupedSlugs.has(article.slug));
---

<BaseLayout
  title="Thực đơn mẫu và công cụ lập bữa ăn | Dinh Dưỡng Việt"
  description="Xem thực đơn mẫu theo bệnh lý, hoàn cảnh và lứa tuổi; sau đó dùng công cụ lập kế hoạch bữa ăn và danh sách đi chợ để áp dụng."
  canonical="/thuc-don"
>
  <div class="meal-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span>/</span><span>Thực đơn</span>
    </nav>

    <header class="meal-header">
      <p class="eyebrow">Bắt đầu từ mẫu, điều chỉnh theo nhu cầu</p>
      <h1>Thực đơn mẫu</h1>
      <p>Các thực đơn dưới đây là gợi ý tham khảo. Hãy chọn đúng nhóm bệnh hoặc hoàn cảnh, rồi điều chỉnh khẩu phần theo cân nặng, thuốc, xét nghiệm và hướng dẫn của nhân viên y tế.</p>
      <div class="actions">
        <a class="primary" href="/cong-cu/ke-hoach-bua-an">Lập kế hoạch bữa ăn</a>
        <a href="/cong-cu/lap-thuc-don-tuan">Lập thực đơn tuần</a>
        <a href="/cong-cu/danh-sach-di-cho">Tạo danh sách đi chợ</a>
      </div>
    </header>

    {menuGroups.map((group) => {
      const items = menus.filter((article) => article.specialty === group.key);
      if (!items.length) return null;
      return (
        <section class="meal-section">
          <h2><span aria-hidden="true">{group.emoji}</span> {group.title}</h2>
          <div class="meal-grid">
            {items.map((article) => (
              <a class="meal-card" href={`/kien-thuc-dinh-duong/${article.slug}`}>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span>{article.readTime} phút đọc</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {otherMenus.length > 0 && (
      <section class="meal-section">
        <h2>Thực đơn khác</h2>
        <div class="meal-grid">
          {otherMenus.map((article) => (
            <a class="meal-card" href={`/kien-thuc-dinh-duong/${article.slug}`}>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <span>{article.readTime} phút đọc</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <style>
    .meal-page { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
    .breadcrumb { display: flex; gap: 8px; margin-bottom: 1rem; color: var(--ink-secondary); font-size: .88rem; }
    .meal-header { padding: 24px 0 28px; border-bottom: 1px solid var(--line); }
    .eyebrow { margin: 0 0 8px; color: var(--brand-dark); font-size: .82rem; font-weight: 700; text-transform: uppercase; }
    h1 { margin: 0 0 12px; font-size: 2rem; }
    .meal-header > p:not(.eyebrow) { max-width: 760px; color: var(--ink-secondary); line-height: 1.65; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
    .actions a { min-height: 44px; display: inline-flex; align-items: center; padding: 9px 16px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); font-weight: 700; text-decoration: none; }
    .actions .primary { border-color: var(--brand); background: var(--brand); color: #fff; }
    .meal-section { padding-top: 28px; }
    .meal-section h2 { margin: 0 0 14px; font-size: 1.2rem; }
    .meal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
    .meal-card { padding: 16px; border: 1px solid var(--line); border-radius: 8px; color: inherit; text-decoration: none; background: var(--card); }
    .meal-card:hover { border-color: var(--brand); box-shadow: var(--shadow-sm); }
    .meal-card h3 { margin: 0 0 8px; font-size: 1rem; line-height: 1.4; }
    .meal-card p { margin: 0 0 12px; color: var(--ink-secondary); font-size: .88rem; line-height: 1.55; }
    .meal-card span { color: var(--brand-dark); font-size: .8rem; font-weight: 700; }
    @media (max-width: 600px) { .meal-page { padding-inline: 1rem; } h1 { font-size: 1.7rem; } }
  </style>
</BaseLayout>
