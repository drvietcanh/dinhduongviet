---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articles } from "../data/articles";

const menus = articles.filter((article) => article.displayCategory === "thuc-don");
const menuGroups = [
  { key: "noi-tiet", title: "Đái tháo đường, gout và chuyển hóa", emoji: "🩸", summary: "Ưu tiên khi cần kiểm soát đường huyết, axit uric hoặc giảm tải chuyển hóa mà vẫn giữ bữa ăn quen thuộc." },
  { key: "tim-mach", title: "Tim mạch, huyết áp và mỡ máu", emoji: "❤️", summary: "Phù hợp khi cần ăn nhạt hơn, giảm mỡ bão hòa và sắp bữa đều đặn hơn mỗi ngày." },
  { key: "tieu-hoa", title: "Dạ dày, gan và tiêu hóa", emoji: "🍲", summary: "Dành cho người cần bữa ăn nhẹ bụng hơn, ít kích thích hơn và dễ duy trì trong sinh hoạt thường ngày." },
  { key: "than-tiet-nieu", title: "Thận và tiết niệu", emoji: "🫘", summary: "Chỉ nên dùng như gợi ý nhập môn trước khi cá thể hóa theo xét nghiệm, thuốc và tư vấn điều trị." },
  { key: "phu-nu-nhi", title: "Phụ nữ, trẻ em và người cao tuổi", emoji: "👪", summary: "Nhóm dành cho các giai đoạn sống cần khẩu phần mềm hơn, linh hoạt hơn hoặc có nhu cầu theo dõi riêng." },
];
const groupedSlugs = new Set(menuGroups.flatMap((group) => menus.filter((article) => article.specialty === group.key).map((article) => article.slug)));
const otherMenus = menus.filter((article) => !groupedSlugs.has(article.slug));
const quickFilters = [
  { href: "#group-noi-tiet", label: "Đường huyết - gout" },
  { href: "#group-tim-mach", label: "Huyết áp - tim mạch" },
  { href: "#group-tieu-hoa", label: "Dạ dày - gan" },
  { href: "#group-than-tiet-nieu", label: "Bệnh thận" },
  { href: "#group-phu-nu-nhi", label: "Gia đình - người cao tuổi" },
];
---

<BaseLayout
  title="Thực đơn mẫu và công cụ lập bữa ăn | Dinh Dưỡng Việt"
  description="Xem thực đơn mẫu theo bệnh lý, hoàn cảnh và lứa tuổi; sau đó dùng công cụ lập kế hoạch bữa ăn và danh sách đi chợ để áp dụng."
  canonical="/thuc-don"
>
  <div class="meal-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span>/</span><span>Thực đơn</span>
    </nav>

    <header class="meal-header">
      <p class="eyebrow">Bắt đầu từ mẫu, điều chỉnh theo nhu cầu</p>
      <h1>Thực đơn mẫu</h1>
      <p>Các thực đơn dưới đây là gợi ý tham khảo. Hãy chọn đúng nhóm bệnh hoặc hoàn cảnh, rồi điều chỉnh khẩu phần theo cân nặng, thuốc, xét nghiệm và hướng dẫn của nhân viên y tế.</p>
      <div class="actions">
        <a class="primary" href="/cong-cu/ke-hoach-bua-an">Lập kế hoạch bữa ăn</a>
        <a href="/cong-cu/lap-thuc-don-tuan">Lập thực đơn tuần</a>
        <a href="/cong-cu/danh-sach-di-cho">Tạo danh sách đi chợ</a>
      </div>
      <div class="quick-filters" aria-label="Chọn nhanh nhóm thực đơn">
        {quickFilters.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="meal-steps">
        <div class="step-card">
          <strong>1. Chọn đúng nhóm</strong>
          <p>Bắt đầu từ bệnh hoặc hoàn cảnh chính đang cần giải quyết, thay vì đọc dàn trải nhiều thực đơn cùng lúc.</p>
        </div>
        <div class="step-card">
          <strong>2. Chọn mức gần với đời sống</strong>
          <p>Ưu tiên mẫu bình dân, bận rộn hoặc người lớn tuổi tùy tình huống thực tế để dễ áp dụng hơn.</p>
        </div>
        <div class="step-card">
          <strong>3. Dùng công cụ để chỉnh</strong>
          <p>Sau khi chọn mẫu phù hợp, mới chuyển sang kế hoạch bữa ăn, danh sách đi chợ hoặc nhật ký.</p>
        </div>
      </div>
    </header>

    {menuGroups.map((group) => {
      const items = menus.filter((article) => article.specialty === group.key);
      if (!items.length) return null;
      return (
        <section class="meal-section" id={`group-${group.key}`}>
          <div class="meal-section-head">
            <h2><span aria-hidden="true">{group.emoji}</span> {group.title}</h2>
            <p>{group.summary}</p>
          </div>
          <div class="meal-grid">
            {items.map((article) => (
              <a class="meal-card" href={`/kien-thuc-dinh-duong/${article.slug}`}>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <div class="meal-meta">
                  <span>{article.readTime} phút đọc</span>
                  <span>Xem chi tiết →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {otherMenus.length > 0 && (
      <section class="meal-section">
        <div class="meal-section-head">
          <h2>Thực đơn khác</h2>
          <p>Các lựa chọn này phù hợp khi bạn cần thêm biến thể ngoài những nhóm bệnh hoặc hoàn cảnh chính ở trên.</p>
        </div>
        <div class="meal-grid">
          {otherMenus.map((article) => (
            <a class="meal-card" href={`/kien-thuc-dinh-duong/${article.slug}`}>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <div class="meal-meta">
                <span>{article.readTime} phút đọc</span>
                <span>Xem chi tiết →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <style>
    .meal-page { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
    .breadcrumb { display: flex; gap: 8px; margin-bottom: 1rem; color: var(--ink-secondary); font-size: .88rem; }
    .meal-header { padding: 24px 0 28px; border-bottom: 1px solid var(--line); }
    .eyebrow { margin: 0 0 8px; color: var(--brand-dark); font-size: .82rem; font-weight: 700; text-transform: uppercase; }
    h1 { margin: 0 0 12px; font-size: 2rem; }
    .meal-header > p:not(.eyebrow) { max-width: 760px; color: var(--ink-secondary); line-height: 1.65; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
    .actions a { min-height: 44px; display: inline-flex; align-items: center; padding: 9px 16px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); font-weight: 700; text-decoration: none; }
    .actions .primary { border-color: var(--brand); background: var(--brand); color: #fff; }
    .quick-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .quick-filters a { display: inline-flex; min-height: 38px; align-items: center; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-soft); color: var(--ink-secondary); font-size: .82rem; font-weight: 700; text-decoration: none; }
    .quick-filters a:hover { border-color: var(--brand-light2); color: var(--brand-dark); background: var(--brand-light); }
    .meal-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 20px; }
    .step-card { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-soft); }
    .step-card strong { display: block; margin-bottom: 6px; font-size: .9rem; }
    .step-card p { margin: 0; color: var(--ink-secondary); font-size: .84rem; line-height: 1.55; }
    .meal-section { padding-top: 28px; }
    .meal-section-head { margin-bottom: 14px; }
    .meal-section h2 { margin: 0 0 6px; font-size: 1.2rem; }
    .meal-section-head p { margin: 0; max-width: 760px; color: var(--ink-secondary); font-size: .88rem; line-height: 1.6; }
    .meal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
    .meal-card { padding: 16px; border: 1px solid var(--line); border-radius: 8px; color: inherit; text-decoration: none; background: var(--card); }
    .meal-card:hover { border-color: var(--brand); box-shadow: var(--shadow-sm); }
    .meal-card h3 { margin: 0 0 8px; font-size: 1rem; line-height: 1.4; }
    .meal-card p { margin: 0 0 12px; color: var(--ink-secondary); font-size: .88rem; line-height: 1.55; }
    .meal-meta { display: flex; justify-content: space-between; gap: 10px; color: var(--brand-dark); font-size: .8rem; font-weight: 700; }
    @media (max-width: 820px) { .meal-steps { grid-template-columns: 1fr; } }
    @media (max-width: 600px) {
      .meal-page { padding-inline: 1rem; }
      h1 { font-size: 1.7rem; }
      .meal-meta { flex-direction: column; gap: 4px; }
    }
  </style>
</BaseLayout>
