---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="404 - Trang không tìm thấy | Dinh Dưỡng Việt">
  <div style="text-align:center;padding:80px 20px;max-width:600px;margin:0 auto">
    <div style="font-size:4rem;margin-bottom:12px">🔍</div>
    <h1>404 — Trang không tìm thấy</h1>
    <p style="font-size:1.1rem;color:var(--ink-secondary);margin-bottom:24px;">Không tìm thấy thực phẩm, món ăn hay bài viết tại địa chỉ này.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <a href="/" style="display:inline-block;padding:10px 22px;border-radius:999px;font-weight:600;background:var(--brand);color:white;text-decoration:none;">🏠 Về trang chủ</a>
      <a href="/thuc-pham" style="display:inline-block;padding:10px 22px;border-radius:999px;font-weight:600;background:var(--ink-tertiary);color:white;text-decoration:none;">🥬 Tra thực phẩm</a>
      <a href="/tim-kiem" style="display:inline-block;padding:10px 22px;border-radius:999px;font-weight:600;background:var(--ink-tertiary);color:white;text-decoration:none;">🔍 Tìm kiếm</a>
    </div>
  </div>
</BaseLayout>
