---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Thống Kê Dinh Dưỡng | Dinh dưỡng Việt";
const pageDescription = "Biểu đồ theo dõi quá trình dinh dưỡng, lượng Calo tiêu thụ và năng lượng hấp thụ trong tuần.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="analytics-container">
    <div class="text-center" style="margin-bottom: 32px;">
      <span class="badge" style="background: linear-gradient(135deg, #10b981, #059669); color: white;">📈 Analytics Dashboard</span>
      <h1 style="margin-top: 10px;">Báo Cáo Dinh Dưỡng</h1>
      <p class="lead">Dữ liệu tổng quan 7 ngày gần nhất dựa trên Sổ Tay Nhật Ký của bạn.</p>
      <button onclick="window.print()" class="btn btn-primary btn-print" style="margin-top: 16px; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 10px 20px; font-weight: 600; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(16,185,129,0.3);">🖨️ Xuất Báo Cáo (PDF)</button>
    </div>

    <!-- Summary Cards -->
    <div class="summary-grid">
      <div class="summary-card">
        <div class="sc-title">Trung bình Calo nạp (7 ngày)</div>
        <div class="sc-value" id="avg-calo">0 <span style="font-size: 1rem; color: var(--ink-secondary);">Kcal</span></div>
      </div>
      <div class="summary-card">
        <div class="sc-title">Ngày ăn nhiều nhất</div>
        <div class="sc-value" id="max-calo">0 <span style="font-size: 1rem; color: var(--ink-secondary);">Kcal</span></div>
      </div>
      <div class="summary-card">
        <div class="sc-title">Lượng Nước trung bình</div>
        <div class="sc-value" id="avg-water">0 <span style="font-size: 1rem; color: var(--ink-secondary);">ml</span></div>
      </div>
    </div>

    <!-- Charts Area -->
    <div class="chart-section card">
      <div class="chart-header">
        <h2>🔥 Biểu đồ Calo 7 ngày qua</h2>
        <p class="muted" style="margin-bottom: 20px;">So sánh giữa Calo bạn đã nạp vào so với Mục tiêu của bạn.</p>
      </div>
      <div class="chart-wrapper">
        <canvas id="caloChart"></canvas>
      </div>
    </div>

    <div class="chart-section card" style="margin-top: 24px;">
      <div class="chart-header">
        <h2>💧 Biểu đồ Nước uống 7 ngày qua</h2>
      </div>
      <div class="chart-wrapper">
        <canvas id="waterChart"></canvas>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .analytics-container { max-width: 900px; margin: 0 auto; padding: 24px 0; }

  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .summary-card {
    background: var(--card); padding: 20px; border-radius: var(--radius-lg);
    border: 1px solid var(--card-border); text-align: center;
    box-shadow: var(--shadow-sm); transition: transform 0.3s;
  }
  .summary-card:hover { transform: translateY(-4px); border-color: var(--brand); }
  .sc-title { font-size: 0.95rem; font-weight: 600; color: var(--ink-secondary); margin-bottom: 8px; }
  .sc-value { font-size: 2.2rem; font-weight: 800; color: var(--brand); }

  .chart-section { padding: 24px; }
  .chart-wrapper { position: relative; height: 350px; width: 100%; }

  @media(max-width: 600px) {
    .chart-wrapper { height: 250px; }
  }

  /* Định dạng dành riêng cho lúc Xuất PDF (Print Mode) */
  @media print {
    :global(.top-bar), :global(.footer), :global(#scroll-top-btn), .btn-print {
      display: none !important;
    }
    body { background: white !important; color: black !important; }
    .analytics-container { max-width: 100% !important; padding: 0 !important; }
    .summary-card, .chart-section {
      break-inside: avoid;
      box-shadow: none !important;
      border: 1px solid #ccc !important;
    }
  }
</style>

<!-- Tích hợp Chart.js từ CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Get Dates (Last 7 Days)
    const dates = [];
    const labels = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      dates.push(d);
      labels.push(d.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' }));
    }

    // 2. Read from LocalStorage
    const caloData = [];
    const targetData = [];
    const waterData = [];

    let totalCalo7Days = 0;
    let maxCalo = 0;
    let totalWater7Days = 0;
    let daysWithData = 0;

    // Lấy mục tiêu chung
    let globalTarget = 2000;
    try {
      const raw = localStorage.getItem('mt-target-v2');
      if (raw) globalTarget = JSON.parse(raw).kcal || 2000;
    } catch(e) {}

    dates.forEach(d => {
      // Đọc Calo
      const diaryKey = `ddv_diary_${d.getFullYear()}_${d.getMonth()+1}_${d.getDate()}`;
      const diaryStr = localStorage.getItem(diaryKey);
      let dayCalo = 0;
      if (diaryStr) {
        try {
          const meals = JSON.parse(diaryStr);
          Object.values(meals).forEach(meal => {
            meal.forEach(food => { dayCalo += food.calo; });
          });
          daysWithData++;
        } catch(e){}
      }
      caloData.push(Math.round(dayCalo));
      targetData.push(globalTarget);

      totalCalo7Days += dayCalo;
      if (dayCalo > maxCalo) maxCalo = dayCalo;

      // Đọc Nước
      const waterKey = `ddv_water_${d.getFullYear()}_${d.getMonth()+1}_${d.getDate()}`;
      const waterAmt = parseInt(localStorage.getItem(waterKey) || "0");
      waterData.push(waterAmt);
      totalWater7Days += waterAmt;
    });

    // Cập nhật Summary
    const avgCalo = daysWithData > 0 ? Math.round(totalCalo7Days / daysWithData) : 0;
    const avgWater = Math.round(totalWater7Days / 7);

    document.getElementById('avg-calo').innerHTML = `${avgCalo} <span style="font-size: 1rem; color: var(--ink-secondary);">Kcal</span>`;
    document.getElementById('max-calo').innerHTML = `${Math.round(maxCalo)} <span style="font-size: 1rem; color: var(--ink-secondary);">Kcal</span>`;
    document.getElementById('avg-water').innerHTML = `${avgWater} <span style="font-size: 1rem; color: var(--ink-secondary);">ml</span>`;

    // 3. Draw Calo Chart
    const ctxCalo = document.getElementById('caloChart');
    new Chart(ctxCalo, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Calo tiêu thụ',
            data: caloData,
            backgroundColor: 'rgba(16, 185, 129, 0.8)',
            borderRadius: 6
          },
          {
            label: 'Mục tiêu',
            data: targetData,
            type: 'line',
            borderColor: '#ef4444',
            borderWidth: 2,
            borderDash: [5, 5],
            pointRadius: 0,
            fill: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: { beginAtZero: true, suggestedMax: globalTarget * 1.2 }
        }
      }
    });

    // 4. Draw Water Chart
    const ctxWater = document.getElementById('waterChart');
    new Chart(ctxWater, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Lượng nước (ml)',
            data: waterData,
            borderColor: '#0ea5e9',
            backgroundColor: 'rgba(14, 165, 233, 0.2)',
            fill: true,
            tension: 0.4,
            borderWidth: 3,
            pointBackgroundColor: '#0ea5e9',
            pointRadius: 4
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: { beginAtZero: true, suggestedMax: 2000 }
        }
      }
    });
  });
</script>
