      { slug: "thieu-mau-thai-ky", title: "Thiếu máu thai kỳ", desc: "Huyết học - sản khoa" },
      { slug: "tang-huyet-ap-thai-ky-tien-san-giat", title: "Tăng huyết áp thai kỳ, tiền sản giật", desc: "Cảnh báo" },
      { slug: "sau-sinh-thieu-sua-an-uong", title: "Sau sinh ít sữa, mệt và táo bón", desc: "Sau sinh" },
    ],
    faq: { href: "/hoi-dap#mang-thai", label: "Bà bầu có cần uống sắt mỗi ngày?" },
    menus: [],
  },
  {
    specialty: "phu-nu-nhi",
    id: "tre-em",
    emoji: "🧒",
    name: "Dinh dưỡng trẻ em & thanh thiếu niên",
    foundation: [
      { slug: "dinh-duong-tre-em", title: "Dinh dưỡng cho trẻ em & thanh thiếu niên", desc: "Bài nền tảng" },
      { slug: "tao-bon-tre-em", title: "Táo bón ở trẻ em", desc: "Tiêu hóa nhi" },
      { slug: "sau-rang-men-rang-tre-em", title: "Sâu răng, men răng yếu ở trẻ", desc: "Răng miệng" },
      { slug: "thieu-mau-tuoi-day-thi", title: "Thiếu máu tuổi dậy thì", desc: "Huyết học nhi" },
      { slug: "tang-chieu-cao-tuoi-day-thi", title: "Tăng chiều cao tuổi dậy thì", desc: "Kiến thức" },
      { slug: "tre-tu-ky-tang-dong-adhd", title: "Tự kỷ, ADHD và trục ruột - não", desc: "Kiến thức chuyên sâu" },
      { slug: "dinh-duong-an-dam-blw", title: "Ăn dặm BLW và nguy cơ thiếu sắt", desc: "Cảnh báo" },
      { slug: "dinh-duong-tre-bieng-an-suy-dinh-duong", title: "Trẻ biếng ăn, suy dinh dưỡng — Phục hồi", desc: "Bài nền tảng" },
    ],
    faq: null,
    menus: [],
  },
  {
    specialty: "phu-nu-nhi",
    id: "ma-kinh",
    emoji: "👩",
    name: "Mãn kinh — Dinh dưỡng phụ nữ trung niên",
    foundation: [
      { slug: "dinh-duong-ma-kinh", title: "Mãn kinh — Giảm bốc hỏa, bảo vệ xương & tim mạch", desc: "Bài nền tảng" },
      { slug: "tien-man-kinh-tang-can", title: "Tiền mãn kinh, mãn kinh và tăng cân", desc: "Thực hành" },
    ],
    faq: null,
    menus: [],
  },
];
---

<BaseLayout title={title} description={desc} canonical="/ban-do-benh">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">🏠 Trang chủ</a> <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-current">🗺️ Bản đồ bệnh</span>
  </nav>
  <main class="disease-map-page">
    <div class="map-hero">
      <h1>🗺️ Bản đồ bệnh đầy đủ</h1>
      <p>
        Đây là nơi xem <strong>toàn cảnh theo chuyên khoa</strong> khi bạn chưa chắc nên bắt đầu từ nhóm bệnh nào.
        Mỗi cụm bệnh dẫn tới <strong>bài nền tảng</strong>, <strong>hỏi đáp</strong>, <strong>thực đơn</strong> và các bài đọc thêm.
      </p>
      <div class="route-row primary">
        <a href="/theo-benh" class="quick-route featured-route">🗂️ Muốn đi nhanh? Mở Theo bệnh</a>
      </div>
      <div class="route-row">
        {quickRoutes.map((route) => (
          <a href={route.href} class="quick-route">{route.label}</a>
        ))}
      </div>
    </div>

    <div class="disease-search" role="search" aria-label="Tìm nhóm bệnh">
      <label for="disease-filter">Tìm bệnh hoặc bài viết</label>
      <div class="disease-search-field">
        <input id="disease-filter" type="search" placeholder="Ví dụ: đái tháo đường, gout, gan nhiễm mỡ..." autocomplete="off" aria-describedby="disease-result" />
        <button id="disease-search-clear" type="button" hidden aria-label="Xóa từ khóa">×</button>
      </div>
      <span id="disease-result" role="status" aria-live="polite">Đang hiển thị {groups.length} nhóm bệnh</span>
    </div>

    <!-- Specialty tabs -->
    <div id="spec-tabs" class="spec-tabs">
      <button class="st-btn st-active" data-spec="all" onclick="filterSpec('all')">📋 Tất cả ({groups.length})</button>
      {specialties.map(sp => {
        const count = groups.filter(g => g.specialty === sp.key).length;
        if (!count) return null;
        return (
          <button class="st-btn" data-spec={sp.key} onclick={`filterSpec('${sp.key}')`}>
            {sp.emoji} {sp.name} <span class="tab-count">({count})</span>
          </button>
        );
      })}
    </div>

    <!-- Disease cards -->
    <div class="disease-list">
      {groups.map(g => {
        const spMeta = specialties.find(s => s.key === g.specialty);
        const listedSlugs = new Set([
          ...g.foundation.map(a => a.slug),
          ...g.menus.map(m => m.slug),
        ]);
        const groupAudience = [...new Set(
          [...g.foundation, ...g.menus]
            .map((item) => getArticle(item.slug)?.audience ?? [])
            .flat()
            .map((tag) => canonicalAudienceList([tag])[0])
            .filter(Boolean),
        )];
        const isArticleLike = (article) =>
          article.displayCategory === "bai-viet" || article.displayCategory === "dung-tin-ngay";
        const matchAudience = (article) => {
          if (!groupAudience.length) return false;
          const articleAudience = canonicalAudienceList(article.audience);
          return groupAudience.some((tag) => articleAudience.includes(tag));
        };
        const compareReadMore = (a, b) => {
          const aAudience = matchAudience(a);
          const bAudience = matchAudience(b);
          if (aAudience !== bAudience) return Number(bAudience) - Number(aAudience);
          if (Boolean(a.featured) !== Boolean(b.featured)) return Number(Boolean(b.featured)) - Number(Boolean(a.featured));
          return 0;
        };
        const audienceMatches = articles
          .filter((article) => !listedSlugs.has(article.slug) && isArticleLike(article) && matchAudience(article))
          .sort(compareReadMore);
        const audienceMatchedSlugs = new Set(audienceMatches.map((article) => article.slug));
        const specialtyFallback = articles
          .filter((article) => (
            !listedSlugs.has(article.slug)
            && !audienceMatchedSlugs.has(article.slug)
            && isArticleLike(article)
            && article.specialty === g.specialty
          ))
          .sort(compareReadMore);
        const readMore = [...audienceMatches, ...specialtyFallback].slice(0, 4);
        const primaryFoundation = g.foundation.slice(0, 4);
        const extraFoundationCount = Math.max(0, g.foundation.length - primaryFoundation.length);
        const primaryMenus = g.menus.slice(0, 2);
        const extraMenuCount = Math.max(0, g.menus.length - primaryMenus.length);
        const specialtyHref = specialtyAnchorMap[g.specialty] ? `/kien-thuc-dinh-duong#${specialtyAnchorMap[g.specialty]}` : "/kien-thuc-dinh-duong";
        return (
          <div class="disease-card" data-spec={g.specialty} data-search={`${g.id} ${g.name} ${spMeta.name} ${g.faq?.label ?? ""} ${g.foundation.map(a => a.title).join(" ")} ${g.menus.map(m => m.title).join(" ")}`} id={g.id}>
            <div class="dc-header" style={`--group-color:${spMeta.color};`}>
              <span class="dc-emoji">{g.emoji}</span>
              <h2>{g.name}</h2>
              <span class="dc-specialty">
                {spMeta.name}
              </span>
            </div>
            <div class="dc-body">
              <h3 class="dc-section-title">📖 Điểm vào theo nhóm bệnh</h3>
              <ul class="map-link-list">
                {primaryFoundation.map(a => (
                  <li>
                    <span>[{normalizeLabel(a.desc)}]</span>
                    <a href={`/kien-thuc-dinh-duong/${a.slug}`}>
                      {a.title}
                    </a>
                  </li>
                ))}
              </ul>
              {extraFoundationCount > 0 && (
                <p class="map-more-note">
                  + {extraFoundationCount} bài cùng mạch trong nhóm này
                </p>
              )}

              <div class="map-action-row">
                {g.faq && (
                  <a href={g.faq.href} class="map-action faq">
                    ❓ {g.faq.label}
                  </a>
                )}
                {primaryMenus.map(m => (
                  <a href={`/kien-thuc-dinh-duong/${m.slug}`} class="map-action menu">
                    🍽️ {m.title}
                  </a>
                ))}
                {extraMenuCount > 0 && (
                  <span class="map-meta-chip">+ {extraMenuCount} thực đơn khác</span>
                )}
              </div>
              <div class="map-meta-row">
                <span class="map-meta-chip">📖 {g.foundation.length} bài chính</span>
                {g.menus.length > 0 && <span class="map-meta-chip">🍽️ {g.menus.length} thực đơn</span>}
                {readMore.length > 0 && <span class="map-meta-chip">➕ {readMore.length} bài đọc thêm</span>}
              </div>
              {readMore.length > 0 && (
                <div class="read-more-block">
                  <h3 class="dc-section-title small">📚 Đọc thêm theo nhóm này</h3>
                  <ul class="map-link-list compact">
                    {readMore.slice(0, 2).map(item => (
                      <li>
                        <span>[{item.displayCategory === "dung-tin-ngay" ? "Đừng tin ngay" : "Bài thêm"}]</span>
                        <a href={`/kien-thuc-dinh-duong/${item.slug}`}>
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                  {readMore.length > 2 && (
                    <p class="map-more-note">
                      + {readMore.length - 2} bài đọc thêm gần nhất với nhóm này
                    </p>
                  )}
                </div>
              )}
              <div class="dc-footer-row">
                <a href={specialtyHref} class="dc-more-link">
                  📚 Xem tất cả bài viết cùng chuyên khoa →</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <p id="disease-empty" class="disease-empty" hidden>Chưa tìm thấy nhóm bệnh phù hợp. Hãy thử từ khóa ngắn hơn.</p>

    <!-- Tools -->
    <div class="map-tools">
      <h3>🔧 Công cụ hỗ trợ</h3>
      <div class="tool-row">
        {[
          { href: "/cong-cu/bmi", label: "BMI & Vòng eo" },
          { href: "/cong-cu/chi-so-gi", label: "Chỉ số GI thực phẩm" },
          { href: "/cong-cu/muc-tieu-can-nang", label: "Mục tiêu cân nặng" },
          { href: "/cong-cu/nuoc-uong", label: "Nhu cầu nước" },
          { href: "/cong-cu/duong-do-uong", label: "Đường đồ uống" },
          { href: "/cong-cu/nuoc-muoi-mon-an", label: "Tra muối" },
          { href: "/cong-cu/nhu-cau-dinh-duong-tre-em", label: "Dinh dưỡng trẻ em" },
          { href: "/cong-cu/dinh-duong-thai-ky", label: "Dinh dưỡng thai kỳ" },
          { href: "/cong-cu/tinh-nhu-cau-dam", label: "Tính nhu cầu đạm" },
          { href: "/cong-cu/tinh-calo-tieu-thu", label: "Calo tiêu thụ" },
          { href: "/cong-cu/so-sanh-thuc-pham", label: "So sánh thực phẩm" },
          { href: "/cong-cu/tinh-carb", label: "Tính carb" },
          { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn" },
          { href: "/cong-cu/ke-hoach-bua-an", label: "Kế hoạch bữa ăn" },
          { href: "/cong-cu/theo-doi-suc-khoe", label: "Theo dõi sức khỏe" },
        ].map(t => (
          <a href={t.href} class="st-tool">{t.label}</a>
        ))}
      </div>
    </div>

    <div class="map-final-cta">
      <a href="/kien-thuc-dinh-duong">
        📚 Xem tất cả bài viết →
      </a>
    </div>
  </main>

  <style>
    .disease-map-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .map-hero {
      text-align: center;
      margin-bottom: 2rem;
    }
    .map-hero h1 {
      margin: 0 0 8px;
      font-size: 1.8rem;
      line-height: 1.25;
    }
    .map-hero p {
      max-width: 640px;
      margin: 0.5rem auto 0;
      color: var(--ink-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }
    .route-row,
    .spec-tabs,
    .disease-list,
    .map-action-row,
    .map-meta-row,
    .dc-footer-row,
    .tool-row {
      display: flex;
      flex-wrap: wrap;
    }
    .route-row {
      gap: 8px;
      justify-content: center;
      margin-top: 14px;
    }
    .route-row.primary { gap: 10px; }
    .spec-tabs {
      gap: 6px;
      margin-bottom: 1.5rem;
      justify-content: center;
    }
    .tab-count {
      opacity: 0.6;
      font-size: 0.75rem;
    }
    .disease-list {
      flex-direction: column;
      gap: 1.5rem;
    }
    .disease-card { border: 1px solid var(--card-border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); box-shadow: var(--shadow-sm); transition: all var(--transition); }
    .disease-card:hover { border-color: var(--brand-light2); box-shadow: var(--shadow); transform: translateY(-1px); }
    .dc-header {
      background: var(--group-color);
      color: #fff;
      padding: 0.8rem 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .dc-emoji { font-size: 1.6rem; }
    .dc-header h2 {
      margin: 0;
      font-size: 1.15rem;
      line-height: 1.28;
      flex: 1;
      color: #fff;
    }
    .dc-specialty {
      font-size: 0.75rem;
      opacity: 0.88;
      background: rgba(255,255,255,0.2);
      padding: 2px 10px;
      border-radius: 999px;
    }
    .dc-body { padding: 1rem 1.2rem; }
    .dc-section-title {
      margin: -0.2rem 0 0.6rem;
      font-size: 0.88rem;
      color: var(--ink-secondary);
    }
    .dc-section-title.small {
      margin: 0 0 0.5rem;
      font-size: 0.84rem;
    }
    .map-link-list {
      margin: 0;
      padding-left: 0;
      list-style: none;
    }
    .map-link-list li {
      margin: 0.35rem 0;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 6px;
    }
    .map-link-list.compact li { margin: 0.3rem 0; }
    .map-link-list span {
      color: var(--ink-tertiary);
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .map-link-list a {
      min-width: 0;
      color: var(--brand);
      text-decoration: underline;
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .map-link-list.compact a { font-size: 0.88rem; }
    .map-more-note {
      margin: 0.55rem 0 0;
      color: var(--ink-tertiary);
      font-size: 0.8rem;
      line-height: 1.45;
    }
    .map-action-row {
      gap: 0.6rem;
      margin-top: 1rem;
    }
    .map-action {
      padding: 0.4rem 1rem;
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      line-height: 1.35;
    }
    .map-action.faq {
      background: var(--bg-soft);
      color: var(--ink);
    }
    .map-action.menu {
      background: var(--primary-bg);
      color: var(--brand);
      font-weight: 500;
    }
    .map-action:hover { text-decoration: none; filter: brightness(0.98); }
    .map-meta-row {
      gap: 8px;
      margin-top: 0.9rem;
    }
    .read-more-block {
      margin-top: 1rem;
      padding-top: 0.9rem;
      border-top: 1px dashed var(--line);
    }
    .dc-footer-row {
      margin-top: 8px;
      gap: 8px;
    }
    .st-btn { padding: 8px 16px; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); color: var(--ink-secondary); font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all var(--transition); font-family: inherit; box-shadow: var(--shadow-sm); }
    .st-btn:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-1px); }
    .st-btn.st-active { background: var(--brand-light); color: var(--brand); border-color: var(--brand-light2); font-weight: 600; box-shadow: none; transform: none; }
    .st-tool { padding: 0.5rem 1rem; border: 1px solid var(--card-border); border-radius: var(--radius-lg); background: var(--card); color: var(--ink); text-decoration: none; font-size: 0.85rem; transition: all var(--transition); font-weight: 500; box-shadow: var(--shadow-sm); display: inline-block; }
    .st-tool:hover { border-color: var(--brand); color: var(--brand); box-shadow: var(--shadow); transform: translateY(-1px); }
    .dc-more-link {
      font-size: 0.82rem;
      color: var(--ink-secondary);
      text-decoration: none;
      padding: 3px 10px;
      border-radius: 999px;
      transition: all var(--transition);
    }
    .dc-more-link:hover { background: var(--bg-soft); color: var(--brand); text-decoration: none; }
    .quick-route {
      text-decoration: none;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--bg-soft);
      border: 1px solid var(--card-border);
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 600;
      transition: all var(--transition);
    }
    .featured-route {
      background: var(--brand-light);
      color: var(--brand-dark);
      border-color: var(--brand-light2);
    }
    .quick-route:hover {
      color: var(--brand);
      border-color: var(--brand-light2);
      background: var(--brand-light);
      text-decoration: none;
    }
    .map-meta-chip {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--bg-soft);
      border: 1px solid var(--card-border);
      color: var(--ink-secondary);
      font-size: 0.76rem;
      font-weight: 600;
    }
    .disease-search { max-width: 680px; margin: 0 auto 1.25rem; padding: 0.8rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-soft); }
    .disease-search label { display: block; margin-bottom: 0.35rem; font-size: 0.82rem; font-weight: 700; color: var(--ink-secondary); }
    .disease-search-field { display: flex; align-items: center; gap: 8px; }
    .disease-search input { flex: 1; min-width: 0; box-sizing: border-box; border: 1px solid var(--line); border-radius: 8px; padding: 0.7rem 0.8rem; font: inherit; background: var(--card); color: var(--ink); }
    .disease-search input:focus { outline: 3px solid color-mix(in srgb, var(--brand) 22%, transparent); border-color: var(--brand); }
    .disease-search-field button { width: 32px; height: 32px; border: 0; border-radius: 999px; background: var(--card); color: var(--ink-secondary); cursor: pointer; font-size: 1.2rem; line-height: 1; }
    .disease-search-field button:hover { background: var(--brand-light); color: var(--brand-dark); }
    .disease-search span { display: block; margin-top: 0.45rem; font-size: 0.78rem; color: var(--ink-tertiary); }
    .disease-empty { margin: 1rem 0; padding: 1rem; border: 1px dashed var(--line); border-radius: 10px; text-align: center; color: var(--ink-secondary); }
    .map-tools {
      margin-top: 2rem;
      padding: 1.2rem;
      background: var(--bg-soft);
      border-radius: 12px;
      text-align: center;
    }
    .map-tools h3 {
      margin: 0 0 0.5rem;
    }
    .tool-row {
      gap: 0.5rem;
      justify-content: center;
    }
    .map-final-cta {
      margin-top: 1.5rem;
      text-align: center;
    }
    .map-final-cta a {
      padding: 0.6rem 1.5rem;
      background: var(--brand);
      color: white;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      display: inline-block;
    }
    .disease-card[hidden] { display: none; }
    [data-spec] { transition: opacity 0.2s; }
    @media (max-width:640px) {
      .disease-map-page {
        padding: 1rem 0.9rem 2rem;
      }
      .map-hero {
        margin-bottom: 1.25rem;
      }
      .map-hero h1 {
        font-size: 1.48rem;
      }
      .map-hero p {
        font-size: 0.9rem;
        line-height: 1.55;
      }
      .route-row {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 2px;
      }
      .quick-route {
        flex: 0 0 auto;
        font-size: 0.78rem;
        padding: 6px 10px;
      }
      .disease-search {
        margin-bottom: 1rem;
        padding: 0.75rem;
      }
      .spec-tabs {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        margin-bottom: 1rem;
        padding-bottom: 2px;
      }
      .st-btn {
        flex: 0 0 auto;
        padding: 7px 12px;
        font-size: 0.8rem;
      }
      .disease-list {
        gap: 1rem;
      }
      .dc-header {
        align-items: flex-start;
        gap: 0.45rem;
        padding: 0.75rem 0.9rem;
      }
      .dc-emoji {
        font-size: 1.35rem;
      }
      .dc-header h2 {
        flex-basis: calc(100% - 2rem);
        font-size: 1rem;
      }
      .dc-specialty {
        font-size: 0.7rem;
      }
      .dc-body {
        padding: 0.9rem;
      }
      .map-link-list li {
        grid-template-columns: 1fr;
        gap: 1px;
        margin: 0.45rem 0;
      }
      .map-link-list span {
        font-size: 0.7rem;
      }
      .map-link-list a,
      .map-link-list.compact a {
        font-size: 0.86rem;
      }
      .map-action-row,
      .map-meta-row {
        gap: 6px;
      }
      .map-action,
      .map-meta-chip,
      .dc-more-link {
        font-size: 0.75rem;
      }
      .map-tools {
        margin-top: 1.25rem;
        padding: 1rem 0.8rem;
      }
      .map-final-cta a {
        width: 100%;
        padding: 0.7rem 1rem;
      }
    }
  </style>

  <script is:inline>
    var diseaseInput = document.querySelector('#disease-filter');
    var diseaseClear = document.querySelector('#disease-search-clear');
    var diseaseResult = document.querySelector('#disease-result');
    var diseaseEmpty = document.querySelector('#disease-empty');
    var diseaseCards = Array.from(document.querySelectorAll('.disease-card'));
    var selectedSpec = 'all';
    var diseaseParams = new URLSearchParams(window.location.search);
    if (diseaseInput && diseaseParams.get('q')) diseaseInput.value = diseaseParams.get('q');

    function normalizeDiseaseSearch(value) {
      return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'd').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function syncDiseaseUrl() {
      var next = new URLSearchParams(window.location.search);
      var query = diseaseInput && diseaseInput.value.trim();
      if (query) next.set('q', query); else next.delete('q');
      var nextUrl = window.location.pathname + (next.toString() ? '?' + next.toString() : '') + window.location.hash;
      window.history.replaceState({}, '', nextUrl);
    }

    function updateDiseaseFilter() {
      var query = normalizeDiseaseSearch(diseaseInput && diseaseInput.value);
      var visible = 0;
      diseaseCards.forEach(function(card) {
        var matchesSpec = selectedSpec === 'all' || card.getAttribute('data-spec') === selectedSpec;
        var matchesQuery = !query || normalizeDiseaseSearch(card.getAttribute('data-search')).indexOf(query) !== -1;
        var show = matchesSpec && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (diseaseClear) diseaseClear.hidden = !query;
      if (diseaseResult) diseaseResult.textContent = 'Đang hiển thị ' + visible.toLocaleString('vi-VN') + ' / ' + diseaseCards.length.toLocaleString('vi-VN') + ' nhóm bệnh';
      if (diseaseEmpty) diseaseEmpty.hidden = visible !== 0;
      syncDiseaseUrl();
    }
    function filterSpec(spec) {
      selectedSpec = spec;
      document.querySelectorAll('.st-btn').forEach(b => b.classList.remove('st-active'));
      var btn = document.querySelector('.st-btn[data-spec="' + spec + '"]');
      if (btn) btn.classList.add('st-active');
      updateDiseaseFilter();
    }
    if (diseaseInput) diseaseInput.addEventListener('input', updateDiseaseFilter);
    if (diseaseClear) diseaseClear.addEventListener('click', function() {
      if (diseaseInput) diseaseInput.value = '';
      diseaseInput && diseaseInput.focus();
      updateDiseaseFilter();
    });
    updateDiseaseFilter();
  </script>
</BaseLayout>
