---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { diseaseHubs } from "../../data/disease-hubs";

const title = "Theo bệnh | Dinh Dưỡng Việt";
const desc = "Chọn đúng nhóm bệnh để xem bài nền tảng, thực đơn mẫu, hiểu lầm thường gặp và công cụ áp dụng ngay.";
---

<BaseLayout title={title} description={desc} canonical="/theo-benh">
  <div class="hub-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">🏠 Trang chủ</a> <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">🗂️ Theo bệnh</span>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Lối vào nhanh theo bệnh lý</p>
        <h1>Theo bệnh</h1>
        <p class="desc">Thay vì mở từng bài lẻ, bạn có thể bắt đầu từ đúng nhóm bệnh để thấy ngay bài nền tảng, thực đơn, công cụ và các hiểu lầm cần tránh.</p>
        <div class="hero-actions">
          <a href="/ban-do-benh" class="cta-btn">🗺️ Xem bản đồ bệnh đầy đủ</a>
          <a href="/tim-kiem" class="cta-alt-btn">🔍 Tìm kiếm toàn site</a>
        </div>
      </div>
      <div class="hero-panel">
        <h2>Bắt đầu hợp lý nhất</h2>
        <ul>
          <li>Chọn đúng bệnh hoặc vấn đề chính đang quan tâm.</li>
          <li>Đọc bài nền tảng trước khi xem mẹo ngắn hoặc thực đơn mẫu.</li>
          <li>Dùng công cụ để áp dụng từng ngày, không cần đổi mọi thứ cùng lúc.</li>
        </ul>
      </div>
    </section>

    <section class="grid-section">
      <div class="section-head">
        <h2>Nhóm bệnh trọng điểm</h2>
        <p>Các hub này gom những nội dung đang có giá trị thực hành cao nhất cho người dùng phổ thông.</p>
      </div>
      <div class="hub-grid">
        {diseaseHubs.map((hub) => (
          <a class="hub-card" href={`/theo-benh/${hub.id}`}>
            <div class="hub-top">
              <span class="hub-emoji">{hub.emoji}</span>
              <div>
                <h3>{hub.name}</h3>
                <p>{hub.description}</p>
              </div>
            </div>
            <div class="hub-tags">
              {hub.heroPoints.slice(0, 2).map((point) => <span>{point}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <style>
    .hub-page { max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.95fr);
      gap: 18px;
      align-items: stretch;
      margin-bottom: 26px;
    }
    .hero-copy, .hero-panel, .hub-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
    }
    .hero-copy { padding: 22px; }
    .hero-panel { padding: 20px; background: var(--bg-soft); }
    .eyebrow {
      margin: 0 0 8px;
      font-size: 0.78rem;
      color: var(--brand);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    h1 { margin: 0 0 10px; font-size: 2rem; }
    .desc { margin: 0 0 16px; color: var(--ink-secondary); line-height: 1.65; max-width: 700px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .cta-btn, .cta-alt-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
    }
    .cta-btn { background: var(--brand); color: #fff; }
    .cta-alt-btn { border: 1px solid var(--card-border); color: var(--ink); }
    .hero-panel h2 { margin: 0 0 10px; font-size: 1rem; }
    .hero-panel ul { margin: 0; padding-left: 18px; color: var(--ink-secondary); line-height: 1.7; }
    .section-head { margin-bottom: 12px; }
    .section-head h2 { margin: 0 0 4px; font-size: 1.2rem; }
    .section-head p { margin: 0; color: var(--ink-secondary); }
    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }
    .hub-card {
      padding: 16px;
      color: inherit;
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .hub-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--brand-light2); }
    .hub-top { display: flex; gap: 12px; align-items: flex-start; }
    .hub-emoji { font-size: 1.7rem; line-height: 1; }
    .hub-card h3 { margin: 0 0 6px; font-size: 1rem; }
    .hub-card p { margin: 0; color: var(--ink-secondary); font-size: 0.88rem; line-height: 1.55; }
    .hub-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
    }
    .hub-tags span {
      display: inline-flex;
      padding: 4px 8px;
      border-radius: 999px;
      background: var(--bg-soft);
      color: var(--ink-secondary);
      font-size: 0.75rem;
    }
    @media (max-width: 820px) {
      .hero { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .hub-page { padding-inline: 1rem; }
      h1 { font-size: 1.7rem; }
    }
  </style>
</BaseLayout>
