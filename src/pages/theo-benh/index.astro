---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { diseaseHubs } from "../../data/disease-hubs";

const title = "Theo bệnh | Dinh dưỡng Việt";
const desc = "Chọn đúng nhóm bệnh để xem bài nền tảng, thực đơn mẫu, hiểu lầm thường gặp và công cụ áp dụng ngay.";
const quickRoutes = [
  { href: "/theo-benh/tieu-duong", label: "Mới biết đái tháo đường", note: "Đi từ bài nền, hiểu carb và thực đơn ngày thường." },
  { href: "/theo-benh/cao-huyet-ap", label: "Huyết áp cao, ăn mặn", note: "Ưu tiên natri ẩn, nước chấm và thực đơn dễ áp dụng." },
  { href: "/theo-benh/beo-phi-chuyen-hoa", label: "Béo phì, bụng to, kháng insulin", note: "Đi từ vòng eo, năng lượng và giảm cân bền vững thay vì ăn kiêng cực đoan." },
  { href: "/theo-benh/gan-nhiem-mo", label: "Gan nhiễm mỡ, men gan", note: "Tập trung vào đường lỏng, năng lượng và giảm cân bền." },
  { href: "/theo-benh/da-day-trao-nguoc", label: "Dạ dày, tá tràng", note: "Chọn bữa nhỏ, mềm, ít kích thích và dễ chịu hơn." },
  { href: "/theo-benh/ho-hap-man", label: "COPD, hen suyễn, khó thở khi ăn", note: "Ưu tiên dung nạp bữa ăn, cân nặng và các bệnh đi kèm." },
];
---

<BaseLayout title={title} description={desc} canonical="/theo-benh">
  <div class="hub-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">🏠 Trang chủ</a> <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">🗂️ Theo bệnh</span>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Lối vào nhanh theo bệnh lý</p>
        <h1>Theo bệnh</h1>
        <p class="desc">Đây là lối vào nhanh cho những nhóm bệnh đã được gom sẵn theo hành động: đọc bài nền trước, xem thực đơn phù hợp, rồi mới dùng công cụ áp dụng mỗi ngày.</p>
        <div class="hero-actions">
          <a href="/tim-kiem" class="cta-btn">🔍 Tìm kiếm toàn site</a>
          <a href="/ban-do-benh" class="cta-alt-btn">🗺️ Mở bản đồ bệnh đầy đủ</a>
        </div>
      </div>
      <div class="hero-panel">
        <h2>Khi nào dùng trang này?</h2>
        <ul>
          <li>Khi bạn đã biết khá rõ vấn đề chính mình đang cần xử lý.</li>
          <li>Khi muốn đi nhanh vào một lộ trình đọc đã được gom sẵn.</li>
          <li>Nếu chưa chắc bệnh thuộc nhóm nào, hãy mở Bản đồ bệnh để xem toàn cảnh trước.</li>
        </ul>
      </div>
    </section>

    <section class="quick-route-section">
      <div class="section-head">
        <h2>Đi nhanh theo tình huống</h2>
        <p>Nếu chưa muốn nhìn hết các nhóm bệnh, bạn có thể bắt đầu từ những tình huống vào web phổ biến nhất.</p>
      </div>
      <div class="quick-route-grid">
        {quickRoutes.map((item) => (
          <a class="quick-route-card" href={item.href}>
            <strong>{item.label}</strong>
            <p>{item.note}</p>
            <span>Vào lộ trình →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="grid-section">
      <div class="section-head">
        <h2>Nhóm bệnh trọng điểm</h2>
        <p>Các hub dưới đây ưu tiên cho nhu cầu phổ biến nhất và đã được sắp sẵn theo thứ tự đọc - thực đơn - công cụ.</p>
      </div>
      <div class="hub-grid">
        {diseaseHubs.map((hub) => (
          <a class="hub-card" href={`/theo-benh/${hub.id}`}>
            <div class="hub-top">
              <span class="hub-emoji">{hub.emoji}</span>
              <div>
                <h3>{hub.name}</h3>
                <p>{hub.description}</p>
              </div>
            </div>
            <div class="hub-tags">
              {hub.heroPoints.slice(0, 2).map((point) => <span>{point}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <style>
    .hub-page { max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.95fr);
      gap: 18px;
      align-items: stretch;
      margin-bottom: 26px;
    }
    .hero-copy, .hero-panel, .hub-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
    }
    .hero-copy { padding: 22px; }
    .hero-panel { padding: 20px; background: var(--bg-soft); }
    .eyebrow {
      margin: 0 0 8px;
      font-size: 0.78rem;
      color: var(--brand);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    h1 { margin: 0 0 10px; font-size: 2rem; }
    .desc { margin: 0 0 16px; color: var(--ink-secondary); line-height: 1.65; max-width: 700px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .cta-btn, .cta-alt-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
    }
    .cta-btn { background: var(--brand); color: #fff; }
    .cta-alt-btn { border: 1px solid var(--card-border); color: var(--ink); }
    .hero-panel h2 { margin: 0 0 10px; font-size: 1rem; }
    .hero-panel ul { margin: 0; padding-left: 18px; color: var(--ink-secondary); line-height: 1.7; }
    .section-head { margin-bottom: 12px; }
    .section-head h2 { margin: 0 0 4px; font-size: 1.2rem; }
    .section-head p { margin: 0; color: var(--ink-secondary); }
    .quick-route-section { margin-bottom: 24px; }
    .quick-route-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .quick-route-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: 14px;
      background: var(--bg-soft);
      color: inherit;
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .quick-route-card:hover {
      transform: translateY(-2px);
      border-color: var(--brand-light2);
      box-shadow: var(--shadow-sm);
      text-decoration: none;
    }
    .quick-route-card strong { font-size: 0.95rem; }
    .quick-route-card p {
      margin: 0;
      color: var(--ink-secondary);
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .quick-route-card span {
      color: var(--brand-dark);
      font-size: 0.82rem;
      font-weight: 700;
    }
    .hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }
    .hub-card {
      padding: 16px;
      color: inherit;
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .hub-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--brand-light2); }
    .hub-top { display: flex; gap: 12px; align-items: flex-start; }
    .hub-emoji { font-size: 1.7rem; line-height: 1; }
    .hub-card h3 { margin: 0 0 6px; font-size: 1rem; }
    .hub-card p { margin: 0; color: var(--ink-secondary); font-size: 0.88rem; line-height: 1.55; }
    .hub-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
    }
    .hub-tags span {
      display: inline-flex;
      padding: 4px 8px;
      border-radius: 999px;
      background: var(--bg-soft);
      color: var(--ink-secondary);
      font-size: 0.75rem;
    }
    @media (max-width: 820px) {
      .hero { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .hub-page { padding-inline: 1rem; }
      h1 { font-size: 1.7rem; }
      .hero-copy, .hero-panel, .hub-card, .quick-route-card {
        border-radius: 14px;
      }
      .hero-copy, .hero-panel {
        padding: 18px;
      }
      .hero-actions {
        flex-direction: column;
      }
      .hero-actions a,
      .quick-route-card,
      .hub-card {
        width: 100%;
      }
      .quick-route-grid,
      .hub-grid {
        grid-template-columns: 1fr;
      }
      .hub-tags {
        gap: 8px;
      }
      .hub-tags span {
        font-size: 0.78rem;
        line-height: 1.4;
      }
    }
  </style>
</BaseLayout>
