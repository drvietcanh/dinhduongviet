---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NutritionChart from "../../components/NutritionChart.astro";
import PortionCalculator from "../../components/PortionCalculator.astro";
import HealthAlert from "../../components/HealthAlert.astro";
import GlycemicLoad from "../../components/GlycemicLoad.astro";
import VNHealthScore from "../../components/VNHealthScore.astro";
import AddToDiary from "../../components/AddToDiary.astro";
import { nutrientLabels, recipes } from "../../data/nutrition";
import { calculateRecipe, confidenceLabel, detailNutrients, foodById, recipeBySlug, sourceFor, allTags, tagLabel, recipePublicNote } from "../../lib/nutrition";

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug } }));
}

const recipe = recipeBySlug(Astro.params.slug ?? "");
if (!recipe) return Astro.redirect("/tim-kiem");
const nutrients = calculateRecipe(recipe);
const publicNote = recipePublicNote(recipe, nutrients);
const source = sourceFor(recipe.sourceId);
const sourceHref = source?.url ?? "/phuong-phap";
const reviewMailto = `mailto:drvietcanh@gmail.com?subject=${encodeURIComponent(`Rà soát dữ liệu món ăn: ${recipe.name}`)}`;
const nextRecipeLinks = [
  { href: "/cong-cu/danh-gia-bua-an", label: "Đánh giá bữa ăn", note: "Đặt món này vào cả bữa để đọc tổng thể hơn." },
  { href: "#doi-khau-phan", label: "Đổi khẩu phần", note: "Tăng hoặc giảm theo tô, đĩa hay phần ăn thực tế." },
  { href: "/thuc-pham", label: "Xem thực phẩm thành phần", note: "Đi tiếp sang từng nguyên liệu nếu cần so kỹ." },
];
const pageDescription = `Tra cứu ${recipe.servingName} ${recipe.name}: khoảng ${Math.round(nutrients.energyKcal ?? 0)} kcal, ${Math.round(nutrients.proteinG ?? 0)}g đạm, ${Math.round(nutrients.carbG ?? 0)}g carb và ${Math.round(nutrients.fatG ?? 0)}g chất béo mỗi khẩu phần.`;
const heroMetrics = [
  { label: "Năng lượng", value: `${Math.round(nutrients.energyKcal ?? 0)} kcal` },
  { label: "Protein", value: `${Math.round(nutrients.proteinG ?? 0)} g` },
  { label: "Carb", value: `${Math.round(nutrients.carbG ?? 0)} g` },
  { label: "Natri", value: `${Math.round(nutrients.sodiumMg ?? 0)} mg` }
];
const heroTags = allTags({ tags: recipe.tags, nutrients }).slice(0, 3);
const detailMeta = [
  { label: "Khẩu phần", value: recipe.servingName },
  { label: "Khối lượng ước tính", value: `${recipe.servingWeightG} g` },
  { label: "Độ tin cậy", value: confidenceLabel(recipe.confidence) },
];
const qualityBadge = recipe.confidence === "high"
  ? { label: "Dữ liệu chắc", tone: "good" }
  : recipe.confidence === "medium"
    ? { label: "Cần đối chiếu khẩu phần", tone: "watch" }
    : { label: "Ước tính theo công thức", tone: "caution" };
const presentDetailKeys = detailNutrients.filter((key) => nutrients[key] != null);
const missingDetailKeys = detailNutrients.filter((key) => nutrients[key] == null);
const completenessPct = Math.round((presentDetailKeys.length / detailNutrients.length) * 100);
const completenessLabel = completenessPct >= 70
  ? "Rất đầy đủ"
  : completenessPct >= 45
    ? "Khá đầy đủ"
    : "Đủ macro, vi chất còn mỏng";
const missingPreview = missingDetailKeys
  .slice(0, 6)
  .map((key) => nutrientLabels[key]?.label.toLowerCase() ?? String(key))
  .join(", ");

// Build JSON-LD Recipe schema object (will be stringified in template)
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": recipe.servingName + " " + recipe.name,
  "description": publicNote || "Thông tin dinh dưỡng cho " + recipe.servingName + " " + recipe.name,
  "image": recipe.imageUrl || "https://dinh-duong-viet.pages.dev/og-default.png",
  "author": { "@type": "Organization", "name": "Dinh dưỡng Việt" },
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": Math.round(nutrients.energyKcal ?? 0) + " kcal",
    "proteinContent": Math.round(nutrients.proteinG ?? 0) + " g",
    "fatContent": Math.round(nutrients.fatG ?? 0) + " g",
    "carbohydrateContent": Math.round(nutrients.carbG ?? 0) + " g",
    "fiberContent": Math.round(nutrients.fiberG ?? 0) + " g",
    "sodiumContent": Math.round(nutrients.sodiumMg ?? 0) + " mg"
  },
  "recipeIngredient": recipe.items.map(function(item) {
    var food = foodById(item.foodId);
    return item.amountG + "g " + (food ? food.name : item.foodId);
  }),
  "recipeYield": recipe.servingName || "1 suất"
};
---

<BaseLayout
  title={`${recipe.servingName} ${recipe.name} bao nhiêu calo? - Dinh dưỡng Việt`}
  description={pageDescription}
  canonical={`/mon-an/${recipe.slug}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(recipeSchema)}></script>
  <section class="detail-hero">
    <div class="detail-topline">
      <a href="/mon-an" class="back-link">Danh sách món ăn</a>
      <div class="quality-cluster" aria-label="Chất lượng dữ liệu">
        <span class="badge">Món ăn</span>
        <span class={`quality-badge ${qualityBadge.tone}`}>{qualityBadge.label}</span>
      </div>
    </div>
    <div class="detail-heading">
      <div class="detail-copy">
        <p class="eyebrow">Theo {recipe.servingName.toLowerCase()}</p>
        <h1>{recipe.servingName} {recipe.name}</h1>
        <p class="lead">{publicNote}</p>
        <div class="detail-actions">
          <button class="action-chip" onclick="shareRecipe()" title="Chia sẻ">Chia sẻ</button>
          <button class="action-chip" onclick="window.print()" title="In / Xuất PDF">In / PDF</button>
        </div>
      </div>
      <div class="detail-media">
        {recipe.imageUrl && <img src={recipe.imageUrl} alt={recipe.name} class="food-img detail-image" loading="lazy" decoding="async" fetchpriority="low" onerror="this.closest('.detail-media')?.classList.add('is-fallback'); this.remove();" />}
        <div class="detail-media-fallback" aria-hidden="true">
          <span>🍲</span>
          <strong>{recipe.name}</strong>
        </div>
      </div>
    </div>
    <div class="detail-metrics" aria-label="Tóm tắt dinh dưỡng">
      {heroMetrics.map((metric) => (
        <div class="metric-card">
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
        </div>
      ))}
    </div>
    {heroTags.length > 0 && (
      <div class="detail-tags">
        {heroTags.map((tag) => <span class="tag">{tagLabel(tag)}</span>)}
      </div>
    )}
    <div class="detail-meta-strip" aria-label="Thông tin đọc nhanh">
      {detailMeta.map((item) => (
        <div class="meta-pill">
          <span>{item.label}</span>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>
    <div class="detail-note-card">
      <h2>Đọc nhanh</h2>
      <p>Đây là ước tính theo một khẩu phần phổ biến. Sai số thường đến từ lượng cơm, dầu mỡ, nước sốt và kích thước tô hoặc đĩa thực tế. Nếu dùng cho người bệnh mạn tính, hãy xem thêm cảnh báo bên dưới và đối chiếu khẩu phần thật.</p>
    </div>
    <AddToDiary type="recipe" itemId={recipe.slug} defaultAmount={recipe.servingWeightG} />
  </section>

  <HealthAlert nutrients={nutrients} name={recipe.name} />

  {nutrients.glycemicIndex != null && (
    <section class="section">
      <GlycemicLoad glycemicIndex={nutrients.glycemicIndex} carbG={nutrients.carbG} />
    </section>
  )}

  <section class="section" id="doi-khau-phan">
    <PortionCalculator
      nutrients={nutrients}
      baseAmountG={recipe.servingWeightG}
      defaultAmountG={recipe.servingWeightG}
      title={`Đổi khẩu phần ${recipe.name}`}
    />
  </section>

  <section class="section card next-step-card">
    <div class="section-head">
      <h2>Bước tiếp theo</h2>
      <p>Sau khi xem một món riêng lẻ, đây là ba hướng đi rõ nhất để quyết định tiếp.</p>
    </div>
    <div class="next-step-grid">
      {nextRecipeLinks.map((link) => (
        <a href={link.href} class="next-step-link">
          <strong>{link.label}</strong>
          <span>{link.note}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <NutritionChart nutrients={nutrients} name={`${recipe.servingName} ${recipe.name}`} />
  </section>

  <section class="section">
    <VNHealthScore nutrients={nutrients} name={`${recipe.servingName} ${recipe.name}`} isRecipe servingKcal={nutrients.energyKcal} />
  </section>

  <section class="section">
    <div class="card">
      <div class="section-head">
        <h2>Cách tính</h2>
        <p>Mỗi nguyên liệu được quy đổi theo phần ăn được rồi cộng lại thành một khẩu phần món.</p>
      </div>
      <table class="table">
        <thead>
          <tr>
            <th>Nguyên liệu</th>
            <th>Khối lượng</th>
          </tr>
        </thead>
        <tbody>
          {recipe.items.map((item) => {
            const food = foodById(item.foodId);
            return (
              <tr>
                <td>
                  {food ? <a class="ingredient-link" href={`/thuc-pham/${food.slug}`}>{food.name}</a> : item.foodId}
                  <br />
                  <span class="muted">{item.note}</span>
                </td>
                <td>{item.amountG}g</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {recipe.commonPortions && (
    <section class="section card">
      <h2>Khẩu phần thường gặp</h2>
      <p class="muted portion-note">{recipe.portionNote}</p>
      <div class="grid three">
        {recipe.commonPortions.map((portion) => (
          <div class="stat">
            <span class="muted">{portion.label}</span>
            <strong>{portion.beefAmountG ? `${portion.beefAmountG}g` : "—"}</strong>
            <span class="muted">thịt bò chín</span>
            <p class="muted portion-description">{portion.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section card source-card">
    <div class="section-head">
      <h2>Nguồn dữ liệu</h2>
      <p>Đọc nhanh nguồn và giới hạn của số liệu ước tính theo công thức mẫu.</p>
    </div>
    <div class="source-facts">
      <div class="source-fact">
        <span>Nguồn</span>
        <strong>{source?.name ?? recipe.sourceId}</strong>
      </div>
      <div class="source-fact">
        <span>Loại dữ liệu</span>
        <strong>Ước tính theo khẩu phần mẫu</strong>
      </div>
      <div class="source-fact">
        <span>Khẩu phần tính</span>
        <strong>{recipe.servingName} · {recipe.servingWeightG} g</strong>
      </div>
      <div class="source-fact">
        <span>Thành phần đã có</span>
        <strong>{presentDetailKeys.length}/{detailNutrients.length} chỉ số</strong>
      </div>
    </div>
    <div class="data-completeness-card">
      <div>
        <span class="data-completeness-kicker">Độ đầy đủ dữ liệu</span>
        <strong>{completenessLabel} · {completenessPct}%</strong>
      </div>
      <p>
        Món ăn được cộng từ dữ liệu từng nguyên liệu. Các chỉ số như natri, kali, phốt pho, vitamin hoặc GI chỉ hiển thị khi nguyên liệu nguồn có dữ liệu.
        {missingPreview && ` Một số chỉ số còn thiếu: ${missingPreview}.`}
      </p>
    </div>
    <div class="source-copy">
      <p><strong>Lưu ý sai số:</strong> Giá trị có thể thay đổi theo lượng tinh bột, đạm, dầu mỡ, nước chấm và kích thước khẩu phần thực tế.</p>
    </div>
    <div class="source-actions">
      <a href={sourceHref} target={source?.url ? "_blank" : undefined} rel={source?.url ? "noreferrer" : undefined}>{source?.url ? "Mở nguồn gốc dữ liệu" : "Xem phương pháp và nguồn dữ liệu"}</a>
      <a href={reviewMailto}>Báo dữ liệu cần rà soát</a>
    </div>
  </section>
  <script is:inline>
    function shareRecipe() {
      var title = document.title;
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function(){});
      } else {
        navigator.clipboard.writeText(url).then(function() {
          alert('Đã sao chép đường dẫn!');
        }).catch(function(){});
      }
    }
  </script>
</BaseLayout>

<style>
  .detail-hero {
    display: grid;
    gap: 18px;
    margin-bottom: 8px;
  }

  .detail-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    color: var(--ink-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--brand);
  }

  .quality-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: flex-end;
  }

  .quality-badge {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 5px 10px;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .quality-badge.good {
    border-color: color-mix(in srgb, var(--brand) 28%, var(--card-border));
    background: color-mix(in srgb, var(--brand) 10%, var(--card));
    color: var(--brand-dark);
  }

  .quality-badge.watch {
    border-color: color-mix(in srgb, #f59e0b 32%, var(--card-border));
    background: color-mix(in srgb, #f59e0b 12%, var(--card));
    color: color-mix(in srgb, #92400e 72%, var(--ink));
  }

  .quality-badge.caution {
    border-color: color-mix(in srgb, #ef4444 26%, var(--card-border));
    background: color-mix(in srgb, #ef4444 9%, var(--card));
    color: color-mix(in srgb, #991b1b 70%, var(--ink));
  }

  .detail-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 360px);
    gap: 20px;
    align-items: start;
  }

  .detail-copy h1 {
    margin: 4px 0 10px;
  }

  .eyebrow {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .action-chip {
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    padding: 9px 14px;
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  .detail-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .detail-media {
    width: 100%;
  }

  .detail-media-fallback {
    display: none;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: linear-gradient(135deg, var(--bg-soft), var(--brand-light));
    color: var(--ink);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    padding: 16px;
  }

  .detail-media-fallback span {
    font-size: 2rem;
  }

  .detail-media.is-fallback .detail-media-fallback {
    display: flex;
  }

  .detail-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .metric-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    padding: 12px 14px;
  }

  .metric-card span {
    display: block;
    color: var(--ink-secondary);
    font-size: 0.82rem;
    margin-bottom: 6px;
  }

  .metric-card strong {
    font-size: 1rem;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .detail-tags .tag {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--card-border);
    color: var(--ink-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .detail-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meta-pill {
    display: inline-flex;
    min-height: 46px;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .meta-pill span {
    color: var(--ink-tertiary);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .meta-pill strong {
    margin-top: 3px;
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .detail-note-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--brand) 6%, var(--card));
    padding: 14px 16px;
  }

  .detail-note-card h2,
  .section-head h2 {
    margin: 0 0 6px;
    font-size: 1.02rem;
  }

  .detail-note-card p,
  .section-head p {
    margin: 0;
    color: var(--ink-secondary);
  }

  .section-head {
    margin-bottom: 12px;
  }
  .next-step-card { padding: 18px; }
  .next-step-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .next-step-link {
    display: flex;
    min-height: 88px;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 13px;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
  }

  .next-step-link strong {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .next-step-link span {
    margin-top: 10px;
    color: var(--ink-secondary);
    font-size: 0.79rem;
    line-height: 1.45;
  }

  .next-step-link:hover {
    border-color: var(--brand-light2);
    background: var(--brand-light);
    color: var(--brand-dark);
  }

  .source-card {
    display: grid;
    gap: 12px;
  }

  .source-facts {
    display: grid;
    gap: 8px;
  }

  .source-fact {
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--bg-soft);
  }

  .source-fact span {
    color: var(--ink-tertiary);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .source-fact strong {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .ingredient-link {
    color: var(--brand-dark);
    font-weight: 800;
    text-decoration: none;
  }

  .ingredient-link:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .data-completeness-card {
    display: grid;
    gap: 8px;
    margin-top: 4px;
    padding: 13px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 7%, var(--card)), var(--card));
  }

  .data-completeness-kicker {
    display: block;
    margin-bottom: 3px;
    color: var(--ink-tertiary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .data-completeness-card strong {
    display: block;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.35;
  }

  .data-completeness-card p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .source-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .source-actions a {
    color: var(--brand-dark);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .source-copy p {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .portion-note {
    margin: 6px 0 12px;
  }
  .portion-description {
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .detail-heading,
    .detail-metrics {
      grid-template-columns: 1fr;
    }

    .next-step-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .detail-hero {
      gap: 12px;
      margin-bottom: 4px;
    }

    .section.grid.two {
      grid-template-columns: 1fr;
    }

    .detail-topline {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .quality-cluster {
      justify-content: flex-start;
    }

    .badge {
      max-width: 100%;
