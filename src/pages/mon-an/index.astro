    color: var(--ink-tertiary);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .recipe-title {
    margin: 0 0 8px;
    font-size: 0.98rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .recipe-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .recipe-metrics span {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--bg-soft);
  }
  .recipe-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 28px;
  }
  .food-thumb {
    width: calc(100% + 32px);
    height: 120px;
    background-size: cover;
    background-position: center;
    border-radius: inherit;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-top: -16px;
    margin-left: -16px;
    margin-bottom: 10px;
  }
  .mini-tag {
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fit-tag { font-weight: 600; }
  .fit-green { background: #e8f5e9; color: #2e7d32; }
  .fit-red { background: #fce4ec; color: #c62828; }
  .fit-blue { background: #e8eaf6; color: #283593; }
  .fit-amber { background: #fff8e1; color: #f57f17; }
  .recipe-note {
    margin-top: 7px;
    font-size: 0.8rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .recipe-card-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  .recipe-card-footer span {
    color: var(--brand-dark);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .cross-cta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
  }
  .cross-cta-strip a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--card-border);
