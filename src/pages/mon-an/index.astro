---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchBox from "../../components/SearchBox.astro";
import DataSummary from "../../components/DataSummary.astro";
import { recipes } from "../../data/nutrition";
import { calculateRecipe, confidenceLabel, allTags, tagLabel } from "../../lib/nutrition";

const recipeCards = recipes.map((recipe) => {
  const nutrients = calculateRecipe(recipe);
  const tags = allTags({ tags: recipe.tags, nutrients });
  const quickFits = [];

  if (tags.includes("low-sodium")) quickFits.push({ label: "THA", tone: "green" });
  if (tags.includes("low-purine")) quickFits.push({ label: "Gout", tone: "red" });
  if (tags.includes("glycemic-index-low")) quickFits.push({ label: "ĐTĐ", tone: "blue" });
  if (nutrients.energyKcal <= 300) quickFits.push({ label: "Giảm cân", tone: "amber" });

  return {
    recipe,
    nutrients,
    tags,
    quickFits,
    confidence: confidenceLabel(recipe.confidence),
    shortNote:
      recipe.portionNote && recipe.portionNote.length > 110
        ? `${recipe.portionNote.slice(0, 107)}...`
        : recipe.portionNote,
  };
});
---

<BaseLayout
  title="Danh sách món ăn - Dinh Dưỡng Việt"
  description="Tra cứu món ăn Việt theo khẩu phần với ước tính calo, đạm, carb, natri và các tag dinh dưỡng tham khảo."
  canonical="/mon-an"
>
  <section>
    <h1>Danh sách món ăn</h1>
    <p class="lead">Trang này phù hợp khi bạn muốn nhìn một món ăn trọn phần trước khi quyết định có nên đưa vào bữa ăn của mình hay không.</p>
    <div style="margin-top: 18px;">
      <SearchBox />
    </div>
    <div class="quick-start-panel">
      <div class="quick-start-copy">
        <strong>Chọn nhanh theo nhu cầu</strong>
        <p>Nếu đang phân vân giữa nhiều món, hãy lọc theo mục tiêu trước rồi mới so kỹ calo, đạm và natri.</p>
      </div>
      <div class="quick-start-links">
        <a href="/mon-an?profile=diabetes">🩸 Món thân thiện đường huyết</a>
        <a href="/mon-an?profile=hypertension">❤️ Món ít natri hơn</a>
        <a href="/mon-an?profile=weight">⚖️ Món nhẹ năng lượng</a>
      </div>
    </div>
    <div class="filter-panel" aria-label="Bộ lọc món ăn nâng cao">
      <div class="filter-row">
        <label>
          <span>Sắp xếp</span>
          <select id="recipe-sort">
            <option value="name-asc">Tên A→Z</option>
            <option value="name-desc">Tên Z→A</option>
            <option value="calo-asc">Calo thấp → cao</option>
            <option value="calo-desc">Calo cao → thấp</option>
            <option value="protein-desc">Đạm cao → thấp</option>
            <option value="sodium-asc">Natri thấp → cao</option>
          </select>
        </label>
        <label>
          <span>🎯 Gợi ý theo mục tiêu</span>
          <select id="recipe-profile" style="font-weight:600;">
            <option value="all">Tất cả</option>
            <option value="diabetes">🩸 Đái tháo đường</option>
            <option value="hypertension">❤️ Tăng huyết áp</option>
            <option value="gout">🦶 Gout</option>
            <option value="weight">⚖️ Giảm cân</option>
          </select>
        </label>
        <label>
          <span>Tag</span>
          <select id="recipe-tag">
            <option value="all">Tất cả tag</option>
            <option value="low-sodium">Ít natri</option>
            <option value="high-sodium">Nhiều natri</option>
            <option value="low-purine">Ít purin</option>
            <option value="high-purine">Nhiều purin</option>
            <option value="glycemic-index-low">GI thấp</option>
            <option value="high-fat">Nhiều béo</option>
          </select>
        </label>
      </div>
      <div class="filter-row numeric-row">
        <label><span>Kcal tối đa</span><input id="recipe-max-kcal" type="number" min="0" step="25" placeholder="vd 500" /></label>
        <label><span>Đạm tối thiểu</span><input id="recipe-min-protein" type="number" min="0" step="1" placeholder="g/phần" /></label>
        <label><span>Natri tối đa</span><input id="recipe-max-sodium" type="number" min="0" step="50" placeholder="mg/phần" /></label>
        <button id="recipe-reset" class="button secondary" type="button">Xóa lọc</button>
      </div>
      <p class="muted" style="margin:10px 0 0; font-size:0.83rem;">
        Nhãn gợi ý chỉ dựa trên thành phần dinh dưỡng ước tính của món, không thay thế kế hoạch ăn điều trị cá thể hóa.
      </p>
      <p class="muted" id="recipe-summary"></p>
    </div>
  </section>

  <DataSummary />

  <section class="section">
    <div class="grid two" id="recipe-grid">
      {recipeCards.map(({ recipe, nutrients, tags, quickFits, confidence, shortNote }) => (
          <a
            class="card result-link recipe-card"
            href={`/mon-an/${recipe.slug}`}
            data-tags={tags.join(" ")}
            data-kcal={Math.round(nutrients.energyKcal)}
            data-protein={nutrients.proteinG.toFixed(1)}
            data-sodium={Math.round(nutrients.sodiumMg ?? 0)}
          >
            {recipe.imageUrl && <div class="food-thumb" style={`background-image: url(${recipe.imageUrl});`}></div>}
            <div class="recipe-topline">
              <span class="badge">{recipe.servingName}</span>
              <span class="recipe-confidence">{confidence}</span>
            </div>
            <h2 class="recipe-title">{recipe.name}</h2>
            <div class="recipe-metrics">
              <span>{Math.round(nutrients.energyKcal)} kcal</span>
              <span>{nutrients.proteinG.toFixed(1)}g đạm</span>
              <span>{Math.round(nutrients.sodiumMg ?? 0)}mg natri</span>
            </div>
            <div class="recipe-tag-row">
              {tags.slice(0, 2).map(tag => <span class="mini-tag">{tagLabel(tag)}</span>)}
              {quickFits.slice(0, 2).map((fit) => <span class:list={["mini-tag", "fit-tag", `fit-${fit.tone}`]}>{fit.label}</span>)}
            </div>
            {shortNote && (
              <p class="muted recipe-note">
                {shortNote}
              </p>
            )}
          </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  var recipeSort = document.getElementById('recipe-sort');
  var recipeProfile = document.getElementById('recipe-profile');
  var recipeTag = document.getElementById('recipe-tag');
  var recipeMaxKcal = document.getElementById('recipe-max-kcal');
  var recipeMinProtein = document.getElementById('recipe-min-protein');
  var recipeMaxSodium = document.getElementById('recipe-max-sodium');
  var recipeSummary = document.getElementById('recipe-summary');
  var params = new URLSearchParams(window.location.search);

  function numberValue(el) {
    if (!el || el.value === '') return null;
    var value = Number(el.value);
    return Number.isFinite(value) ? value : null;
  }

  function tagsOf(card) {
    return (card.getAttribute('data-tags') || '').split(' ').filter(Boolean);
  }

  function hasTag(card, tag) {
    return tagsOf(card).indexOf(tag) >= 0;
  }

  function matchesProfile(card, profile) {
    var kcal = Number(card.getAttribute('data-kcal') || 0);
    var sodium = Number(card.getAttribute('data-sodium') || 0);
    if (profile === 'diabetes') return hasTag(card, 'glycemic-load-low') || hasTag(card, 'glycemic-index-low');
    if (profile === 'hypertension') return sodium <= 600 || hasTag(card, 'low-sodium');
    if (profile === 'gout') return hasTag(card, 'low-purine');
    if (profile === 'weight') return kcal <= 500;
    return true;
  }

  function sortRecipes() {
    var val = recipeSort?.value || 'name-asc';
    var grid = document.getElementById('recipe-grid');
    if (!grid) return;
    var cards = Array.from(grid.querySelectorAll('.recipe-card'));
    cards.sort(function(a, b) {
      var aName = (a.querySelector('h2')?.textContent || '');
      var bName = (b.querySelector('h2')?.textContent || '');
      if (val === 'name-asc') return aName.localeCompare(bName, 'vi');
      if (val === 'name-desc') return bName.localeCompare(aName, 'vi');
      if (val === 'calo-asc') return (parseFloat(a.getAttribute('data-kcal') || '0')) - (parseFloat(b.getAttribute('data-kcal') || '0'));
      if (val === 'calo-desc') return (parseFloat(b.getAttribute('data-kcal') || '0')) - (parseFloat(a.getAttribute('data-kcal') || '0'));
      if (val === 'protein-desc') return (parseFloat(b.getAttribute('data-protein') || '0')) - (parseFloat(a.getAttribute('data-protein') || '0'));
      if (val === 'sodium-asc') return (parseFloat(a.getAttribute('data-sodium') || '0')) - (parseFloat(b.getAttribute('data-sodium') || '0'));
      return 0;
    });
    cards.forEach(function(card) { grid.appendChild(card); });
  }

  function applyRecipeFilters() {
    var tag = recipeTag?.value || 'all';
    var profile = recipeProfile?.value || 'all';
    var maxKcal = numberValue(recipeMaxKcal);
    var minProtein = numberValue(recipeMinProtein);
    var maxSodium = numberValue(recipeMaxSodium);
    var visible = 0;
    document.querySelectorAll('.recipe-card').forEach(function(card) {
      var kcal = Number(card.getAttribute('data-kcal') || 0);
      var protein = Number(card.getAttribute('data-protein') || 0);
      var sodium = Number(card.getAttribute('data-sodium') || 0);
      var ok = true;
      if (tag !== 'all' && !hasTag(card, tag)) ok = false;
      if (maxKcal !== null && kcal > maxKcal) ok = false;
      if (minProtein !== null && protein < minProtein) ok = false;
      if (maxSodium !== null && sodium > maxSodium) ok = false;
      if (!matchesProfile(card, profile)) ok = false;
      card.style.display = ok ? '' : 'none';
      if (ok) visible += 1;
    });
    if (recipeSummary) recipeSummary.textContent = 'Đang hiển thị ' + visible + ' / ' + document.querySelectorAll('.recipe-card').length + ' món ăn.';
  }

  [recipeSort, recipeProfile, recipeTag, recipeMaxKcal, recipeMinProtein, recipeMaxSodium].forEach(function(el) {
    el?.addEventListener('change', function() {
      sortRecipes();
      applyRecipeFilters();
    });
    el?.addEventListener('input', applyRecipeFilters);
  });
  document.getElementById('recipe-reset')?.addEventListener('click', function() {
    if (recipeProfile) recipeProfile.value = 'all';
    if (recipeTag) recipeTag.value = 'all';
    [recipeMaxKcal, recipeMinProtein, recipeMaxSodium].forEach(function(el) { if (el) el.value = ''; });
    applyRecipeFilters();
  });
  function applyUrlPresets() {
    var profile = params.get('profile');
    var tag = params.get('tag');
    if (profile && recipeProfile?.querySelector('option[value="' + CSS.escape(profile) + '"]')) recipeProfile.value = profile;
    if (tag && recipeTag?.querySelector('option[value="' + CSS.escape(tag) + '"]')) recipeTag.value = tag;
    if (params.get('maxKcal') && recipeMaxKcal) recipeMaxKcal.value = params.get('maxKcal');
    if (params.get('minProtein') && recipeMinProtein) recipeMinProtein.value = params.get('minProtein');
    if (params.get('maxSodium') && recipeMaxSodium) recipeMaxSodium.value = params.get('maxSodium');
  }
  applyUrlPresets();
  sortRecipes();
  applyRecipeFilters();
</script>

<style>
  .quick-start-panel {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
  }
  .quick-start-copy strong { display: block; margin-bottom: 4px; font-size: 0.9rem; }
  .quick-start-copy p { margin: 0; color: var(--ink-secondary); font-size: 0.84rem; line-height: 1.55; }
  .quick-start-links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .quick-start-links a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .quick-start-links a:hover { border-color: var(--brand-light2); color: var(--brand-dark); background: var(--brand-light); }
  .filter-panel {
    margin-top: 14px;
    padding: 14px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
  }
  .filter-row + .filter-row { margin-top: 10px; }
  .filter-row label { display: grid; gap: 5px; }
  .filter-row label span {
    font-size: 0.82rem;
    color: var(--ink-secondary);
    font-weight: 600;
  }
  .filter-row select,
  .filter-row input {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    background: var(--card);
    color: inherit;
    transition: all var(--transition);
  }
  .filter-row select:focus,
  .filter-row input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    outline: none;
  }
  .numeric-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .recipe-card {
    position: relative;
  }
  .recipe-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .recipe-confidence {
    color: var(--ink-tertiary);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .recipe-title {
    margin: 0 0 8px;
    font-size: 1.02rem;
    line-height: 1.4;
  }
  .recipe-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--ink-secondary);
    font-size: 0.82rem;
  }
  .recipe-metrics span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--bg-soft);
  }
  .recipe-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .food-thumb {
    width: calc(100% + 32px);
    height: 120px;
    background-size: cover;
    background-position: center;
    border-radius: inherit;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin-top: -16px;
    margin-left: -16px;
    margin-bottom: 10px;
  }
  .mini-tag {
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
  }
  .fit-tag { font-weight: 600; }
  .fit-green { background: #e8f5e9; color: #2e7d32; }
  .fit-red { background: #fce4ec; color: #c62828; }
  .fit-blue { background: #e8eaf6; color: #283593; }
  .fit-amber { background: #fff8e1; color: #f57f17; }
  .recipe-note {
    margin-top: 8px;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .quick-start-panel { grid-template-columns: 1fr; }
    .quick-start-links { justify-content: flex-start; }
    .filter-row,
    .numeric-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .recipe-grid { grid-template-columns: 1fr; gap: 10px; }
    .recipe-card { padding: 12px; }
    .recipe-topline { align-items: flex-start; flex-direction: column; gap: 6px; }
    .recipe-metrics { gap: 6px; }
    #recipe-reset { min-height: 44px; }
  }
</style>
