---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles, SPECIALTIES, type ArticleMeta } from "../../data/articles";
import ArticleCard from "../../components/ArticleCard.astro";

const title = "Kiến thức dinh dưỡng | Dinh dưỡng Việt";
const desc = "Bài viết dinh dưỡng cho người Việt — tra cứu theo chuyên khoa như tim mạch, chuyển hóa, tiêu hóa, thận, hô hấp và nhiều nhóm khác.";

// Group articles by specialty
const specOrder = [
  "dinh-duong-tong-quat",
  "noi-tiet",
  "tieu-hoa",
  "tim-mach",
  "than-tiet-nieu",
  "co-xuong-khop",
  "huyet-hoc",
  "than-kinh",
  "ho-hap",
  "da-lieu",
  "phu-nu-nhi",
  "nhi-khoa",
  "lao-khoa",
  "san-khoa",
  "di-ung",
  "tai-mui-hong",
  "ngoai-khoa",
  "truyen-nhiem",
  "dinh-duong-the-thao",
  "ung-thu"
];
const knownOrder = [...new Set([...specOrder, ...Object.keys(SPECIALTIES)])];
const knownSpecialties = new Set(knownOrder);
const grouped = knownOrder.map(key => ({
  key,
  meta: SPECIALTIES[key],
  items: articles.filter(a => a.specialty === key),
})).filter(g => g.meta && g.items.length > 0);

const unknownItems = articles.filter(a => !a.specialty || a.specialty === "unknown");

// Featured (from any specialty, non-specialty specific)
const featured = articles.filter(a => a.featured && a.series !== "dung-tin-ngay");
const articleSearchText = (article: ArticleMeta) => [
  article.title,
  article.description,
  article.specialty,
  article.series,
  ...(article.tags ?? []),
  ...(article.audience ?? []),
].filter(Boolean).join(" ");

// Display category labels (for sub-grouping within each specialty)
const dcLabel = {
  "bai-viet": { name: "📝 Bài viết", desc: "Dinh dưỡng cơ bản, lối sống, bệnh lý, chăm sóc" },
  "mon-an": { name: "🍜 Món ăn & Thực phẩm", desc: "Phân tích từng món" },
  "thuc-don": { name: "📋 Thực đơn mẫu", desc: "Thực đơn 1 ngày" },
  "dung-tin-ngay": { name: "🔍 Đừng Tin Ngay", desc: "Hiểu lầm thường gặp" },
};
const dcKeys = ["bai-viet", "mon-an", "thuc-don", "dung-tin-ngay"] as const;

// Audiences
const audiences = [
  { id: "diabetes", label: "🩸 Người đái tháo đường" },
  { id: "hypertension", label: "🫗 Người tăng huyết áp" },
  { id: "gout", label: "🦶 Người gout" },
  { id: "kidney", label: "🫘 Người bệnh thận" },
  { id: "fatty-liver", label: "🫁 Người gan nhiễm mỡ" },
  { id: "stomach", label: "😣 Người bệnh dạ dày, tá tràng" },
  { id: "elderly", label: "👴 Người cao tuổi" },
  { id: "pregnancy", label: "🤰 Phụ nữ mang thai" },
  { id: "children", label: "🧒 Trẻ em" },
  { id: "weight-loss", label: "🏋️ Người cần giảm cân" },
  { id: "vegan", label: "🥬 Ăn chay" },
  { id: "caregiver", label: "👨👩👧👦 Người chăm sóc" },
];
const quickStarts = [
  { href: "/kien-thuc-dinh-duong#sec-noi-tiet", label: "Mới chẩn đoán đái tháo đường", note: "Ưu tiên nhóm chuyển hóa, carb, bữa ăn và hiểu lầm thường gặp." },
  { href: "/kien-thuc-dinh-duong#sec-tim-mach", label: "Muốn ăn nhạt mà vẫn ngon", note: "Đi vào nhóm tim mạch, huyết áp và các bài giảm natri thực tế." },
  { href: "/kien-thuc-dinh-duong#sec-tieu-hoa", label: "Đầy bụng, dạ dày, gan mật", note: "Xem trước các bài tiêu hóa, gan mật và cách sắp bữa dễ chịu hơn." },
  { href: "/dung-tin-ngay", label: "Muốn kiểm tra hiểu lầm", note: "Đi thẳng vào loạt nội dung gỡ nhầm về thực phẩm, đường, mỡ và các xu hướng thanh lọc thiếu bằng chứng." },
];
---

<BaseLayout title={title} description={desc} canonical="/kien-thuc-dinh-duong">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">🏠 Trang chủ</a> <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-current">📚 Kiến thức dinh dưỡng</span>
  </nav>
  <div class="ki-page">

    <!-- Hero -->
    <div class="ki-hero">
      <h1>📚 Kiến thức dinh dưỡng</h1>
      <p class="ki-desc">Tra cứu bài viết theo chuyên khoa. Từ bệnh lý đến thực đơn mẫu — tất cả bằng ngôn ngữ đời thường cho người Việt.</p>
      <div class="ki-actions">
        <a href="/tim-kiem" class="cta-btn">🔍 Tìm bài viết →</a>
        <a href="/hoi-dap" class="cta-alt-btn">❓ Hỏi nhanh – đáp gọn</a>
      </div>
    </div>

    <section class="ki-start-grid" aria-label="Lối vào nhanh">
      {quickStarts.map((item) => (
        <a class="ki-start-card" href={item.href}>
          <strong>{item.label}</strong>
          <p>{item.note}</p>
          <span>Đọc theo lối này →</span>
        </a>
      ))}
    </section>

    <div class="ki-search-panel" role="search" aria-label="Tìm bài viết dinh dưỡng">
      <label class="ki-search-label" for="ki-article-search">Tìm nhanh trong {articles.length.toLocaleString("vi-VN")} bài viết</label>
      <div class="ki-search-row">
        <input id="ki-article-search" type="search" placeholder="Ví dụ: tiểu đường, gout, bữa sáng, thuốc…" autocomplete="off" aria-describedby="ki-search-summary" />
        <button id="ki-search-clear" type="button" hidden>Xóa tìm kiếm</button>
      </div>
      <p id="ki-search-summary" class="ki-search-summary" role="status" aria-live="polite">Đang hiển thị bài viết theo chuyên khoa.</p>
    </div>

    <!-- Specialty Tabs (quick filters) -->
    <div class="ki-tabs">
      <button class="sp-tab sp-active" data-sp="all" onclick="filterSpecialty('all')">📋 Tất cả</button>
      {grouped.map(g => (
        <button class="sp-tab" data-sp={g.key} onclick={`filterSpecialty('${g.key}')`}>
          {g.meta.emoji} {g.meta.name} <span class="sp-count">{g.items.length}</span>
        </button>
      ))}
    </div>

    <!-- Audience filter (secondary) -->
    <details class="ki-aud-filter">
      <summary>🎯 Lọc theo đối tượng</summary>
      <div class="aud-btns">
        <button class="aud-btn aud-active" data-filter="all" onclick="filterAudience('all')">📋 Tất cả</button>
        {audiences.map(a => (
          <button class="aud-btn" data-filter={a.id} onclick={`filterAudience('${a.id}')`}>{a.label}</button>
        ))}
      </div>
    </details>
    <p id="ki-search-empty" class="ki-search-empty" hidden role="status">Chưa tìm thấy bài viết phù hợp. Thử từ khóa khác hoặc mở lại bộ lọc đối tượng.</p>

    <!-- Featured (only in "All" mode) -->
    <section id="sec-featured" class="ki-section" data-sp-section="featured">
      <h2 class="ki-section-title">🌟 Bài viết nổi bật</h2>
      <div class="ki-article-grid">
        {featured.map(a => (
          <div data-article-card data-audience={(a.audience||[]).join(',')} data-article-search={articleSearchText(a)}>
            <ArticleCard title={a.title} slug={a.slug} emoji={a.emoji} description={a.description} readTime={a.readTime} date={a.date} audience={a.audience} tags={a.tags} series={a.series} specialty={a.specialty} />
          </div>
        ))}
      </div>
    </section>

    <!-- Specialty Sections -->
    {grouped.map(g => {
      // Sub-group by display category
      const subGroups = dcKeys
        .map(dc => ({ key: dc, ...dcLabel[dc], items: g.items.filter((a: ArticleMeta) => a.displayCategory === dc) }))
        .filter(sg => sg.items.length > 0);

      // Large sections stay collapsed initially to keep the page scannable.
      const defaultOpen = !(g.items.length > 15);

      return (
        <section id={`sec-${g.key}`} class="ki-section" data-sp-section={g.key}>
          <details class="ki-details" open={defaultOpen}>
            <summary class="ki-section-title">
              <span class="spec-header">
                <span class="spec-emoji">{g.meta.emoji}</span>
                <span class="spec-name">{g.meta.name}</span>
                <span class="spec-count">{g.items.length} bài</span>
              </span>
              <span class="ki-toggle-arrow">▼</span>
            </summary>
            <p class="spec-desc">{g.meta.desc}</p>

            {subGroups.map(sg => (
              <div class="ki-subgroup">
                <h3 class="ki-sub-title">{sg.name} <span class="sub-count">({sg.items.length})</span></h3>
                <div class="ki-article-grid">
                  {sg.items.map((a: ArticleMeta) => (
                    <div data-article-card data-audience={(a.audience||[]).join(',')} data-article-search={articleSearchText(a)}>
                      <ArticleCard title={a.title} slug={a.slug} emoji={a.emoji} description={a.description} readTime={a.readTime} date={a.date} audience={a.audience} tags={a.tags} series={a.series} specialty={a.specialty} />
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </details>
        </section>
      );
    })}

    {unknownItems.length > 0 && (
      <section id="sec-unknown" class="ki-section" data-sp-section="unknown">
        <h2 class="ki-section-title">📋 Bài viết khác</h2>
        <div class="ki-article-grid">
          {unknownItems.map(a => (
            <div data-article-card data-audience={(a.audience||[]).join(',')} data-article-search={articleSearchText(a)}>
              <ArticleCard title={a.title} slug={a.slug} emoji={a.emoji} description={a.description} readTime={a.readTime} date={a.date} audience={a.audience} tags={a.tags} series={a.series} specialty={a.specialty} />
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="ki-footer-links">
      <p class="muted">Chưa tìm thấy bài viết phù hợp?</p>
      <div class="ki-actions">
        <a href="/theo-benh" class="cta-alt-btn">🗂️ Theo bệnh</a>
        <a href="/ban-do-benh" class="cta-alt-btn">🗺️ Bản đồ bệnh lý</a>
        <a href="/tim-kiem" class="cta-alt-btn">🔍 Tìm kiếm toàn bộ</a>
      </div>
    </div>
  </div>

  <style>
    .ki-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .ki-hero {
      margin-bottom: 1.5rem;
    }
    .ki-hero h1 {
      font-size: 1.8rem;
      margin: 0 0 8px;
    }
    .ki-desc {
      color: var(--ink-secondary);
      max-width: 620px;
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0 0 14px;
    }
    .ki-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ki-start-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin: 0 0 18px;
    }
    .ki-start-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 16px;
      border: 1px solid var(--card-border);
      border-radius: 14px;
      background: var(--bg-soft);
      color: inherit;
      text-decoration: none;
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .ki-start-card:hover {
      transform: translateY(-2px);
      border-color: var(--brand-light2);
      box-shadow: var(--shadow-sm);
      text-decoration: none;
    }
    .ki-start-card strong { font-size: 0.95rem; }
    .ki-start-card p {
      margin: 0;
      color: var(--ink-secondary);
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .ki-start-card span {
      color: var(--brand-dark);
      font-size: 0.82rem;
      font-weight: 700;
    }
    .ki-search-panel {
      margin: 0 0 18px;
      padding: 14px;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      background: var(--bg-soft);
    }
    .ki-search-label {
      display: block;
      margin-bottom: 7px;
      color: var(--ink);
      font-size: .82rem;
      font-weight: 800;
    }
    .ki-search-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ki-search-row input {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      padding: 9px 12px;
      border: 1px solid var(--card-border);
      border-radius: 11px;
      background: var(--card);
      color: var(--ink);
      font: inherit;
    }
    .ki-search-row input:focus {
      border-color: var(--brand);
      outline: 0;
      box-shadow: 0 0 0 3px rgba(5,150,105,.12);
    }
    .ki-search-clear {
      min-height: 36px;
      padding: 5px 10px;
      border: 1px solid var(--card-border);
      border-radius: 999px;
      background: var(--card);
      color: var(--ink-secondary);
      cursor: pointer;
      font: inherit;
      font-size: .76rem;
      font-weight: 750;
    }
    .ki-search-clear:hover { border-color: var(--brand-light2); color: var(--brand-dark); }
    .ki-search-summary { margin: 7px 0 0; color: var(--ink-tertiary); font-size: .76rem; }
    .ki-search-empty { margin: 0 0 16px; padding: 14px; border: 1px dashed var(--brand-light2); border-radius: 12px; background: var(--brand-subtle); color: var(--ink-secondary); font-size: .84rem; }
    .cta-btn {
      display: inline-block;
      padding: 9px 20px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.88rem;
      background: var(--brand);
      color: white;
      text-decoration: none;
      transition: all 0.2s;
    }
    .cta-btn:hover { opacity: 0.9; transform: translateY(-1px); text-decoration: none; }
    .cta-alt-btn {
      display: inline-block;
      padding: 8px 18px;
      border: 1px solid var(--card-border);
      border-radius: 999px;
      font-size: 0.88rem;
      color: var(--ink);
      text-decoration: none;
      transition: all 0.15s;
      font-weight: 500;
      box-shadow: var(--shadow-sm);
    }
    .cta-alt-btn:hover { border-color: var(--brand); color: var(--brand); text-decoration: none; box-shadow: var(--shadow); transform: translateY(-1px); }

    /* Specialty tabs */
    .ki-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }
    .sp-tab {
      padding: 6px 14px;
      border: 1px solid var(--card-border);
      border-radius: 20px;
      background: var(--card);
      color: var(--ink);
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
      white-space: nowrap;
      box-shadow: var(--shadow-sm);
    }
    .sp-tab:hover { border-color: var(--brand); transform: translateY(-1px); box-shadow: var(--shadow); color: var(--brand); }
    .sp-tab.sp-active { background: var(--brand-light); color: var(--brand-dark); border-color: var(--brand-light2); font-weight: 600; box-shadow: none; transform: none; }
    .sp-count {
      display: inline-block;
      margin-left: 4px;
      font-size: 0.72rem;
      opacity: 0.7;
    }

    /* Audience filter */
    .ki-aud-filter {
      margin-bottom: 1.2rem;
      font-size: 0.88rem;
    }
    .ki-aud-filter summary {
      cursor: pointer;
      color: var(--ink-secondary);
      font-weight: 500;
      padding: 4px 0;
    }
    .aud-btns {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 8px;
    }
    .aud-btn {
      padding: 4px 11px;
      border: 1px solid var(--card-border);
      border-radius: 20px;
      background: var(--card);
      color: var(--ink-secondary);
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
      box-shadow: var(--shadow-sm);
    }
    .aud-btn:hover { border-color: var(--brand); color: var(--ink); box-shadow: var(--shadow); transform: translateY(-1px); }
    .aud-btn.aud-active { background: var(--brand-light); color: var(--brand); border-color: var(--brand-light2); font-weight: 600; box-shadow: none; transform: none; }

    /* Sections */
    .ki-section {
      margin-bottom: 12px;
    }
    .ki-section-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      padding: 10px 14px;
      background: var(--bg-soft);
      border-radius: 10px;
      transition: background 0.15s;
      user-select: none;
    }
    .ki-section-title:hover {
      background: var(--brand-light);
    }
    .spec-header {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .spec-emoji { font-size: 1.2rem; }
    .spec-name { font-size: 0.95rem; }
    .spec-count {
      font-size: 0.78rem;
      color: var(--ink-tertiary);
      font-weight: 400;
    }
    .ki-toggle-arrow {
      font-size: 0.8rem;
      color: var(--ink-tertiary);
      transition: transform 0.2s;
    }
    details[open] .ki-toggle-arrow {
      transform: rotate(180deg);
    }
    .spec-desc {
      font-size: 0.85rem;
      color: var(--ink-secondary);
      margin: -8px 0 14px 14px;
    }

    /* Sub-group */
    .ki-subgroup {
      margin: 0 0 18px 14px;
    }
    .ki-sub-title {
      font-size: 0.92rem;
      font-weight: 600;
      margin: 0 0 10px;
      color: var(--brand);
      border-left: 3px solid var(--brand-light2);
      padding-left: 10px;
    }
    .sub-count {
      font-size: 0.8rem;
      color: var(--ink-tertiary);
      font-weight: 400;
    }

    /* Article grid */
    .ki-article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 10px;
    }

    /* Footer */
    .ki-footer-links {
      text-align: center;
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid var(--card-border);
    }
    .ki-footer-links p { margin-bottom: 12px; }
    .ki-footer-links .ki-actions { justify-content: center; }

    @media (max-width: 640px) {
      .ki-page { padding-inline: 1rem; }
      .ki-hero h1 { font-size: 1.6rem; }
      .ki-actions {
        flex-direction: column;
      }
      .ki-actions a {
        width: 100%;
        text-align: center;
      }
      .ki-start-grid,
      .ki-article-grid { grid-template-columns: 1fr; }
      .ki-search-row { align-items: stretch; flex-direction: column; }
      .ki-search-clear { width: 100%; }
      .ki-start-card {
        border-radius: 12px;
      }
      .ki-article-grid { grid-template-columns: 1fr; }
      .ki-tabs {
        gap: 6px;
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
        scrollbar-width: none;
        scroll-snap-type: x proximity;
      }
      .ki-tabs::-webkit-scrollbar { display: none; }
      .sp-tab {
        font-size: 0.78rem;
        padding: 6px 10px;
        min-height: 38px;
        flex: 0 0 auto;
        scroll-snap-align: start;
      }
      .aud-btn {
        min-height: 36px;
        text-align: left;
      }
      .ki-section-title {
        padding: 12px;
        align-items: flex-start;
      }
      .spec-header {
        align-items: flex-start;
      }
      .spec-name {
        line-height: 1.4;
      }
      .ki-subgroup { margin-left: 0; }
      .spec-desc {
        margin-left: 0;
        margin-top: -4px;
      }
    }
    @media (max-width: 600px) {
      .article-item { padding: 12px; }
      .article-item h3 { font-size: 0.9rem; }
      .article-item p { font-size: 0.82rem; }
    }
</style>

  <script is:inline>
    var activeSpecialty = 'all';
    var activeAudience = 'all';
    var articleSearchInput = document.getElementById('ki-article-search');
    var articleSearchClear = document.getElementById('ki-search-clear');
    var articleSearchSummary = document.getElementById('ki-search-summary');
    var articleSearchEmpty = document.getElementById('ki-search-empty');
    var articleCards = Array.from(document.querySelectorAll('[data-article-card]'));
    var articleSections = Array.from(document.querySelectorAll('[data-sp-section]'));
    var articleParams = new URLSearchParams(window.location.search);
    if (articleSearchInput && articleParams.get('q')) articleSearchInput.value = articleParams.get('q');

    function normalizeArticleSearch(value) {
      return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'd').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function articleMatches(card) {
      var query = normalizeArticleSearch(articleSearchInput && articleSearchInput.value);
      var audienceList = (card.getAttribute('data-audience') || '').split(',').filter(Boolean);
      var matchesQuery = !query || normalizeArticleSearch(card.getAttribute('data-article-search')).indexOf(query) !== -1;
      var matchesAudience = activeAudience === 'all' || audienceList.indexOf(activeAudience) >= 0;
      return matchesQuery && matchesAudience;
    }

    function applyArticleFilters() {
      var visible = 0;
      var query = normalizeArticleSearch(articleSearchInput && articleSearchInput.value);
      articleCards.forEach(function(card) {
        var section = card.closest('[data-sp-section]');
        var sectionKey = section && section.getAttribute('data-sp-section');
        var specialtyMatches = activeSpecialty === 'all'
          ? true
          : sectionKey === activeSpecialty;
        var matches = specialtyMatches && articleMatches(card);
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      articleSections.forEach(function(section) {
        var sectionKey = section.getAttribute('data-sp-section');
        var sectionSpecialtyMatches = activeSpecialty === 'all' || sectionKey === activeSpecialty;
        var sectionVisible = section.querySelectorAll('[data-article-card]:not([hidden])').length;
        section.hidden = !sectionSpecialtyMatches || sectionVisible === 0;
        section.querySelectorAll('.ki-subgroup').forEach(function(subgroup) {
          subgroup.hidden = subgroup.querySelectorAll('[data-article-card]:not([hidden])').length === 0;
        });
      });

      if (articleSearchClear) articleSearchClear.hidden = !query;
      if (articleSearchEmpty) articleSearchEmpty.hidden = visible !== 0;
      if (articleSearchSummary) {
        articleSearchSummary.textContent = query
          ? ('Tìm thấy ' + visible.toLocaleString('vi-VN') + ' / ' + articleCards.length.toLocaleString('vi-VN') + ' bài viết phù hợp.')
          : (activeAudience === 'all' ? 'Đang hiển thị bài viết theo chuyên khoa.' : 'Đang lọc bài viết theo đối tượng đã chọn.');
      }
      syncArticleUrl();
    }

    function syncArticleUrl() {
      var next = new URLSearchParams(window.location.search);
      var query = articleSearchInput && articleSearchInput.value.trim();
      if (query) next.set('q', query); else next.delete('q');
      var nextUrl = window.location.pathname + (next.toString() ? '?' + next.toString() : '') + window.location.hash;
      window.history.replaceState({}, '', nextUrl);
    }

    function filterSpecialty(sp) {
      document.querySelectorAll('.sp-tab').forEach(b => b.classList.remove('sp-active'));
      var btn = document.querySelector('.sp-tab[data-sp="' + sp + '"]');
      if (btn) btn.classList.add('sp-active');
      activeSpecialty = sp;
      applyArticleFilters();
    }

    function filterAudience(aud) {
      document.querySelectorAll('.aud-btn').forEach(b => b.classList.remove('aud-active'));
      var btn = document.querySelector('.aud-btn[data-filter="' + aud + '"]');
      if (btn) btn.classList.add('aud-active');
      activeAudience = aud;
      applyArticleFilters();
    }

    articleSearchInput && articleSearchInput.addEventListener('input', applyArticleFilters);
    articleSearchClear && articleSearchClear.addEventListener('click', function() {
      if (articleSearchInput) articleSearchInput.value = '';
      articleSearchInput && articleSearchInput.focus();
      applyArticleFilters();
    });
    applyArticleFilters();
  </script>
</BaseLayout>
