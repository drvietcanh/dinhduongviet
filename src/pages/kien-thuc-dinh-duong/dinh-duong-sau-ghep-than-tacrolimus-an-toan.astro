import ArticleLayout from '../../layouts/ArticleLayout.astro'; import { articleBySlug } from '../../data/articles';
const article = articleBySlug['dinh-duong-sau-ghep-than-tacrolimus-an-toan'];
---
<ArticleLayout article={article}><p>Sau ghép thận, thuốc ức chế miễn dịch và chức năng thận mới quyết định nhiều giới hạn ăn uống.</p><ul><li>Dùng tacrolimus đúng giờ và cùng cách với bữa ăn; tránh bưởi, nước bưởi và sản phẩm bổ sung chưa được duyệt.</li><li>Tuân thủ an toàn thực phẩm, theo dõi huyết áp, đường huyết, cân nặng và xét nghiệm.</li><li>Sốt, tiêu chảy kéo dài, nôn, tiểu ít hoặc run tay nhiều cần gọi đội ghép thận.</li></ul></ArticleLayout>
