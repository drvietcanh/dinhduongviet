---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articleBySlug } from "../../data/articles";
const art = articleBySlug["canxi-xuong-chac-khoe"];
if (!art) throw new Error("Article not found: canxi-xuong-chac-khoe");
---

<ArticleLayout article={art}>
<div class="toc">
      <strong>📑 Nội dung</strong>
      <ul>
        <li><a href="#bao-nhieu">Cần bao nhiêu canxi mỗi ngày?</a></li>
        <li><a href="#thuc-pham">Thực phẩm giàu canxi cho người Việt</a></li>
        <li><a href="#loang-xuong">Loãng xương — kẻ giết người thầm lặng</a></li>
        <li><a href="#vitamin-d">Vitamin D và K2 — người vận chuyển canxi</a></li>
        <li><a href="#thuoc">Có nên uống thuốc canxi?</a></li>
        <li><a href="#thuc-don">Thực đơn giàu canxi mẫu</a></li>
      </ul>
    </div>

    <section id="bao-nhieu">
      <h2>📊 Nhu cầu canxi theo độ tuổi</h2>
      <table class="nutri-table">
        <tr><th>Độ tuổi</th><th>Nhu cầu (mg/ngày)</th><th>Lưu ý</th></tr>
        <tr><td>Trẻ 1-3 tuổi</td><td>500 mg</td><td>Xương phát triển nhanh</td></tr>
        <tr><td>Trẻ 4-8 tuổi</td><td>700 mg</td><td></td></tr>
        <tr><td>Thiếu niên 9-18 tuổi</td><td><strong>1.300 mg</strong></td><td>⚡ Giai đoạn tích xương cao nhất</td></tr>
        <tr><td>Người lớn 19-50 tuổi</td><td>1.000 mg</td><td>Duy trì khối xương</td></tr>
        <tr><td>Phụ nữ có thai/cho bú</td><td>1.000-1.200 mg</td><td>Tăng hấp thu canxi</td></tr>
        <tr><td>Người &gt;50 tuổi (nữ)</td><td><strong>1.200 mg</strong></td><td>⚠️ Mất xương nhanh sau mãn kinh</td></tr>
        <tr><td>Người &gt;70 tuổi</td><td><strong>1.200 mg</strong></td><td>⚠️ Nguy cơ gãy xương cao</td></tr>
      </table>
    </section>

    <section id="thuc-pham">
      <h2>🥬 Thực phẩm giàu canxi cho người Việt</h2>
      <p class="small">Không chỉ sữa — canxi có nhiều trong rau xanh, đậu, hải sản nhỏ ăn cả xương.</p>
      <table class="nutri-table">
        <tr><th>Thực phẩm</th><th>Khẩu phần</th><th>Canxi (mg)</th><th>% DRI</th></tr>
        <tr><td><a href="/thuc-pham/sua-tuoi">Sữa tươi</a></td><td>200ml</td><td>240 mg</td><td>24%</td></tr>
        <tr><td><a href="/thuc-pham/sua-chua">Sữa chua</a></td><td>100g</td><td>120 mg</td><td>12%</td></tr>
        <tr><td><a href="/thuc-pham/tom-kho">Tép khô</a></td><td>30g</td><td><strong>600 mg</strong></td><td>60%</td></tr>
        <tr><td><a href="/thuc-pham/ca-sac">Cá nhỏ nguyên xương</a></td><td>100g</td><td>~350 mg</td><td>35%</td></tr>
        <tr><td><a href="/thuc-pham/cu-den">Củ dền</a></td><td>100g</td><td>270 mg</td><td>27%</td></tr>
        <tr><td><a href="/thuc-pham/rau-muong">Rau muống</a></td><td>100g</td><td>100 mg</td><td>10%</td></tr>
        <tr><td><a href="/thuc-pham/rau-cai-thia-non">Cải thìa</a></td><td>100g</td><td>150 mg</td><td>15%</td></tr>
        <tr><td><a href="/thuc-pham/dau-phu">Đậu phụ (nung canxi)</a></td><td>100g</td><td>350 mg</td><td>35%</td></tr>
        <tr><td><a href="/thuc-pham/me-vung">Mè (vừng)</a></td><td>10g (1 thìa)</td><td>88 mg</td><td>9%</td></tr>
        <tr><td><a href="/thuc-pham/hat-dieu">Hạt điều</a></td><td>30g</td><td>50 mg</td><td>5%</td></tr>
      </table>
      <div class="highlight-box"><strong>🇻🇳 Mẹo Việt:</strong> Tép khô rang + mè + lá chanh — ăn cùng cơm. Tép khô có thể góp phần đáng kể vào lượng canxi, nhưng hàm lượng thay đổi theo loại và cách chế biến. Nước xương hầm thực ra không nhiều canxi như nhiều người nghĩ.</div>
    </section>

    <section id="loang-xuong">
      <h2>⚠️ Loãng xương — kẻ giết người thầm lặng</h2>
      <div class="two-col">
        <div class="col-card bad"><h3>🔴 Yếu tố nguy cơ</h3><ul><li>Nữ &gt; 50 tuổi</li><li>Ít vận động</li><li>Hút thuốc, uống rượu</li><li>Chế độ ăn thiếu canxi</li><li>Gia đình có người loãng xương</li><li>Sử dụng corticoid kéo dài</li></ul></div>
        <div class="col-card good"><h3>🟢 Phòng ngừa</h3><ul><li>Bổ sung canxi đủ nhu cầu</li><li>Tập chịu trọng lượng (đi bộ, leo cầu thang, tạ)</li><li>Vitamin D — tắm nắng 15-20 phút/ngày</li><li>Tránh hút thuốc, rượu bia</li><li>Hạn chế muối, cà phê</li><li>Ăn đủ đạm để xây dựng xương</li></ul></div>
      </div>
    </section>

    <section id="vitamin-d">
      <h2>☀️ Vitamin D & K2 — "Người vận chuyển" canxi</h2>
      <p>Bổ sung canxi mà thiếu vitamin D và K2 thì canxi sẽ không đến được xương.</p>
      <div class="two-col">
        <div class="col-card good"><h3>☀️ Vitamin D</h3><ul><li>Giúp hấp thu canxi từ ruột</li><li>Nhu cầu: 600-2000 IU/ngày</li><li>Nguồn: tắm nắng 6-10h sáng, cá béo, lòng đỏ trứng</li><li>Người Việt thường thiếu do lười tắm nắng</li></ul></div>
        <div class="col-card good"><h3>🥦 Vitamin K2</h3><ul><li>Giúp gắn canxi vào xương, tránh lắng đọng ở mạch máu</li><li>Nguồn: đậu nành lên men (natto), gan, phô mai, bông cải</li><li>Thiếu K2 → canxi "lạc đường" → vôi hóa mạch máu</li></ul></div>
      </div>
    </section>

    <section id="thuoc">
      <h2>💊 Có nên uống viên canxi?</h2>
      <p><strong>Nguyên tắc:</strong> Thực phẩm trước, viên uống sau. Chỉ bổ sung khi chế độ ăn không đáp ứng đủ.</p>
      <ul>
        <li>Canxi từ thực phẩm hấp thu tốt hơn canxi từ viên uống</li>
        <li>Nếu cần uống: 500-600 mg/lần, không uống 1000mg 1 lần</li>
        <li>Uống kèm vitamin D 400-800 IU</li>
        <li>Tránh uống chung với sắt (cản trở hấp thu nhau)</li>
        <li>Uống canxi trong bữa ăn — giảm tác dụng phụ, tăng hấp thu</li>
      </ul>
      <div class="highlight-box"><strong>⚠️ Cảnh báo:</strong> Thừa canxi (&gt;2000 mg/ngày từ cả thực phẩm và viên uống) có thể gây sỏi thận, vôi hóa mạch máu, táo bón.</div>
    </section>

    <section id="thuc-don">
      <h2>🍜 Thực đơn giàu canxi 1 ngày (~1.500 mg canxi)</h2>
      <table class="nutri-table">
        <tr><th>Bữa</th><th>Món</th><th>Canxi</th></tr>
        <tr><td>🌅 Sáng</td><td>Bún riêu cua + sữa đậu nành 200ml</td><td>~250 mg</td></tr>
        <tr><td>🍎 Phụ sáng</td><td>Sữa chua 100g + hạt điều 20g</td><td>~200 mg</td></tr>
        <tr><td>🌞 Trưa</td><td>Cơm + cá kho nhỏ ăn cả xương + rau dền luộc</td><td>~500 mg</td></tr>
        <tr><td>🌙 Tối</td><td>Cơm + tép rang mè + canh cải nấu tôm</td><td>~450 mg</td></tr>
        <tr><td>🌆 Tối trước ngủ</td><td>Sữa ấm 200ml</td><td>~240 mg</td></tr>
      </table>
    </section>

    <div class="article-actions">
      <a href="/kien-thuc-dinh-duong/loang-xuong" class="cta-btn">🦴 Loãng xương</a>
      <a href="/thuc-pham" class="cta-btn cta-alt">🥬 Tra thực phẩm</a>
    </div>
  </div>
</BaseLayout>

<style>
.article-wrapper { max-width: 740px; margin: 0 auto; }
.toc { background: var(--bg-elevated); padding: 16px 20px; border-radius: 12px; margin-bottom: 24px; font-size:0.9rem; }
.toc ul { margin:8px 0 0; padding-left:20px; }
.toc a { color:var(--brand); }
section { margin-bottom:28px; }
h2 { font-size:1.15rem; margin-bottom:10px; }
p, li { line-height:1.7; }
.highlight-box { background:var(--brand-light); padding:16px; border-radius:12px; margin:12px 0; }
.nutri-table { width:100%; border-collapse:collapse; font-size:0.88rem; margin:12px 0; }
.nutri-table th { background:var(--bg-elevated); padding:8px 10px; text-align:left; border-bottom:2px solid var(--border); }
.nutri-table td { padding:8px 10px; border-bottom:1px solid var(--border); }
.small { font-size:0.82rem; color:var(--ink-tertiary); }
.two-col { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:16px 0; }
.col-card { padding:14px; border-radius:10px; border:1px solid var(--border); background:var(--bg-card); }
.col-card.good { border-left:3px solid #2e7d32; }
.col-card.bad { border-left:3px solid #e53935; }
.col-card h3 { margin:0 0 8px; font-size:0.9rem; }
.col-card ul { margin:0; padding-left:16px; font-size:0.85rem; }
.article-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:28px; padding-top:16px; border-top:1px solid var(--border); }
.cta-btn { display:inline-block; padding:10px 22px; border-radius:999px; font-weight:600; background:var(--brand); color:white; text-decoration:none; }
.cta-alt { background:var(--ink-tertiary); }
@media (max-width:600px) { .two-col { grid-template-columns:1fr; } }
</style>
</ArticleLayout>
