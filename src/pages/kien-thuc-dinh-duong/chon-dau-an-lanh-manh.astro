---
import BaseLayout from "../../layouts/BaseLayout.astro";
const targetSlug = "chon-dau-an";
---

<BaseLayout title="Chọn dầu ăn — Loại nào cho món nào? | Dinh Dưỡng Việt" description="Bài viết đã được chuyển đến địa chỉ mới.">
  <div style="max-width:600px;margin:4rem auto;text-align:center;line-height:1.8;">
    <h1 style="font-size:2rem;">🔀 Bài viết đã được hợp nhất</h1>
    <p>Bài viết này đã được gộp vào bài viết khác.</p>
    <a href={`/kien-thuc-dinh-duong/${targetSlug}`} style="display:inline-block;margin-top:1rem;padding:10px 24px;background:var(--brand);color:white;border-radius:999px;text-decoration:none;font-weight:600;">
      → Xem bài tổng hợp tại đây
    </a>
  </div>
</BaseLayout>

<script is:inline>
  setTimeout(function() {
    window.location.href = "/kien-thuc-dinh-duong/chon-dau-an";
  }, 3000);
</script>
