  }

  .story-box h3 {
    margin-top: 0;
    color: var(--primary);
  }

  .tldr-box {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(41, 128, 185, 0.1));
    border: 1px solid rgba(52, 152, 219, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .tldr-box h3 {
    margin-top: 0;
    color: #2980b9;
