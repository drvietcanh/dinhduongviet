<tbody>
<tr>
<td>Cơm gạo lứt</td>
<td>3/4 chén (100g)</td>
<td>Tăng HDL, giảm đường huyết</td>
</tr>
<tr>
<td>Cá thu/hồi nướng</td>
<td>100g</td>
<td>Omega-3 giảm triglyceride</td>
</tr>
<tr>
<td>Rau luộc (bông cải, rau muống)</td>
<td>200g</td>
<td>Chất xơ giảm hấp thu cholesterol</td>
</tr>
