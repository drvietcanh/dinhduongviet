import ArticleLayout from '../../layouts/ArticleLayout.astro'; import { articleBySlug } from '../../data/articles';
const article = articleBySlug['bua-an-hoc-duong-va-tang-truong-tre'];
---
<ArticleLayout article={article}><p>Bữa học đường nên bổ sung cho bữa gia đình, không biến thành cuộc thi ăn hoặc giảm cân.</p><ul><li>Ưu tiên món có rau/quả, tinh bột, đạm và nước; hạn chế nước ngọt và ăn vặt nhiều lần.</li><li>Theo dõi chiều cao, cân nặng theo biểu đồ tăng trưởng thay vì chỉ nhìn cân nặng.</li><li>Trẻ sụt cân, tăng trưởng chậm, mệt kéo dài hoặc thừa cân nhanh cần được đánh giá.</li></ul></ArticleLayout>
