---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Đọc nhãn dinh dưỡng thực phẩm - Hướng dẫn & Giải mã - Dinh Dưỡng Việt"
  description="Hướng dẫn đọc nhãn dinh dưỡng thực phẩm đóng gói: khẩu phần, calo, đường, chất béo, natri và phần trăm giá trị dinh dưỡng."
  canonical="/kien-thuc-dinh-duong/doc-nhan-dinh-duong"
>
  <section>
    <span class="badge">📖 Hướng dẫn</span>
    <h1>Đọc hiểu nhãn dinh dưỡng</h1>
    <p class="lead">
      Bạn có biết "% giá trị dinh dưỡng" thực sự nghĩa là gì? Lượng đường bao nhiêu là nhiều?
      Hướng dẫn này giúp bạn nhìn vào nhãn thực phẩm và biết ngay sản phẩm có tốt không.
    </p>
  </section>

  <section class="section card">
    <h2>🥫 Giải mã nhãn dinh dưỡng mẫu</h2>
    <div class="nl-layout">
      <div class="nl-label">
        <div class="nl-title">THÔNG TIN DINH DƯỠNG</div>
        <div class="nl-line"><span>Khẩu phần: 1 gói (75g)</span></div>
        <div class="nl-line"><span>Số khẩu phần: 1</span></div>
        <div class="nl-line nl-divider"></div>
        <div class="nl-line"><span class="nl-head">Năng lượng</span><span class="nl-val">350 kcal</span><span class="nl-pct">18%*</span></div>
        <div class="nl-line"><span class="nl-head">Chất đạm</span><span class="nl-val">6g</span><span class="nl-pct">10%</span></div>
        <div class="nl-line"><span class="nl-head">Chất béo</span><span class="nl-val">16g</span><span class="nl-pct">24%</span></div>
        <div class="nl-line sub"><span class="nl-head">- Chất béo bão hòa</span><span class="nl-val">7g</span><span class="nl-pct">35%</span></div>
        <div class="nl-line"><span class="nl-head">Carbohydrate</span><span class="nl-val">45g</span><span class="nl-pct">15%</span></div>
        <div class="nl-line sub"><span class="nl-head">- Đường</span><span class="nl-val">2g</span><span class="nl-pct">—</span></div>
        <div class="nl-line"><span class="nl-head">Chất xơ</span><span class="nl-val">1g</span><span class="nl-pct">4%</span></div>
        <div class="nl-line"><span class="nl-head">Natri</span><span class="nl-val">1180mg</span><span class="nl-pct">59%**</span></div>
        <div class="nl-foot">* % dựa trên khẩu phần 2.000 kcal/ngày<br/>** Một gói Hảo Hảo đã chứa ~59% nhu cầu muối tối đa/ngày!</div>
      </div>
      <div class="nl-guide">
        <h3>🔍 Cách đọc</h3>
        <ol style="padding-left:16px;line-height:1.8;">
          <li><strong>Khẩu phần</strong> — Kiểm tra một "khẩu phần" là bao nhiêu. Nhà sản xuất có thể để khẩu phần rất nhỏ để số calo trông thấp.</li>
          <li><strong>% Giá trị dinh dưỡng</strong> — Là % so với nhu cầu 1 ngày (dựa trên 2.000 kcal).
            <ul><li>🟢 <strong>&lt; 5%</strong> = thấp, tốt (cho chất béo, natri, đường)</li>
            <li>🔴 <strong>&gt; 20%</strong> = cao, cần cân nhắc</li></ul>
          </li>
          <li><strong>Chất béo bão hòa</strong> — Nên &lt; 10g/ngày. Hạn chế nếu &gt; 3g/khẩu phần.</li>
          <li><strong>Đường</strong> — WHO khuyến nghị &lt; 25g/ngày. &gt; 10g/khẩu phần là nhiều.</li>
          <li><strong>Natri</strong> — WHO khuyến nghị dưới 2.000mg/ngày cho người lớn; một số nhãn dùng mốc tham chiếu 2.300mg. &gt; 400mg/khẩu phần là cao.</li>
          <li><strong>Chất xơ</strong> — Nên &ge; 25g/ngày. &gt; 3g/khẩu phần là tốt. &gt; 5g là rất tốt.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section card">
    <h2>📐 Tool: Phân tích nhãn thực phẩm</h2>
    <p class="muted">Nhập các chỉ số từ nhãn thực phẩm bạn đang cầm — app đánh giá ngay.</p>
    
    <div class="nl-tool">
      <div class="nl-tool-grid">
        <div class="nl-tfld">
          <label>Khẩu phần (g)</label>
          <input type="number" id="nl-kp" value="100" min="1" step="1" />
        </div>
        <div class="nl-tfld">
          <label>Năng lượng (kcal)</label>
          <input type="number" id="nl-kcal" value="0" min="0" step="1" />
        </div>
        <div class="nl-tfld">
          <label>Chất béo (g)</label>
          <input type="number" id="nl-fat" value="0" min="0" step="0.1" />
        </div>
        <div class="nl-tfld">
          <label>Béo bão hòa (g)</label>
          <input type="number" id="nl-sat" value="0" min="0" step="0.1" />
        </div>
        <div class="nl-tfld">
          <label>Đường (g)</label>
          <input type="number" id="nl-sugar" value="0" min="0" step="0.1" />
        </div>
        <div class="nl-tfld">
          <label>Natri (mg)</label>
          <input type="number" id="nl-na" value="0" min="0" step="1" />
        </div>
        <div class="nl-tfld">
          <label>Chất xơ (g)</label>
          <input type="number" id="nl-fiber" value="0" min="0" step="0.1" />
        </div>
        <div class="nl-tfld">
          <label>Đạm (g)</label>
          <input type="number" id="nl-prot" value="0" min="0" step="0.1" />
        </div>
      </div>

      <div id="nl-result" style="margin-top:12px;">
        <div id="nl-verdicts"></div>
        <div id="nl-grade" style="margin-top:8px;padding:10px;border-radius:8px;font-weight:700;font-size:1.1rem;"></div>
      </div>
    </div>
  </section>

  <section class="section card">
    <h2>⚡ Mẹo nhanh khi đọc nhãn</h2>
    <p class="muted">Các mốc dưới đây là gợi ý sàng lọc nhanh cho người trưởng thành nói chung; người tăng huyết áp, đái tháo đường, bệnh thận, suy tim, phụ nữ mang thai hoặc trẻ nhỏ nên cá nhân hóa theo chỉ định bác sĩ/chuyên gia dinh dưỡng.</p>
    <div class="grid two" style="gap:12px;">
      <div style="background:#f0fdf4;padding:12px;border-radius:8px;border:1px solid #bbf7d0;">
        <h4>🟢 NÊN MUA nếu</h4>
        <ul style="font-size:0.88rem;line-height:1.6;padding-left:16px;">
          <li>Xơ &ge; 3g/khẩu phần</li>
          <li>Đạm &ge; 10g/khẩu phần (món chính)</li>
          <li>Natri &lt; 120mg/100g</li>
          <li>Đường &lt; 5g/khẩu phần</li>
          <li>Ít béo bão hòa</li>
        </ul>
      </div>
      <div style="background:#fef2f2;padding:12px;border-radius:8px;border:1px solid #fecaca;">
        <h4>🔴 HẠN CHẾ nếu</h4>
        <ul style="font-size:0.88rem;line-height:1.6;padding-left:16px;">
          <li>Natri &gt; 400mg/khẩu phần</li>
          <li>Đường &gt; 10g/khẩu phần</li>
          <li>Béo bão hòa &gt; 3g/khẩu phần</li>
          <li>% năng lượng từ đường &gt; 10%</li>
          <li>Khẩu phần "ảo" (gói nhỏ nhưng để khẩu phần lớn)</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section card">
    <h2>🔤 Tra từ viết tắt</h2>
    <table class="table">
      <thead><tr><th>Viết tắt</th><th>Nghĩa</th><th>Ghi chú</th></tr></thead>
      <tbody>
        <tr><td>NRV</td><td>Nutrient Reference Value</td><td>Giá trị tham chiếu dinh dưỡng</td></tr>
        <tr><td>GDA</td><td>Guideline Daily Amount</td><td>Lượng khuyến nghị hàng ngày</td></tr>
        <tr><td>DV</td><td>Daily Value</td><td>% nhu cầu 1 ngày (thường ghi trên nhãn)</td></tr>
        <tr><td>RDA</td><td>Recommended Dietary Allowance</td><td>Khuyến nghị dinh dưỡng (Mỹ)</td></tr>
        <tr><td>KJ / kcal</td><td>Kilojoules / Kilocalories</td><td>1 kcal = 4,184 kJ. Ở VN hay ghi "Calo" = kcal</td></tr>
        <tr><td>SFA</td><td>Saturated Fatty Acids</td><td>Chất béo bão hòa</td></tr>
        <tr><td>TFA</td><td>Trans Fatty Acids</td><td>Chất béo chuyển hóa (càng ít càng tốt)</td></tr>
        <tr><td>IMS</td><td>Iodized Marine Salt</td><td>Muối i-ốt biển</td></tr>
      </tbody>
    </table>
  </section>
<style is:global>
  .nl-layout { display: grid; grid-template-columns: 280px 1fr; gap: 20px; }
  @media (max-width: 700px) { .nl-layout { grid-template-columns: 1fr; } }
  .nl-label { background: #fff; border: 2px solid #333; padding: 12px; font-family: Arial, sans-serif; max-width: 280px; }
  [data-theme="dark"] .nl-label { background: #1a1a2e; border-color: #555; }
  .nl-title { font-size: 1.1rem; font-weight: 900; text-align: center; border-bottom: 4px solid #333; margin-bottom: 8px; padding-bottom: 4px; }
  .nl-line { display: flex; justify-content: space-between; font-size: 0.82rem; padding: 3px 0; border-bottom: 1px solid #ddd; gap: 4px; }
  .nl-line.sub { padding-left: 12px; }
  .nl-divider { border-bottom: 4px solid #333; margin: 4px 0; }
  .nl-head { flex: 1; }
  .nl-val { text-align: right; min-width: 55px; }
  .nl-pct { text-align: right; min-width: 45px; color: #666; }
  .nl-foot { font-size: 0.75rem; margin-top: 8px; color: #666; }
  .nl-guide { font-size: 0.9rem; }
  .nl-guide h3 { margin-bottom: 8px; }
  .nl-tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .nl-tfld label { font-size: 0.8rem; font-weight: 600; color: var(--ink-secondary); display: block; margin-bottom: 2px; }
  .nl-tfld input { width: 100%; min-height: 36px; border: 1.5px solid var(--line); border-radius: 6px; padding: 0 8px; font-size: 0.88rem; background: var(--bg-elevated); color: var(--ink); box-sizing: border-box; }
  .nl-verdict { padding: 6px 10px; margin-bottom: 4px; border-radius: 6px; font-size: 0.85rem; display: flex; gap: 6px; align-items: flex-start; }
  .nl-v-green { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .nl-v-red { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
  .nl-v-yellow { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
  [data-theme="dark"] .nl-v-green { background: #1a3a1a; border-color: #2a5a2a; color: #86efac; }
  [data-theme="dark"] .nl-v-red { background: #3a1a1a; border-color: #5a2a2a; color: #fca5a5; }
  [data-theme="dark"] .nl-v-yellow { background: #3a3a1a; border-color: #5a5a2a; color: #fde68a; }
</style>

<script>
(function() {
  function analyze() {
    function inputNumber(id: string, fallback: number) {
      var el = document.getElementById(id);
      if (!(el instanceof HTMLInputElement)) return fallback;
      var value = parseFloat(el.value);
      return Number.isFinite(value) ? value : fallback;
    }

    var kp = inputNumber('nl-kp', 100);
    var kcal = inputNumber('nl-kcal', 0);
    var sat = inputNumber('nl-sat', 0);
    var sugar = inputNumber('nl-sugar', 0);
    var na = inputNumber('nl-na', 0);
    var fiber = inputNumber('nl-fiber', 0);
    var prot = inputNumber('nl-prot', 0);

    // Per 100g
    var eds = [];

    // Energy
    var pctEnergy = Math.round(kcal / 2000 * 100);
    if (pctEnergy > 33) eds.push({lv:'red', msg:'🔴 Năng lượng cao (>33% nhu cầu ngày trong 1 khẩu phần). Hạn chế nếu đang giảm cân.'});
    else if (pctEnergy > 20) eds.push({lv:'yellow', msg:'🟡 Năng lượng trung bình (' + pctEnergy + '% nhu cầu ngày).'});
    else eds.push({lv:'green', msg:'🟢 Năng lượng thấp (' + pctEnergy + '% nhu cầu ngày). Phù hợp cho ăn nhẹ.'});

    // Sat fat
    if (sat > 3) eds.push({lv:'red', msg:'🔴 Nhiều béo bão hòa (' + sat + 'g). Hạn chế, gây tăng mỡ máu.'});
    else if (sat > 1.5) eds.push({lv:'yellow', msg:'🟡 Béo bão hòa ở mức trung bình (' + sat + 'g).'});
    else eds.push({lv:'green', msg:'🟢 Ít béo bão hòa (' + sat + 'g). Tốt cho tim mạch.'});

    // Sugar
    if (sugar > 10) eds.push({lv:'red', msg:'🔴 Nhiều đường (' + sugar + 'g). WHO khuyến nghị giảm đường tự do; mốc <25g/ngày là mục tiêu lý tưởng với khẩu phần 2.000 kcal.'});
    else if (sugar > 5) eds.push({lv:'yellow', msg:'🟡 Đường ở mức trung bình (' + sugar + 'g). Nên kiểm tra nếu là đường tinh chế.'});
    else eds.push({lv:'green', msg:'🟢 Ít đường (' + sugar + 'g). Tốt.'});

    // Sodium
    if (na > 600) eds.push({lv:'red', msg:'🔴 Rất nhiều natri (' + na + 'mg). THA và bệnh thận cần tránh.'});
    else if (na > 400) eds.push({lv:'red', msg:'🔴 Nhiều natri (' + na + 'mg). Theo dõi tổng lượng muối trong ngày.'});
    else if (na > 200) eds.push({lv:'yellow', msg:'🟡 Natri trung bình (' + na + 'mg). Có thể chấp nhận được.'});
    else eds.push({lv:'green', msg:'🟢 Ít natri (' + na + 'mg). Phù hợp cho THA, bệnh thận.'});

    // Fiber
    if (fiber > 5) eds.push({lv:'green', msg:'🟢 Giàu chất xơ (' + fiber + 'g). Rất tốt cho tiêu hóa và ĐTĐ.'});
    else if (fiber > 3) eds.push({lv:'green', msg:'🟢 Chất xơ tốt (' + fiber + 'g).'});
    else if (fiber < 1) eds.push({lv:'yellow', msg:'🟡 Ít chất xơ (' + fiber + 'g). Nếu là món chính, nên kết hợp rau.'});

    // Protein
    var isMeal = kp >= 100;
    if (isMeal && prot < 5) eds.push({lv:'yellow', msg:'🟡 Ít đạm (' + prot + 'g/' + kp + 'g). Nếu là món chính, nên thêm thịt/cá/trứng.'});
    else if (isMeal && prot >= 10) eds.push({lv:'green', msg:'🟢 Đạm khá (' + prot + 'g).'});

    // Sugar % of kcal
    if (kcal > 0) {
      var sugarPct = (sugar * 4 / kcal) * 100;
      if (sugarPct > 20) eds.push({lv:'red', msg:'🔴 ' + Math.round(sugarPct) + '% năng lượng từ đường. Vượt quá khuyến nghị (<10%).'});
    }

    // Render
    var verdictsEl = document.getElementById('nl-verdicts');
    if (!verdictsEl) return;
    verdictsEl.innerHTML = eds.map(function(e) {
      var cls = e.lv === 'red' ? 'nl-v-red' : (e.lv === 'yellow' ? 'nl-v-yellow' : 'nl-v-green');
      return '<div class="nl-verdict ' + cls + '">' + e.msg + '</div>';
    }).join('');

    // Overall grade
    var gradeEl = document.getElementById('nl-grade');
    if (!gradeEl) return;
    var reds = eds.filter(function(e) { return e.lv === 'red'; }).length;
    var yellows = eds.filter(function(e) { return e.lv === 'yellow'; }).length;
    var greens = eds.filter(function(e) { return e.lv === 'green'; }).length;
    var total = eds.length;
    var score = (greens * 2 + yellows * 1 - reds * 2) / total * 50 + 50;
    score = Math.max(0, Math.min(100, Math.round(score)));

    var grade, bg, color;
    if (score >= 80) { grade = 'A — Tuyệt vời! Sản phẩm lành mạnh.'; bg = '#f0fdf4'; color='#166534'; }
    else if (score >= 60) { grade = 'B — Khá tốt, có thể dùng thường xuyên.'; bg = '#fffbeb'; color='#92400e'; }
    else if (score >= 40) { grade = 'C — Trung bình. Dùng có chừng mực.'; bg = '#fef2f2'; color='#991b1b'; }
    else if (score >= 20) { grade = 'D — Kém. Hạn chế sử dụng.'; bg = '#fef2f2'; color='#991b1b'; }
    else { grade = 'F — Rất kém. Nên tránh.'; bg = '#fce4ec'; color='#c62828'; }

    gradeEl.textContent = '🏆 Điểm: ' + score + '/100 — ' + grade;
    gradeEl.style.background = bg;
    gradeEl.style.color = color;
  }

  ['nl-kp','nl-kcal','nl-fat','nl-sat','nl-sugar','nl-na','nl-fiber','nl-prot'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) { el.addEventListener('input', analyze); el.addEventListener('change', analyze); }
  });

  // Trigger initial
  analyze();
})();
</script>
</BaseLayout>
