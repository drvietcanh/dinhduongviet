---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articleBySlug } from "../../data/articles";
const art = articleBySlug["nhu-cau-dinh-duong-khuyen-nghi"];
if (!art) throw new Error("Article not found: nhu-cau-dinh-duong-khuyen-nghi");
---

<ArticleLayout article={art}>
<style is:global>
    .hero { text-align: center; margin-bottom: 24px; }
    .hero h1 { font-size: 1.6rem; margin-bottom: 6px; }
    .hero .sub { color: var(--ink-secondary); font-size: 0.95rem; }
    .tabs { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 20px; justify-content: center; }
    .tab { padding: 8px 16px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg-elevated); color: var(--ink-secondary); font-size: 0.85rem; font-weight: 500; cursor: pointer; transition: all var(--transition); }
    .tab:hover { border-color: var(--brand); }
    .tab.active { background: var(--brand); border-color: var(--brand); color: white; }
    .dri-table-wrap { overflow-x: auto; margin-top: 12px; }
    table.dri { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    table.dri th, table.dri td { padding: 8px 10px; border: 1px solid var(--line); text-align: center; }
    table.dri th { background: var(--brand-light); font-weight: 600; color: var(--ink); white-space: nowrap; }
    [data-theme="dark"] table.dri th { background: #1a2e21; }
    table.dri td:first-child { text-align: left; font-weight: 600; white-space: nowrap; }
    table.dri .section-header { background: var(--line-light); font-weight: 700; color: var(--ink); }
    [data-theme="dark"] table.dri .section-header { background: #242a23; }
    .info-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px; max-width: 600px; margin: 20px auto; }
    .info-card h3 { font-size: 1rem; margin-bottom: 8px; }
    .info-card p { font-size: 0.9rem; color: var(--ink-secondary); line-height: 1.6; }
    .source-note { text-align: center; font-size: 0.8rem; color: var(--ink-tertiary); margin-top: 24px; line-height: 1.5; }
  </style>

  <div class="hero">
    
    <p class="sub">Bảng nhu cầu tham khảo cho người Việt Nam, dựa trên khuyến nghị của Viện Dinh Dưỡng và WHO</p>
  </div>

  <div class="tabs" id="tabContainer">
    <button class="tab active" onclick="switchTab('energy')">⚡ Năng lượng</button>
    <button class="tab" onclick="switchTab('macro')">🥩 Đạm & Béo</button>
    <button class="tab" onclick="switchTab('vitamins')">🍊 Vitamin</button>
    <button class="tab" onclick="switchTab('minerals')">🧂 Khoáng chất</button>
  </div>

  <div class="dri-table-wrap" id="table-energy">
    <table class="dri">
      <tr><th>Nhóm</th><th>Nữ (kcal)</th><th>Nam (kcal)</th><th>Đạm nữ (g)</th><th>Đạm nam (g)</th></tr>
      <tr><td>Trẻ 1-3 tuổi</td><td>1100-1200</td><td>1200-1300</td><td>30</td><td>32</td></tr>
      <tr><td>Trẻ 4-6 tuổi</td><td>1400-1500</td><td>1500-1600</td><td>40</td><td>45</td></tr>
      <tr><td>Trẻ 7-9 tuổi</td><td>1600-1700</td><td>1700-1800</td><td>50</td><td>55</td></tr>
      <tr><td>Thiếu niên 10-12</td><td>1900-2000</td><td>2000-2100</td><td>60</td><td>65</td></tr>
      <tr><td>Thiếu niên 13-15</td><td>2000-2100</td><td>2250-2350</td><td>65</td><td>70</td></tr>
      <tr><td>Thiếu niên 16-18</td><td>2050-2150</td><td>2400-2500</td><td>65</td><td>72</td></tr>
      <tr class="section-header"><td colspan="5">Người trưởng thành</td></tr>
      <tr><td>19-29 tuổi (lao động nhẹ)</td><td>1800-1900</td><td>2200-2300</td><td>60</td><td>68</td></tr>
      <tr><td>19-29 tuổi (lao động TB)</td><td>2000-2100</td><td>2500-2600</td><td>65</td><td>72</td></tr>
      <tr><td>19-29 tuổi (lao động nặng)</td><td>2200-2300</td><td>2800-2900</td><td>70</td><td>78</td></tr>
      <tr><td>30-49 tuổi (lao động nhẹ)</td><td>1750-1850</td><td>2100-2200</td><td>58</td><td>65</td></tr>
      <tr><td>30-49 tuổi (lao động TB)</td><td>1950-2050</td><td>2400-2500</td><td>63</td><td>70</td></tr>
      <tr><td>30-49 tuổi (lao động nặng)</td><td>2150-2250</td><td>2700-2800</td><td>68</td><td>75</td></tr>
      <tr><td>50-69 tuổi</td><td>1700-1800</td><td>2000-2100</td><td>55</td><td>62</td></tr>
      <tr><td>≥ 70 tuổi</td><td>1600-1700</td><td>1900-2000</td><td>50</td><td>58</td></tr>
      <tr class="section-header"><td colspan="5">Đặc biệt</td></tr>
      <tr><td>Phụ nữ mang thai</td><td colspan="2">+ 350 (3 tháng giữa) / + 500 (3 tháng cuối)</td><td colspan="2">+15</td></tr>
      <tr><td>Cho con bú</td><td colspan="2">+ 500</td><td colspan="2">+20</td></tr>
    </table>
  </div>

  <div class="dri-table-wrap" id="table-macro" style="display:none;">
    <table class="dri">
      <tr><th>Nhóm</th><th>Đạm (g/kg/ngày)</th><th>Chất béo (% năng lượng)</th><th>Xơ (g/ngày)</th><th>Đường tinh (g)</th></tr>
      <tr><td>Trẻ 1-3 tuổi</td><td>1.5-1.8</td><td>30-40%</td><td>10-15</td><td>&lt;25</td></tr>
      <tr><td>Trẻ 4-9 tuổi</td><td>1.2-1.5</td><td>28-35%</td><td>15-20</td><td>&lt;30</td></tr>
      <tr><td>Thiếu niên 10-18</td><td>1.0-1.2</td><td>25-30%</td><td>20-25</td><td>&lt;35</td></tr>
      <tr><td>Người trưởng thành</td><td>0.8-1.0</td><td>20-25%</td><td>25-30</td><td>&lt;40</td></tr>
      <tr><td>Người &gt; 70 tuổi</td><td>0.9-1.1</td><td>20-25%</td><td>25-30</td><td>&lt;35</td></tr>
      <tr><td>Phụ nữ mang thai</td><td>1.0-1.2</td><td>25-30%</td><td>28-32</td><td>&lt;30</td></tr>
      <tr><td>Cho con bú</td><td>1.1-1.3</td><td>25-30%</td><td>30-35</td><td>&lt;30</td></tr>
      <tr><td>Vận động viên</td><td>1.2-1.7</td><td>25-30%</td><td>25-30</td><td>&lt;40</td></tr>
      <tr class="section-header"><td colspan="5">Ghi chú</td></tr>
      <tr><td colspan="5">Đạm: người bình thường 0.8g/kg → 60kg = 48g/ngày tối thiểu.<br/>
      Béo bão hòa: ≤ 7% năng lượng. Béo trans: &lt; 1%.<br/>
      Xơ: 14g/1000 kcal dựa theo khuyến cáo WHO.</td></tr>
    </table>
  </div>

  <div class="dri-table-wrap" id="table-vitamins" style="display:none;">
    <table class="dri">
      <tr><th>Vitamin</th><th>Nam (≥19)</th><th>Nữ (≥19)</th><th>Thai kỳ</th><th>Cho con bú</th></tr>
      <tr><td>Vitamin A (µg RE)</td><td>600</td><td>500</td><td>600</td><td>700</td></tr>
      <tr><td>Vitamin B1 (mg)</td><td>1.2</td><td>1.1</td><td>1.4</td><td>1.5</td></tr>
      <tr><td>Vitamin B2 (mg)</td><td>1.3</td><td>1.1</td><td>1.4</td><td>1.5</td></tr>
      <tr><td>Vitamin B3 (mg NE)</td><td>16</td><td>14</td><td>18</td><td>20</td></tr>
      <tr><td>Vitamin B6 (mg)</td><td>1.3</td><td>1.3</td><td>1.9</td><td>2.0</td></tr>
      <tr><td>Vitamin B9/Folate (µg DF)</td><td>200</td><td>200</td><td>400</td><td>300</td></tr>
      <tr><td>Vitamin B12 (µg)</td><td>2.4</td><td>2.4</td><td>2.6</td><td>2.8</td></tr>
      <tr><td>Vitamin C (mg)</td><td>80</td><td>80</td><td>110</td><td>120</td></tr>
      <tr><td>Vitamin D (µg)</td><td>5</td><td>5</td><td>15</td><td>15</td></tr>
      <tr><td>Vitamin E (mg α-TE)</td><td>10</td><td>8</td><td>10</td><td>12</td></tr>
      <tr><td>Vitamin K (µg)</td><td>65</td><td>55</td><td>55</td><td>55</td></tr>
    </table>
  </div>

  <div class="dri-table-wrap" id="table-minerals" style="display:none;">
    <table class="dri">
      <tr><th>Khoáng chất</th><th>Nam (≥19)</th><th>Nữ (≥19)</th><th>Thai kỳ</th><th>Cho con bú</th></tr>
      <tr><td>Canxi (mg)</td><td>500-800</td><td>500-800</td><td>1000</td><td>1000</td></tr>
      <tr><td>Sắt (mg)</td><td>12</td><td>24</td><td>30</td><td>24</td></tr>
      <tr><td>Kẽm (mg)</td><td>11</td><td>9</td><td>12</td><td>12</td></tr>
      <tr><td>Iod (µg)</td><td>150</td><td>150</td><td>250</td><td>250</td></tr>
      <tr><td>Magie (mg)</td><td>270</td><td>220</td><td>300</td><td>270</td></tr>
      <tr><td>Kali (mg)</td><td>2000</td><td>2000</td><td>2500</td><td>2500</td></tr>
      <tr><td>Natri (mg)</td><td>&lt;2400</td><td>&lt;2400</td><td>&lt;2400</td><td>&lt;2400</td></tr>
      <tr><td>Phốt pho (mg)</td><td>700</td><td>700</td><td>700</td><td>700</td></tr>
      <tr><td>Selen (µg)</td><td>50</td><td>50</td><td>60</td><td>65</td></tr>
    </table>
  </div>

  <div class="info-card">
    <h3>💡 Cách sử dụng bảng DRI</h3>
    <p>
      Khi xem thực phẩm, hãy so sánh hàm lượng dinh dưỡng với % DRI tương ứng.
      Ví dụ: 1 hộp sữa chua 100g cung cấp ~120mg canxi ≈ 20% nhu cầu canxi của người trưởng thành.
      <br/><br/>
      <strong>Lưu ý:</strong> DRI là giá trị tham khảo. Nhu cầu thực tế có thể thay đổi tuỳ tình trạng sức khoẻ, mức độ hoạt động, và yếu tố di truyền.
    </p>
  </div>

  <div class="source-note">
    Nguồn: "Nhu cầu dinh dưỡng khuyến nghị cho người Việt Nam" — Viện Dinh Dưỡng Quốc Gia (cập nhật 2016).
    Vitamin D và Folate tham khảo WHO/FAO 2004. Iod tham khảo ICCIDD/UNICEF.
  </div>

  <script is:inline>
    function switchTab(tab) {
      document.querySelectorAll('.dri-table-wrap').forEach(el => el.style.display = 'none');
      document.getElementById('table-' + tab).style.display = 'block';
      document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab').forEach(el => {
        if (el.textContent.includes(tab === 'energy' ? 'Năng' : tab === 'macro' ? 'Đạm' : tab === 'vitamins' ? 'Vitamin' : 'Khoáng')) {
          el.classList.add('active');
        }
      });
      // Simpler: find by onclick attribute
      document.querySelectorAll('.tab').forEach(el => {
        el.classList.remove('active');
        if (el.getAttribute('onclick') === "switchTab('" + tab + "')") el.classList.add('active');
      });
    }
  </script>
</ArticleLayout>
