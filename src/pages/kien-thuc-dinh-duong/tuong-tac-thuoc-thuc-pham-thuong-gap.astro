  .urgent-box p { margin-bottom: 0; }
  .source-list { padding-left: 1.25rem; }
  .source-list li { margin: .55rem 0; }
  .source-list a { color: var(--primary); font-weight: 700; }
  @media (max-width: 700px) {
    .tip-grid { grid-template-columns: 1fr; }
